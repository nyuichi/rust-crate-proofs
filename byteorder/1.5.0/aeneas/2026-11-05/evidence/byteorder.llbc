Deduplicated":2877},"id":9401,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2877},"id":9402,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":171,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["to_be",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":14,"beg":{"line":908,"col":8},"end":{"line":908,"col":40}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts `self` to big endian from the target's endianness."},{"DocComment":""},{"DocComment":" On big endian this is a no-op. On little endian the bytes are"},{"DocComment":" swapped."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"let n = 0x1Au64;"},{"DocComment":""},{"DocComment":" if cfg!(target_endian = \"big\") {"},{"DocComment":"     assert_eq!(n.to_be(), n)"},{"DocComment":" } else {"},{"DocComment":"     assert_eq!(n.to_be(), n.swap_bytes())"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6}],"output":{"Deduplicated":6}},"src":"Normal","body":"Opaque"},{"def_id":172,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["const_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":13},"kind":"InherentImplBlock"}}},{"Ident":["offset",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":355,"col":4},"end":{"line":357,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Adds a signed offset to a pointer.\n\n`count` is in units of T; e.g., a `count` of 3 represents a pointer\noffset of `3 * size_of::<T>()` bytes.\n\n# Safety\n\nIf any of the following conditions are violated, the result is Undefined Behavior:\n\n* The offset in bytes, `count * size_of::<T>()`, computed on mathematical integers (without\n\"wrapping around\"), must fit in an `isize`.\n\n* Let `result` be `self.addr() + count * size_of::<T>()`, computed on mathematical integers.\nThis must fit in a `usize`.\n\n* If the computed offset is non-zero, then `self` must be [derived from][crate::ptr#provenance] a pointer to some\n[allocation], and the entire memory range between `self` and `result`\n(i.e., `min(self.addr(), result)..max(self.addr(), result)`)\nmust be in bounds of that allocation.\n\nAllocations can never be larger than `isize::MAX` bytes and they can only contain addresses\nrepresentable by `usize`, so technically the last condition implies the first two. This implies, for\ninstance, that `vec.as_ptr().offset(vec.len() as isize)` (for `vec: Vec<T>`) is always safe.\n\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" Consider using [`wrapping_offset`](#method.wrapping_offset) instead if these constraints are"},{"DocComment":" difficult to satisfy. The only advantage of this method is that it"},{"DocComment":" enables more aggressive compiler optimizations."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: *const u8 = s.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(*ptr.offset(1) as char, '2');"},{"DocComment":"     assert_eq!(*ptr.offset(2) as char, '3');"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":26,"beg":{"line":354,"col":4},"end":{"line":354,"col":19}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":59},{"Deduplicated":231}],"output":{"Deduplicated":59}},"src":"Normal","body":"Opaque"},{"def_id":173,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["copy_nonoverlapping",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":553,"col":0},"end":{"line":553,"col":84}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Copies `count * size_of::<T>()` bytes from `src` to `dst`. The source"},{"DocComment":" and destination must *not* overlap."},{"DocComment":""},{"DocComment":" For regions of memory which might overlap, use [`copy`] instead."},{"DocComment":""},{"DocComment":" `copy_nonoverlapping` is semantically equivalent to C's [`memcpy`], but"},{"DocComment":" with the source and destination arguments swapped,"},{"DocComment":" and `count` counting the number of `T`s instead of bytes."},{"DocComment":""},{"DocComment":" The copy is \"untyped\" in the sense that data may be uninitialized or otherwise violate the"},{"DocComment":" requirements of `T`. The initialization state is preserved exactly."},{"DocComment":""},{"DocComment":" [`memcpy`]: https://en.cppreference.com/w/c/string/byte/memcpy"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `src` must be [valid] for reads of `count * size_of::<T>()` bytes or that number must be 0."},{"DocComment":""},{"DocComment":" * `dst` must be [valid] for writes of `count * size_of::<T>()` bytes or that number must be 0."},{"DocComment":""},{"DocComment":" * Both `src` and `dst` must be properly aligned."},{"DocComment":""},{"DocComment":" * The region of memory beginning at `src` with a size of `count *"},{"DocComment":"   size_of::<T>()` bytes must *not* overlap with the region of memory"},{"DocComment":"   beginning at `dst` with the same size."},{"DocComment":""},{"DocComment":" Like [`read`], `copy_nonoverlapping` creates a bitwise copy of `T`, regardless of"},{"DocComment":" whether `T` is [`Copy`]. If `T` is not [`Copy`], using *both* the values"},{"DocComment":" in the region beginning at `*src` and the region beginning at `*dst` can"},{"DocComment":" [violate memory safety][read-ownership]."},{"DocComment":""},{"DocComment":" Note that even if the effectively copied size (`count * size_of::<T>()`) is"},{"DocComment":" `0`, the pointers must be properly aligned."},{"DocComment":""},{"DocComment":" [`read`]: crate::ptr::read"},{"DocComment":" [read-ownership]: crate::ptr::read#ownership-of-the-returned-value"},{"DocComment":" [valid]: crate::ptr#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Manually implement [`Vec::append`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" /// Moves all the elements of `src` into `dst`, leaving `src` empty."},{"DocComment":" fn append<T>(dst: &mut Vec<T>, src: &mut Vec<T>) {"},{"DocComment":"     let src_len = src.len();"},{"DocComment":"     let dst_len = dst.len();"},{"DocComment":""},{"DocComment":"     // Ensure that `dst` has enough capacity to hold all of `src`."},{"DocComment":"     dst.reserve(src_len);"},{"DocComment":""},{"DocComment":"     unsafe {"},{"DocComment":"         // The call to add is always safe because `Vec` will never"},{"DocComment":"         // allocate more than `isize::MAX` bytes."},{"DocComment":"         let dst_ptr = dst.as_mut_ptr().add(dst_len);"},{"DocComment":"         let src_ptr = src.as_ptr();"},{"DocComment":""},{"DocComment":"         // Truncate `src` without dropping its contents. We do this first,"},{"DocComment":"         // to avoid problems in case something further down panics."},{"DocComment":"         src.set_len(0);"},{"DocComment":""},{"DocComment":"         // The two regions cannot overlap because mutable references do"},{"DocComment":"         // not alias, and two different vectors cannot own the same"},{"DocComment":"         // memory."},{"DocComment":"         ptr::copy_nonoverlapping(src_ptr, dst_ptr, src_len);"},{"DocComment":""},{"DocComment":"         // Notify `dst` that it now holds the contents of `src`."},{"DocComment":"         dst.set_len(dst_len + src_len);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut a = vec!['r'];"},{"DocComment":" let mut b = vec!['u', 's', 't'];"},{"DocComment":""},{"DocComment":" append(&mut a, &mut b);"},{"DocComment":""},{"DocComment":" assert_eq!(a, &['r', 'u', 's', 't']);"},{"DocComment":" assert!(b.is_empty());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Vec::append`]: ../../std/vec/struct.Vec.html#method.append"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ptr_copy_nonoverlapping","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated"