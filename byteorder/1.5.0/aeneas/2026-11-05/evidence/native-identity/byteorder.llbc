n be"},{"DocComment":" retrieved from the `into_remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks_mut`]."},{"DocComment":""},{"DocComment":" See [`chunks_mut`] for a variant of this iterator that also returns the remainder as a"},{"DocComment":" smaller chunk, and [`rchunks_exact_mut`] for the same iterator but starting at the end of"},{"DocComment":" the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks_mut`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = &mut [0, 0, 0, 0, 0];"},{"DocComment":" let mut count = 1;"},{"DocComment":""},{"DocComment":" for chunk in v.chunks_exact_mut(2) {"},{"DocComment":"     for elem in chunk.iter_mut() {"},{"DocComment":"         *elem += count;"},{"DocComment":"     }"},{"DocComment":"     count += 1;"},{"DocComment":" }"},{"DocComment":" assert_eq!(v, &[1, 1, 2, 2, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks_mut`]: slice::chunks_mut"},{"DocComment":" [`rchunks_exact_mut`]: slice::rchunks_exact_mut"},{"DocComment":" [`as_chunks_mut`]: slice::as_chunks_mut"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1290,"col":4},"end":{"line":1290,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"ind