]}]},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Value":[1851,{"data":{"file_id":0,"beg":{"line":129,"col":4},"end":{"line":129,"col":5}},"generated_from_span":null}]},"id":5388,"kind":{"StorageDead":20},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5391,"kind":{"StorageDead":17},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5394,"kind":{"StorageDead":14},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5397,"kind":{"StorageDead":11},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5400,"kind":{"StorageDead":8},"comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5403,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5404,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Value":[1852,{"data":{"file_id":0,"beg":{"line":130,"col":1},"end":{"line":130,"col":1}},"generated_from_span":null}]},"id":5419,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":1852},"id":5420,"kind":"Return","comments_before":[]}]}]}},"comments_before":[]},{"span":{"Deduplicated":1831},"id":5422,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"Deduplicated":1831},"id":5423,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"Value":[1853,{"data":{"file_id":0,"beg":{"line":114,"col":8},"end":{"line":114,"col":9}},"generated_from_span":null}]},"id":5424,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":0}},{"Use":[{"Const":{"Deduplicated":2}},"Yes"]}]},"comments_before":[]},{"span":{"Deduplicated":1851},"id":5425,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":1852},"id":5440,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":1852},"id":5441,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":144,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["copy_nonoverlapping",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":553,"col":0},"end":{"line":553,"col":84}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Copies `count * size_of::<T>()` bytes from `src` to `dst`. The source"},{"DocComment":" and destination must *not* overlap."},{"DocComment":""},{"DocComment":" For regions of memory which might overlap, use [`copy`] instead."},{"DocComment":""},{"DocComment":" `copy_nonoverlapping` is semantically equivalent to C's [`memcpy`], but"},{"DocComment":" with the source and destination arguments swapped,"},{"DocComment":" and `count` counting the number of `T`s instead of bytes."},{"DocComment":""},{"DocComment":" The copy is \"untyped\" in the sense that data may be uninitialized or otherwise violate the"},{"DocComment":" requirements of `T`. The initialization state is preserved exactly."},{"DocComment":""},{"DocComment":" [`memcpy`]: https://en.cppreference.com/w/c/string/byte/memcpy"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `src` must be [valid] for reads of `count * size_of::<T>()` bytes or that number must be 0."},{"DocComment":""},{"DocComment":" * `dst` must be [valid] for writes of `count * size_of::<T>()` bytes or that number must be 0."},{"DocComment":""},{"DocComment":" * Both `src` and `dst` must be properly aligned."},{"DocComment":""},{"DocComment":" * The region of memory beginning at `src` with a size of `count *"},{"DocComment":"   size_of::<T>()` bytes must *not* overlap with the region of memory"},{"DocComment":"   beginning at `dst` with the same size."},{"DocComment":""},{"DocComment":" Like [`read`], `copy_nonoverlapping` creates a bitwise copy of `T`, regardless of"},{"DocComment":" whether `T` is [`Copy`]. If `T` is not [`Copy`], using *both* the values"},{"DocComment":" in the region beginning at `*src` and the region beginning at `*dst` can"},{"DocComment":" [violate memory safety][read-ownership]."},{"DocComment":""},{"DocComment":" Note that even if the effectively copied size (`count * size_of::<T>()`) is"},{"DocComment":" `0`, the pointers must be properly aligned."},{"DocComment":""},{"DocComment":" [`read`]: crate::ptr::read"},{"DocComment":" [read-ownership]: crate::ptr::read#ownership-of-the-returned-value"},{"DocComment":" [valid]: crate::ptr#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Manually implement [`Vec::append`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" /// Moves all the elements of `src` into `dst`, leaving `src` empty."},{"DocComment":" fn append<T>(dst: &mut Vec<T>, src: &mut Vec<T>) {"},{"DocComment":"     let src_len = src.len();"},{"DocComment":"     let dst_len = dst.len();"},{"DocComment":""},{"DocComment":"     // Ensure that `dst` has enough capacity to hold all of `src`."},{"DocComment":"     dst.reserve(src_len);"},{"DocComment":""},{"DocComment":"     unsafe {"},{"DocComment":"         // The call to add is always safe because `Vec` will never"},{"DocComment":"         // allocate more than `isize::MAX` bytes."},{"DocComment":"         let dst_ptr = dst.as_mut_ptr().add(dst_len);"},{"DocComment":"         let src_ptr = src.as_ptr();"},{"DocComment":""},{"DocComment":"         // Truncate `src` without dropping its contents. We do this first,"},{"DocComment":"         // to avoid problems in case something further down panics."},{"DocComment":"         src.set_len(0);"},{"DocComment":""},{"DocComment":"         // The two regions cannot overlap because mutable references do"},{"DocComment":"         // not alias, and two different vectors cannot own the same"},{"DocComment":"         // memory."},{"DocComment":"         ptr::copy_nonoverlapping(src_ptr, dst_ptr, src_len);"},{"DocComment":""},{"DocComment":"         // Notify `dst` that it now holds the contents of `src`."},{"DocComment":"         dst.set_len(dst_len + src_len);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut a = vec!['r'];"},{"DocComment":" let mut b = vec!['u', 's', 't'];"},{"DocComment":""},{"DocComment":" append(&mut a, &mut b);"},{"DocComment":""},{"DocComment":" assert_eq!(a, &['r', 'u', 's', 't']);"},{"DocComment":" assert!(b.is_empty());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Vec::append`]: ../../std/vec/struct.Vec.html#method.append"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ptr_copy_nonoverlapping","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":97},{"Deduplicated":99},{"Deduplicated":0}],"output":{"Deduplicated":32}},"src":"Normal","body":"Opaque"},{"def_id":145,"item_meta":{"name":[{"Ident":["byteorder",0]},{"Ident":["pack_size128",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":133,"col":0},"end":{"line":167,"col":1}},"generated_from_span":null}},"source_text":"fn pack_size128(n: u128) -> usize {\n    if n < 1 << 8 {\n        1\n    } else if n < 1 << 16 {\n        2\n    } else if n < 1 << 24 {\n        3\n    } else if n < 1 << 32 {\n        4\n    } else if n < 1 << 40 {\n        5\n    } else if n < 1 << 48 {\n        6\n    } else if n < 1 << 56 {\n        7\n    } else if n < 1 << 64 {\n        8\n    } else if n < 1 << 72 {\n        9\n    } else if n < 1 << 80 {\n        10\n    } else if n < 1 << 88 {\n        11\n    } else if n < 1 << 96 {\n        12\n    } else if n < 1 << 104 {\n        13\n    } else if n < 1 << 112 {\n        14\n    } else if n < 1 <