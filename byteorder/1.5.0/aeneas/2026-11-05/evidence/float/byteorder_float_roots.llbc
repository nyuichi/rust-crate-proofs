},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"let n = 0x1Au128;"},{"DocComment":""},{"DocComment":" if cfg!(target_endian = \"big\") {"},{"DocComment":"     assert_eq!(n.to_be(), n)"},{"DocComment":" } else {"},{"DocComment":"     assert_eq!(n.to_be(), n.swap_bytes())"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":11}],"output":{"Deduplicated":11}},"src":"Normal","body":"Opaque"},{"def_id":173,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":5},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":1243,"col":4},"end":{"line":1243,"col":77}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are slices and do not overlap. If `chunk_size` does not divide the length of the"},{"DocComment":" slice, then the last up to `chunk_size-1` elements will be omitted and can be retrieved"},{"DocComment":" from the `remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a smaller"},{"DocComment":" chunk, and [`rchunks_exact`] for the same iterator but starting at the end of the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1242,"col":4},"end":{"line":1242,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":14},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21}