lEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[55,{"data":{"file_id":7,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":3},{"Deduplicated":4},{"Deduplicated":14}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":7,"beg":{"line":178,"col":4},"end":{"line":178,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[53,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":3},"Mut"]}]},{"Deduplicated":4}],"output":{"Deduplicated":48}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":4},{"Deduplicated":14}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":4,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":189,"col":0},"end":{"line":189,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Base trait for random number generators and random data sources"},{"DocComment":""},{"DocComment":" This trait provides a base interface designed to support efficient usage of"},{"DocComment":" (`u32`, `u64`) word generators, block generators and random data sources."},{"DocComment":" There is no required relationship between the output of each method or any"},{"DocComment":" requirement to use all generated random bits; for example an implementation"},{"DocComment":" of [`try_fill_bytes`](Self::try_fill_bytes) may discard some generated bytes"},{"DocComment":" to avoid storing a partially used word or block."},{"DocComment":""},{"DocComment":" # Requirements"},{"DocComment":""},{"DocComment":" ### Quality and length"},{"DocComment":""},{"DocComment":" Implementions should produce bits uniformly: each output value should be"},{"DocComment":" equally likely, without observable patterns in successive outputs or"},{"DocComment":" between the output streams of multiple instances of an implementation using"},{"DocComment":" different seeds or streams (where supported by the implementation)."},{"DocComment":""},{"DocComment":" Pathological implementations (e.g. constant or counting generators which"},{"DocComment":" rarely change some bits) may cause issues in consumers of random data, for"},{"DocComment":" example dead-locks in rejection samplers and obviously non-random output"},{"DocComment":" (e.g. a counting generator may result in apparently-constant output from a"},{"DocComment":" uniform-ranged distribution)."},{"DocComment":""},{"DocComment":" Cryptographically unpredictable output is not a requirement of this trait,"},{"DocComment":" but is a requirement of [`TryCryptoRng`]."},{"DocComment":""},{"DocComment":" In practice, most implementations are pseudo-random number generators with a"},{"DocComment":" finite *period* or *cycle length*, and (among non-cryptographic PRNGs)"},{"DocComment":" statistical anomalies may appear long before a cycle occurs. An"},{"DocComment":" implementation should ensure its period is sufficiently long that no"},{"DocComment":" anomalies are likely to appear in usage and/or document its limitations."},{"DocComment":""},{"DocComment":" For more on PRNG quality and period, see [The Rust Rand Book: Quality][0]."},{"DocComment":""},{"DocComment":" [0]: https://rust-random.github.io/book/guide-rngs.html#quality"},{"DocComment":""},{"DocComment":" ### Reproducibility"},{"DocComment":""},{"DocComment":" Algorithmic generators implementing [`SeedableRng`] should normally have"},{"DocComment":" *portable, reproducible* output, i.e. fix Endianness when converting values"},{"DocComment":" to avoid platform differences, and avoid making any changes which affect"},{"DocComment":" output (except by communicating that the release has breaking changes)."},{"DocComment":" See also [The Rust Rand Book: Reproducibility][1]."},{"DocComment":""},{"DocComment":" [1]: https://rust-random.github.io/book/crate-reprod.html"},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" Often, usage of the infallible trait [`Rng`] or its extension trait"},{"DocComment":" [`rand::Rng`] is preferred to direct usage of `TryRng`."},{"DocComment":" Many implementations of `TryRng` (those with <code>type Error = [Infallible][]</code>)"},{"DocComment":" already implement [`Rng`]; in other cases [`UnwrapErr`] may be used to obtain"},{"DocComment":" an implementation of [`Rng`]."},{"DocComment":""},{"DocComment":" # Implementing `TryRng`"},{"DocComment":""},{"DocComment":" Most algorithmic generators (i.e. pseudo-random number generators or PRNGs)"},{"DocComment":" never fail; in this case type `Error` should be [`Infallible`]; in this case"},{"DocComment":" trait `Rng` is implemented automatically. Cycling is not considered an"},{"DocComment":" error."},{"DocComment":""},{"DocComment":" Small PRNGs often yield either `u32` or `u64` natively."},{"DocComment":" Module [`crate::utils`] provides utilities to help implement other methods."},{"DocComment":""},{"DocComment":" Byte sources may implement [`try_fill_bytes`](Self::try_fill_bytes)"},{"DocComment":" natively."},{"DocComment":" Module [`crate::utils`] provides utilities to help implement other methods."},{"DocComment":""},{"DocComment":" Block generators (which produce `[u32; N]` or `[u64; N]` for some fixed `N`)"},{"DocComment":" should make use of the [`crate::block`] module."},{"DocComment":""},{"DocComment":" With regards to other traits:"},{"DocComment":""},{"DocComment":" - **Do not** implement [`Default`] for seedable pseudorandom generators,"},{"DocComment":"   though the trait may be implemented for stateless interfaces and"},{"DocComment":"   auto-seeding generators."},{"DocComment":" - **Do** implement [`SeedableRng`] for seedable pseudorandom generators. See"},{"DocComment":"   [Reproducibility](#reproducibility) above."},{"DocComment":" - Implement [`Clone`] for non-cryptographic PRNGs but consider not doing so"},{"DocComment":"   for cryptographic generators to avoid the risk of key-stream duplication."},{"DocComment":" - **Do not** implement [`Copy`] since accidental copies may cause repeated"},{"DocComment":"   values."},{"DocComment":" - Implement [`Debug`](core::fmt::Debug), except that cryptographic PRNGs"},{"DocComment":"   should use a custom implementation which avoids leaking internal state (or"},{"DocComment":"   the subset of this derived from the key)."},{"DocComment":" - [`Eq`] and [`PartialEq`] could be implemented, but are probably not useful."},{"DocComment":""},{"DocComment":" [`rand::Rng`]: https://docs.rs/rand/latest/rand/trait.Rng.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[56,{"data":{"file_id":9,"beg":{"line":193,"col":16},"end":{"line":193,"col":34}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_next_u32","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]},{"Ident":["try_next_u32",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":196,"col":4},"end":{"line":196,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u32`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item