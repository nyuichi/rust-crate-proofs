cComment":""},{"DocComment":" The provided value will be used as an element of the resulting array and"},{"DocComment":" will be cloned N - 1 times to fill up the rest. If N is zero, the value"},{"DocComment":" will be dropped."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Creating multiple copies of a `String`:"},{"DocComment":" ```rust"},{"DocComment":" use std::array;"},{"DocComment":""},{"DocComment":" let string = \"Hello there!\".to_string();"},{"DocComment":" let strings = array::repeat(string);"},{"DocComment":" assert_eq!(strings, [\"Hello there!\", \"Hello there!\"]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[{"clause_id":0,"span":{"Value":[1,{"data":{"file_id":2,"beg":{"line":53,"col":17},"end":{"line":53,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3}],"output":{"Deduplicated":9}},"src":"Normal","body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":389,"col":4},"end":{"line":389,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagno