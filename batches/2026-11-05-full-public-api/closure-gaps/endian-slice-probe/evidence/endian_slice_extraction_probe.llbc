9},"ty":{"Deduplicated":54}},"safety":"Inherit"},"on_unwind":{"span":{"Deduplicated":123},"id":88,"statements":[{"span":{"Deduplicated":151},"id":279,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":151},"id":280,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"Value":[158,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":54,"col":36},"end":{"line":54,"col":37}}}]},"id":282,"kind":{"StorageDead":10},"comments_before":[]},{"span":{"Deduplicated":150},"id":283,"kind":{"Assign":[{"kind":{"Local":8},"ty":{"Deduplicated":26}},{"UnaryOp":[{"Cast":{"RawPtr":[{"Deduplicated":54},{"Deduplicated":26}]}},{"Move":{"kind":{"Local":9},"ty":{"Deduplicated":54}}}]}]},"comments_before":[]},{"span":{"Value":[159,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":54,"col":49},"end":{"line":54,"col":50}}}]},"id":284,"kind":{"StorageDead":9},"comments_before":[]},{"span":{"Value":[160,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":54,"col":21},"end":{"line":54,"col":50}}}]},"id":285,"kind":{"Assign":[{"kind":{"Local":7},"ty":{"Deduplicated":7}},{"Use":[{"Copy":{"kind":{"Projection":[{"kind":{"Local":8},"ty":{"Deduplicated":26}},"Deref"]},"ty":{"Deduplicated":7}}},"Yes"]}]},"comments_before":[]},{"span":{"Value":[161,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":54,"col":16},"end":{"line":54,"col":53}}}]},"id":286,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":48}},{"Aggregate":[{"Adt":[{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]},"builtin":null},null,null]},[{"Move":{"kind":{"Local":7},"ty":{"Deduplicated":7}}}]]}]},"comments_before":[]},{"span":{"Value":[162,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":54,"col":52},"end":{"line":54,"col":53}}}]},"id":287,"kind":{"StorageDead":7},"comments_before":[]},{"span":{"Value":[163,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":55,"col":12},"end":{"line":55,"col":13}}}]},"id":288,"kind":{"StorageDead":8},"comments_before":[]},{"span":{"Value":[164,{"data":{"file_id":11,"beg":{"line":183,"col":0},"end":{"line":183,"col":30}},"generated_from_span":{"file_id":11,"beg":{"line":55,"col":13},"end":{"line":55,"col":13}}}]},"id":290,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":164},"id":291,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["size_of",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":375,"col":0},"end":{"line":375,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the size of a type in bytes."},{"DocComment":""},{"DocComment":" More specifically, this is the offset in bytes between successive elements"},{"DocComment":" in an array with that item type including alignment padding. Thus, for any"},{"DocComment":" type `T` and length `n`, `[T; n]` has a size of `n * size_of::<T>()`."},{"DocComment":""},{"DocComment":" In general, the size of a type is not stable across compilations, but"},{"DocComment":" specific types such as primitives are."},{"DocComment":""},{"DocComment":" The following table gives the size for primitives."},{"DocComment":""},{"DocComment":" Type | `size_of::<Type>()`"},{"DocComment":" ---- | ---------------"},{"DocComment":" () | 0"},{"DocComment":" bool | 1"},{"DocComment":" u8 | 1"},{"DocComment":" u16 | 2"},{"DocComment":" u32 | 4"},{"DocComment":" u64 | 8"},{"DocComment":" u128 | 16"},{"DocComment":" i8 | 1"},{"DocComment":" i16 | 2"},{"DocComment":" i32 | 4"},{"DocComment":" i64 | 8"},{"DocComment":" i128 | 16"},{"DocComment":" f32 | 4"},{"DocComment":" f64 | 8"},{"DocComment":" char | 4"},{"DocComment":""},{"DocComment":" Furthermore, `usize` and `isize` have the same size."},{"DocComment":""},{"DocComment":" The types [`*const T`], `&T`, [`Box<T>`], [`Option<&T>`], and `Option<Box<T>>` all have"},{"DocComment":" the same size. If `T` is `Sized`, all of those types have the same size as `usize`."},{"DocComment":""},{"DocComment":" The mutability of a pointer does not change its size. As such, `&T` and `&mut T`"},{"DocComment":" have the same size. Likewise for `*const T` and `*mut T`."},{"DocComment":""},{"DocComment":" # Size of `#[repr(C)]` items"},{"DocComment":""},{"DocComment":" The `C` representation for items has a defined layout. With this layout,"},{"DocComment":" the size of items is also stable as long as all fields have a stable size."},{"DocComment":""},{"DocComment":" ## Size of Structs"},{"DocComment":""},{"DocComment":" For `struct`s, the size is determined by the following algorithm."},{"DocComment":""},{"DocComment":" For each field in the struct ordered by declaration order:"},{"DocComment":""},{"DocComment":" 1. Add the size of the field."},{"DocComment":" 2. Round up the current size to the nearest multiple of the next field's [alignment]."},{"DocComment":""},{"DocComment":" Finally, round the size of the struct to the nearest multiple of its [alignment]."},{"DocComment":" The alignment of the struct is usually the largest alignment of all its"},{"DocComment":" fields; this can be changed with the use of `repr(align(N))`."},{"DocComment":""},{"DocComment":" Unlike `C`, zero sized structs are not rounded up to one byte in size."},{"DocComment":""},{"DocComment":" ## Size of Enums"},{"DocComment":""},{"DocComment":" Enums that carry no data other than the discriminant have the same size as C enums"},{"DocComment":" on the platform they are compiled for."},{"DocComment":""},{"DocComment":" ## Size of Unions"},{"DocComment":""},{"DocComment":" The size of a union is the size of its largest field."},{"DocComment":""},{"DocComment":" Unlike `C`, zero sized unions are not rounded up to one byte in size."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // Some primitives"},{"DocComment":" assert_eq!(4, size_of::<i32>());"},{"DocComment":" assert_eq!(8, size_of::<f64>());"},{"DocComment":" assert_eq!(0, size_of::<()>());"},{"DocComment":""},{"DocComment":" // Some arrays"},{"DocComment":" assert_eq!(8, size_of::<[i32; 2]>());"},{"DocComment":" assert_eq!(12, size_of::<[i32; 3]>());"},{"DocComment":" assert_eq!(0, size_of::<[i32; 0]>());"},{"DocComment":""},{"DocComment":""},{"DocComment":" // Pointer size equality"},{"DocComment":" assert_eq!(size_of::<&i32>(), size_of::<*const i32>());"},{"DocComment":" assert_eq!(size_of::<&i32>(), size_of::<Box<i32>>());"},{"DocComment":" assert_eq!(size_of::<&i32>(), size_of::<Option<&i32>>());"},{"DocComment":" assert_eq!(size_of::<Box<i32>>(), size_of::<Option<Box<i32>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `#[repr(C)]`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[repr(C)]"},{"DocComment":" struct FieldStruct {"},{"DocComment":"     first: u8,"},{"DocComment":"     second: u16,"},{"DocComment":"     third: u8"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // The size of the first field is 1, so add 1 to the size. Size is 1."},{"DocComment":" // The alignment of the second field is 2, so add 1 to the size for padding. Size is 2."},{"DocComment":" // The size of the second field is 2, so add 2 to the size. Size is 4."},{"DocComment":" // The alignment of the third field is 1, so add 0 to the size for padding. Size is 4."},{"DocComment":" // The size of the third field is 1, so add 1 to the size. Size is 5."},{"DocComment":" // Finally, the alignment of the struct is 2 (because the largest alignment amongst its"},{"DocComment":" // fields is 2), so add 1 to the size for padding. Size is 6."},{"DocComment":" assert_eq!(6, size_of::<FieldStruct>());"},{"DocComment":""},{"DocComment":" #[repr(C)]"},{"DocComment":" struct TupleStruct(u8, u16, u8);"},{"DocComment":""},{"DocComment":" // Tuple structs follow the same rules."},{"DocComment":" assert_eq!(6, size_of::<TupleStruct>());"},{"DocComment":""},{"DocComment":" // Note that reordering the fields can lower the size. We can remove both padding bytes"},{"DocComment":" // by putting `third` before `second`."},{"DocComment":" #[repr(C)]"},{"DocComment":" struct FieldStructOptimized {"},{"DocComment":"     first: u8,"},{"DocComment":"     third: u8,"},{"DocComment":"     second: u16"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(4, size_of::<FieldStructOptimized>());"},{"DocComment":""},{"DocComment":" // Union size is the size of the largest field."},{"DocComment":" #[repr(C)]"},{"DocComment":" union ExampleUnion {"},{"DocComment":"     smaller: u8,"},{"DocComment":"     larger: u16"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(2, size_of::<ExampleUnion>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [alignment]: align_of"},{"DocComment":" [`*const T`]: primitive@pointer"},{"DocComment":" [`Box<T>`]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`Option<&T>`]: crate::option::Option"},{"DocComment":""}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"mem_size_of","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":0}},"src":"Normal","body":"Opaque"},{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":124,"col":0},"end":{"line":124,"col":80}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Forms a slice from a pointer and a length."},{"DocComment":""},{"DocComment":" The `len` argument is the number of **elements**, not the number of bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for reads for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations. See [below](#incorrect-usage)"},{"DocComment":"       for an example incorrectly not taking this into account."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be mutated for the duration"},{"DocComment":"   of lifetime `'a`, except inside an `UnsafeCell`."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" # Caveat"},{"DocComment":""},{"DocComment":" The lifetime for the returned slice is inferred from its usage. To"},{"DocComment":" prevent accidental misuse, it's suggested to tie the lifetime to whichever"},{"DocComment":" source lifetime is safe in the context, such as by providing a helper"},{"DocComment":" function taking the lifetime of a host value for the slice, or by explicit"},{"DocComment":" annotation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" // manifest a slice for a single element"},{"DocComment":" let x = 42;"},{"DocComment":" let ptr = &x as *const _;"},{"DocComment":" let slice = unsafe { slice::from_raw_parts(ptr, 1) };"},{"DocComment":" assert_eq!(slice[0], 42);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Incorrect usage"},{"DocComment":""},{"DocComment":" The following `join_slices` function is **unsound** ⚠️"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" fn join_slices<'a, T>(fst: &'a [T], snd: &'a [T]) -> &'a [T] {"},{"DocComment":"     let fst_end = fst.as_ptr().wrapping_add(fst.len());"},{"DocComment":"     let snd_start = snd.as_ptr();"},{"DocComment":"     assert_eq!(fst_end, snd_start, \"Slices must be contiguous!\");"},{"DocComment":"     unsafe {"},{"DocComment":"         // The assertion above ensures `fst` and `snd` are contiguous, but they might"},{"DocComment":"         // still be contained within _different allocations_, in which case"},{"DocComment":"         // creating this slice is undefined behavior."},{"DocComment":"         slice::from_raw_parts(fst.as_ptr(), fst.len() + snd.len())"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     // `a` and `b` are different allocations..."},{"DocComment":"     let a = 42;"},{"DocComment":"     let b = 27;"},{"DocComment":"     // ... which may nevertheless be laid out contiguously in memory: | a | b |"},{"DocComment":"     let _ = join_slices(slice::from_ref(&a), slice::from_ref(&b)); // UB"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### FFI: Handling null pointers"},{"DocComment":""},{"DocComment":" In languages such as C++, pointers to empty collections are not guaranteed to be non-null."},{"DocComment":" When accepting such pointers, they have to be checked for null-ness to avoid undefined"},{"DocComment":" behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" /// Sum the elements of an FFI slice."},{"DocComment":" ///"},{"DocComment":" /// # Safety"},{"DocComment":" ///"},{"DocComment":" /// If ptr is not NULL, it must be correctly aligned and"},{"DocComment":" /// point to `len` initialized items of type `f32`."},{"DocComment":" unsafe extern \"C\" fn sum_slice(ptr: *const f32, len: usize) -> f32 {"},{"DocComment":"     let data = if ptr.is_null() {"},{"DocComment":"         // `len` is assumed to be 0."},{"DocComment":"         &[]"},{"DocComment":"     } else {"},{"DocComment":"         // SAFETY: see function docstring."},{"DocComment":"         unsafe { slice::from_raw_parts(ptr, len) }"},{"DocComment":"     };"},{"DocComment":"     data.into_iter().sum()"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // This could be the result of C++'s std::vector::data():"},{"DocComment":" let ptr = std::ptr::null();"},{"DocComment":" // And this could be std::vector::size():"},{"DocComment":" let len = 0;"},{"DocComment":" assert_eq!(unsafe { sum_slice(ptr, len) }, 0.0);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":13,"beg":{"line":123,"col":0},"end":{"line":123,"col":15}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"slice_from_raw_parts","has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":7},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":26},{"Deduplicated":0}],"output":{"Deduplicated":12}},"src":"Normal","body":"Opaque"},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts_mut",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":179,"col":0},"end":{"line":179,"col":86}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the same functionality as [`from_raw_parts`], except that a"},{"DocComment":" mutable slice is returned."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for both reads and writes for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be accessed through any other pointer"},{"DocComment":"   (not derived from the return value) for the duration of lifetime `'a`."},{"DocComment":"   Both read and write accesses are forbidden."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":13,"beg":{"line":178,"col":0},"end":{"line":178,"col":15}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"slice_from_raw_parts_mut","has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":7},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":28},{"Deduplicated":0}],"output":{"Deduplicated":15}},"src":"Normal","body":"Opaque"},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["len",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":118,"col":4},"end":{"line":118,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of elements in the slice."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.len(), 3);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"SliceLen","diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":7},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12}],"output":{"Deduplicated":0}},"src":"Normal","body":"Opaque"},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["as_ptr",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":730,"col":4},"end":{"line":730,"col":42}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a raw pointer to the slice's buffer."},{"DocComment":""},{"DocComment":" The caller must ensure that the slice outlives the pointer this"},{"DocComment":" function returns, or else it will end up dangling."},{"DocComment":""},{"DocComment":" The caller must also ensure that the memory the pointer (non-transitively) points to"},{"DocComment":" is never written to (except inside an `UnsafeCell`) using this pointer or any pointer"},{"DocComment":" derived from it. If you need to mutate the contents of the slice, use [`as_mut_ptr`]."},{"DocComment":""},{"DocComment":" Modifying the container referenced by this slice may cause its buffer"},{"DocComment":" to be reallocated, which would also make any pointers to it invalid."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &[1, 2, 4];"},{"DocComment":" let x_ptr = x.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     for i in 0..x.len() {"},{"DocComment":"         assert_eq!(x.get_unchecked(i), &*x_ptr.add(i));"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_mut_ptr`]: slice::as_mut_ptr"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":7},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12}],"output":{"Deduplicated":26}},"src":"Normal","body":"Opaque"},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["panicking",0]},{"Ident":["panic",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":138,"col":0},"end":{"line":138,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The underlying implementation of core's `panic!` macro when no formatting is used."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":15,"beg":{"line":135,"col":0},"end":{"line":135,"col":15}},"generated_from_span":null}}}}],"inline":"Never","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Panic","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[61,{"Ref":["Static",{"Value":[62,{"Adt":{"id":8,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Str"}}]},"Shared"]}]}],"output":{"Value":[63,"Never"]}},"src":"Normal","body":"Opaque"}],"global_decls":[null,null,null,null,null,null],"trait_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":194,"col":0},"end":{"line":194,"col":28}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A common trait that allows explicit creation of a duplicate value."},{"DocComment":""},{"DocComment":" Calling [`clone`] always produces a new value."},{"DocComment":" However, for types that are references to other data (such as smart pointers or references),"},{"DocComment":" the new value may still point to the same underlying data, rather than duplicating it."},{"DocComment":" See [`Clone::clone`] for more details."},{"DocComment":""},{"DocComment":" This distinction is especially important when using `#[derive(Clone)]` on structs containing"},{"DocComment":" smart pointers like `Arc<Mutex<T>>` - the cloned struct will share mutable state with the"},{"DocComment":" original."},{"DocComment":""},{"DocComment":" Differs from [`Copy`] in that [`Copy`] is implicit and an inexpensive bit-wise copy, while"},{"DocComment":" `Clone` is always explicit and may or may not be expensive. [`Copy`] has no methods, so you"},{"DocComment":" cannot change its behavior, but when implementing `Clone`, the `clone` method you provide"},{"DocComment":" may run arbitrary code."},{"DocComment":""},{"DocComment":" Since `Clone` is a supertrait of [`Copy`], any type that implements `Copy` must also implement"},{"DocComment":" `Clone`."},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields are `Clone`. The `derive`d"},{"DocComment":" implementation of [`Clone`] calls [`clone`] on each field."},{"DocComment":""},{"DocComment":" [`clone`]: Clone::clone"},{"DocComment":""},{"DocComment":" For a generic struct, `#[derive]` implements `Clone` conditionally by adding bound `Clone` on"},{"DocComment":" generic parameters."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // `derive` implements Clone for Reading<T> when T is Clone."},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct Reading<T> {"},{"DocComment":"     frequency: T,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## How can I implement `Clone`?"},{"DocComment":""},{"DocComment":" Types that are [`Copy`] should have a trivial implementation of `Clone`. More formally:"},{"DocComment":" if `T: Copy`, `x: T`, and `y: &T`, then `let x = y.clone();` is equivalent to `let x = *y;`."},{"DocComment":" Manual implementations should be careful to uphold this invariant; however, unsafe code"},{"DocComment":" must not rely on it to ensure memory safety."},{"DocComment":""},{"DocComment":" An example is a generic struct holding a function pointer. In this case, the"},{"DocComment":" implementation of `Clone` cannot be `derive`d, but can be implemented as:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Generate<T>(fn() -> T);"},{"DocComment":""},{"DocComment":" impl<T> Copy for Generate<T> {}"},{"DocComment":""},{"DocComment":" impl<T> Clone for Generate<T> {"},{"DocComment":"     fn clone(&self) -> Self {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If we `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Generate<T>(fn() -> T);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" the auto-derived implementations will have unnecessary `T: Copy` and `T: Clone` bounds:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # struct Generate<T>(fn() -> T);"},{"DocComment":""},{"DocComment":" // Automatically derived"},{"DocComment":" impl<T: Copy> Copy for Generate<T> { }"},{"DocComment":""},{"DocComment":" // Automatically derived"},{"DocComment":" impl<T: Clone> Clone for Generate<T> {"},{"DocComment":"     fn clone(&self) -> Generate<T> {"},{"DocComment":"         Generate(Clone::clone(&self.0))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The bounds are unnecessary because clearly the function itself should be"},{"DocComment":" copy- and cloneable even if its return type is not:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0599"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Generate<T>(fn() -> T);"},{"DocComment":""},{"DocComment":" struct NotCloneable;"},{"DocComment":""},{"DocComment":" fn generate_not_cloneable() -> NotCloneable {"},{"DocComment":"     NotCloneable"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" Generate(generate_not_cloneable).clone(); // error: trait bounds were not satisfied"},{"DocComment":" // Note: With the manual implementations the above line will compile."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Clone` and `PartialEq`/`Eq`"},{"DocComment":" `Clone` is intended for the duplication of objects. Consequently, when implementing"},{"DocComment":" both `Clone` and [`PartialEq`], the following property is expected to hold:"},{"DocComment":" ```text"},{"DocComment":" x == x -> x.clone() == x"},{"DocComment":" ```"},{"DocComment":" In other words, if an object compares equal to itself,"},{"DocComment":" its clone must also compare equal to the original."},{"DocComment":""},{"DocComment":" For types that also implement [`Eq`] – for which `x == x` always holds –"},{"DocComment":" this implies that `x.clone() == x` must always be true."},{"DocComment":" Standard library collections such as"},{"DocComment":" [`HashMap`], [`HashSet`], [`BTreeMap`], [`BTreeSet`] and [`BinaryHeap`]"},{"DocComment":" rely on their keys respecting this property for correct behavior."},{"DocComment":" Furthermore, these collections require that cloning a key preserves the outcome of the"},{"DocComment":" [`Hash`] and [`Ord`] methods. Thankfully, this follows automatically from `x.clone() == x`"},{"DocComment":" if `Hash` and `Ord` are correctly implemented according to their own requirements."},{"DocComment":""},{"DocComment":" When deriving both `Clone` and [`PartialEq`] using `#[derive(Clone, PartialEq)]`"},{"DocComment":" or when additionally deriving [`Eq`] using `#[derive(Clone, PartialEq, Eq)]`,"},{"DocComment":" then this property is automatically upheld – provided that it is satisfied by"},{"DocComment":" the underlying types."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on this property"},{"DocComment":" being satisfied."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Clone`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Clone` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Clone`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Clone`."},{"DocComment":""},{"DocComment":" [`HashMap`]: ../../std/collections/struct.HashMap.html"},{"DocComment":" [`HashSet`]: ../../std/collections/struct.HashSet.html"},{"DocComment":" [`BTreeMap`]: ../../std/collections/struct.BTreeMap.html"},{"DocComment":" [`BTreeSet`]: ../../std/collections/struct.BTreeSet.html"},{"DocComment":" [`BinaryHeap`]: ../../std/collections/struct.BinaryHeap.html"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Clone","diagnostic_item":"Clone","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"clone","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0]},{"Ident":["clone",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":236,"col":4},"end":{"line":236,"col":28}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a duplicate of the value."},{"DocComment":""},{"DocComment":" Note that what \"duplicate\" means varies by type:"},{"DocComment":" - For most types, this creates a deep, independent copy"},{"DocComment":" - For reference types like `&T`, this creates another reference to the same value"},{"DocComment":" - For smart pointers like [`Arc`] or [`Rc`], this increments the reference count"},{"DocComment":"   but still points to the same underlying data"},{"DocComment":""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html"},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(noop_method_call)]"},{"DocComment":" let hello = \"Hello\"; // &str implements Clone"},{"DocComment":""},{"DocComment":" assert_eq!(\"Hello\", hello.clone());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Example with a reference-counted type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex};"},{"DocComment":""},{"DocComment":" let data = Arc::new(Mutex::new(vec![1, 2, 3]));"},{"DocComment":" let data_clone = data.clone(); // Creates another Arc pointing to the same Mutex"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let mut lock = data.lock().unwrap();"},{"DocComment":"     lock.push(4);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Changes are visible through the clone because they share the same underlying data"},{"DocComment":" assert_eq!(*data_clone.lock().unwrap(), vec![1, 2, 3, 4]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"CloneFn","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[64,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":7},"Shared"]}]}],"output":{"Deduplicated":7}},"default":null},"kind":{"TraitMethod":[0,0]}},null],"vtable":null},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["Index",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":59,"col":0},"end":{"line":59,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in immutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for `*container.index(index)`,"},{"DocComment":" but only when used as an immutable value. If a mutable value is requested,"},{"DocComment":" [`IndexMut`] is used instead. This allows nice things such as"},{"DocComment":" `let value = v[index]` if the type of `value` implements [`Copy`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The following example implements `Index` on a read-only `NucleotideCount`"},{"DocComment":" container, enabling individual counts to be retrieved with index syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Index;"},{"DocComment":""},{"DocComment":" enum Nucleotide {"},{"DocComment":"     A,"},{"DocComment":"     C,"},{"DocComment":"     G,"},{"DocComment":"     T,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct NucleotideCount {"},{"DocComment":"     a: usize,"},{"DocComment":"     c: usize,"},{"DocComment":"     g: usize,"},{"DocComment":"     t: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Nucleotide> for NucleotideCount {"},{"DocComment":"     type Output = usize;"},{"DocComment":""},{"DocComment":"     fn index(&self, nucleotide: Nucleotide) -> &Self::Output {"},{"DocComment":"         match nucleotide {"},{"DocComment":"             Nucleotide::A => &self.a,"},{"DocComment":"             Nucleotide::C => &self.c,"},{"DocComment":"             Nucleotide::G => &self.g,"},{"DocComment":"             Nucleotide::T => &self.t,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let nucleotide_count = NucleotideCount {a: 14, c: 9, g: 10, t: 12};"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::A], 14);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::C], 9);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::G], 10);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::T], 12);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Index","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["Index",0]},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":73,"col":4},"end":{"line":73,"col":49}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the indexing (`conta