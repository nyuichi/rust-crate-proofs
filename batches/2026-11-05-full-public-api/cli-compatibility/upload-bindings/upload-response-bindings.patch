+/// Validate exact opt-in bindings returned by the official immutable SARIF upload.
+/// No catalogue alias fallback is permitted for this narrow source-key scope.
+fn exact_uploaded_bindings(project: &Project, tool: &crate::config::Tool, record: &record::Record,
+    bytes: &[u8], response: &Value, metadata: &Value) -> Result<Vec<(String, String)>> {
+    use sha2::{Digest, Sha256};
+    ensure!(project.name == "endian-type" && project.version == "0.2.0"
+        && tool.is_aeneas() && tool.exact_source_bindings.is_some(), "Unsupported uploaded binding scope");
+    let parsed: Value = serde_json::from_slice(bytes)?;
+    ensure!(parsed == record.sarif, "Upload bytes differ from the loaded immutable SARIF");
+    let run = &record.sarif["runs"][0];
+    let proof = &run["properties"]["proofs"];
+    let id = run["automationDetails"]["guid"].as_str().context("Missing run ID")?;
+    let digest = format!("{:x}", Sha256::digest(bytes));
+    ensure!(response["id"] == id && metadata["id"] == id
+        && response["sha256"] == digest && metadata["sha256"] == digest,
+        "Uploaded binding run/hash mismatch");
+    ensure!(metadata["crate"] == project.name && metadata["version"] == project.version
+        && metadata["tool_version_id"] == format!("aeneas-{}", tool.version)
+        && metadata["size"].as_u64() == Some(bytes.len() as u64), "Uploaded binding metadata mismatch");
+    ensure!(run["tool"]["driver"]["name"] == tool.name && run["tool"]["driver"]["version"] == tool.version, "Uploaded binding tool mismatch");
+    ensure!(proof["crate"] == project.name && proof["version"] == project.version
+        && proof["aeneas"] == crate::aeneas::configuration(tool)?, "Uploaded binding configuration mismatch");
+    let expected: BTreeSet<_> = tool.proofs.iter().map(|p| p.api.as_str()).collect();
+    let actual: BTreeSet<_> = record.contracts.iter().filter_map(|c|
+        (c.api_paths.len() == 1).then(|| c.api_paths[0].as_str())).collect();
+    ensure!(record.contracts.len() == 66 && expected.len() == 66 && actual == expected,
+        "Uploaded binding contract keys mismatch");
+    let apis = response["apis"].as_array().context("Missing uploaded API bindings")?;
+    ensure!(apis.len() == 66, "Uploaded binding count mismatch");
+    let mut ids = BTreeSet::new();
+    let mut out = Vec::new();
+    for (index, (api, contract)) in apis.iter().zip(&record.contracts).enumerate() {
+        let api_id = api["api_item_id"].as_str().context("Missing uploaded API ID")?;
+        ensure!(api["contract_index"].as_u64() == Some(index as u64)
+            && api["display_path"] == contract.api_paths[0] && api["origin"] == "recorded",
+            "Uploaded binding index/path/origin mismatch");
+        ensure!(api_id.len() == 64 && api_id.bytes().all(|c| c.is_ascii_hexdigit())
+            && ids.insert(api_id), "Duplicate or malformed uploaded API ID");
+        out.push((api_id.to_owned(), contract.api_paths[0].clone()));
+    }
+    Ok(out)
+}
 
