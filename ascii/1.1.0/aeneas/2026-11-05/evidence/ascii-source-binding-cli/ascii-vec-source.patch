+        record.sarif["runs"][0]["versionControlProvenance"][0]["revisionId"] =
+            json!(git(root, &["rev-parse", "HEAD"]));
+        fs::remove_file(&manifest).unwrap();
+        fs::write(&manifest, &manifest_bytes).unwrap();
+        assert!(
