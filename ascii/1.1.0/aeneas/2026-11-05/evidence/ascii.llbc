ption",0]},{"Ident":["Option",0]}],"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":598,"col":0},"end":{"line":598,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Option","diagnostic_item":"Option","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":602,"col":4},"end":{"line":602,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":606,"col":4},"end":{"line":606,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":606,"col":55},"end":{"line":606,"col":56}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":23}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[81,{"AtLeast":{"Value":[82,{"AlignTo":{"base":{"Value":[83,{"Plus":[{"Value":[84,{"Constant":{"Value":[39,[{"OffsetOf":[{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":23}],"const_generics":[],"trait_refs":[]},"builtin":null},1,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":26}]}]},"target_align":{"Deduplicated":29}}}]}}]}},"align":{"chosen":null,"guarantee":{"Value":[85,{"AtLeast":{"Deduplicated":29}}]}},"discriminator":null,"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]},{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":29}},"chosen":null}],"inhabited":{"Deduplicated":1},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":27,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["private",0]},{"Ident":["Internal",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":268,"col":4},"end":{"line":268,"col":23}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":58}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":59}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["any",0]},{"Ident":["TypeId",0]}],"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":724,"col":0},"end":{"line":724,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `TypeId` represents a globally unique identifier for a type."},{"DocComment":""},{"DocComment":" Each `TypeId` is an opaque object which does not allow inspection of what's"},{"DocComment":" inside but does allow basic operations such as cloning, comparison,"},{"DocComment":" printing, and showing."},{"DocComment":""},{"DocComment":" A `TypeId` is currently only available for types which ascribe to `'static`,"},{"DocComment":" but this limitation may be removed in the future."},{"DocComment":""},{"DocComment":" While `TypeId` implements `Hash`, `PartialOrd`, and `Ord`, it is worth"},{"DocComment":" noting that the hashes and ordering will vary between Rust releases. Beware"},{"DocComment":" of relying on them inside of your code!"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" Like other [`Rust`-representation][repr-rust] types, `TypeId`'s size and layout are unstable."},{"DocComment":" In particular, this means that you cannot rely on the size and layout of `TypeId` remaining the"},{"DocComment":" same between Rust releases; they are subject to change without prior notice between Rust"},{"DocComment":" releases."},{"DocComment":""},{"DocComment":" [repr-rust]: https://doc.rust-lang.org/reference/type-layout.html#r-layout.repr.rust.unspecified"},{"DocComment":""},{"DocComment":" # Danger of Improper Variance"},{"DocComment":""},{"DocComment":" You might think that subtyping is impossible between two static types,"},{"DocComment":" but this is false; there exists a static type with a static subtype."},{"DocComment":" To wit, `fn(&str)`, which is short for `for<'any> fn(&'any str)`, and"},{"DocComment":" `fn(&'static str)`, are two distinct, static types, and yet,"},{"DocComment":" `fn(&str)` is a subtype of `fn(&'static str)`, since any value of type"},{"DocComment":" `fn(&str)` can be used where a value of type `fn(&'static str)` is needed."},{"DocComment":""},{"DocComment":" This means that abstractions around `TypeId`, despite its"},{"DocComment":" `'static` bound on arguments, still need to worry about unnecessary"},{"DocComment":" and improper variance: it is advisable to strive for invariance"},{"DocComment":" first. The usability impact will be negligible, while the reduction"},{"DocComment":" in the risk of unsoundness will be most welcome."},{"DocComment":""},{"DocComment":" ## Examples"},{"DocComment":""},{"DocComment":" Suppose `SubType` is a subtype of `SuperType`, that is,"},{"DocComment":" a value of type `SubType` can be used wherever"},{"DocComment":" a value of type `SuperType` is expected."},{"DocComment":" Suppose also that `CoVar<T>` is a generic type, which is covariant over `T`"},{"DocComment":" (like many other types, including `PhantomData<T>` and `Vec<T>`)."},{"DocComment":""},{"DocComment":" Then, by covariance, `CoVar<SubType>` is a subtype of `CoVar<SuperType>`,"},{"DocComment":" that is, a value of type `CoVar<SubType>` can be used wherever"},{"DocComment":" a value of type `CoVar<SuperType>` is expected."},{"DocComment":""},{"DocComment":" Then if `CoVar<SuperType>` relies on `TypeId::of::<SuperType>()` to uphold any invariants,"},{"DocComment":" those invariants may be broken because a value of type `CoVar<SuperType>` can be created"},{"DocComment":" without going through any of its methods, like so:"},{"DocComment":" ```"},{"DocComment":" type SubType = fn(&());"},{"DocComment":" type SuperType = fn(&'static ());"},{"DocComment":" type CoVar<T> = Vec<T>; // imagine something more complicated"},{"DocComment":""},{"DocComment":" let sub: CoVar<SubType> = CoVar::new();"},{"DocComment":" // we have a `CoVar<SuperType>` instance without"},{"DocComment":" // *ever* having called `CoVar::<SuperType>::new()`!"},{"DocComment":" let fake_super: CoVar<SuperType> = sub;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following is an example program that tries to use `TypeId::of` to"},{"DocComment":" implement a generic type `Unique<T>` that guarantees unique instances for each `Unique<T>`,"},{"DocComment":" that is, for each type `T` there can be at most one value of type `Unique<T>` at any time."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" mod unique {"},{"DocComment":"     use std::any::TypeId;"},{"DocComment":"     use std::collections::BTreeSet;"},{"DocComment":"     use std::marker::PhantomData;"},{"DocComment":"     use std::sync::Mutex;"},{"DocComment":""},{"DocComment":"     static ID_SET: Mutex<BTreeSet<TypeId>> = Mutex::new(BTreeSet::new());"},{"DocComment":""},{"DocComment":"     // TypeId has only covariant uses, which makes Unique covariant over TypeAsId 🚨"},{"DocComment":"     #[derive(Debug, PartialEq)]"},{"DocComment":"     pub struct Unique<TypeAsId: 'static>("},{"DocComment":"         // private field prevents creation without `new` outside this module"},{"DocComment":"         PhantomData<TypeAsId>,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Unique<TypeAsId> {"},{"DocComment":"         pub fn new() -> Option<Self> {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (set.insert(TypeId::of::<TypeAsId>())).then(|| Self(PhantomData))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Drop for Unique<TypeAsId> {"},{"DocComment":"         fn drop(&mut self) {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (!set.remove(&TypeId::of::<TypeAsId>())).then(|| panic!(\"duplicity detected\"));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" use unique::Unique;"},{"DocComment":""},{"DocComment":" // `OtherRing` is a subtype of `TheOneRing`. Both are 'static, and thus have a TypeId."},{"DocComment":" type TheOneRing = fn(&'static ());"},{"DocComment":" type OtherRing = fn(&());"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let the_one_ring: Unique<TheOneRing> = Unique::new().unwrap();"},{"DocComment":"     assert_eq!(Unique::<TheOneRing>::new(), None);"},{"DocComment":""},{"DocComment":"     let other_ring: Unique<OtherRing> = Unique::new().unwrap();"},{"DocComment":"     // Use that `Unique<OtherRing>` is a subtype of `Unique<TheOneRing>` 🚨"},{"DocComment":"     let fake_one_ring: Unique<TheOneRing> = other_ring;"},{"DocComment":"     assert_eq!(fake_one_ring, the_one_ring);"},{"DocComment":""},{"DocComment":"     std::mem::forget(fake_one_ring);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"TypeId","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":69},"guarantee":null},"align":{"chosen":{"Deduplicated":4},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Request",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":588,"col":0},"end":{"line":588,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Request` supports generic, type-driven access to data. Its use is currently restricted to the"},{"DocComment":" standard library in cases where trait authors wish to allow trait implementors to share generic"},{"DocComment":" information across trait boundaries. The motivating and prototypical use case is"},{"DocComment":" `core::error::Error` which would otherwise require a method per concrete type (e.g."},{"DocComment":" `std::backtrace::Backtrace` instance that implementors want to expose to users)."},{"DocComment":""},{"DocComment":" # Data flow"},{"DocComment":""},{"DocComment":" To describe the intended data flow for Request objects, let's consider two conceptual users"},{"DocComment":" separated by API boundaries:"},{"DocComment":""},{"DocComment":" * Consumer - the consumer requests objects using a Request instance; e.g. a crate that offers"},{"DocComment":"   fancy `Error`/`Result` reporting to users wants to request a Backtrace from a given `dyn Error`."},{"DocComment":""},{"DocComment":" * Producer - the producer provides objects when requested via Request; e.g. a library with an"},{"DocComment":"   an `Error` implementation that automatically captures backtraces at the time instances are"},{"DocComment":"   created."},{"DocComment":""},{"DocComment":" The consumer only needs to know where to submit their request and is expected to handle the"},{"DocComment":" request not being fulfilled by the use of `Option<T>` in the responses offered by the producer."},{"DocComment":""},{"DocComment":" * A Producer initializes the value of one of its fields of a specific type. (or is otherwise"},{"DocComment":"   prepared to generate a value requested). e.g., `backtrace::Backtrace` or"},{"DocComment":"   `std::backtrace::Backtrace`."},{"DocComment":" * A Consumer requests an object of a specific type (say `std::backtrace::Backtrace`). In the"},{"DocComment":"   case of a `dyn Error` trait object (the Producer), there are functions called `request_ref` and"},{"DocComment":"   `request_value` to simplify obtaining an `Option<T>` for a given type."},{"DocComment":" * The Producer, when requested, populates the given Request object which is given as a mutable"},{"DocComment":"   reference."},{"DocComment":" * The Consumer extracts a value or reference to the requested type from the `Request` object"},{"DocComment":"   wrapped in an `Option<T>`; in the case of `dyn Error` the aforementioned `request_ref` and"},{"DocComment":"   `request_value` methods mean that `dyn Error` users don't have to deal with the `Request` type at"},{"DocComment":"   all (but `Error` implementors do). The `None` case of the `Option` suggests only that the"},{"DocComment":"   Producer cannot currently offer an instance of the requested type, not that it can't or never will."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The best way to demonstrate this is using an example implementation of `Error`'s `provide` trait"},{"DocComment":" method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(error_generic_member_access)]"},{"DocComment":" use core::fmt;"},{"DocComment":" use core::error::Request;"},{"DocComment":" use core::error::request_ref;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum MyLittleTeaPot {"},{"DocComment":"     Empty,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyBacktrace {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl MyBacktrace {"},{"DocComment":"     fn new() -> MyBacktrace {"},{"DocComment":"         // ..."},{"DocComment":"         # MyBacktrace {}"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Error {"},{"DocComment":"     backtrace: MyBacktrace,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Error {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Example Error\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl std::error::Error for Error {"},{"DocComment":"     fn provide<'a>(&'a self, request: &mut Request<'a>) {"},{"DocComment":"         request"},{"DocComment":"             .provide_ref::<MyBacktrace>(&self.backtrace);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let backtrace = MyBacktrace::new();"},{"DocComment":"     let error = Error { backtrace };"},{"DocComment":"     let dyn_error = &error as &dyn std::error::Error;"},{"DocComment":"     let backtrace_ref = request_ref::<MyBacktrace>(dyn_error).unwrap();"},{"DocComment":""},{"DocComment":"     assert!(core::ptr::eq(&error.backtrace, backtrace_ref));"},{"DocComment":"     assert!(request_ref::<MyLittleTeaPot>(dyn_error).is_none());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[86,{"AlignTo":{"base":{"Value":[87,{"AlignTo":{"base":{"Value":[88,{"Plus":[{"Deduplicated":69},{"Value":[89,{"FromMetadata":"DynSize"}]}]}]},"target_align":{"Value":[90,{"Max":[{"Value":[91,{"FromMetadata":"DynAlign"}]},{"Deduplicated":4}]}]}}}]},"target_align":{"Deduplicated":90}}}]},"guarantee":null},"align":{"chosen":{"Deduplicated":90},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeFull",0]}],"span":{"Untagged":{"data":{"file_id":20,"beg":{"line":44,"col":0},"end":{"line":44,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An unbounded range (`..`)."},{"DocComment":""},{"DocComment":" `RangeFull` is primarily used as a [slicing index], its shorthand is `..`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..` syntax is a `RangeFull`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(.., std::ops::RangeFull);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" for i in .. {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Used as a [slicing index], `RangeFull` produces the full array as a slice."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]); // This is the `RangeFull`"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeFull","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":58}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":59}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,null,null,null,null,{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Builtin":["VTable",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"VTable":{"dyn_predicate":{"binder":{"params":{"regions":[],"types":[{"index":0,"name":"_dyn","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"Dyn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":29}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":29},"Erased"]}],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2},"kind":"Dyn"}},"field_map":[],"supertrait_map":[]}},"kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Formatter",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":561,"col":0},"end":{"line":561,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Configuration for formatting."},{"DocComment":""},{"DocComment":" A `Formatter` represents various options related to formatting. Users do not"},{"DocComment":" construct `Formatter`s directly; a mutable reference to one is passed to"},{"DocComment":" the `fmt` method of all formatting traits, like [`Debug`] and [`Display`]."},{"DocComment":""},{"DocComment":" To interact with a `Formatter`, you'll call various methods to change the"},{"DocComment":" various options related to formatting. For examples, please see the"},{"DocComment":" documentation of the methods defined on `Formatter` below."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Formatter","has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Mutable"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Var":{"Free":0}},{"Var":{"Free":0}}]}],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":12},"guarantee":null},"align":{"chosen":{"Deduplicated":4},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":16},{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Error",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":111,"col":0},"end":{"line":111,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type which is returned from formatting a message into a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":58}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":59}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,{"def_id":40,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeInclusive",0]}],"span":{"Untagged":{"data":{"file_id":20,"beg":{"line":362,"col":0},"end":{"line":362,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range bounded inclusively below and above (`start..=end`)."},{"DocComment":""},{"DocComment":" The `RangeInclusive` `start..=end` contains all values with `x >= start`"},{"DocComment":" and `x <= end`. It is empty unless `start <= end`."},{"DocComment":""},{"DocComment":" This iterator is [fused], but the specific values of `start` and `end` after"},{"DocComment":" iteration has finished are **unspecified** other than that [`.is_empty()`]"},{"DocComment":" will return `true` once no more values will be produced."},{"DocComment":""},{"DocComment":" [fused]: crate::iter::FusedIterator"},{"DocComment":" [`.is_empty()`]: RangeInclusive::is_empty"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..=end` syntax is a `RangeInclusive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..=5), std::ops::RangeInclusive::new(3, 5));"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..=5).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]); // This is a `RangeInclusive`"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeInclusiveStruct","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},null,{"def_id":42,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Arguments",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":716,"col":0},"end":{"line":716,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" This structure represents a safely precompiled version of a format string"},{"DocComment":" and its arguments. This cannot be generated at runtime because it cannot"},{"DocComment":" safely be done, so no constructors are given and the fie