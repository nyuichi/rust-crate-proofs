f the index is out of bounds or the byte is not ASCII.\n    ///\n    /// # Examples\n    /// ```\n    /// use ascii::{AsAsciiStr, AsciiChar};\n    /// assert_eq!(\"'zoä'\".get_ascii(4), None);\n    /// assert_eq!(\"'zoä'\".get_ascii(5), Some(AsciiChar::Apostrophe));\n    /// assert_eq!(\"'zoä'\".get_ascii(6), None);\n    /// ```\n    fn get_ascii(&self, index: usize) -> Option<AsciiChar> {\n        self.slice_ascii(index..=index)\n            .ok()\n            .and_then(AsciiStr::first)\n    }\n    /// Convert to an ASCII slice without checking for non-ASCII characters.\n    ///\n    /// # Safety\n    /// Calling this function when `self` contains non-ascii characters is\n    /// undefined behavior.\n    ///\n    /// # Examples\n    ///\n    unsafe fn as_ascii_str_unchecked(&self) -> &AsciiStr;\n}","attr_info":{"attributes":[{"DocComment":" Convert slices of bytes or [`AsciiChar`] to [`AsciiStr`]."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Inner","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"R","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[853,{"data":{"file_id":6,"beg":{"line":867,"col":11},"end":{"line":867,"col":60}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":115},{"Deduplicated":115}],"const_generics":[],"tr