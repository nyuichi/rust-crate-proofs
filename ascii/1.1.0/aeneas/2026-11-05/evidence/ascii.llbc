n    fn slice_ascii_mut<R>(&mut self, range: R) -> Result<&mut AsciiStr, AsAsciiStrError>\n    where\n        R: SliceIndex<[Self::Inner], Output = [Self::Inner]>;\n\n    /// Convert to a mutable ASCII slice.\n    ///\n    /// # Errors\n    /// This function returns `Err` if `self` contains non-ascii values\n    fn as_mut_ascii_str(&mut self) -> Result<&mut AsciiStr, AsAsciiStrError> {\n        self.slice_ascii_mut(..)\n    }\n\n    /// Convert to a mutable ASCII slice without checking for non-ASCII characters.\n    ///\n    /// # Safety\n    /// Calling this function when `self` contains non-ascii characters is\n    /// undefined behavior.\n    unsafe fn as_mut_ascii_str_unchecked(&mut self) -> &mut AsciiStr;\n}","attr_info":{"attributes":[{"DocComment":" Convert mutable slices of bytes or [`AsciiChar`] to [`AsciiStr`]."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Inner","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[701,{"data":{"file_id":6,"beg":{"line":913,"col":25},"end":{"line":913,"col":35}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":20},{"Deduplicated":21}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"R","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[702,{"data":{"file_id":6,"beg":{"line":921,"co