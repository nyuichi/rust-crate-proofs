+fn selected_standard_header_comparator_consumer(name_bytes: &[u8]) -> bool {
+    let matches_accept = bytes_equal_accept(name_bytes);
+    if !matches_accept {
+        proof_assert! {
+            name_bytes@ != seq![97u8, 99u8, 99u8, 101u8, 112u8, 116u8]
