(* <header::map::FnvHasher as std::hash::Hasher> *)

use creusot.int.UInt64
use creusot.prelude.Any

type t_FnvHasher = { f0: UInt64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec finish_FnvHasher
  [#"/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 4898 4 4898 27]
  (self: t_FnvHasher) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self.f0 ] s1 | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & self: t_FnvHasher = self ]) [ return (result: UInt64.t) -> (! return {result}) ]
