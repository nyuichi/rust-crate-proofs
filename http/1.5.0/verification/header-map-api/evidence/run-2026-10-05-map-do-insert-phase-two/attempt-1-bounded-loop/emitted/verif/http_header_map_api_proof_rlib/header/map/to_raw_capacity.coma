  [ return (result: t_Result_usize_MaxSizeReached) ->
  {[@stop_split] [@expl:ok_or_else ensures] [%#soption'0] match self_ with
      | None -> exists r: t_MaxSizeReached. result = Err r /\ postcondition_once_new err () r
      | Some t -> result = Ok t
      end}
    (! return {result}) ]

