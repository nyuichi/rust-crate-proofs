predicate postcondition_once_new [@inline:trivial] (self: ()) (args: ()) (result: t_MaxSizeReached) =
  [%#smap'3] let () = args in true

meta "rewrite_def" predicate postcondition_once_new

let rec ok_or_else_usize (self_: t_Option_usize) (err: ()) (return (x: t_Result_usize_MaxSizeReached)) =
  {[@stop_split] [@expl:ok_or_else requires] [%#soption] self_ = None -> precondition_new err ()}
