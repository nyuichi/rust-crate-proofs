    | s2 = return {_ret} ] ]
  [ & _ret: t_Result_usize_MaxSizeReached = Any.any_l () | & n: UInt64.t = n | & _4: t_Option_usize = Any.any_l () ])
  [ return (result: t_Result_usize_MaxSizeReached) ->
