type t_Option_usize = None | Some UInt64.t

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let rec checked_raw_capacity (requested: UInt64.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:checked_raw_capacity ensures] [%#smap_capacity] match result with
      | Some raw -> UInt64.t'int raw = UInt64.t'int requested + ComputerDivision.div (UInt64.t'int requested) 3
      | None -> UInt64.t'int requested + ComputerDivision.div (UInt64.t'int requested) 3 > UInt64.t'int const_MAX
      end}
    (! return {result}) ]

type t_MaxSizeReached = { _priv: () }

type t_Result_usize_MaxSizeReached = Ok UInt64.t | Err t_MaxSizeReached

predicate precondition_new [@inline:trivial] (self: ()) (args: ()) = [%#smap'3] let () = args in true

