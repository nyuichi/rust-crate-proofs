use creusot.prelude.Any

type t_RandomState

type t_Danger = Green | Yellow | Red t_RandomState

let rec elim_Red (_x: t_Danger) (return (f0: t_RandomState)) = any
  [ _k (f0: t_RandomState) -> {Red f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Red] match _x with
      | Red _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_RandomState (_1: t_RandomState)

predicate invariant_ref_RandomState [@inline:trivial] (self: t_RandomState) = [%#sinvariant] inv_RandomState self

meta "rewrite_def" predicate invariant_ref_RandomState

predicate inv_ref_RandomState [@inline:trivial] (_1: t_RandomState) = invariant_ref_RandomState _1

meta "rewrite_def" predicate inv_ref_RandomState

let rec clone_RandomState (self_: t_RandomState) (return (x: t_RandomState)) =
  {[@stop_split] [@expl:clone 'self_' type invariant] [%#sclone] inv_ref_RandomState self_}
  any
  [ return (result: t_RandomState) -> {[@stop_split] [@expl:clone result type invariant] inv_RandomState result}
    (! return {result}) ]

predicate inv_Danger (_1: t_Danger)

axiom inv_axiom [@rewrite]: forall x: t_Danger [inv_Danger x]. inv_Danger x
    = match x with
      | Green -> true
      | Yellow -> true
      | Red f0 -> inv_RandomState f0
      end

predicate invariant_ref_Danger [@inline:trivial] (self: t_Danger) = [%#sinvariant] inv_Danger self

meta "rewrite_def" predicate invariant_ref_Danger

predicate inv_ref_Danger [@inline:trivial] (_1: t_Danger) = invariant_ref_Danger _1

