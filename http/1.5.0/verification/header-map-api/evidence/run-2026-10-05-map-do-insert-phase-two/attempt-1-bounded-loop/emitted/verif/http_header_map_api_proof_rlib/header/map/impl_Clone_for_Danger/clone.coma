  [ & _ret: t_Danger = Any.any_l ()
  | & self: t_Danger = self
  | & __self_0: t_RandomState = Any.any_l ()
  | & _4: t_RandomState = Any.any_l () ])
  [ return (result: t_Danger) -> {[@stop_split] [@expl:clone result type invariant] [%#smap'1] inv_Danger result}
