use creusot.int.UInt64
use creusot.prelude.MutBorrow
use seq.Seq

type t_T

type t_Link = Entry UInt64.t | Extra UInt64.t

type t_ExtraValue_T = { value: t_T; prev: t_Link; next: t_Link }

predicate inv_T (_1: t_T)

predicate inv_ExtraValue_T (_1: t_ExtraValue_T)

axiom inv_axiom [@rewrite]: forall x: t_ExtraValue_T [inv_ExtraValue_T x]. inv_ExtraValue_T x = inv_T x.value

predicate invariant_ref_ExtraValue_T [@inline:trivial] (self: t_ExtraValue_T) = [%#sinvariant] inv_ExtraValue_T self

meta "rewrite_def" predicate invariant_ref_ExtraValue_T

predicate inv_ref_ExtraValue_T [@inline:trivial] (_1: t_ExtraValue_T) = invariant_ref_ExtraValue_T _1

meta "rewrite_def" predicate inv_ref_ExtraValue_T

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant'0] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

predicate formatter_extends (before: Seq.seq int) (after: Seq.seq int) =
  [%#sfmt'2] exists suffix: Seq.seq int. after = Seq.(++) before suffix

function deep_model_Formatter (self: t_Formatter) : Seq.seq int

function deep_model_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) : Seq.seq int =
  [%#smodel] deep_model_Formatter self.current

meta "rewrite_def" function deep_model_refmut_Formatter

type t_Result_unit_Error = Ok () | Err ()

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self_: t_ExtraValue_T. forall formatter: MutBorrow.t t_Formatter. ([%#sfmt] inv_ref_ExtraValue_T self_)
        /\ ([%#sfmt'0] inv_refmut_Formatter formatter)
      -> ([%#smap] inv_ref_ExtraValue_T self_)
      /\ ([%#smap'0] inv_refmut_Formatter formatter)
      /\ (forall result: t_Result_unit_Error. [%#sfmt'1] formatter_extends (deep_model_refmut_Formatter formatter) (deep_model_Formatter formatter.final))
