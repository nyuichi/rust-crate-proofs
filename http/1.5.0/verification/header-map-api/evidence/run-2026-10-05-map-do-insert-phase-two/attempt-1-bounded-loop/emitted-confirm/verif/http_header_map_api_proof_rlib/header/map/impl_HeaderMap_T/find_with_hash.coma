type tup2_usize_HashValue = { f0'0: UInt64.t; f1'0: t_HashValue }

type t_Option_tup2_usize_HashValue = None | Some tup2_usize_HashValue

constant const_MAX: UInt16.t = (65535: UInt16.t)

let rec resolve (self: t_Pos) (return (x: t_Option_tup2_usize_HashValue)) = any
  [ return (result: t_Option_tup2_usize_HashValue) ->
  {[@stop_split] [@expl:resolve ensures] [%#smap_index'1] match result with
      | Some {f0'0 = index'0; f1'0 = hash'0} -> self.index <> const_MAX
      /\ UInt64.t'int index'0 = UInt16.t'int self.index /\ hash'0 = self.hash
      | None -> self.index = const_MAX
      end}
    (! return {result}) ]

let rec elim_Some (_x: t_Option_tup2_usize_HashValue) (return (f0'1: tup2_usize_HashValue)) = any
  [ _k (f0'1: tup2_usize_HashValue) -> {Some f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

constant const_MAX_SIZE: UInt64.t = [%#smap_index'8] (32768: UInt64.t)

constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

let rec probe_distance (mask'0: UInt16.t) (hash'0: t_HashValue) (current': UInt64.t) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:probe_distance requires] ([@stop_split] [@expl:probe_distance requires #0] [%#smap_index'2] exists k: int. k
        >= 0
      /\ UInt16.t'int mask'0 + 1 = Power.power 2 k)
  /\ ([@stop_split] [@expl:probe_distance requires #1] [%#smap_index'3] UInt16.t'int mask'0
    < UInt64.t'int const_MAX_SIZE)
  /\ ([@stop_split] [@expl:probe_distance requires #2] [%#smap_index'4] UInt64.t'int current' <= UInt16.t'int mask'0)
  /\ ([@stop_split] [@expl:probe_distance requires #3] [%#smap_index'5] UInt64.t'int current' + UInt16.t'int mask'0 + 1
  <= UInt64.t'int const_MAX'0)}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:probe_distance ensures] [%#smap_index'6] UInt64.t'int result
    = (if UInt64.t'int current' >= UInt16.t'int (UInt16.bw_and hash'0.f0 mask'0) then
      UInt64.t'int current' - UInt16.t'int (UInt16.bw_and hash'0.f0 mask'0)
    else
      UInt64.t'int current' + UInt16.t'int mask'0 + 1 - UInt16.t'int (UInt16.bw_and hash'0.f0 mask'0)
    )}
    (! return {result}) ]

let rec eq_HashValue (self: t_HashValue) (other: t_HashValue) (return (x: bool)) = any
