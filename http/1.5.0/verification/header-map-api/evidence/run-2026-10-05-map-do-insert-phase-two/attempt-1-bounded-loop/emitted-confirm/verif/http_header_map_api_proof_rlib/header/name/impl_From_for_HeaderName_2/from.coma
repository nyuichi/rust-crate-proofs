type t_ByteStr

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'2] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

