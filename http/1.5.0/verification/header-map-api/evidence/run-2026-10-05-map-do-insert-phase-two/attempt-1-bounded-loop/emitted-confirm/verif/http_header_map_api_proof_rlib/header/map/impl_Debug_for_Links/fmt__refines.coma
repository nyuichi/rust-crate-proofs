(* <header::map::Links as std::fmt::Debug> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 93 20 93 44
let%span sfmt = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/fmt.rs" 46 20 46 29
let%span sfmt'0 = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/fmt.rs" 43 26 43 94
let%span sfmt'1 = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/fmt.rs" 28 16 28 71
let%span smodel = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/model.rs" 44 8 44 28
let%span smap = "/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 639 9 639 14

use creusot.prelude.MutBorrow
use seq.Seq
use creusot.int.UInt64

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

predicate formatter_extends (before: Seq.seq int) (after: Seq.seq int) =
  [%#sfmt'1] exists suffix: Seq.seq int. after = Seq.(++) before suffix

function deep_model_Formatter (self: t_Formatter) : Seq.seq int

function deep_model_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) : Seq.seq int =
  [%#smodel] deep_model_Formatter self.current

meta "rewrite_def" function deep_model_refmut_Formatter

type t_Result_unit_Error = Ok () | Err ()

type t_Links = { next: UInt64.t; tail: UInt64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self_: t_Links. forall formatter: MutBorrow.t t_Formatter. ([%#sfmt] inv_refmut_Formatter formatter)
      -> ([%#smap] inv_refmut_Formatter formatter)
      /\ (forall result: t_Result_unit_Error. [%#sfmt'0] formatter_extends (deep_model_refmut_Formatter formatter) (deep_model_Formatter formatter.final))
