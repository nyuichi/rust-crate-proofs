predicate inv_IntoIter_T_Global (_1: t_IntoIter_T_Global)

predicate inv_Option_IntoIter_T_Global (_1: t_Option_IntoIter_T_Global)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Option_IntoIter_T_Global [inv_Option_IntoIter_T_Global x]. inv_Option_IntoIter_T_Global x
