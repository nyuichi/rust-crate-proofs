predicate inv_ValueDrain_T (_1: t_ValueDrain_T)

axiom inv_axiom'1 [@rewrite]: forall x: t_ValueDrain_T [inv_ValueDrain_T x]. inv_ValueDrain_T x
    = (inv_Option_T x.first /\ inv_Option_IntoIter_T_Global x.next)

