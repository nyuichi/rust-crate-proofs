axiom Power_non_neg :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gteq y 0 -> infix_gteq (power x y) 0

axiom Power_pos :
  forall x:int, y:int.
   infix_gt x 0 /\ infix_gteq y 0 -> infix_gt (power x y) 0

axiom Power_monotonic :
  forall x:int, n:int, m:int.
   infix_ls 0 x /\ infix_lseq 0 n /\ infix_lseq n m ->
   infix_lseq (power x n) (power x m)

