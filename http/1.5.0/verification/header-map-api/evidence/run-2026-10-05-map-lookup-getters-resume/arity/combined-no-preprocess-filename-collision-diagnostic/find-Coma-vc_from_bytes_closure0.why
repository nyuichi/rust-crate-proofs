   infix_lseq 0 n /\ infix_ls n size -> nth3 (bw_not3 v) n = notb (nth3 v n)

(* meta remove_unused:dependency prop Nth_bw_not, function bw_not3 *)

function lsr t22 int : t22

axiom Lsr_nth_low :
  forall b:t22, n:int, s:int.
   infix_lseq 0 s ->
   infix_lseq 0 n ->
   infix_ls (infix_pl n s) size -> nth3 (lsr b s) n = nth3 b (infix_pl n s)

(* meta remove_unused:dependency prop Lsr_nth_low, function lsr *)

axiom Lsr_nth_high :
  forall b:t22, n:int, s:int.
   infix_lseq 0 s ->
