predicate eq_sub_bv t22 t22 t22 t22

axiom eq_sub_bv_def :
  forall a:t22, b:t22, i:t22, n:t22.
   let mask11 = lsl_bv (sub3 (lsl_bv one4 n) one4) i in
   eq_sub_bv a b i n <-> bw_and3 b mask11 = bw_and3 a mask11

(* meta remove_unused:dependency prop eq_sub_bv_def, predicate eq_sub_bv *)

predicate eq_sub (a:t22) (b:t22) (i:int) (n:int) =
  forall j:int.
   infix_lseq i j /\ infix_ls j (infix_pl i n) -> nth3 a j = nth3 b j

axiom eq_sub_equiv :
  forall a:t22, b:t22, i:t22, n:t22.
   eq_sub a b (tqtint3 i) (tqtint3 n) <-> eq_sub_bv a b i n

(* meta remove_unused:dependency prop eq_sub_equiv, predicate eq_sub_bv *)

(* meta remove_unused:dependency prop eq_sub_equiv, predicate eq_sub *)

predicate infix_eqeq1 (v1:t22) (v2:t22) = eq_sub v1 v2 0 size

axiom Extensionality [@W:non_conservative_extension:N] :
  forall x:t22, y:t22 [infix_eqeq1 x y]. infix_eqeq1 x y -> x = y

