(* use bv.Pow2int *)

predicate is_signed_positive t22

function of_int3 int : t22

function to_int (x:t22) : int =
  if is_signed_positive x then tqtint3 x
  else prefix_mn (infix_mn two_power_size3 (tqtint3 x))

axiom to_uint_extensionality :
  forall v:t22, vqt:t22. tqtint3 v = tqtint3 vqt -> v = vqt

(* meta remove_unused:dependency prop to_uint_extensionality,
  function tqtint3 *)

axiom to_int_extensionality :
  forall v:t22, vqt:t22. to_int v = to_int vqt -> v = vqt

(* meta remove_unused:dependency prop to_int_extensionality,
  function to_int *)

predicate uint_in_range (i:int) = infix_lseq 0 i /\ infix_lseq i tqtmaxInt3

axiom to_uint_bounds :
  forall v:t22.
   infix_lseq 0 (tqtint3 v) /\ infix_ls (tqtint3 v) two_power_size3

(* meta remove_unused:dependency prop to_uint_bounds, function tqtint3 *)

axiom to_uint_of_int :
  forall i:int.
   infix_lseq 0 i /\ infix_ls i two_power_size3 -> tqtint3 (of_int3 i) = i

(* meta remove_unused:dependency prop to_uint_of_int, function tqtint3 *)

(* meta remove_unused:dependency prop to_uint_of_int, function of_int3 *)

axiom to_int_bounds :
  forall v:t22.
   infix_lseq (prefix_mn two_power_sizem1) (to_int v) /\
   infix_ls (to_int v) two_power_sizem1

(* meta remove_unused:dependency prop to_int_bounds, function to_int *)

axiom to_int_of_int :
  forall i:int.
   infix_lseq (prefix_mn two_power_sizem1) i /\ infix_ls i two_power_sizem1 ->
   to_int (of_int3 i) = i

(* meta remove_unused:dependency prop to_int_of_int, function of_int3 *)

constant size_bv : t22

inductive acc ('a -> 'a -> bool) 'a =
  | acc_x :
      forall r:'a -> 'a -> bool, x:'a.
       (forall y:'a. infix_at (infix_at r y) x = True -> acc r y) -> acc r x

predicate well_founded (r:'a -> 'a -> bool) = forall x:'a. acc r x

(* use why3.WellFounded.WellFounded *)

predicate ult (x:t22) (y:t22) = infix_ls (tqtint3 x) (tqtint3 y)

axiom ult_wf : well_founded (fun (y0:t22) (y1:t22) -> ult y0 y1)

(* meta vc:proved_wf predicate ult, prop ult_wf *)

(* meta remove_unused:dependency prop ult_wf, predicate ult *)

predicate ule (x:t22) (y:t22) = infix_lseq (tqtint3 x) (tqtint3 y)

predicate ugt (x:t22) (y:t22) = infix_gt (tqtint3 x) (tqtint3 y)

axiom ugt_wf : well_founded (fun (y0:t22) (y1:t22) -> ugt y0 y1)

(* meta vc:proved_wf predicate ugt, prop ugt_wf *)

(* meta remove_unused:dependency prop ugt_wf, predicate ugt *)

predicate uge (x:t22) (y:t22) = infix_gteq (tqtint3 x) (tqtint3 y)

predicate slt (v1:t22) (v2:t22) = infix_ls (to_int v1) (to_int v2)

axiom slt_wf : well_founded (fun (y0:t22) (y1:t22) -> slt y0 y1)

(* meta vc:proved_wf predicate slt, prop slt_wf *)

(* meta remove_unused:dependency prop slt_wf, predicate slt *)

predicate sle (v1:t22) (v2:t22) = infix_lseq (to_int v1) (to_int v2)

predicate sgt (v1:t22) (v2:t22) = infix_gt (to_int v1) (to_int v2)

axiom sgt_wf : well_founded (fun (y0:t22) (y1:t22) -> sgt y0 y1)

(* meta vc:proved_wf predicate sgt, prop sgt_wf *)

(* meta remove_unused:dependency prop sgt_wf, predicate sgt *)

predicate sge (v1:t22) (v2:t22) = infix_gteq (to_int v1) (to_int v2)

axiom positive_is_ge_zeros :
  forall x:t22. is_signed_positive x <-> sge x zeros

(* meta remove_unused:dependency prop positive_is_ge_zeros, predicate sge *)

(* meta remove_unused:dependency prop positive_is_ge_zeros,
  predicate is_signed_positive *)

function add3 t22 t22 : t22

axiom to_uint_add :
  forall v1:t22, v2:t22.
   tqtint3 (add3 v1 v2) =
   mod1 (infix_pl (tqtint3 v1) (tqtint3 v2)) two_power_size3

(* meta remove_unused:dependency prop to_uint_add, function add3 *)

axiom to_uint_add_bounded :
  forall v1:t22, v2:t22.
   infix_ls (infix_pl (tqtint3 v1) (tqtint3 v2)) two_power_size3 ->
   tqtint3 (add3 v1 v2) = infix_pl (tqtint3 v1) (tqtint3 v2)

(* meta remove_unused:dependency prop to_uint_add_bounded, function add3 *)

axiom to_uint_add_overflow :
  forall v1:t22, v2:t22.
   infix_gteq (infix_pl (tqtint3 v1) (tqtint3 v2)) two_power_size3 ->
   tqtint3 (add3 v1 v2) =
   infix_mn (infix_pl (tqtint3 v1) (tqtint3 v2)) two_power_size3

(* meta remove_unused:dependency prop to_uint_add_overflow, function add3 *)

function sub3 t22 t22 : t22

axiom to_uint_sub :
  forall v1:t22, v2:t22.
   tqtint3 (sub3 v1 v2) =
   mod1 (infix_mn (tqtint3 v1) (tqtint3 v2)) two_power_size3

(* meta remove_unused:dependency prop to_uint_sub, function sub3 *)

axiom to_uint_sub_bounded :
  forall v1:t22, v2:t22.
   infix_lseq 0 (infix_mn (tqtint3 v1) (tqtint3 v2)) ->
   tqtint3 (sub3 v1 v2) = infix_mn (tqtint3 v1) (tqtint3 v2)

(* meta remove_unused:dependency prop to_uint_sub_bounded, function sub3 *)

axiom to_uint_sub_overflow :
  forall v1:t22, v2:t22.
   infix_gt 0 (infix_mn (tqtint3 v1) (tqtint3 v2)) ->
   tqtint3 (sub3 v1 v2) =
   infix_pl (infix_mn (tqtint3 v1) (tqtint3 v2)) two_power_size3

(* meta remove_unused:dependency prop to_uint_sub_overflow, function sub3 *)

function neg3 t22 : t22

axiom to_uint_neg :
  forall v:t22.
   tqtint3 (neg3 v) = mod1 (prefix_mn (tqtint3 v)) two_power_size3

(* meta remove_unused:dependency prop to_uint_neg, function neg3 *)

axiom to_uint_neg_no_mod :
  forall v:t22.
   tqtint3 (neg3 v) =
   (if v = zeros then 0 else infix_mn two_power_size3 (tqtint3 v))

(* meta remove_unused:dependency prop to_uint_neg_no_mod, function neg3 *)

function mul3 t22 t22 : t22

axiom to_uint_mul :
  forall v1:t22, v2:t22.
   tqtint3 (mul3 v1 v2) =
   mod1 (infix_as (tqtint3 v1) (tqtint3 v2)) two_power_size3

(* meta remove_unused:dependency prop to_uint_mul, function mul3 *)

axiom to_uint_mul_bounded :
  forall v1:t22, v2:t22.
   infix_ls (infix_as (tqtint3 v1) (tqtint3 v2)) two_power_size3 ->
   tqtint3 (mul3 v1 v2) = infix_as (tqtint3 v1) (tqtint3 v2)

(* meta remove_unused:dependency prop to_uint_mul_bounded, function mul3 *)

function udiv t22 t22 : t22

axiom to_uint_udiv :
  forall v1:t22, v2:t22.
   tqtint3 (udiv v1 v2) = div1 (tqtint3 v1) (tqtint3 v2)

(* meta remove_unused:dependency prop to_uint_udiv, function udiv *)

function urem t22 t22 : t22

axiom to_uint_urem :
  forall v1:t22, v2:t22.
