  forall v1:t22, v2:t22, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth3 (bw_xor3 v1 v2) n = xorb (nth3 v1 n) (nth3 v2 n)

(* meta remove_unused:dependency prop Nth_bw_xor, function bw_xor3 *)

