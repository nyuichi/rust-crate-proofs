function nth3 t22 int : bool

axiom nth_out_of_bound :
  forall x:t22, n:int. infix_ls n 0 \/ infix_gteq n size -> nth3 x n = False

(* meta remove_unused:dependency prop nth_out_of_bound, function nth3 *)

axiom Nth_zeros : forall n:int. nth3 zeros n = False

(* meta remove_unused:dependency prop Nth_zeros, constant zeros *)

axiom Nth_ones :
  forall n:int. infix_lseq 0 n /\ infix_ls n size -> nth3 ones n = True

(* meta remove_unused:dependency prop Nth_ones, constant ones *)

function bw_and3 t22 t22 : t22

axiom Nth_bw_and :
  forall v1:t22, v2:t22, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth3 (bw_and3 v1 v2) n = andb (nth3 v1 n) (nth3 v2 n)

(* meta remove_unused:dependency prop Nth_bw_and, function bw_and3 *)

function bw_or3 t22 t22 : t22

axiom Nth_bw_or :
  forall v1:t22, v2:t22, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth3 (bw_or3 v1 v2) n = orb (nth3 v1 n) (nth3 v2 n)

(* meta remove_unused:dependency prop Nth_bw_or, function bw_or3 *)

function bw_xor3 t22 t22 : t22

