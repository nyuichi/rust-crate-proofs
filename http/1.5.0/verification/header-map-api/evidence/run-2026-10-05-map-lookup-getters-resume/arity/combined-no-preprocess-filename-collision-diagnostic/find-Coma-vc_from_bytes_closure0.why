function nth_bv t22 t22 : bool

axiom nth_bv_def :
  forall x:t22, i:t22.
   nth_bv x i = True <-> not bw_and3 (lsr_bv x i) one4 = zeros

(* meta remove_unused:dependency prop nth_bv_def, function nth_bv *)

axiom Nth_bv_is_nth : forall x:t22, i:t22. nth3 x (tqtint3 i) = nth_bv x i

(* meta remove_unused:dependency prop Nth_bv_is_nth, function nth_bv *)

