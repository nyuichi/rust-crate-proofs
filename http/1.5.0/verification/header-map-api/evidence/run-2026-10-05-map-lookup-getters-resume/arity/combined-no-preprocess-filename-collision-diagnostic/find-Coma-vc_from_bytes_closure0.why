axiom Nth_bv_is_nth2 :
  forall x:t22, i:int.
   infix_lseq 0 i /\ infix_ls i two_power_size3 ->
   nth_bv x (of_int3 i) = nth3 x i

(* meta remove_unused:dependency prop Nth_bv_is_nth2, function nth_bv *)

