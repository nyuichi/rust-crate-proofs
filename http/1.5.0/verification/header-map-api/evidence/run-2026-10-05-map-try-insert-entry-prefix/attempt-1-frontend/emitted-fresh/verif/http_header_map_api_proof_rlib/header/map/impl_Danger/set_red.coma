let rec is_yellow (self: t_Danger) (return (x: bool)) =
  {[@stop_split] [@expl:is_yellow 'self' type invariant] [%#smap'2] inv_ref_Danger self}
  any [ return (result: bool) -> (! return {result}) ]

predicate invariant_refmut_Danger [@inline:trivial] (self: MutBorrow.t t_Danger) =
  [%#sinvariant] inv_Danger self.current /\ inv_Danger self.final

meta "rewrite_def" predicate invariant_refmut_Danger

