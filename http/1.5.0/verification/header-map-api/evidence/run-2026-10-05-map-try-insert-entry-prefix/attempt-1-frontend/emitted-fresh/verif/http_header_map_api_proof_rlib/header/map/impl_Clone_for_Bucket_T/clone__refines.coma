(* #"/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 630 16 630 21 *)

(* <header::map::Bucket<T> as std::clone::Clone> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 85 8 85 18
let%span sclone = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/clone.rs" 14 26 14 30
let%span smap = "/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 630 16 630 21
let%span smap'0 = "/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 630 16 630 21

use creusot.int.UInt16
use creusot.int.UInt64

type t_HashValue = { f0: UInt16.t }

type t_HeaderName

type t_T

type t_Links = { next: UInt64.t; tail: UInt64.t }

type t_Option_Links = None | Some t_Links

type t_Bucket_T = { hash: t_HashValue; key: t_HeaderName; value: t_T; links: t_Option_Links }

predicate inv_HeaderName (_1: t_HeaderName)

predicate inv_T (_1: t_T)

predicate inv_Bucket_T (_1: t_Bucket_T)

axiom inv_axiom [@rewrite]: forall x: t_Bucket_T [inv_Bucket_T x]. inv_Bucket_T x
    = (inv_HeaderName x.key /\ inv_T x.value)

predicate invariant_ref_Bucket_T [@inline:trivial] (self: t_Bucket_T) = [%#sinvariant] inv_Bucket_T self

meta "rewrite_def" predicate invariant_ref_Bucket_T

predicate inv_ref_Bucket_T [@inline:trivial] (_1: t_Bucket_T) = invariant_ref_Bucket_T _1

meta "rewrite_def" predicate inv_ref_Bucket_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Bucket_T. ([%#sclone] inv_ref_Bucket_T self_)
    -> ([%#smap] inv_ref_Bucket_T self_)
    /\ (forall result: t_Bucket_T. ([%#smap'0] inv_Bucket_T result) -> inv_Bucket_T result)
