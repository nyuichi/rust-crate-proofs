  [ return (result: t_Result_HdrName_InvalidHeaderName) ->
  {[@stop_split] [@expl:parse_hdr ensures] ([@stop_split] [@expl:parse_hdr result type invariant] [%#sname'32] inv_Result_HdrName_InvalidHeaderName result)
    /\ ([@stop_split] [@expl:parse_hdr ensures] [%#sname'33] match result with
      | Ok name -> 0 < Seq.length (Slice64.view data)
      /\ Seq.length (Slice64.view data) <= 65535
      /\ match deep_model_HdrName name with
          | Standard'0 _ -> Seq.length (Slice64.view data) <= UInt64.t'int const_SCRATCH_BUF_SIZE
          | Custom'0 {f0 = bytes; f1 = lower'0} -> lower'0
            = (Seq.length (Slice64.view data) <= UInt64.t'int const_SCRATCH_BUF_SIZE)
          /\ (not lower'0 -> bytes = Slice64.view data)
          end
      /\ (if Seq.length (Slice64.view data) <= UInt64.t'int const_SCRATCH_BUF_SIZE then
        (if h2 then lowercase_header_bytes_allowed (Slice64.view data) else header_bytes_allowed (Slice64.view data))
        /\ Seq.length (hdr_name_model_bytes (deep_model_HdrName name)) = Seq.length (Slice64.view data)
        /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view data)
          -> UInt8.t'int (Seq.get (hdr_name_model_bytes (deep_model_HdrName name)) i)
          = (if h2 then
            header_chars_h2_byte (Seq.get (Slice64.view data) i)
          else
            header_chars_byte (Seq.get (Slice64.view data) i)
          ))
      else
        hdr_name_model_bytes (deep_model_HdrName name) = Slice64.view data
      )
      | Err _ -> Seq.length (Slice64.view data) = 0
      \/ Seq.length (Slice64.view data) > 65535
      \/ Seq.length (Slice64.view data) <= UInt64.t'int const_SCRATCH_BUF_SIZE
      /\ (if h2 then
        not lowercase_header_bytes_allowed (Slice64.view data)
      else
        not header_bytes_allowed (Slice64.view data)
      )
      end)}
    (! return {result}) ]
