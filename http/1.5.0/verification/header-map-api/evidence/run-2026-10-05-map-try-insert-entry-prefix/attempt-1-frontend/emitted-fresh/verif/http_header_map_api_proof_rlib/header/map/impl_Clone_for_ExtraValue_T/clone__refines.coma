(* <header::map::ExtraValue<T> as std::clone::Clone> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 85 8 85 18
let%span sclone = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/clone.rs" 14 26 14 30
let%span smap = "/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 816 16 816 21
let%span smap'0 = "/workspace/rust-crate-proofs/http/1.5.0/verification/header-map-api/src/../../../src/header/map.rs" 816 16 816 21

use creusot.int.UInt64

type t_T

type t_Link = Entry UInt64.t | Extra UInt64.t

type t_ExtraValue_T = { value: t_T; prev: t_Link; next: t_Link }

predicate inv_T (_1: t_T)

predicate inv_ExtraValue_T (_1: t_ExtraValue_T)

axiom inv_axiom [@rewrite]: forall x: t_ExtraValue_T [inv_ExtraValue_T x]. inv_ExtraValue_T x = inv_T x.value

predicate invariant_ref_ExtraValue_T [@inline:trivial] (self: t_ExtraValue_T) = [%#sinvariant] inv_ExtraValue_T self

meta "rewrite_def" predicate invariant_ref_ExtraValue_T

predicate inv_ref_ExtraValue_T [@inline:trivial] (_1: t_ExtraValue_T) = invariant_ref_ExtraValue_T _1

meta "rewrite_def" predicate inv_ref_ExtraValue_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_ExtraValue_T. ([%#sclone] inv_ref_ExtraValue_T self_)
    -> ([%#smap] inv_ref_ExtraValue_T self_)
    /\ (forall result: t_ExtraValue_T. ([%#smap'0] inv_ExtraValue_T result) -> inv_ExtraValue_T result)
