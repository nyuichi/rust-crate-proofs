{
  "manifest_version": 2,
  "scope": "Fresh source-scoped proof run of selected actual HTTP 1.5.0 HeaderMap APIs and a generic Vec allocation-bound helper used directly by HeaderMap::len; not a full integrated HeaderMap proof.",
  "proof_support": {
    "helper": "http/1.5.0/src/header/map.rs::allocation_len_bound<T>",
    "implementation": "Borrow the actual Vec as a slice; obtain its allocation permission with SliceExt::as_ptr_perm; extract PtrLive through the existing Perm::live contract; use the existing PtrLive allocation-byte invariant and a nonzero-size precondition to prove the sequence length is at most isize::MAX.",
    "trusted_contracts_added": false,
    "new_Vec_len_postcondition": false,
    "helper_body_proved": true,
    "runtime_effect": "Helper and calls are cfg(creusot)-only; the normal HeaderMap::len expression remains unchanged."
  },
  "proof_run": {
    "translation_command": "cargo clean -p http-header-map-api-proof; RUSTFLAGS=\"--cfg http_map_api_leaf\" cargo creusot --simple-triggers=false -- --features http_map_api_leaf --locked --offline",
    "proof_command": "RUSTFLAGS=\"--cfg http_map_api_leaf\" ../../scripts/run-proof.sh cargo creusot --simple-triggers=false prove --no-cache <12 exact emitted .coma targets> -- --features http_map_api_leaf --locked --offline",
    "target": "http-header-map-api-proof",
    "feature_configuration": {
      "crate_features": [
        "http_map_api_leaf"
      ],
      "creusot_std_features": [
        "bytes-model"
      ]
    },
    "status": "partial: 47/49 leaves proved; only two generic element positive-size preconditions in actual HeaderMap::len remain open.",
    "total_leaves": 49,
    "proved_leaves": 47,
    "open_leaves": 2,
    "own_body_total_leaves": 19,
    "own_body_proved_leaves": 17,
    "own_body_open_leaves": 2,
    "supporting_or_callee_or_elimination_leaves": 30,
    "supporting_or_callee_or_elimination_open_leaves": 0,
    "environment": "Why3 split_vc; Z3 4.15.3; one prover / 1024 MiB via HTTP shared-lock wrapper."
  },
  "len_frontier": {
    "actual_method": "http/1.5.0/src/header/map.rs::HeaderMap<T>::len",
    "body_goals": "6/8 leaves of vc_len_T pass, including both machine-integer overflow obligations for entries.len() + extra_values.len().",
    "call_support": "The generic permission-based helper body is independently proved; four Vec call/type support leaves pass.",
    "open_goals": [
      "allocation_len_bound_Bucket_T requires size_of_logic::<Bucket<T>>() > 0",
      "allocation_len_bound_ExtraValue_T requires size_of_logic::<ExtraValue<T>>() > 0"
    ],
    "reason": "The existing allocation permission gives length-in-bytes <= isize::MAX. To turn that into an element-count bound, each generic stored element must be shown to have positive size. Current Creusot std ADT size inference does not establish that for Bucket<T> or ExtraValue<T> for arbitrary T because T may be uninhabited and the model does not bridge a live stored value / positive Vec length to the required generic layout fact. No map invariant or blanket nonzero axiom was introduced.",
    "next_sound_bridge": "Establish the two actual generic stored-element layout facts from the source fields or from positive live Vec storage, without assuming T is inhabited."
  },
