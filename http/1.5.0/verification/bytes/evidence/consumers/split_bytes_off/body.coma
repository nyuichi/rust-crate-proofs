use creusot.prelude.MutBorrow
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_Bytes

predicate inv_Bytes (_1: t_Bytes)

predicate invariant_refmut_Bytes [@inline:trivial] (self: MutBorrow.t t_Bytes) =
  [%#sinvariant] inv_Bytes self.current /\ inv_Bytes self.final

meta "rewrite_def" predicate invariant_refmut_Bytes

predicate inv_refmut_Bytes [@inline:trivial] (_1: MutBorrow.t t_Bytes) = invariant_refmut_Bytes _1

meta "rewrite_def" predicate inv_refmut_Bytes

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec split_off (self_: MutBorrow.t t_Bytes) (at': UInt64.t) (return (x: t_Bytes)) =
  {[@stop_split] [@expl:split_off requires] ([@stop_split] [@expl:split_off 'self_' type invariant] [%#sbytes] inv_refmut_Bytes self_)
  /\ ([@stop_split] [@expl:split_off requires] [%#sbytes'0] UInt64.t'int at' <= Seq.length (bytes_seq self_.current))}
  any
  [ return (result: t_Bytes) ->
  {[@stop_split] [@expl:split_off ensures] ([@stop_split] [@expl:split_off result type invariant] [%#sbytes'1] inv_Bytes result)
    /\ ([@stop_split] [@expl:split_off ensures #0] [%#sbytes'2] bytes_seq result
      = Seq.([..]) (bytes_seq self_.current) (UInt64.t'int at') (Seq.length (bytes_seq self_.current)))
    /\ ([@stop_split] [@expl:split_off ensures #1] [%#sbytes'3] bytes_seq self_.final
    = Seq.([..]) (bytes_seq self_.current) 0 (UInt64.t'int at'))}
    (! return {result}) ]

predicate resolve_refmut_Bytes [@inline:trivial] (_1: MutBorrow.t t_Bytes) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Bytes

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec split_bytes_off [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 114 0 114 62]
  (source: MutBorrow.t t_Bytes) (at': UInt64.t) (return (x: t_Bytes)) =
  {[@stop_split] [@expl:split_bytes_off requires] ([@stop_split] [@expl:split_bytes_off 'source' type invariant] [%#slib'0] inv_refmut_Bytes source)
  /\ ([@stop_split] [@expl:split_bytes_off requires] [%#slib'1] UInt64.t'int at'
  <= Seq.length (bytes_seq source.current))}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Bytes> {source.current} {MutBorrow.get_id source}
        (fun (_bor: MutBorrow.t t_Bytes) ->
          [ &_12 <- _bor ] -{inv_Bytes _bor.final}-
          [ &source <- { source with current = _bor.final } ] s1)
      [ _ck -> (! {[@expl:type invariant] inv_Bytes source.current} any) ]
    | s1 = split_off [%#slib] {_12} {at'} (fun (_x: t_Bytes) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Bytes source} any) ]
    | s3 = -{resolve_refmut_Bytes source}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Bytes = Any.any_l ()
  | & source: MutBorrow.t t_Bytes = source
  | & at': UInt64.t = at'
  | & _12: MutBorrow.t t_Bytes = Any.any_l () ])
  [ return (result: t_Bytes) ->
  {[@stop_split] [@expl:split_bytes_off ensures] ([@stop_split] [@expl:split_bytes_off result type invariant] [%#slib'2] inv_Bytes result)
    /\ ([@stop_split] [@expl:split_bytes_off ensures #0] [%#slib'3] bytes_seq result
      = Seq.([..]) (bytes_seq source.current) (UInt64.t'int at') (Seq.length (bytes_seq source.current)))
    /\ ([@stop_split] [@expl:split_bytes_off ensures #1] [%#slib'4] bytes_seq source.final
    = Seq.([..]) (bytes_seq source.current) 0 (UInt64.t'int at'))}
    (! return {result}) ]
