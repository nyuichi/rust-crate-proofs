let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 93 20 93 44

use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Bytes

predicate inv_Bytes (_1: t_Bytes)

predicate invariant_refmut_Bytes [@inline:trivial] (self: MutBorrow.t t_Bytes) =
  [%#sinvariant] inv_Bytes self.current /\ inv_Bytes self.final

meta "rewrite_def" predicate invariant_refmut_Bytes

predicate inv_refmut_Bytes [@inline:trivial] (_1: MutBorrow.t t_Bytes) = invariant_refmut_Bytes _1

meta "rewrite_def" predicate inv_refmut_Bytes

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec truncate (self_: MutBorrow.t t_Bytes) (len: UInt64.t) (return (x: ())) =
  {[@stop_split] [@expl:truncate 'self_' type invariant] [%#sbytes] inv_refmut_Bytes self_}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:truncate ensures] [%#sbytes'0] bytes_seq self_.final
    = Seq.([..]) (bytes_seq self_.current) 0 (if UInt64.t'int len < Seq.length (bytes_seq self_.current) then
      UInt64.t'int len
    else
      Seq.length (bytes_seq self_.current)
    )}
    (! return {result}) ]

predicate resolve_refmut_Bytes [@inline:trivial] (_1: MutBorrow.t t_Bytes) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Bytes

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec truncate_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 119 0 119 52]
  (value: MutBorrow.t t_Bytes) (len: UInt64.t) (return (x: ())) =
  {[@stop_split] [@expl:truncate_bytes 'value' type invariant] [%#slib'0] inv_refmut_Bytes value}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Bytes> {value.current} {MutBorrow.get_id value}
        (fun (_bor: MutBorrow.t t_Bytes) ->
          [ &_6 <- _bor ] -{inv_Bytes _bor.final}-
          [ &value <- { value with current = _bor.final } ] s1)
      [ _ck -> (! {[@expl:type invariant] inv_Bytes value.current} any) ]
    | s1 = truncate [%#slib] {_6} {len} (fun (_x: ()) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Bytes value} any) ]
    | s3 = -{resolve_refmut_Bytes value}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & value: MutBorrow.t t_Bytes = value
  | & len: UInt64.t = len
  | & _6: MutBorrow.t t_Bytes = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:truncate_bytes ensures] [%#slib'1] bytes_seq value.final
    = Seq.([..]) (bytes_seq value.current) 0 (if UInt64.t'int len < Seq.length (bytes_seq value.current) then
      UInt64.t'int len
    else
      Seq.length (bytes_seq value.current)
    )}
    (! return {result}) ]
