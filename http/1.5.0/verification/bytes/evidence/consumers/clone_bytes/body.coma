use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any

type t_Bytes

predicate inv_Bytes (_1: t_Bytes)

predicate invariant_ref_Bytes [@inline:trivial] (self: t_Bytes) = [%#sinvariant] inv_Bytes self

meta "rewrite_def" predicate invariant_ref_Bytes

predicate inv_ref_Bytes [@inline:trivial] (_1: t_Bytes) = invariant_ref_Bytes _1

meta "rewrite_def" predicate inv_ref_Bytes

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec clone_Bytes (self_: t_Bytes) (return (x: t_Bytes)) =
  {[@stop_split] [@expl:clone 'self_' type invariant] [%#sbytes] inv_ref_Bytes self_}
  any
  [ return (result: t_Bytes) ->
  {[@stop_split] [@expl:clone_Bytes ensures] ([@stop_split] [@expl:clone result type invariant] [%#sbytes'0] inv_Bytes result)
    /\ ([@stop_split] [@expl:clone ensures] [%#sbytes'1] bytes_seq result = bytes_seq self_)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec clone_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 22 0 22 43]
  (source: t_Bytes) (return (x: t_Bytes)) =
  {[@stop_split] [@expl:clone_bytes 'source' type invariant] [%#slib'0] inv_ref_Bytes source}
  (! bb0
  [ bb0 = s0 [ s0 = clone_Bytes [%#slib] {source} (fun (_x: t_Bytes) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_Bytes = Any.any_l () | & source: t_Bytes = source ])
  [ return (result: t_Bytes) ->
  {[@stop_split] [@expl:clone_bytes ensures] ([@stop_split] [@expl:clone_bytes result type invariant] [%#slib'1] inv_Bytes result)
    /\ ([@stop_split] [@expl:clone_bytes ensures] [%#slib'2] bytes_seq result = bytes_seq source)}
    (! return {result}) ]
