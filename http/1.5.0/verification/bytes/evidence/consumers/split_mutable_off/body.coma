      Seq.([..]) (bytes_mut_seq self_.current) 0 (UInt64.t'int at')
    else
      bytes_mut_seq self_.current
    ))}
    (! return {result}) ]

predicate resolve_refmut_BytesMut [@inline:trivial] (_1: MutBorrow.t t_BytesMut) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_BytesMut

