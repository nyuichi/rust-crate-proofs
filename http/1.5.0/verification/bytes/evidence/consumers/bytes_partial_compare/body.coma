use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Bytes

type t_Ordering = Less | Equal | Greater

type t_Option_Ordering = None | Some t_Ordering

predicate inv_Bytes (_1: t_Bytes)

predicate invariant_ref_Bytes [@inline:trivial] (self: t_Bytes) = [%#sinvariant] inv_Bytes self

meta "rewrite_def" predicate invariant_ref_Bytes

predicate inv_ref_Bytes [@inline:trivial] (_1: t_Bytes) = invariant_ref_Bytes _1

meta "rewrite_def" predicate inv_ref_Bytes

function cmp_log_u8 (self: UInt8.t) (o: UInt8.t) : t_Ordering = [%#sord'3] if UInt8.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom eq_cmp_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'16] (x = y) = (cmp_log_u8 x y = Equal)

function antisym2_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym2_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'14] cmp_log_u8 x y = Greater)
    -> ([%#sord'15] cmp_log_u8 y x = Less)

function antisym1_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym1_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'12] cmp_log_u8 x y = Less)
    -> ([%#sord'13] cmp_log_u8 y x = Greater)

function trans_u8 (x: UInt8.t) (y: UInt8.t) (z: UInt8.t) (o: t_Ordering) : ()

axiom trans_u8_spec: forall x: UInt8.t, y: UInt8.t, z: UInt8.t, o: t_Ordering. ([%#sord'9] cmp_log_u8 x y = o)
    -> ([%#sord'10] cmp_log_u8 y z = o) -> ([%#sord'11] cmp_log_u8 x z = o)

function refl_u8 (x: UInt8.t) : ()

axiom refl_u8_spec: forall x: UInt8.t. [%#sord'8] cmp_log_u8 x x = Equal

function cmp_gt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_gt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'7] UInt8.gt x y = (cmp_log_u8 x y = Greater)

function cmp_ge_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_ge_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'6] UInt8.ge x y = (cmp_log_u8 x y <> Less)

function cmp_lt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_lt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'5] UInt8.lt x y = (cmp_log_u8 x y = Less)

function cmp_le_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_le_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'4] UInt8.le x y = (cmp_log_u8 x y <> Greater)

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_u8 (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) : t_Ordering

axiom seq_cmp_u8_def: forall left: Seq.seq UInt8.t, right: Seq.seq UInt8.t. seq_cmp_u8 left right
    = ([%#sseq_ord'0] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_u8 (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_u8 (tail_u8 left) (tail_u8 right)
          end
    
    )

function cmp_log_Seq_u8 (self: Seq.seq UInt8.t) (other: Seq.seq UInt8.t) : t_Ordering =
  [%#sseq_ord_impl] seq_cmp_u8 self other

function eq_cmp_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom eq_cmp_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. [%#sseq_ord_impl'12] (x = y)
    = (cmp_log_Seq_u8 x y = Equal)

function antisym2_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom antisym2_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. ([%#sseq_ord_impl'10] cmp_log_Seq_u8 x y
      = Greater) -> ([%#sseq_ord_impl'11] cmp_log_Seq_u8 y x = Less)

function antisym1_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom antisym1_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. ([%#sseq_ord_impl'8] cmp_log_Seq_u8 x y
      = Less) -> ([%#sseq_ord_impl'9] cmp_log_Seq_u8 y x = Greater)

function trans_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) (z: Seq.seq UInt8.t) (order: t_Ordering) : ()

axiom trans_Seq_u8_spec:
  forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t, z: Seq.seq UInt8.t, order: t_Ordering. ([%#sseq_ord_impl'5] cmp_log_Seq_u8 x y
      = order) -> ([%#sseq_ord_impl'6] cmp_log_Seq_u8 y z = order) -> ([%#sseq_ord_impl'7] cmp_log_Seq_u8 x z = order)

function refl_Seq_u8 (x: Seq.seq UInt8.t) : ()

axiom refl_Seq_u8_spec: forall x: Seq.seq UInt8.t. [%#sseq_ord_impl'4] cmp_log_Seq_u8 x x = Equal

predicate gt_log_Seq_u8 (self: Seq.seq UInt8.t) (o: Seq.seq UInt8.t) = [%#sord'2] cmp_log_Seq_u8 self o = Greater

function cmp_gt_log_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom cmp_gt_log_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. [%#sseq_ord_impl'3] gt_log_Seq_u8 x y
    = (cmp_log_Seq_u8 x y = Greater)

predicate ge_log_Seq_u8 (self: Seq.seq UInt8.t) (o: Seq.seq UInt8.t) = [%#sord'1] cmp_log_Seq_u8 self o <> Less

function cmp_ge_log_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom cmp_ge_log_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. [%#sseq_ord_impl'2] ge_log_Seq_u8 x y
    = (cmp_log_Seq_u8 x y <> Less)

predicate lt_log_Seq_u8 (self: Seq.seq UInt8.t) (o: Seq.seq UInt8.t) = [%#sord'0] cmp_log_Seq_u8 self o = Less

function cmp_lt_log_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom cmp_lt_log_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. [%#sseq_ord_impl'1] lt_log_Seq_u8 x y
    = (cmp_log_Seq_u8 x y = Less)

predicate le_log_Seq_u8 (self: Seq.seq UInt8.t) (o: Seq.seq UInt8.t) = [%#sord] cmp_log_Seq_u8 self o <> Greater

function cmp_le_log_Seq_u8 (x: Seq.seq UInt8.t) (y: Seq.seq UInt8.t) : ()

axiom cmp_le_log_Seq_u8_spec: forall x: Seq.seq UInt8.t, y: Seq.seq UInt8.t. [%#sseq_ord_impl'0] le_log_Seq_u8 x y
    = (cmp_log_Seq_u8 x y <> Greater)

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec partial_cmp_Bytes (self_: t_Bytes) (other: t_Bytes) (return (x: t_Option_Ordering)) =
  {[@stop_split] [@expl:partial_cmp_Bytes requires] ([@stop_split] [@expl:partial_cmp 'self_' type invariant] [%#sbytes] inv_ref_Bytes self_)
  /\ ([@stop_split] [@expl:partial_cmp 'other' type invariant] [%#sbytes'0] inv_ref_Bytes other)}
  any
  [ return (result: t_Option_Ordering) -> {[@stop_split] [@expl:partial_cmp ensures] [%#sbytes'1] result
    = Some (cmp_log_Seq_u8 (bytes_seq self_) (bytes_seq other))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec bytes_partial_compare [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 95 0 95 87]
  (left: t_Bytes) (right: t_Bytes) (return (x: t_Option_Ordering)) =
  {[@stop_split] [@expl:bytes_partial_compare requires] ([@stop_split] [@expl:bytes_partial_compare 'left' type invariant] [%#slib'0] inv_ref_Bytes left)
  /\ ([@stop_split] [@expl:bytes_partial_compare 'right' type invariant] [%#slib'1] inv_ref_Bytes right)}
  (! bb0
  [ bb0 = s0
    [ s0 = partial_cmp_Bytes [%#slib] {left} {right} (fun (_x: t_Option_Ordering) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_Option_Ordering = Any.any_l () | & left: t_Bytes = left | & right: t_Bytes = right ])
  [ return (result: t_Option_Ordering) -> {[@stop_split] [@expl:bytes_partial_compare ensures] [%#slib'2] result
    = Some (cmp_log_Seq_u8 (bytes_seq left) (bytes_seq right))}
    (! return {result}) ]
