    (! return {result}) ]

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_BytesMut [@inline:trivial] (self: MutBorrow.t t_BytesMut) =
  [%#sinvariant] inv_BytesMut self.current /\ inv_BytesMut self.final

meta "rewrite_def" predicate invariant_refmut_BytesMut

predicate inv_refmut_BytesMut [@inline:trivial] (_1: MutBorrow.t t_BytesMut) = invariant_refmut_BytesMut _1

meta "rewrite_def" predicate inv_refmut_BytesMut

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'1] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'0] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let rec write_str_BytesMut (self_: MutBorrow.t t_BytesMut) (value: string) (return (x: t_Result_unit_Error)) =
  {[@stop_split] [@expl:write_str_BytesMut requires] ([@stop_split] [@expl:write_str 'self_' type invariant] [%#sbytes'0] inv_refmut_BytesMut self_)
  /\ ([@stop_split] [@expl:write_str requires] [%#sbytes'1] Seq.length (bytes_mut_seq self_.current)
    + Seq.length (to_bytes (view_str value))
  <= Int64.to_int const_MAX)}
  any
  [ return (result: t_Result_unit_Error) ->
  {[@stop_split] [@expl:write_str_BytesMut ensures] ([@stop_split] [@expl:write_str ensures #0] [%#sbytes'2] result
      = Ok ())
    /\ ([@stop_split] [@expl:write_str ensures #1] [%#sbytes'3] bytes_mut_seq self_.final
    = Seq.(++) (bytes_mut_seq self_.current) (to_bytes (view_str value)))}
    (! return {result}) ]

let rec unwrap_unit (self_: t_Result_unit_Error) (return (x: ())) =
  {[@stop_split] [@expl:unwrap requires] [%#sresult] exists t: (). self_ = Ok t}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:unwrap ensures] [%#sresult'0] Ok result = self_} (! return {result}) ]

type t_Bytes

