function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec freeze (self_: t_BytesMut) (return (x: t_Bytes)) =
  {[@stop_split] [@expl:freeze 'self_' type invariant] [%#sbytes'4] inv_BytesMut self_}
