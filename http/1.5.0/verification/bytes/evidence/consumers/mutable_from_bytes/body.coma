use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any

type t_Bytes

type t_BytesMut

predicate inv_Bytes (_1: t_Bytes)

predicate inv_BytesMut (_1: t_BytesMut)

function bytes_mut_seq (_value: t_BytesMut) : Seq.seq UInt8.t

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec from_BytesMut (bytes: t_Bytes) (return (x: t_BytesMut)) =
  {[@stop_split] [@expl:from 'bytes' type invariant] [%#sbytes] inv_Bytes bytes}
  any
  [ return (result: t_BytesMut) ->
  {[@stop_split] [@expl:from_BytesMut ensures] ([@stop_split] [@expl:from result type invariant] [%#sbytes'0] inv_BytesMut result)
    /\ ([@stop_split] [@expl:from ensures] [%#sbytes'1] bytes_mut_seq result = bytes_seq bytes)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec mutable_from_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 201 0 201 51]
  (value: t_Bytes) (return (x: t_BytesMut)) =
  {[@stop_split] [@expl:mutable_from_bytes 'value' type invariant] [%#slib'0] inv_Bytes value}
  (! bb0
  [ bb0 = s0 [ s0 = from_BytesMut [%#slib] {value} (fun (_x: t_BytesMut) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_BytesMut = Any.any_l () | & value: t_Bytes = value ])
  [ return (result: t_BytesMut) ->
  {[@stop_split] [@expl:mutable_from_bytes ensures] ([@stop_split] [@expl:mutable_from_bytes result type invariant] [%#slib'1] inv_BytesMut result)
    /\ ([@stop_split] [@expl:mutable_from_bytes ensures] [%#slib'2] bytes_mut_seq result = bytes_seq value)}
    (! return {result}) ]
