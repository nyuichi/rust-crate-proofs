let rec mutable_from_str [#"/workspace/rust-crate-proofs/http/1.5.0/verification/bytes/src/lib.rs" 206 0 206 47]
  (data: string) (return (x: t_BytesMut)) = (! bb0
  [ bb0 = s0 [ s0 = from_BytesMut [%#slib] {data} (fun (_x: t_BytesMut) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_BytesMut = Any.any_l () | & data: string = data ])
  [ return (result: t_BytesMut) ->
  {[@stop_split] [@expl:mutable_from_str ensures] ([@stop_split] [@expl:mutable_from_str result type invariant] [%#slib'0] inv_BytesMut result)
    /\ ([@stop_split] [@expl:mutable_from_str ensures] [%#slib'1] bytes_mut_seq result = to_bytes (view_str data))}
    (! return {result}) ]
