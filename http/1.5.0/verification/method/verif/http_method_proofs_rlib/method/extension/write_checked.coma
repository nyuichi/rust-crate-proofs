  /\ UInt8.t'int byte <> 64
  /\ UInt8.t'int byte <> 91
  /\ UInt8.t'int byte <> 92 /\ UInt8.t'int byte <> 93 /\ UInt8.t'int byte <> 123 /\ UInt8.t'int byte <> 125

let rec is_method_char (byte: UInt8.t) (return (x: bool)) = any
