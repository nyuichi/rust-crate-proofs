type t_RangeTo_usize = { end': UInt64.t }

predicate in_bounds_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt8.t) =
  [%#sslice'7] UInt64.t'int self.end' <= Seq.length seq

predicate has_value_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  [%#sslice'8] Seq.([..]) seq 0 (UInt64.t'int self.end') = Slice64.view out

predicate resolve_elswhere_RangeTo_usize (self: t_RangeTo_usize) (old': Seq.seq UInt8.t) (fin: Seq.seq UInt8.t) =
  [%#sslice'9] forall i: int. UInt64.t'int self.end' <= i /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

