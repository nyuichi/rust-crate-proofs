    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#sslice'2] has_value_RangeTo_usize ix (Slice64.view self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#sslice'3] resolve_elswhere_RangeTo_usize ix (Slice64.view self_.current) (Slice64.view self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#sslice'4] Seq.length (Slice64.view self_.final)
    = Seq.length (Slice64.view self_.current))}
    (! return {result}) ]

let rec copy_from_slice_u8 (self_: MutBorrow.t (Slice64.slice UInt8.t)) (src: Slice64.slice UInt8.t) (return (x: ())) =
