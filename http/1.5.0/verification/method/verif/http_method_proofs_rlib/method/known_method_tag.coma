    method_text_matches bytes (method_model_text (Get)) \/ method_text_matches bytes (method_model_text (Put))
  else
    if Seq.length bytes = 4 then
      method_text_matches bytes (method_model_text (Post)) \/ method_text_matches bytes (method_model_text (Head))
    else
      if Seq.length bytes = 5 then
        method_text_matches bytes (method_model_text (Patch))
        \/ method_text_matches bytes (method_model_text (Trace))
        \/ method_text_matches bytes (method_model_text (Query))
      else
        if Seq.length bytes = 6 then
          method_text_matches bytes (method_model_text (Delete))
        else
          if Seq.length bytes = 7 then
            method_text_matches bytes (method_model_text (Options))
            \/ method_text_matches bytes (method_model_text (Connect))
          else
            false
        
      
    
  


