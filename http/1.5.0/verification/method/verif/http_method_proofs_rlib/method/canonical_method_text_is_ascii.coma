use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use int.Int

type t_MethodModel =
  | Options
  | Get
  | Post
  | Put
  | Delete
  | Head
  | Trace
  | Connect
  | Patch
  | Query
  | ExtensionInline (Seq.seq UInt8.t) int
  | ExtensionAllocated (Seq.seq UInt8.t)

constant const_MAX: UInt64.t = [%#smethod'4] (15: UInt64.t)

predicate is_method_char_model [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 37 0 37 45] (byte: UInt8.t) =
  [%#smethod'7] 33 <= UInt8.t'int byte
  /\ UInt8.t'int byte <= 126
  /\ UInt8.t'int byte <> 34
  /\ UInt8.t'int byte <> 40
  /\ UInt8.t'int byte <> 41
  /\ UInt8.t'int byte <> 44
  /\ UInt8.t'int byte <> 47
  /\ UInt8.t'int byte <> 58
  /\ UInt8.t'int byte <> 59
  /\ UInt8.t'int byte <> 60
  /\ UInt8.t'int byte <> 61
  /\ UInt8.t'int byte <> 62
  /\ UInt8.t'int byte <> 63
  /\ UInt8.t'int byte <> 64
  /\ UInt8.t'int byte <> 91
  /\ UInt8.t'int byte <> 92 /\ UInt8.t'int byte <> 93 /\ UInt8.t'int byte <> 123 /\ UInt8.t'int byte <> 125

predicate all_method_chars_valid [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 52 0 52 53] (bytes: Seq.seq UInt8.t) =
  [%#smethod'5] forall i: int. 0 <= i /\ i < Seq.length bytes -> is_method_char_model (Seq.get bytes i)

predicate method_text_matches [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 297 0 297 65] (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) =
  [%#smethod'8] Seq.length left = Seq.length right
  /\ (forall i: int. 0 <= i /\ i < Seq.length left -> Seq.get left i = Seq.get right i)

function method_model_text [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 275 0 275 56] (method: t_MethodModel) : Seq.seq UInt8.t
 = [%#smethod'3] match method with
    | Options -> Seq.create 7 [|(79: UInt8.t);(80: UInt8.t);(84: UInt8.t);(73: UInt8.t);(79: UInt8.t);(78: UInt8.t);(83: UInt8.t)|]
    | Get -> Seq.create 3 [|(71: UInt8.t);(69: UInt8.t);(84: UInt8.t)|]
    | Post -> Seq.create 4 [|(80: UInt8.t);(79: UInt8.t);(83: UInt8.t);(84: UInt8.t)|]
    | Put -> Seq.create 3 [|(80: UInt8.t);(85: UInt8.t);(84: UInt8.t)|]
    | Delete -> Seq.create 6 [|(68: UInt8.t);(69: UInt8.t);(76: UInt8.t);(69: UInt8.t);(84: UInt8.t);(69: UInt8.t)|]
    | Head -> Seq.create 4 [|(72: UInt8.t);(69: UInt8.t);(65: UInt8.t);(68: UInt8.t)|]
    | Trace -> Seq.create 5 [|(84: UInt8.t);(82: UInt8.t);(65: UInt8.t);(67: UInt8.t);(69: UInt8.t)|]
    | Connect -> Seq.create 7 [|(67: UInt8.t);(79: UInt8.t);(78: UInt8.t);(78: UInt8.t);(69: UInt8.t);(67: UInt8.t);(84: UInt8.t)|]
    | Patch -> Seq.create 5 [|(80: UInt8.t);(65: UInt8.t);(84: UInt8.t);(67: UInt8.t);(72: UInt8.t)|]
    | Query -> Seq.create 5 [|(81: UInt8.t);(85: UInt8.t);(69: UInt8.t);(82: UInt8.t);(89: UInt8.t)|]
    | ExtensionInline data len -> Seq.([..]) data 0 len
    | ExtensionAllocated data -> data
    end

predicate is_known_method_text [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 326 0 326 51] (bytes: Seq.seq UInt8.t) =
  [%#smethod'6] if Seq.length bytes = 3 then
    method_text_matches bytes (method_model_text (Get)) \/ method_text_matches bytes (method_model_text (Put))
  else
    if Seq.length bytes = 4 then
      method_text_matches bytes (method_model_text (Post)) \/ method_text_matches bytes (method_model_text (Head))
    else
      if Seq.length bytes = 5 then
        method_text_matches bytes (method_model_text (Patch))
        \/ method_text_matches bytes (method_model_text (Trace))
        \/ method_text_matches bytes (method_model_text (Query))
      else
        if Seq.length bytes = 6 then
          method_text_matches bytes (method_model_text (Delete))
        else
          if Seq.length bytes = 7 then
            method_text_matches bytes (method_model_text (Options))
            \/ method_text_matches bytes (method_model_text (Connect))
          else
            false
        
      
    
  


predicate method_model_is_canonical [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 377 0 377 61] (method: t_MethodModel) =
  [%#smethod'2] match method with
    | ExtensionInline data len -> Seq.length data = UInt64.t'int const_MAX
    /\ 0 < len
    /\ len <= UInt64.t'int const_MAX
    /\ all_method_chars_valid (Seq.([..]) data 0 len)
    /\ (forall i: int. len <= i /\ i < Seq.length data -> Seq.get data i = (0: UInt8.t))
    /\ not is_known_method_text (Seq.([..]) data 0 len)
    | ExtensionAllocated data -> Seq.length data > UInt64.t'int const_MAX
    /\ all_method_chars_valid data /\ not is_known_method_text data
    | _ -> true
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant method : t_MethodModel

function canonical_method_text_is_ascii [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 577 0 577 54] (method: t_MethodModel) : ()

goal vc_canonical_method_text_is_ascii: ([%#smethod] method_model_is_canonical method)
  -> match method with
    | Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query -> (forall i: int. 0 <= i
          /\ i < Seq.length (method_model_text method) -> UInt8.t'int (Seq.get (method_model_text method) i) < 128)
    && ([@stop_split] [@expl:canonical_method_text_is_ascii ensures] [%#smethod'0] forall i: int. 0 <= i
        /\ i < Seq.length (method_model_text method) -> UInt8.t'int (Seq.get (method_model_text method) i) < 128)
    | ExtensionInline data len -> (forall i: int. 0 <= i /\ i < Seq.length (Seq.([..]) data 0 len)
        -> UInt8.t'int (Seq.get (Seq.([..]) data 0 len) i) < 128)
    && ([@stop_split] [@expl:canonical_method_text_is_ascii ensures] [%#smethod'0] forall i: int. 0 <= i
        /\ i < Seq.length (method_model_text method) -> UInt8.t'int (Seq.get (method_model_text method) i) < 128)
    | ExtensionAllocated data -> (forall i: int. 0 <= i /\ i < Seq.length data -> UInt8.t'int (Seq.get data i) < 128)
    && ([@stop_split] [@expl:canonical_method_text_is_ascii ensures] [%#smethod'0] forall i: int. 0 <= i
        /\ i < Seq.length (method_model_text method) -> UInt8.t'int (Seq.get (method_model_text method) i) < 128)
    end
