type t_Ordering = Less | Equal | Greater

function cmp_log_char (self: Char.t) (o: Char.t) : t_Ordering = [%#sord] if Char.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_char (x: Char.t) (y: Char.t) : ()

axiom eq_cmp_char_spec: forall x: Char.t, y: Char.t. [%#sord'17] (x = y) = (cmp_log_char x y = Equal)

function antisym2_char (x: Char.t) (y: Char.t) : ()

axiom antisym2_char_spec: forall x: Char.t, y: Char.t. ([%#sord'15] cmp_log_char x y = Greater)
    -> ([%#sord'16] cmp_log_char y x = Less)

function antisym1_char (x: Char.t) (y: Char.t) : ()

axiom antisym1_char_spec: forall x: Char.t, y: Char.t. ([%#sord'13] cmp_log_char x y = Less)
    -> ([%#sord'14] cmp_log_char y x = Greater)

function trans_char (x: Char.t) (y: Char.t) (z: Char.t) (o: t_Ordering) : ()

axiom trans_char_spec: forall x: Char.t, y: Char.t, z: Char.t, o: t_Ordering. ([%#sord'10] cmp_log_char x y = o)
    -> ([%#sord'11] cmp_log_char y z = o) -> ([%#sord'12] cmp_log_char x z = o)

function refl_char (x: Char.t) : ()

axiom refl_char_spec: forall x: Char.t. [%#sord'9] cmp_log_char x x = Equal

function cmp_gt_log_char (x: Char.t) (y: Char.t) : ()

axiom cmp_gt_log_char_spec: forall x: Char.t, y: Char.t. [%#sord'8] Char.gt x y = (cmp_log_char x y = Greater)

function cmp_ge_log_char (x: Char.t) (y: Char.t) : ()

axiom cmp_ge_log_char_spec: forall x: Char.t, y: Char.t. [%#sord'7] Char.ge x y = (cmp_log_char x y <> Less)

function cmp_lt_log_char (x: Char.t) (y: Char.t) : ()

axiom cmp_lt_log_char_spec: forall x: Char.t, y: Char.t. [%#sord'6] Char.lt x y = (cmp_log_char x y = Less)

function cmp_le_log_char (x: Char.t) (y: Char.t) : ()

axiom cmp_le_log_char_spec: forall x: Char.t, y: Char.t. [%#sord'5] Char.le x y = (cmp_log_char x y <> Greater)

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'0] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_char (left: Seq.seq Char.t) (right: Seq.seq Char.t) : t_Ordering

axiom seq_cmp_char_def: forall left: Seq.seq Char.t, right: Seq.seq Char.t. seq_cmp_char left right
    = ([%#sseq_ord'7] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_char (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_char (tail_char left) (tail_char right)
          end
    
    )

function cmp_log_Seq_char (self: Seq.seq Char.t) (other: Seq.seq Char.t) : t_Ordering =
  [%#sseq_ord_impl] seq_cmp_char self other

function eq_cmp_Seq_char (x: Seq.seq Char.t) (y: Seq.seq Char.t) : ()

axiom eq_cmp_Seq_char_spec: forall x: Seq.seq Char.t, y: Seq.seq Char.t. [%#sseq_ord_impl'12] (x = y)
