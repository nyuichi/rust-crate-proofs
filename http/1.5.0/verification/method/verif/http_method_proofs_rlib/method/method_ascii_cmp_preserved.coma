    = (cmp_log_Seq_char x y = Less)

predicate le_log_Seq_char (self: Seq.seq Char.t) (o: Seq.seq Char.t) = [%#sord'1] cmp_log_Seq_char self o <> Greater

function cmp_le_log_Seq_char (x: Seq.seq Char.t) (y: Seq.seq Char.t) : ()

axiom cmp_le_log_Seq_char_spec: forall x: Seq.seq Char.t, y: Seq.seq Char.t. [%#sseq_ord_impl'0] le_log_Seq_char x y
    = (cmp_log_Seq_char x y <> Greater)

function push_front_char [@inline:trivial] (self: Seq.seq Char.t) (x: Char.t) : Seq.seq Char.t =
  [%#sseq] Seq.cons x self

meta "rewrite_def" function push_front_char

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq'0] Seq.([..]) self 1 (Seq.length self)

function ascii_char [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/ascii.rs" 19 0 19 42] (byte: UInt8.t) : Char.t

axiom ascii_char_spec: forall byte: UInt8.t. [%#sascii'4] UInt8.t'int byte < 128
    -> Char.to_int (ascii_char byte) = UInt8.t'int byte

function ascii_chars [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/ascii.rs" 159 0 159 54] (bytes: Seq.seq UInt8.t) : Seq.seq Char.t

axiom ascii_chars_def: forall bytes: Seq.seq UInt8.t. ascii_chars bytes
