  | ExtensionAllocated (Seq.seq UInt8.t)

constant const_MAX: UInt64.t = [%#smethod'13] (15: UInt64.t)

predicate is_method_char_model [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 37 0 37 45] (byte: UInt8.t) =
  [%#smethod'17] 33 <= UInt8.t'int byte
