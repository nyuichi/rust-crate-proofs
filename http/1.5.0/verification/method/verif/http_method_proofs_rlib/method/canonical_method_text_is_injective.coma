predicate method_text_matches [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 297 0 297 65] (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) =
  [%#smethod'16] Seq.length left = Seq.length right
  /\ (forall i: int. 0 <= i /\ i < Seq.length left -> Seq.get left i = Seq.get right i)

function method_model_text [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 275 0 275 56] (method: t_MethodModel) : Seq.seq UInt8.t
 = [%#smethod'11] match method with
    | Options -> Seq.create 7 [|(79: UInt8.t);(80: UInt8.t);(84: UInt8.t);(73: UInt8.t);(79: UInt8.t);(78: UInt8.t);(83: UInt8.t)|]
    | Get -> Seq.create 3 [|(71: UInt8.t);(69: UInt8.t);(84: UInt8.t)|]
    | Post -> Seq.create 4 [|(80: UInt8.t);(79: UInt8.t);(83: UInt8.t);(84: UInt8.t)|]
    | Put -> Seq.create 3 [|(80: UInt8.t);(85: UInt8.t);(84: UInt8.t)|]
    | Delete -> Seq.create 6 [|(68: UInt8.t);(69: UInt8.t);(76: UInt8.t);(69: UInt8.t);(84: UInt8.t);(69: UInt8.t)|]
    | Head -> Seq.create 4 [|(72: UInt8.t);(69: UInt8.t);(65: UInt8.t);(68: UInt8.t)|]
    | Trace -> Seq.create 5 [|(84: UInt8.t);(82: UInt8.t);(65: UInt8.t);(67: UInt8.t);(69: UInt8.t)|]
    | Connect -> Seq.create 7 [|(67: UInt8.t);(79: UInt8.t);(78: UInt8.t);(78: UInt8.t);(69: UInt8.t);(67: UInt8.t);(84: UInt8.t)|]
    | Patch -> Seq.create 5 [|(80: UInt8.t);(65: UInt8.t);(84: UInt8.t);(67: UInt8.t);(72: UInt8.t)|]
    | Query -> Seq.create 5 [|(81: UInt8.t);(85: UInt8.t);(69: UInt8.t);(82: UInt8.t);(89: UInt8.t)|]
    | ExtensionInline data len -> Seq.([..]) data 0 len
    | ExtensionAllocated data -> data
    end

predicate is_known_method_text [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 326 0 326 51] (bytes: Seq.seq UInt8.t) =
  [%#smethod'14] if Seq.length bytes = 3 then
    method_text_matches bytes (method_model_text (Get)) \/ method_text_matches bytes (method_model_text (Put))
  else
    if Seq.length bytes = 4 then
      method_text_matches bytes (method_model_text (Post)) \/ method_text_matches bytes (method_model_text (Head))
    else
      if Seq.length bytes = 5 then
        method_text_matches bytes (method_model_text (Patch))
        \/ method_text_matches bytes (method_model_text (Trace))
        \/ method_text_matches bytes (method_model_text (Query))
      else
        if Seq.length bytes = 6 then
          method_text_matches bytes (method_model_text (Delete))
        else
          if Seq.length bytes = 7 then
            method_text_matches bytes (method_model_text (Options))
            \/ method_text_matches bytes (method_model_text (Connect))
          else
            false
        
      
    
  


predicate method_model_is_canonical [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 377 0 377 61] (method: t_MethodModel) =
  [%#smethod'10] match method with
    | ExtensionInline data len -> Seq.length data = UInt64.t'int const_MAX
    /\ 0 < len
    /\ len <= UInt64.t'int const_MAX
    /\ all_method_chars_valid (Seq.([..]) data 0 len)
    /\ (forall i: int. len <= i /\ i < Seq.length data -> Seq.get data i = (0: UInt8.t))
    /\ not is_known_method_text (Seq.([..]) data 0 len)
    | ExtensionAllocated data -> Seq.length data > UInt64.t'int const_MAX
    /\ all_method_chars_valid data /\ not is_known_method_text data
    | _ -> true
    end

type tup2_MethodModel_MethodModel = { f0: t_MethodModel; f1: t_MethodModel }

function equal_canonical_inline_storage [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 410 0 415 1] (data1: Seq.seq UInt8.t) (len1: int) (data2: Seq.seq UInt8.t) (len2: int) : ()
 = [%#smethod'12] ()

axiom equal_canonical_inline_storage_spec:
  forall data1: Seq.seq UInt8.t, len1: int, data2: Seq.seq UInt8.t, len2: int. ([%#smethod'2] Seq.length data1
      = UInt64.t'int const_MAX)
    -> ([%#smethod'3] Seq.length data2 = UInt64.t'int const_MAX)
    -> ([%#smethod'4] 0 < len1 /\ len1 <= UInt64.t'int const_MAX)
    -> ([%#smethod'5] 0 < len2 /\ len2 <= UInt64.t'int const_MAX)
    -> ([%#smethod'6] forall i: int. len1 <= i /\ i < Seq.length data1 -> Seq.get data1 i = (0: UInt8.t))
    -> ([%#smethod'7] forall i: int. len2 <= i /\ i < Seq.length data2 -> Seq.get data2 i = (0: UInt8.t))
    -> ([%#smethod'8] (data1 = data2 /\ len1 = len2) = (Seq.([..]) data1 0 len1 = Seq.([..]) data2 0 len2))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant left : t_MethodModel

constant right : t_MethodModel

function canonical_method_text_is_injective [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 429 0 429 76] (left: t_MethodModel) (right: t_MethodModel) : ()

goal vc_canonical_method_text_is_injective: ([%#smethod] method_model_is_canonical left)
  -> ([%#smethod'0] method_model_is_canonical right)
  -> match { f0 = left; f1 = right } with
    | {f0 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query; f1 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query} -> (left
        = right)
      = (method_model_text left = method_model_text right)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = ExtensionInline data1 len1; f1 = ExtensionInline data2 len2} -> ([@stop_split] [@expl:equal_canonical_inline_storage requires] ([@stop_split] [@expl:equal_canonical_inline_storage requires #0] [%#smethod'2] Seq.length data1
        = UInt64.t'int const_MAX)
      /\ ([@stop_split] [@expl:equal_canonical_inline_storage requires #1] [%#smethod'3] Seq.length data2
        = UInt64.t'int const_MAX)
      /\ ([@stop_split] [@expl:equal_canonical_inline_storage requires #2] [%#smethod'4] 0 < len1
        /\ len1 <= UInt64.t'int const_MAX)
      /\ ([@stop_split] [@expl:equal_canonical_inline_storage requires #3] [%#smethod'5] 0 < len2
        /\ len2 <= UInt64.t'int const_MAX)
      /\ ([@stop_split] [@expl:equal_canonical_inline_storage requires #4] [%#smethod'6] forall i: int. len1 <= i
            /\ i < Seq.length data1 -> Seq.get data1 i = (0: UInt8.t))
      /\ ([@stop_split] [@expl:equal_canonical_inline_storage requires #5] [%#smethod'7] forall i: int. len2 <= i
          /\ i < Seq.length data2 -> Seq.get data2 i = (0: UInt8.t)))
    /\ (([@stop_split] [@expl:equal_canonical_inline_storage ensures] [%#smethod'8] (data1 = data2 /\ len1 = len2)
      = (Seq.([..]) data1 0 len1 = Seq.([..]) data2 0 len2))
    -> (let _ = equal_canonical_inline_storage data1 len1 data2 len2 in (ExtensionInline data1 len1
        = ExtensionInline data2 len2)
      = (Seq.([..]) data1 0 len1 = Seq.([..]) data2 0 len2)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))))
    | {f0 = ExtensionAllocated data1; f1 = ExtensionAllocated data2} -> (data1 = data2) = (data1 = data2)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query; f1 = ExtensionInline data len} -> is_known_method_text (method_model_text left)
    && not is_known_method_text (Seq.([..]) data 0 len)
    && (left = ExtensionInline data len) = (method_model_text left = Seq.([..]) data 0 len)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = ExtensionInline data len; f1 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query} -> is_known_method_text (method_model_text right)
    && not is_known_method_text (Seq.([..]) data 0 len)
    && (ExtensionInline data len = right) = (Seq.([..]) data 0 len = method_model_text right)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query; f1 = ExtensionAllocated data} -> is_known_method_text (method_model_text left)
    && not is_known_method_text data
    && (left = ExtensionAllocated data) = (method_model_text left = data)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = ExtensionAllocated data; f1 = Options | Get | Post | Put | Delete | Head | Trace | Connect | Patch | Query} -> is_known_method_text (method_model_text right)
    && not is_known_method_text data
    && (ExtensionAllocated data = right) = (data = method_model_text right)
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    | {f0 = ExtensionInline data len; f1 = ExtensionAllocated allocated} | {f0 = ExtensionAllocated allocated; f1 = ExtensionInline data len} -> len
      <> Seq.length allocated
    && (Seq.([..]) data 0 len = allocated) = false
    && ([@stop_split] [@expl:canonical_method_text_is_injective ensures] [%#smethod'1] (left = right)
    = (method_model_text left = method_model_text right))
    end
