predicate method_model_is_canonical [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/method.rs" 377 0 377 61] (method: t_MethodModel) =
  [%#smethod'23] match method with
    | ExtensionInline'0 data len -> Seq.length data = UInt64.t'int const_MAX
    /\ 0 < len
    /\ len <= UInt64.t'int const_MAX
    /\ all_method_chars_valid (Seq.([..]) data 0 len)
