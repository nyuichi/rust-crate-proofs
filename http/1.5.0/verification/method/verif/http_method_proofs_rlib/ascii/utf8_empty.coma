function utf8_empty [#"/workspace/rust-crate-proofs/http/1.5.0/verification/method/src/../../../src/ascii.rs" 194 0 194 26] : ()

goal vc_utf8_empty: [@stop_split] [@expl:utf8_empty ensures] [%#sascii] to_bytes (Seq.empty: Seq.seq Char.t)
  = (Seq.empty: Seq.seq UInt8.t)
