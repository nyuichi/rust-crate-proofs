axiom cmp_le_log_T_spec: forall x: t_T, y: t_T. [%#sord] le_log_T x y = (cmp_log_T x y <> Greater)

function tail_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/seq.rs" 163 4 163 29] (self: Seq.seq t_T) : Seq.seq t_T
 = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord.rs" 13 0 13 68] (left: Seq.seq t_T) (right: Seq.seq t_T) : t_Ordering

axiom seq_cmp_T_def: forall left: Seq.seq t_T, right: Seq.seq t_T. seq_cmp_T left right
    = ([%#sseq_ord'5] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_T (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_T (tail_T left) (tail_T right)
          end
    
    )

predicate well_founded_relation_Int [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/well_founded.rs" 42 4 42 55] [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant first : Seq.seq t_T

constant second : Seq.seq t_T

constant third : Seq.seq t_T

constant order : t_Ordering

function seq_cmp_trans_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord.rs" 77 0 82 1] (first: Seq.seq t_T) (second: Seq.seq t_T) (third: Seq.seq t_T) (order: t_Ordering) : ()

goal vc_seq_cmp_trans_T: ([%#sseq_ord'0] seq_cmp_T first second = order)
  -> ([%#sseq_ord'1] seq_cmp_T second third = order)
  -> (if Seq.length first > 0 then
    if Seq.length second > 0 then
      if Seq.length third > 0 then
        if cmp_log_T (Seq.get first 0) (Seq.get second 0) = Equal then
          if cmp_log_T (Seq.get second 0) (Seq.get third 0) = Equal then
            Seq.get first 0 = Seq.get second 0
            && Seq.get second 0 = Seq.get third 0
            && (([@stop_split] [@expl:seq_cmp_trans requires] ([@stop_split] [@expl:seq_cmp_trans requires #0] [%#sseq_ord'0] seq_cmp_T (tail_T first) (tail_T second)
                  = order)
                /\ ([@stop_split] [@expl:seq_cmp_trans requires #1] [%#sseq_ord'1] seq_cmp_T (tail_T second) (tail_T third)
                = order))
              /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sseq_ord] Seq.length first + Seq.length second
              + Seq.length third) ([%#sseq_ord] Seq.length (tail_T first) + Seq.length (tail_T second)
              + Seq.length (tail_T third))))
            /\ (([@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T (tail_T first) (tail_T third)
              = order)
            -> (let _ = seq_cmp_trans_T (tail_T first) (tail_T second) (tail_T third) order in [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third
            = order))
          else
            [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third = order
        
        else
          [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third = order
      
      else
        [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third = order
    
    else
      [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third = order
  
  else
    [@stop_split] [@expl:seq_cmp_trans ensures] [%#sseq_ord'2] seq_cmp_T first third = order
  )
