function tail_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/seq.rs" 163 4 163 29] (self: Seq.seq t_T) : Seq.seq t_T
 = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord.rs" 13 0 13 68] (left: Seq.seq t_T) (right: Seq.seq t_T) : t_Ordering

axiom seq_cmp_T_def: forall left: Seq.seq t_T, right: Seq.seq t_T. seq_cmp_T left right
    = ([%#sseq_ord'3] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_T (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_T (tail_T left) (tail_T right)
          end
    
    )

function cmp_log_Seq_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord_impl.rs" 8 4 8 45] (self: Seq.seq t_T) (other: Seq.seq t_T) : t_Ordering
 = [%#sseq_ord_impl'1] seq_cmp_T self other

function seq_eq_cmp_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord.rs" 42 0 42 59] (left: Seq.seq t_T) (right: Seq.seq t_T) : ()

axiom seq_eq_cmp_T_def: forall left: Seq.seq t_T, right: Seq.seq t_T. seq_eq_cmp_T left right
    = ([%#sseq_ord'1] if Seq.length left > 0
    /\ Seq.length right > 0 /\ cmp_log_T (Seq.get left 0) (Seq.get right 0) = Equal then
      let _ = seq_eq_cmp_T (tail_T left) (tail_T right) in ()
    else
      ()
    )

axiom seq_eq_cmp_T_spec: forall left: Seq.seq t_T, right: Seq.seq t_T. [%#sseq_ord] (seq_cmp_T left right = Equal)
    = (left = right)

