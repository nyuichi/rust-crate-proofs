function refl_Seq_T [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord_impl.rs" 30 4 30 20] (x: Seq.seq t_T) : ()

goal vc_refl_Seq_T: ([@stop_split] [@expl:seq_eq_cmp ensures] [%#sseq_ord] (seq_cmp_T x x = Equal) = (x = x))
  -> (let _ = seq_eq_cmp_T x x in [@stop_split] [@expl:refl ensures] [%#sseq_ord_impl] cmp_log_Seq_T x x = Equal)
