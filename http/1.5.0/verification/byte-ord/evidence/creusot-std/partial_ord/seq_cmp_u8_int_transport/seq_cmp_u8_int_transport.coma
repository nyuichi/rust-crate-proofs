function seq_cmp_u8 [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/seq_ord.rs" 13 0 13 68] (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) : t_Ordering

axiom seq_cmp_u8_def: forall left: Seq.seq UInt8.t, right: Seq.seq UInt8.t. seq_cmp_u8 left right
    = ([%#sseq_ord'0] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_u8 (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_u8 (tail_u8 left) (tail_u8 right)
          end
    
    )

function u8_int_cmp_transport [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/partial_ord.rs" 43 0 43 72] (left_byte: UInt8.t) (other_byte: UInt8.t) (integer: int) : ()
 = [%#spartial_ord'8] ()

axiom u8_int_cmp_transport_spec:
  forall left_byte: UInt8.t, other_byte: UInt8.t, integer: int. ([%#spartial_ord'3] integer = UInt8.t'int other_byte)
    -> ([%#spartial_ord'4] cmp_log_Int (UInt8.t'int left_byte) integer = cmp_log_u8 left_byte other_byte)

predicate well_founded_relation_Int [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/well_founded.rs" 42 4 42 55] [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant bytes : Seq.seq UInt8.t

constant other_bytes : Seq.seq UInt8.t

constant integers : Seq.seq int

function seq_cmp_u8_int_transport [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/partial_ord.rs" 56 0 60 1] (bytes: Seq.seq UInt8.t) (other_bytes: Seq.seq UInt8.t) (integers: Seq.seq int) : ()

goal vc_seq_cmp_u8_int_transport: ([%#spartial_ord'0] Seq.length other_bytes = Seq.length integers)
  -> ([%#spartial_ord'1] forall i: int. 0 <= i /\ i < Seq.length integers
      -> UInt8.t'int (Seq.get other_bytes i) = Seq.get integers i)
  -> (if Seq.length bytes > 0 then
    if Seq.length integers > 0 then
      let left_byte = Seq.get bytes 0 in let other_byte = Seq.get other_bytes 0 in let integer = Seq.get integers 0 in ([@stop_split] [@expl:u8_int_cmp_transport requires] [%#spartial_ord'3] integer
        = UInt8.t'int other_byte)
      /\ (([@stop_split] [@expl:u8_int_cmp_transport ensures] [%#spartial_ord'4] cmp_log_Int (UInt8.t'int left_byte) integer
        = cmp_log_u8 left_byte other_byte)
      -> (let _ = u8_int_cmp_transport left_byte other_byte integer in if cmp_log_Int (UInt8.t'int left_byte) integer
      = Equal then
        cmp_log_u8 left_byte other_byte = Equal
        && Seq.length (tail_u8 other_bytes) = Seq.length (tail_Int integers)
        && (forall i: int. 0 <= i /\ i < Seq.length (tail_Int integers)
            -> UInt8.t'int (Seq.get (tail_u8 other_bytes) i) = Seq.get (tail_Int integers) i)
        && (([@stop_split] [@expl:seq_cmp_u8_int_transport requires] ([@stop_split] [@expl:seq_cmp_u8_int_transport requires #0] [%#spartial_ord'0] Seq.length (tail_u8 other_bytes)
              = Seq.length (tail_Int integers))
            /\ ([@stop_split] [@expl:seq_cmp_u8_int_transport requires #1] [%#spartial_ord'1] forall i: int. 0 <= i
                /\ i < Seq.length (tail_Int integers)
              -> UInt8.t'int (Seq.get (tail_u8 other_bytes) i) = Seq.get (tail_Int integers) i))
          /\ ([@expl:variant decreases] well_founded_relation_Int ([%#spartial_ord] Seq.length bytes
          + Seq.length integers) ([%#spartial_ord] Seq.length (tail_u8 bytes) + Seq.length (tail_Int integers))))
        /\ (([@stop_split] [@expl:seq_cmp_u8_int_transport ensures] [%#spartial_ord'2] seq_cmp_u8_int (tail_u8 bytes) (tail_Int integers)
          = seq_cmp_u8 (tail_u8 bytes) (tail_u8 other_bytes))
        -> (let _ = seq_cmp_u8_int_transport (tail_u8 bytes) (tail_u8 other_bytes) (tail_Int integers) in [@stop_split] [@expl:seq_cmp_u8_int_transport ensures] [%#spartial_ord'2] seq_cmp_u8_int bytes integers
        = seq_cmp_u8 bytes other_bytes))
      else
        [@stop_split] [@expl:seq_cmp_u8_int_transport ensures] [%#spartial_ord'2] seq_cmp_u8_int bytes integers
        = seq_cmp_u8 bytes other_bytes
      ))
    else
      [@stop_split] [@expl:seq_cmp_u8_int_transport ensures] [%#spartial_ord'2] seq_cmp_u8_int bytes integers
      = seq_cmp_u8 bytes other_bytes
  
  else
    [@stop_split] [@expl:seq_cmp_u8_int_transport ensures] [%#spartial_ord'2] seq_cmp_u8_int bytes integers
    = seq_cmp_u8 bytes other_bytes
  )
