axiom ascii_chars_spec: forall bytes: Seq.seq UInt8.t. [%#sascii'3] Seq.length (ascii_chars bytes) = Seq.length bytes

axiom ascii_chars_spec'0: forall bytes: Seq.seq UInt8.t. [%#sascii'4] Seq.length bytes = 0
