goal refines: forall self_: t_StatusCode. forall rhs: t_StatusCode. ([%#scmp] inv_ref_StatusCode self_)
        /\ ([%#scmp'0] inv_ref_StatusCode rhs)
      -> ([%#sstatus] inv_ref_StatusCode self_)
      /\ ([%#sstatus'0] inv_ref_StatusCode rhs)
      /\ (forall result: t_Option_Ordering. ([%#sstatus'1] result
