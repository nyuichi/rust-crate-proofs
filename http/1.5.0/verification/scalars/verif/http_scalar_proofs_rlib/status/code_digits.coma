function status_digit_byte [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/status.rs" 54 0 54 55] (code: int) (column: int) : int
 = [%#sstatus'4] if column = 0 then
    48 + ComputerDivision.div code 100
  else
    if column = 1 then
      48 + ComputerDivision.mod (ComputerDivision.div code 10) 10
    else
      48 + ComputerDivision.mod code 10
  


let rec build_code_digits (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:build_code_digits ensures] ([@stop_split] [@expl:build_code_digits result type invariant] [%#sstatus'5] inv_array_u8_2700 result)
    /\ ([@stop_split] [@expl:build_code_digits ensures] [%#sstatus'6] forall i: int. 0 <= i
        /\ i < Seq.length (Slice64.view result)
      -> UInt8.t'int (Seq.get (Slice64.view result) i)
      = status_digit_byte (100 + ComputerDivision.div i 3) (ComputerDivision.mod i 3))}
    (! return {result}) ]

