predicate is_zero_u16 (self: UInt16.t) = [%#snum'2] UInt16.t'int self = 0

let rec get_u16 (self_: t_NonZero_u16) (return (x: UInt16.t)) =
  {[@stop_split] [@expl:get 'self_' type invariant] [%#snum] inv_NonZero_u16 self_}
