use creusot.int.UInt16
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Char
use map.Map
use int.ComputerDivision
use int.Int

type t_NonZero_u16

type t_StatusCode = { f0: t_NonZero_u16 }

type t_InvalidStatusCode = { _priv: () }

type t_Result_StatusCode_InvalidStatusCode = Ok t_StatusCode | Err t_InvalidStatusCode

function nonzero_value_u16 (_value: t_NonZero_u16) : UInt16.t

function deep_model_NonZero_u16 (self: t_NonZero_u16) : int = [%#snum] UInt16.t'int (nonzero_value_u16 self)

function view_StatusCode [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/status.rs" 140 4 140 33] (self: t_StatusCode) : int
 = [%#sstatus'2] deep_model_NonZero_u16 self.f0

predicate invariant_StatusCode [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/status.rs" 166 4 166 30] (self: t_StatusCode) =
  [%#sstatus'4] 100 <= view_StatusCode self /\ view_StatusCode self <= 999

predicate inv_NonZero_u16 (_1: t_NonZero_u16)

predicate inv_StatusCode (_1: t_StatusCode)

axiom inv_axiom [@rewrite]: forall x: t_StatusCode [inv_StatusCode x]. inv_StatusCode x
    = (invariant_StatusCode x /\ inv_NonZero_u16 x.f0)

predicate inv_Result_StatusCode_InvalidStatusCode (_1: t_Result_StatusCode_InvalidStatusCode)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Result_StatusCode_InvalidStatusCode [inv_Result_StatusCode_InvalidStatusCode x]. inv_Result_StatusCode_InvalidStatusCode x
    = match x with
      | Ok f0'0 -> inv_StatusCode f0'0
      | Err f0'0 -> true
      end

predicate valid_status_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/status.rs" 31 0 31 71] (bytes: Seq.seq UInt8.t) =
  [%#sstatus'1] Seq.length bytes = 3
  /\ 49 <= UInt8.t'int (Seq.get bytes 0)
  /\ UInt8.t'int (Seq.get bytes 0) <= 57
  /\ 48 <= UInt8.t'int (Seq.get bytes 1)
  /\ UInt8.t'int (Seq.get bytes 1) <= 57 /\ 48 <= UInt8.t'int (Seq.get bytes 2) /\ UInt8.t'int (Seq.get bytes 2) <= 57

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'1] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'0] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function status_bytes_value [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/status.rs" 42 0 42 70] (bytes: Seq.seq UInt8.t) : int
 = [%#sstatus'3] if Seq.length bytes = 3 then
    (UInt8.t'int (Seq.get bytes 0) - 48) * 100 + (UInt8.t'int (Seq.get bytes 1) - 48) * 10
      + UInt8.t'int (Seq.get bytes 2)
    - 48
  else
    0


meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall value: string. forall result: t_Result_StatusCode_InvalidStatusCode. ([%#sstatus] inv_Result_StatusCode_InvalidStatusCode result)
        /\ ([%#sstatus'0] match result with
          | Ok code -> valid_status_bytes (to_bytes (view_str value))
          /\ view_StatusCode code = status_bytes_value (to_bytes (view_str value)) /\ invariant_StatusCode code
          | Err _ -> not valid_status_bytes (to_bytes (view_str value))
          end) -> inv_Result_StatusCode_InvalidStatusCode result
