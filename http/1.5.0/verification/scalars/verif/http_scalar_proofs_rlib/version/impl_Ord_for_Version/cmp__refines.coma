goal refines: forall self_: t_Version. forall rhs: t_Version. ([%#scmp] inv_ref_Version self_)
        /\ ([%#scmp'0] inv_ref_Version rhs)
      -> ([%#sversion] inv_ref_Version self_)
      /\ ([%#sversion'0] inv_ref_Version rhs)
      /\ (forall result: t_Ordering. ([%#sversion'1] result
          = cmp_log_Int (deep_model_ref_Version self_) (deep_model_ref_Version rhs))
        -> ([%#scmp'1] result = cmp_log_Int (deep_model_Version self_) (deep_model_Version rhs)))
