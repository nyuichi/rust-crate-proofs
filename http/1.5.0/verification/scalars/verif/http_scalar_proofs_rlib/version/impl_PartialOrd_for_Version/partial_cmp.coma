type t_Http = Http09 | Http10 | Http11 | H2 | H3 | C___NonExhaustive

type t_Version = { f0: t_Http }

type t_Ordering = Less | Equal | Greater

function deep_model_Http [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/version.rs" 176 4 176 44] (self: t_Http) : int
 = [%#sversion'8] match self with
    | Http09 -> 9
    | Http10 -> 10
    | Http11 -> 11
    | H2 -> 20
    | H3 -> 30
    | C___NonExhaustive -> 255
    end

function view_Version [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/version.rs" 35 4 35 33] (self: t_Version) : int
 = [%#sversion'7] deep_model_Http self.f0

predicate invariant_Version [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/version.rs" 51 4 51 30] (self: t_Version) =
  [%#sversion'9] view_Version self = 9
  \/ view_Version self = 10 \/ view_Version self = 11 \/ view_Version self = 20 \/ view_Version self = 30

predicate inv_Version (_1: t_Version)

axiom inv_axiom [@rewrite]: forall x: t_Version [inv_Version x]. inv_Version x = invariant_Version x

predicate invariant_ref_Version [@inline:trivial] (self: t_Version) = [%#sinvariant] inv_Version self

meta "rewrite_def" predicate invariant_ref_Version

predicate inv_ref_Version [@inline:trivial] (_1: t_Version) = invariant_ref_Version _1

meta "rewrite_def" predicate inv_ref_Version

function cmp_log_Int (self: int) (o: int) : t_Ordering = [%#sord] if self < o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_Int (x: int) (y: int) : ()

axiom eq_cmp_Int_spec: forall x: int, y: int. [%#sord'12] (x = y) = (cmp_log_Int x y = Equal)

function antisym2_Int (x: int) (y: int) : ()

axiom antisym2_Int_spec: forall x: int, y: int. ([%#sord'10] cmp_log_Int x y = Greater)
    -> ([%#sord'11] cmp_log_Int y x = Less)

function antisym1_Int (x: int) (y: int) : ()

axiom antisym1_Int_spec: forall x: int, y: int. ([%#sord'8] cmp_log_Int x y = Less)
    -> ([%#sord'9] cmp_log_Int y x = Greater)

function trans_Int (x: int) (y: int) (z: int) (o: t_Ordering) : ()

axiom trans_Int_spec: forall x: int, y: int, z: int, o: t_Ordering. ([%#sord'5] cmp_log_Int x y = o)
    -> ([%#sord'6] cmp_log_Int y z = o) -> ([%#sord'7] cmp_log_Int x z = o)

function refl_Int (x: int) : ()

axiom refl_Int_spec: forall x: int. [%#sord'4] cmp_log_Int x x = Equal

function cmp_gt_log_Int (x: int) (y: int) : ()

axiom cmp_gt_log_Int_spec: forall x: int, y: int. [%#sord'3] (x > y) = (cmp_log_Int x y = Greater)

function cmp_ge_log_Int (x: int) (y: int) : ()

axiom cmp_ge_log_Int_spec: forall x: int, y: int. [%#sord'2] (x >= y) = (cmp_log_Int x y <> Less)

function cmp_lt_log_Int (x: int) (y: int) : ()

axiom cmp_lt_log_Int_spec: forall x: int, y: int. [%#sord'1] (x < y) = (cmp_log_Int x y = Less)

function cmp_le_log_Int (x: int) (y: int) : ()

axiom cmp_le_log_Int_spec: forall x: int, y: int. [%#sord'0] (x <= y) = (cmp_log_Int x y <> Greater)

function deep_model_Version [#"/workspace/rust-crate-proofs/http/1.5.0/verification/scalars/src/../../../src/version.rs" 44 4 44 44] (self: t_Version) : int
 = [%#sversion'6] view_Version self

function deep_model_ref_Version [@inline:trivial] (self: t_Version) : int = [%#smodel] deep_model_Version self

meta "rewrite_def" function deep_model_ref_Version

let rec cmp_Version (self: t_Version) (other: t_Version) (return (x: t_Ordering)) =
  {[@stop_split] [@expl:cmp_Version requires] ([@stop_split] [@expl:cmp 'self' type invariant] [%#sversion'3] inv_ref_Version self)
  /\ ([@stop_split] [@expl:cmp 'other' type invariant] [%#sversion'4] inv_ref_Version other)}
  any
  [ return (result: t_Ordering) -> {[@stop_split] [@expl:cmp ensures] [%#sversion'5] result
    = cmp_log_Int (deep_model_ref_Version self) (deep_model_ref_Version other)}
    (! return {result}) ]

type t_Option_Ordering = None | Some t_Ordering

