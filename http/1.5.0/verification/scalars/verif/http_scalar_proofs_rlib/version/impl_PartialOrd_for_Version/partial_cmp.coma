    | s1 = [ &_ret <- Some _6 ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_Option_Ordering = Any.any_l ()
  | & self: t_Version = self
  | & other: t_Version = other
  | & _6: t_Ordering = Any.any_l () ])
  [ return (result: t_Option_Ordering) -> {[@stop_split] [@expl:partial_cmp ensures] [%#sversion'2] result
    = Some (cmp_log_Int (deep_model_ref_Version self) (deep_model_ref_Version other))}
    (! return {result}) ]
