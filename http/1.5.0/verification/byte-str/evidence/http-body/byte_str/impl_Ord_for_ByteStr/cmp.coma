function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec cmp_Bytes (self_: t_Bytes) (other: t_Bytes) (return (x: t_Ordering)) =
  {[@stop_split] [@expl:cmp_Bytes requires] ([@stop_split] [@expl:cmp 'self_' type invariant] [%#sbytes] inv_ref_Bytes self_)
  /\ ([@stop_split] [@expl:cmp 'other' type invariant] [%#sbytes'0] inv_ref_Bytes other)}
