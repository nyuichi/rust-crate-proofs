type t_EvenHasher = { f0: UInt64.t }

predicate invariant_EvenHasher [#"/workspace/rust-crate-proofs/http/1.5.0/verification/byte-str/src/hash_protocol_probe.rs" 8 4 8 30] (self: t_EvenHasher) =
  [%#shash_protocol_probe'0] ComputerDivision.mod (UInt64.t'int self.f0) 2 = 0

predicate inv_EvenHasher (_1: t_EvenHasher)

axiom inv_axiom [@rewrite]: forall x: t_EvenHasher [inv_EvenHasher x]. inv_EvenHasher x = invariant_EvenHasher x

predicate invariant_refmut_EvenHasher [@inline:trivial] (self: MutBorrow.t t_EvenHasher) =
  [%#sinvariant] inv_EvenHasher self.current /\ inv_EvenHasher self.final

meta "rewrite_def" predicate invariant_refmut_EvenHasher

predicate inv_refmut_EvenHasher [@inline:trivial] (_1: MutBorrow.t t_EvenHasher) = invariant_refmut_EvenHasher _1

meta "rewrite_def" predicate inv_refmut_EvenHasher

meta "compute_max_steps" 1000000

