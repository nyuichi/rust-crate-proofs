use creusot.prelude.Char
use seq.Seq
use creusot.int.UInt8
use map.Map
use int.ComputerDivision
use int.Int

function tail_char [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/seq.rs" 163 4 163 29] (self: Seq.seq Char.t) : Seq.seq Char.t
 = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/seq.rs" 318 4 318 65] (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/char.rs" 78 0 78 34] (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/char.rs" 47 4 47 31] (self: Char.t) : Seq.seq UInt8.t
 = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

predicate well_founded_relation_Int [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/logic/well_founded.rs" 42 4 42 55] [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq Char.t

function to_bytes [#"/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/string.rs" 288 4 288 36] (self: Seq.seq Char.t) : Seq.seq UInt8.t

goal vc_to_bytes: if Seq.length self = 0 then
    [@stop_split] [@expl:to_bytes ensures] [%#sstring'0] (Seq.empty: Seq.seq UInt8.t)
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)
  else
    ([@stop_split] [@expl:to_utf8 ensures] [%#schar] 1 <= Seq.length (to_utf8_char (Seq.get self 0))
      /\ Seq.length (to_utf8_char (Seq.get self 0)) <= 4)
    -> ([@expl:variant decreases] well_founded_relation_Int ([%#sstring] Seq.length self) ([%#sstring] Seq.length (tail_char self)))
    /\ (([@stop_split] [@expl:to_bytes ensures] [%#sstring'0] to_bytes (tail_char self)
      = flat_map_char (tail_char self) (fun (c: Char.t) -> to_utf8_char c))
    -> ([@stop_split] [@expl:to_bytes ensures] [%#sstring'0] Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)))
  
