type t20

function to_int2 t20 : int

axiom to_int [@useraxiom] :
  forall c:t20.
   (infix_lseq 0 (to_int2 c) /\ infix_ls (to_int2 c) 0x10FFFF) /\
   not (infix_lseq 0xD800 (to_int2 c) /\ infix_ls (to_int2 c) 0xE000)

axiom extensionality1 [@useraxiom] :
  forall x:t20, y:t20 [to_int2 x, to_int2 y]. to_int2 x = to_int2 y -> x = y

function of_int3 int : t20

axiom to_of_int1 [@useraxiom] :
  forall n:int [of_int3 n].
   (infix_lseq 0 n /\ infix_ls n 0x10FFFF) /\
   not (infix_lseq 0xD800 n /\ infix_ls n 0xE000) -> to_int2 (of_int3 n) = n

predicate le1 [@inline:trivial] (a:t20) (b:t20) =
  infix_lseq (to_int2 a) (to_int2 b)

predicate lt1 [@inline:trivial] (a:t20) (b:t20) =
  infix_ls (to_int2 a) (to_int2 b)

predicate ge1 [@inline:trivial] (a:t20) (b:t20) =
  infix_gteq (to_int2 a) (to_int2 b)

predicate gt1 [@inline:trivial] (a:t20) (b:t20) =
  infix_gt (to_int2 a) (to_int2 b)

