function andb (x:bool) (y:bool) : bool =
  match x with
  | True -> y
  | False -> False
  end

function orb (x:bool) (y:bool) : bool =
  match x with
  | False -> y
  | True -> True
  end

function notb (x:bool) : bool = match x with
  | False -> True
  | True -> False
  end

function xorb (x:bool) (y:bool) : bool =
  match x with
  | False -> y
  | True -> notb y
  end

function implb (x:bool) (y:bool) : bool =
  match x with
  | False -> True
  | True -> y
  end

(* use bool.Bool1 *)

function nth1 t18 int : bool

axiom nth_out_of_bound :
  forall x:t18, n:int. infix_ls n 0 \/ infix_gteq n size -> nth1 x n = False

(* meta remove_unused:dependency prop nth_out_of_bound, function nth1 *)

axiom Nth_zeros : forall n:int. nth1 zeros n = False

(* meta remove_unused:dependency prop Nth_zeros, constant zeros *)

axiom Nth_ones :
  forall n:int. infix_lseq 0 n /\ infix_ls n size -> nth1 ones n = True

(* meta remove_unused:dependency prop Nth_ones, constant ones *)

function bw_and1 t18 t18 : t18

axiom Nth_bw_and :
  forall v1:t18, v2:t18, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth1 (bw_and1 v1 v2) n = andb (nth1 v1 n) (nth1 v2 n)

(* meta remove_unused:dependency prop Nth_bw_and, function bw_and1 *)

function bw_or1 t18 t18 : t18

axiom Nth_bw_or :
  forall v1:t18, v2:t18, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth1 (bw_or1 v1 v2) n = orb (nth1 v1 n) (nth1 v2 n)

(* meta remove_unused:dependency prop Nth_bw_or, function bw_or1 *)

function bw_xor1 t18 t18 : t18

axiom Nth_bw_xor :
  forall v1:t18, v2:t18, n:int.
   infix_lseq 0 n /\ infix_ls n size ->
   nth1 (bw_xor1 v1 v2) n = xorb (nth1 v1 n) (nth1 v2 n)

(* meta remove_unused:dependency prop Nth_bw_xor, function bw_xor1 *)

function bw_not1 t18 : t18

axiom Nth_bw_not :
  forall v:t18, n:int.
   infix_lseq 0 n /\ infix_ls n size -> nth1 (bw_not1 v) n = notb (nth1 v n)

(* meta remove_unused:dependency prop Nth_bw_not, function bw_not1 *)

function lsr t18 int : t18

axiom Lsr_nth_low :
  forall b:t18, n:int, s:int.
   infix_lseq 0 s ->
   infix_lseq 0 n ->
   infix_ls (infix_pl n s) size -> nth1 (lsr b s) n = nth1 b (infix_pl n s)

(* meta remove_unused:dependency prop Lsr_nth_low, function lsr *)

axiom Lsr_nth_high :
  forall b:t18, n:int, s:int.
   infix_lseq 0 s ->
   infix_lseq 0 n ->
   infix_gteq (infix_pl n s) size -> nth1 (lsr b s) n = False

(* meta remove_unused:dependency prop Lsr_nth_high, function lsr *)

axiom lsr_zeros : forall x:t18. lsr x 0 = x

(* meta remove_unused:dependency prop lsr_zeros, function lsr *)

function asr t18 int : t18

axiom Asr_nth_low :
  forall b:t18, n:int, s:int.
   infix_lseq 0 s ->
   infix_lseq 0 n /\ infix_ls n size ->
   infix_ls (infix_pl n s) size -> nth1 (asr b s) n = nth1 b (infix_pl n s)

(* meta remove_unused:dependency prop Asr_nth_low, function asr *)

axiom Asr_nth_high :
  forall b:t18, n:int, s:int.
   infix_lseq 0 s ->
   infix_lseq 0 n /\ infix_ls n size ->
   infix_gteq (infix_pl n s) size ->
   nth1 (asr b s) n = nth1 b (infix_mn size 1)

(* meta remove_unused:dependency prop Asr_nth_high, function asr *)

axiom asr_zeros : forall x:t18. asr x 0 = x

(* meta remove_unused:dependency prop asr_zeros, function asr *)

