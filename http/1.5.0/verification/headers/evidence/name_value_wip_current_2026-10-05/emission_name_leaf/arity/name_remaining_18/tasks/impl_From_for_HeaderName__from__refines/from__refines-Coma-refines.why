type map 'a 'b = 'a -> 'b

function get1 (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function set1 (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b =
  fun (y:'a) -> if y = x then v else infix_at f y

function mixfix_lbrb1 (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function mixfix_lblsmnrb1 (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b = set1 f x v

