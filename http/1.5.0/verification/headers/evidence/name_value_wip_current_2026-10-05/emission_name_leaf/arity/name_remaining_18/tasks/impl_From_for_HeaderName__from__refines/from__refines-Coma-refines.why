predicate is_signed_positive t18

function of_int1 int : t18

function to_int (x:t18) : int =
  if is_signed_positive x then tqtint1 x
  else prefix_mn (infix_mn two_power_size1 (tqtint1 x))

axiom to_uint_extensionality :
  forall v:t18, vqt:t18. tqtint1 v = tqtint1 vqt -> v = vqt

(* meta remove_unused:dependency prop to_uint_extensionality,
  function tqtint1 *)

axiom to_int_extensionality :
  forall v:t18, vqt:t18. to_int v = to_int vqt -> v = vqt

(* meta remove_unused:dependency prop to_int_extensionality,
  function to_int *)

predicate uint_in_range (i:int) = infix_lseq 0 i /\ infix_lseq i tqtmaxInt1

