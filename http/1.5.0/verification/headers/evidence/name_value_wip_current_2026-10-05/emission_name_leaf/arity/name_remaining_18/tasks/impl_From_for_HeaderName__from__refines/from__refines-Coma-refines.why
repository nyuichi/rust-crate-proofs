function div1 int int : int

function mod1 int int : int

axiom Div_mod1 [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div1 x y)) (mod1 x y)

(* meta remove_unused:dependency prop Div_mod1, function div1 *)

(* meta remove_unused:dependency prop Div_mod1, function mod1 *)

axiom Mod_bound1 [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> infix_lseq 0 (mod1 x y) /\ infix_ls (mod1 x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound1, function mod1 *)

axiom Div_unique :
  forall x:int, y:int, q:int.
   infix_gt y 0 ->
   infix_lseq (infix_as q y) x /\ infix_ls x (infix_pl (infix_as q y) y) ->
   div1 x y = q

(* meta remove_unused:dependency prop Div_unique, function div1 *)

axiom Div_bound1 :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div1 x y) /\ infix_lseq (div1 x y) x

(* meta remove_unused:dependency prop Div_bound1, function div1 *)

axiom Mod_11 : forall x:int. mod1 x 1 = 0

(* meta remove_unused:dependency prop Mod_11, function mod1 *)

axiom Div_11 : forall x:int. div1 x 1 = x

(* meta remove_unused:dependency prop Div_11, function div1 *)

axiom Div_inf1 :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> div1 x y = 0

(* meta remove_unused:dependency prop Div_inf1, function div1 *)

axiom Div_inf_neg :
  forall x:int, y:int.
   infix_ls 0 x /\ infix_lseq x y -> div1 (prefix_mn x) y = (- 1)

(* meta remove_unused:dependency prop Div_inf_neg, function div1 *)

axiom Mod_0 : forall y:int. not y = 0 -> mod1 0 y = 0

(* meta remove_unused:dependency prop Mod_0, function mod1 *)

axiom Div_1_left : forall y:int. infix_gt y 1 -> div1 1 y = 0

(* meta remove_unused:dependency prop Div_1_left, function div1 *)

axiom Div_minus1_left : forall y:int. infix_gt y 1 -> div1 (- 1) y = (- 1)

(* meta remove_unused:dependency prop Div_minus1_left, function div1 *)

axiom Mod_1_left : forall y:int. infix_gt y 1 -> mod1 1 y = 1

(* meta remove_unused:dependency prop Mod_1_left, function mod1 *)

axiom Mod_minus1_left :
  forall y:int. infix_gt y 1 -> mod1 (- 1) y = infix_mn y 1

(* meta remove_unused:dependency prop Mod_minus1_left, function mod1 *)

axiom Div_mult1 :
  forall x:int, y:int, z:int [div1 (infix_pl (infix_as x y) z) x].
   infix_gt x 0 -> div1 (infix_pl (infix_as x y) z) x = infix_pl y (div1 z x)

(* meta remove_unused:dependency prop Div_mult1, function div1 *)

axiom Mod_mult1 :
  forall x:int, y:int, z:int [mod1 (infix_pl (infix_as x y) z) x].
   infix_gt x 0 -> mod1 (infix_pl (infix_as x y) z) x = mod1 z x

(* meta remove_unused:dependency prop Mod_mult1, function mod1 *)

