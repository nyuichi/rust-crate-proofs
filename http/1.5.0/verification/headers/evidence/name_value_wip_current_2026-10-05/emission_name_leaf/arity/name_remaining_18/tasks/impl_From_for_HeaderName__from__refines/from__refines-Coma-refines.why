(* meta model_record function inner *)

function tail_char (self:seq t20) : seq t20 =
  mixfix_lbdtdtrb self 1 (length self)

function flat_map_char (seq t20) (t20 -> seq t17) : seq t17

axiom flat_map_char_def [@useraxiom] :
  forall self:seq t20, other:t20 -> seq t17.
   flat_map_char self other =
   (if length self = 0 then empty: seq t17
    else infix_plpl (get1 other (get self 0))
         (flat_map_char (tail_char self) other))

function utf8_byte int : t17

axiom utf8_byte_spec [@useraxiom] :
  forall value:int.
   infix_lseq 0 value /\ infix_lseq value 255 ->
   tqtint (utf8_byte value) = value

function to_utf8_char (self:t20) : seq t17 =
  let code = to_int2 self in
  if infix_ls code 128 then singleton (utf8_byte code)
  else if infix_ls code 2048
       then snoc (singleton (utf8_byte (infix_pl 192 (div code 64))))
            (utf8_byte (infix_pl 128 (mod code 64)))
       else if infix_ls code 65536
            then snoc
                 (snoc (singleton (utf8_byte (infix_pl 224 (div code 4096))))
                  (utf8_byte (infix_pl 128 (mod (div code 64) 64))))
                 (utf8_byte (infix_pl 128 (mod code 64)))
            else snoc
                 (snoc
                  (snoc
                   (singleton (utf8_byte (infix_pl 240 (div code 262144))))
                   (utf8_byte (infix_pl 128 (mod (div code 4096) 64))))
                  (utf8_byte (infix_pl 128 (mod (div code 64) 64))))
                 (utf8_byte (infix_pl 128 (mod code 64)))

axiom to_utf8_char_spec [@useraxiom] :
  forall self:t20.
   infix_lseq 1 (length (to_utf8_char self)) /\
   infix_lseq (length (to_utf8_char self)) 4

function to_bytes (seq t20) : seq t17

axiom to_bytes_def [@useraxiom] :
  forall self:seq t20.
   to_bytes self =
   (if length self = 0 then empty: seq t17
    else infix_plpl (to_utf8_char (get self 0)) (to_bytes (tail_char self)))

axiom to_bytes_spec [@useraxiom] :
  forall self:seq t20.
   to_bytes self = flat_map_char self (fun (c:t20) -> to_utf8_char c)

predicate valid_utf8 (bytes:seq t17) =
  exists characters:seq t20. to_bytes characters = bytes

function view_ByteStr t_ByteStr : seq t17

predicate invariant_ByteStr (self:t_ByteStr) = valid_utf8 (view_ByteStr self)

predicate inv_ByteStr t_ByteStr

axiom inv_axiom [@useraxiom] :
  forall x:t_ByteStr [inv_ByteStr x]. inv_ByteStr x -> invariant_ByteStr x

predicate inv_Custom t_Custom

axiom inv_axiomqt0 [@useraxiom] [@rewrite] :
  forall x:t_Custom [inv_Custom x]. inv_Custom x <-> inv_ByteStr (x.f0)

predicate inv_Repr_Custom t_Repr_Custom

axiom inv_axiomqt1 [@useraxiom] [@rewrite] :
  forall x:t_Repr_Custom [inv_Repr_Custom x].
   inv_Repr_Custom x <->
   match x with
   | Standard f0qt0 -> true
   | Custom f0qt0 -> inv_Custom f0qt0
   end

predicate inv_HeaderName t_HeaderName

axiom inv_axiomqt2 [@useraxiom] [@rewrite] :
  forall x:t_HeaderName [inv_HeaderName x].
   inv_HeaderName x <-> inv_Repr_Custom (x.inner)

predicate invariant_ref_HeaderName [@inline:trivial] (self:t_HeaderName) =
  inv_HeaderName self

(* meta rewrite_def predicate invariant_ref_HeaderName *)

predicate inv_ref_HeaderName [@inline:trivial] (us1:t_HeaderName) =
  invariant_ref_HeaderName us1

