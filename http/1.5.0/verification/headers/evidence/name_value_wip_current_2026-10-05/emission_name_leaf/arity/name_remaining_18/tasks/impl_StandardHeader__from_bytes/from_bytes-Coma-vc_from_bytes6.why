type slice 'a

function elts [@is_field_id] [@builtin] (slice 'a) : seq 'a

axiom sliceqtinvariant :
  forall self:slice 'a [self.elts].
   [@hyp_name:TypeInvariant] in_bounds (length (self.elts))

predicate sliceqteq (a:slice 'a) (b:slice 'a) = a.elts = b.elts

axiom sliceqtinj [@W:non_conservative_extension:N] :
  forall a:slice 'a, b:slice 'a. sliceqteq a b -> a = b

(* meta remove_unused:dependency prop sliceqtinj, predicate sliceqteq *)

(* meta model_record function elts *)

axiom slice_ext [@useraxiom] :
  forall x:slice 'a, y:slice 'a. x.elts = y.elts -> x = y

type array 'a = slice 'a

function length1 (slice 'a) : t17

axiom spec [@useraxiom] :
  forall s:slice 'a. tqtint (length1 s) = length (s.elts)

function view (s:slice 'a) : seq 'a = s.elts

function slice_ptr_len ptr : t17

