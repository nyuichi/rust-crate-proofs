type t_MaybeLower = { buf: Slice64.slice UInt8.t; lower: bool }

type t_H

predicate inv_H (_1: t_H)

type tup2_refmut_H_ref_slice_u8 = { f0: MutBorrow.t t_H; f1: Slice64.slice UInt8.t }

predicate invariant_refmut_H [@inline:trivial] (self: MutBorrow.t t_H) =
  [%#sinvariant] inv_H self.current /\ inv_H self.final

meta "rewrite_def" predicate invariant_refmut_H

predicate inv_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = invariant_refmut_H _1

meta "rewrite_def" predicate inv_refmut_H

predicate precondition_write (self: ()) (args: tup2_refmut_H_ref_slice_u8)

axiom precondition_fndef:
  forall args: tup2_refmut_H_ref_slice_u8 [precondition_write () args]. (let {f0 = self_; f1 = bytes} = args in [%#shash] inv_refmut_H self_)
    -> precondition_write () args

predicate postcondition_once_write (self: ()) (args: tup2_refmut_H_ref_slice_u8) (result: ())

axiom postcondition_fndef:
  forall args: tup2_refmut_H_ref_slice_u8, res: () [postcondition_once_write () args res]. postcondition_once_write () args res
    -> (let {f0 = self_; f1 = bytes} = args in [%#shash'0] inv_H self_.final)

let rec write_H (self_: MutBorrow.t t_H) (bytes: Slice64.slice UInt8.t) (return (x: ())) =
  {[@stop_split] [@expl:write requires] precondition_write () { f0 = self_; f1 = bytes }}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:write ensures] postcondition_once_write () { f0 = self_;
                                                                                              f1 = bytes } result}
    (! return {result}) ]

predicate resolve_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_H

type t_Iter_u8

predicate inv_Iter_u8 (_1: t_Iter_u8)

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

let rec into_iter_ref_slice_u8 (self_: Slice64.slice UInt8.t) (return (x: t_Iter_u8)) = any
  [ return (result: t_Iter_u8) ->
  {[@stop_split] [@expl:into_iter_ref_slice_u8 ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_Iter_u8 result)
    /\ ([@stop_split] [@expl:into_iter ensures] [%#sslice] self_ = view_Iter_u8 result)}
    (! return {result}) ]

type t_Option_ref_u8 = None | Some UInt8.t

predicate invariant_refmut_Iter_u8 [@inline:trivial] (self: MutBorrow.t t_Iter_u8) =
  [%#sinvariant] inv_Iter_u8 self.current /\ inv_Iter_u8 self.final

meta "rewrite_def" predicate invariant_refmut_Iter_u8

predicate inv_refmut_Iter_u8 [@inline:trivial] (_1: MutBorrow.t t_Iter_u8) = invariant_refmut_Iter_u8 _1

meta "rewrite_def" predicate inv_refmut_Iter_u8

function index_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: int) : UInt8.t =
  [%#sslice'10] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_u8

function to_ref_seq_slice_u8 (self: Slice64.slice UInt8.t) : Seq.seq UInt8.t

axiom to_ref_seq_slice_u8_spec: forall self: Slice64.slice UInt8.t. [%#sslice'8] Seq.length (to_ref_seq_slice_u8 self)
    = Seq.length (Slice64.view self)

axiom to_ref_seq_slice_u8_spec'0: forall self: Slice64.slice UInt8.t. [%#sslice'9] forall i: int. 0 <= i
