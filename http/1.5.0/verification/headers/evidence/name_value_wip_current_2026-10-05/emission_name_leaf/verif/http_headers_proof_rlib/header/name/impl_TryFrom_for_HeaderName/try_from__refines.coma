predicate inv_ByteStr (_1: t_ByteStr)

axiom inv_axiom: forall x: t_ByteStr [inv_ByteStr x]. inv_ByteStr x -> invariant_ByteStr x

predicate inv_Custom (_1: t_Custom)

axiom inv_axiom'0 [@rewrite]: forall x: t_Custom [inv_Custom x]. inv_Custom x = inv_ByteStr x.f0

predicate inv_Repr_Custom (_1: t_Repr_Custom)

