predicate inv_Result_HeaderName_InvalidHeaderName (_1: t_Result_HeaderName_InvalidHeaderName)

axiom inv_axiom'3 [@rewrite]:
  forall x: t_Result_HeaderName_InvalidHeaderName [inv_Result_HeaderName_InvalidHeaderName x]. inv_Result_HeaderName_InvalidHeaderName x
