use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Char
use map.Map
use int.ComputerDivision
use int.Int

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_Bytes (_1: t_Bytes)

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

predicate invariant_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) = [%#sinvariant] inv_HeaderValue self

meta "rewrite_def" predicate invariant_ref_HeaderValue

predicate inv_ref_HeaderValue [@inline:trivial] (_1: t_HeaderValue) = invariant_ref_HeaderValue _1

meta "rewrite_def" predicate inv_ref_HeaderValue

type t_String

predicate inv_String (_1: t_String)

predicate invariant_ref_String [@inline:trivial] (self: t_String) = [%#sinvariant] inv_String self

meta "rewrite_def" predicate invariant_ref_String

predicate inv_ref_String [@inline:trivial] (_1: t_String) = invariant_ref_String _1

meta "rewrite_def" predicate inv_ref_String

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'1] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'0] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

predicate eq_model_Seq_u8 (self: Seq.seq UInt8.t) (rhs: Seq.seq Char.t) = [%#spartial_eq] to_bytes rhs = self

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 49 4 49 33] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'3] bytes_seq self.inner

function deep_model_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 59 4 59 44] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'2] view_HeaderValue self

function deep_model_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) : Seq.seq UInt8.t =
  [%#smodel] deep_model_HeaderValue self

meta "rewrite_def" function deep_model_ref_HeaderValue

function view_String (self: t_String) : Seq.seq Char.t

function deep_model_String (self: t_String) : Seq.seq Char.t = [%#sstring'2] view_String self

function deep_model_ref_String [@inline:trivial] (self: t_String) : Seq.seq Char.t = [%#smodel] deep_model_String self

meta "rewrite_def" function deep_model_ref_String

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_HeaderValue. forall rhs: t_String. ([%#scmp] inv_ref_HeaderValue self_)
        /\ ([%#scmp'0] inv_ref_String rhs)
      -> ([%#svalue] inv_ref_HeaderValue self_)
      /\ ([%#svalue'0] inv_ref_String rhs)
      /\ (forall result: bool. ([%#svalue'1] result
          = eq_model_Seq_u8 (deep_model_ref_HeaderValue self_) (deep_model_ref_String rhs))
        -> ([%#scmp'1] result = eq_model_Seq_u8 (deep_model_ref_HeaderValue self_) (deep_model_ref_String rhs)))
