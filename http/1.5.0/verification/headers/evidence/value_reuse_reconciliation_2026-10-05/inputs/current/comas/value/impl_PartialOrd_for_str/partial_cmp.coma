use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.prelude.Char
use seq.Seq
use map.Map
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'2] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'1] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

let rec as_bytes (self_: string) (return (x: Slice64.slice UInt8.t)) = any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_bytes ensures] [%#sstring] Slice64.view result
    = to_bytes (view_str self_)}
    (! return {result}) ]

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_Bytes (_1: t_Bytes)

predicate invariant_ref_Bytes [@inline:trivial] (self: t_Bytes) = [%#sinvariant] inv_Bytes self

meta "rewrite_def" predicate invariant_ref_Bytes

predicate inv_ref_Bytes [@inline:trivial] (_1: t_Bytes) = invariant_ref_Bytes _1

meta "rewrite_def" predicate inv_ref_Bytes

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

let rec deref_Bytes (self_: t_Bytes) (return (x: Slice64.slice UInt8.t)) =
  {[@stop_split] [@expl:deref 'self_' type invariant] [%#sbytes] inv_ref_Bytes self_}
  any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:deref ensures] [%#sbytes'0] Slice64.view result
    = bytes_seq self_}
    (! return {result}) ]

type t_Ordering = Less | Equal | Greater

function cmp_log_Int (self: int) (o: int) : t_Ordering = [%#sord] if self < o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_Int (x: int) (y: int) : ()

axiom eq_cmp_Int_spec: forall x: int, y: int. [%#sord'13] (x = y) = (cmp_log_Int x y = Equal)

function antisym2_Int (x: int) (y: int) : ()

axiom antisym2_Int_spec: forall x: int, y: int. ([%#sord'11] cmp_log_Int x y = Greater)
    -> ([%#sord'12] cmp_log_Int y x = Less)

function antisym1_Int (x: int) (y: int) : ()

axiom antisym1_Int_spec: forall x: int, y: int. ([%#sord'9] cmp_log_Int x y = Less)
    -> ([%#sord'10] cmp_log_Int y x = Greater)

function trans_Int (x: int) (y: int) (z: int) (o: t_Ordering) : ()

axiom trans_Int_spec: forall x: int, y: int, z: int, o: t_Ordering. ([%#sord'6] cmp_log_Int x y = o)
    -> ([%#sord'7] cmp_log_Int y z = o) -> ([%#sord'8] cmp_log_Int x z = o)

function refl_Int (x: int) : ()

axiom refl_Int_spec: forall x: int. [%#sord'5] cmp_log_Int x x = Equal

function cmp_gt_log_Int (x: int) (y: int) : ()

axiom cmp_gt_log_Int_spec: forall x: int, y: int. [%#sord'4] (x > y) = (cmp_log_Int x y = Greater)

function cmp_ge_log_Int (x: int) (y: int) : ()

axiom cmp_ge_log_Int_spec: forall x: int, y: int. [%#sord'3] (x >= y) = (cmp_log_Int x y <> Less)

function cmp_lt_log_Int (x: int) (y: int) : ()

axiom cmp_lt_log_Int_spec: forall x: int, y: int. [%#sord'2] (x < y) = (cmp_log_Int x y = Less)

function cmp_le_log_Int (x: int) (y: int) : ()

axiom cmp_le_log_Int_spec: forall x: int, y: int. [%#sord'1] (x <= y) = (cmp_log_Int x y <> Greater)

function tail_Int (self: Seq.seq int) : Seq.seq int = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_Int (left: Seq.seq int) (right: Seq.seq int) : t_Ordering

axiom seq_cmp_Int_def: forall left: Seq.seq int, right: Seq.seq int. seq_cmp_Int left right
    = ([%#sseq_ord'0] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_Int (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_Int (tail_Int left) (tail_Int right)
          end
    
    )

function cmp_log_u8 (self: UInt8.t) (o: UInt8.t) : t_Ordering = [%#sord'0] if UInt8.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom eq_cmp_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'26] (x = y) = (cmp_log_u8 x y = Equal)

function antisym2_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym2_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'24] cmp_log_u8 x y = Greater)
    -> ([%#sord'25] cmp_log_u8 y x = Less)

function antisym1_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym1_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'22] cmp_log_u8 x y = Less)
    -> ([%#sord'23] cmp_log_u8 y x = Greater)

function trans_u8 (x: UInt8.t) (y: UInt8.t) (z: UInt8.t) (o: t_Ordering) : ()

axiom trans_u8_spec: forall x: UInt8.t, y: UInt8.t, z: UInt8.t, o: t_Ordering. ([%#sord'19] cmp_log_u8 x y = o)
    -> ([%#sord'20] cmp_log_u8 y z = o) -> ([%#sord'21] cmp_log_u8 x z = o)

function refl_u8 (x: UInt8.t) : ()

axiom refl_u8_spec: forall x: UInt8.t. [%#sord'18] cmp_log_u8 x x = Equal

function cmp_gt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_gt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'17] UInt8.gt x y = (cmp_log_u8 x y = Greater)

function cmp_ge_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_ge_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'16] UInt8.ge x y = (cmp_log_u8 x y <> Less)

function cmp_lt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_lt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'15] UInt8.lt x y = (cmp_log_u8 x y = Less)

function cmp_le_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_le_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'14] UInt8.le x y = (cmp_log_u8 x y <> Greater)

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_u8 (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) : t_Ordering

axiom seq_cmp_u8_def: forall left: Seq.seq UInt8.t, right: Seq.seq UInt8.t. seq_cmp_u8 left right
    = ([%#sseq_ord'0] if Seq.length left = 0 then
      if Seq.length right = 0 then Equal else Less
    else
      if Seq.length right = 0 then
        Greater
      else
        match cmp_log_u8 (Seq.get left 0) (Seq.get right 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_u8 (tail_u8 left) (tail_u8 right)
          end
    
    )

predicate seq_cmp_u8_int_pair_transport_preserved (left_bytes: Seq.seq UInt8.t) (left_integers: Seq.seq int) (right_bytes: Seq.seq UInt8.t) (right_integers: Seq.seq int)

axiom seq_cmp_u8_int_pair_transport_preserved_spec:
  forall left_bytes: Seq.seq UInt8.t, left_integers: Seq.seq int, right_bytes: Seq.seq UInt8.t, right_integers: Seq.seq int. ([%#spartial_ord] Seq.length left_bytes
      = Seq.length left_integers)
    -> ([%#spartial_ord'0] Seq.length right_bytes = Seq.length right_integers)
    -> ([%#spartial_ord'1] forall i: int. 0 <= i /\ i < Seq.length left_bytes
        -> UInt8.t'int (Seq.get left_bytes i) = Seq.get left_integers i)
