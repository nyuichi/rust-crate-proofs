use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Char
use map.Map
use int.ComputerDivision
use int.Int

type t_String

predicate inv_String (_1: t_String)

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

type t_InvalidHeaderValue = { _priv: () }

type t_Result_HeaderValue_InvalidHeaderValue = Ok t_HeaderValue | Err t_InvalidHeaderValue

predicate inv_Bytes (_1: t_Bytes)

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

predicate inv_Result_HeaderValue_InvalidHeaderValue (_1: t_Result_HeaderValue_InvalidHeaderValue)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Result_HeaderValue_InvalidHeaderValue [inv_Result_HeaderValue_InvalidHeaderValue x]. inv_Result_HeaderValue_InvalidHeaderValue x
    = match x with
      | Ok f0 -> inv_HeaderValue f0
      | Err f0 -> true
      end

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 51 4 51 33] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'2] bytes_seq self.inner

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'1] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'0] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_String (self: t_String) : Seq.seq Char.t

predicate valid_value_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 79 0 79 48] (bytes: Seq.seq UInt8.t) =
  [%#svalue'3] forall i: int. 0 <= i /\ i < Seq.length bytes
    -> UInt8.t'int (Seq.get bytes i) >= 32 /\ UInt8.t'int (Seq.get bytes i) <> 127 \/ UInt8.t'int (Seq.get bytes i) = 9

predicate sensitive_model [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 71 4 71 41] (self: t_HeaderValue) =
  [%#svalue'4] self.is_sensitive

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall value: t_String. ([%#sconvert] inv_String value)
    -> ([%#svalue] inv_String value)
    /\ (forall result: t_Result_HeaderValue_InvalidHeaderValue. ([%#svalue'0] inv_Result_HeaderValue_InvalidHeaderValue result)
        /\ ([%#svalue'1] match result with
          | Ok value'0 -> view_HeaderValue value'0 = to_bytes (view_String value)
          /\ valid_value_bytes (to_bytes (view_String value)) /\ not sensitive_model value'0
          | Err _ -> not valid_value_bytes (to_bytes (view_String value))
          end) -> inv_Result_HeaderValue_InvalidHeaderValue result)
