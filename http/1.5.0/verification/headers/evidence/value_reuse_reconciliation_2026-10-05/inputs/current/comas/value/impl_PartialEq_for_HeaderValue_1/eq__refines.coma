meta "rewrite_def" function deep_model_ref_HeaderValue

function deep_model_u8 [@inline:trivial] (self: UInt8.t) : int = [%#snum] UInt8.t'int self

meta "rewrite_def" function deep_model_u8

function index_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: int) : UInt8.t =
  [%#sslice'1] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_u8

function deep_model_slice_u8 (self: Slice64.slice UInt8.t) : Seq.seq int

axiom deep_model_slice_u8_spec: forall self: Slice64.slice UInt8.t. [%#sslice] Seq.length (Slice64.view self)
    = Seq.length (deep_model_slice_u8 self)

axiom deep_model_slice_u8_spec'0: forall self: Slice64.slice UInt8.t. [%#sslice'0] forall i: int. 0 <= i
        /\ i < Seq.length (deep_model_slice_u8 self)
      -> Seq.get (deep_model_slice_u8 self) i = deep_model_u8 (index_slice_u8 self i)

function deep_model_ref_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) : Seq.seq int =
  [%#smodel] deep_model_slice_u8 self

meta "rewrite_def" function deep_model_ref_slice_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_HeaderValue. forall rhs: Slice64.slice UInt8.t. ([%#scmp] inv_ref_HeaderValue self_)
      -> ([%#svalue] inv_ref_HeaderValue self_)
      /\ (forall result: bool. ([%#svalue'0] result
