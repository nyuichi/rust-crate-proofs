use creusot.int.UInt8
use seq.Seq
use creusot.slice.Slice64
use int.Int

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_Bytes (_1: t_Bytes)

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

predicate invariant_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) = [%#sinvariant] inv_HeaderValue self

meta "rewrite_def" predicate invariant_ref_HeaderValue

predicate inv_ref_HeaderValue [@inline:trivial] (_1: t_HeaderValue) = invariant_ref_HeaderValue _1

meta "rewrite_def" predicate inv_ref_HeaderValue

predicate eq_model_Seq_u8 (self: Seq.seq UInt8.t) (rhs: Seq.seq int) =
  [%#spartial_eq] Seq.length self = Seq.length rhs
  /\ (forall i: int. 0 <= i /\ i < Seq.length self -> UInt8.t'int (Seq.get self i) = Seq.get rhs i)

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 51 4 51 33] (self: t_HeaderValue) : Seq.seq UInt8.t
