let rec bytes_equal_accept (name_bytes: Slice64.slice UInt8.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:bytes_equal_accept ensures] [%#sname'1179] result
    = (Slice64.view name_bytes
    = Seq.create 6 [|(97: UInt8.t);(99: UInt8.t);(99: UInt8.t);(101: UInt8.t);(112: UInt8.t);(116: UInt8.t)|])}
    (! return {result}) ]

