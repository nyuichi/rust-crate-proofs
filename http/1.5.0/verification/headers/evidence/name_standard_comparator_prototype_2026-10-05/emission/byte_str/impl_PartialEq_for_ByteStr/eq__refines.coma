use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Char
use map.Map
use int.ComputerDivision
use int.Int

type t_Bytes

type t_ByteStr = { bytes: t_Bytes }

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'2] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'1] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

predicate valid_utf8 (bytes'0: Seq.seq UInt8.t) =
  [%#sstring] exists characters: Seq.seq Char.t. to_bytes characters = bytes'0

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/byte_str.rs" 41 4 41 33] (self: t_ByteStr) : Seq.seq UInt8.t
 = [%#sbyte_str'2] bytes_seq self.bytes

predicate invariant_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/byte_str.rs" 48 4 48 30] (self: t_ByteStr) =
  [%#sbyte_str'4] valid_utf8 (view_ByteStr self)

predicate inv_Bytes (_1: t_Bytes)

predicate inv_ByteStr (_1: t_ByteStr)

axiom inv_axiom [@rewrite]: forall x: t_ByteStr [inv_ByteStr x]. inv_ByteStr x
    = (invariant_ByteStr x /\ inv_Bytes x.bytes)

predicate invariant_ref_ByteStr [@inline:trivial] (self: t_ByteStr) = [%#sinvariant] inv_ByteStr self

meta "rewrite_def" predicate invariant_ref_ByteStr

predicate inv_ref_ByteStr [@inline:trivial] (_1: t_ByteStr) = invariant_ref_ByteStr _1

meta "rewrite_def" predicate inv_ref_ByteStr

predicate eq_model_Seq_u8 (self: Seq.seq UInt8.t) (rhs: Seq.seq UInt8.t) = [%#spartial_eq] self = rhs

function deep_model_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/byte_str.rs" 57 4 57 44] (self: t_ByteStr) : Seq.seq UInt8.t
 = [%#sbyte_str'3] view_ByteStr self

function deep_model_ref_ByteStr [@inline:trivial] (self: t_ByteStr) : Seq.seq UInt8.t =
  [%#smodel] deep_model_ByteStr self

meta "rewrite_def" function deep_model_ref_ByteStr

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_ByteStr. forall rhs: t_ByteStr. ([%#scmp] inv_ref_ByteStr self_)
        /\ ([%#scmp'0] inv_ref_ByteStr rhs)
      -> ([%#sbyte_str] inv_ref_ByteStr self_)
      /\ ([%#sbyte_str'0] inv_ref_ByteStr rhs)
      /\ (forall result: bool. ([%#sbyte_str'1] result = (view_ByteStr self_ = view_ByteStr rhs))
        -> ([%#scmp'1] result = eq_model_Seq_u8 (deep_model_ref_ByteStr self_) (deep_model_ref_ByteStr rhs)))
