(* <header::name::MaybeLower<'a> as std::hash::Hash> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 93 20 93 44
let%span sname = "/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/name.rs" 2555 30 2555 36
let%span shash = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/hash.rs" 65 42 65 47
let%span shash'0 = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/hash.rs" 64 26 64 37

use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8

type t_H

predicate inv_H (_1: t_H)

predicate invariant_refmut_H [@inline:trivial] (self: MutBorrow.t t_H) =
  [%#sinvariant] inv_H self.current /\ inv_H self.final

meta "rewrite_def" predicate invariant_refmut_H

predicate inv_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = invariant_refmut_H _1

meta "rewrite_def" predicate inv_refmut_H

type t_MaybeLower = { buf: Slice64.slice UInt8.t; lower: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_MaybeLower. forall state: MutBorrow.t t_H. ([%#shash] inv_refmut_H state)
      -> ([%#sname] inv_refmut_H state) /\ (forall result: (). [%#shash'0] inv_H state.final)
