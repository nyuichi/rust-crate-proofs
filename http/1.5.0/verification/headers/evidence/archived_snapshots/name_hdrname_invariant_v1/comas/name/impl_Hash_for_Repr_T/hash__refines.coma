type t_T

type t_Repr_T = Standard t_StandardHeader | Custom t_T

predicate inv_T (_1: t_T)

predicate inv_Repr_T (_1: t_Repr_T)

axiom inv_axiom [@rewrite]: forall x: t_Repr_T [inv_Repr_T x]. inv_Repr_T x
    = match x with
      | Standard f0 -> true
      | Custom f0 -> inv_T f0
      end

predicate invariant_ref_Repr_T [@inline:trivial] (self: t_Repr_T) = [%#sinvariant] inv_Repr_T self

meta "rewrite_def" predicate invariant_ref_Repr_T

predicate inv_ref_Repr_T [@inline:trivial] (_1: t_Repr_T) = invariant_ref_Repr_T _1

meta "rewrite_def" predicate inv_ref_Repr_T

type t_H

predicate inv_H (_1: t_H)

predicate invariant_refmut_H [@inline:trivial] (self: MutBorrow.t t_H) =
  [%#sinvariant'0] inv_H self.current /\ inv_H self.final

meta "rewrite_def" predicate invariant_refmut_H

predicate inv_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = invariant_refmut_H _1

meta "rewrite_def" predicate inv_refmut_H

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Repr_T. forall state: MutBorrow.t t_H. ([%#shash] inv_ref_Repr_T self_)
        /\ ([%#shash'0] inv_refmut_H state)
      -> ([%#sname] inv_ref_Repr_T self_)
      /\ ([%#sname'0] inv_refmut_H state) /\ (forall result: (). [%#shash'1] inv_H state.final)
