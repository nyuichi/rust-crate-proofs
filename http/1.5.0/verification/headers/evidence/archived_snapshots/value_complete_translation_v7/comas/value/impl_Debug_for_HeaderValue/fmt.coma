use creusot.prelude.MutBorrow
use seq.Seq
use creusot.prelude.Char
use creusot.int.UInt8
use map.Map
use int.ComputerDivision
use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'4] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'3] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'3] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'2] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function deep_model_Formatter (self: t_Formatter) : Seq.seq int

function deep_model_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) : Seq.seq int =
  [%#smodel] deep_model_Formatter self.current

meta "rewrite_def" function deep_model_refmut_Formatter

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'1] forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

let rec write_str (self_: MutBorrow.t t_Formatter) (data: string) (return (x: t_Result_unit_Error)) =
  {[@stop_split] [@expl:write_str 'self_' type invariant] [%#sfmt] inv_refmut_Formatter self_}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_str ensures] [%#sfmt'0] exists i: int. 0 <= i
      /\ i <= Seq.length (to_bytes (view_str data))
      /\ deep_model_Formatter self_.final
        = Seq.(++) (deep_model_refmut_Formatter self_) (map_u8 (Seq.([..]) (to_bytes (view_str data)) 0 i) (fun (byte: UInt8.t) -> UInt8.t'int byte))
      /\ match result with
        | Ok _ -> i = Seq.length (to_bytes (view_str data))
        | Err _ -> true
        end}
    (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

type t_Result_Infallible_Error = Ok'0 () | Err'0 ()

type t_ControlFlow_Result_Infallible_Error_unit = Continue () | Break t_Result_Infallible_Error

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Result_Infallible_Error (_1: t_Result_Infallible_Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_Infallible_Error [inv_Result_Infallible_Error x]. inv_Result_Infallible_Error x
    = match x with
      | Ok'0 f0 -> inv_Infallible f0
      | Err'0 f0 -> true
      end

predicate inv_ControlFlow_Result_Infallible_Error_unit (_1: t_ControlFlow_Result_Infallible_Error_unit)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Result_Infallible_Error_unit [inv_ControlFlow_Result_Infallible_Error_unit x]. inv_ControlFlow_Result_Infallible_Error_unit x
    = match x with
      | Continue f0 -> true
      | Break f0 -> inv_Result_Infallible_Error f0
      end

let rec branch_Result_unit_Error (self_: t_Result_unit_Error) (return (x: t_ControlFlow_Result_Infallible_Error_unit)) =
