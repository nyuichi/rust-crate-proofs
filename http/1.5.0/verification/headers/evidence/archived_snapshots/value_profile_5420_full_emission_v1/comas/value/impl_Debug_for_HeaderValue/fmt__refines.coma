      /\ ([%#svalue'0] inv_refmut_Formatter formatter)
      /\ (forall result: t_Result_unit_Error. [%#sfmt'1] formatter_extends (deep_model_refmut_Formatter formatter) (deep_model_Formatter formatter.final))
