type t_Option_Ordering = None | Some t_Ordering

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_HeaderValue. forall rhs: string. ([%#scmp] inv_ref_HeaderValue self_)
      -> ([%#svalue] inv_ref_HeaderValue self_)
      /\ (forall result: t_Option_Ordering. ([%#svalue'0] result
          = Some (partial_cmp_model_Seq_u8 (deep_model_ref_HeaderValue self_) (deep_model_ref_str rhs)))
        -> ([%#scmp'0] result = Some (partial_cmp_model_Seq_u8 (deep_model_HeaderValue self_) (deep_model_str rhs))))
