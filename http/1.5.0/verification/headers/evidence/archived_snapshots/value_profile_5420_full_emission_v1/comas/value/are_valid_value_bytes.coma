predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

let rec len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate valid_value_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 77 0 77 48] (bytes: Seq.seq UInt8.t) =
  [%#svalue'10] forall i: int. 0 <= i /\ i < Seq.length bytes
    -> UInt8.t'int (Seq.get bytes i) >= 32 /\ UInt8.t'int (Seq.get bytes i) <> 127 \/ UInt8.t'int (Seq.get bytes i) = 9

let rec is_valid (b: UInt8.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_valid ensures] [%#svalue_validation] result
    = (UInt8.t'int b >= 32 /\ UInt8.t'int b <> 127 \/ UInt8.t'int b = 9)}
    (! return {result}) ]

