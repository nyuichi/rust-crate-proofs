function model [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/name.rs" 253 12 253 49] (self: t_StandardHeader) : t_StandardHeaderModel
 = [%#sname'4] match self with
    | Accept -> Accept'0
    | AcceptCharset -> AcceptCharset'0
    | AcceptEncoding -> AcceptEncoding'0
    | AcceptLanguage -> AcceptLanguage'0
    | AcceptRanges -> AcceptRanges'0
    | AccessControlAllowCredentials -> AccessControlAllowCredentials'0
    | AccessControlAllowHeaders -> AccessControlAllowHeaders'0
    | AccessControlAllowMethods -> AccessControlAllowMethods'0
