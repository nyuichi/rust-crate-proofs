  | StrictTransportSecurity -> StrictTransportSecurityqt0
  | Te -> Teqt0
  | Trailer -> Trailerqt0
  | TransferEncoding -> TransferEncodingqt0
  | UserAgent -> UserAgentqt0
  | Upgrade -> Upgradeqt0
  | UpgradeInsecureRequests -> UpgradeInsecureRequestsqt0
  | Vary -> Varyqt0
  | Via -> Viaqt0
  | Warning -> Warningqt0
  | WwwAuthenticate -> WwwAuthenticateqt0
  | XContentTypeOptions -> XContentTypeOptionsqt0
  | XDnsPrefetchControl -> XDnsPrefetchControlqt0
  | XFrameOptions -> XFrameOptionsqt0
  | XXssProtection -> XXssProtectionqt0
  end

function byte_viewqt0 (self:t_StandardHeader) : seq t17 =
