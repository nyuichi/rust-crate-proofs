  | AccessControlExposeHeaders -> AccessControlExposeHeadersqt0
  | AccessControlMaxAge -> AccessControlMaxAgeqt0
  | AccessControlRequestHeaders -> AccessControlRequestHeadersqt0
  | AccessControlRequestMethod -> AccessControlRequestMethodqt0
  | Age -> Ageqt0
  | Allow -> Allowqt0
  | AltSvc -> AltSvcqt0
  | Authorization -> Authorizationqt0
  | CacheControl -> CacheControlqt0
  | CacheStatus -> CacheStatusqt0
  | CdnCacheControl -> CdnCacheControlqt0
  | Connection -> Connectionqt0
  | ContentDisposition -> ContentDispositionqt0
  | ContentEncoding -> ContentEncodingqt0
  | ContentLanguage -> ContentLanguageqt0
  | ContentLength -> ContentLengthqt0
  | ContentLocation -> ContentLocationqt0
  | ContentRange -> ContentRangeqt0
  | ContentSecurityPolicy -> ContentSecurityPolicyqt0
  | ContentSecurityPolicyReportOnly -> ContentSecurityPolicyReportOnlyqt0
  | ContentType -> ContentTypeqt0
  | Cookie -> Cookieqt0
  | Dnt -> Dntqt0
  | Date -> Dateqt0
  | Etag -> Etagqt0
  | Expect -> Expectqt0
  | Expires -> Expiresqt0
  | Forwarded -> Forwardedqt0
  | From -> Fromqt0
  | Host -> Hostqt0
  | IfMatch -> IfMatchqt0
  | IfModifiedSince -> IfModifiedSinceqt0
  | IfNoneMatch -> IfNoneMatchqt0
  | IfRange -> IfRangeqt0
  | IfUnmodifiedSince -> IfUnmodifiedSinceqt0
  | LastModified -> LastModifiedqt0
  | Link -> Linkqt0
  | Location -> Locationqt0
  | MaxForwards -> MaxForwardsqt0
  | Origin -> Originqt0
  | Pragma -> Pragmaqt0
  | ProxyAuthenticate -> ProxyAuthenticateqt0
  | ProxyAuthorization -> ProxyAuthorizationqt0
  | PublicKeyPins -> PublicKeyPinsqt0
  | PublicKeyPinsReportOnly -> PublicKeyPinsReportOnlyqt0
  | Range -> Rangeqt0
  | Referer -> Refererqt0
  | ReferrerPolicy -> ReferrerPolicyqt0
  | Refresh -> Refreshqt0
  | RetryAfter -> RetryAfterqt0
  | SecWebSocketAccept -> SecWebSocketAcceptqt0
  | SecWebSocketExtensions -> SecWebSocketExtensionsqt0
  | SecWebSocketKey -> SecWebSocketKeyqt0
