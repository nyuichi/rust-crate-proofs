(* meta select_lsinst "all" *)

constant name_bytes [@introduced] : slice t18

constant us_arr_temp [@introduced] : slice t18

axiom Assert [@introduced] :
  [@hyp_name:Assert]
  get (us_arr_temp.elts) 0 = (101:t18) /\
  get (us_arr_temp.elts) 1 = (120:t18) /\
  get (us_arr_temp.elts) 2 = (112:t18) /\
  get (us_arr_temp.elts) 3 = (101:t18) /\
  get (us_arr_temp.elts) 4 = (99:t18) /\
  get (us_arr_temp.elts) 5 = (116:t18) /\ length (us_arr_temp.elts) = 6

constant result [@introduced] : bool

axiom Assert1 [@introduced] :
  [@expl:bytes_equal ensures] [@hyp_name:Assert]
  result = True <-> view name_bytes = view us_arr_temp

(* meta syntax_type type int, "int", 0 *)

(* meta syntax_type type real, "real", 0 *)

(* meta syntax_logic predicate infix_eq, "(%1 = %2)", 0 *)

(* meta encoding:ignore_polymorphism_ls predicate infix_eq *)

goal vc_bytes_equal_expect :
  [@hyp_name:Assert] [@expl:bytes_equal_expect ensures]
  result = True <->
  view name_bytes =
  create 6
  ([@funlit]
   fun (xqtx:int) ->
    if xqtx = 0 then (101:t18)
    else if xqtx = 1 then (120:t18)
         else if xqtx = 2 then (112:t18)
              else if xqtx = 3 then (101:t18)
                   else if xqtx = 4 then (99:t18)
                        else if xqtx = 5 then (116:t18) else (116:t18))

end
