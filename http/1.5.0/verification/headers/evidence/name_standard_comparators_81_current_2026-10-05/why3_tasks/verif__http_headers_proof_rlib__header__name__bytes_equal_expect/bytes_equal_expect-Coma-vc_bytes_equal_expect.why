(* use int.Int *)

type seq 'a

(* meta infinite_type type seq *)

function length (seq 'a) : int

axiom length_nonnegative [@useraxiom] :
  forall s:seq 'a. infix_lseq 0 (length s)

(* meta remove_unused:dependency prop length_nonnegative, function length *)

function get (seq 'a) int : 'a

function mixfix_lbrb (s:seq 'a) (i:int) : 'a = get s i

predicate infix_eqeq (seq 'a) (seq 'a)

axiom infix_eqeqqtspecqt0 [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   infix_eqeq s1 s2 <->
   ([@asym_split] length s1 = length s2) &&
   (forall i:int.
     infix_lseq 0 i /\ infix_ls i (length s1) ->
     mixfix_lbrb s1 i = mixfix_lbrb s2 i)

axiom infix_eqeqqtspec [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures] infix_eqeq s1 s2 -> s1 = s2

(* meta remove_unused:dependency prop infix_eqeqqtspecqt0,
  predicate infix_eqeq *)

(* meta remove_unused:dependency prop infix_eqeqqtspec,
  predicate infix_eqeq *)

(* meta extensionality predicate infix_eqeq *)

type (->) 'a 'b

function infix_at ('a -> 'b) 'a : 'b

(* use why3.HighOrd.HighOrd *)

function create int (int -> 'a) : seq 'a

axiom createqtspecqt0 [@W:non_conservative_extension:N] :
  forall len:int, f:int -> 'a.
   ([@hyp_name:Requires] infix_lseq 0 len) ->
   ([@hyp_name:Ensures] length (create len f) = len)

axiom createqtspec [@W:non_conservative_extension:N] :
  forall len:int, f:int -> 'a.
   ([@hyp_name:Requires] infix_lseq 0 len) ->
   ([@hyp_name:Ensures]
    forall i:int.
     infix_lseq 0 i /\ infix_ls i len ->
     mixfix_lbrb (create len f) i = infix_at f i)

(* meta remove_unused:dependency prop createqtspecqt0, function create *)

(* meta remove_unused:dependency prop createqtspec, function create *)

constant empty : seq 'a

axiom emptyqtdef [@W:non_conservative_extension:N] :
  [@hyp_name:Ensures] length (empty: seq 'a) = 0

(* meta remove_unused:dependency prop emptyqtdef, constant empty *)

function set (seq 'a) int 'a : seq 'a

axiom setqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   set s i v =
   create (length s) (fun (j:int) -> if j = i then v else mixfix_lbrb s j)

axiom setqtspecqt1 [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   ([@hyp_name:Ensures] length (set s i v) = length s)

axiom setqtspecqt0 [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   ([@hyp_name:Ensures] mixfix_lbrb (set s i v) i = v)

axiom setqtspec [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   ([@hyp_name:Ensures]
    forall j:int.
     (infix_lseq 0 j /\ infix_ls j (length s)) /\ not j = i ->
     mixfix_lbrb (set s i v) j = mixfix_lbrb s j)

(* meta remove_unused:dependency prop setqtdef, function set *)

(* meta remove_unused:dependency prop setqtspecqt1, function set *)

(* meta remove_unused:dependency prop setqtspecqt0, function set *)

(* meta remove_unused:dependency prop setqtspec, function set *)

function mixfix_lblsmnrb (seq 'a) int 'a : seq 'a

axiom mixfix_lblsmnrbqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   mixfix_lblsmnrb s i v = set s i v

(* meta remove_unused:dependency prop mixfix_lblsmnrbqtdef,
  function mixfix_lblsmnrb *)

function singleton (v:'a) : seq 'a =
  create 1 (fun (us [@__dummy__]:int) -> v)

axiom singletonqtspecqt0 [@W:non_conservative_extension:N] :
  forall v:'a. [@hyp_name:Ensures] length (singleton v) = 1

axiom singletonqtspec [@W:non_conservative_extension:N] :
  forall v:'a. [@hyp_name:Ensures] mixfix_lbrb (singleton v) 0 = v

(* meta remove_unused:dependency prop singletonqtspecqt0,
  function singleton *)

(* meta remove_unused:dependency prop singletonqtspec, function singleton *)

function cons (x:'a) (s:seq 'a) : seq 'a =
  create (infix_pl 1 (length s))
  (fun (i:int) -> if i = 0 then x else mixfix_lbrb s (infix_mn i 1))

axiom consqtspecqt1 [@W:non_conservative_extension:N] :
  forall x:'a, s:seq 'a.
   [@hyp_name:Ensures] length (cons x s) = infix_pl 1 (length s)

axiom consqtspecqt0 [@W:non_conservative_extension:N] :
  forall x:'a, s:seq 'a. [@hyp_name:Ensures] mixfix_lbrb (cons x s) 0 = x

axiom consqtspec [@W:non_conservative_extension:N] :
  forall x:'a, s:seq 'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_ls 0 i /\ infix_lseq i (length s) ->
    mixfix_lbrb (cons x s) i = mixfix_lbrb s (infix_mn i 1)

(* meta remove_unused:dependency prop consqtspecqt1, function cons *)

(* meta remove_unused:dependency prop consqtspecqt0, function cons *)

(* meta remove_unused:dependency prop consqtspec, function cons *)

function snoc (s:seq 'a) (x:'a) : seq 'a =
  create (infix_pl 1 (length s))
  (fun (i:int) -> if i = length s then x else mixfix_lbrb s i)

axiom snocqtspecqt1 [@W:non_conservative_extension:N] :
  forall s:seq 'a, x:'a.
   [@hyp_name:Ensures] length (snoc s x) = infix_pl 1 (length s)

axiom snocqtspecqt0 [@W:non_conservative_extension:N] :
  forall s:seq 'a, x:'a.
   [@hyp_name:Ensures] mixfix_lbrb (snoc s x) (length s) = x

axiom snocqtspec [@W:non_conservative_extension:N] :
  forall s:seq 'a, x:'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_lseq 0 i /\ infix_ls i (length s) ->
    mixfix_lbrb (snoc s x) i = mixfix_lbrb s i

(* meta remove_unused:dependency prop snocqtspecqt1, function snoc *)

(* meta remove_unused:dependency prop snocqtspecqt0, function snoc *)

(* meta remove_unused:dependency prop snocqtspec, function snoc *)

function mixfix_lbdtdtrb (seq 'a) int int : seq 'a

axiom mixfix_lbdtdtrbqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   mixfix_lbdtdtrb s i j =
   create (infix_mn j i) (fun (k:int) -> mixfix_lbrb s (infix_pl i k))

axiom mixfix_lbdtdtrbqtspecqt0 [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   ([@hyp_name:Ensures] length (mixfix_lbdtdtrb s i j) = infix_mn j i)

axiom mixfix_lbdtdtrbqtspec [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   ([@hyp_name:Ensures]
    forall k:int.
     infix_lseq 0 k /\ infix_ls k (infix_mn j i) ->
     mixfix_lbrb (mixfix_lbdtdtrb s i j) k = mixfix_lbrb s (infix_pl i k))

(* meta remove_unused:dependency prop mixfix_lbdtdtrbqtdef,
  function mixfix_lbdtdtrb *)

(* meta remove_unused:dependency prop mixfix_lbdtdtrbqtspecqt0,
  function mixfix_lbdtdtrb *)

(* meta remove_unused:dependency prop mixfix_lbdtdtrbqtspec,
  function mixfix_lbdtdtrb *)

function mixfix_lb_dtdtrb (seq 'a) int : seq 'a

axiom mixfix_lb_dtdtrbqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_lseq i (length s)) ->
   mixfix_lb_dtdtrb s i = mixfix_lbdtdtrb s i (length s)

(* meta remove_unused:dependency prop mixfix_lb_dtdtrbqtdef,
  function mixfix_lb_dtdtrb *)

function mixfix_lbdtdt_rb (seq 'a) int : seq 'a

axiom mixfix_lbdtdt_rbqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, j:int.
   ([@hyp_name:Requires] infix_lseq 0 j /\ infix_lseq j (length s)) ->
   mixfix_lbdtdt_rb s j = mixfix_lbdtdtrb s 0 j

(* meta remove_unused:dependency prop mixfix_lbdtdt_rbqtdef,
  function mixfix_lbdtdt_rb *)

function infix_plpl (s1:seq 'a) (s2:seq 'a) : seq 'a =
  let l = length s1 in
  create (infix_pl l (length s2))
  (fun (i:int) ->
    if infix_ls i l then mixfix_lbrb s1 i else mixfix_lbrb s2 (infix_mn i l))

axiom infix_plplqtspecqt1 [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   length (infix_plpl s1 s2) = infix_pl (length s1) (length s2)

axiom infix_plplqtspecqt0 [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_lseq 0 i /\ infix_ls i (length s1) ->
    mixfix_lbrb (infix_plpl s1 s2) i = mixfix_lbrb s1 i

axiom infix_plplqtspec [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_lseq (length s1) i /\ infix_ls i (length (infix_plpl s1 s2)) ->
    mixfix_lbrb (infix_plpl s1 s2) i =
    mixfix_lbrb s2 (infix_mn i (length s1))

(* meta remove_unused:dependency prop infix_plplqtspecqt1,
  function infix_plpl *)

(* meta remove_unused:dependency prop infix_plplqtspecqt0,
  function infix_plpl *)

(* meta remove_unused:dependency prop infix_plplqtspec,
  function infix_plpl *)

(* use seq.Seq *)

function abs (x:int) : int = if infix_gteq x 0 then x else prefix_mn x

axiom Abs_le :
  forall x:int, y:int.
   infix_lseq (abs x) y <-> infix_lseq (prefix_mn y) x /\ infix_lseq x y

(* meta remove_unused:dependency prop Abs_le, function abs *)

axiom Abs_pos : forall x:int. infix_gteq (abs x) 0

(* meta remove_unused:dependency prop Abs_pos, function abs *)

(* use int.Abs *)

function div int int : int

function mod int int : int

axiom Div_mod [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div x y)) (mod x y)

(* meta remove_unused:dependency prop Div_mod, function div *)

(* meta remove_unused:dependency prop Div_mod, function mod *)

axiom Div_bound [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div x y) /\ infix_lseq (div x y) x

(* meta remove_unused:dependency prop Div_bound, function div *)

(* meta remove_unused:dependency prop Div_bound, function mod *)

axiom Mod_bound [@useraxiom] :
  forall x:int, y:int.
   not y = 0 ->
   infix_ls (prefix_mn (abs y)) (mod x y) /\ infix_ls (mod x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound, function div *)

(* meta remove_unused:dependency prop Mod_bound, function mod *)

axiom Div_sign_pos [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 -> infix_gteq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_pos, function div *)

(* meta remove_unused:dependency prop Div_sign_pos, function mod *)

axiom Div_sign_neg [@useraxiom] :
  forall x:int, y:int.
   infix_lseq x 0 /\ infix_gt y 0 -> infix_lseq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_neg, function div *)

(* meta remove_unused:dependency prop Div_sign_neg, function mod *)

axiom Mod_sign_pos [@useraxiom] :
  forall x:int, y:int. infix_gteq x 0 /\ not y = 0 -> infix_gteq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_pos, function div *)

(* meta remove_unused:dependency prop Mod_sign_pos, function mod *)

axiom Mod_sign_neg [@useraxiom] :
  forall x:int, y:int. infix_lseq x 0 /\ not y = 0 -> infix_lseq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_neg, function div *)

(* meta remove_unused:dependency prop Mod_sign_neg, function mod *)

axiom Rounds_toward_zero :
  forall x:int, y:int.
   not y = 0 -> infix_lseq (abs (infix_as (div x y) y)) (abs x)

(* meta remove_unused:dependency prop Rounds_toward_zero, function div *)

(* meta remove_unused:dependency prop Rounds_toward_zero, function mod *)

axiom Div_1 : forall x:int. div x 1 = x

(* meta remove_unused:dependency prop Div_1, function div *)

(* meta remove_unused:dependency prop Div_1, function mod *)

axiom Mod_1 : forall x:int. mod x 1 = 0

(* meta remove_unused:dependency prop Mod_1, function div *)

(* meta remove_unused:dependency prop Mod_1, function mod *)

axiom Div_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> div x y = 0

(* meta remove_unused:dependency prop Div_inf, function div *)

(* meta remove_unused:dependency prop Div_inf, function mod *)

axiom Mod_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> mod x y = x

(* meta remove_unused:dependency prop Mod_inf, function div *)

(* meta remove_unused:dependency prop Mod_inf, function mod *)

axiom Div_mult :
  forall x:int, y:int, z:int [div (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   div (infix_pl (infix_as x y) z) x = infix_pl y (div z x)

(* meta remove_unused:dependency prop Div_mult, function div *)

(* meta remove_unused:dependency prop Div_mult, function mod *)

axiom Mod_mult :
  forall x:int, y:int, z:int [mod (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   mod (infix_pl (infix_as x y) z) x = mod z x

(* meta remove_unused:dependency prop Mod_mult, function div *)

(* meta remove_unused:dependency prop Mod_mult, function mod *)

(* use int.ComputerDivision *)

(* use mach.int.Int1 *)

type t17 = <range 0 18446744073709551615>

function tqtint t17 : int

constant tqtmaxInt : int = 18446744073709551615

constant tqtminInt : int = 0

predicate tqteq (a:t17) (b:t17) = tqtint a = tqtint b

axiom tqtinj [@W:non_conservative_extension:N] :
  forall a:t17, b:t17. tqteq a b -> a = b

(* meta range_type type t17, function tqtint *)

(* meta model_projection function tqtint *)

(* meta remove_unused:dependency prop tqtinj, predicate tqteq *)

constant two_power_size : int = 0x10000000000000000

axiom extensionality [@useraxiom] :
  forall x:t17, y:t17 [tqtint x, tqtint y]. tqtint x = tqtint y -> x = y

predicate in_bounds [@inline:trivial] (n:int) =
  infix_lseq 0 n /\ infix_lseq n 0xFFFFFFFFFFFFFFFF

function of_int int : t17

axiom to_of_int [@useraxiom] :
  forall x:int [of_int x]. in_bounds x -> tqtint (of_int x) = x

function add t17 t17 : t17

axiom add_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [add x y].
   in_bounds (infix_pl (tqtint x) (tqtint y)) ->
   tqtint (add x y) = infix_pl (tqtint x) (tqtint y)

axiom add_wrapping [@useraxiom] :
  forall x:t17, y:t17 [add x y].
   exists k:int.
    tqtint (add x y) =
    infix_pl (infix_pl (tqtint x) (tqtint y)) (infix_as k two_power_size)

function sub t17 t17 : t17

axiom sub_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [sub x y].
   in_bounds (infix_mn (tqtint x) (tqtint y)) ->
   tqtint (sub x y) = infix_mn (tqtint x) (tqtint y)

axiom sub_wrapping [@useraxiom] :
  forall x:t17, y:t17 [sub x y].
   exists k:int.
    tqtint (sub x y) =
    infix_pl (infix_mn (tqtint x) (tqtint y)) (infix_as k two_power_size)

function mul t17 t17 : t17

axiom mul_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [mul x y].
   in_bounds (infix_as (tqtint x) (tqtint y)) ->
   tqtint (mul x y) = infix_as (tqtint x) (tqtint y)

axiom mul_wrapping [@useraxiom] :
  forall x:t17, y:t17 [mul x y].
   exists k:int.
    tqtint (mul x y) =
    infix_pl (infix_as (tqtint x) (tqtint y)) (infix_as k two_power_size)

function neg t17 : t17

axiom neg_zero [@useraxiom] :
  forall x:t17 [neg x]. tqtint x = 0 -> tqtint (neg x) = 0

axiom neg_not_zero [@useraxiom] :
  forall x:t17 [neg x].
   infix_ls 0 (tqtint x) /\ infix_lseq (tqtint x) 0xFFFFFFFFFFFFFFFF ->
   tqtint (neg x) = infix_mn two_power_size (tqtint x)

function of_bool [@inline:trivial] (b:bool) : t17 =
  if b = True then (1:t17) else (0:t17)

predicate le [@inline:trivial] (a:t17) (b:t17) =
  infix_lseq (tqtint a) (tqtint b)

predicate lt [@inline:trivial] (a:t17) (b:t17) =
  infix_ls (tqtint a) (tqtint b)

predicate ge [@inline:trivial] (a:t17) (b:t17) =
  infix_gteq (tqtint a) (tqtint b)

predicate gt [@inline:trivial] (a:t17) (b:t17) =
  infix_gt (tqtint a) (tqtint b)

function bw_and t17 t17 : t17

function bw_or t17 t17 : t17

function bw_xor t17 t17 : t17

function bw_not t17 : t17

function shl t17 t17 : t17

function shr t17 t17 : t17

function nth t17 int : bool

type tuple2 'a 'a1 =
  | Tuple2 [@builtin] 'a 'a1

(* use why3.Tuple2.Tuple21 *)

function add_with_overflow (a:t17) (b:t17) : (t17, bool) = (add a b,
  if not in_bounds (infix_pl (tqtint a) (tqtint b)) then True else False)

function sub_with_overflow (a:t17) (b:t17) : (t17, bool) = (sub a b,
  if not in_bounds (infix_mn (tqtint a) (tqtint b)) then True else False)

function mul_with_overflow (a:t17) (b:t17) : (t17, bool) = (mul a b,
  if not in_bounds (infix_as (tqtint a) (tqtint b)) then True else False)

(* use creusot.int.UInt64 *)

type ptr

function thin ptr : ptr

type foreign

(* use creusot.prelude.Opaque *)

type slice 'a

function elts [@is_field_id] [@builtin] (slice 'a) : seq 'a

axiom sliceqtinvariant :
  forall self:slice 'a [self.elts].
   [@hyp_name:TypeInvariant] in_bounds (length (self.elts))

predicate sliceqteq (a:slice 'a) (b:slice 'a) = a.elts = b.elts

axiom sliceqtinj [@W:non_conservative_extension:N] :
  forall a:slice 'a, b:slice 'a. sliceqteq a b -> a = b

(* meta remove_unused:dependency prop sliceqtinj, predicate sliceqteq *)

(* meta model_record function elts *)

axiom slice_ext [@useraxiom] :
  forall x:slice 'a, y:slice 'a. x.elts = y.elts -> x = y

type array 'a = slice 'a

function length1 (slice 'a) : t17

axiom spec [@useraxiom] :
  forall s:slice 'a. tqtint (length1 s) = length (s.elts)

function view (s:slice 'a) : seq 'a = s.elts

function slice_ptr_len ptr : t17

