  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   ([@hyp_name:Ensures] mixfix_lbrb (set s i v) i = v)

axiom setqtspec [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   ([@hyp_name:Ensures]
    forall j:int.
     (infix_lseq 0 j /\ infix_ls j (length s)) /\ not j = i ->
     mixfix_lbrb (set s i v) j = mixfix_lbrb s j)

