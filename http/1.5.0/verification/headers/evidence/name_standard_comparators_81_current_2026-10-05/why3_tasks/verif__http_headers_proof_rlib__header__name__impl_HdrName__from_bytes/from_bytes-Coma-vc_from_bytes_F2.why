predicate header_chars_lower_tchar (byte:t17) =
  tqtint byte = 33 \/
  tqtint byte = 35 \/
  tqtint byte = 36 \/
  tqtint byte = 37 \/
  tqtint byte = 38 \/
  tqtint byte = 39 \/
  tqtint byte = 42 \/
  tqtint byte = 43 \/
  tqtint byte = 45 \/
