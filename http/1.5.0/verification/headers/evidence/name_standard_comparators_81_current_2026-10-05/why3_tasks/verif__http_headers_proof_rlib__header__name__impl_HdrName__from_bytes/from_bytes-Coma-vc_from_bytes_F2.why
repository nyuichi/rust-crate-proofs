function neg2 t20 : t20

axiom neg_in_bounds [@useraxiom] :
  forall x:t20 [neg2 x].
   infix_ls min_int (to_int x) /\ infix_lseq (to_int x) max_int ->
   to_int (neg2 x) = prefix_mn (to_int x)

axiom neg_wrapping [@useraxiom] :
  forall x:t20 [neg2 x]. to_int x = min_int -> to_int (neg2 x) = min_int

function of_bool2 [@inline:trivial] (b:bool) : t20 =
