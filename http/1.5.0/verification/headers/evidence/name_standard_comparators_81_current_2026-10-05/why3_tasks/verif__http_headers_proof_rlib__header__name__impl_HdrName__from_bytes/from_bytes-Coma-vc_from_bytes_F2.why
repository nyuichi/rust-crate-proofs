(* meta remove_unused:dependency prop to_int_srem, function srem *)

predicate u_add_o (a:t21) (b:t21) =
  not infix_ls (infix_pl (tqtint3 a) (tqtint3 b)) two_power_size3

predicate s_add_o (a:t21) (b:t21) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_pl (to_int1 a) (to_int1 b)) /\
       infix_ls (infix_pl (to_int1 a) (to_int1 b)) two_power_sizem1)

predicate u_sub_o (a:t21) (b:t21) = not infix_gteq (tqtint3 a) (tqtint3 b)

predicate s_sub_o (a:t21) (b:t21) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_mn (to_int1 a) (to_int1 b)) /\
       infix_ls (infix_mn (to_int1 a) (to_int1 b)) two_power_sizem1)

predicate u_mul_o (a:t21) (b:t21) =
  not infix_ls (infix_as (tqtint3 a) (tqtint3 b)) two_power_size3

predicate s_mul_o (a:t21) (b:t21) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_as (to_int1 a) (to_int1 b)) /\
       infix_ls (infix_as (to_int1 a) (to_int1 b)) two_power_sizem1)

predicate s_neg_o (a:t21) = to_int1 a = prefix_mn two_power_sizem1

predicate s_div_o (a:t21) (b:t21) = a = min_sint /\ b = minus_one

