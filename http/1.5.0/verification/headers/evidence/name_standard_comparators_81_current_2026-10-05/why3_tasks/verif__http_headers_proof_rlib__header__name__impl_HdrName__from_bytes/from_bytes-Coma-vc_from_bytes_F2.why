function header_chars_byte (byte:t17) : int =
  if infix_lseq 65 (tqtint byte) /\ infix_lseq (tqtint byte) 90
  then infix_pl (tqtint byte) 32
  else if header_chars_lower_tchar byte then tqtint byte else 0

predicate header_bytes_allowed (bytes:seq t17) =
  forall i:int.
