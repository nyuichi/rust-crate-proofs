  infix_lseq 94 (tqtint byte) /\ infix_lseq (tqtint byte) 96 \/
  infix_lseq 97 (tqtint byte) /\ infix_lseq (tqtint byte) 122 \/
  tqtint byte = 124 \/ tqtint byte = 126

function header_chars_h2_byte (byte:t17) : int =
