type t23

function to_int3 t23 : int

axiom to_int [@useraxiom] :
  forall c:t23.
   (infix_lseq 0 (to_int3 c) /\ infix_ls (to_int3 c) 0x10FFFF) /\
   not (infix_lseq 0xD800 (to_int3 c) /\ infix_ls (to_int3 c) 0xE000)

axiom extensionality3 [@useraxiom] :
  forall x:t23, y:t23 [to_int3 x, to_int3 y]. to_int3 x = to_int3 y -> x = y

function of_int5 int : t23

axiom to_of_int3 [@useraxiom] :
  forall n:int [of_int5 n].
   (infix_lseq 0 n /\ infix_ls n 0x10FFFF) /\
   not (infix_lseq 0xD800 n /\ infix_ls n 0xE000) -> to_int3 (of_int5 n) = n

predicate le3 [@inline:trivial] (a:t23) (b:t23) =
  infix_lseq (to_int3 a) (to_int3 b)

predicate lt3 [@inline:trivial] (a:t23) (b:t23) =
  infix_ls (to_int3 a) (to_int3 b)

predicate ge3 [@inline:trivial] (a:t23) (b:t23) =
  infix_gteq (to_int3 a) (to_int3 b)

predicate gt3 [@inline:trivial] (a:t23) (b:t23) =
  infix_gt (to_int3 a) (to_int3 b)

