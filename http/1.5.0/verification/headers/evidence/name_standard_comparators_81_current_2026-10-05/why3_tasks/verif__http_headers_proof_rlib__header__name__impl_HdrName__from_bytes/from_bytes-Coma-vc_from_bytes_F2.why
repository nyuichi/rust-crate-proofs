  forall x:t20, y:t20 [sub2 x y].
   in_bounds2 (infix_mn (to_int x) (to_int y)) ->
   to_int (sub2 x y) = infix_mn (to_int x) (to_int y)

axiom sub_wrapping2 [@useraxiom] :
  forall x:t20, y:t20 [sub2 x y].
