predicate eq_sub (a:t21) (b:t21) (i:int) (n:int) =
  forall j:int.
   infix_lseq i j /\ infix_ls j (infix_pl i n) -> nth2 a j = nth2 b j

axiom eq_sub_equiv :
  forall a:t21, b:t21, i:t21, n:t21.
   eq_sub a b (tqtint3 i) (tqtint3 n) <-> eq_sub_bv a b i n

