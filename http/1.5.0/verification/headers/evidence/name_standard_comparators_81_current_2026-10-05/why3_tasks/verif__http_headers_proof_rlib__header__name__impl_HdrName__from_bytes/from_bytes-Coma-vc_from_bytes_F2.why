axiom mul_in_bounds2 [@useraxiom] :
  forall x:t20, y:t20 [mul2 x y].
   in_bounds2 (infix_as (to_int x) (to_int y)) ->
   to_int (mul2 x y) = infix_as (to_int x) (to_int y)

axiom mul_wrapping2 [@useraxiom] :
  forall x:t20, y:t20 [mul2 x y].
