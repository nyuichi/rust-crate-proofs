function infix_plpl (s1:seq 'a) (s2:seq 'a) : seq 'a =
  let l = length s1 in
  create (infix_pl l (length s2))
  (fun (i:int) ->
    if infix_ls i l then mixfix_lbrb s1 i else mixfix_lbrb s2 (infix_mn i l))

axiom infix_plplqtspecqt1 [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   length (infix_plpl s1 s2) = infix_pl (length s1) (length s2)

axiom infix_plplqtspecqt0 [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_lseq 0 i /\ infix_ls i (length s1) ->
    mixfix_lbrb (infix_plpl s1 s2) i = mixfix_lbrb s1 i

axiom infix_plplqtspec [@W:non_conservative_extension:N] :
  forall s1:seq 'a, s2:seq 'a.
   [@hyp_name:Ensures]
   forall i:int.
    infix_lseq (length s1) i /\ infix_ls i (length (infix_plpl s1 s2)) ->
    mixfix_lbrb (infix_plpl s1 s2) i =
    mixfix_lbrb s2 (infix_mn i (length s1))

