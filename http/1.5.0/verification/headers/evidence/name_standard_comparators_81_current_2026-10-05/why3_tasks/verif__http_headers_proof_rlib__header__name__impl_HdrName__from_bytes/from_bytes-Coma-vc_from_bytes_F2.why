  [@hyp_name:Assert] [@expl:parse_hdr ensures]
  ([@stop_split] [@expl:parse_hdr result type invariant]
   inv_Result_HdrName_InvalidHeaderName result1) /\
  ([@stop_split] [@expl:parse_hdr ensures]
   match result1 with
   | Ok name ->
       infix_ls 0 (length (view hdr)) /\
       infix_lseq (length (view hdr)) 65535 /\
       match deep_model_HdrName name with
       | Standardqt0 _ ->
           infix_lseq (length (view hdr)) (tqtint1 const_SCRATCH_BUF_SIZE)
       | Customqt0 (Tup2_Seq_u8_boolqtmk bytes lowerqt0) ->
           (lowerqt0 = True <->
            infix_lseq (length (view hdr)) (tqtint1 const_SCRATCH_BUF_SIZE)) /\
           (not lowerqt0 = True -> bytes = view hdr)
       end /\
       (if infix_lseq (length (view hdr)) (tqtint1 const_SCRATCH_BUF_SIZE)
        then (if false then lowercase_header_bytes_allowed (view hdr)
              else header_bytes_allowed (view hdr)) /\
             length (hdr_name_model_bytes (deep_model_HdrName name)) =
             length (view hdr) /\
             (forall i:int.
               infix_lseq 0 i /\ infix_ls i (length (view hdr)) ->
               (if false
                then tqtint
                     (get (hdr_name_model_bytes (deep_model_HdrName name)) i) =
                     header_chars_h2_byte (get (view hdr) i)
                else tqtint
                     (get (hdr_name_model_bytes (deep_model_HdrName name)) i) =
                     header_chars_byte (get (view hdr) i)))
        else hdr_name_model_bytes (deep_model_HdrName name) = view hdr)
   | Err _ ->
       length (view hdr) = 0 \/
       infix_gt (length (view hdr)) 65535 \/
       infix_lseq (length (view hdr)) (tqtint1 const_SCRATCH_BUF_SIZE) /\
       (if false then not lowercase_header_bytes_allowed (view hdr)
        else not header_bytes_allowed (view hdr))
   end)

