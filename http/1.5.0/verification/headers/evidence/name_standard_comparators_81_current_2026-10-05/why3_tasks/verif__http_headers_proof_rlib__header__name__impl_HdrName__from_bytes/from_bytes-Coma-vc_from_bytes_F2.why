      infix_lseq (length data) (tqtint1 const_SCRATCH_BUF_SIZE)
  | Customqt0 (Tup2_Seq_u8_boolqtmk bytes lowerqt0) ->
      (lowerqt0 = True <->
       infix_lseq (length data) (tqtint1 const_SCRATCH_BUF_SIZE)) /\
      (not lowerqt0 = True -> bytes = data)
  end /\
  (if infix_lseq (length data) (tqtint1 const_SCRATCH_BUF_SIZE)
   then header_bytes_allowed data /\
        length (hdr_name_model_bytes modelqt0) = length data /\
        (forall i:int.
          infix_lseq 0 i /\ infix_ls i (length data) ->
          tqtint (get (hdr_name_model_bytes modelqt0) i) =
          header_chars_byte (get data i))
   else hdr_name_model_bytes modelqt0 = data)

