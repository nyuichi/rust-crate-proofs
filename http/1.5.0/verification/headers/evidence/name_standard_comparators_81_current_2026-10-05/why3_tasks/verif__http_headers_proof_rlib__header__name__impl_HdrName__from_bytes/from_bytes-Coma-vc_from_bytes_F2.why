constant min_int : int = (- 0x8000000000000000)

constant max_int : int = 0x7FFFFFFFFFFFFFFF

constant two_power_size2 : int = 0x10000000000000000

predicate in_bounds2 [@inline:trivial] (n:int) =
  infix_lseq min_int n /\ infix_lseq n max_int

function to_int (x:t20) : int = tqtint2 x

axiom extensionality2 [@useraxiom] :
  forall x:t20, y:t20 [to_int x, to_int y]. to_int x = to_int y -> x = y

function of_int2 int : t20

axiom to_of_int2 [@useraxiom] :
  forall x:int [of_int2 x]. in_bounds2 x -> to_int (of_int2 x) = x

function add2 t20 t20 : t20

axiom add_in_bounds2 [@useraxiom] :
  forall x:t20, y:t20 [add2 x y].
   in_bounds2 (infix_pl (to_int x) (to_int y)) ->
   to_int (add2 x y) = infix_pl (to_int x) (to_int y)

axiom add_wrapping2 [@useraxiom] :
  forall x:t20, y:t20 [add2 x y].
   exists k:int.
    to_int (add2 x y) =
    infix_pl (infix_pl (to_int x) (to_int y)) (infix_as k two_power_size2)

