predicate invariant_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/byte_str.rs" 48 4 48 30] (self: t_ByteStr) =
  [%#sbyte_str'4] valid_utf8 (view_ByteStr self)

