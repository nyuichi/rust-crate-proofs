function hist_inv_trans_from (self: ()) (b: ()) (c: ()) : ()

axiom hist_inv_trans_from_spec: forall self: (), b: (), c: (). ([%#sops'8] hist_inv_from self b)
    -> ([%#sops'9] hist_inv_from b c) -> ([%#sops'10] hist_inv_from self c)

function hist_inv_refl_from (self: ()) : ()

axiom hist_inv_refl_from_spec: forall self: (). [%#sops'7] hist_inv_from self self

function postcondition_mut_hist_inv_from (self: ()) (args: ()) (res_state: ()) (res: ()) : ()

axiom postcondition_mut_hist_inv_from_spec:
  forall self: (), args: (), res_state: (), res: (). ([%#sops'5] postcondition_mut_from self args res_state res)
    -> ([%#sops'6] hist_inv_from self res_state)

function fn_hist_inv_from (self: ()) (res_state: ()) : ()

axiom fn_hist_inv_from_spec: forall self: (), res_state: (). [%#sops'4] hist_inv_from self res_state
    = (self = res_state)

predicate postcondition_from [@inline:trivial] (self: ()) (args: ()) (result: ()) =
  let self_ = args in [%#sconvert] result = self_

meta "rewrite_def" predicate postcondition_from

function fn_once_from (self: ()) (args: ()) (res: ()) : ()

axiom fn_once_from_spec: forall self: (), args: (), res: (). [%#sops'3] postcondition_once_from self args res
    = (postcondition_from self args res /\ resolve_from self)

function fn_mut_from (self: ()) (args: ()) (res_state: ()) (res: ()) : ()

axiom fn_mut_from_spec:
  forall self: (), args: (), res_state: (), res: (). [%#sops'2] postcondition_mut_from self args res_state res
