use creusot.int.UInt8
use seq.Seq
use map.Map
use creusot.int.Int64
use int.ComputerDivision
use int.Int

type t_Bytes

predicate inv_Bytes (_1: t_Bytes)

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'1] forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 51 4 51 33] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'2] bytes_seq self.inner

function decimal_values (n: int) : Seq.seq int

axiom decimal_values_def: forall n: int. ([%#sverification'3] n >= 0)
    -> decimal_values n
    = ([%#sverification'4] if n < 10 then
      Seq.singleton (48 + n)
    else
      Seq.snoc (decimal_values (ComputerDivision.div n 10)) (48 + ComputerDivision.mod n 10)
    )

function signed_decimal_values (n: int) : Seq.seq int = [%#sverification'0] if n < 0 then
    Seq.(++) (Seq.singleton 45) (decimal_values (- n))
  else
    decimal_values n


function value_i64 (self: Int64.t) : int = [%#sverification'5] Int64.to_int self

function integer_value_i64 (value: Int64.t) : int = [%#sverification'1] value_i64 value

function integer_decimal_values_i64 (value: Int64.t) : Seq.seq int =
  [%#sverification] signed_decimal_values (integer_value_i64 value)

predicate sensitive_model [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 71 4 71 41] (self: t_HeaderValue) =
  [%#svalue'3] self.is_sensitive

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall value: Int64.t. forall result: t_HeaderValue. ([%#svalue] inv_HeaderValue result)
        /\ ([%#svalue'0] map_u8 (view_HeaderValue result) (fun (byte: UInt8.t) -> UInt8.t'int byte)
          = integer_decimal_values_i64 value)
        /\ ([%#svalue'1] not sensitive_model result) -> inv_HeaderValue result
