use creusot.prelude.MutBorrow

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_Bytes (_1: t_Bytes)

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

predicate invariant_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) = [%#sinvariant] inv_HeaderValue self

meta "rewrite_def" predicate invariant_ref_HeaderValue

predicate inv_ref_HeaderValue [@inline:trivial] (_1: t_HeaderValue) = invariant_ref_HeaderValue _1

meta "rewrite_def" predicate inv_ref_HeaderValue

type t_H

predicate inv_H (_1: t_H)

predicate invariant_refmut_H [@inline:trivial] (self: MutBorrow.t t_H) =
  [%#sinvariant'0] inv_H self.current /\ inv_H self.final

meta "rewrite_def" predicate invariant_refmut_H

predicate inv_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = invariant_refmut_H _1

meta "rewrite_def" predicate inv_refmut_H

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_HeaderValue. forall state: MutBorrow.t t_H. ([%#shash] inv_ref_HeaderValue self_)
        /\ ([%#shash'0] inv_refmut_H state)
      -> ([%#svalue] inv_ref_HeaderValue self_)
      /\ ([%#svalue'0] inv_refmut_H state) /\ (forall result: (). [%#shash'1] inv_H state.final)
