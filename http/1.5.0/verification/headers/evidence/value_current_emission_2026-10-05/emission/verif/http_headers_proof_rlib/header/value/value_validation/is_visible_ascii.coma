let rec is_visible_ascii
  [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value_validation.rs" 6 0 6 51]
  (b: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- UInt8.ge b ([%#svalue_validation] (32: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_4 = false} (! bb5) | br1 -> {_4} (! bb1) ] ]
  | bb1 = s0
