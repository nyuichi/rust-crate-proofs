use creusot.int.UInt8
use seq.Seq
use creusot.slice.Slice64
use int.Int

type t_Bytes

type t_HeaderValue = { inner: t_Bytes; is_sensitive: bool }

predicate inv_Bytes (_1: t_Bytes)

predicate inv_HeaderValue (_1: t_HeaderValue)

axiom inv_axiom [@rewrite]: forall x: t_HeaderValue [inv_HeaderValue x]. inv_HeaderValue x = inv_Bytes x.inner

predicate invariant_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) = [%#sinvariant] inv_HeaderValue self

meta "rewrite_def" predicate invariant_ref_HeaderValue

predicate inv_ref_HeaderValue [@inline:trivial] (_1: t_HeaderValue) = invariant_ref_HeaderValue _1

meta "rewrite_def" predicate inv_ref_HeaderValue

type t_Ordering = Less | Equal | Greater

function cmp_log_Int (self: int) (o: int) : t_Ordering = [%#sord] if self < o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_Int (x: int) (y: int) : ()

axiom eq_cmp_Int_spec: forall x: int, y: int. [%#sord'12] (x = y) = (cmp_log_Int x y = Equal)

function antisym2_Int (x: int) (y: int) : ()

axiom antisym2_Int_spec: forall x: int, y: int. ([%#sord'10] cmp_log_Int x y = Greater)
    -> ([%#sord'11] cmp_log_Int y x = Less)

function antisym1_Int (x: int) (y: int) : ()

axiom antisym1_Int_spec: forall x: int, y: int. ([%#sord'8] cmp_log_Int x y = Less)
    -> ([%#sord'9] cmp_log_Int y x = Greater)

function trans_Int (x: int) (y: int) (z: int) (o: t_Ordering) : ()

axiom trans_Int_spec: forall x: int, y: int, z: int, o: t_Ordering. ([%#sord'5] cmp_log_Int x y = o)
    -> ([%#sord'6] cmp_log_Int y z = o) -> ([%#sord'7] cmp_log_Int x z = o)

function refl_Int (x: int) : ()

axiom refl_Int_spec: forall x: int. [%#sord'4] cmp_log_Int x x = Equal

function cmp_gt_log_Int (x: int) (y: int) : ()

axiom cmp_gt_log_Int_spec: forall x: int, y: int. [%#sord'3] (x > y) = (cmp_log_Int x y = Greater)

function cmp_ge_log_Int (x: int) (y: int) : ()

axiom cmp_ge_log_Int_spec: forall x: int, y: int. [%#sord'2] (x >= y) = (cmp_log_Int x y <> Less)

function cmp_lt_log_Int (x: int) (y: int) : ()

axiom cmp_lt_log_Int_spec: forall x: int, y: int. [%#sord'1] (x < y) = (cmp_log_Int x y = Less)

function cmp_le_log_Int (x: int) (y: int) : ()

axiom cmp_le_log_Int_spec: forall x: int, y: int. [%#sord'0] (x <= y) = (cmp_log_Int x y <> Greater)

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function tail_Int (self: Seq.seq int) : Seq.seq int = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function seq_cmp_u8_int (bytes: Seq.seq UInt8.t) (integers: Seq.seq int) : t_Ordering

axiom seq_cmp_u8_int_def: forall bytes: Seq.seq UInt8.t, integers: Seq.seq int. seq_cmp_u8_int bytes integers
    = ([%#spartial_ord'1] if Seq.length bytes = 0 then
      if Seq.length integers = 0 then Equal else Less
    else
      if Seq.length integers = 0 then
        Greater
      else
        match cmp_log_Int (UInt8.t'int (Seq.get bytes 0)) (Seq.get integers 0) with
          | Less -> Less
          | Greater -> Greater
          | Equal -> seq_cmp_u8_int (tail_u8 bytes) (tail_Int integers)
          end
    
    )

function partial_cmp_model_Seq_u8 (self: Seq.seq UInt8.t) (rhs: Seq.seq int) : t_Ordering =
  [%#spartial_ord] seq_cmp_u8_int self rhs

function bytes_seq (_value: t_Bytes) : Seq.seq UInt8.t

function view_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 51 4 51 33] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'2] bytes_seq self.inner

function deep_model_HeaderValue [#"/workspace/rust-crate-proofs/http/1.5.0/verification/headers/src/../../../src/header/value.rs" 61 4 61 44] (self: t_HeaderValue) : Seq.seq UInt8.t
 = [%#svalue'1] view_HeaderValue self

function deep_model_ref_HeaderValue [@inline:trivial] (self: t_HeaderValue) : Seq.seq UInt8.t =
  [%#smodel] deep_model_HeaderValue self

meta "rewrite_def" function deep_model_ref_HeaderValue

function deep_model_u8 [@inline:trivial] (self: UInt8.t) : int = [%#snum] UInt8.t'int self

meta "rewrite_def" function deep_model_u8

function index_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: int) : UInt8.t =
  [%#sslice'1] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_u8

function deep_model_slice_u8 (self: Slice64.slice UInt8.t) : Seq.seq int

axiom deep_model_slice_u8_spec: forall self: Slice64.slice UInt8.t. [%#sslice] Seq.length (Slice64.view self)
    = Seq.length (deep_model_slice_u8 self)

axiom deep_model_slice_u8_spec'0: forall self: Slice64.slice UInt8.t. [%#sslice'0] forall i: int. 0 <= i
        /\ i < Seq.length (deep_model_slice_u8 self)
      -> Seq.get (deep_model_slice_u8 self) i = deep_model_u8 (index_slice_u8 self i)

function deep_model_ref_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) : Seq.seq int =
  [%#smodel] deep_model_slice_u8 self

meta "rewrite_def" function deep_model_ref_slice_u8

type t_Option_Ordering = None | Some t_Ordering

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_HeaderValue. forall rhs: Slice64.slice UInt8.t. ([%#scmp] inv_ref_HeaderValue self_)
      -> ([%#svalue] inv_ref_HeaderValue self_)
      /\ (forall result: t_Option_Ordering. ([%#svalue'0] result
          = Some (partial_cmp_model_Seq_u8 (deep_model_ref_HeaderValue self_) (deep_model_ref_slice_u8 rhs)))
        -> ([%#scmp'0] result
        = Some (partial_cmp_model_Seq_u8 (deep_model_HeaderValue self_) (deep_model_slice_u8 rhs))))
