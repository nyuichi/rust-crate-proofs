function nth_bv t19 t19 : bool

axiom nth_bv_def :
  forall x:t19, i:t19.
   nth_bv x i = True <-> not bw_and2 (lsr_bv x i) one3 = zeros

(* meta remove_unused:dependency prop nth_bv_def, function nth_bv *)

axiom Nth_bv_is_nth : forall x:t19, i:t19. nth2 x (tqtint2 i) = nth_bv x i

(* meta remove_unused:dependency prop Nth_bv_is_nth, function nth_bv *)

(* meta remove_unused:dependency prop Nth_bv_is_nth, function nth2 *)

axiom Nth_bv_is_nth2 :
  forall x:t19, i:int.
   infix_lseq 0 i /\ infix_ls i two_power_size2 ->
   nth_bv x (of_int2 i) = nth2 x i

(* meta remove_unused:dependency prop Nth_bv_is_nth2, function nth_bv *)

