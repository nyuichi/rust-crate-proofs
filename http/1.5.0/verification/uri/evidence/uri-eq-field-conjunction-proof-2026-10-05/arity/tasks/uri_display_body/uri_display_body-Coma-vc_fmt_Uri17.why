function rotate_right t19 int : t19

axiom Nth_rotate_right :
  forall v:t19, n:int, i:int.
   infix_lseq 0 i /\ infix_ls i size ->
   infix_lseq 0 n ->
   nth2 (rotate_right v n) i = nth2 v (mod1 (infix_pl i n) size)

(* meta remove_unused:dependency prop Nth_rotate_right,
  function rotate_right *)

function rotate_left t19 int : t19

axiom Nth_rotate_left :
  forall v:t19, n:int, i:int.
   infix_lseq 0 i /\ infix_ls i size ->
   infix_lseq 0 n ->
   nth2 (rotate_left v n) i = nth2 v (mod1 (infix_mn i n) size)

(* meta remove_unused:dependency prop Nth_rotate_left,
