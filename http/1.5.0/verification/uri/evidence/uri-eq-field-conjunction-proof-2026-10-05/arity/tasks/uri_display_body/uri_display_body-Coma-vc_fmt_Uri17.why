function pow2 int : int

axiom Power_0 [@useraxiom] : pow2 0 = 1

(* meta remove_unused:dependency prop Power_0, function pow2 *)

axiom Power_s [@useraxiom] :
  forall n:int. infix_gteq n 0 -> pow2 (infix_pl n 1) = infix_as 2 (pow2 n)

(* meta remove_unused:dependency prop Power_s, function pow2 *)

axiom Power_1 : pow2 1 = 2

(* meta remove_unused:dependency prop Power_1, function pow2 *)

axiom Power_sum :
  forall n:int, m:int.
   infix_gteq n 0 /\ infix_gteq m 0 ->
   pow2 (infix_pl n m) = infix_as (pow2 n) (pow2 m)

(* meta remove_unused:dependency prop Power_sum, function pow2 *)

axiom pow2pos : forall i:int. infix_gteq i 0 -> infix_gt (pow2 i) 0

