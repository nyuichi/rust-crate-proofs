function uri_scheme_display_bytes (schemeqt2:t_SchemeModel) : seq t18 =
  match schemeqt2 with
  | Noneqt2 -> empty: seq t18
  | Httpqt2 ->
      create 4
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (104:t18)
        else if xqtx = 1 then (116:t18)
             else if xqtx = 2 then (116:t18)
                  else if xqtx = 3 then (112:t18) else (112:t18))
  | Httpsqt2 ->
      create 5
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (104:t18)
        else if xqtx = 1 then (116:t18)
             else if xqtx = 2 then (116:t18)
                  else if xqtx = 3 then (112:t18)
                       else if xqtx = 4 then (115:t18) else (115:t18))
  | Otherqt2 bytesqt0 -> bytesqt0
  end

function uri_display_text (model:t_UriModel) : seq int =
  let has_path = (if uri_model_has_path model then True else False) in
  let scheme_text =
    (if uri_scheme_is_none (model.schemeqt0) then empty: seq t18
     else infix_plpl (uri_scheme_display_bytes (model.schemeqt0))
          (create 3
           ([@funlit]
            fun (xqtx:int) ->
             if xqtx = 0 then (58:t18)
             else if xqtx = 1 then (47:t18)
                  else if xqtx = 2 then (47:t18) else (47:t18))))
  in
  let authority_text = model.authorityqt0 in
  let path_text =
    (if has_path = True then path_component_bytes (model.path_and_queryqt0)
     else empty: seq t18)
  in
  let query_text =
    match (model.path_and_queryqt0).query with
  | Noneqt1 -> empty: seq t18
  | Someqt1 offset ->
      infix_plpl
      (create 1
       ([@funlit] fun (xqtx:int) -> if xqtx = 0 then (63:t18) else (63:t18)))
      (mixfix_lbdtdtrb ((model.path_and_queryqt0).bytes) (infix_pl offset 1)
       (length ((model.path_and_queryqt0).bytes)))
  end
  in
  map_u8
  (infix_plpl (infix_plpl (infix_plpl scheme_text authority_text) path_text)
   query_text)
  (fun (byte:t18) -> tqtint1 byte)

