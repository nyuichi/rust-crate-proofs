  infix_lseq (infix_pl startqt0 (length expected)) (length bytesqt0) /\
  uri_ascii_fold_bytes
  (mixfix_lbdtdtrb bytesqt0 startqt0 (infix_pl startqt0 (length expected))) =
  expected

predicate uri_exact_bytes_match_at (bytesqt0:seq t18) (startqt0:int)
  (expected:seq t18) =
  infix_lseq 0 startqt0 /\
  infix_lseq (infix_pl startqt0 (length expected)) (length bytesqt0) /\
  mixfix_lbdtdtrb bytesqt0 startqt0 (infix_pl startqt0 (length expected)) =
  expected

predicate uri_compare_model_matches_text (model:t_UriCompareModel) (text:seq
  t21) =
  let bytesqt0 = to_bytes text in
  let scheme_text = uri_scheme_comparison_text (model.schemeqt2) in
  let scheme_present =
    match scheme_text with
  | Noneqt7 -> False
  | Someqt7 _ -> True
  end
  in
  let scheme_ok =
    (if match scheme_text with
     | Noneqt7 -> true
     | Someqt7 scheme_bytes ->
         infix_lseq 0 (infix_pl (length scheme_bytes) 3) /\
         infix_lseq (infix_pl (length scheme_bytes) 3) (length bytesqt0) /\
         uri_folded_bytes_match_at bytesqt0 0 scheme_bytes /\
         mixfix_lbdtdtrb bytesqt0 (length scheme_bytes)
         (infix_pl (length scheme_bytes) 3) =
         create 3
         ([@funlit]
          fun (xqtx:int) ->
           if xqtx = 0 then (58:t18)
           else if xqtx = 1 then (47:t18)
                else if xqtx = 2 then (47:t18) else (47:t18))
     end then True else False)
  in
  let after_scheme =
    match scheme_text with
  | Noneqt7 -> 0
  | Someqt7 scheme_bytes -> infix_pl (length scheme_bytes) 3
  end
  in
  let authority_present =
    (if infix_gt (length (model.authorityqt2)) 0 then True else False)
  in
  let authority_ok =
    (if not authority_present = True \/
        uri_folded_bytes_match_at bytesqt0 after_scheme (model.authorityqt2)
     then True else False)
  in
  let after_authority =
    infix_pl after_scheme (length (model.authorityqt2))
  in
  let absolute =
    (if scheme_present = True \/ authority_present = True then True
     else False)
  in
  let path_start =
    (if scheme_ok = True /\ authority_ok = True then after_authority else 0)
  in
  let path_matches =
    (if uri_exact_bytes_match_at bytesqt0 path_start (model.pathqt2)
     then True else False)
  in
  let omitted_absolute_slash =
    (if absolute = True /\
        model.pathqt2 =
        create 1
        ([@funlit] fun (xqtx:int) -> if xqtx = 0 then (47:t18) else (47:t18))
     then True else False)
  in
  let path_ok =
    (if path_matches = True \/ omitted_absolute_slash = True then True
     else False)
  in
  let after_path =
    (if path_matches = True then infix_pl path_start (length (model.pathqt2))
     else path_start)
  in
  let query_ok =
    (if match model.queryqt2 with
     | Noneqt6 -> true
     | Someqt6 query_bytes ->
         if after_path = length bytesqt0 then length query_bytes = 0
         else infix_ls after_path (length bytesqt0) /\
              tqtint1 (get bytesqt0 after_path) = 63 /\
              uri_exact_bytes_match_at bytesqt0 (infix_pl after_path 1)
              query_bytes
     end then True else False)
  in
  let after_query =
    match model.queryqt2 with
  | Noneqt6 -> after_path
  | Someqt6 query_bytes ->
      if after_path = length bytesqt0 then after_path
      else infix_pl (infix_pl after_path 1) (length query_bytes)
  end
  in
  scheme_ok = True /\
  authority_ok = True /\
  path_ok = True /\
  query_ok = True /\
  (after_query = length bytesqt0 \/
   infix_lseq 0 after_query /\
   infix_ls after_query (length bytesqt0) /\
   tqtint1 (get bytesqt0 after_query) = 35)

function uri_scheme_comparison_model (schemeqt3:t_SchemeModel) :
  t_UriSchemeCompareModel =
  match schemeqt3 with
  | Noneqt2 -> Noneqt5
  | Httpqt2 -> Httpqt5
  | Httpsqt2 -> Httpsqt5
  | Otherqt2 bytesqt0 -> Otherqt5 (uri_ascii_fold_bytes bytesqt0)
  end

function uri_comparison_model (model:t_UriModel) : t_UriCompareModel =
  T_UriCompareModelqtmk (uri_scheme_comparison_model (model.schemeqt0))
  (uri_ascii_fold_bytes (model.authorityqt0))
  (if uri_model_has_path model
   then path_component_bytes (model.path_and_queryqt0) else empty: seq t18)
  match (model.path_and_queryqt0).query with
  | Noneqt1 -> Noneqt6
  | Someqt1 offset ->
      Someqt6
      (mixfix_lbdtdtrb ((model.path_and_queryqt0).bytes) (infix_pl offset 1)
       (length ((model.path_and_queryqt0).bytes)))
  end

function deep_model_Uri (self:t_Uri) : t_UriCompareModel =
  uri_comparison_model (view_Uri self)

function deep_model_ref_Uri [@inline:trivial] (self:t_Uri) :
  t_UriCompareModel = deep_model_Uri self

