(* meta remove_unused:dependency prop Div_minus1_left, function div1 *)

axiom Mod_1_left : forall y:int. infix_gt y 1 -> mod1 1 y = 1

(* meta remove_unused:dependency prop Mod_1_left, function mod1 *)

axiom Mod_minus1_left :
  forall y:int. infix_gt y 1 -> mod1 (- 1) y = infix_mn y 1

(* meta remove_unused:dependency prop Mod_minus1_left, function mod1 *)

axiom Div_mult1 :
  forall x:int, y:int, z:int [div1 (infix_pl (infix_as x y) z) x].
   infix_gt x 0 -> div1 (infix_pl (infix_as x y) z) x = infix_pl y (div1 z x)

(* meta remove_unused:dependency prop Div_mult1, function div1 *)

axiom Mod_mult1 :
  forall x:int, y:int, z:int [mod1 (infix_pl (infix_as x y) z) x].
