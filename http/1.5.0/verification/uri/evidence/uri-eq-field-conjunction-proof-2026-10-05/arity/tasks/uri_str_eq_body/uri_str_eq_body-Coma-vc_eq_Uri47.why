(* use bv.Pow2int *)

predicate is_signed_positive t19

function of_int2 int : t19

function to_int (x:t19) : int =
  if is_signed_positive x then tqtint2 x
  else prefix_mn (infix_mn two_power_size2 (tqtint2 x))

axiom to_uint_extensionality :
  forall v:t19, vqt:t19. tqtint2 v = tqtint2 vqt -> v = vqt

(* meta remove_unused:dependency prop to_uint_extensionality,
  function tqtint2 *)

axiom to_int_extensionality :
  forall v:t19, vqt:t19. to_int v = to_int vqt -> v = vqt

(* meta remove_unused:dependency prop to_int_extensionality,
  function to_int *)

predicate uint_in_range (i:int) = infix_lseq 0 i /\ infix_lseq i tqtmaxInt2

axiom to_uint_bounds :
  forall v:t19.
   infix_lseq 0 (tqtint2 v) /\ infix_ls (tqtint2 v) two_power_size2

(* meta remove_unused:dependency prop to_uint_bounds, function tqtint2 *)

axiom to_uint_of_int :
  forall i:int.
   infix_lseq 0 i /\ infix_ls i two_power_size2 -> tqtint2 (of_int2 i) = i

(* meta remove_unused:dependency prop to_uint_of_int, function tqtint2 *)

(* meta remove_unused:dependency prop to_uint_of_int, function of_int2 *)

axiom to_int_bounds :
  forall v:t19.
   infix_lseq (prefix_mn two_power_sizem1) (to_int v) /\
   infix_ls (to_int v) two_power_sizem1

(* meta remove_unused:dependency prop to_int_bounds, function to_int *)

axiom to_int_of_int :
  forall i:int.
   infix_lseq (prefix_mn two_power_sizem1) i /\ infix_ls i two_power_sizem1 ->
   to_int (of_int2 i) = i

(* meta remove_unused:dependency prop to_int_of_int, function of_int2 *)

constant size_bv : t19

inductive acc ('a -> 'a -> bool) 'a =
  | acc_x :
      forall r:'a -> 'a -> bool, x:'a.
       (forall y:'a. infix_at (infix_at r y) x = True -> acc r y) -> acc r x

predicate well_founded (r:'a -> 'a -> bool) = forall x:'a. acc r x

(* use why3.WellFounded.WellFounded *)

predicate ult (x:t19) (y:t19) = infix_ls (tqtint2 x) (tqtint2 y)

axiom ult_wf : well_founded (fun (y0:t19) (y1:t19) -> ult y0 y1)

(* meta vc:proved_wf predicate ult, prop ult_wf *)

(* meta remove_unused:dependency prop ult_wf, predicate ult *)

predicate ule (x:t19) (y:t19) = infix_lseq (tqtint2 x) (tqtint2 y)

predicate ugt (x:t19) (y:t19) = infix_gt (tqtint2 x) (tqtint2 y)

axiom ugt_wf : well_founded (fun (y0:t19) (y1:t19) -> ugt y0 y1)

(* meta vc:proved_wf predicate ugt, prop ugt_wf *)

(* meta remove_unused:dependency prop ugt_wf, predicate ugt *)

predicate uge (x:t19) (y:t19) = infix_gteq (tqtint2 x) (tqtint2 y)

predicate slt (v1:t19) (v2:t19) = infix_ls (to_int v1) (to_int v2)

axiom slt_wf : well_founded (fun (y0:t19) (y1:t19) -> slt y0 y1)

(* meta vc:proved_wf predicate slt, prop slt_wf *)

(* meta remove_unused:dependency prop slt_wf, predicate slt *)

predicate sle (v1:t19) (v2:t19) = infix_lseq (to_int v1) (to_int v2)

predicate sgt (v1:t19) (v2:t19) = infix_gt (to_int v1) (to_int v2)

axiom sgt_wf : well_founded (fun (y0:t19) (y1:t19) -> sgt y0 y1)

(* meta vc:proved_wf predicate sgt, prop sgt_wf *)

(* meta remove_unused:dependency prop sgt_wf, predicate sgt *)

predicate sge (v1:t19) (v2:t19) = infix_gteq (to_int v1) (to_int v2)

axiom positive_is_ge_zeros :
  forall x:t19. is_signed_positive x <-> sge x zeros

(* meta remove_unused:dependency prop positive_is_ge_zeros, predicate sge *)

(* meta remove_unused:dependency prop positive_is_ge_zeros,
  predicate is_signed_positive *)

function add2 t19 t19 : t19

axiom to_uint_add :
  forall v1:t19, v2:t19.
   tqtint2 (add2 v1 v2) =
   mod1 (infix_pl (tqtint2 v1) (tqtint2 v2)) two_power_size2

(* meta remove_unused:dependency prop to_uint_add, function add2 *)

axiom to_uint_add_bounded :
  forall v1:t19, v2:t19.
   infix_ls (infix_pl (tqtint2 v1) (tqtint2 v2)) two_power_size2 ->
   tqtint2 (add2 v1 v2) = infix_pl (tqtint2 v1) (tqtint2 v2)

(* meta remove_unused:dependency prop to_uint_add_bounded, function add2 *)

axiom to_uint_add_overflow :
  forall v1:t19, v2:t19.
   infix_gteq (infix_pl (tqtint2 v1) (tqtint2 v2)) two_power_size2 ->
   tqtint2 (add2 v1 v2) =
   infix_mn (infix_pl (tqtint2 v1) (tqtint2 v2)) two_power_size2

(* meta remove_unused:dependency prop to_uint_add_overflow, function add2 *)

function sub2 t19 t19 : t19

axiom to_uint_sub :
  forall v1:t19, v2:t19.
   tqtint2 (sub2 v1 v2) =
   mod1 (infix_mn (tqtint2 v1) (tqtint2 v2)) two_power_size2

(* meta remove_unused:dependency prop to_uint_sub, function sub2 *)

axiom to_uint_sub_bounded :
  forall v1:t19, v2:t19.
   infix_lseq 0 (infix_mn (tqtint2 v1) (tqtint2 v2)) ->
   tqtint2 (sub2 v1 v2) = infix_mn (tqtint2 v1) (tqtint2 v2)

(* meta remove_unused:dependency prop to_uint_sub_bounded, function sub2 *)

axiom to_uint_sub_overflow :
  forall v1:t19, v2:t19.
   infix_gt 0 (infix_mn (tqtint2 v1) (tqtint2 v2)) ->
   tqtint2 (sub2 v1 v2) =
   infix_pl (infix_mn (tqtint2 v1) (tqtint2 v2)) two_power_size2

(* meta remove_unused:dependency prop to_uint_sub_overflow, function sub2 *)

function neg2 t19 : t19

axiom to_uint_neg :
  forall v:t19.
   tqtint2 (neg2 v) = mod1 (prefix_mn (tqtint2 v)) two_power_size2

(* meta remove_unused:dependency prop to_uint_neg, function neg2 *)

axiom to_uint_neg_no_mod :
  forall v:t19.
   tqtint2 (neg2 v) =
   (if v = zeros then 0 else infix_mn two_power_size2 (tqtint2 v))

(* meta remove_unused:dependency prop to_uint_neg_no_mod, function neg2 *)

function mul2 t19 t19 : t19

axiom to_uint_mul :
  forall v1:t19, v2:t19.
   tqtint2 (mul2 v1 v2) =
   mod1 (infix_as (tqtint2 v1) (tqtint2 v2)) two_power_size2

(* meta remove_unused:dependency prop to_uint_mul, function mul2 *)

axiom to_uint_mul_bounded :
  forall v1:t19, v2:t19.
   infix_ls (infix_as (tqtint2 v1) (tqtint2 v2)) two_power_size2 ->
   tqtint2 (mul2 v1 v2) = infix_as (tqtint2 v1) (tqtint2 v2)

(* meta remove_unused:dependency prop to_uint_mul_bounded, function mul2 *)

function udiv t19 t19 : t19

axiom to_uint_udiv :
  forall v1:t19, v2:t19.
   tqtint2 (udiv v1 v2) = div1 (tqtint2 v1) (tqtint2 v2)

(* meta remove_unused:dependency prop to_uint_udiv, function udiv *)

function urem t19 t19 : t19

axiom to_uint_urem :
  forall v1:t19, v2:t19.
