(* meta remove_unused:dependency prop to_uint_urem, function urem *)

function sdiv t19 t19 : t19

axiom to_int_sdiv :
  forall v1:t19, v2:t19.
   to_int (sdiv v1 v2) = mod (div (to_int v1) (to_int v2)) two_power_size2

(* meta remove_unused:dependency prop to_int_sdiv, function sdiv *)

axiom to_int_sdiv_bounded :
  forall v1:t19, v2:t19.
   not v1 = lsl one3 (infix_mn size 1) \/ not v2 = ones ->
   to_int (sdiv v1 v2) = div (to_int v1) (to_int v2)

(* meta remove_unused:dependency prop to_int_sdiv_bounded, function sdiv *)

function srem t19 t19 : t19

axiom to_int_srem :
  forall v1:t19, v2:t19. to_int (srem v1 v2) = mod (to_int v1) (to_int v2)

(* meta remove_unused:dependency prop to_int_srem, function srem *)

predicate u_add_o (a:t19) (b:t19) =
  not infix_ls (infix_pl (tqtint2 a) (tqtint2 b)) two_power_size2

predicate s_add_o (a:t19) (b:t19) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_pl (to_int a) (to_int b)) /\
       infix_ls (infix_pl (to_int a) (to_int b)) two_power_sizem1)

predicate u_sub_o (a:t19) (b:t19) = not infix_gteq (tqtint2 a) (tqtint2 b)

predicate s_sub_o (a:t19) (b:t19) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_mn (to_int a) (to_int b)) /\
       infix_ls (infix_mn (to_int a) (to_int b)) two_power_sizem1)

predicate u_mul_o (a:t19) (b:t19) =
  not infix_ls (infix_as (tqtint2 a) (tqtint2 b)) two_power_size2

predicate s_mul_o (a:t19) (b:t19) =
  not (infix_lseq (prefix_mn two_power_sizem1)
       (infix_as (to_int a) (to_int b)) /\
       infix_ls (infix_as (to_int a) (to_int b)) two_power_sizem1)

predicate s_neg_o (a:t19) = to_int a = prefix_mn two_power_sizem1

predicate s_div_o (a:t19) (b:t19) = a = min_sint /\ b = minus_one

function lsr_bv t19 t19 : t19

axiom lsr_bv_is_lsr : forall x:t19, n:t19. lsr_bv x n = lsr x (tqtint2 n)

