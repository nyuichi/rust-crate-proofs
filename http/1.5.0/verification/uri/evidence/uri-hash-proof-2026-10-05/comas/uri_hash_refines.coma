  [%#sbyte_str] valid_utf8 (view_ByteStr self)

predicate inv_ByteStr (_1: t_ByteStr)

axiom inv_axiom: forall x: t_ByteStr [inv_ByteStr x]. inv_ByteStr x -> invariant_ByteStr x

predicate invariant_Box_ByteStr_Global (self: t_ByteStr) = [%#sboxed] inv_ByteStr self

predicate inv_Box_ByteStr_Global [@inline:trivial] (_1: t_ByteStr) = invariant_Box_ByteStr_Global _1

meta "rewrite_def" predicate inv_Box_ByteStr_Global

predicate inv_Scheme2_Box_ByteStr_Global (_1: t_Scheme2_Box_ByteStr_Global)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Scheme2_Box_ByteStr_Global [inv_Scheme2_Box_ByteStr_Global x]. inv_Scheme2_Box_ByteStr_Global x
    = match x with
      | None -> true
      | Standard f0 -> true
      | Other f0 -> inv_Box_ByteStr_Global f0
      end

predicate inv_Scheme (_1: t_Scheme)

axiom inv_axiom'1 [@rewrite]: forall x: t_Scheme [inv_Scheme x]. inv_Scheme x = inv_Scheme2_Box_ByteStr_Global x.inner

predicate inv_Authority (_1: t_Authority)

axiom inv_axiom'2 [@rewrite]: forall x: t_Authority [inv_Authority x]. inv_Authority x = inv_ByteStr x.data

type t_Option_Int = None'0 | Some'0 int

type t_PathAndQueryModel = { bytes: Seq.seq UInt8.t; query: t_Option_Int }

predicate path_query_boundaries [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 233 0 233 62] (model: t_PathAndQueryModel) =
  [%#spath'0] match model.query with
    | None'0 -> true
    | Some'0 query'1 -> 0 <= query'1
    /\ query'1 < Seq.length model.bytes /\ UInt8.t'int (Seq.get model.bytes query'1) = 63
    end

function view_PathAndQuery [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 43 4 43 33] (self: t_PathAndQuery) : t_PathAndQueryModel

predicate invariant_PathAndQuery [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 56 4 56 30] (self: t_PathAndQuery) =
  [%#spath] path_query_boundaries (view_PathAndQuery self)

predicate inv_PathAndQuery (_1: t_PathAndQuery)

axiom inv_axiom'3 [@rewrite]: forall x: t_PathAndQuery [inv_PathAndQuery x]. inv_PathAndQuery x
    = (invariant_PathAndQuery x /\ inv_ByteStr x.data'0)

predicate inv_Uri (_1: t_Uri)

axiom inv_axiom'4 [@rewrite]: forall x: t_Uri [inv_Uri x]. inv_Uri x
    = (inv_Scheme x.scheme /\ inv_Authority x.authority /\ inv_PathAndQuery x.path_and_query)

predicate invariant_ref_Uri [@inline:trivial] (self: t_Uri) = [%#sinvariant] inv_Uri self

