axiom seq_eq_u8_int_view_transport_spec [@useraxiom] :
  forall left_bytes:seq t18, right_bytes:seq t18, right_integers:seq int.
   length right_bytes = length right_integers ->
   (forall i:int.
     infix_lseq 0 i /\ infix_ls i (length right_bytes) ->
     tqtint1 (get right_bytes i) = get right_integers i) ->
   seq_eq_u8_int_view_transport left_bytes right_bytes right_integers

axiom seq_eq_u8_int_view_transport_specqt0 [@useraxiom] :
  forall left_bytes:seq t18, right_bytes:seq t18, right_integers:seq int.
   length right_bytes = length right_integers ->
   (forall i:int.
     infix_lseq 0 i /\ infix_ls i (length right_bytes) ->
     tqtint1 (get right_bytes i) = get right_integers i) ->
