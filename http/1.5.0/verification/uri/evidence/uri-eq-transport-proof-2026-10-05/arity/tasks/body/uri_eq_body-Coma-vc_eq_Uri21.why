function uri_comparison_model (model:t_UriModel) : t_UriCompareModel =
  T_UriCompareModelqtmk (uri_scheme_comparison_model (model.schemeqt0))
  (uri_ascii_fold_bytes (model.authorityqt0))
  (if uri_model_has_path model
   then path_component_bytes (model.path_and_queryqt0) else empty: seq t18)
  match (model.path_and_queryqt0).query with
  | Noneqt1 -> Noneqt8
  | Someqt1 offset ->
      Someqt8
      (mixfix_lbdtdtrb ((model.path_and_queryqt0).bytes) (infix_pl offset 1)
       (length ((model.path_and_queryqt0).bytes)))
  end

predicate uri_models_equal (left:t_UriModel) (right:t_UriModel) =
  uri_comparison_model left = uri_comparison_model right

