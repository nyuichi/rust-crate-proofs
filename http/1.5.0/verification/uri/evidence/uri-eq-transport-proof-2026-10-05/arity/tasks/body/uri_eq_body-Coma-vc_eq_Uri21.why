predicate eq_sub_bv t19 t19 t19 t19

axiom eq_sub_bv_def :
  forall a:t19, b:t19, i:t19, n:t19.
   let mask = lsl_bv (sub2 (lsl_bv one3 n) one3) i in
   eq_sub_bv a b i n <-> bw_and2 b mask = bw_and2 a mask

(* meta remove_unused:dependency prop eq_sub_bv_def, predicate eq_sub_bv *)

predicate eq_sub (a:t19) (b:t19) (i:int) (n:int) =
  forall j:int.
   infix_lseq i j /\ infix_ls j (infix_pl i n) -> nth2 a j = nth2 b j

axiom eq_sub_equiv :
  forall a:t19, b:t19, i:t19, n:t19.
   eq_sub a b (tqtint2 i) (tqtint2 n) <-> eq_sub_bv a b i n

(* meta remove_unused:dependency prop eq_sub_equiv, predicate eq_sub_bv *)

(* meta remove_unused:dependency prop eq_sub_equiv, predicate eq_sub *)

predicate infix_eqeq1 (v1:t19) (v2:t19) = eq_sub v1 v2 0 size

axiom Extensionality [@W:non_conservative_extension:N] :
  forall x:t19, y:t19 [infix_eqeq1 x y]. infix_eqeq1 x y -> x = y

