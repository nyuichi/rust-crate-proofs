(* use int.Int *)

function abs (x:int) : int = if infix_gteq x 0 then x else prefix_mn x

axiom Abs_le :
  forall x:int, y:int.
   infix_lseq (abs x) y <-> infix_lseq (prefix_mn y) x /\ infix_lseq x y

(* meta remove_unused:dependency prop Abs_le, function abs *)

axiom Abs_pos : forall x:int. infix_gteq (abs x) 0

(* meta remove_unused:dependency prop Abs_pos, function abs *)

(* use int.Abs *)

function div int int : int

function mod int int : int

axiom Div_mod [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div x y)) (mod x y)

(* meta remove_unused:dependency prop Div_mod, function div *)

(* meta remove_unused:dependency prop Div_mod, function mod *)

axiom Div_bound [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div x y) /\ infix_lseq (div x y) x

(* meta remove_unused:dependency prop Div_bound, function div *)

(* meta remove_unused:dependency prop Div_bound, function mod *)

axiom Mod_bound [@useraxiom] :
  forall x:int, y:int.
   not y = 0 ->
   infix_ls (prefix_mn (abs y)) (mod x y) /\ infix_ls (mod x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound, function div *)

(* meta remove_unused:dependency prop Mod_bound, function mod *)

axiom Div_sign_pos [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 -> infix_gteq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_pos, function div *)

(* meta remove_unused:dependency prop Div_sign_pos, function mod *)

axiom Div_sign_neg [@useraxiom] :
  forall x:int, y:int.
   infix_lseq x 0 /\ infix_gt y 0 -> infix_lseq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_neg, function div *)

(* meta remove_unused:dependency prop Div_sign_neg, function mod *)

axiom Mod_sign_pos [@useraxiom] :
  forall x:int, y:int. infix_gteq x 0 /\ not y = 0 -> infix_gteq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_pos, function div *)

(* meta remove_unused:dependency prop Mod_sign_pos, function mod *)

axiom Mod_sign_neg [@useraxiom] :
  forall x:int, y:int. infix_lseq x 0 /\ not y = 0 -> infix_lseq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_neg, function div *)

(* meta remove_unused:dependency prop Mod_sign_neg, function mod *)

axiom Rounds_toward_zero :
  forall x:int, y:int.
   not y = 0 -> infix_lseq (abs (infix_as (div x y) y)) (abs x)

(* meta remove_unused:dependency prop Rounds_toward_zero, function div *)

(* meta remove_unused:dependency prop Rounds_toward_zero, function mod *)

axiom Div_1 : forall x:int. div x 1 = x

(* meta remove_unused:dependency prop Div_1, function div *)

(* meta remove_unused:dependency prop Div_1, function mod *)

axiom Mod_1 : forall x:int. mod x 1 = 0

(* meta remove_unused:dependency prop Mod_1, function div *)

(* meta remove_unused:dependency prop Mod_1, function mod *)

axiom Div_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> div x y = 0

(* meta remove_unused:dependency prop Div_inf, function div *)

(* meta remove_unused:dependency prop Div_inf, function mod *)

axiom Mod_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> mod x y = x

(* meta remove_unused:dependency prop Mod_inf, function div *)

(* meta remove_unused:dependency prop Mod_inf, function mod *)

axiom Div_mult :
  forall x:int, y:int, z:int [div (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   div (infix_pl (infix_as x y) z) x = infix_pl y (div z x)

(* meta remove_unused:dependency prop Div_mult, function div *)

(* meta remove_unused:dependency prop Div_mult, function mod *)

axiom Mod_mult :
  forall x:int, y:int, z:int [mod (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   mod (infix_pl (infix_as x y) z) x = mod z x

(* meta remove_unused:dependency prop Mod_mult, function div *)

(* meta remove_unused:dependency prop Mod_mult, function mod *)

(* use int.ComputerDivision *)

(* use mach.int.Int1 *)

type t17 = <range 0 65535>

function tqtint t17 : int

constant tqtmaxInt : int = 65535

constant tqtminInt : int = 0

predicate tqteq (a:t17) (b:t17) = tqtint a = tqtint b

axiom tqtinj [@W:non_conservative_extension:N] :
  forall a:t17, b:t17. tqteq a b -> a = b

(* meta range_type type t17, function tqtint *)

(* meta model_projection function tqtint *)

(* meta remove_unused:dependency prop tqtinj, predicate tqteq *)

constant two_power_size : int = 0x10000

axiom extensionality [@useraxiom] :
  forall x:t17, y:t17 [tqtint x, tqtint y]. tqtint x = tqtint y -> x = y

predicate in_bounds [@inline:trivial] (n:int) =
  infix_lseq 0 n /\ infix_lseq n 0xFFFF

function of_int int : t17

axiom to_of_int [@useraxiom] :
  forall x:int [of_int x]. in_bounds x -> tqtint (of_int x) = x

function add t17 t17 : t17

axiom add_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [add x y].
   in_bounds (infix_pl (tqtint x) (tqtint y)) ->
   tqtint (add x y) = infix_pl (tqtint x) (tqtint y)

axiom add_wrapping [@useraxiom] :
  forall x:t17, y:t17 [add x y].
   exists k:int.
    tqtint (add x y) =
    infix_pl (infix_pl (tqtint x) (tqtint y)) (infix_as k two_power_size)

function sub t17 t17 : t17

axiom sub_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [sub x y].
   in_bounds (infix_mn (tqtint x) (tqtint y)) ->
   tqtint (sub x y) = infix_mn (tqtint x) (tqtint y)

axiom sub_wrapping [@useraxiom] :
  forall x:t17, y:t17 [sub x y].
   exists k:int.
    tqtint (sub x y) =
    infix_pl (infix_mn (tqtint x) (tqtint y)) (infix_as k two_power_size)

function mul t17 t17 : t17

axiom mul_in_bounds [@useraxiom] :
  forall x:t17, y:t17 [mul x y].
   in_bounds (infix_as (tqtint x) (tqtint y)) ->
   tqtint (mul x y) = infix_as (tqtint x) (tqtint y)

axiom mul_wrapping [@useraxiom] :
  forall x:t17, y:t17 [mul x y].
   exists k:int.
    tqtint (mul x y) =
    infix_pl (infix_as (tqtint x) (tqtint y)) (infix_as k two_power_size)

function neg t17 : t17

axiom neg_zero [@useraxiom] :
  forall x:t17 [neg x]. tqtint x = 0 -> tqtint (neg x) = 0

axiom neg_not_zero [@useraxiom] :
  forall x:t17 [neg x].
   infix_ls 0 (tqtint x) /\ infix_lseq (tqtint x) 0xFFFF ->
   tqtint (neg x) = infix_mn two_power_size (tqtint x)

function of_bool [@inline:trivial] (b:bool) : t17 =
  if b = True then (1:t17) else (0:t17)

predicate le [@inline:trivial] (a:t17) (b:t17) =
  infix_lseq (tqtint a) (tqtint b)

predicate lt [@inline:trivial] (a:t17) (b:t17) =
  infix_ls (tqtint a) (tqtint b)

predicate ge [@inline:trivial] (a:t17) (b:t17) =
  infix_gteq (tqtint a) (tqtint b)

predicate gt [@inline:trivial] (a:t17) (b:t17) =
  infix_gt (tqtint a) (tqtint b)

function bw_and t17 t17 : t17

function bw_or t17 t17 : t17

function bw_xor t17 t17 : t17

function bw_not t17 : t17

function shl t17 t17 : t17

function shr t17 t17 : t17

function nth t17 int : bool

type tuple2 'a 'a1 =
  | Tuple2 [@builtin] 'a 'a1

(* use why3.Tuple2.Tuple21 *)

function add_with_overflow (a:t17) (b:t17) : (t17, bool) = (add a b,
  if not in_bounds (infix_pl (tqtint a) (tqtint b)) then True else False)

function sub_with_overflow (a:t17) (b:t17) : (t17, bool) = (sub a b,
  if not in_bounds (infix_mn (tqtint a) (tqtint b)) then True else False)

function mul_with_overflow (a:t17) (b:t17) : (t17, bool) = (mul a b,
  if not in_bounds (infix_as (tqtint a) (tqtint b)) then True else False)

(* use creusot.int.UInt16 *)

type t18 = <range 0 255>

function tqtint1 t18 : int

constant tqtmaxInt1 : int = 255

constant tqtminInt1 : int = 0

predicate tqteq1 (a:t18) (b:t18) = tqtint1 a = tqtint1 b

axiom tqtinj1 [@W:non_conservative_extension:N] :
  forall a:t18, b:t18. tqteq1 a b -> a = b

(* meta range_type type t18, function tqtint1 *)

(* meta model_projection function tqtint1 *)

(* meta remove_unused:dependency prop tqtinj1, predicate tqteq1 *)

constant two_power_size1 : int = 0x100

axiom extensionality1 [@useraxiom] :
  forall x:t18, y:t18 [tqtint1 x, tqtint1 y]. tqtint1 x = tqtint1 y -> x = y

predicate in_bounds1 [@inline:trivial] (n:int) =
  infix_lseq 0 n /\ infix_lseq n 0xFF

function of_int1 int : t18

axiom to_of_int1 [@useraxiom] :
  forall x:int [of_int1 x]. in_bounds1 x -> tqtint1 (of_int1 x) = x

function add1 t18 t18 : t18

axiom add_in_bounds1 [@useraxiom] :
  forall x:t18, y:t18 [add1 x y].
   in_bounds1 (infix_pl (tqtint1 x) (tqtint1 y)) ->
   tqtint1 (add1 x y) = infix_pl (tqtint1 x) (tqtint1 y)

axiom add_wrapping1 [@useraxiom] :
  forall x:t18, y:t18 [add1 x y].
   exists k:int.
    tqtint1 (add1 x y) =
    infix_pl (infix_pl (tqtint1 x) (tqtint1 y)) (infix_as k two_power_size1)

function sub1 t18 t18 : t18

axiom sub_in_bounds1 [@useraxiom] :
  forall x:t18, y:t18 [sub1 x y].
   in_bounds1 (infix_mn (tqtint1 x) (tqtint1 y)) ->
   tqtint1 (sub1 x y) = infix_mn (tqtint1 x) (tqtint1 y)

axiom sub_wrapping1 [@useraxiom] :
  forall x:t18, y:t18 [sub1 x y].
   exists k:int.
    tqtint1 (sub1 x y) =
    infix_pl (infix_mn (tqtint1 x) (tqtint1 y)) (infix_as k two_power_size1)

function mul1 t18 t18 : t18

axiom mul_in_bounds1 [@useraxiom] :
  forall x:t18, y:t18 [mul1 x y].
   in_bounds1 (infix_as (tqtint1 x) (tqtint1 y)) ->
   tqtint1 (mul1 x y) = infix_as (tqtint1 x) (tqtint1 y)

axiom mul_wrapping1 [@useraxiom] :
  forall x:t18, y:t18 [mul1 x y].
   exists k:int.
    tqtint1 (mul1 x y) =
    infix_pl (infix_as (tqtint1 x) (tqtint1 y)) (infix_as k two_power_size1)

function neg1 t18 : t18

axiom neg_zero1 [@useraxiom] :
  forall x:t18 [neg1 x]. tqtint1 x = 0 -> tqtint1 (neg1 x) = 0

axiom neg_not_zero1 [@useraxiom] :
  forall x:t18 [neg1 x].
   infix_ls 0 (tqtint1 x) /\ infix_lseq (tqtint1 x) 0xFF ->
   tqtint1 (neg1 x) = infix_mn two_power_size1 (tqtint1 x)

function of_bool1 [@inline:trivial] (b:bool) : t18 =
  if b = True then (1:t18) else (0:t18)

predicate le1 [@inline:trivial] (a:t18) (b:t18) =
  infix_lseq (tqtint1 a) (tqtint1 b)

predicate lt1 [@inline:trivial] (a:t18) (b:t18) =
  infix_ls (tqtint1 a) (tqtint1 b)

predicate ge1 [@inline:trivial] (a:t18) (b:t18) =
  infix_gteq (tqtint1 a) (tqtint1 b)

predicate gt1 [@inline:trivial] (a:t18) (b:t18) =
  infix_gt (tqtint1 a) (tqtint1 b)

function bw_and1 t18 t18 : t18

function bw_or1 t18 t18 : t18

function bw_xor1 t18 t18 : t18

function bw_not1 t18 : t18

function shl1 t18 t18 : t18

function shr1 t18 t18 : t18

function nth1 t18 int : bool

function add_with_overflow1 (a:t18) (b:t18) : (t18, bool) = (add1 a b,
  if not in_bounds1 (infix_pl (tqtint1 a) (tqtint1 b)) then True else False)

function sub_with_overflow1 (a:t18) (b:t18) : (t18, bool) = (sub1 a b,
