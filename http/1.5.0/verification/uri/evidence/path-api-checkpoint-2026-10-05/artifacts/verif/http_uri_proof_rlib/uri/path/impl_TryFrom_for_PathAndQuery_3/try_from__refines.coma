meta "rewrite_def" predicate invariant_ref_String

predicate inv_ref_String [@inline:trivial] (_1: t_String) = invariant_ref_String _1

meta "rewrite_def" predicate inv_ref_String

type t_ByteStr

type t_PathAndQuery = { data: t_ByteStr; query: UInt16.t }

type t_ErrorKind =
  | InvalidUriChar
  | InvalidScheme
  | InvalidAuthority
  | InvalidPort
  | InvalidFormat
  | SchemeMissing
  | AuthorityMissing
  | PathAndQueryMissing
  | PathDoesNotStartWithSlash
  | TooLong
  | Empty
  | SchemeTooLong

type t_InvalidUri = { f0: t_ErrorKind }

type t_Result_PathAndQuery_InvalidUri = Ok t_PathAndQuery | Err t_InvalidUri

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t

axiom to_bytes_def: forall self: Seq.seq Char.t. to_bytes self
    = ([%#sstring'1] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (to_utf8_char (Seq.get self 0)) (to_bytes (tail_char self))
    )

axiom to_bytes_spec: forall self: Seq.seq Char.t. [%#sstring'0] to_bytes self
    = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

predicate valid_utf8 (bytes: Seq.seq UInt8.t) =
  [%#sstring'2] exists characters: Seq.seq Char.t. to_bytes characters = bytes

function view_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/byte_str.rs" 41 4 41 33] (self: t_ByteStr) : Seq.seq UInt8.t

predicate invariant_ByteStr [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/byte_str.rs" 48 4 48 30] (self: t_ByteStr) =
  [%#sbyte_str] valid_utf8 (view_ByteStr self)

predicate inv_ByteStr (_1: t_ByteStr)

axiom inv_axiom: forall x: t_ByteStr [inv_ByteStr x]. inv_ByteStr x -> invariant_ByteStr x

predicate inv_PathAndQuery (_1: t_PathAndQuery)

axiom inv_axiom'0 [@rewrite]: forall x: t_PathAndQuery [inv_PathAndQuery x]. inv_PathAndQuery x = inv_ByteStr x.data

predicate inv_Result_PathAndQuery_InvalidUri (_1: t_Result_PathAndQuery_InvalidUri)

axiom inv_axiom'1 [@rewrite]:
  forall x: t_Result_PathAndQuery_InvalidUri [inv_Result_PathAndQuery_InvalidUri x]. inv_Result_PathAndQuery_InvalidUri x
    = match x with
      | Ok f0'0 -> inv_PathAndQuery f0'0
      | Err f0'0 -> true
      end

type t_Option_Int = None | Some int

type t_PathAndQueryModel = { bytes'0: Seq.seq UInt8.t; query'0: t_Option_Int }

predicate path_projection_matches_input [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 240 0 240 86] (input: Seq.seq UInt8.t) (model: t_PathAndQueryModel) =
  [%#spath'2] let end' = Seq.length model.bytes'0 in end' <= Seq.length input
  /\ (end' = Seq.length input \/ UInt8.t'int (Seq.get input end') = 35)
  /\ (forall i: int. 0 <= i /\ i < end' -> UInt8.t'int (Seq.get input i) <> 35)
  /\ model.bytes'0 = Seq.([..]) input 0 end'
  /\ match model.query'0 with
    | None -> forall i: int. 0 <= i /\ i < end' -> UInt8.t'int (Seq.get input i) <> 63
    | Some query'1 -> 0 <= query'1
    /\ query'1 < end'
    /\ UInt8.t'int (Seq.get input query'1) = 63
    /\ (forall i: int. 0 <= i /\ i < query'1 -> UInt8.t'int (Seq.get input i) <> 63)
    end

function view_String (self: t_String) : Seq.seq Char.t

constant const_NONE: UInt16.t = [%#spath'5] (65535: UInt16.t)

function view_PathAndQuery [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 42 4 42 33] (self: t_PathAndQuery) : t_PathAndQueryModel
 = [%#spath'3] { bytes'0 = view_ByteStr self.data;
                 query'0 = (if self.query = const_NONE then None else Some (UInt16.t'int self.query)) }

predicate path_query_boundaries [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/path.rs" 214 0 214 62] (model: t_PathAndQueryModel) =
  [%#spath'4] match model.query'0 with
    | None -> true
    | Some query'1 -> 0 <= query'1
    /\ query'1 < Seq.length model.bytes'0 /\ UInt8.t'int (Seq.get model.bytes'0 query'1) = 63
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall value: t_String. ([%#sconvert] inv_ref_String value)
    -> ([%#spath] inv_ref_String value)
    /\ (forall result: t_Result_PathAndQuery_InvalidUri. ([%#spath'0] inv_Result_PathAndQuery_InvalidUri result)
        /\ ([%#spath'1] match result with
          | Ok value'0 -> path_projection_matches_input (to_bytes (view_String value)) (view_PathAndQuery value'0)
          /\ path_query_boundaries (view_PathAndQuery value'0)
          | Err _ -> true
          end) -> inv_Result_PathAndQuery_InvalidUri result)
