let rec len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int. [%#sseq'1] forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function authority_fold_ascii_byte [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/authority.rs" 848 0 848 50] (byte: int) : int
 = [%#sauthority'26] if 65 <= byte /\ byte <= 90 then byte + 32 else byte

function authority_folded_bytes [#"/workspace/rust-crate-proofs/http/1.5.0/verification/uri/src/../../../src/uri/authority.rs" 856 0 856 57] (bytes: Seq.seq UInt8.t) : Seq.seq int
 = [%#sauthority'24] map_u8 bytes (fun (byte: UInt8.t) -> authority_fold_ascii_byte (UInt8.t'int byte))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

