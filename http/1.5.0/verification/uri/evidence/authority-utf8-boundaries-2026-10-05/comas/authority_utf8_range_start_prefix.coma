                                                                                                                                                                                                                                  f1 = chars }
      else
        let tail_offset = offset
        - head_len in let split = prefix_at_ascii_byte tail tail_offset in let _ = concat (Seq.singleton head) split.f0 in let _ = seq_head_tail_char chars in let _ = seq_concat_assoc_char (Seq.singleton head) split.f0 split.f1 in let prefix = Seq.(++) (Seq.singleton head) split.f0 in let suffix = split.f1 in let _ = seq_concat_halves_char prefix suffix in let _ = concat prefix suffix in let _ = seq_concat_halves_u8 (to_bytes prefix) (to_bytes suffix) in { f0 = prefix;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                             f1 = suffix }
    
    )

axiom prefix_at_ascii_byte_spec: forall chars: Seq.seq Char.t, offset: int. ([%#sstr_index'9] 0 <= offset
