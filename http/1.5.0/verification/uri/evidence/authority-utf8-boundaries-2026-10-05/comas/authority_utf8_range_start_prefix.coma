function prefix_at_ascii_byte (chars: Seq.seq Char.t) (offset: int) : tup2_Seq_char_Seq_char

axiom prefix_at_ascii_byte_def: forall chars: Seq.seq Char.t, offset: int. ([%#sstr_index'9] 0 <= offset
      /\ offset < Seq.length (to_bytes chars))
