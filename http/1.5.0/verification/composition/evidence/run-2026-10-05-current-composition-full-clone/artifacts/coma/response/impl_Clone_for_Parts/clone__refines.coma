(* <response::Parts as std::clone::Clone> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 85 8 85 18
let%span sclone = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/clone.rs" 14 26 14 30
let%span sresponse = "/workspace/rust-crate-proofs/http/1.5.0/verification/composition/src/../../../src/response.rs" 207 14 207 18
let%span sresponse'0 = "/workspace/rust-crate-proofs/http/1.5.0/verification/composition/src/../../../src/response.rs" 207 23 207 28

type t_StatusCode

type t_Version

type t_HeaderMap_HeaderValue

type t_Extensions

type t_Parts = {
  status: t_StatusCode;
  version: t_Version;
  headers: t_HeaderMap_HeaderValue;
  extensions: t_Extensions;
  _priv: () }

predicate inv_StatusCode (_1: t_StatusCode)

predicate inv_Version (_1: t_Version)

predicate inv_HeaderMap_HeaderValue (_1: t_HeaderMap_HeaderValue)

predicate inv_Extensions (_1: t_Extensions)

predicate inv_Parts (_1: t_Parts)

axiom inv_axiom [@rewrite]: forall x: t_Parts [inv_Parts x]. inv_Parts x
    = (inv_StatusCode x.status
    /\ inv_Version x.version /\ inv_HeaderMap_HeaderValue x.headers /\ inv_Extensions x.extensions)

predicate invariant_ref_Parts [@inline:trivial] (self: t_Parts) = [%#sinvariant] inv_Parts self

meta "rewrite_def" predicate invariant_ref_Parts

predicate inv_ref_Parts [@inline:trivial] (_1: t_Parts) = invariant_ref_Parts _1

meta "rewrite_def" predicate inv_ref_Parts

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Parts. ([%#sclone] inv_ref_Parts self_)
    -> ([%#sresponse] inv_ref_Parts self_)
    /\ (forall result: t_Parts. ([%#sresponse'0] inv_Parts result) -> inv_Parts result)
