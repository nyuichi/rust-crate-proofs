(* <response::Response<T> as std::clone::Clone> *)

let%span sinvariant = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/invariant.rs" 85 8 85 18
let%span sclone = "/workspace/rust-crate-proofs/creusot-libs/creusot-std/src/std/clone.rs" 14 26 14 30
let%span sresponse = "/workspace/rust-crate-proofs/http/1.5.0/verification/composition/src/../../../src/response.rs" 179 9 179 14
let%span sresponse'0 = "/workspace/rust-crate-proofs/http/1.5.0/verification/composition/src/../../../src/response.rs" 179 9 179 14

type t_StatusCode

type t_Version

type t_HeaderMap_HeaderValue

type t_Extensions

type t_Parts = {
  status: t_StatusCode;
  version: t_Version;
  headers: t_HeaderMap_HeaderValue;
  extensions: t_Extensions;
  _priv: () }

type t_T

type t_Response_T = { head: t_Parts; body: t_T }

predicate inv_StatusCode (_1: t_StatusCode)

predicate inv_Version (_1: t_Version)

predicate inv_HeaderMap_HeaderValue (_1: t_HeaderMap_HeaderValue)

predicate inv_Extensions (_1: t_Extensions)

predicate inv_Parts (_1: t_Parts)

axiom inv_axiom [@rewrite]: forall x: t_Parts [inv_Parts x]. inv_Parts x
    = (inv_StatusCode x.status
    /\ inv_Version x.version /\ inv_HeaderMap_HeaderValue x.headers /\ inv_Extensions x.extensions)

predicate inv_T (_1: t_T)

predicate inv_Response_T (_1: t_Response_T)

axiom inv_axiom'0 [@rewrite]: forall x: t_Response_T [inv_Response_T x]. inv_Response_T x
    = (inv_Parts x.head /\ inv_T x.body)

predicate invariant_ref_Response_T [@inline:trivial] (self: t_Response_T) = [%#sinvariant] inv_Response_T self

meta "rewrite_def" predicate invariant_ref_Response_T

predicate inv_ref_Response_T [@inline:trivial] (_1: t_Response_T) = invariant_ref_Response_T _1

meta "rewrite_def" predicate inv_ref_Response_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Response_T. ([%#sclone] inv_ref_Response_T self_)
    -> ([%#sresponse] inv_ref_Response_T self_)
    /\ (forall result: t_Response_T. ([%#sresponse'0] inv_Response_T result) -> inv_Response_T result)
