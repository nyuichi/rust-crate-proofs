use creusot.prelude.MutBorrow
use seq.Seq

type t_StatusCode

type t_Version

type t_HeaderMap_HeaderValue

type t_Extensions

type t_Parts = {
  status: t_StatusCode;
  version: t_Version;
  headers: t_HeaderMap_HeaderValue;
  extensions: t_Extensions;
  _priv: () }

type t_T

type t_Response_T = { head: t_Parts; body: t_T }

predicate inv_StatusCode (_1: t_StatusCode)

predicate inv_Version (_1: t_Version)

predicate inv_HeaderMap_HeaderValue (_1: t_HeaderMap_HeaderValue)

predicate inv_Extensions (_1: t_Extensions)

predicate inv_Parts (_1: t_Parts)

axiom inv_axiom [@rewrite]: forall x: t_Parts [inv_Parts x]. inv_Parts x
    = (inv_StatusCode x.status
    /\ inv_Version x.version /\ inv_HeaderMap_HeaderValue x.headers /\ inv_Extensions x.extensions)

predicate inv_T (_1: t_T)

predicate inv_Response_T (_1: t_Response_T)

axiom inv_axiom'0 [@rewrite]: forall x: t_Response_T [inv_Response_T x]. inv_Response_T x
    = (inv_Parts x.head /\ inv_T x.body)

predicate invariant_ref_Response_T [@inline:trivial] (self: t_Response_T) = [%#sinvariant] inv_Response_T self

meta "rewrite_def" predicate invariant_ref_Response_T

predicate inv_ref_Response_T [@inline:trivial] (_1: t_Response_T) = invariant_ref_Response_T _1

meta "rewrite_def" predicate inv_ref_Response_T

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant'0] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

predicate formatter_extends (before: Seq.seq int) (after: Seq.seq int) =
  [%#sfmt'2] exists suffix: Seq.seq int. after = Seq.(++) before suffix

function deep_model_Formatter (self: t_Formatter) : Seq.seq int

function deep_model_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) : Seq.seq int =
  [%#smodel] deep_model_Formatter self.current

meta "rewrite_def" function deep_model_refmut_Formatter

type t_Result_unit_Error = Ok () | Err ()

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Response_T. forall formatter: MutBorrow.t t_Formatter. ([%#sfmt] inv_ref_Response_T self_)
