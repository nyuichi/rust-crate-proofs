function method_model_text [#"/workspace/rust-crate-proofs/http/1.5.0/verification/composition/src/../../../src/method.rs" 275 0 275 56] (method'0: t_MethodModel) : Seq.seq UInt8.t
 = [%#smethod'6] match method'0 with
    | Options -> Seq.create 7 [|(79: UInt8.t);(80: UInt8.t);(84: UInt8.t);(73: UInt8.t);(79: UInt8.t);(78: UInt8.t);(83: UInt8.t)|]
    | Get -> Seq.create 3 [|(71: UInt8.t);(69: UInt8.t);(84: UInt8.t)|]
    | Post -> Seq.create 4 [|(80: UInt8.t);(79: UInt8.t);(83: UInt8.t);(84: UInt8.t)|]
    | Put -> Seq.create 3 [|(80: UInt8.t);(85: UInt8.t);(84: UInt8.t)|]
    | Delete -> Seq.create 6 [|(68: UInt8.t);(69: UInt8.t);(76: UInt8.t);(69: UInt8.t);(84: UInt8.t);(69: UInt8.t)|]
    | Head -> Seq.create 4 [|(72: UInt8.t);(69: UInt8.t);(65: UInt8.t);(68: UInt8.t)|]
    | Trace -> Seq.create 5 [|(84: UInt8.t);(82: UInt8.t);(65: UInt8.t);(67: UInt8.t);(69: UInt8.t)|]
    | Connect -> Seq.create 7 [|(67: UInt8.t);(79: UInt8.t);(78: UInt8.t);(78: UInt8.t);(69: UInt8.t);(67: UInt8.t);(84: UInt8.t)|]
    | Patch -> Seq.create 5 [|(80: UInt8.t);(65: UInt8.t);(84: UInt8.t);(67: UInt8.t);(72: UInt8.t)|]
    | Query -> Seq.create 5 [|(81: UInt8.t);(85: UInt8.t);(69: UInt8.t);(82: UInt8.t);(89: UInt8.t)|]
    | ExtensionInline data len -> Seq.([..]) data 0 len
