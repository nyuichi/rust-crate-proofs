      /\ (forall result: t_Result_unit_Error. ([%#srequest'1] formatter_extends (deep_model_refmut_Formatter formatter) (deep_model_Formatter formatter.final))
        -> ([%#sfmt'1] formatter_extends (deep_model_refmut_Formatter formatter) (deep_model_Formatter formatter.final)))
