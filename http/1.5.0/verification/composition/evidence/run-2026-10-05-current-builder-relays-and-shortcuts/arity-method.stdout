function mixfix_lbdtdtrb (seq 'a) int int : seq 'a

axiom mixfix_lbdtdtrbqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   mixfix_lbdtdtrb s i j =
   create (infix_mn j i) (fun (k:int) -> mixfix_lbrb s (infix_pl i k))

axiom mixfix_lbdtdtrbqtspecqt0 [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   ([@hyp_name:Ensures] length (mixfix_lbdtdtrb s i j) = infix_mn j i)

axiom mixfix_lbdtdtrbqtspec [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, j:int.
   ([@hyp_name:Requires]
    infix_lseq 0 i /\ infix_lseq i j /\ infix_lseq j (length s)) ->
   ([@hyp_name:Ensures]
    forall k:int.
     infix_lseq 0 k /\ infix_ls k (infix_mn j i) ->
     mixfix_lbrb (mixfix_lbdtdtrb s i j) k = mixfix_lbrb s (infix_pl i k))

