type t_InvalidUriParts

type t_InvalidHeaderName

type t_InvalidHeaderValue

type t_MaxSizeReached

type t_ErrorKind =
  | StatusCode t_InvalidStatusCode
  | Method t_InvalidMethod
  | Uri t_InvalidUri
  | UriParts t_InvalidUriParts
  | HeaderName t_InvalidHeaderName
  | HeaderValue t_InvalidHeaderValue
  | MaxSizeReached t_MaxSizeReached

type t_Errorqt0 =
  | T_Errorqt0qtmk [@builtin] (inner:t_ErrorKind)

(* meta model_record function inner *)

predicate precondition_into unit t_Error

axiom precondition_fndefqt0 [@useraxiom] :
  forall args:t_Error [precondition_into () args].
   (let self_ = args in inv_Error self_) -> precondition_into () args

predicate inv_InvalidStatusCode t_InvalidStatusCode

predicate inv_InvalidMethod t_InvalidMethod

predicate inv_InvalidUri t_InvalidUri

predicate inv_InvalidUriParts t_InvalidUriParts

predicate inv_InvalidHeaderName t_InvalidHeaderName

predicate inv_InvalidHeaderValue t_InvalidHeaderValue

predicate inv_MaxSizeReached t_MaxSizeReached

predicate inv_ErrorKind t_ErrorKind

axiom inv_axiomqt2 [@useraxiom] [@rewrite] :
  forall x:t_ErrorKind [inv_ErrorKind x].
   inv_ErrorKind x <->
   match x with
   | StatusCode f0 -> inv_InvalidStatusCode f0
   | Method f0 -> inv_InvalidMethod f0
   | Uri f0 -> inv_InvalidUri f0
   | UriParts f0 -> inv_InvalidUriParts f0
   | HeaderName f0 -> inv_InvalidHeaderName f0
   | HeaderValue f0 -> inv_InvalidHeaderValue f0
   | MaxSizeReached f0 -> inv_MaxSizeReached f0
   end

predicate inv_Errorqt0 t_Errorqt0

axiom inv_axiomqt3 [@useraxiom] [@rewrite] :
  forall x:t_Errorqt0 [inv_Errorqt0 x].
   inv_Errorqt0 x <-> inv_ErrorKind (x.inner)

predicate postcondition_once_into unit t_Error t_Errorqt0

axiom postcondition_fndefqt0 [@useraxiom] :
  forall args:t_Error, res:t_Errorqt0 [postcondition_once_into () args res].
   postcondition_once_into () args res ->
   (let self_ = args in inv_Errorqt0 res)

