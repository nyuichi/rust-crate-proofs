     ([@stop_split] [@hyp_name:Assert] [@expl:try_into ensures]
      postcondition_once_try_into () (self.c0) result) ->
     (forall x0:t_Method.
       ([@stop_split] [@hyp_name:Assert] result = Ok x0) ->
       (forall f0:t_Method.
         ([@stop_split] [@hyp_name:Assert] Ok f0 = result) ->
         ([@stop_split] [@hyp_name:Assert]
          [@expl:closure result type invariant]
          inv_Result_Parts_Error
          (Okqt0
           (T_Partsqtmk f0 (head.uri) (head.version) (head.headers)
            (head.extensions) (head.uspriv))))) /\
       ([@stop_split] [@hyp_name:Assert] [@expl:elim Ok]
        match result with
        | Ok _ -> true
        | _ -> false
        end)) /\
     (forall x0:t_Error.
       ([@stop_split] [@hyp_name:Assert] result = Err x0) ->
       (([@stop_split] [@hyp_name:Assert] resolve_Parts head) ->
        (forall f0:t_Error.
          ([@stop_split] [@hyp_name:Assert] Err f0 = result) ->
          ([@stop_split] [@hyp_name:Assert] [@expl:into requires]
           precondition_into () f0) /\
          (forall result1 [@field:0:inner]:t_ErrorKind.
            let result2 = T_Errorqt0qtmk result1 in
            ([@stop_split] [@hyp_name:Assert] [@expl:into ensures]
             postcondition_once_into () f0 result2) ->
            ([@stop_split] [@hyp_name:Assert]
             [@expl:closure result type invariant]
             inv_Result_Parts_Error (Errqt0 result2)))) /\
        ([@stop_split] [@hyp_name:Assert] [@expl:elim Err]
         match result with
         | Err _ -> true
         | _ -> false
         end)) /\
       ([@stop_split] [@expl:type invariant] [@hyp_name:Assert]
        inv_Parts head)))) /\
  ([@stop_split] [@expl:type invariant] [@hyp_name:Assert]
   inv_Method (head.method))

predicate closure0qtpostqtreturn (self:closure0) (head:t_Parts) (x:
  t_Result_Parts_Error) =
  ([@stop_split] [@hyp_name:Assert] [@expl:closure0 requires]
   ([@stop_split] [@expl:closure 'self' type invariant] inv_closure0 self) /\
   ([@stop_split] [@expl:closure 'head' type invariant] inv_Parts head)) /\
  ([@stop_split] [@hyp_name:Assert] resolve_Method (head.method)) /\
  (exists result:t_Result_Method_Error.
