(* meta encoding:ignore_polymorphism_ls predicate infix_eq *)

goal vc_method_T :
  forall self [@field:0:inner'0]:t_Result_Parts_Error, methodqt0:t_T.
   let self1 = T_Builderqtmk self in
   ([@stop_split] [@hyp_name:Assert] [@expl:method_T requires]
    ([@stop_split] [@expl:method 'self' type invariant] inv_Builder self1) /\
    ([@stop_split] [@expl:method 'method' type invariant] inv_T methodqt0) /\
    ([@stop_split] [@expl:method requires]
     not request_builder_is_valid self1 \/
     precondition_try_into () methodqt0 /\
     (forall e:t_Error.
       postcondition_try_into () methodqt0 (Err e) -> precondition_into () e))) ->
   ([@stop_split] [@hyp_name:Assert] [@expl:and_then_closure0 requires]
    ([@stop_split] [@expl:and_then 'self' type invariant] inv_Builder self1) /\
    ([@stop_split] [@expl:and_then 'func' type invariant]
     inv_closure0 (Closure0qtmk methodqt0)) /\
    ([@stop_split] [@expl:and_then requires]
     match self with
     | Okqt0 head -> precondition_closure0 (Closure0qtmk methodqt0) head
     | Errqt0 _ -> true
     end)) /\
   (forall result [@field:0:inner'0]:t_Result_Parts_Error.
     let result1 = T_Builderqtmk result in
     ([@stop_split] [@hyp_name:Assert] [@expl:and_then_closure0 ensures]
      ([@stop_split] [@expl:and_then result type invariant]
       inv_Builder result1) /\
      ([@stop_split] [@expl:and_then ensures]
       match self with
       | Okqt0 head ->
           postcondition_once_closure0 (Closure0qtmk methodqt0) head result
       | Errqt0 _ ->
           request_builder_error result1 = request_builder_error self1
       end)) ->
     ([@stop_split] [@hyp_name:Assert] [@expl:method_T ensures]
      ([@stop_split] [@expl:method result type invariant] inv_Builder result1) /\
      ([@stop_split] [@expl:method ensures #0]
       not request_builder_is_valid self1 ->
       request_builder_error result1 = request_builder_error self1) /\
      ([@stop_split] [@expl:method ensures #1]
       request_builder_is_valid self1 ->
       (exists converted:t_Result_Method_Error.
         postcondition_try_into () methodqt0 converted /\
         match converted with
         | Ok new_method ->
             request_builder_is_valid result1 /\
             request_builder_method result1 = Someqt0 new_method /\
             request_builder_error result1 = None /\
             request_builder_uri result1 = request_builder_uri self1 /\
             request_builder_version result1 = request_builder_version self1 /\
             request_builder_headers result1 = request_builder_headers self1 /\
             request_builder_extensions result1 =
             request_builder_extensions self1
         | Err conversion_error ->
             not request_builder_is_valid result1 /\
             request_builder_error_is_from_Error result1 conversion_error /\
             request_builder_method result1 = Noneqt0 /\
             request_builder_uri result1 = Noneqt1 /\
             request_builder_version result1 = Noneqt2 /\
             request_builder_headers result1 = Noneqt3 /\
             request_builder_extensions result1 = Noneqt4
         end))))

end
