axiom ZeroLessOne : infix_lseq zero one

axiom CompatOrderAdd :
  forall x:int, y:int, z:int.
   infix_lseq x y -> infix_lseq (infix_pl x z) (infix_pl y z)

axiom CompatOrderMult :
