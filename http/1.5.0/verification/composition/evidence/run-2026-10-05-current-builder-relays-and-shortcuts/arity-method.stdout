predicate inv_T t_T

predicate precondition_try_into unit t_T

axiom precondition_fndef [@useraxiom] :
  forall args:t_T [precondition_try_into () args].
   (let self_ = args in inv_T self_) -> precondition_try_into () args

predicate inv_Error t_Error

predicate inv_Result_Method_Error t_Result_Method_Error

axiom inv_axiomqt0 [@useraxiom] [@rewrite] :
  forall x:t_Result_Method_Error [inv_Result_Method_Error x].
   inv_Result_Method_Error x <->
   match x with
   | Ok f0 -> inv_Method f0
   | Err f0 -> inv_Error f0
   end

predicate postcondition_once_try_into unit t_T t_Result_Method_Error

axiom postcondition_fndef [@useraxiom] :
  forall args:t_T, res:t_Result_Method_Error
   [postcondition_once_try_into () args res].
   postcondition_once_try_into () args res ->
   (let self_ = args in inv_Result_Method_Error res)

predicate inv_Uri t_Uri

predicate inv_Version t_Version

predicate inv_HeaderMap_HeaderValue t_HeaderMap_HeaderValue

predicate inv_Extensions t_Extensions

predicate inv_Parts t_Parts

axiom inv_axiomqt1 [@useraxiom] [@rewrite] :
  forall x:t_Parts [inv_Parts x].
   inv_Parts x <->
   inv_Method (x.method) /\
   inv_Uri (x.uri) /\
   inv_Version (x.version) /\
   inv_HeaderMap_HeaderValue (x.headers) /\ inv_Extensions (x.extensions)

predicate resolve_Uri t_Uri

predicate resolve_Version t_Version

predicate resolve_HeaderMap_HeaderValue t_HeaderMap_HeaderValue

predicate resolve_Extensions t_Extensions

predicate resolve_Parts t_Parts

axiom resolve_axiom [@useraxiom] [@rewrite] :
  forall x:t_Parts [resolve_Parts x].
   resolve_Parts x <->
   resolve_Method (x.method) /\
   resolve_Uri (x.uri) /\
   resolve_Version (x.version) /\
   resolve_HeaderMap_HeaderValue (x.headers) /\
   resolve_Extensions (x.extensions)

type t_InvalidStatusCode

type t_InvalidMethod

