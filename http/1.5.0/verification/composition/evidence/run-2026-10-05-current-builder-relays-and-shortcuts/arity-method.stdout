function div int int : int

function mod int int : int

axiom Div_mod [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div x y)) (mod x y)

(* meta remove_unused:dependency prop Div_mod, function div *)

(* meta remove_unused:dependency prop Div_mod, function mod *)

axiom Div_bound [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div x y) /\ infix_lseq (div x y) x

(* meta remove_unused:dependency prop Div_bound, function div *)

(* meta remove_unused:dependency prop Div_bound, function mod *)

axiom Mod_bound [@useraxiom] :
  forall x:int, y:int.
   not y = 0 ->
   infix_ls (prefix_mn (abs y)) (mod x y) /\ infix_ls (mod x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound, function div *)

(* meta remove_unused:dependency prop Mod_bound, function mod *)

axiom Div_sign_pos [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 -> infix_gteq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_pos, function div *)

(* meta remove_unused:dependency prop Div_sign_pos, function mod *)

axiom Div_sign_neg [@useraxiom] :
  forall x:int, y:int.
   infix_lseq x 0 /\ infix_gt y 0 -> infix_lseq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_neg, function div *)

(* meta remove_unused:dependency prop Div_sign_neg, function mod *)

axiom Mod_sign_pos [@useraxiom] :
  forall x:int, y:int. infix_gteq x 0 /\ not y = 0 -> infix_gteq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_pos, function div *)

(* meta remove_unused:dependency prop Mod_sign_pos, function mod *)

axiom Mod_sign_neg [@useraxiom] :
  forall x:int, y:int. infix_lseq x 0 /\ not y = 0 -> infix_lseq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_neg, function div *)

(* meta remove_unused:dependency prop Mod_sign_neg, function mod *)

axiom Rounds_toward_zero :
  forall x:int, y:int.
   not y = 0 -> infix_lseq (abs (infix_as (div x y) y)) (abs x)

(* meta remove_unused:dependency prop Rounds_toward_zero, function div *)

