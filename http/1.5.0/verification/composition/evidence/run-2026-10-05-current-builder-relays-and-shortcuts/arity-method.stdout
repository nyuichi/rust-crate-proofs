  if not in_bounds1 (infix_pl (tqtint1 a) (tqtint1 b)) then True else False)

function sub_with_overflow1 (a:t18) (b:t18) : (t18, bool) = (sub1 a b,
  if not in_bounds1 (infix_mn (tqtint1 a) (tqtint1 b)) then True else False)

function mul_with_overflow1 (a:t18) (b:t18) : (t18, bool) = (mul1 a b,
  if not in_bounds1 (infix_as (tqtint1 a) (tqtint1 b)) then True else False)

(* use creusot.int.UInt64 *)

function any_l 'a : 'b

(* use creusot.prelude.Any *)

type t_Method

type t_MethodModel =
  | Options
  | Get
  | Post
  | Put
  | Delete
  | Head
  | Trace
  | Connect
  | Patch
  | Query
  | ExtensionInline (seq t17) int
  | ExtensionAllocated (seq t17)

constant const_MAX : t18 = (15:t18)

predicate is_method_char_model (byte:t17) =
  infix_lseq 33 (tqtint byte) /\
  infix_lseq (tqtint byte) 126 /\
  not tqtint byte = 34 /\
  not tqtint byte = 40 /\
  not tqtint byte = 41 /\
  not tqtint byte = 44 /\
  not tqtint byte = 47 /\
  not tqtint byte = 58 /\
  not tqtint byte = 59 /\
  not tqtint byte = 60 /\
  not tqtint byte = 61 /\
  not tqtint byte = 62 /\
  not tqtint byte = 63 /\
  not tqtint byte = 64 /\
  not tqtint byte = 91 /\
  not tqtint byte = 92 /\
  not tqtint byte = 93 /\ not tqtint byte = 123 /\ not tqtint byte = 125

predicate all_method_chars_valid (bytes:seq t17) =
  forall i:int.
   infix_lseq 0 i /\ infix_ls i (length bytes) ->
   is_method_char_model (get bytes i)

predicate method_text_matches (left:seq t17) (right:seq t17) =
  length left = length right /\
  (forall i:int.
    infix_lseq 0 i /\ infix_ls i (length left) -> get left i = get right i)

function method_model_text (method:t_MethodModel) : seq t17 =
  match method with
  | Options ->
      create 7
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (79:t17)
        else if xqtx = 1 then (80:t17)
             else if xqtx = 2 then (84:t17)
                  else if xqtx = 3 then (73:t17)
                       else if xqtx = 4 then (79:t17)
                            else if xqtx = 5 then (78:t17)
                                 else if xqtx = 6 then (83:t17) else (83:t17))
  | Get ->
      create 3
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (71:t17)
        else if xqtx = 1 then (69:t17)
             else if xqtx = 2 then (84:t17) else (84:t17))
  | Post ->
      create 4
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (80:t17)
        else if xqtx = 1 then (79:t17)
             else if xqtx = 2 then (83:t17)
                  else if xqtx = 3 then (84:t17) else (84:t17))
  | Put ->
      create 3
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (80:t17)
        else if xqtx = 1 then (85:t17)
             else if xqtx = 2 then (84:t17) else (84:t17))
  | Delete ->
      create 6
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (68:t17)
        else if xqtx = 1 then (69:t17)
             else if xqtx = 2 then (76:t17)
                  else if xqtx = 3 then (69:t17)
                       else if xqtx = 4 then (84:t17)
                            else if xqtx = 5 then (69:t17) else (69:t17))
  | Head ->
      create 4
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (72:t17)
        else if xqtx = 1 then (69:t17)
             else if xqtx = 2 then (65:t17)
                  else if xqtx = 3 then (68:t17) else (68:t17))
  | Trace ->
      create 5
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (84:t17)
        else if xqtx = 1 then (82:t17)
             else if xqtx = 2 then (65:t17)
                  else if xqtx = 3 then (67:t17)
                       else if xqtx = 4 then (69:t17) else (69:t17))
  | Connect ->
      create 7
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (67:t17)
        else if xqtx = 1 then (79:t17)
             else if xqtx = 2 then (78:t17)
                  else if xqtx = 3 then (78:t17)
                       else if xqtx = 4 then (69:t17)
                            else if xqtx = 5 then (67:t17)
                                 else if xqtx = 6 then (84:t17) else (84:t17))
  | Patch ->
      create 5
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (80:t17)
        else if xqtx = 1 then (65:t17)
             else if xqtx = 2 then (84:t17)
                  else if xqtx = 3 then (67:t17)
                       else if xqtx = 4 then (72:t17) else (72:t17))
  | Query ->
      create 5
      ([@funlit]
       fun (xqtx:int) ->
        if xqtx = 0 then (81:t17)
        else if xqtx = 1 then (85:t17)
             else if xqtx = 2 then (69:t17)
                  else if xqtx = 3 then (82:t17)
                       else if xqtx = 4 then (89:t17) else (89:t17))
  | ExtensionInline data len -> mixfix_lbdtdtrb data 0 len
  | ExtensionAllocated data -> data
  end

predicate is_known_method_text (bytes:seq t17) =
  if length bytes = 3
  then method_text_matches bytes (method_model_text Get) \/
       method_text_matches bytes (method_model_text Put)
  else if length bytes = 4
       then method_text_matches bytes (method_model_text Post) \/
            method_text_matches bytes (method_model_text Head)
       else if length bytes = 5
            then method_text_matches bytes (method_model_text Patch) \/
                 method_text_matches bytes (method_model_text Trace) \/
                 method_text_matches bytes (method_model_text Query)
            else if length bytes = 6
                 then method_text_matches bytes (method_model_text Delete)
                 else if length bytes = 7
                      then method_text_matches bytes
                           (method_model_text Options) \/
                           method_text_matches bytes
                           (method_model_text Connect)
                      else false

predicate method_model_is_canonical (method:t_MethodModel) =
  match method with
  | ExtensionInline data len ->
      length data = tqtint1 const_MAX /\
      infix_ls 0 len /\
      infix_lseq len (tqtint1 const_MAX) /\
      all_method_chars_valid (mixfix_lbdtdtrb data 0 len) /\
      (forall i:int.
        infix_lseq len i /\ infix_ls i (length data) -> get data i = (0:t17)) /\
      not is_known_method_text (mixfix_lbdtdtrb data 0 len)
  | ExtensionAllocated data ->
      infix_gt (length data) (tqtint1 const_MAX) /\
      all_method_chars_valid data /\ not is_known_method_text data
  | _ -> true
  end

function method_repr t_Method : t_MethodModel

predicate invariant_Method (self:t_Method) =
  method_model_is_canonical (method_repr self)

predicate inv_Method t_Method

axiom inv_axiom [@useraxiom] :
  forall x:t_Method [inv_Method x]. inv_Method x -> invariant_Method x

