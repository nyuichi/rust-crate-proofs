function add_with_overflow (a:t17) (b:t17) : (t17, bool) = (add a b,
  if not in_bounds (infix_pl (tqtint a) (tqtint b)) then True else False)

function sub_with_overflow (a:t17) (b:t17) : (t17, bool) = (sub a b,
  if not in_bounds (infix_mn (tqtint a) (tqtint b)) then True else False)

