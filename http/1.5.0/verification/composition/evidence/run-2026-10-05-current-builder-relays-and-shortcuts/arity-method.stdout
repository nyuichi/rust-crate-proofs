axiom setqtdef [@W:non_conservative_extension:N] :
  forall s:seq 'a, i:int, v:'a.
   ([@hyp_name:Requires] infix_lseq 0 i /\ infix_ls i (length s)) ->
   set s i v =
   create (length s) (fun (j:int) -> if j = i then v else mixfix_lbrb s j)

