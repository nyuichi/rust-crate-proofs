nt":""},{"DocComment":" Rather than trying to preserve signaling-ness cross-platform, this"},{"DocComment":" implementation favors preserving the exact bits. This means that"},{"DocComment":" any payloads encoded in NaNs will be preserved even if the result of"},{"DocComment":" this method is sent over the network from an x86 machine to a MIPS one."},{"DocComment":""},{"DocComment":" If the results of this method are only manipulated by the same"},{"DocComment":" architecture that produced them, then there is no portability concern."},{"DocComment":""},{"DocComment":" If the input isn't NaN, then there is no portability concern."},{"DocComment":""},{"DocComment":" If you don't care about signalingness (very likely), then there is no"},{"DocComment":" portability concern."},{"DocComment":""},{"DocComment":" Note that this function is distinct from `as` casting, which attempts to"},{"DocComment":" preserve the *numeric* value, and not the bitwise value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = f32::from_bits(0x41480000);"},{"DocComment":" assert_eq!(v, 12.5);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4}],"output":{"Deduplicated":13}},"src":"Normal","body":"Opaque"},{"def_id":128,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["f64",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":14},"kind":"InherentImplBlock"}}},{"Ident":["from_bits",0]}],"span":{"Untagged":{"dat