t isn't NaN, then there is no portability concern."},{"DocComment":""},{"DocComment":" If you don't care about signalingness (very likely), then there is no"},{"DocComment":" portability concern."},{"DocComment":""},{"DocComment":" Note that this function is distinct from `as` casting, which attempts to"},{"DocComment":" preserve the *numeric* value, and not the bitwise value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = f32::from_bits(0x41480000);"},{"DocComment":" assert_eq!(v, 12.5);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":9}],"output":{"Deduplicated":3}},"src":"Normal","body":"Opaque"},{"def_id":158,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["f64",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["from_bits",0]}],"span":{"Untagged":{"data":{"file_id":20,"beg":{"line":1365,"col":4},"end":{"line":1365,"col":42}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Raw transmutation from `u64`."},{"DocComment":""},{"DocComment":" This is currently identical to `transmute::<u64, f64>(v)` on all platforms."},{"DocComment":" It turns out this is incredibly portable, for two reasons:"},{"DocComment":""},{"DocComment":" * Floats and Ints have the same endianness on all supported platforms."},{"DocComment":" * IEEE 754 very precisely specifies the bit layout of floats."},{"DocComment":