d":26,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Ident":["ChunksExact",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":1841,"col":0},"end":{"line":1841,"col":33}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator over a slice in (non-overlapping) chunks (`chunk_size` elements at a"},{"DocComment":" time), starting at the beginning of the slice."},{"DocComment":""},{"DocComment":" When the slice len is not evenly divided by the chunk size, the last"},{"DocComment":" up to `chunk_size-1` elements will be omitted but can be retrieved from"},{"DocComment":" the [`remainder`] function from the iterator."},{"DocComment":""},{"DocComment":" This struct is created by the [`chunks_exact`] method on [slices]."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next(), Some(&['l', 'o'][..]));"},{"DocComment":" assert_eq!(iter.next(), Some(&['r', 'e'][..]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks_exact`]: slice::chunks_exact"},{"DocComment":" [`remainder`]: ChunksExact::remainder"},{"DocComment":" [slices]: slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared"}],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":17},{"Var":{"Free":0}}]},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":17},{"Var":{"