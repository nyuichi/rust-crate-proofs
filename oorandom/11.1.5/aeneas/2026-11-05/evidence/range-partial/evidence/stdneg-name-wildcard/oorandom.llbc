      // trust Lokathor's implementation 'cause I don't understand\n        // it, so I went to numpy's, which points me to \"Lemire's\n        // rejection algorithm\": http://arxiv.org/abs/1805.10941\n        //\n        // Algorithms 3, 4 and 5 in that paper all seem fine modulo\n        // minor performance differences, so this is algorithm 5.\n        // It uses numpy's implementation, `buffered_bounded_lemire_uint32()`\n\n        debug_assert!(range.start < range.end);\n        let range_starting_from_zero = 0..(range.end - range.start);\n\n        let s: u32 = range_starting_from_zero.end;\n        let mut m: u64 = u64::from(self.rand_u32()) * u64::from(s);\n        let mut leftover: u32 = (m & 0xFFFF_FFFF) as u32;\n\n        if leftover < s {\n            // TODO: verify the wrapping_neg() here\n            let threshold: u32 = s.wrapping_neg() % s;\n            while leftover < threshold {\n                m = u64::from(self.rand_u32()).wrapping_mul(u64::from(s));\n                leftover = (m & 0xFFFF_FFFF) as u32;\n            }\n        }\n        (m >> 32) as u32 + range.start\n    }","attr_info":{"attributes":[{"DocComment":" Produces a random within the given bounds.  Like any `Range`,"},{"DocComment":" it includes the lower bound and excludes the upper one."},{"DocComment":""},{"DocComment":" This should be faster than `Self::rand() % end + start`, but the"},{"DocComment":" real advantage is it's more convenient.  Requires that"},{"DocComment":" `range.end <= range.start`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[24,{