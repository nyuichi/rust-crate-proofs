ing signed type's maximum."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(0_u64.wrapping_neg(), 0);"},{"DocComment":"assert_eq!(u64::MAX.wrapping_neg(), 1);"},{"DocComment":"assert_eq!(13_u64.wrapping_neg(), (!13) + 1);"},{"DocComment":"assert_eq!(42_u64.wrapping_neg(), !(42 - 1));"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6}],"output":{"Deduplicated":6}},"src":"Normal","body":{"Structured":{"span":{"Value":[282,{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2890,"col":8},"end":{"line":2892,"col":9}}}]},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[283,{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2890,"col":43},"end":{"line":2890,"col":47}}}]},"ty":{"Deduplicated":6},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[284,{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2890,"col":34},"end":{"line":2890,"col":38}}}]},"ty":{"Deduplicated":6},"drop_flag_for":null}]},"body":{"span":{"Value":[285,{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":null}]},"id":119,"statements":[{"span":{"Value":[286,{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2719,"col":12},"end":{"line":2