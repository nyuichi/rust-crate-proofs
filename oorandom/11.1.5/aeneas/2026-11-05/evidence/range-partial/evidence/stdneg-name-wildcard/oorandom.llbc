cer behaviour."},{"DocComment":""},{"DocComment":" Note that this is *not* the same as a rotate-right; the"},{"DocComment":" RHS of a wrapping shift-right is restricted to the range"},{"DocComment":" of the type, rather than the bits shifted out of the LHS"},{"DocComment":" being returned to the other end. The primitive integer"},{"DocComment":" types all implement a [`rotate_right`](Self::rotate_right) function,"},{"DocComment":" which may be what you want instead."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(128_u128.wrapping_shr(7), 1);"},{"DocComment":"assert_eq!(0b1010_u128.wrapping_shr(0), 0b1010);"},{"DocComment":"assert_eq!(0b1010_u128.wrapping_shr(1), 0b101);"},{"DocComment":"assert_eq!(0b1010_u128.wrapping_shr(2), 0b10);"},{"DocComment":"assert_eq!(u128::MAX.wrapping_shr(1), i128::MAX.cast_unsigned());"},{"DocComment":"assert_eq!(42_u128.wrapping_shr(128), 42);"},{"DocComment":"assert_eq!(42_u128.wrapping_shr(1).wrapping_shr(127), 0);"},{"DocComment":"assert_eq!(128_u128.wrapping_shr(128), 128);"},{"DocComment":"assert_eq!(10_u128.wrapping_shr(1025), 5);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7},{"Deduplicated":5}],"output":{"Deduplicated":7}},"src":"Normal","body":"Opaque"},null,{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2681,"col":8},"end":{"line":2681,"col":58}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Wrapping (modular) addition. Computes `self + rhs`,"},{"DocComment":" wrapping around at the boundary of the type."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(200u64.wrapping_add(55), 255);"},{"DocComment":"assert_eq!(200u64.wrapping_add(u64::MAX), 199);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Deduplicated":6}],"output":{"Deduplicated":6}},"src":"Normal","body":"Opaque"},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":5},"kind":"InherentImplBlock"}}},{"Ident":["rotate_right",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1292,"col":4},"end":{"line":1316,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":503,"col":8},"end":{"line":503,"col":55}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Shifts the bits to the right by a specified amount, `n`,"},{"DocComment":" wrapping the truncated bits to the beginning of the resulting"},{"DocComment":" integer."},{"DocComment":""},{"DocComment":" `rotate_right(n)` is equivalent to applying `rotate_right(1)` a total of `n` times. In"},{"DocComment":" particular, a rotation by the number of bits in `self` returns the input value"},{"DocComment":" unchanged."},{"DocComment":""},{"DocComment":" Please note this isn't the same operation as the `>>` shifting operator!"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"let n = 0x0000b301u32;"},{"DocComment":"let m = 0x010000b3;"},{"DocComment":""},{"DocComment":"assert_eq!(n.rotate_right(8), m);"},{"DocComment":"assert_eq!(n.rotate_right(1024), n);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Deduplicated":5}],"output":{"Deduplicated":5}},"src":"Normal","body":"Opaque"},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":7},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_mul",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1356,"col":4},"end":{"line":1382,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2757,"col":8},"end":{"line":2757,"col":58}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Wrapping (modular) multiplication. Computes `self *"},{"DocComment":" rhs`, wrapping around at the boundary of the type."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Please note that this example is shared among integer types, which is why `u8` is used."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(10u8.wrapping_mul(12), 120);"},{"DocComment":" assert_eq!(25u8.wrapping_mul(12), 44);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7},{"Deduplicated":7}],"output":{"Deduplicated":7}},"src":"Normal","body":"Opaque"},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":7},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1356,"col":4},"end":{"line":1382,"col":5}},"generated_from_span":{"file_id":13,"beg":{"line":2681,"col":8},"end":{"line":2681,"col":58}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Wrapping (modular) addition. Computes `self + rhs`,"},{"DocComment":" wrapping around at the boundary of the type."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(200u128.wrapping_add(55), 255);"},{"DocComment":"assert_eq!(200u128.wrapping_add(u128::MAX), 199);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7},{"Deduplicated":7}],"output":{"Deduplicated":7}},"src":"Normal