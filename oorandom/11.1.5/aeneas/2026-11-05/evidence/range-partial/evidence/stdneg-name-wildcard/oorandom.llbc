":{"Deduplicated":89},"id":278,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":89},"id":279,"kind":"Return","comments_before":[]}]},"comments":[[137,["This is harder to do well than it looks, it seems.  I don't","trust Lokathor's implementation 'cause I don't understand","it, so I went to numpy's, which points me to \"Lemire's","rejection algorithm\": http://arxiv.org/abs/1805.10941","","Algorithms 3, 4 and 5 in that paper all seem fine modulo","minor performance differences, so this is algorithm 5.","It uses numpy's implementation, `buffered_bounded_lemire_uint32()`"]],[147,["TODO: verify the wrapping_neg() here"]]]}}},{"def_id":12,"item_meta":{"name":[{"Ident":["oorandom",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["rand_range",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":245,"col":4},"end":{"line":263,"col":5}},"generated_from_span":null}},"source_text":"pub fn rand_range(&mut self, range: Range<u64>) -> u64 {\n        // Same as `Rand32::rand_range()`\n        debug_assert!(range.start < range.end);\n        let range_starting_from_zero = 0..(range.end - range.start);\n\n        let s: u64 = range_starting_from_zero.end;\n        let mut m: u128 = u128::from(self.rand_u64()) * u128::from(s);\n        let mut leftover: u64 = (m & 0xFFFFFFFF_FFFFFFFF) as u64;\n\n        if leftover < s {\n            // TODO: Verify the wrapping_negate() here\n            let threshold: u64 = s.wrapping_neg() % s;\n            while leftover < threshold {\n                m = u128::from(self.rand_u64()) * u128::from(s);\n                leftover = (m & 0xFFFFFFFF_FFFFFFFF) as u64;\n            }\n        }\n        (m.wrapping_shr(64)) as u64 + range.start\n    }","attr_info":{"attributes":[{"DocComment":" Produces a random within the given bounds.  Like any `Range`,"},{"DocComment":" it includes the lower bound and excludes the upper one."},{"DocComment":""},{"DocComment":" This should be faster than `Self::rand() % end + start`, but the"},{"DocComment":" real advantage is it's more convenient.  Requires that"},{"DocComment":" `range.end <= range.start`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[32,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4},"Mut"]}]},{"Value":[33,{"Adt":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}],"output":{"Deduplicated":6}},"src":"Normal","body":{"Structured":{"span":{"Value":[90,{"data":{"file_id":0,"beg":{"line":245,"col":4},"end":{"line":263,"col":5}},"generated_from_span":null}]},"bound_body_regions":10,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[91,{"data":{"file_id":0,"beg":{"line":245,"col":55},"end":{"line":245,"col":58}},"generated_from_span":null}]},"ty":{"Deduplicated":6},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[92,{"data":{"file_id":0,"beg":{"line":245,"col":22},"end":{"line":245,"col":31}},"generated_from_span":null}]},"ty":{"Value":[34,{"Ref":[{"Body":1},{"Deduplicated":4},"Mut"]}]},"drop_flag_for":null},{"index":2,"name":"range","span":{"Value":[93,{"data":{"file_id":0,"beg":{"line":245,"col":33},"end":{"line":245,"col":38}},"generated_from_span":null}]},"ty":{"Deduplicated":33},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[94,{"data":{"file_id":0,"beg":{"line":247,"col":8},"end":{"line":247,"col":46}},"generat