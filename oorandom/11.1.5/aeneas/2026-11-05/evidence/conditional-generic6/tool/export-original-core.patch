     exception** of opaque (builtin/declared) functions for HOL4.
 
     See {!extract_fun_decl}. *)
+(** Select only the two original generic core bodies; no model/body/type rewrite. *)
+let original_core_conversion_export_kind (ctx : extraction_ctx)
+    (def : fun_decl) : string option =
+  if not !Config.emit_original_core_conversion_bodies || backend () <> Lean then None
+  else
+    let targets = [
+      ("into", "core::convert::{core::convert::Into<@T, @U>}::into");
+      ("try_into", "core::convert::{core::convert::TryInto<@T, @U, @Error>}::try_into")
+    ] in
+    match List.find_opt (fun (_, pattern) ->
+      ExtractName.match_name ctx.crate (Charon.NameMatcher.parse_pattern pattern)
+        def.item_meta.name) targets with
+    | None -> None
+    | Some (kind, _) ->
+        if def.item_meta.is_local || Option.is_none def.body
+           || def.loop_id <> None || def.num_loops <> 0 || def.is_global_decl_body
+           || List.length def.signature.inputs <> 1
+           || List.length def.signature.llbc_generics.types <>
+                (if kind = "into" then 2 else 3)
+        then failwith "Original core conversion export requires the exact external transparent generic body";
+        Some kind
+
