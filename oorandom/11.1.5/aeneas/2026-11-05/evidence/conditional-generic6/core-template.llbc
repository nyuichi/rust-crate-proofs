utf8(input) {"},{"DocComment":"             Ok(valid) => {"},{"DocComment":"                 push(valid);"},{"DocComment":"                 break"},{"DocComment":"             }"},{"DocComment":"             Err(error) => {"},{"DocComment":"                 let (valid, after_valid) = input.split_at(error.valid_up_to());"},{"DocComment":"                 unsafe {"},{"DocComment":"                     push(std::str::from_utf8_unchecked(valid))"},{"DocComment":"                 }"},{"DocComment":"                 push(\"\\u{FFFD}\");"},{"DocComment":""},{"DocComment":"                 if let Some(invalid_sequence_length) = error.error_len() {"},{"DocComment":"                     input = &after_valid[invalid_sequence_length..]"},{"DocComment":"                 } else {"},{"DocComment":"                     break"},{"DocComment":"                 }"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[32,{"Constant":{"Value":[14,[{"Integer":{"Unsigned":["Usize","16"]}},{"Deduplicated":0}]]}}]},"guarantee":null},"align":{"chosen":{"Value":[33,{"Constant":{"Value":[15,[{"Integer":{"Unsigned":["Usize","8"]}},{"Deduplicated":0}]]}}]},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_