side the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ControlFlow","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"B","variance":"Covariant"},{"index":1,"name":"C","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":6}}],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":5}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[44,{"AtLeast":{"Value":[45,{"AlignTo":{"base":{"Value":[46,{"Max":[{"Value":[47,{"Plus":[{"Value":[48,{"Constant":{"Value":[20,[{"OffsetOf":[{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":5},{"Deduplicated":6}],"const_generics":[],"trait_refs":[]},"builtin":null},0,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":20}]}]},{"Value":[49,{"Plus":[{"Value":[50,{"Constant":{"Value":[21,[{"OffsetOf":[{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":5},{"Deduplicated":6}],"const_generics":[],"trait_refs":[]},"builtin":null},1,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":7}]}]}]}]},"target_align":{"Value":[51,{"Max":[{"Deduplicated":22},{"Deduplicated":11}]}]}}}]}}]}},"align":{"chosen":null,"guarantee":{"Value":[52,{"AtLeast":{"Deduplicated":51}}]}},"discriminator":null,"inhabited":{"Value":[5,{"Or":[{"Deduplicated":4},{"Deduplicated":2}]}]},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":22}},"chosen":null}],"inhabited":{"Deduplicated":4},"tagger":[]},{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":11}},"chosen":null}],"inhabited":{"Deduplicated":2},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":19,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":439,"col":0},"end":{"line":439,"col":96}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Vec","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["char",0]},{"Ident":["convert",0]},{"Ident":["CharTryFromError",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":318,"col":0},"end":{"line":318,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type returned when a conversion from [`prim@u32`] to [`prim@char`] fails."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`char::try_from<u32>`](char#impl-TryFrom<u32>-for-char) method."},{"DocComment":" See its documentation for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":null},"align":{"chosen":{"Deduplicated":1},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["core_simd",0]},{"Ident":["vector",0]},{"Ident":["Simd",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":108,"col":0},"end":{"line":108,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A SIMD vector with the shape of `[T; N]` but the operations of `T`."},{"DocComment":""},{"DocComment":" `Simd<T, N>` supports the operators (+, *, etc.) that `T` does in \"elementwise\" fashion."},{"DocComment":" These take the element at each index from the left-hand side and right-hand side,"},{"DocComment":" perform the operation, then return the result in the same index in a vector of equal size."},{"DocComment":" However, `Simd` differs from normal iteration and normal arrays:"},{"DocComment":" - `Simd<T, N>` executes `N` operations in a single step with no `break`s"},{"DocComment":" - `Simd<T, N>` can have an alignment greater than `T`, for better mechanical sympathy"},{"DocComment":""},{"DocComment":" By always imposing these constraints on `Simd`, it is easier to compile elementwise operations"},{"DocComment":" into machine instructions that can themselves be executed in parallel."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #![feature(portable_simd)]"},{"DocComment":" # use core::simd::{Simd};"},{"DocComment":" # use core::array;"},{"DocComment":" let a: [i32; 4] = [-2, 0, 2, 4];"},{"DocComment":" let b = [10, 9, 8, 7];"},{"DocComment":" let sum = array::from_fn(|i| a[i] + b[i]);"},{"DocComment":" let prod = array::from_fn(|i| a[i] * b[i]);"},{"DocComment":""},{"DocComment":" // `Simd<T, N>` implements `From<[T; N]>`"},{"DocComment":" let (v, w) = (Simd::from(a), Simd::from(b));"},{"DocComment":" // Which means arrays implement `Into<Simd<T, N>>`."},{"DocComment":" assert_eq!(v + w, sum.into());"},{"DocComment":" assert_eq!(v * w, prod.into());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":""},{"DocComment":" `Simd` with integer elements treats operators as wrapping, as if `T` was [`Wrapping<T>`]."},{"DocComment":" Thus, `Simd` does not implement `wrapping_add`, because that is the default behavior."},{"DocComment":" This means there is no warning on overflows, even in \"debug\" builds."},{"DocComment":" For most applications where `Simd` is appropriate, it is \"not a bug\" to wrap,"},{"DocComment":" and even \"debug builds\" are unlikely to tolerate the loss of performance."},{"DocComment":" You may want to consider using explicitly checked arithmetic if such is required."},{"DocComment":" Division by zero on integers still causes a panic, so"},{"DocComment":" you may want to consider using `f32` or `f64` if that is unacceptable."},{"DocComment":""},{"DocComment":" [`Wrapping<T>`]: core::num::Wrapping"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":" `Simd<T, N>` has a layout similar to `[T; N]` (identical \"shapes\"), with a greater alignment."},{"DocComment":" `[T; N]` is aligned to `T`, but `Simd<T, N>` will have an alignment based on both `T` and `N`."},{"DocComment":" Thus it is sound to [`transmute`] `Simd<T, N>` to `[T; N]` and should optimize to \"zero cost\","},{"DocComment":" but the reverse transmutation may require a copy the compiler cannot simply elide."},{"DocComment":""},{"DocComment":" `N` cannot be 0 and may be at most 64. This limit may be increased in the future."},{"DocComment":""},{"DocComment":" # ABI \"Features\""},{"DocComment":" Due to Rust's safety guarantees, `Simd<T, N>` is currently passed and returned via memory,"},{"DocComment":" not SIMD registers, except as an optimization. Using `#[inline]` on functions that accept"},{"DocComment":" `Simd<T, N>` or return it is recommended, at the cost of code generation time, as"},{"DocComment":" inlining SIMD-using functions can omit a large function prolog or epilog and thus"},{"DocComment":" improve both speed and code size. The need for this may be corrected in the future."},{"DocComment":""},{"DocComment":" Using `#[inline(always)]` still requires additional care."},{"DocComment":""},{"DocComment":" # Safe SIMD with Unsafe Rust"},{"DocComment":""},{"DocComment":" Operations with `Simd` are typically safe, but there are many reasons to want to combine SIMD with `unsafe` code."},{"DocComment":" Care must be taken to respect differences between `Simd` and other types it may be transformed into or derived from."},{"DocComment":" In particular, the layout of `Simd<T, N>` may be similar to `[T; N]`, and may allow some transmutations,"},{"DocComment":" but references to `[T; N]` are not interchangeable with those to `Simd<T, N>`."},{"DocComment":" Thus, when using `unsafe` Rust to read and write `Simd<T, N>` through [raw pointers], it is a good idea to first try with"},{"DocComment":" [`read_unaligned`] and [`write_unaligned`]. This is because:"},{"DocComment":" - [`read`] and [`write`] require full alignment (in this case, `Simd<T, N>`'s alignment)"},{"DocComment":" - `Simd<T, N>` is often read from or written to [`[T]`](slice) and other types aligned to `T`"},{"DocComment":" - combining these actions violates the `unsafe` contract and explodes the program into"},{"DocComment":"   a puff of **undefined behavior**"},{"DocComment":" - the compiler can implicitly adjust layouts to make unaligned reads or writes fully aligned"},{"DocComment":"   if it sees the optimization"},{"DocComment":" - most contemporary processors with \"aligned\" and \"unaligned\" read and write instructions"},{"DocComment":"   exhibit no performance difference if the \"unaligned\" variant is aligned at runtime"},{"DocComment":""},{"DocComment":" Less obligations mean unaligned reads and writes are less likely to make the program unsound,"},{"DocComment":" and may be just as fast as stricter alternatives."},{"DocComment":" When trying to guarantee alignment, [`[T]::as_simd`][as_simd] is an option for"},{"DocComment":" converting `[T]` to `[Simd<T, N>]`, and allows soundly operating on an aligned SIMD body,"},{"DocComment":" but it may cost more time when handling the scalar head and tail."},{"DocComment":" If these are not enough, it is most ideal to design data structures to be already aligned"},{"DocComment":" to `align_of::<Simd<T, N>>()` before using `unsafe` Rust to read or write."},{"DocComment":" Other ways to compensate for these facts, like materializing `Simd` to or from an array first,"},{"DocComment":" are handled by safe methods like [`Simd::from_array`] and [`Simd::from_slice`]."},{"DocComment":""},{"DocComment":" [`transmute`]: core::mem::transmute"},{"DocComment":" [raw pointers]: pointer"},{"DocComment":" [`read_unaligned`]: pointer::read_unaligned"},{"DocComment":" [`write_unaligned`]: pointer::write_unaligned"},{"DocComment":" [`read`]: pointer::read"},{"DocComment":" [`write`]: pointer::write"},{"DocComment":" [as_simd]: slice::as_simd"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[{"clause_id":0,"span":{"Value":[1,{"data":{"file_id":18,"beg":{"line":110,"col":7},"end":{"line":110,"col":18}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":22,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["boxed",0]},{"Ident":["Box",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":236,"col":0},"end":{"line":239,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer type that uniquely owns a heap allocation of type `T`."},{"DocComment":""},{"DocComment":" See the [module-level documentation](../../std/boxed/index.html) for more."},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"OwnedBox","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Box"},"kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":23,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"Untagged":{"data":{"file_id":42,"beg":{"line":59,"col":0},"end":{"line":59,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"GlobalAlloc","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":37}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":38}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":24,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["String",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":353,"col":0},"end":{"line":353,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A UTF-8–encoded, growable string."},{"DocComment":""},{"DocComment":" `String` is the most common string type. It has ownership over the contents"},{"DocComment":" of the string, stored in a heap-allocated buffer (see [Representation](#representation))."},{"DocComment":" It is closely related to its borrowed counterpart, the primitive [`str`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can create a `String` from [a literal string][`&str`] with [`String::from`]:"},{"DocComment":""},{"DocComment":" [`String::from`]: From::from"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let hello = String::from(\"Hello, world!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can append a [`char`] to a `String` with the [`push`] method, and"},{"DocComment":" append a [`&str`] with the [`push_str`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut hello = String::from(\"Hello, \");"},{"DocComment":""},{"DocComment":" hello.push('w');"},{"DocComment":" hello.push_str(\"orld!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`push`]: String::push"},{"DocComment":" [`push_str`]: String::push_str"},{"DocComment":""},{"DocComment":" If you have a vector of UTF-8 bytes, you can create a `String` from it with"},{"DocComment":" the [`from_utf8`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`from_utf8`]: String::from_utf8"},{"DocComment":""},{"DocComment":" # UTF-8"},{"DocComment":""},{"DocComment":" `String`s are always valid UTF-8. If you need a non-UTF-8 string, consider"},{"DocComment":" [`OsString`]. It is similar, but without the UTF-8 constraint. Because UTF-8"},{"DocComment":" is a variable width encoding, `String`s are typically smaller than an array of"},{"DocComment":" the same `char`s:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // `s` is ASCII which represents each `char` as one byte"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.len(), 5);"},{"DocComment":""},{"DocComment":" // A `char` array with the same contents would be longer because"},{"DocComment":" // every `char` is four bytes"},{"DocComment":" let s = ['h', 'e', 'l', 'l', 'o'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":""},{"DocComment":" // However, for non-ASCII strings, the difference will be smaller"},{"DocComment":" // and sometimes they are the same"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.len(), 20);"},{"DocComment":""},{"DocComment":" let s = ['💖', '💖', '💖', '💖', '💖'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This raises interesting questions as to how `s[i]` should work."},{"DocComment":" What should `i` be here? Several options include byte indices and"},{"DocComment":" `char` indices but, because of UTF-8 encoding, only byte indices"},{"DocComment":" would provide constant time indexing. Getting the `i`th `char`, for"},{"DocComment":" example, is available using [`chars`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = \"hello\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('l'));"},{"DocComment":""},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('💖'));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Next, what should `s[i]` return? Because indexing returns a reference"},{"DocComment":" to underlying data it could be `&u8`, `&[u8]`, or something similar."},{"DocComment":" Since we're only providing one index, `&u8` makes the most sense but that"},{"DocComment":" might not be what the user expects and can be explicitly achieved with"},{"DocComment":" [`as_bytes()`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The first byte is 104 - the byte value of `'h'`"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 104);"},{"DocComment":" // or"},{"DocComment":" assert_eq!(s.as_bytes()[0], b'h');"},{"DocComment":""},{"DocComment":" // The first byte is 240 which isn't obviously useful"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 240);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Due to these ambiguities/restrictions, indexing with a `usize` is simply"},{"DocComment":" forbidden:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" let s = \"hello\";"},{"DocComment":""},{"DocComment":" // The following will not compile!"},{"DocComment":" println!(\"The first letter of s is {}\", s[0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is more clear, however, how `&s[i..j]` should work (that is,"},{"DocComment":" indexing with a range). It should accept byte indices (to be constant-time)"},{"DocComment":" and return a `&str` which is UTF-8 encoded. This is also called \"string slicing\"."},{"DocComment":" Note this will panic if the byte indices provided are not character"},{"DocComment":" boundaries - see [`is_char_boundary`] for more details. See the implementations"},{"DocComment":" for [`SliceIndex<str>`] for more details on string slicing. For a non-panicking"},{"DocComment":" version of string slicing, see [`get`]."},{"DocComment":""},{"DocComment":" [`OsString`]: ../../std/ffi/struct.OsString.html \"ffi::OsString\""},{"DocComment":" [`SliceIndex<str>`]: core::slice::SliceIndex"},{"DocComment":" [`as_bytes()`]: str::as_bytes"},{"DocComment":" [`get`]: str::get"},{"DocComment":" [`is_char_boundary`]: str::is_char_boundary"},{"DocComment":""},{"DocComment":" The [`bytes`] and [`chars`] methods return iterators over the bytes and"},{"DocComment":" codepoints of the string, respectively. To iterate over codepoints along"},{"DocComment":" with byte indices, use [`char_indices`]."},{"DocComment":""},{"DocComment":" [`bytes`]: str::bytes"},{"DocComment":" [`chars`]: str::chars"},{"DocComment":" [`char_indices`]: str::char_indices"},{"DocComment":""},{"DocComment":" # Deref"},{"DocComment":""},{"DocComment":" `String` implements <code>[Deref]<Target = [str]></code>, and so inherits all of [`str`]'s"},{"DocComment":" methods. In addition, this means that you can pass a `String` to a"},{"DocComment":" function which takes a [`&str`] by using an ampersand (`&`):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn takes_str(s: &str) { }"},{"DocComment":""},{"DocComment":" let s = String::from(\"Hello\");"},{"DocComment":""},{"DocComment":" takes_str(&s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will create a [`&str`] from the `String` and pass it in. This"},{"DocComment":" conversion is very inexpensive, and so generally, functions will accept"},{"DocComment":" [`&str`]s as arguments unless they need a `String` for some specific"},{"DocComment":" reason."},{"DocComment":""},{"DocComment":" In certain cases Rust doesn't have enough information to make this"},{"DocComment":" conversion, known as [`Deref`] coercion. In the following example a string"},{"DocComment":" slice [`&'a str`][`&str`] implements the trait `TraitExample`, and the function"},{"DocComment":" `example_func` takes anything that implements the trait. In this case Rust"},{"DocComment":" would need to make two implicit conversions, which Rust doesn't have the"},{"DocComment":" means to do. For that reason, the following example will not compile."},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" trait TraitExample {}"},{"DocComment":""},{"DocComment":" impl<'a> TraitExample for &'a str {}"},{"DocComment":""},{"DocComment":" fn example_func<A: TraitExample>(example_arg: A) {}"},{"DocComment":""},{"DocComment":" let example_string = String::from(\"example_string\");"},{"DocComment":" example_func(&example_string);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are two options that would work instead. The first would be to"},{"DocComment":" change the line `example_func(&example_string);` to"},{"DocComment":" `example_func(example_string.as_str());`, using the method [`as_str()`]"},{"DocComment":" to explicitly extract the string slice containing the string. The second"},{"DocComment":" way changes `example_func(&example_string);` to"},{"DocComment":" `example_func(&*example_string);`. In this case we are dereferencing a"},{"DocComment":" `String` to a [`str`], then referencing the [`str`] back to"},{"DocComment":" [`&str`]. The second way is more idiomatic, however both work to do the"},{"DocComment":" conversion explicitly rather than relying on the implicit conversion."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" A `String` is made up of three components: a pointer to some bytes, a"},{"DocComment":" length, and a capacity. The pointer points to the internal buffer which `String`"},{"DocComment":" uses to store its data. The length is the number of bytes currently stored"},{"DocComment":" in the buffer, and the capacity is the size of the buffer in bytes. As such,"},{"DocComment":" the length will always be less than or equal to the capacity."},{"DocComment":""},{"DocComment":" This buffer is always stored on the heap."},{"DocComment":""},{"DocComment":" You can look at these with the [`as_ptr`], [`len`], and [`capacity`]"},{"DocComment":" methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let story = String::from(\"Once upon a time...\");"},{"DocComment":""},{"DocComment":" // Deconstruct the String into parts."},{"DocComment":" let (ptr, len, capacity) = story.into_raw_parts();"},{"DocComment":""},{"DocComment":" // story has nineteen bytes"},{"DocComment":" assert_eq!(19, len);"},{"DocComment":""},{"DocComment":" // We can re-build a String out of ptr, len, and capacity. This is all"},{"DocComment":" // unsafe because we are responsible for making sure the components are"},{"DocComment":" // valid:"},{"DocComment":" let s = unsafe { String::from_raw_parts(ptr, len, capacity) } ;"},{"DocComment":""},{"DocComment":" assert_eq!(String::from(\"Once upon a time...\"), s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_ptr`]: str::as_ptr"},{"DocComment":" [`len`]: String::len"},{"DocComment":" [`capacity`]: String::capacity"},{"DocComment":""},{"DocComment":" If a `String` has enough capacity, adding elements to it will not"},{"DocComment":" re-allocate. For example, consider this program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::new();"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will output the following:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 0"},{"DocComment":" 8"},{"DocComment":" 16"},{"DocComment":" 16"},{"DocComment":" 32"},{"DocComment":" 32"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" At first, we have no memory allocated at all, but as we append to the"},{"DocComment":" string, it increases its capacity appropriately. If we instead use the"},{"DocComment":" [`with_capacity`] method to allocate the correct capacity initially:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::with_capacity(25);"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`with_capacity`]: String::with_capacity"},{"DocComment":""},{"DocComment":" We end up with a different output:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here, there's no need to allocate more memory inside the loop."},{"DocComment":""},{"DocComment":" [str]: prim@str \"str\""},{"DocComment":" [`str`]: prim@str \"str\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [Deref]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`Deref`]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`as_str()`]: String::as_str"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"String","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":34},"guarantee":null},"align":{"chosen":{"Deduplicated":33},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":25,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["FromUtf8Error",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":391,"col":0},"end":{"line":391,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A possible error value when converting a `String` from a UTF-8 byte vector."},{"DocComment":""},{"DocComment":" This type is the error type for the [`from_utf8`] method on [`String`]. It"},{"DocComment":" is designed in such a way to carefully avoid reallocations: the"},{"DocComment":" [`into_bytes`] method will give back the byte vector that was used in the"},{"DocComment":" conversion attempt."},{"DocComment":""},{"DocComment":" [`from_utf8`]: String::from_utf8"},{"DocComment":" [`into_bytes`]: FromUtf8Error::into_bytes"},{"DocComment":""},{"DocComment":" The [`Utf8Error`] type provided by [`std::str`] represents an error that may"},{"DocComment":" occur when converting a slice of [`u8`]s to a [`&str`]. In this sense, it's"},{"DocComment":" an analogue to `FromUtf8Error`, and you can get one from a `FromUtf8Error`"},{"DocComment":" through the [`utf8_error`] method."},{"DocComment":""},{"DocComment":" [`Utf8Error`]: str::Utf8Error \"std::str::Utf8Error\""},{"DocComment":" [`std::str`]: core::str \"std::str\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [`utf8_error`]: FromUtf8Error::utf8_error"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some invalid bytes, in a vector"},{"DocComment":" let bytes = vec![0, 159];"},{"DocComment":""},{"DocComment":" let value = String::from_utf8(bytes);"},{"DocComment":""},{"DocComment":" assert!(value.is_err());"},{"DocComment":" assert_eq!(vec![0, 159], value.unwrap_err().into_bytes());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[53,{"Constant":{"Value":[22,[{"Integer":{"Unsigned":["Usize","40"]}},{"Deduplicated":0}]]}}]},"guarantee":null},"align":{"chosen":{"Deduplicated":33},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":24}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":26,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["ffi",0]},{"Ident":["c_str",0]},{"Ident":["CString",0]}],"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":108,"col":0},"end":{"line":108,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A type representing an owned, C-compatible, nul-terminated string with no nul bytes in the"},{"DocComment":" middle."},{"DocComment":""},{"DocComment":" This type serves the purpose of being able to safely generate a"},{"DocComment":" C-compatible string from a Rust byte slice or vector. An instance of this"},{"DocComment":" type is a static guarantee that the underlying bytes contain no interior 0"},{"DocComment":" bytes (\"nul characters\") and that the final byte is 0 (\"nul terminator\")."},{"DocComment":""},{"DocComment":" `CString` is to <code>&[CStr]</code> as [`String`] is to <code>&[str]</code>: the former"},{"DocComment":" in each pair are owned strings; the latter are borrowed"},{"DocComment":" references."},{"DocComment":""},{"DocComment":" # Creating a `CString`"},{"DocComment":""},{"DocComment":" A `CString` is created from either a byte slice or a byte vector,"},{"DocComment":" or anything that implements <code>[Into]<[Vec]<[u8]>></code> (for"},{"DocComment":" example, you can build a `CString` straight out of a [`String`] or"},{"DocComment":" a <code>&[str]</code>, since both implement that trait)."},{"DocComment":" You can create a `CString` from a literal with `CString::from(c\"Text\")`."},{"DocComment":""},{"DocComment":" The [`CString::new`] method will actually check that the provided <code>&[[u8]]</code>"},{"DocComment":" does not have 0 bytes in the middle, and return an error if it"},{"DocComment":" finds one."},{"DocComment":""},{"DocComment":" # Extracting a raw pointer to the whole C string"},{"DocComment":""},{"DocComment":" `CString` implements an [`as_ptr`][`CStr::as_ptr`] method through the [`Deref`]"},{"DocComment":" trait. This method will give you a `*const c_char` which you can"},{"DocComment":" feed directly to extern functions that expect a nul-terminated"},{"DocComment":" string, like C's `strdup()`. Notice that [`as_ptr`][`CStr::as_ptr`] returns a"},{"DocComment":" read-only pointer; if the C code writes to it, that causes"},{"DocComment":" undefined behavior."},{"DocComment":""},{"DocComment":" # Extracting a slice of the whole C string"},{"DocComment":""},{"DocComment":" Alternatively, you can obtain a <code>&[[u8]]</code> slice from a"},{"DocComment":" `CString` with the [`CString::as_bytes`] method. Slices produced in this"},{"DocComment":" way do *not* contain the trailing nul terminator. This is useful"},{"DocComment":" when you will be calling an extern function that takes a `*const"},{"DocComment":" u8` argument which is not necessarily nul-terminated, plus another"},{"DocComment":" argument with the length of the string — like C's `strndup()`."},{"DocComment":" You can of course get the slice's length with its"},{"DocComment":" [`len`][slice::len] method."},{"DocComment":""},{"DocComment":" If you need a <code>&[[u8]]</code> slice *with* the nul terminator, you"},{"DocComment":" can use [`CString::as_bytes_with_nul`] instead."},{"DocComment":""},{"DocComment":" Once you have the kind of slice you need (with or without a nul"},{"DocComment":" terminator), you can call the slice's own"},{"DocComment":" [`as_ptr`][slice::as_ptr] method to get a read-only raw pointer to pass to"},{"DocComment":" extern functions. See the documentation for that function for a"},{"DocComment":" discussion on ensuring the lifetime of the raw pointer."},{"DocComment":""},{"DocComment":" [str]: prim@str \"str\""},{"DocComment":" [`Deref`]: ops::Deref"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```ignore (extern-declaration)"},{"DocComment":" # fn main() {"},{"DocComment":" use std::ffi::CString;"},{"DocComment":" use std::os::raw::c_char;"},{"DocComment":""},{"DocComment":" extern \"C\" {"},{"DocComment":"     fn my_printer(s: *const c_char);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // We are certain that our string doesn't have 0 bytes in the middle,"},{"DocComment":" // so we can .expect()"},{"DocComment":" let c_to_print = CString::new(\"Hello, world!\").expect(\"we provided a string without NUL bytes, so CString::new should not fail\");"},{"DocComment":" unsafe {"},{"DocComment":"     my_printer(c_to_print.as_ptr());"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" `CString` is intended for working with traditional C-style strings"},{"DocComment":" (a sequence of non-nul bytes terminated by a single nul byte); the"},{"DocComment":" primary use case for these kinds of strings is interoperating with C-like"},{"DocComment":" code. Often you will need to transfer ownership to/from that external"},{"DocComment":" code. It is strongly recommended that you thoroughly read through the"},{"DocComment":" documentation of `CString` before use, as improper ownership management"},{"DocComment":" of `CString` instances can lead to invalid memory accesses, memory leaks,"},{"DocComment":" and other memory errors."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"cstring_type","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":32},"guarantee":null},"align":{"chosen":{"Deduplicated":33},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":27,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["ffi",0]},{"Ident":["c_str",0]},{"Ident":["IntoStringError",0]}],"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":223,"col":0},"end":{"line":223,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An error indicating invalid UTF-8 when converting a [`CString`] into a [`String`]."},{"DocComment":""},{"DocComment":" `CString` is just a wrapper over a buffer of bytes with a nul terminator;"},{"DocComment":" [`CString::into_string`] performs UTF-8 validation on those bytes and may"},{"DocComment":" return this error."},{"DocComment":""},{"DocComment":" This `struct` is created by [`CString::into_string()`]. See"},{"DocComment":" its documentation for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[54,{"Constant":{"Value":[23,[{"Integer":{"Unsigned":["Usize","32"]}},{"Deduplicated":0}]]}}]},"guarantee":null},"align":{"chosen":{"Deduplicated":33},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":16}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":28,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["rc",0]},{"Ident":["Rc",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":324,"col":0},"end":{"line":327,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A single-threaded reference-counting pointer. 'Rc' stands for 'Reference"},{"DocComment":" Counted'."},{"DocComment":""},{"DocComment":" See the [module-level documentation](./index.html) for more details."},{"DocComment":""},{"DocComment":" The inherent methods of `Rc` are all associated functions, which means"},{"DocComment":" that you have to call them as e.g., [`Rc::get_mut(&mut value)`][get_mut] instead of"},{"DocComment":" `value.get_mut()`. This avoids conflicts with methods of the inner type `T`."},{"DocComment":""},{"DocComment":" [get_mut]: Rc::get_mut"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Rc","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":29,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["sync",0]},{"Ident":["Arc",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":274,"col":0},"end":{"line":277,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A thread-safe reference-counting pointer. 'Arc' stands for 'Atomically"},{"DocComment":" Reference Counted'."},{"DocComment":""},{"DocComment":" The type `Arc<T>` provides shared ownership of a value of type `T`,"},{"DocComment":" allocated in the heap. Invoking [`clone`][clone] on `Arc` produces"},{"DocComment":" a new `Arc` instance, which points to the same allocation on the heap as the"},{"DocComment":" source `Arc`, while increasing a reference count. When the last `Arc`"},{"DocComment":" pointer to a given allocation is destroyed, the value stored in that allocation (often"},{"DocComment":" referred to as \"inner value\") is also dropped."},{"DocComment":""},{"DocComment":" Shared references in Rust disallow mutation by default, and `Arc` is no"},{"DocComment":" exception: you cannot generally obtain a mutable reference to something"},{"DocComment":" inside an `Arc`. If you do need to mutate through an `Arc`, you have several options:"},{"DocComment":""},{"DocComment":" 1. Use interior mutability with synchronization primitives like [`Mutex`][mutex],"},{"DocComment":"    [`RwLock`][rwlock], or one of the [`Atomic`][atomic] types."},{"DocComment":""},{"DocComment":" 2. Use clone-on-write semantics with [`Arc::make_mut`] which provides efficient mutation"},{"DocComment":"    without requiring interior mutability. This approach clones the data only when"},{"DocComment":"    needed (when there are multiple references) and can be more efficient when mutations"},{"DocComment":"    are infrequent."},{"DocComment":""},{"DocComment":" 3. Use [`Arc::get_mut`] when you know your `Arc` is not shared (has a reference count of 1),"},{"DocComment":"    which provides direct mutable access to the inner value without any cloning."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let mut data = Arc::new(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // This will clone the vector only if there are other references to it"},{"DocComment":" Arc::make_mut(&mut data).push(4);"},{"DocComment":""},{"DocComment":" assert_eq!(*data, vec![1, 2, 3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Note**: This type is only available on platforms that support atomic"},{"DocComment":" loads and stores of pointers, which includes all platforms that support"},{"DocComment":" the `std` crate but not all those which only support [`alloc`](crate)."},{"DocComment":" This may be detected at compile time using `#[cfg(target_has_atomic = \"ptr\")]`."},{"DocComment":""},{"DocComment":" ## Thread Safety"},{"DocComment":""},{"DocComment":" Unlike [`Rc<T>`], `Arc<T>` uses atomic operations for its reference"},{"DocComment":" counting. This means that it is thread-safe. The disadvantage is that"},{"DocComment":" atomic operations are more expensive than ordinary memory accesses. If you"},{"DocComment":" are not sharing reference-counted allocations between threads, consider using"},{"DocComment":" [`Rc<T>`] for lower overhead. [`Rc<T>`] is a safe default, because the"},{"DocComment":" compiler will catch any attempt to send an [`Rc<T>`] between threads."},{"DocComment":" However, a library might choose `Arc<T>` in order to give library consumers"},{"DocComment":" more flexibility."},{"DocComment":""},{"DocComment":" `Arc<T>` will implement [`Send`] and [`Sync`] as long as the `T` implements"},{"DocComment":" [`Send`] and [`Sync`]. Why can't you put a non-thread-safe type `T` in an"},{"DocComment":" `Arc<T>` to make it thread-safe? This may be a bit counter-intuitive at"},{"DocComment":" first: after all, isn't the point of `Arc<T>` thread safety? The key is"},{"DocComment":" this: `Arc<T>` makes it thread safe to have multiple ownership of the same"},{"DocComment":" data, but it  doesn't add thread safety to its data. Consider"},{"DocComment":" <code>Arc<[RefCell\\<T>]></code>. [`RefCell<T>`] isn't [`Sync`], and if `Arc<T>` was always"},{"DocComment":" [`Send`], <code>Arc<[RefCell\\<T>]></code> would be as well. But then we'd have a problem:"},{"DocComment":" [`RefCell<T>`] is not thread safe; it keeps track of the borrowing count using"},{"DocComment":" non-atomic operations."},{"DocComment":""},{"DocComment":" In the end, this means that you may need to pair `Arc<T>` with some sort of"},{"DocComment":" [`std::sync`] type, usually [`Mutex<T>`][mutex]."},{"DocComment":""},{"DocComment":" ## Breaking cycles with `Weak`"},{"DocComment":""},{"DocComment":" The [`downgrade`][downgrade] method can be used to create a non-owning"},{"DocComment":" [`Weak`] pointer. A [`Weak`] pointer can be [`upgrade`][upgrade]d"},{"DocComment":" to an `Arc`, but this will return [`None`] if the value stored in the allocation has"},{"DocComment":" already been dropped. In other words, `Weak` pointers do not keep the value"},{"DocComment":" inside the allocation alive; however, they *do* keep the allocation"},{"DocComment":" (the backing store for the value) alive."},{"DocComment":""},{"DocComment":" A cycle between `Arc` pointers will never be deallocated. For this reason,"},{"DocComment":" [`Weak`] is used to break cycles. For example, a tree could have"},{"DocComment":" strong `Arc` pointers from parent nodes to children, and [`Weak`]"},{"DocComment":" pointers from children back to their parents."},{"DocComment":""},{"DocComment":" # Cloning references"},{"DocComment":""},{"DocComment":" Creating a new reference from an existing reference-counted pointer is done using the"},{"DocComment":" `Clone` trait implemented for [`Arc<T>`][Arc] and [`Weak<T>`][Weak]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" let foo = Arc::new(vec![1.0, 2.0, 3.0]);"},{"DocComment":" // The two syntaxes below are equivalent."},{"DocComment":" let a = foo.clone();"},{"DocComment":" let b = Arc::clone(&foo);"},{"DocComment":" // a, b, and foo are all Arcs that point to the same memory location"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Deref` behavior"},{"DocComment":""},{"DocComment":" `Arc<T>` automatically dereferences to `T` (via the [`Deref`] trait),"},{"DocComment":" so you can call `T`'s methods on a value of type `Arc<T>`. To avoid name"},{"DocComment":" clashes with `T`'s methods, the methods of `Arc<T>` itself are associated"},{"DocComment":" functions, called using [fully qualified syntax]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let my_arc = Arc::new(());"},{"DocComment":" let my_weak = Arc::downgrade(&my_arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Arc<T>`'s implementations of traits like `Clone` may also be called using"},{"DocComment":" fully qualified syntax. Some people prefer to use fully qualified syntax,"},{"DocComment":" while others prefer using method-call syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let arc = Arc::new(());"},{"DocComment":" // Method-call syntax"},{"DocComment":" let arc2 = arc.clone();"},{"DocComment":" // Fully qualified syntax"},{"DocComment":" let arc3 = Arc::clone(&arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Weak<T>`][Weak] does not auto-dereference to `T`, because the inner value may have"},{"DocComment":" already been dropped."},{"DocComment":""},{"DocComment":" [`Rc<T>`]: crate::rc::Rc"},{"DocComment":" [clone]: Clone::clone"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [atomic]: core::sync::atomic"},{"DocComment":" [downgrade]: Arc::downgrade"},{"DocComment":" [upgrade]: Weak::upgrade"},{"DocComment":" [RefCell\\<T>]: core::cell::RefCell"},{"DocComment":" [`RefCell<T>`]: core::cell::RefCell"},{"DocComment":" [`std::sync`]: ../../std/sync/index.html"},{"DocComment":" [`Arc::clone(&from)`]: Arc::clone"},{"DocComment":" [fully qualified syntax]: https://doc.rust-lang.org/book/ch19-03-advanced-traits.html#fully-qualified-syntax-for-disambiguation-calling-methods-with-the-same-name"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Sharing some immutable data between threads:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let five = Arc::new(5);"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let five = Arc::clone(&five);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         println!(\"{five:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Sharing a mutable [`AtomicUsize`]:"},{"DocComment":""},{"DocComment":" [`AtomicUsize`]: core::sync::atomic::AtomicUsize \"sync::atomic::AtomicUsize\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::sync::atomic::{AtomicUsize, Ordering};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let val = Arc::new(AtomicUsize::new(5));"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let val = Arc::clone(&val);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         let v = val.fetch_add(1, Ordering::Relaxed);"},{"DocComment":"         println!(\"{v:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [`rc` documentation][rc_examples] for more examples of reference"},{"DocComment":" counting in general."},{"DocComment":""},{"DocComment":" [rc_examples]: crate::rc#examples"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Arc","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["niche_types",0]},{"Ident":["NonZeroUsizeInner",0]}],"span":{"Untagged":{"data":{"file_id":43,"beg":{"line":115,"col":0},"end":{"line":139,"col":1}},"generated_from_span":{"file_id":43,"beg":{"line":20,"col":8},"end":{"line":20,"col":55}}}},"source_tex