ications that"},{"DocComment":" need to round-trip whatever data the user provides."},{"DocComment":""},{"DocComment":" For an owned, growable byte string buffer, use"},{"DocComment":" [`ByteString`](../../std/bstr/struct.ByteString.html)."},{"DocComment":""},{"DocComment":" `ByteStr` implements `Deref` to `[u8]`, so all methods available on `[u8]` are available on"},{"DocComment":" `ByteStr`."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" A `&ByteStr` has the same representation as a `&str`. That is, a `&ByteStr` is a wide pointer"},{"DocComment":" which includes a pointer to some bytes and a length."},{"DocComment":""},{"DocComment":" # Trait implementations"},{"DocComment":""},{"DocComment":" The `ByteStr` type has a number of trait implementations, and in particular, defines equality"},{"DocComment":" and comparisons between `&ByteStr`, `&str`, and `&[u8]`, for convenience."},{"DocComment":""},{"DocComment":" The `Debug` implementation for `ByteStr` shows its bytes as a normal string, with invalid UTF-8"},{"DocComment":" presented as hex escape sequences."},{"DocComment":""},{"DocComment":" The `Display` implementation behaves as if the `ByteStr` were first lossily converted to a"},{"DocComment":" `str`, with invalid UTF-8 presented as the Unicode replacement character (�)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":44,"col":19},"end":{"line":44,"col":27}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":7}}]},"layout":[{"key":"x86_64-unknown-linux-gnu"