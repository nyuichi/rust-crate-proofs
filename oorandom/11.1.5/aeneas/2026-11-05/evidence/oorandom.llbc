"line":1348,"col":5}},"generated_from_span":{"file_id":9,"beg":{"line":2930,"col":8},"end":{"line":2930,"col":57}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Panic-free bitwise shift-left; yields `self << mask(rhs)`,"},{"DocComment":" where `mask` removes any high-order bits of `rhs` that"},{"DocComment":" would cause the shift to exceed the bitwidth of the type."},{"DocComment":""},{"DocComment":" Beware that, unlike most other `wrapping_*` methods on integers, this"},{"DocComment":" does *not* give the same result as doing the shift in infinite precision"},{"DocComment":" then truncating as needed. Instead, the behaviour of this method matches what shift instructions"},{"DocComment":" do on many processors, and is what the `<<` operator does when overflow"},{"DocComment":" checks are disabled, but numerically it's weird.  Consider, instead,"},{"DocComment":" using [`Self::unbounded_shl`] which has nicer behaviour."},{"DocComment":""},{"DocComment":" Note that this is *not* the same as a rotate-left; the"},{"DocComment":" RHS of a wrapping shift-left is restricted to the range"},{"DocComment":" of the type, rather than the bits shifted out of the LHS"},{"DocComment":" being returned to the other end. The primitive integer"},{"DocComment":" types all implement a [`rotate_left`](Self::rotate_left) function,"},{"DocComment":" which may be what you want instead."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(1_u64.wrapping_shl(7), 128);"},{"DocComment":"assert_eq!(0b101_u64.wrapping_shl(0), 0b101);"},{"DocComment":"assert_eq!(0b101_u64.wrapping_shl(1), 0b1010);"},{"DocComment":"assert_eq!(0b101_u64.wrapping_shl(2), 0b10100);"},{"DocComment":"assert_eq!(u64::MAX.wrapping_shl(2), u64::MAX - 3);"},{"DocComment":"assert_eq!(42_u64.wrapping_shl(64), 42);"},{"DocComment":"assert_eq!(42_u64.wrapping_shl(1).wrapping_shl(63), 0);"},{"DocComment":"assert_eq!(1_u64.wrapping_shl(128), 1);"},{"DocComment":"assert_eq!(5_u64.wrapping_shl(1025), 10);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Deduplicated":6}],"output":{"Deduplicated":5}},"src":"Normal","body":"Opaque"},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":5},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":1324,"col":4},"end":{"line":1348,"col":5}},"generated_from_span":{"file_id":9,"beg":{"line":2681,"col":8},"end":{"line":2681,"col":58}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Wrapping (modular) addition. Computes `self + rhs`,"},{"DocComment":" wrapping around at the boundary of the type."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(200u64.wrapping_add(55), 255);"},{"DocComment":"assert_eq!(200u64.wrapping_add(u64::MAX), 199);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Deduplicated":5}],"output":{"Deduplicated":5}},"src":"Normal","bod