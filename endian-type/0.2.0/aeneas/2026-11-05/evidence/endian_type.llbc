{"charon_version":"0.1.291","translated":{"crate_name":"endian_type","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["{impl core::ops::bit::BitAnd for endian_type::BigEndian<_>}::bitand","{impl core::ops::bit::BitOr for endian_type::BigEndian<_>}::bitor","{impl core::ops::bit::BitXor for endian_type::BigEndian<_>}::bitxor","{impl core::ops::bit::BitAnd for endian_type::LittleEndian<_>}::bitand","{impl core::ops::bit::BitOr for endian_type::LittleEndian<_>}::bitor","{impl core::ops::bit::BitXor for endian_type::LittleEndian<_>}::bitxor"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":"/workspace/full-api/endian/endian66-publication-candidate/endian-type/0.2.0/aeneas/2026-11-05/evidence","dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"endian_type","contents":"#![no_std]\n\nuse core::ops::{BitAnd, BitOr, BitXor};\nuse core::{mem, slice};\n\n///Type with a specified byte order.\npub trait Endian<T> {}\n\nmacro_rules! impl_Endian{\n    ( for $e:ident) => {\n        impl<T> BitAnd for $e<T>\n        where\n            T: BitAnd,\n        {\n            type Output = $e<<T as BitAnd>::Output>;\n\n            #[inline]\n            fn bitand(self, other: Self) -> Self::Output {\n                $e(self.0 & other.0)\n            }\n        }\n\n        impl<T> BitOr for $e<T>\n        where\n            T: BitOr,\n        {\n            type Output = $e<<T as BitOr>::Output>;\n\n            #[inline]\n            fn bitor(self, other: Self) -> Self::Output {\n                $e(self.0 | other.0)\n            }\n        }\n\n        impl<T> BitXor for $e<T>\n        where\n            T: BitXor,\n        {\n            type Output = $e<<T as BitXor>::Output>;\n\n            #[inline]\n            fn bitxor(self, other: Self) -> Self::Output {\n                $e(self.0 ^ other.0)\n            }\n        }\n\n        impl<T> $e<T>\n        where\n            T: Sized + Copy,\n        {\n            #[inline]\n            pub const unsafe fn from_byte_slice(bytes: &[u8]) -> $e<T> {\n                debug_assert!(bytes.len() >= mem::size_of::<T>());\n                $e({ *(bytes.as_ptr() as *const T) })\n            }\n\n            #[inline]\n            pub fn as_byte_slice(&self) -> &[u8] {\n                unsafe { slice::from_raw_parts(&self.0 as *const T as *const u8, mem::size_of::<T>()) }\n            }\n\n            #[inline]\n            pub fn as_byte_slice_mut(&mut self) -> &mut [u8] {\n                unsafe { slice::from_raw_parts_mut(&mut self.0 as *mut T as *mut u8, mem::size_of::<T>()) }\n            }\n        }\n    }\n}\n\n///Big endian byte order.\n///\n///Most significant byte first.\n#[derive(Copy, Clone, Debug, Eq, PartialEq, Hash, Ord, PartialOrd)]\n#[repr(transparent)]\npub struct BigEndian<T>(T);\n\nimpl<T> Endian<T> for BigEndian<T> {}\n\nmacro_rules! impl_for_BigEndian {\n    ( $t:ident ) => {\n        impl From<BigEndian<$t>> for $t {\n            #[inline]\n            fn from(data: BigEndian<$t>) -> $t {\n                $t::from_be(data.0)\n            }\n        }\n\n        impl From<$t> for BigEndian<$t> {\n            #[inline]\n            fn from(data: $t) -> Self {\n                BigEndian(data.to_be())\n            }\n        }\n\n        impl From<LittleEndian<$t>> for BigEndian<$t> {\n            #[inline]\n            fn from(data: LittleEndian<$t>) -> Self {\n                BigEndian(data.0.swap_bytes())\n            }\n        }\n\n        //TODO: Move these to Endian when https://github.com/rust-lang/rust/issues/67792 stabilized in a few years\n        impl BigEndian<$t>{\n            ///Return the memory representation of this type as a byte array in its endian byte order.\n            ///Note: This is just a transmute.\n            #[inline]\n            pub const fn to_bytes(self) -> [u8; mem::size_of::<BigEndian<$t>>()] {\n                unsafe { mem::transmute(self) }\n            }\n\n            ///Construct a value from its memory representation as a byte array.\n            ///Note: This is just a transmute.\n            #[inline]\n            pub const fn from_bytes(bytes: [u8; mem::size_of::<BigEndian<$t>>()]) -> BigEndian<$t> {\n                unsafe { mem::transmute(bytes) }\n            }\n        }\n    };\n}\n\nimpl_Endian!(for BigEndian);\nimpl_for_BigEndian!(u16);\nimpl_for_BigEndian!(u32);\nimpl_for_BigEndian!(u64);\nimpl_for_BigEndian!(u128);\nimpl_for_BigEndian!(usize);\nimpl_for_BigEndian!(i16);\nimpl_for_BigEndian!(i32);\nimpl_for_BigEndian!(i64);\nimpl_for_BigEndian!(i128);\nimpl_for_BigEndian!(isize);\n\n///Little endian byte order.\n///\n///Least significant byte first.\n#[derive(Copy, Clone, Debug, Eq, PartialEq, Hash, Ord, PartialOrd)]\n#[repr(transparent)]\npub struct LittleEndian<T>(T);\n\nimpl<T> Endian<T> for LittleEndian<T> {}\n\nmacro_rules! impl_for_LittleEndian {\n    ( $t:ident ) => {\n        impl From<LittleEndian<$t>> for $t {\n            #[inline]\n            fn from(data: LittleEndian<$t>) -> $t {\n                $t::from_le(data.0)\n            }\n        }\n\n        impl From<$t> for LittleEndian<$t> {\n            #[inline]\n            fn from(data: $t) -> Self {\n                LittleEndian(data.to_le())\n            }\n        }\n\n        impl From<BigEndian<$t>> for LittleEndian<$t> {\n            #[inline]\n            fn from(data: BigEndian<$t>) -> Self {\n                LittleEndian(data.0.swap_bytes())\n            }\n        }\n\n        impl LittleEndian<$t>{\n            ///Return the memory representation of this type as a byte array in its endian byte order.\n            ///Note: This is just a transmute.\n            #[inline]\n            pub const fn to_bytes(self) -> [u8; mem::size_of::<LittleEndian<$t>>()] {\n                unsafe { mem::transmute(self) }\n            }\n\n            ///Construct a value from its memory representation as a byte array.\n            ///Note: This is just a transmute.\n            #[inline]\n            pub const fn from_bytes(bytes: [u8; mem::size_of::<LittleEndian<$t>>()]) -> LittleEndian<$t> {\n                unsafe { mem::transmute(bytes) }\n            }\n        }\n    };\n}\n\nimpl_Endian!(for LittleEndian);\nimpl_for_LittleEndian!(u16);\nimpl_for_LittleEndian!(u32);\nimpl_for_LittleEndian!(u64);\nimpl_for_LittleEndian!(u128);\nimpl_for_LittleEndian!(usize);\nimpl_for_LittleEndian!(i16);\nimpl_for_LittleEndian!(i32);\nimpl_for_LittleEndian!(i64);\nimpl_for_LittleEndian!(i128);\nimpl_for_LittleEndian!(isize);\n\n///Network byte order as defined by IETF RFC1700 <http://tools.ietf.org/html/rfc1700>.\npub type NetworkOrder<T> = BigEndian<T>;\n\n///Type aliases for primitive types.\npub mod types {\n    #![allow(non_camel_case_types)]\n\n    use super::*;\n\n    pub type i16_be = BigEndian<i16>;\n    pub type i32_be = BigEndian<i32>;\n    pub type i64_be = BigEndian<i64>;\n    pub type i128_be = BigEndian<i128>;\n    pub type isize_be = BigEndian<isize>;\n\n    pub type u16_be = BigEndian<u16>;\n    pub type u32_be = BigEndian<u32>;\n    pub type u64_be = BigEndian<u64>;\n    pub type u128_be = BigEndian<u128>;\n    pub type usize_be = BigEndian<usize>;\n\n    pub type i16_le = LittleEndian<i16>;\n    pub type i32_le = LittleEndian<i32>;\n    pub type i64_le = LittleEndian<i64>;\n    pub type i128_le = LittleEndian<i128>;\n    pub type isize_le = LittleEndian<isize>;\n\n    pub type u16_le = LittleEndian<u16>;\n    pub type u32_le = LittleEndian<u32>;\n    pub type u64_le = LittleEndian<u64>;\n    pub type u128_le = LittleEndian<u128>;\n    pub type usize_le = LittleEndian<usize>;\n\n    pub type i16_net = NetworkOrder<i16>;\n    pub type i32_net = NetworkOrder<i32>;\n    pub type i128_net = NetworkOrder<i128>;\n    pub type isize_net = NetworkOrder<isize>;\n\n    pub type u16_net = NetworkOrder<u16>;\n    pub type u32_net = NetworkOrder<u32>;\n    pub type u64_net = NetworkOrder<u64>;\n    pub type u128_net = NetworkOrder<u128>;\n    pub type usize_net = NetworkOrder<usize>;\n}\n\n#[cfg(test)]\nmod tests{\n    use super::*;\n    use super::types::*;\n\n    #[test]\n    fn from_to_bytes(){\n        macro_rules! test{\n            ($e:ident for $t:ident in $r:expr) => {\n                for i in $r{\n                    let j = $e::<$t>::from(i);\n                    assert_eq!($e::<$t>::from_bytes(j.to_bytes()) , j);\n                }\n            }\n        }\n\n        test!(BigEndian for i16  in -10000..10000);\n        test!(BigEndian for i32  in -10000..10000);\n        test!(BigEndian for i64  in -10000..10000);\n        test!(BigEndian for i128 in -10000..10000);\n\n        test!(LittleEndian for i16  in -10000..10000);\n        test!(LittleEndian for i32  in -10000..10000);\n        test!(LittleEndian for i64  in -10000..10000);\n        test!(LittleEndian for i128 in -10000..10000);\n\n        test!(BigEndian for u16  in 0..20000);\n        test!(BigEndian for u32  in 0..20000);\n        test!(BigEndian for u64  in 0..20000);\n        test!(BigEndian for u128 in 0..20000);\n\n        test!(LittleEndian for u16  in 0..20000);\n        test!(LittleEndian for u32  in 0..20000);\n        test!(LittleEndian for u64  in 0..20000);\n        test!(LittleEndian for u128 in 0..20000);\n    }\n\n    #[test]\n    fn to_bytes_std(){\n        macro_rules! test{\n            ( for $t:ident in $r:expr) => {\n                for i in $r{\n                    assert_eq!(   BigEndian::<$t>::from(i).to_bytes() , i.to_be_bytes());\n                    assert_eq!(LittleEndian::<$t>::from(i).to_bytes() , i.to_le_bytes());\n                }\n            }\n        }\n\n        test!(for i16  in -10000..10000);\n        test!(for i32  in -10000..10000);\n        test!(for i64  in -10000..10000);\n        test!(for i128 in -10000..10000);\n\n        test!(for i16  in 0..20000);\n        test!(for i32  in 0..20000);\n        test!(for i64  in 0..20000);\n        test!(for i128 in 0..20000);\n    }\n\n    #[test]\n    fn as_to_byte_slice(){\n        macro_rules! test{\n            ($e:ident for $t:ident in $r:expr) => {\n                for i in $r{\n                    let mut j = $e::<$t>::from(i);\n                    assert_eq!(unsafe{$e::<$t>::from_byte_slice(j.as_byte_slice())} , j);\n                    assert_eq!(unsafe{$e::<$t>::from_byte_slice(j.as_byte_slice_mut())} , j);\n                }\n            }\n        }\n\n        test!(BigEndian for i16  in -10000..10000);\n        test!(BigEndian for i32  in -10000..10000);\n        test!(BigEndian for i64  in -10000..10000);\n        test!(BigEndian for i128 in -10000..10000);\n\n        test!(LittleEndian for i16  in -10000..10000);\n        test!(LittleEndian for i32  in -10000..10000);\n        test!(LittleEndian for i64  in -10000..10000);\n        test!(LittleEndian for i128 in -10000..10000);\n\n        test!(BigEndian for u16  in 0..20000);\n        test!(BigEndian for u32  in 0..20000);\n        test!(BigEndian for u64  in 0..20000);\n        test!(BigEndian for u128 in 0..20000);\n\n        test!(LittleEndian for u16  in 0..20000);\n        test!(LittleEndian for u32  in 0..20000);\n        test!(LittleEndian for u64  in 0..20000);\n        test!(LittleEndian for u128 in 0..20000);\n    }\n\n}\n\n#[cfg(doctest)]\nmod test_readme {\n    macro_rules! external_doc_test {\n        ($x:expr) => {\n            #[doc = $x]\n            extern {}\n        };\n    }\n    external_doc_test!(include_str!(\"../README.md\"));\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/bit.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regio