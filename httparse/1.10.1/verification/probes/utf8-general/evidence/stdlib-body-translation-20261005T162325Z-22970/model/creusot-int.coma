module UInt128
  use mach.int.Int

  type t = < range 0 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF >

  constant two_power_size : int = 0x100000000000000000000000000000000

  axiom extensionality:
    forall x y: t [t'int x, t'int y]. t'int x = t'int y -> x = y

  predicate in_bounds [@inline:trivial] (n:int) = 0 <= n <= 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF

  function of_int (n: int) : t
  axiom to_of_int:
    forall x: int [of_int x]. in_bounds x -> t'int (of_int x) = x

  function add (a:t) (b:t) : t
  axiom add_in_bounds:
