let rec utf8_u00e9 [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/utf8-lemmas/src/lib.rs" 7 0 7 19]
  (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = [ &encoded <- [%#slib] to_utf8_char (Char.of_int 233) ] s1
    | s1 = {[@expl:assertion] [%#slib'0] Char.to_int (Char.of_int 233) = 233} s2
    | s2 = {[@expl:assertion] [%#slib'1] Seq.length encoded = 2} s3
    | s3 = {[@expl:assertion] [%#slib'2] UInt8.t'int (Seq.get encoded 0) = 195} s4
    | s4 = {[@expl:assertion] [%#slib'3] UInt8.t'int (Seq.get encoded 1) = 169} s5
    | s5 = {[@expl:assertion] [%#slib'4] Seq.(==) encoded (Seq.create 2 [|(195: UInt8.t);(169: UInt8.t)|])} s6
    | s6 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & encoded: Seq.seq UInt8.t = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:utf8_u00e9 ensures] [%#slib'5] to_utf8_char (Char.of_int 233)
    = Seq.create 2 [|(195: UInt8.t);(169: UInt8.t)|]}
    (! return {result}) ]
