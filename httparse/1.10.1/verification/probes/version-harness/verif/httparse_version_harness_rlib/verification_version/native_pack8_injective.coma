use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

function deep_model_u8 [@inline:trivial] (self: UInt8.t) : int = [%#snum'7] UInt8.t'int self

meta "rewrite_def" function deep_model_u8

function u64_from_ne_bytes_byte (bytes: Seq.seq UInt8.t) (offset: int) : int =
  [%#snum'1] deep_model_u8 (Seq.get bytes offset)

function u64_from_ne_bytes_tail (bytes: Seq.seq UInt8.t) (offset: int) : int = [%#snum'4] if offset = 0 then
    u64_from_ne_bytes_byte bytes 0
    + 256
    * (u64_from_ne_bytes_byte bytes 1
    + 256
    * (u64_from_ne_bytes_byte bytes 2
    + 256
    * (u64_from_ne_bytes_byte bytes 3
    + 256
    * (u64_from_ne_bytes_byte bytes 4
    + 256
    * (u64_from_ne_bytes_byte bytes 5
    + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7))))))
  else
    if offset = 1 then
      u64_from_ne_bytes_byte bytes 1
      + 256
      * (u64_from_ne_bytes_byte bytes 2
      + 256
      * (u64_from_ne_bytes_byte bytes 3
      + 256
      * (u64_from_ne_bytes_byte bytes 4
      + 256
      * (u64_from_ne_bytes_byte bytes 5
      + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7)))))
    else
      if offset = 2 then
        u64_from_ne_bytes_byte bytes 2
        + 256
        * (u64_from_ne_bytes_byte bytes 3
        + 256
        * (u64_from_ne_bytes_byte bytes 4
        + 256
        * (u64_from_ne_bytes_byte bytes 5
        + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7))))
      else
        if offset = 3 then
          u64_from_ne_bytes_byte bytes 3
          + 256
          * (u64_from_ne_bytes_byte bytes 4
          + 256
          * (u64_from_ne_bytes_byte bytes 5
          + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7)))
        else
          if offset = 4 then
            u64_from_ne_bytes_byte bytes 4
            + 256
            * (u64_from_ne_bytes_byte bytes 5
            + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7))
          else
            if offset = 5 then
              u64_from_ne_bytes_byte bytes 5
              + 256 * (u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7)
            else
              if offset = 6 then
                u64_from_ne_bytes_byte bytes 6 + 256 * u64_from_ne_bytes_byte bytes 7
              else
                if offset = 7 then u64_from_ne_bytes_byte bytes 7 else 0
            
          
        
      
    
  


let rec unfold_native_pack_tail (bytes: Seq.seq UInt8.t) (offset: int) (return (x: ())) =
  {[@stop_split] [@expl:unfold_native_pack_tail requires] ([@stop_split] [@expl:unfold_native_pack_tail requires #0] [%#sversion'83] Seq.length bytes
    = 8)
  /\ ([@stop_split] [@expl:unfold_native_pack_tail requires #1] [%#sversion'84] 0 <= offset /\ offset < 8)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:unfold_native_pack_tail ensures] [%#sversion'85] u64_from_ne_bytes_tail bytes offset
    = u64_from_ne_bytes_byte bytes offset + 256 * u64_from_ne_bytes_tail bytes (offset + 1)}
    (! return {result}) ]

let rec base256_head_injective (left_byte: int) (right_byte: int) (left_tail: int) (right_tail: int) (return (x: ())) =
  {[@stop_split] [@expl:base256_head_injective requires] ([@stop_split] [@expl:base256_head_injective requires #0] [%#sversion'86] 0
      <= left_byte
    /\ left_byte < 256)
  /\ ([@stop_split] [@expl:base256_head_injective requires #1] [%#sversion'87] 0 <= right_byte /\ right_byte < 256)
  /\ ([@stop_split] [@expl:base256_head_injective requires #2] [%#sversion'88] left_byte + 256 * left_tail
  = right_byte + 256 * right_tail)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:base256_head_injective ensures] ([@stop_split] [@expl:base256_head_injective ensures #0] [%#sversion'89] left_byte
      = right_byte)
    /\ ([@stop_split] [@expl:base256_head_injective ensures #1] [%#sversion'90] left_tail = right_tail)}
    (! return {result}) ]

let rec native_pack_tail_end (bytes: Seq.seq UInt8.t) (return (x: ())) =
  {[@stop_split] [@expl:native_pack_tail_end requires] [%#sversion'91] Seq.length bytes = 8}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:native_pack_tail_end ensures] [%#sversion'92] u64_from_ne_bytes_tail bytes 8 = 0}
    (! return {result}) ]

function u64_from_ne_bytes_value (bytes: Seq.seq UInt8.t) : int = [%#snum'6] u64_from_ne_bytes_tail bytes 0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec native_pack8_injective
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/version-harness/src/../../../../src/verification/version.rs" 309 0 309 80]
  (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t) (return (x: ())) =
  {[@stop_split] [@expl:native_pack8_injective requires] ([@stop_split] [@expl:native_pack8_injective requires #0] [%#sversion'73] Seq.length left
      = 8
    /\ Seq.length right = 8)
  /\ ([@stop_split] [@expl:native_pack8_injective requires #1] [%#sversion'74] u64_from_ne_bytes_value left
  = u64_from_ne_bytes_value right)}
  (! bb0
  [ bb0 = s0
    [ s0 = unfold_native_pack_tail [%#sversion'0] {left} {[%#sversion] 0} (fun (_x: ()) -> [ &_33 <- _x ] s1)
