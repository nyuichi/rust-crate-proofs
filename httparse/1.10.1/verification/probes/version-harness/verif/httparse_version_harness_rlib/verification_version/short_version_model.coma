                                             mark = mark'0;
                                             cursor = end' } in [@stop_split] [@expl:short_version_model ensures] ([@stop_split] [@expl:short_version_model ensures #0] [%#sversion'2] result.mark
                                = mark'0)
                              /\ ([@stop_split] [@expl:short_version_model ensures #1] [%#sversion'3] start
                                <= result.cursor
                              /\ result.cursor <= end')
                            )
                        
                        )
                    
                    )
                
                )
            
            )
        
        )
    
    )
  )
