                                           cursor = end' } in [@stop_split] [@expl:short_version_model ensures] ([@stop_split] [@expl:short_version_model ensures #0] [%#sversion'2] result.mark
                              = mark'0)
                            /\ ([@stop_split] [@expl:short_version_model ensures #1] [%#sversion'3] start
                              <= result.cursor
                            /\ result.cursor <= end')
                          else
                            ([@stop_split] [@expl:version_prefix_byte requires] [%#sversion'4] 0 <= 6 /\ 6 < 7)
                            /\ (if deep_model_u8 (Seq.get input (start + 6)) <> version_prefix_byte 6 then
                              let result = { outcome = Error;
                                             mark = mark'0;
                                             cursor = start
                                             + 7 } in [@stop_split] [@expl:short_version_model ensures] ([@stop_split] [@expl:short_version_model ensures #0] [%#sversion'2] result.mark
                                = mark'0)
                              /\ ([@stop_split] [@expl:short_version_model ensures #1] [%#sversion'3] start
                                <= result.cursor
                              /\ result.cursor <= end')
                            else
