[package]
name = "httparse-method-utf8-harness"
version = "0.1.0"
edition = "2018"

[features]
default = ["std"]
std = []

[lib]
path = "@METHOD_UTF8_PROBE@/src/lib.rs"

[dependencies]
creusot-std = { path = "@HTTPARSE_CREUSOT_LIBS@/creusot-std" }

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ["cfg(creusot)"] }
