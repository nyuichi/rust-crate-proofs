  [#"/workspace/httparse-cloud-resume/httparse/1.10.1/verification/probes/method-utf8/src/lib.rs" 17 0 17 65]
  (raw: Slice64.slice UInt8.t) (return (x: t_MethodOutcome)) = (! bb0
  [ bb0 = s0
    [ s0 = method_from_bytes [%#slib] {raw} (fun (_x: t_Option_ref_str) -> [ &_4 <- _x ] s1)
    | s1 = any [ br0 -> {_4 = None} (! bb4) | br1 (x0: Seq.seq Char.t) -> {_4 = Some x0} (! bb5) ] ]
  | bb5 = s0
    [ s0 = elim_Some {_4} (fun (r0: Seq.seq Char.t) -> [ &value <- r0 ] s1)
    | s1 = [ &_ret <- Complete value ] s2
    | s2 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- InvalidToken ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_MethodOutcome = Any.any_l ()
  | & raw: Slice64.slice UInt8.t = raw
  | & _4: t_Option_ref_str = Any.any_l ()
  | & value: Seq.seq Char.t = Any.any_l () ])
  [ return (result: t_MethodOutcome) -> {[@stop_split] [@expl:map_method_outcome ensures] [%#slib'0] match result with
      | Complete value -> to_bytes value = Slice64.view raw
      | InvalidToken -> not valid_utf8 (Slice64.view raw)
      end}
    (! return {result}) ]
