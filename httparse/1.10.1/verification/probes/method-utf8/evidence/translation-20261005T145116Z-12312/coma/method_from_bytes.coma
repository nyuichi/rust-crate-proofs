type t_Utf8Error

type t_Result_ref_str_Utf8Error = Ok (Seq.seq Char.t) | Err t_Utf8Error

predicate inv_Utf8Error (_1: t_Utf8Error)

predicate inv_Result_ref_str_Utf8Error (_1: t_Result_ref_str_Utf8Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_ref_str_Utf8Error [inv_Result_ref_str_Utf8Error x]. inv_Result_ref_str_Utf8Error x
    = match x with
      | Ok f0 -> true
      | Err f0 -> inv_Utf8Error f0
      end

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def: forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t). flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function utf8_byte (value: int) : UInt8.t

axiom utf8_byte_spec: forall value: int. ([%#schar'2] 0 <= value /\ value <= 255)
    -> ([%#schar'3] UInt8.t'int (utf8_byte value) = value)

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t = [%#schar'0] let code = Char.to_int self in if code < 128 then
    Seq.singleton (utf8_byte code)
  else
    if code < 2048 then
      Seq.snoc (Seq.singleton (utf8_byte (192 + ComputerDivision.div code 64))) (utf8_byte (128
      + ComputerDivision.mod code 64))
    else
      if code < 65536 then
        Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (224 + ComputerDivision.div code 4096))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
      else
        Seq.snoc (Seq.snoc (Seq.snoc (Seq.singleton (utf8_byte (240
        + ComputerDivision.div code 262144))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 4096) 64))) (utf8_byte (128
        + ComputerDivision.mod (ComputerDivision.div code 64) 64))) (utf8_byte (128 + ComputerDivision.mod code 64))
    
  


axiom to_utf8_char_spec: forall self: Char.t. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t =
  [%#sstring'0] flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

type t_Option_Int = None | Some int

predicate valid_utf8 (bytes: Seq.seq UInt8.t) =
  [%#sstring'1] exists characters: Seq.seq Char.t. to_bytes characters = bytes

predicate utf8_error_matches (bytes: Seq.seq UInt8.t) (valid_up_to: int) (error_len: t_Option_Int)

axiom utf8_error_matches_spec:
  forall bytes: Seq.seq UInt8.t, valid_up_to: int, error_len: t_Option_Int. [%#sstring'2] utf8_error_matches bytes valid_up_to error_len
    -> 0 <= valid_up_to /\ valid_up_to <= Seq.length bytes

axiom utf8_error_matches_spec'0:
  forall bytes: Seq.seq UInt8.t, valid_up_to: int, error_len: t_Option_Int. [%#sstring'3] utf8_error_matches bytes valid_up_to error_len
    -> valid_utf8 (Seq.([..]) bytes 0 valid_up_to)

axiom utf8_error_matches_spec'1:
  forall bytes: Seq.seq UInt8.t, valid_up_to: int, error_len: t_Option_Int. [%#sstring'4] utf8_error_matches bytes valid_up_to error_len
    -> not valid_utf8 bytes

axiom utf8_error_matches_spec'2:
  forall bytes: Seq.seq UInt8.t, valid_up_to: int, error_len: t_Option_Int. [%#sstring'5] utf8_error_matches bytes valid_up_to error_len
    -> match error_len with
      | Some length -> 1 <= length /\ length <= 3 /\ valid_up_to + length <= Seq.length bytes
      | None -> valid_up_to < Seq.length bytes /\ Seq.length bytes - valid_up_to < 4
      end

function valid_up_to_Utf8Error (self: t_Utf8Error) : int

function error_len_Utf8Error (self: t_Utf8Error) : t_Option_Int

let rec from_utf8 (bytes: Slice64.slice UInt8.t) (return (x: t_Result_ref_str_Utf8Error)) = any
  [ return (result: t_Result_ref_str_Utf8Error) ->
  {[@stop_split] [@expl:from_utf8 ensures] ([@stop_split] [@expl:from_utf8 result type invariant] inv_Result_ref_str_Utf8Error result)
    /\ ([@stop_split] [@expl:from_utf8 ensures] [%#sstring] match result with
      | Ok value -> to_bytes value = Slice64.view bytes
      | Err error -> utf8_error_matches (Slice64.view bytes) (valid_up_to_Utf8Error error) (error_len_Utf8Error error)
      end)}
    (! return {result}) ]

type t_Option_ref_str = None'0 | Some'0 (Seq.seq Char.t)

let rec elim_Ok (_x: t_Result_ref_str_Utf8Error) (return (f0: Seq.seq Char.t)) = any
