+    fn lower_string_literal(&self, string: &str) -> Exp {
+        let char_ty = Type::qconstructor(self.names.in_pre(PreMod::Char, "t"));
+        let seq_ty = Type::qconstructor(self.names.in_pre(PreMod::Seq, "seq")).tapp([char_ty]);
+        if string.is_empty() {
+            return Exp::qvar(self.names.in_pre(PreMod::Seq, "empty")).ascribe(seq_ty);
+        }
+        let elts: Box<[Exp]> = string
+            .chars()
+            .map(|ch| {
+                Exp::qvar(self.names.in_pre(PreMod::Char, "of_int"))
+                    .app([Constant::Int(ch as u32 as i128, None).into()])
+            })
+            .collect();
+        let seq = Exp::qvar(self.names.in_pre(PreMod::Seq, "create"))
+            .app([Exp::int(elts.len() as i128), Exp::FunLiteral(elts)]);
+        seq.ascribe(seq_ty)
+    }
