let rec space_prefix_at_cursor
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/spaces.rs" 40 0 45 1]
  (input: Seq.seq UInt8.t) (start: int) (cursor: int) (end': int) (return (x: ())) =
  {[@stop_split] [@expl:space_prefix_at_cursor requires] ([@stop_split] [@expl:space_prefix_at_cursor requires #0] [%#sspaces] 0
      <= start
    /\ start <= cursor /\ cursor <= end')
  /\ ([@stop_split] [@expl:space_prefix_at_cursor requires #1] [%#sspaces'0] end' <= Seq.length input)
  /\ ([@stop_split] [@expl:space_prefix_at_cursor requires #2] [%#sspaces'1] forall i: int. start <= i /\ i < cursor
    -> deep_model_u8 (Seq.get input i) = 32)}
  (! bb0
  [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:space_prefix_at_cursor ensures] ([@stop_split] [@expl:space_prefix_at_cursor ensures #0] [%#sspaces'2] cursor
          = end'
        \/ deep_model_u8 (Seq.get input cursor) <> 32 -> cursor = space_prefix_end input start end')
    /\ ([@stop_split] [@expl:space_prefix_at_cursor ensures #1] [%#sspaces'3] cursor < end'
      /\ deep_model_u8 (Seq.get input cursor) = 32 -> cursor < space_prefix_end input start end')}
    (! return {result}) ]
