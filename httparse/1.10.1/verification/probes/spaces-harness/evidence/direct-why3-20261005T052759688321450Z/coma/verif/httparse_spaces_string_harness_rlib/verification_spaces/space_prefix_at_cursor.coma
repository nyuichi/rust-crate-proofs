use creusot.prelude.Any
use creusot.int.UInt8
use seq.Seq
use int.Int

function deep_model_u8 [@inline:trivial] (self: UInt8.t) : int = [%#snum] UInt8.t'int self

meta "rewrite_def" function deep_model_u8

function space_prefix_end [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/spaces.rs" 16 0 16 68] (input: Seq.seq UInt8.t) (start: int) (end': int) : int

axiom space_prefix_end_def: forall input: Seq.seq UInt8.t, start: int, end': int. ([%#sspaces'5] 0 <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> space_prefix_end input start end'
    = ([%#sspaces'9] if start = end' \/ deep_model_u8 (Seq.get input start) <> 32 then
      start
    else
      space_prefix_end input (start + 1) end'
    )

axiom space_prefix_end_spec: forall input: Seq.seq UInt8.t, start: int, end': int. ([%#sspaces'5] 0 <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#sspaces'6] start <= space_prefix_end input start end' /\ space_prefix_end input start end' <= end')

axiom space_prefix_end_spec'0: forall input: Seq.seq UInt8.t, start: int, end': int. ([%#sspaces'5] 0 <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#sspaces'7] forall i: int. start <= i /\ i < space_prefix_end input start end'
      -> deep_model_u8 (Seq.get input i) = 32)

axiom space_prefix_end_spec'1: forall input: Seq.seq UInt8.t, start: int, end': int. ([%#sspaces'5] 0 <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#sspaces'8] space_prefix_end input start end' < end'
    -> deep_model_u8 (Seq.get input (space_prefix_end input start end')) <> 32)

