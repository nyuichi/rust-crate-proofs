(* #"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 75 0 75 88 *)

let%span smodel = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 70 10 70 21
let%span smodel'0 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 71 11 71 59
let%span smodel'1 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 72 10 72 42
let%span smodel'2 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 73 10 73 78
let%span smodel'3 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 74 10 74 57
let%span smodel'4 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 76 4 80 5
let%span smodel'5 = "/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 30 4 43 5
let%span swell_founded = "/workspace/scratch/httparse-string-model/creusot-libs/creusot-std/src/logic/well_founded.rs" 43 8 43 33

use creusot.int.UInt8
use seq.Seq
use int.Int

type t_ByteClass = Token | Uri | HeaderValue

predicate accepts [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 29 0 29 50] (class: t_ByteClass) (byte: UInt8.t) =
  [%#smodel'5] match class with
    | Token -> UInt8.t'int byte >= 48 /\ UInt8.t'int byte <= 57
    \/ UInt8.t'int byte >= 65 /\ UInt8.t'int byte <= 90
    \/ UInt8.t'int byte >= 97 /\ UInt8.t'int byte <= 122
    \/ UInt8.t'int byte = 33
    \/ UInt8.t'int byte = 35
    \/ UInt8.t'int byte = 36
    \/ UInt8.t'int byte = 37
    \/ UInt8.t'int byte = 38
    \/ UInt8.t'int byte = 39
    \/ UInt8.t'int byte = 42
    \/ UInt8.t'int byte = 43
    \/ UInt8.t'int byte = 45
    \/ UInt8.t'int byte = 46
    \/ UInt8.t'int byte = 94
    \/ UInt8.t'int byte = 95 \/ UInt8.t'int byte = 96 \/ UInt8.t'int byte = 124 \/ UInt8.t'int byte = 126
    | Uri -> UInt8.t'int byte >= 33 /\ UInt8.t'int byte <> 127
    | HeaderValue -> UInt8.t'int byte = 9 \/ UInt8.t'int byte >= 32 /\ UInt8.t'int byte <> 127
    end

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq UInt8.t

constant start : int

constant end' : int

constant class : t_ByteClass

function maximal_prefix_end [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/spaces-harness/string/../src/../../../../src/verification/model.rs" 75 0 75 88] (input: Seq.seq UInt8.t) (start: int) (end': int) (class: t_ByteClass) : int

goal vc_maximal_prefix_end: ([%#smodel'0] 0 <= start /\ start <= end' /\ end' <= Seq.length input)
  -> (if start = end' then
    let result = start in [@stop_split] [@expl:maximal_prefix_end ensures] ([@stop_split] [@expl:maximal_prefix_end ensures #0] [%#smodel'1] start
        <= result
      /\ result <= end')
    /\ ([@stop_split] [@expl:maximal_prefix_end ensures #1] [%#smodel'2] forall i: int. start <= i /\ i < result
        -> accepts class (Seq.get input i))
    /\ ([@stop_split] [@expl:maximal_prefix_end ensures #2] [%#smodel'3] result < end'
    -> not accepts class (Seq.get input result))
  else
    if not accepts class (Seq.get input start) then
      let result = start in [@stop_split] [@expl:maximal_prefix_end ensures] ([@stop_split] [@expl:maximal_prefix_end ensures #0] [%#smodel'1] start
          <= result
        /\ result <= end')
      /\ ([@stop_split] [@expl:maximal_prefix_end ensures #1] [%#smodel'2] forall i: int. start <= i /\ i < result
          -> accepts class (Seq.get input i))
      /\ ([@stop_split] [@expl:maximal_prefix_end ensures #2] [%#smodel'3] result < end'
      -> not accepts class (Seq.get input result))
    else
      (([@stop_split] [@expl:maximal_prefix_end requires] [%#smodel'0] 0 <= start + 1
          /\ start + 1 <= end' /\ end' <= Seq.length input)
        /\ ([@expl:variant decreases] well_founded_relation_Int ([%#smodel] end' - start) ([%#smodel] end'
        - (start + 1))))
      /\ (([@stop_split] [@expl:maximal_prefix_end ensures] ([@stop_split] [@expl:maximal_prefix_end ensures #0] [%#smodel'1] start
              + 1
            <= maximal_prefix_end input (start + 1) end' class
          /\ maximal_prefix_end input (start + 1) end' class <= end')
        /\ ([@stop_split] [@expl:maximal_prefix_end ensures #1] [%#smodel'2] forall i: int. start + 1 <= i
              /\ i < maximal_prefix_end input (start + 1) end' class -> accepts class (Seq.get input i))
        /\ ([@stop_split] [@expl:maximal_prefix_end ensures #2] [%#smodel'3] maximal_prefix_end input (start
            + 1) end' class
          < end' -> not accepts class (Seq.get input (maximal_prefix_end input (start + 1) end' class))))
      -> (let result = maximal_prefix_end input (start
      + 1) end' class in [@stop_split] [@expl:maximal_prefix_end ensures] ([@stop_split] [@expl:maximal_prefix_end ensures #0] [%#smodel'1] start
          <= result
        /\ result <= end')
      /\ ([@stop_split] [@expl:maximal_prefix_end ensures #1] [%#smodel'2] forall i: int. start <= i /\ i < result
          -> accepts class (Seq.get input i))
      /\ ([@stop_split] [@expl:maximal_prefix_end ensures #2] [%#smodel'3] result < end'
      -> not accepts class (Seq.get input result))))
  
  )
