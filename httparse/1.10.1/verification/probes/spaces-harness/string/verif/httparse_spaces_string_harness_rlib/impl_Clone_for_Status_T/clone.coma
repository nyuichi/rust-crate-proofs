use creusot.prelude.Any

type t_T

type t_Status_T = Complete t_T | Partial

let rec elim_Complete (_x: t_Status_T) (return (f0: t_T)) = any
  [ _k (f0: t_T) -> {Complete f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Complete] match _x with
      | Complete _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = [%#sinvariant] inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate precondition_clone (self: ()) (args: t_T)

axiom precondition_fndef:
  forall args: t_T [precondition_clone () args]. (let self_ = args in [%#sclone] inv_ref_T self_)
    -> precondition_clone () args

predicate postcondition_once_clone (self: ()) (args: t_T) (result: t_T)

axiom postcondition_fndef:
  forall args: t_T, res: t_T [postcondition_once_clone () args res]. postcondition_once_clone () args res
    -> (let self_ = args in inv_T res)

let rec clone_T (self_: t_T) (return (x: t_T)) = {[@stop_split] [@expl:clone requires] precondition_clone () self_}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self_ result}
    (! return {result}) ]

predicate inv_Status_T (_1: t_Status_T)

axiom inv_axiom [@rewrite]: forall x: t_Status_T [inv_Status_T x]. inv_Status_T x
    = match x with
      | Complete f0 -> inv_T f0
      | Partial -> true
      end

predicate invariant_ref_Status_T [@inline:trivial] (self: t_Status_T) = [%#sinvariant] inv_Status_T self

meta "rewrite_def" predicate invariant_ref_Status_T

predicate inv_ref_Status_T [@inline:trivial] (_1: t_Status_T) = invariant_ref_Status_T _1

meta "rewrite_def" predicate inv_ref_Status_T

