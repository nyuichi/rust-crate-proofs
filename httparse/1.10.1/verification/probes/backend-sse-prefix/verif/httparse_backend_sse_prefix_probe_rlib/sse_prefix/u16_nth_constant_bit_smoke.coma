let rec u16_nth_constant_bit_smoke
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 83 4 83 35]
  (return (x: ())) = (! bb0
  [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:u16_nth_constant_bit_smoke ensures] ([@stop_split] [@expl:u16_nth_constant_bit_smoke ensures #0] [%#slib] UInt16BW.nth (1: UInt16BW.t) 0)
