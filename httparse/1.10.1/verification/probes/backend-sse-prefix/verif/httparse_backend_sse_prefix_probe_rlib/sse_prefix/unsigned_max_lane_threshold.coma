let rec unsigned_max_lane_threshold
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 52 4 52 44]
  (lane: Int8.t) (return (x: ())) = (! bb0
  [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:unsigned_max_lane_threshold ensures] [%#slib] ((if byte_value lane
        >= 33 then
