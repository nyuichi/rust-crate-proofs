let rec uri_allowed_mask_16_sse (dat: __m128i) (return (x: UInt16.t)) =
  {[@stop_split] [@expl:uri_allowed_mask_16_sse 'dat' type invariant] [%#slib'5] inv___m128i dat}
  any
  [ return (result: UInt16.t) ->
  {[@stop_split] [@expl:uri_allowed_mask_16_sse ensures] ([@stop_split] [@expl:uri_allowed_mask_16_sse ensures #0] [%#slib'6] 0
        <= UInt16.t'int result
      /\ UInt16.t'int result <= 65535)
    /\ ([@stop_split] [@expl:uri_allowed_mask_16_sse ensures #1] [%#slib'7] forall i: int. 0 <= i /\ i < 16
      -> UInt16.nth result i = uri_lane_allowed (Seq.get (Slice64.view (lanes dat)) i))}
    (! return {result}) ]

let rec prefix_len_from_mask (mask: UInt16.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:prefix_len_from_mask ensures] ([@stop_split] [@expl:prefix_len_from_mask ensures #0] [%#slib'8] UInt64.t'int result
      <= 16)
    /\ ([@stop_split] [@expl:prefix_len_from_mask ensures #1] [%#slib'9] forall i: int. 0 <= i
          /\ i < UInt64.t'int result -> UInt16.nth mask i)
    /\ ([@stop_split] [@expl:prefix_len_from_mask ensures #2] [%#slib'10] UInt64.t'int result < 16
    -> not UInt16.nth mask (UInt64.t'int result))}
    (! return {result}) ]

