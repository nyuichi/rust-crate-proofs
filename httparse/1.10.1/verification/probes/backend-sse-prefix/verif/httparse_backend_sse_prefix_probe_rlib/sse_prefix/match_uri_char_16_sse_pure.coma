type __m128i

predicate inv___m128i (_1: __m128i)

function deep_model_i8 [@inline:trivial] (self: Int8.t) : int = [%#snum] Int8.to_int self

meta "rewrite_def" function deep_model_i8

function byte_value [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 22 4 22 38] (lane: Int8.t) : int
 = [%#slib'12] if deep_model_i8 lane < 0 then deep_model_i8 lane + 256 else deep_model_i8 lane

predicate uri_lane_allowed [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 31 4 31 45] (lane: Int8.t) =
  [%#slib'11] let b = byte_value lane in b >= 33 /\ b <> 127

