let rec match_uri_char_16_sse_pure
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 245 4 245 67]
  (dat: __m128i) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:match_uri_char_16_sse_pure 'dat' type invariant] [%#slib'1] inv___m128i dat}
  (! bb0
  [ bb0 = s0
    [ s0 = uri_allowed_mask_16_sse [%#slib] {dat} (fun (_x: UInt16.t) -> [ &mask <- _x ] s1)
    | s1 = prefix_len_from_mask [%#slib'0] {mask} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & dat: __m128i = dat | & mask: UInt16.t = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:match_uri_char_16_sse_pure ensures] ([@stop_split] [@expl:match_uri_char_16_sse_pure ensures #0] [%#slib'2] UInt64.t'int result
      <= 16)
    /\ ([@stop_split] [@expl:match_uri_char_16_sse_pure ensures #1] [%#slib'3] forall i: int. 0 <= i
          /\ i < UInt64.t'int result -> uri_lane_allowed (Seq.get (Slice64.view (lanes dat)) i))
    /\ ([@stop_split] [@expl:match_uri_char_16_sse_pure ensures #2] [%#slib'4] UInt64.t'int result < 16
    -> not uri_lane_allowed (Seq.get (Slice64.view (lanes dat)) (UInt64.t'int result)))}
    (! return {result}) ]
