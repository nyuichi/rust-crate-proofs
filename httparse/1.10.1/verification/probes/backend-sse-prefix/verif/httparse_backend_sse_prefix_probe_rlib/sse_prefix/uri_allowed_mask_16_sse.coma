function byte_value [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 22 4 22 38] (lane: Int8BW.t) : int
 = [%#slib'33] if deep_model_i8 lane < 0 then deep_model_i8 lane + 256 else deep_model_i8 lane

let rec _mm_max_epu8 (a: __m128i) (b: __m128i) (return (x: __m128i)) =
  {[@stop_split] [@expl:_mm_max_epu8 requires] ([@stop_split] [@expl:_mm_max_epu8 'a' type invariant] [%#slib'14] inv___m128i a)
  /\ ([@stop_split] [@expl:_mm_max_epu8 'b' type invariant] [%#slib'15] inv___m128i b)}
  any
  [ return (result: __m128i) ->
  {[@stop_split] [@expl:_mm_max_epu8 ensures] ([@stop_split] [@expl:_mm_max_epu8 result type invariant] inv___m128i result)
    /\ ([@stop_split] [@expl:_mm_max_epu8 ensures #0] [%#slib'16] Seq.length (Slice64.view (lanes result)) = 16)
    /\ ([@stop_split] [@expl:_mm_max_epu8 ensures #1] [%#slib'17] forall i: int. 0 <= i /\ i < 16
      -> Seq.get (Slice64.view (lanes result)) i
      = (if byte_value (Seq.get (Slice64.view (lanes a)) i) >= byte_value (Seq.get (Slice64.view (lanes b)) i) then
        Seq.get (Slice64.view (lanes a)) i
      else
        Seq.get (Slice64.view (lanes b)) i
      ))}
    (! return {result}) ]

let rec _mm_cmpeq_epi8 (a: __m128i) (b: __m128i) (return (x: __m128i)) =
  {[@stop_split] [@expl:_mm_cmpeq_epi8 requires] ([@stop_split] [@expl:_mm_cmpeq_epi8 'a' type invariant] [%#slib'18] inv___m128i a)
  /\ ([@stop_split] [@expl:_mm_cmpeq_epi8 'b' type invariant] [%#slib'19] inv___m128i b)}
  any
  [ return (result: __m128i) ->
  {[@stop_split] [@expl:_mm_cmpeq_epi8 ensures] ([@stop_split] [@expl:_mm_cmpeq_epi8 result type invariant] inv___m128i result)
    /\ ([@stop_split] [@expl:_mm_cmpeq_epi8 ensures #0] [%#slib'20] Seq.length (Slice64.view (lanes result)) = 16)
    /\ ([@stop_split] [@expl:_mm_cmpeq_epi8 ensures #1] [%#slib'21] forall i: int. 0 <= i /\ i < 16
      -> Seq.get (Slice64.view (lanes result)) i
      = (if Seq.get (Slice64.view (lanes a)) i = Seq.get (Slice64.view (lanes b)) i then
        Int8BW.neg (1: Int8BW.t)
      else
        (0: Int8BW.t)
      ))}
    (! return {result}) ]

let rec _mm_andnot_si128 (a: __m128i) (b: __m128i) (return (x: __m128i)) =
  {[@stop_split] [@expl:_mm_andnot_si128 requires] ([@stop_split] [@expl:_mm_andnot_si128 'a' type invariant] [%#slib'22] inv___m128i a)
