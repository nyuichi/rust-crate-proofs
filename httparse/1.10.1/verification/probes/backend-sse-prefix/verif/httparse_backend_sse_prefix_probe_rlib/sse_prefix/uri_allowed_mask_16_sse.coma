let rec _mm_set1_epi8 (a: Int8BW.t) (return (x: __m128i)) = any
  [ return (result: __m128i) ->
  {[@stop_split] [@expl:_mm_set1_epi8 ensures] ([@stop_split] [@expl:_mm_set1_epi8 result type invariant] inv___m128i result)
    /\ ([@stop_split] [@expl:_mm_set1_epi8 ensures #0] [%#slib'12] Seq.length (Slice64.view (lanes result)) = 16)
    /\ ([@stop_split] [@expl:_mm_set1_epi8 ensures #1] [%#slib'13] forall i: int. 0 <= i /\ i < 16
      -> Seq.get (Slice64.view (lanes result)) i = a)}
