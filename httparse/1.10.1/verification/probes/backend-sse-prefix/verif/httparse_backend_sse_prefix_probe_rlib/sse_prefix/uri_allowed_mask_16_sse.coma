  [ return (result: __m128i) ->
  {[@stop_split] [@expl:_mm_andnot_si128 ensures] ([@stop_split] [@expl:_mm_andnot_si128 result type invariant] inv___m128i result)
    /\ ([@stop_split] [@expl:_mm_andnot_si128 ensures #0] [%#slib'24] Seq.length (Slice64.view (lanes result)) = 16)
    /\ ([@stop_split] [@expl:_mm_andnot_si128 ensures #1] [%#slib'25] forall i: int. 0 <= i /\ i < 16
      -> Seq.get (Slice64.view (lanes result)) i
      = Int8BW.bw_and (Int8BW.bw_not (Seq.get (Slice64.view (lanes a)) i)) (Seq.get (Slice64.view (lanes b)) i))}
    (! return {result}) ]

function sign_bit [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 37 4 37 36] (lane: Int8BW.t) : int
 = [%#slib'34] if deep_model_i8 lane < 0 then 1 else 0

let rec _mm_movemask_epi8 (v: __m128i) (return (x: Int32BW.t)) =
  {[@stop_split] [@expl:_mm_movemask_epi8 'v' type invariant] [%#slib'26] inv___m128i v}
