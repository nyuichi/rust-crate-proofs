let rec movemask_narrow_preserves_bits (value: Int32BW.t) (return (x: ())) =
  {[@stop_split] [@expl:movemask_narrow_preserves_bits requires] [%#slib'29] 0 <= Int32BW.to_int value
  /\ Int32BW.to_int value <= 65535}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:movemask_narrow_preserves_bits ensures] ([@stop_split] [@expl:movemask_narrow_preserves_bits ensures #0] [%#slib'30] UInt16BW.t'int (UInt16BW.of_BV256 (Int32BW.to_BV256 value))
      = Int32BW.to_int value)
    /\ ([@stop_split] [@expl:movemask_narrow_preserves_bits ensures #1] [%#slib'31] forall i: int. 0 <= i /\ i < 16
      -> UInt16BW.nth (UInt16BW.of_BV256 (Int32BW.to_BV256 value)) i = Int32BW.nth value i)}
    (! return {result}) ]

predicate uri_lane_allowed [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 31 4 31 45] (lane: Int8BW.t) =
  [%#slib'32] let b = byte_value lane in b >= 33 /\ b <> 127

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec uri_allowed_mask_16_sse
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/backend-sse-prefix/src/lib.rs" 215 4 215 58]
  (dat: __m128i) (return (x: UInt16BW.t)) =
  {[@stop_split] [@expl:uri_allowed_mask_16_sse 'dat' type invariant] [%#slib'9] inv___m128i dat}
  (! bb0
  [ bb0 = s0
    [ s0 = _mm_set1_epi8 [%#slib'0] {[%#slib] (127: Int8BW.t)} (fun (_x: __m128i) -> [ &del <- _x ] s1)
    | s1 = _mm_set1_epi8 [%#slib'2] {[%#slib'1] (33: Int8BW.t)} (fun (_x: __m128i) -> [ &low <- _x ] s2)
    | s2 = _mm_max_epu8 [%#slib'3] {dat} {low} (fun (_x: __m128i) -> [ &_8 <- _x ] s3)
    | s3 = _mm_cmpeq_epi8 [%#slib'4] {_8} {dat} (fun (_x: __m128i) -> [ &lo <- _x ] s4)
    | s4 = _mm_cmpeq_epi8 [%#slib'5] {dat} {del} (fun (_x: __m128i) -> [ &is_del <- _x ] s5)
    | s5 = _mm_andnot_si128 [%#slib'6] {is_del} {lo} (fun (_x: __m128i) -> [ &bit <- _x ] s6)
    | s6 = _mm_movemask_epi8 [%#slib'7] {bit} (fun (_x: Int32BW.t) -> [ &raw_mask <- _x ] s7)
    | s7 = movemask_narrow_preserves_bits [%#slib'8] {raw_mask} (fun (_x: ()) -> [ &_20 <- _x ] s8)
    | s8 = UInt16BW.of_BV256 {Int32BW.to_BV256 raw_mask} (fun (_x: UInt16BW.t) -> [ &_ret <- _x ] s9)
    | s9 = return {_ret} ] ]
  [ & _ret: UInt16BW.t = Any.any_l ()
  | & dat: __m128i = dat
  | & del: __m128i = Any.any_l ()
  | & low: __m128i = Any.any_l ()
  | & lo: __m128i = Any.any_l ()
  | & _8: __m128i = Any.any_l ()
  | & is_del: __m128i = Any.any_l ()
  | & bit: __m128i = Any.any_l ()
  | & raw_mask: Int32BW.t = Any.any_l ()
  | & _20: () = Any.any_l () ])
  [ return (result: UInt16BW.t) ->
  {[@stop_split] [@expl:uri_allowed_mask_16_sse ensures] ([@stop_split] [@expl:uri_allowed_mask_16_sse ensures #0] [%#slib'10] 0
        <= UInt16BW.t'int result
      /\ UInt16BW.t'int result <= 65535)
    /\ ([@stop_split] [@expl:uri_allowed_mask_16_sse ensures #1] [%#slib'11] forall i: int. 0 <= i /\ i < 16
      -> UInt16BW.nth result i = uri_lane_allowed (Seq.get (Slice64.view (lanes dat)) i))}
    (! return {result}) ]
