  {[@stop_split] [@expl:_mm_movemask_epi8 ensures] ([@stop_split] [@expl:_mm_movemask_epi8 ensures #0] [%#slib'27] 0
        <= Int32BW.to_int result
      /\ Int32BW.to_int result <= 65535)
    /\ ([@stop_split] [@expl:_mm_movemask_epi8 ensures #1] [%#slib'28] forall i: int. 0 <= i /\ i < 16
      -> Int32BW.nth result i = (sign_bit (Seq.get (Slice64.view (lanes v)) i) = 1))}
