constant size_of_u8: int = 1

meta "rewrite_def" constant size_of_u8

axiom size_of_u8_spec: [%#smem] 0 <= size_of_u8

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function offset_ptr_u8 (self: Opaque.ptr) (offset: int) : Opaque.ptr

axiom offset_ptr_u8_spec: forall self: Opaque.ptr, offset: int. ([%#sptr'3] 0
      <= UInt64.t'int (Ptr.addr_logic_u64 self) + offset * size_of_u8)
    -> ([%#sptr'4] UInt64.t'int (Ptr.addr_logic_u64 self) + offset * size_of_u8 <= UInt64.t'int const_MAX)
    -> ([%#sptr'5] UInt64.t'int (Ptr.addr_logic_u64 (offset_ptr_u8 self offset))
    = UInt64.t'int (Ptr.addr_logic_u64 self) + offset * size_of_u8)

function sub_ptr_u8 (self: Opaque.ptr) (rhs: Opaque.ptr) : int

function sub_offset_ptr_u8 (self: Opaque.ptr) (offset: int) : ()

axiom sub_offset_ptr_u8_spec:
  forall self: Opaque.ptr, offset: int. [%#sptr'2] sub_ptr_u8 (offset_ptr_u8 self offset) self = offset

function sub_logic_refl_ptr_u8 (self: Opaque.ptr) : ()

axiom sub_logic_refl_ptr_u8_spec: forall self: Opaque.ptr. [%#sptr'1] sub_ptr_u8 self self = 0

function offset_logic_assoc_ptr_u8 (self: Opaque.ptr) (offset1: int) (offset2: int) : ()

axiom offset_logic_assoc_ptr_u8_spec:
  forall self: Opaque.ptr, offset1: int, offset2: int. [%#sptr'0] offset_ptr_u8 (offset_ptr_u8 self offset1) offset2
    = offset_ptr_u8 self (offset1 + offset2)

function offset_logic_zero_ptr_u8 (self: Opaque.ptr) : ()

axiom offset_logic_zero_ptr_u8_spec: forall self: Opaque.ptr. [%#sptr] offset_ptr_u8 self 0 = self

