  [ & _ret: t_T = Any.any_l () | & self: t_Status_T = self | & t: t_T = Any.any_l () ])
  [ return (result: t_T) ->
  {[@stop_split] [@expl:unwrap_T ensures] ([@stop_split] [@expl:unwrap result type invariant] [%#sstatus'1] inv_T result)
    /\ ([@stop_split] [@expl:unwrap ensures] [%#sstatus'2] match self with
      | Complete value -> result = value
