use creusot.prelude.Any

type t_T

type t_Status_T = Complete t_T | Partial

let rec elim_Complete (_x: t_Status_T) (return (f0: t_T)) = any
  [ _k (f0: t_T) -> {Complete f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Complete] match _x with
      | Complete _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_T (_1: t_T)

predicate inv_Status_T (_1: t_Status_T)

axiom inv_axiom [@rewrite]: forall x: t_Status_T [inv_Status_T x]. inv_Status_T x
    = match x with
      | Complete f0 -> inv_T f0
      | Partial -> true
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec unwrap_T
  [#"/workspace/rust-crate-proofs/httparse/1.10.1/verification/probes/newline-harness/string/../src/../../../../src/status.rs" 60 4 60 28]
  (self: t_Status_T) (return (x: t_T)) =
  {[@stop_split] [@expl:unwrap_T requires] ([@stop_split] [@expl:unwrap 'self' type invariant] [%#sstatus] inv_Status_T self)
  /\ ([@stop_split] [@expl:unwrap requires] [%#sstatus'0] match self with
