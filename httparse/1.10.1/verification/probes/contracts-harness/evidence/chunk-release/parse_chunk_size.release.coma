      /\ next_pos <= Seq.length input
      /\ 0 <= next.digits'0
      /\ next.digits'0 <= 16
      /\ 0 <= next.size'0
      /\ next.size'0 < hex_capacity next.digits'0
      /\ (next.digits'0 < 16 -> next.size'0 <= ComputerDivision.div (UInt64.t'int const_MAX) 16)
