ndex":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":186}],"output":{"Deduplicated":57}},"default":null},"kind":{"TraitMethod":[4,0]}}],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":189,"col":0},"end":{"line":189,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Base trait for random number generators and random data sources"},{"DocComment":""},{"DocComment":" This trait provides a base interface designed to support efficient usage of"},{"DocComment":" (`u32`, `u64`) word generators, block generators and random data sources."},{"DocComment":" There is no required relationship between the output of each method or any"},{"DocComment":" requirement to use all generated random bits; for example an implementation"},{"DocComment":" of [`try_fill_bytes`](Self::try_fill_bytes) may discard some generated bytes"},{"DocComment":" to avoid storing a partially used word or block."},{"DocComment":""},{"DocComment":" # Requirements"},{"DocComment":""},{"DocComment":" ### Quality and length"},{"DocComment":""},{"DocComment":" Implementions should produce bits uniformly: each output value should be"},{"DocComment":" equally likely, without observable patterns in successive outputs or"},{"DocComment":" between the output streams of multiple instances of an implementation using"},{"DocComment":" different seeds or streams (where supported by the implementation)."},{"DocComment":""},{"DocComment":" Pathological implementations (e.g. constant or counting generators which"},{"DocComment":" rarely change some bits) may cause issues in consumers of random data, for"},{"DocComment":" example dead-locks in rejection samplers and obviously non-random output"},{"DocComment":" (e.g. a counting generator may result in apparently-constant output from a"},{"DocComment":" uniform-ranged distribution)."},{"DocComment":""},{"DocComment":" Cryptographically unpredictable output is not a requirement of this trait,"},{"DocComment":" but is a requirement of [`TryCryptoRng`]."},{"DocComment":""},{"DocComment":" In practice, most implementations are pseudo-random number generators with a"},{"DocComment":" finite *period* or *cycle length*, and (among non-cryptographic PRNGs)"},{"DocComment":" statistical anomalies may appear long before a cycle occurs. An"},{"DocComment":" implementation should ensure its period is sufficiently long that no"},{"DocComment":" anomalies are likely to appear in usage and/or document its limitations."},{"DocComment":""},{"DocComment":" For more on PRNG quality and period, see [The Rust Rand Book: Quality][0]."},{"DocComment":""},{"DocComment":" [0]: https://rust-random.github.io/book/guide-rngs.html#quality"},{"DocComment":""},{"DocComment":" ### Reproducibility"},{"DocComment":""},{"DocComment":" Algorithmic generators implementing [`SeedableRng`] should normally have"},{"DocComment":" *portable, reproducible* output, i.e. fix Endianness when converting values"},{"DocComment":" to avoid platform differences, and avoid making any changes which affect"},{"DocComment":" output (except by communicating that the release has breaking changes)."},{"DocComment":" See also [The Rust Rand Book: Reproducibility][1]."},{"DocComment":""},{"DocComment":" [1]: https://rust-random.github.io/book/crate-reprod.html"},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" Often, usage of the infallible trait [`Rng`] or its extension trait"},{"DocComment":" [`rand::RngExt`] is preferred to direct usage of `TryRng`."},{"DocComment":" Many implementations of `TryRng` (those with <code>type Error = [Infallible][]</code>)"},{"DocComment":" already implement [`Rng`]; in other cases [`UnwrapErr`] may be used to obtain"},{"DocComment":" an implementation of [`Rng`]."},{"DocComment":""},{"DocComment":" # Implementing `TryRng`"},{"DocComment":""},{"DocComment":" Most algorithmic generators (i.e. pseudo-random number generators or PRNGs)"},{"DocComment":" never fail; in this case type `Error` should be [`Infallible`]; in this case"},{"DocComment":" trait `Rng` is implemented automatically. Cycling is not considered an"},{"DocComment":" error."},{"DocComment":""},{"DocComment":" Small PRNGs often yield either `u32` or `u64` natively."},{"DocComment":" Module [`crate::utils`] provides utilities to help implement other methods."},{"DocComment":""},{"DocComment":" Byte sources may implement [`try_fill_bytes`](Self::try_fill_bytes)"},{"DocComment":" natively."},{"DocComment":" Module [`crate::utils`] provides utilities to help implement other methods."},{"DocComment":""},{"DocComment":" Block generators (which produce `[u32; N]` or `[u64; N]` for some fixed `N`)"},{"DocComment":" should make use of the [`crate::block`] module."},{"DocComment":""},{"DocComment":" With regards to other traits:"},{"DocComment":""},{"DocComment":" - **Do not** implement [`Default`] for seedable pseudorandom generators,"},{"DocComment":"   though the trait may be implemented for stateless interfaces and"},{"DocComment":"   auto-seeding generators."},{"DocComment":" - **Do** implement [`SeedableRng`] for seedable pseudorandom generators. See"},{"DocComment":"   [Reproducibility](#reproducibility) above."},{"DocComment":" - Implement [`Clone`] for non-cryptographic PRNGs but consider not doing so"},{"DocComment":"   for cryptographic generators to avoid the risk of key-stream duplication."},{"DocComment":" - **Do not** implement [`Copy`] since accidental copies may cause repeated"},{"DocComment":"   values."},{"DocComment":" - Implement [`Debug`](core::fmt::Debug), except that cryptographic PRNGs"},{"DocComment":"   should use a custom implementation which avoids leaking internal state (or"},{"DocComment":"   the subset of this derived from the key)."},{"DocComment":" - [`Eq`] and [`PartialEq`] could be implemented, but are probably not useful."},{"DocComment":""},{"DocComment":" [`rand::RngExt`]: https://docs.rs/rand/latest/rand/trait.RngExt.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[954,{"data":{"file_id":14,"beg":{"line":193,"col":16},"end":{"line":193,"col":34}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_next_u32","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]},{"Ident":["try_next_u32",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":196,"col":4},"end":{"line":196,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u32`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":186}],"output":{"Value":[187,{"Adt":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":52},{"Deduplicated":5}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[5,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_next_u64","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]},{"Ident":["try_next_u64",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":198,"col":4},"end":{"line":198,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u64`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":186}],"output":{"Value":[188,{"Adt":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":3},{"Deduplicated":5}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[5,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_fill_bytes","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]},{"Ident":["try_fill_bytes",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":200,"col":4},"end":{"line":200,"col":76}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fill `dst` entirely with random data."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":186},{"Value":[189,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":9},"Mut"]}]}],"output":{"Value":[190,{"Adt":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":57},{"Deduplicated":5}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[5,2]}}],"vtable":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Error",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":59,"col":0},"end":{"line":59,"col":32}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Error` is a trait representing the basic expectations for error values,"},{"DocComment":" i.e., values of type `E` in [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" Errors must describe themselves through the [`Display`] and [`Debug`]"},{"DocComment":" traits. Error messages are typically concise lowercase sentences without"},{"DocComment":" trailing punctuation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let err = \"NaN\".parse::<u32>().unwrap_err();"},{"DocComment":" assert_eq!(err.to_string(), \"invalid digit found in string\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Error source"},{"DocComment":""},{"DocComment":" Errors may provide cause information. [`Error::source()`] is generally"},{"DocComment":" used when errors cross \"abstraction boundaries\". If one module must report"},{"DocComment":" an error that is caused by an error from a lower-level module, it can allow"},{"DocComment":" accessing that error via `Error::source()`. This makes it possible for the"},{"DocComment":" high-level module to provide its own errors while also revealing some of the"},{"DocComment":" implementation for debugging."},{"DocComment":""},{"DocComment":" In error types that wrap an underlying error, the underlying error"},{"DocComment":" should be either returned by the outer error's `Error::source()`, or rendered"},{"DocComment":" by the outer error's `Display` implementation, but not both."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Implementing the `Error` trait only requires that `Debug` and `Display` are implemented too."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::error::Error;"},{"DocComment":" use std::fmt;"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct ReadConfigError {"},{"DocComment":"     path: PathBuf"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for ReadConfigError {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         let path = self.path.display();"},{"DocComment":"         write!(f, \"unable to read configuration at {path}\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Error for ReadConfigError {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Error","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[955,{"data":{"file_id":23,"beg":{"line":59,"col":17},"end":{"line":59,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[956,{"data":{"file_id":23,"beg":{"line":59,"col":25},"end":{"line":59,"col":32}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null,null,null,null],"vtable":{"id":17,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":175},{"Value":[191,{"Ref":[{"Var":{"Bound":[0,1]}},{"Value":[192,{"Adt":{"id":32,"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Mut"]}]}],"output":{"Deduplicated":167}},"default":null},"kind":{"TraitMethod":[7,0]}}],"vtable":{"id":31,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1187,"col":0},"end":{"line":1187,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Format trait for an empty format, `{}`."},{"DocComment":""},{"DocComment":" Implementing this trait for a type will automatically implement the"},{"DocComment":" [`ToString`][tostring] trait for the type, allowing the usage"},{"DocComment":" of the [`.to_string()`][tostring_function] method. Prefer implementing"},{"DocComment":" the `Display` trait for a type, rather than [`ToString`][tostring]."},{"DocComment":""},{"DocComment":" `Display` is similar to [`Debug`], but `Display` is for user-facing"},{"DocComment":" output, and so cannot be derived."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":" [tostring]: ../../std/string/trait.ToString.html"},{"DocComment":" [tostring_function]: ../../std/string/trait.ToString.html#tymethod.to_string"},{"DocComment":""},{"DocComment":" # Completeness and parseability"},{"DocComment":""},{"DocComment":" `Display` for a type might not necessarily be a lossless or complete representation of the type."},{"DocComment":" It may omit internal state, precision, or other information the type does not consider important"},{"DocComment":" for user-facing output, as determined by the type. As such, the output of `Display` might not be"},{"DocComment":" possible to parse, and even if it is, the result of parsing might not exactly match the original"},{"DocComment":" value."},{"DocComment":""},{"DocComment":" However, if a type has a lossless `Display` implementation whose output is meant to be"},{"DocComment":" conveniently machine-parseable and not just meant for human consumption, then the type may wish"},{"DocComment":" to accept the same format in `FromStr`, and document that usage. Having both `Display` and"},{"DocComment":" `FromStr` implementations where the result of `Display` cannot be parsed with `FromStr` may"},{"DocComment":" surprise users."},{"DocComment":""},{"DocComment":" # Internationalization"},{"DocComment":""},{"DocComment":" Because a type can only have one `Display` implementation, it is often preferable"},{"DocComment":" to only implement `Display` when there is a single most \"obvious\" way that"},{"DocComment":" values can be formatted as text. This could mean formatting according to the"},{"DocComment":" \"invariant\" culture and \"undefined\" locale, or it could mean that the type"},{"DocComment":" display is designed for a specific culture/locale, such as developer logs."},{"DocComment":""},{"DocComment":" If not all values have a justifiably canonical textual format or if you want"},{"DocComment":" to support alternative formats not covered by the standard set of possible"},{"DocComment":" [formatting traits], the most flexible approach is display adapters: methods"},{"DocComment":" like [`str::escape_default`] or [`Path::display`] which create a wrapper"},{"DocComment":" implementing `Display` to output the specific display format."},{"DocComment":""},{"DocComment":" [formatting traits]: ../../std/fmt/index.html#formatting-traits"},{"DocComment":" [`Path::display`]: ../../std/path/struct.Path.html#method.display"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Implementing `Display` on a type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"The origin is: {origin}\"), \"The origin is: (0, 0)\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Display","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1212,"col":4},"end":{"line":1212,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.longitude, self.latitude)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     \"(1.987, 2.983)\","},{"DocComment":"     format!(\"{}\", Position { longitude: 1.987, latitude: 2.983, }),"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":175},{"Deduplicated":191}],"output":{"Deduplicated":167}},"default":null},"kind":{"TraitMethod":[8,0]}}],"vtable":{"id":34,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":9,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["word",0]},{"Ident":["Word",0]}],"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":6,"col":0},"end":{"line":6,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker trait for supported \"word\" types."},{"DocComment":""},{"DocComment":" This is implemented for: `u32`, `u64`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Bytes","variance":"Invariant"},{"index":2,"name":"Self_Clause0_Clause2_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[957,{"data":{"file_id":30,"beg":{"line":6,"col":16},"end":{"line":6,"col":30}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":4},{"Deduplicated":5},{"Deduplicated":37}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnMut",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":163,"col":0},"end":{"line":163,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a mutable receiver."},{"DocComment":""},{"DocComment":" Instances of `FnMut` can be called repeatedly and may mutate state."},{"DocComment":""},{"DocComment":" `FnMut` is implemented automatically by closures which take mutable"},{"DocComment":" references to captured variables, as well as all types that implement"},{"DocComment":" [`Fn`], e.g., (safe) [function pointers] (since `FnMut` is a supertrait of"},{"DocComment":" [`Fn`]). Additionally, for any type `F` that implements `FnMut`, `&mut F`"},{"DocComment":" implements `FnMut`, too."},{"DocComment":""},{"DocComment":" Since [`FnOnce`] is a supertrait of `FnMut`, any instance of `FnMut` can be"},{"DocComment":" used where a [`FnOnce`] is expected, and since [`Fn`] is a subtrait of"},{"DocComment":" `FnMut`, any instance of [`Fn`] can be used where `FnMut` is expected."},{"DocComment":""},{"DocComment":" Use `FnMut` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and need to call it repeatedly, while allowing it to mutate state."},{"DocComment":" If you don't want the parameter to mutate state, use [`Fn`] as a"},{"DocComment":" bound; if you don't need to call it repeatedly, use [`FnOnce`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Calling a mutably capturing closure"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = 5;"},{"DocComment":" {"},{"DocComment":"     let mut square_x = || x *= x;"},{"DocComment":"     square_x();"},{"DocComment":" }"},{"DocComment":" assert_eq!(x, 25);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Using a `FnMut` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn do_twice<F>(mut func: F)"},{"DocComment":"     where F: FnMut()"},{"DocComment":" {"},{"DocComment":"     func();"},{"DocComment":"     func();"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x: usize = 1;"},{"DocComment":" {"},{"DocComment":"     let add_two_to_x = || x += 2;"},{"DocComment":"     do_twice(add_two_to_x);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(x, 5);"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[958,{"data":{"file_id":31,"beg":{"line":163,"col":36},"end":{"line":163,"col":48}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"ge