+        .unwrap();
+        recorded.sarif["runs"][0]["versionControlProvenance"][0]["revisionId"] =
+            json!(crate::git::run(root, &["rev-parse", "HEAD"]).unwrap());
+        fs::remove_file(&project.manifest).unwrap();
