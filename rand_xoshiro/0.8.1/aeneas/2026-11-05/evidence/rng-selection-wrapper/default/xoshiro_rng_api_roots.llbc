{"DocComment":" Implement [`TryRng`] with <code>type Error = [core::convert::Infallible][]</code>."},{"DocComment":""},{"DocComment":" [`rand`]: https://docs.rs/rand/"},{"DocComment":" [`rand::RngExt`]: https://docs.rs/rand/latest/rand/trait.RngExt.html"},{"DocComment":" [`fill_bytes`]: Rng::fill_bytes"},{"DocComment":" [`next_u32`]: Rng::next_u32"},{"DocComment":" [`next_u64`]: Rng::next_u64"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1580,{"data":{"file_id":13,"beg":{"line":49,"col":15},"end":{"line":49,"col":41}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":5},{"Deduplicated":14}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next_u32","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["Rng",0]},{"Ident":["next_u32",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":51,"col":4},"end":{"line":51,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u32`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi"