  A,"},{"DocComment":"     C,"},{"DocComment":"     G,"},{"DocComment":"     T,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct NucleotideCount {"},{"DocComment":"     a: usize,"},{"DocComment":"     c: usize,"},{"DocComment":"     g: usize,"},{"DocComment":"     t: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Nucleotide> for NucleotideCount {"},{"DocComment":"     type Output = usize;"},{"DocComment":""},{"DocComment":"     fn index(&self, nucleotide: Nucleotide) -> &Self::Output {"},{"DocComment":"         match nucleotide {"},{"DocComment":"             Nucleotide::A => &self.a,"},{"DocComment":"             Nucleotide::C => &self.c,"},{"DocComment":"             Nucleotide::G => &self.g,"},{"DocComment":"             Nucleotide::T => &self.t,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let nucleotide_count = NucleotideCount {a: 14, c: 9, g: 10, t: 12};"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::A], 14);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::C], 9);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::G], 10);"},{"DocComment":" assert_eq!(nucleotide_count[Nucleotide::T], 12);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Index","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":3,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":124,"col":0},"end":{"line":124,"col":56}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A helper trait used for indexing operations."},{"DocComment":""},{"DocComment":" Implementations of this trait have to promise that if the argument"},{"DocComment":" to `get_unchecked(_mut)` is a safe reference, then so is the result."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"SliceIndex","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":4,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":170,"col":0},"end":{"line":170,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[48,{"data":{"file_id":6,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Value":[92,{"TypeVar":{"Free":0}}]},{"Value":[93,{"TypeVar":{"Free":1}}]}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":{"id":5,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":3,"item_meta":{"name":[{"Ident":["bit_field",0]},{"Ident":["BitField",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":13,"col":0},"end":{"line":109,"col":1}},"generated_from_span":null}},"source_text":"pub trait BitField {\n    /// The number of bits in this bit field.\n    ///\n    /// ```rust\n    /// use bit_field::BitField;\n    ///\n    /// assert_eq!(u32::BIT_LENGTH, 32);\n    /// assert_eq!(u64::BIT_LENGTH, 64);\n    /// ```\n    const BIT_LENGTH: usize;\n\n    /// Obtains the bit at the index `bit`; note that index 0 is the least significant bit, while\n    /// index `length() - 1` is the most significant bit.\n    ///\n    /// ```rust\n    /// use bit_field::BitField;\n    ///\n    /// let value: u32 = 0b110101;\n    ///\n    /// assert_eq!(value.get_bit(1), false);\n    /// assert_eq!(value.get_bit(2), true);\n    /// ```\n    ///\n    /// ## Panics\n    ///\n    /// This method will panic if the bit index is out of bounds of the bit field.\n    fn get_bit(&self, bit: usize) -> bool;\n\n    /// Obtains the range of bits specified by `range`; note that index 0 is the least significant\n    /// bit, while index `length() - 1` is the most significant bit.\n    ///\n    /// ```rust\n    /// use bit_field::BitField;\n    ///\n    /// let value: u32 = 0b110101;\n    ///\n    /// assert_eq!(value.get_bits(0..3), 0b101);\n    /// assert_eq!(value.get_bits(2..6), 0b1101);\n    /// assert_eq!(value.get_bits(..), 0b110101);\n    /// assert_eq!(value.get_bits(3..=3), value.get_bit(3) as u32);\n    /// ```\n    ///\n    /// ## Panics\n    ///\n    /// This method will panic if the start or end indexes of the range are out of bounds of the\n    /// bit field.\n    fn get_bits<T: RangeBounds<usize>>(&self, range: T) -> Self;\n\n    /// Sets the bit at the index `bit` to the value `value` (where true means a value of '1' and\n    /// false means a value of '0'); note that index 0 is the least significant bit, while index\n    /// `length() - 1` is the most significant bit.\n    ///\n    /// ```rust\n    /// use bit_field::BitField;\n    ///\n    /// let mut value = 0u32;\n    ///\n    /// value.set_bit(1, true);\n    /// assert_eq!(value, 2u32);\n    ///\n    /// value.set_bit(3, true);\n    /// assert_eq!(value, 10u32);\n    ///\n    /// value.set_bit(1, false);\n    /// assert_eq!(value, 8u32);\n    /// ```\n    ///\n    /// ## Panics\n    ///\n    /// This method will panic if the bit index is out of the bounds of the bit field.\n    fn set_bit(&mut self, bit: usize, value: bool) -> &mut Self;\n\n    /// Sets the range of bits defined by the range `range` to the lower bits of `value`; to be\n    /// specific, if the range is N bits long, the N lower bits of `value` will be used; if any of\n    /// the other bits in `value` are set to 1, this function will panic.\n    ///\n    /// ```rust\n    /// use bit_field::BitField;\n    ///\n    /// let mut value = 0u32;\n    ///\n    /// value.set_bits(0..2, 0b11);\n    /// assert_eq!(value, 0b11);\n    ///\n    /// value.set_bits(2..=3, 0b11);\n    /// assert_eq!(value, 0b1111);\n    ///\n    /// value.set_bits(..4, 0b1010);\n    /// assert_eq!(value, 0b1010);\n    /// ```\n    ///\n    /// ## Panics\n    ///\n    /// This method will panic if the range is out of bounds of the bit field, or if there are `1`s\n    /// not in the lower N bits of `value`.\n    fn set_bits<T: RangeBounds<usize>>(&mut self, range: T, value: Self) -> &mut Self;\n}","attr_info":{"attributes":[{"DocComment":" A generic trait which provides methods for extracting and setting specific bits or ranges of"},{"DocComment":" bits."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":null}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":382,"col":0},"end":{"line":384,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":0,"generics