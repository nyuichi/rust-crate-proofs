0]},{"Ident":["TryRng",0]},{"Ident":["try_next_u64",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":198,"col":4},"end":{"line":198,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u64`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156}],"output":{"Deduplicated":116}},"default":null},"kind":{"TraitMethod":[9,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_fill_bytes","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["TryRng",0]},{"Ident":["try_fill_bytes",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":200,"col":4},"end":{"line":200,"col":76}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fill `dst` entirely with random data."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156},{"Value":[161,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":9},"Mut"]}]}],"output":{"Deduplicated":105}},"default":null},"kind":{"TraitMethod":[9,2]}}],"vtable":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Error",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":59,"col":0},"end":{"line":59,"col":32}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Error` is a trait representing the basic expectations for error values,"},{"DocComment":" i.e., values of type `E` in [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" Errors must describe themselves through the [`Display`] and [`Debug`]"},{"DocComment":" traits. Error messages are typically concise lowercase sentences without"},{"DocComment":" trailing punctuation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let err = \"NaN\".parse::<u32>().unwrap_err();"},{"DocComment":" assert_eq!(err.to_string(), \"invalid digit found in string\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Error source"},{"DocComment":""},{"DocComment":" Errors may provide cause information. [`Error::source()`] is generally"},{"DocComment":" used when errors cross \"abstraction boundaries\". If one module must report"},{"DocComment":" an error that is caused by an error from a lower-level module, it can allow"},{"DocComment":" accessing that error via `Error::source()`. This makes it possible for the"},{"DocComment":" high-level module to provide its own errors while also revealing some of the"},{"DocComment":" implementation for debugging."},{"DocComment":""},{"DocComment":" In error types that wrap an underlying error, the underlying error"},{"DocComment":" should be either returned by the outer error's `Error::source()`, or rendered"},{"DocComment":" by the outer error's `Display` implementation, but not both."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Implementing the `Error` trait only requires that `Debug` and `Display` are implemented too."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::error::Error;"},{"DocComment":" use std::fmt;"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct ReadConfigError {"},{"DocComment":"     path: PathBuf"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for ReadConfigError {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         let path = self.path.display();"},{"DocComment":"         write!(f, \"unable to read configuration at {path}\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Error for ReadConfigError {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Error","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[329,{"data":{"file_id":16,"beg":{"line":59,"col":17},"end":{"line":59,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[330,{"data":{"file_id":16,"beg":{"line":59,"col":25},"end":{"line":59,"col":32}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null,null,null,null],"vtable":{"id":17,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":11,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["seedable_rng",0]},{"Ident":["SeedableRng",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":14,"col":0},"end":{"line":14,"col":28}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A random number generator that can be explicitly seeded."},{"DocComment":""},{"DocComment":" This trait encapsulates the low-level functionality common to all"},{"DocComment":" pseudo-random number generators (PRNGs, or algorithmic generators)."},{"DocComment":""},{"DocComment":" A generator implementing `SeedableRng` will usually be deterministic, but"},{"DocComment":" beware that portability and reproducibility of results **is not implied**."},{"DocComment":" Refer to documentation of the generator, noting that generators named after"},{"DocComment":" a specific algorithm are usually tested for reproducibility against a"},{"DocComment":" reference vector, while `SmallRng` and `StdRng` specifically opt out of"},{"DocComment":" reproducibility guarantees."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Seed","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[331,{"data":{"file_id":17,"beg":{"line":66,"col":15},"end":{"line":66,"col":20}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[332,{"data":{"file_id":17,"beg":{"line":66,"col":23},"end":{"line":66,"col":30}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[333,{"data":{"file_id":17,"beg":{"line":66,"col":33},"end":{"line":66,"col":44}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[334,{"data":{"file_id":17,"beg":{"line":66,"col":47},"end":{"line":66,"col":58}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"from_seed","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["seedable_rng",0]},{"Ident":["SeedableRng",0]},{"Ident":["from_seed",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":93,"col":4},"end":{"line":93,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Create a new PRNG using the given seed."},{"DocComment":""},{"DocComment":" PRNG implementations are allowed to assume that bits in the seed are"},{"DocComment":" well distributed. That means usually that the number of one and zero"},{"DocComment":" bits are roughly equal, and values like 0, 1 and (size - 1) are unlikely."},{"DocComment":" Note that many non-cryptographic PRNGs will show poor quality output"},{"DocComment":" if this is not adhered to. If you wish to seed from simple numbers, use"},{"DocComment":" `seed_from_u64` instead."},{"DocComment":""},{"DocComment":" All PRNG implementations should be reproducible unless otherwise noted:"},{"DocComment":" given a fixed `seed`, the same sequence of output should be produced"},{"DocComment":" on all runs, library versions and architectures (e.g. check endianness)."},{"DocComment":" Any \"value-breaking\" changes to the generator should require bumping at"},{"DocComment":" least the minor version and documentation of the change."},{"DocComment":""},{"DocComment":" It is not required that this function yield the same state as a"},{"DocComment":" reference implementation of the PRNG given equivalent seed; if necessary"},{"DocComment":" another constructor replicating behaviour from a reference"},{"DocComment":" implementation can be added."},{"DocComment":""},{"DocComment":" PRNG implementations should make sure `from_seed` never panics. In the"},{"DocComment":" case that some special values (like an all zero seed) are not viable"},{"DocComment":" seeds it is preferable to map these to alternative constant value(s),"},{"DocComment":" for example `0xBAD5EEDu32` or `0x0DDB1A5E5BAD5EEDu64` (\"odd biases? bad"},{"DocComment":" seed\"). This is assuming only a small number of values must be rejected."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":8}],"output":{"Deduplicated":6}},"default":null},"kind":{"TraitMethod":[11,0]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"R","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":140},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"from_rng","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["seedable_rng",0]},{"Ident":["SeedableRng",0]},{"Ident":["from_rng",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":147,"col":4},"end":{"line":147,"col":53}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Create a new PRNG seeded from an infallible `Rng`."},{"DocComment":""},{"DocComment":" This may be useful when needing to rapidly seed many PRNGs from a master"},{"DocComment":" PRNG, and to allow forking of PRNGs. It may be considered deterministic."},{"DocComment":""},{"DocComment":" The master PRNG should be at least as high quality as the child PRNGs."},{"DocComment":" When seeding non-cryptographic child PRNGs, we recommend using a"},{"DocComment":" different algorithm for the master PRNG (ideally a CSPRNG) to avoid"},{"DocComment":" correlations between the child PRNGs. If this is not possible (e.g."},{"DocComment":" forking using small non-crypto PRNGs) ensure that your PRNG has a good"},{"DocComment":" mixing function on the output or consider use of a hash function with"},{"DocComment":" `from_seed`."},{"DocComment":""},{"DocComment":" Note that seeding `XorShiftRng` from another `XorShiftRng` provides an"},{"DocComment":" extreme example of what can go wrong: the new PRNG will be a clone"},{"DocComment":" of the parent."},{"DocComment":""},{"DocComment":" PRNG implementations are allowed to assume that a good RNG is provided"},{"DocComment":" for seeding, and that it is cryptographically secure when appropriate."},{"DocComment":" As of `rand` 0.7 / `rand_core` 0.5, implementations overriding this"},{"DocComment":" method should ensure the implementation satisfies reproducibility"},{"DocComment":" (in prior versions this was not required)."},{"DocComment":""},{"DocComment":" [`rand`]: https://docs.rs/rand"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[162,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":2},"Mut"]}]}],"output":{"Deduplicated":6}},"default":{"id":32,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":8}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Value":[24,{"kind":"SelfId","trait_decl_ref":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Value":[25,{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[11,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"R","variance":"Invariant"},{"index":1,"name":"Clause0_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":141},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Value":[163,{"TypeVar":{"Bound":[1,1]}}]}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_from_rng","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["seedable_rng",0]},{"Ident":["SeedableRng",0]},{"Ident":["try_from_rng",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":156,"col":4},"end":{"line":156,"col":78}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Create a new PRNG seeded from a potentially fallible `Rng`."},{"DocComment":""},{"DocComment":" See [`from_rng`][SeedableRng::from_rng] docs for more information."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":162}],"output":{"Value":[164,{"Adt":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Value":[165,{"TypeVar":{"Bound":[0,1]}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":{"id":33,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":8},{"Deduplicated":165}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Deduplicated":24}},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Value":[26,{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":163}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[11,3]}},null,null],"vtable":null},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["default",0]},{"Ident":["Default",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":107,"col":0},"end":{"line":107,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for giving a type a useful default value."},{"DocComment":""},{"DocComment":" Sometimes, you want to fall back to some kind of default value, and"},{"DocComment":" don't particularly care what it is. This comes up often with `struct`s"},{"DocComment":" that define a set of options:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" struct SomeOptions {"},{"DocComment":"     foo: i32,"},{"DocComment":"     bar: f32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" How can we define some default values? You can use `Default`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct SomeOptions {"},{"DocComment":"     foo: i32,"},{"DocComment":"     bar: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let options: SomeOptions = Default::default();"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Now, you get all of the default values. Rust implements `Default` for various primitive types."},{"DocComment":""},{"DocComment":" If you want to override a particular option, but still retain the other defaults:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" # #[derive(Default)]"},{"DocComment":" # struct SomeOptions {"},{"DocComment":" #     foo: i32,"},{"DocComment":" #     bar: f32,"},{"DocComment":" # }"},{"DocComment":" fn main() {"},{"DocComment":"     let options = SomeOptions { foo: 42, ..Default::default() };"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all of the type's fields implement"},{"DocComment":" `Default`. When `derive`d, it will use the default value for each field's type."},{"DocComment":""},{"DocComment":" ### `enum`s"},{"DocComment":""},{"DocComment":" When using `#[derive(Default)]` on an `enum`, you need to choose which unit variant will be"},{"DocComment":" default. You do this by placing the `#[default]` attribute on the variant."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Default)]"},{"DocComment":" enum Kind {"},{"DocComment":"     #[default]"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You cannot use the `#[default]` attribute on non-unit or non-exhaustive variants."},{"DocComment":""},{"DocComment":" The `#[default]` attribute was stabilized in Rust 1.62.0."},{"DocComment":""},{"DocComment":" ## How can I implement `Default`?"},{"DocComment":""},{"DocComment":" Provide an implementation for the `default()` method that returns the value of"},{"DocComment":" your type that should be the default:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" enum Kind {"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Default for Kind {"},{"DocComment":"     fn default() -> Self { Kind::A }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct SomeOptions {"},{"DocComment":"     foo: i32,"},{"DocComment":"     bar: f32,"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Default","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"default","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["default",0]},{"Ident":["Default",0]},{"Ident":["default",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":139,"col":4},"end":{"line":139,"col":25}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the \"default value\" for a type."},{"DocComment":""},{"DocComment":" Default values are often some kind of initial value, identity value, or anything else that"},{"DocComment":" may make sense as a default."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using built-in default values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let i: i8 = Default::default();"},{"DocComment":" let (x, y): (Option<String>, f64) = Default::default();"},{"DocComment":" let (a, b, (c, d)): (i32, u32, (bool, bool)) = Default::default();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Making your own:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" enum Kind {"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Default for Kind {"},{"DocComment":"     fn default() -> Self { Kind::A }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"default_fn","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":6}},"default":null},"kind":{"TraitMethod":[12,0]}}],"vtable":null},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":220,"col":0},"end":{"line":220,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsRef","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_ref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]},{"Ident":["as_ref",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":223,"col":4},"end":{"line":223,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a shared reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":145}],"output":{"Deduplicated":147}},"default":null},"kind":{"TraitMethod":[13,0]}}],"vtable":{"id":22,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":372,"col":0},"end":{"line":372,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap mutable-to-mutable reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsRef`] but used for converting between mutable"},{"DocComment":" references. If you need to do a costly conversion it is better to"},{"DocComment":" implement [`From`] with type `&mut T` or write a custom function."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsMut` auto-dereferences if the inner type is a mutable reference"},{"DocComment":" (e.g.: `foo.as_mut()` will work the same if `foo` has type `&mut Foo` or `&mut &mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [mutably dereferenceable types], e.g. `foo.as_mut()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_mut()`. Instead, many smart pointers provide an `as_mut` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsMut::as_mut`] should not be"},{"DocComment":" used for the sole purpose of mutable dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [mutably dereferenceable types]: core::ops::DerefMut"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::DerefMut#mutable-deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &mut i32 = x.as_mut();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &mut i32 = &mut x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`DerefMut`] should consider to add an implementation of `AsMut<T>` as"},{"DocComment":" follows:"},{"DocComment":""},{"DocComment":" [`DerefMut`]: core::ops::DerefMut"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::{Deref, DerefMut};"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" # impl DerefMut for SomeType {"},{"DocComment":" #     fn deref_mut(&mut self) -> &mut [u8] {"},{"DocComment":" #         &mut []"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsMut<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     <SomeType as Deref>::Target: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.deref_mut().as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsMut` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsMut<T> for T`"},{"DocComment":" with [`as_mut`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&mut T where T: AsMut<U>` which allows `AsMut` to auto-dereference, see \"Generic"},{"DocComment":" Implementations\" above)."},{"DocComment":""},{"DocComment":" [`as_mut`]: AsMut::as_mut"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsMut<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using `AsMut` as trait bound for a generic function, we can accept all mutable references that"},{"DocComment":" can be converted to type `&mut T`. Unlike [dereference], which has a single [target type],"},{"DocComment":" there can be multiple implementations of `AsMut` for a type. In particular, `Vec<T>` implements"},{"DocComment":" both `AsMut<Vec<T>>` and `AsMut<[T]>`."},{"DocComment":""},{"DocComment":" In the following, the example functions `caesar` and `null_terminate` provide a generic"},{"DocComment":" interface which works with any type that can be converted by cheap mutable-to-mutable conversion"},{"DocComment":" into a byte slice (`[u8]`) or a byte vector (`Vec<u8>`), respectively."},{"DocComment":""},{"DocComment":" [dereference]: core::ops::DerefMut"},{"DocComment":" [target type]: core::ops::Deref::Target"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Document {"},{"DocComment":"     info: String,"},{"DocComment":"     content: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: ?Sized> AsMut<T> for Document"},{"DocComment":" where"},{"DocComment":"     Vec<u8>: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.content.as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn caesar<T: AsMut<[u8]>>(data: &mut T, key: u8) {"},{"DocComment":"     for byte in data.as_mut() {"},{"DocComment":"         *byte = byte.wrapping_add(key);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn null_terminate<T: AsMut<Vec<u8>>>(data: &mut T) {"},{"DocComment":"     // Using a non-generic inner function, which contains most of the"},{"DocComment":"     // functionality, helps to minimize monomorphization overhead."},{"DocComment":"     fn doit(data: &mut Vec<u8>) {"},{"DocComment":"         let len = data.len();"},{"DocComment":"         if len == 0 || data[len-1] != 0 {"},{"DocComment":"             data.push(0);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     doit(data.as_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut v: Vec<u8> = vec![1, 2, 3];"},{"DocComment":"     caesar(&mut v, 5);"},{"DocComment":"     assert_eq!(v, [6, 7, 8]);"},{"DocComment":"     null_terminate(&mut v);"},{"DocComment":"     assert_eq!(v, [6, 7, 8, 0]);"},{"DocComment":"     let mut doc = Document {"},{"DocComment":"         info: String::from(\"Example\"),"},{"DocComment":"         content: vec![17, 19, 8],"},{"DocComment":"     };"},{"DocComment":"     caesar(&mut doc, 1);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9]);"},{"DocComment":"     null_terminate(&mut doc);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9, 0]);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note, however, that APIs don't need to be generic. In many cases taking a `&mut [u8]` or"},{"DocComment":" `&mut Vec<u8>`, for example, is the better choice (callers need to pass the correct type then)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsMut","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]},{"Ident":["as_mut",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":375,"col":4},"end":{"line":375,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a mutable reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156}],"output":{"Deduplicated":149}},"default":null},"kind":{"TraitMethod":[14,0]}}],"vtable":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":15,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["Rng",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":49,"col":0},"end":{"line":49,"col":41}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for infallible random number generators"},{"DocComment":""},{"DocComment":" `Rng` is a sub-trait of [`TryRng`] for infallible generators."},{"DocComment":""},{"DocComment":" # Requirements"},{"DocComment":""},{"DocComment":" See [`TryRng`#Requirements] which also apply here."},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" The [`rand`] crate provides higher level functionality, for example"},{"DocComment":" generation of floating-point values, uniform ranged sampling and shuffling"},{"DocComment":" sequences. In particular, [`rand::RngExt`] is an extension trait over `Rng`"},{"DocComment":" providing many of the methods one might expect to be able to use on an RNG."},{"DocComment":""},{"DocComment":" # Implementing `Rng`"},{"DocComment":""},{"DocComment":" Implement [`TryRng`] with <code>type Error = [core::convert::Infallible][]</code>."},{"DocComment":""},{"DocComment":" [`rand`]: https://docs.rs/rand/"},{"DocComment":" [`rand::RngExt`]: https://docs.rs/rand/latest/rand/trait.RngExt.html"},{"DocComment":" [`fill_bytes`]: Rng::fill_bytes"},{"DocComment":" [`next_u32`]: Rng::next_u32"},{"DocComment":" [`next_u64`]: Rng::next_u64"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[335,{"data":{"file_id":15,"beg":{"line":49,"col":15},"end":{"line":49,"col":41}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next_u32","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["Rng",0]},{"Ident":["next_u32",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":51,"col":4},"end":{"line":51,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u32`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156}],"output":{"Deduplicated":5}},"default":null},"kind":{"TraitMethod":[15,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next_u64","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["Rng",0]},{"Ident":["next_u64",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":54,"col":4},"end":{"line":54,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Return the next random `u64`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156}],"output":{"Deduplicated":66}},"default":null},"kind":{"TraitMethod":[15,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fill_bytes","item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["Rng",0]},{"Ident":["fill_bytes",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":62,"col":4},"end":{"line":62,"col":45}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fill `dest` with random data."},{"DocComment":""},{"DocComment":" This method should guarantee that `dest` is entirely filled"},{"DocComment":" with new data, and may panic if this is impossible"},{"DocComment":" (e.g. reading past the end of a file that is being used as the"},{"DocComment":" source of randomness)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":156},{"Deduplicated":161}],"output":{"Deduplicated":46}},"default":null},"kind":{"TraitMethod":[15,2]}}],"vtable":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1187,"col":0},"end":{"line":1187,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Format trait for an empty format, `{}`."},{"DocComment":""},{"DocComment":" Implementing this trait for a type will automatically implement the"},{"DocComment":" [`ToString`][tostring] trait for the type, allowing the usage"},{"DocComment":" of the [`.to_string()`][tostring_function] method. Prefer implementing"},{"DocComment":" the `Display` trait for a type, rather than [`ToString`][tostring]."},{"DocComment":""},{"DocComment":" `Display` is similar to [`Debug`], but `Display` is for user-facing"},{"DocComment":" output, and so cannot be derived."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":" [tostring]: ../../std/string/trait.ToString.html"},{"DocComment":" [tostring_function]: ../../std/string/trait.ToString.html#tymethod.to_string"},{"DocComment":""},{"DocComment":" # Completeness and parseability"},{"DocComment":""},{"DocComment":" `Display` for a type might not necessarily be a lossless or complete representation of the type."},{"DocComment":" It may omit internal state, precision, or other information the type does not consider important"},{"DocComment":" for user-facing output, as determined by the type. As such, the output of `Display` might not be"},{"DocComment":" possible to parse, and even if it is, the result of parsing might not exactly match the original"},{"DocComment":" value."},{"DocComment":""},{"DocComment":" However, if a type has a lossless `Display` implementation whose output is meant to be"},{"DocComment":" conveniently machine-parseable and not just meant for human consumption, then the type may wish"},{"DocComment":" to accept the same format in `FromStr`, and document that usage. Having both `Display` and"},{"DocComment":" `FromStr` implementations where the result of `Display` cannot be parsed with `FromStr` may"},{"DocComment":" surprise users."},{"DocComment":""},{"DocComment":" # Internationalization"},{"DocComment":""},{"DocComment":" Because a type can only have one `Display` implementation, it is often preferable"},{"DocComment":" to only implement `Display` when there is a single most \"obvious\" way that"},{"DocComment":" values can be formatted as text. This could mean formatting according to the"},{"DocComment":" \"invariant\" culture and \"undefined\" locale, or it could mean that the type"},{"DocComment":" display is designed for a specific culture/locale, such as developer logs."},{"DocComment":""},{"DocComment":" If not all values have a justifiably canonical textual format or if you want"},{"DocComment":" to support alternative formats not covered by the standard set of possible"},{"DocComment":" [formatting traits], the most flexible approach is display adapters: methods"},{"DocComment":" like [`str::escape_default`] or [`Path::display`] which create a wrapper"},{"DocComment":" implementing `Display` to output the specific display format."},{"DocComment":""},{"DocComment":" [formatting traits]: ../../std/fmt/index.html#formatting-traits"},{"DocComment":" [`Path::display`]: ../../std/path/struct.Path.html#method.display"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Implementing `Display` on a type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"The origin is: {origin}\"), \"The origin is: (0, 0)\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Display","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1212,"col":4},"end":{"line":1212,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.longitude, self.latitude)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     \"(1.987, 2.983)\","},{"DocComment":"     format!(\"{}\", Position { longitude: 1.987, latitude: 2.983, }),"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":145},{"Deduplicated":158}],"output":{"Deduplicated":54}},"default":null},"kind":{"TraitMethod":[16,0]}}],"vtable":{"id":26,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":17,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["word",0]},{"Ident":["Word",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":6,"col":0},"end":{"line":6,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker trait for supported \"word\" types."},{"DocComment":""},{"DocComment":" This is implemented for: `u32`, `u64`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Bytes","variance":"Invariant"},{"index":2,"name":"Self_Clause0_Clause2_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[336,{"data":{"file_id":24,"beg":{"line":6,"col":16},"end":{"line":6,"col":30}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":25,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnMut",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":163,"col":0},"end":{"line":163,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a mutable receiver."},{"DocComment":""},{"DocComment":" Instances of `FnMut` can be called repeatedly and may mutate state."},{"DocComment":""},{"DocComment":" `FnMut` is implemented automatically by closures which take mutable"},{"DocComment":" references to captured variables, as well as all types that implement"},{"DocComment":" [`Fn`], e.g., (safe) [function pointers] (since `FnMut` is a supertrait of"},{"DocComment":" [`Fn`]). Additionally, for any type `F` that implements `FnMut`, `&mut F`"},{"DocComment":" implements `FnMut`, too."},{"DocComment":""},{"DocComment":" Since [`FnOnce`] is a supertrait of `FnMut`, any instance of `FnMut` can be"},{"DocComment":" used where a [`FnOnce`] is expected, and since [`Fn`] is a subtrait of"},{"DocComment":" `FnMut`, any instance of [`Fn`] can be used where `FnMut` is expected."},{"DocComment":""},{"DocComment":" Use `FnMut` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and need to call it repeatedly, while allowing it to mutate state."},{"DocComment":" If you don't want the parameter to mutate state, use [`Fn`] as a"},{"DocComment":" bound; if you don't need to call it repeatedly, use [`FnOnce`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Calling a mutably capturing closure"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = 5;"},{"DocComment":" {"},{"DocComment":"     let mut square_x = || x *= x;"},{"DocComment":"     square_x();"},{"DocComment":" }"},{"DocComment":" assert_eq!(x, 25);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Using a `FnMut` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn do_twice<F>(mut func: F)"},{"DocComment":"     where F: FnMut()"},{"DocComment":" {"},{"DocComment":"     func();"},{"DocComment":"     func();"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x: usize = 1;"},{"DocComment":" {"},{"DocComment":"     let add_two_to_x = || x += 2;"},{"DocComment":"     do_twice(add_two_to_x);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(x, 5);"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[337,{"data":{"file_id":25,"beg":{"line":163,"col":36},"end":{"line":163,"col":48}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnMut",0]},{"Ident":["call_mut",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":166,"col":4},"end":{"line":166,"col":74}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":{"Other":"rust-call"},"is_variadic":false,"inputs":[{"Deduplicated":156},{"Deduplicated":8}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[18,0]}}],"vtable":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":454,"col":0},"end":{"line":454,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types whose values can be duplicated simply by copying bits."},{"DocComment":""},{"DocComment":" By default, variable bindings have 'move semantics.' In other"},{"DocComment":" words:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `x` has moved into `y`, and so cannot be used"},{"DocComment":""},{"DocComment":" // println!(\"{x:?}\"); // error: use of moved value"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, if a type implements `Copy`, it instead has 'copy semantics':"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // We can derive a `Copy` implementation. `Clone` is also required, as it's"},{"DocComment":" // a supertrait of `Copy`."},{"DocComment":" #[derive(Debug, Copy, Clone)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `y` is a copy of `x`"},{"DocComment":""},{"DocComment":" println!(\"{x:?}\"); // A-OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's important to note that in these two examples, the only difference is whether you"},{"DocComment":" are allowed to access `x` after the assignment. Under the hood, both a copy and a move"},{"DocComment":" can result in bits being copied in memory, although this is sometimes optimized away."},{"DocComment":""},{"DocComment":" ## How can I implement `Copy`?"},{"DocComment":""},{"DocComment":" There are two ways to implement `Copy` on your type. The simplest is to use `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct MyStruct;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also implement `Copy` and `Clone` manually:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct MyStruct;"},{"DocComment":""},{"DocComment":" impl Copy for MyStruct { }"},{"DocComment":""},{"DocComment":" impl Clone for MyStruct {"},{"DocComment":"     fn clone(&self) -> MyStruct {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There is a small difference between the two. The `derive` strategy will also place a `Copy`"},{"DocComment":" bound on type parameters:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct MyStruct<T>(T);"},{"DocComment":""},{"DocComment":" impl<T: Copy> Copy for MyStruct<T> { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This isn't always desired. For example, shared references (`&T`) can be copied regardless of"},{"DocComment":" whether `T` is `Copy`. Likewise, a generic struct containing markers such as [`PhantomData`]"},{"DocComment":" could potentially be duplicated with a bit-wise copy."},{"DocComment":""},{"DocComment":" ## What's the difference between `Copy` and `Clone`?"},{"DocComment":""},{"DocComment":" Copies happen implicitly, for example as part of an assignment `y = x`. The behavior of"},{"DocComment":" `Copy` is not overloadable; it is always a simple bit-wise copy."},{"DocComment":""},{"DocComment":" Cloning is an explicit action, `x.clone()`. The implementation of [`Clone`] can"},{"DocComment":" provide any type-specific behavior necessary to duplicate values safely. For example,"},{"DocComment":" the implementation of [`Clone`] for [`String`] needs to copy the pointed-to string"},{"DocComment":" buffer in the heap. A simple bitwise copy of [`String`] values would merely copy the"},{"DocComment":" pointer, leading to a double free down the line. For this reason, [`String`] is [`Clone`]"},{"DocComment":" but not `Copy`."},{"DocComment":""},{"DocComment":" [`Clone`] is a supertrait of `Copy`, so everything which is `Copy` must also implement"},{"DocComment":" [`Clone`]. If a type is `Copy` then its [`Clone`] implementation only needs to return `*self`"},{"DocComment":" (see the example above)."},{"DocComment":""},{"DocComment":" ## When can my type be `Copy`?"},{"DocComment":""},{"DocComment":" A type can implement `Copy` if all of its components implement `Copy`. For example, this"},{"DocComment":" struct can be `Copy`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Point {"},{"DocComment":"    x: i32,"},{"DocComment":"    y: i32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A struct can be `Copy`, and [`i32`] is `Copy`, therefore `Point` is eligible to be `Copy`."},{"DocComment":" By contrast, consider"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct Point;"},{"DocComment":" struct PointList {"},{"DocComment":"     points: Vec<Point>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The struct `PointList` cannot implement `Copy`, because [`Vec<T>`] is not `Copy`. If we"},{"DocComment":" attempt to derive a `Copy` implementation, we'll get an error:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" the trait `Copy` cannot be implemented for this type; field `points` does not implement `Copy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Shared references (`&T`) are also `Copy`, so a type can be `Copy`, even when it holds"},{"DocComment":" shared references of types `T` that are *not* `Copy`. Consider the following struct,"},{"DocComment":" which can implement `Copy`, because it only holds a *shared reference* to our non-`Copy`"},{"DocComment":" type `PointList` from above:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct PointList;"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct PointListWrapper<'a> {"},{"DocComment":"     point_list_ref: &'a PointList,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## When *can't* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Some types can't be copied safely. For example, copying `&mut T` would create an aliased"},{"DocComment":" mutable reference. Copying [`String`] would duplicate responsibility for managing the"},{"DocComment":" [`String`]'s buffer, leading to a double free."},{"DocComment":""},{"DocComment":" Generalizing the latter case, any type implementing [`Drop`] can't be `Copy`, because it's"},{"DocComment":" managing some resource besides its own [`size_of::<T>`] bytes."},{"DocComment":""},{"DocComment":" If you try to implement `Copy` on a struct or enum containing non-`Copy` data, you will get"},{"DocComment":" the error [E0204]."},{"DocComment":""},{"DocComment":" [E0204]: ../../error_codes/E0204.html"},{"DocComment":""},{"DocComment":" ## When *should* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Generally speaking, if your type _can_ implement `Copy`, it should. Keep in mind, though,"},{"DocComment":" that implementing `Copy` is part of the public API of your type. If the type might become"},{"DocComment":" non-`Copy` in the future, it could be prudent to omit the `Copy` implementation now, to"},{"DocComment":" avoid a breaking API change."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Copy`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Copy` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Copy`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Copy`."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`size_of::<T>`]: size_of"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Copy","diagnostic_item":"Copy","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[338,{"data":{"file_id":9,"beg":{"line":454,"col":16},"end":{"line":454,"col":21}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["From",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":588,"col":0},"end":{"line":588,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do value-to-value conversions while consuming the input value. It is the reciprocal of"},{"DocComment":" [`Into`]."},{"DocComment":""},{"DocComment":" One should always prefer implementing `From` over [`Into`]"},{"DocComment":" because implementing `From` automatically provides one with an implementation of [`Into`]"},{"DocComment":" thanks to the blanket implementation in the standard library."},{"DocComment":""},{"DocComment":" Only implement [`Into`] when targeting a version prior to Rust 1.41 and converting to a type"},{"DocComment":" outside the current crate."},{"DocComment":" `From` was not able to do these types of conversions in earlier versions because of Rust's"},{"DocComment":" orphaning rules."},{"DocComment":" See [`Into`] for more details."},{"DocComment":""},{"DocComment":" Prefer using [`Into`] over [`From`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`Into`] can be used as well."},{"DocComment":""},{"DocComment":" The `From` trait is also very useful when performing error handling. When constructing a function"},{"DocComment":" that is capable of failing, the return type will generally be of the form `Result<T, E>`."},{"DocComment":" `From` simplifies error handling by allowing a function to return a single error type"},{"DocComment":" that encapsulates multiple error types. See the \"Examples\" section and [the book][book] for more"},{"DocComment":" details."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. The `From` trait is intended for perfect conversions."},{"DocComment":" If the conversion can fail or is not perfect, use [`TryFrom`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" - `From<T> for U` implies [`Into`]`<U> for T`"},{"DocComment":" - `From` is reflexive, which means that `From<T> for T` is implemented"},{"DocComment":""},{"DocComment":" # When to implement `From`"},{"DocComment":""},{"DocComment":" While there's no technical restrictions on which conversions can be done using"},{"DocComment":" a `From` implementation, the general expectation is that the conversions"},{"DocComment":" should typically be restricted as follows:"},{"DocComment":""},{"DocComment":" * The conversion is *infallible*: if the conversion can fail, use [`TryFrom`]"},{"DocComment":"   instead; don't provide a `From` impl that panics."},{"DocComment":""},{"DocComment":" * The conversion is *lossless*: semantically, it should not lose or discard"},{"DocComment":"   information. For example, `i32: From<u16>` exists, where the original"},{"DocComment":"   value can be recovered using `u16: TryFrom<i32>`.  And `String: From<&str>`"},{"DocComment":"   exists, where you can get something equivalent to the original value via"},{"DocComment":"   `Deref`.  But `From` cannot be used to convert from `u32` to `u16`, since"},{"DocComment":"   that cannot succeed in a lossless way.  (There's some wiggle room here for"},{"DocComment":"   information not considered semantically relevant.  For example,"},{"DocComment":"   `Box<[T]>: From<Vec<T>>` exists even though it might not preserve capacity,"},{"DocComment":"   like how two vectors can be equal despite differing capacities.)"},{"DocComment":""},{"DocComment":" * The conversion is *value-preserving*: the conceptual kind and meaning of"},{"DocComment":"   the resulting value is the same, even though the Rust type and technical"},{"DocComment":"   representation might be different.  For example `-1_i8 as u8` is *lossless*,"},{"DocComment":"   since `as` casting back can recover the original value, but that conversion"},{"DocComment":"   is *not* available via `From` because `-1` and `255` are different conceptual"},{"DocComment":"   values (despite being identical bit patterns technically).  But"},{"DocComment":"   `f32: From<i16>` *is* available because `1_i16` and `1.0_f32` are conceptually"},{"DocComment":"   the same real number (despite having very different bit patterns technically)."},{"DocComment":"   `String: From<char>` is available because they're both *text*, but"},{"DocComment":"   `String: From<u32>` is *not* available, since `1` (a number) and `\"1\"`"},{"DocComment":"   (text) are too different.  (Converting values to text is instead covered"},{"DocComment":"   by the [`Display`](crate::fmt::Display) trait.)"},{"DocComment":""},{"DocComment":" * The conversion is *obvious*: it's the only reasonable conversion between"},{"DocComment":"   the two types.  Otherwise it's better to have it be a named method or"},{"DocComment":"   constructor, like how [`str::as_bytes`] is a method and how integers have"},{"DocComment":"   methods like [`u32::from_ne_bytes`], [`u32::from_le_bytes`], and"},{"DocComment":"   [`u32::from_be_bytes`], none of which are `From` implementations.  Whereas"},{"DocComment":"   there's only one reasonable way to wrap an [`Ipv6Addr`](crate::net::Ipv6Addr)"},{"DocComment":"   into an [`IpAddr`](crate::net::IpAddr), thus `IpAddr: From<Ipv6Addr>` exists."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" [`String`] implements `From<&str>`:"},{"DocComment":""},{"DocComment":" An explicit conversion from a `&str` to a String is done as follows:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let string = \"hello\".to_string();"},{"DocComment":" let other_string = String::from(\"hello\");"},{"DocComment":""},{"DocComment":" assert_eq!(string, other_string);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While performing error handling it is often useful to implement `From` for your own error type."},{"DocComment":" By converting underlying error types to our own custom error type that encapsulates the"},{"DocComment":" underlying error type, we can return a single error type without losing information on the"},{"DocComment":" underlying cause. The '?' operator automatically converts the underlying error type to our"},{"DocComment":" custom error type with `From::from`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fs;"},{"DocComment":" use std::io;"},{"DocComment":" use std::num;"},{"DocComment":""},{"DocComment":" enum CliError {"},{"DocComment":"     IoError(io::Error),"},{"DocComment":"     ParseError(num::ParseIntError),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl From<io::Error> for CliError {"},{"DocComment":"     fn from(error: io::Error) -> Self {"},{"DocComment":"         CliError::IoError(error)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl From<num::ParseIntError> for CliError {"},{"DocComment":"     fn from(error: num::ParseIntError) -> Self {"},{"DocComment":"         CliError::ParseError(error)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn open_and_parse_file(file_name: &str) -> Result<i32, CliError> {"},{"DocComment":"     let mut contents = fs::read_to_string(&file_name)?;"},{"DocComment":"     let num: i32 = contents.trim().parse()?;"},{"DocComment":"     Ok(num)"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`from`]: From::from"},{"DocComment":" [book]: ../../book/ch09-00-error-handling.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"From","diagnostic_item":"From","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"from","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["From",0]},{"Ident":["from",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":594,"col":4},"end":{"line":594,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts to this type from the input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FromFn","diagnostic_item":"from_fn","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":8}],"output":{"Deduplicated":6}},"default":null},"kind":{"TraitMethod":[20,0]}}],"vtable":null},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["Shl",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":461,"col":0},"end":{"line":461,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The left shift operator `<<`. Note that because this trait is implemented"},{"DocComment":" for all integer types with multiple right-hand-side types, Rust's type"},{"DocComment":" checker has special handling for `_ << _`, setting the result type for"},{"DocComment":" integer operations to the type of the left-hand-side operand. This means"},{"DocComment":" that though `a << b` and `a.shl(b)` are one and the same from an evaluation"},{"DocComment":" standpoint, they are different when it comes to type inference."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" An implementation of `Shl` that lifts the `<<` operation on integers to a"},{"DocComment":" wrapper around `usize`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Shl;"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct Scalar(usize);"},{"DocComment":""},{"DocComment":" impl Shl<Scalar> for Scalar {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn shl(self, Self(rhs): Self) -> Self::Output {"},{"DocComment":"         let Self(lhs) = self;"},{"DocComment":"         Self(lhs << rhs)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Scalar(4) << Scalar(2), Scalar(16));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" An implementation of `Shl` that spins a vector leftward by a given amount."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Shl;"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct SpinVector<T: Clone> {"},{"DocComment":"     vec: Vec<T>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: Clone> Shl<usize> for SpinVector<T> {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn shl(self, rhs: usize) -> Self::Output {"},{"DocComment":"         // Rotate the vector by `rhs` places."},{"DocComment":"         let (a, b) = self.vec.split_at(rhs);"},{"DocComment":"         let mut spun_vector = vec![];"},{"DocComment":"         spun_vector.extend_from_slice(b);"},{"DocComment":"         spun_vector.extend_from_slice(a);"},{"DocComment":"         Self { vec: spun_vector }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(SpinVector { vec: vec![0, 1, 2, 3, 4] } << 2,"},{"DocComment":"            SpinVector { vec: vec![2, 3, 4, 0, 1] });"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Shl","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Rhs","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"shl","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["Shl",0]},{"Ident":["shl",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":476,"col":4},"end":{"line":476,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `<<` operation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(5u8 << 1, 10);"},{"DocComment":" assert_eq!(1u8 << 1, 2);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Deduplicated":8}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[21,0]}}],"vtable":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":22,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["BitXor",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":358,"col":0},"end":{"line":358,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The bitwise XOR operator `^`."},{"DocComment":""},{"DocComment":" Note that `Rhs` is `Self` by default, but this is not mandatory."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" An implementation of `BitXor` that lifts `^` to a wrapper around `bool`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::BitXor;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" struct Scalar(bool);"},{"DocComment":""},{"DocComment":" impl BitXor for Scalar {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     // rhs is the \"right-hand side\" of the expression `a ^ b`"},{"DocComment":"     fn bitxor(self, rhs: Self) -> Self::Output {"},{"DocComment":"         Self(self.0 ^ rhs.0)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Scalar(true) ^ Scalar(true), Scalar(false));"},{"DocComment":" assert_eq!(Scalar(true) ^ Scalar(false), Scalar(true));"},{"DocComment":" assert_eq!(Scalar(false) ^ Scalar(true), Scalar(true));"},{"DocComment":" assert_eq!(Scalar(false) ^ Scalar(false), Scalar(false));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" An implementation of `BitXor` trait for a wrapper around `Vec<bool>`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::BitXor;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" struct BooleanVector(Vec<bool>);"},{"DocComment":""},{"DocComment":" impl BitXor for BooleanVector {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn bitxor(self, Self(rhs): Self) -> Self::Output {"},{"DocComment":"         let Self(lhs) = self;"},{"DocComment":"         assert_eq!(lhs.len(), rhs.len());"},{"DocComment":"         Self("},{"DocComment":"             lhs.iter()"},{"DocComment":"                 .zip(rhs.iter())"},{"DocComment":"                 .map(|(x, y)| *x ^ *y)"},{"DocComment":"                 .collect()"},{"DocComment":"         )"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let bv1 = BooleanVector(vec![true, true, false, false]);"},{"DocComment":" let bv2 = BooleanVector(vec![true, false, true, false]);"},{"DocComment":" let expected = BooleanVector(vec![false, true, true, false]);"},{"DocComment":" assert_eq!(bv1 ^ bv2, expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"BitXor","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Rhs","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"bitxor","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["BitXor",0]},{"Ident":["bitxor",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":375,"col":4},"end":{"line":375,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `^` operation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(true ^ false, true);"},{"DocComment":" assert_eq!(true ^ true, false);"},{"DocComment":" assert_eq!(5u8 ^ 1u8, 4);"},{"DocComment":" assert_eq!(5u8 ^ 2u8, 7);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Deduplicated":8}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[22,0]}}],"vtable":{"id":28,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["Shr",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":584,"col":0},"end":{"line":584,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The right shift operator `>>`. Note that because this trait is implemented"},{"DocComment":" for all integer types with multiple right-hand-side types, Rust's type"},{"DocComment":" checker has special handling for `_ >> _`, setting the result type for"},{"DocComment":" integer operations to the type of the left-hand-side operand. This means"},{"DocComment":" that though `a >> b` and `a.shr(b)` are one and the same from an evaluation"},{"DocComment":" standpoint, they are different when it comes to type inference."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" An implementation of `Shr` that lifts the `>>` operation on integers to a"},{"DocComment":" wrapper around `usize`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Shr;"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct Scalar(usize);"},{"DocComment":""},{"DocComment":" impl Shr<Scalar> for Scalar {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn shr(self, Self(rhs): Self) -> Self::Output {"},{"DocComment":"         let Self(lhs) = self;"},{"DocComment":"         Self(lhs >> rhs)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Scalar(16) >> Scalar(2), Scalar(4));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" An implementation of `Shr` that spins a vector rightward by a given amount."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Shr;"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct SpinVector<T: Clone> {"},{"DocComment":"     vec: Vec<T>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: Clone> Shr<usize> for SpinVector<T> {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn shr(self, rhs: usize) -> Self::Output {"},{"DocComment":"         // Rotate the vector by `rhs` places."},{"DocComment":"         let (a, b) = self.vec.split_at(self.vec.len() - rhs);"},{"DocComment":"         let mut spun_vector = vec![];"},{"DocComment":"         spun_vector.extend_from_slice(b);"},{"DocComment":"         spun_vector.extend_from_slice(a);"},{"DocComment":"         Self { vec: spun_vector }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(SpinVector { vec: vec![0, 1, 2, 3, 4] } >> 2,"},{"DocComment":"            SpinVector { vec: vec![3, 4, 0, 1, 2] });"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Shr","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Rhs","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"shr","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["bit",0]},{"Ident":["Shr",0]},{"Ident":["shr",0]}],"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":599,"col":4},"end":{"line":599,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `>>` operation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(5u8 >> 1, 2);"},{"DocComment":" assert_eq!(2u8 >> 1, 1);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Deduplicated":8}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[23,0]}}],"vtable":{"id":29,"generics":{"regions":[],"types":[{"Deduplicated":8},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":242,"col":0},"end":{"line":242,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a by-value receiver."},{"DocComment":""},{"DocComment":" Instances of `FnOnce` can be called, but might not be callable multiple"},{"DocComment":" times. Because of this, if the only thing known about a type is that it"},{"DocComment":" implements `FnOnce`, it can only be called once."},{"DocComment":""},{"DocComment":" `FnOnce` is implemented automatically by closures that might consume captured"},{"DocComment":" variables, as well as all types that implement [`FnMut`], e.g., (safe)"},{"DocComment":" [function pointers] (since `FnOnce` is a supertrait of [`FnMut`])."},{"DocComment":""},{"DocComment":" Since both [`Fn`] and [`FnMut`] are subtraits of `FnOnce`, any instance of"},{"DocComment":" [`Fn`] or [`FnMut`] can be used where a `FnOnce` is expected."},{"DocComment":""},{"DocComment":" Use `FnOnce` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and only need to call it once. If you need to call the parameter"},{"DocComment":" repeatedly, use [`FnMut`] as a bound; if you also need it to not mutate"},{"DocComment":" state, use [`Fn`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Using a `FnOnce` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn consume_with_relish<F>(func: F)"},{"DocComment":"     where F: FnOnce() -> String"},{"DocComment":" {"},{"DocComment":"     // `func` consumes its captured variables, so it cannot be run more"},{"DocComment":"     // than once."},{"DocComment":"     println!(\"Consumed: {}\", func());"},{"DocComment":""},{"DocComment":"     println!(\"Delicious!\");"},{"DocComment":""},{"DocComment":"     // Attempting to invoke `func()` again will throw a `use of moved"},{"DocComment":"     // value` error for `func`."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = String::from(\"x\");"},{"DocComment":" let consume_and_return_x = move || x;"},{"DocComment":" consume_with_relish(consume_and_return_x);"},{"DocComment":""},{"DocComment":" // `consume_and_return_x` can no longer be invoked at this point"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnOnce","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_once","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]},{"Ident":["call_once",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":250,"col":4},"end":{"line":250,"col":70}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":{"