{"charon_version":"0.1.291","translated":{"crate_name":"normalize_original_contracts","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":true,"monomorphize_mut":null,"start_from":["crate::first"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["normalize_line_endings"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":"investigation","dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"normalize_original_contracts","contents":"use normalize_line_endings::normalized;\n\n#[derive(Clone, Copy)]\npub struct Input { data: [char; 4], len: usize, pos: usize }\nimpl Iterator for Input {\n    type Item = char;\n    fn next(&mut self) -> Option<char> {\n        if self.pos < self.len { let c=self.data[self.pos]; self.pos+=1; Some(c) } else { None }\n    }\n}\n\npub fn first(input: Input) -> Option<char> { normalized(input).next() }\n\n#[cfg(kani)]\nmod verification {\n    use super::*;\n    // Independent eager specification: replace CR by LF; omit LF immediately after CR.\n    fn reference(data:[char;4], len:usize)->([char;4],usize) {\n        let mut out=['\\0';4]; let mut n=0; let mut i=0;\n        while i<len {\n            let c=data[i];\n            if c!='\\n' || i==0 || data[i-1]!='\\r' {\n                out[n]=if c=='\\r' {'\\n'} else {c}; n+=1;\n            }\n            i+=1;\n        }\n        (out,n)\n    }\n    #[kani::proof]\n    #[kani::unwind(8)]\n    fn original_bounded_normalization() {\n        let data:[char;4]=kani::any(); let len:usize=kani::any();\n        kani::assume(len<=4);\n        let (expected,n)=reference(data,len);\n        let mut actual=normalized(Input{data,len,pos:0});\n        assert_eq!(actual.size_hint(),(0,None));\n        let mut output=['\\0';4]; let mut i=0;\n        while i<n { output[i]=actual.next().expect(\"reference output exists\"); i+=1; }\n        assert_eq!(actual.next(),None);\n        assert_eq!(actual.next(),None);\n        assert_eq!(output,expected);\n        assert!(n<=len);\n        let mut j=0; while j<n { assert_ne!(output[j],'\\r'); j+=1; }\n        let mut twice=normalized(Input{data:output,len:n,pos:0});\n        let mut k=0; while k<n { assert_eq!(twice.next(),Some(output[k])); k+=1; }\n        assert_eq!(twice.next(),None);\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"source/src/lib.rs"},"crate_name":"normalize_line_endings","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple