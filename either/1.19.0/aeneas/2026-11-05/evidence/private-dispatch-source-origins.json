        "source_text": "pub fn either<F, G, T>(self, f: F, g: G) -> T\n    where\n        F: FnOnce(L) -> T,\n        G: FnOnce(R) -> T,\n    {\n        match self {\n            Left(l) => f(l),\n            Right(r) => g(r),\n        }\n    }",
        "attr_info": {
          "attributes": [
            {
              "DocComment": " Apply one of two functions depending on contents, unifying their result. If the value is"
            },
            {
              "DocComment": " `Left(L)` then the first function `f` is applied; if it is `Right(R)` then the second"
            },
            {
              "DocComment": " function `g` is applied."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " ```"
            },
            {
              "DocComment": " use either::*;"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " fn square(n: u32) -> i32 { (n * n) as i32 }"
            },
            {
              "DocComment": " fn negate(n: i32) -> i32 { -n }"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " let left: Either<u32, i32> = Left(4);"
            },
            {
              "DocComment": " assert_eq!(left.either(square, negate), 16);"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " let right: Either<u32, i32> = Right(-4);"
            },
            {
              "DocComment": " assert_eq!(right.either(square, negate), 4);"
            },
            {
              "DocComment": " ```"
            }
          ],
          "inline": null,
          "rename": null,
          "public": true
        },
