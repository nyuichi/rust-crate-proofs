        "source_text": "pub fn either_into<T>(self) -> T\n    where\n        L: Into<T>,\n        R: Into<T>,\n    {\n        for_both!(self, inner => inner.into())\n    }",
        "attr_info": {
          "attributes": [
            {
              "DocComment": " Convert the contained value into `T`"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " # Examples"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " ```"
            },
            {
              "DocComment": " # use either::*;"
            },
            {
              "DocComment": " // Both u16 and u32 can be converted to u64."
            },
            {
              "DocComment": " let left: Either<u16, u32> = Left(3u16);"
            },
            {
              "DocComment": " assert_eq!(left.either_into::<u64>(), 3u64);"
            },
            {
              "DocComment": " let right: Either<u16, u32> = Right(7u32);"
            },
            {
              "DocComment": " assert_eq!(right.either_into::<u64>(), 7u64);"
            },
