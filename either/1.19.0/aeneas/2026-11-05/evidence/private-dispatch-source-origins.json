        "source_text": "pub fn either_with<Ctx, F, G, T>(self, ctx: Ctx, f: F, g: G) -> T\n    where\n        F: FnOnce(Ctx, L) -> T,\n        G: FnOnce(Ctx, R) -> T,\n    {\n        match self {\n            Left(l) => f(ctx, l),\n            Right(r) => g(ctx, r),\n        }\n    }",
        "attr_info": {
          "attributes": [
            {
              "DocComment": " Like [`either`][Self::either], but provide some context to whichever of the"
            },
            {
              "DocComment": " functions ends up being called."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " ```"
            },
            {
              "DocComment": " // In this example, the context is a mutable reference"
            },
            {
              "DocComment": " use either::*;"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " let mut result = Vec::new();"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " let values = vec![Left(2), Right(2.7)];"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " for value in values {"
            },
            {
              "DocComment": "     value.either_with(&mut result,"
            },
            {
              "DocComment": "                       |ctx, integer| ctx.push(integer),"
            },
            {
              "DocComment": "                       |ctx, real| ctx.push(f64::round(real) as i32));"
            },
            {
              "DocComment": " }"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " assert_eq!(result, vec![2, 3]);"
            },
            {
              "DocComment": " ```"
            }
          ],
          "inline": null,
          "rename": null,
          "public": true
        },
