r` with `Ok => Right` and `Err => Left`."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":98}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"L","variance":"Unknown"},{"index":1,"name":"R","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":39,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":17}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[7,0]}}],"vtable":"NotDynCompatible"},{"def_id":8,"item_meta":{"name":[{"Ident":["either",0]},{"Impl":{"Trait":8}}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1447,"col":0},"end":{"line":1454,"col":1}},"generated_from_span":null}},"source_text":"impl<L, R> From<Either<L, R>> for Result<R, L> {\n    fn from(val: Either<L, R>) -> Self {\n        match val {\n            Left(l) => Err(l),\n            Right(r) => Ok(r),\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Convert from `Either` to `Result` with `Right => Ok` and `Left => Err`."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":98},{"Deduplicated":19}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"