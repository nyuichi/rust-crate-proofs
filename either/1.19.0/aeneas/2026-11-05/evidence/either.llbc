   where\n        B: Default + Extend<Self::Item>,\n        F: FnMut(&Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.partition(f))\n    }\n\n    fn all<F>(&mut self, f: F) -> bool\n    where\n        F: FnMut(Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.all(f))\n    }\n\n    fn any<F>(&mut self, f: F) -> bool\n    where\n        F: FnMut(Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.any(f))\n    }\n\n    fn find<P>(&mut self, predicate: P) -> Option<Self::Item>\n    where\n        P: FnMut(&Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.find(predicate))\n    }\n\n    fn find_map<B, F>(&mut self, f: F) -> Option<B>\n    where\n        F: FnMut(Self::Item) -> Option<B>,\n    {\n        for_both!(self, inner => inner.find_map(f))\n    }\n\n    fn position<P>(&mut self, predicate: P) -> Option<usize>\n    where\n        P: FnMut(Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.position(predicate))\n    }\n}","attr_info":{"attributes":[{"DocComment":" `Either<L, R>` is an iterator if both `L` and `R` are iterators."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"L","variance":"Unknown"},{"index":1,"name":"R","variance":"Unknown"},{"index":2,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":711},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}}}},{"cl