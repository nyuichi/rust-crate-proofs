x, F, G, M, S>(self, ctx: Ctx, f: F, g: G) -> Either<M, S>\n    where\n        F: FnOnce(Ctx, L) -> M,\n        G: FnOnce(Ctx, R) -> S,\n    {\n        match self {\n            Left(l) => Left(f(ctx, l)),\n            Right(r) => Right(g(ctx, r)),\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Similar to [`map_either`][Self::map_either], with an added context `ctx` accessible to"},{"DocComment":" both functions."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use either::*;"},{"DocComment":""},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" // Both closures want to update the same value, so pass it as context."},{"DocComment":" let mut f = |sum: &mut usize, s: String| { *sum += s.len(); s.to_uppercase() };"},{"DocComment":" let mut g = |sum: &mut usize, u: usize| { *sum += u; u.to_string() };"},{"DocComment":""},{"DocComment":" let left: Either<String, usize> = Left(\"loopy\".into());"},{"DocComment":" assert_eq!(left.map_either_with(&mut sum, &mut f, &mut g), Left(\"LOOPY\".into()));"},{"DocComment":""},{"DocComment":" let right: Either<String, usize> = Right(42);"},{"DocComment":" assert_eq!(right.map_either_with(&mut sum, &mut f, &mut g), Right(\"42\".into()));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 47);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"L","variance":"Unknown"},{"index":1,"name":"R","variance":"Unknown"},{"index":2,"name":"Ctx","variance":"Contravariant"},{"index":3,"name":"F","variance":"Contravariant"},{"index":4,"name":"G","variance":"Contravariant"},{"index":5,"name":"M","variance":"Covariant"},{"index":6,"name":"S","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[644,{"data":{"file_id":0,"beg":{"line":612,"col":11},"end":{"line":612,