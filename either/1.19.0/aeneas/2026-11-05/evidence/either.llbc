om_span":null}},"source_text":"impl<L, R> DoubleEndedIterator for Either<L, R>\nwhere\n    L: DoubleEndedIterator,\n    R: DoubleEndedIterator<Item = L::Item>,\n{\n    fn next_back(&mut self) -> Option<Self::Item> {\n        for_both!(self, inner => inner.next_back())\n    }\n\n    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {\n        for_both!(self, inner => inner.nth_back(n))\n    }\n\n    #[inline]\n    fn rfold<Acc, G>(self, init: Acc, f: G) -> Acc\n    where\n        G: FnMut(Acc, Self::Item) -> Acc,\n    {\n        for_both!(self, inner => inner.rfold(init, f))\n    }\n\n    fn rfind<P>(&mut self, predicate: P) -> Option<Self::Item>\n    where\n        P: FnMut(&Self::Item) -> bool,\n    {\n        for_both!(self, inner => inner.rfind(predicate))\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"L","variance":"Unknown"},{"index":1,"name":"R","variance":"Unknown"},{"index":2,"name":"Clause0_Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":726},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":727},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":17},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"t