../../std/string/struct.String.html \"String\""},{"DocComment":" ```"},{"DocComment":" let maybe_some_string = Some(String::from(\"Hello, World!\"));"},{"DocComment":" // `Option::map` takes self *by value*, consuming `maybe_some_string`"},{"DocComment":" let maybe_some_len = maybe_some_string.map(|s| s.len());"},{"DocComment":" assert_eq!(maybe_some_len, Some(13));"},{"DocComment":""},{"DocComment":" let x: Option<&str> = None;"},{"DocComment":" assert_eq!(x.map(|s| s.len()), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"U","variance":"Covariant"},{"index":2,"name":"F","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[779,{"data":{"file_id":5,"beg":{"line":1162,"col":11},"end":{"line":1162,"col":33}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":26},{"Deduplicated":46},{"Deduplicated":17}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[780,{"data":{"file_id":5,"beg":{"line":1162,"col":36},"end":{"line":1162,"col":52}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38},{"Deduplicated":26}],"output":{"Deduplicated":39}},"src":"Normal","body":"Opaque"},{"def_id":63,"item_meta":{"name":[{"Ident":["either",0]},{"Ident":["Either",0]},{"Ident":["Right",0]