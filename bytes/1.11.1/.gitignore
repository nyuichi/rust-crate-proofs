/target

# Preserve small proof evidence snapshots, not live build/cache outputs.
!verification/artifacts/**/*.coma

# Saved proof snapshots include paired Why3 JSON; live probe verif stays ignored.
!verification/artifacts/component-evidence/**/verif/
!verification/artifacts/component-evidence/**/verif/**

/.verified-proof-config

# Generated per-environment path override for the retained generic proof std copy.
/.cargo/config.toml
