:1387,"col":42}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Raw transmutation from `u32`."},{"DocComment":""},{"DocComment":" This is currently identical to `transmute::<u32, f32>(v)` on all platforms."},{"DocComment":" It turns out this is incredibly portable, for two reasons:"},{"DocComment":""},{"DocComment":" * Floats and Ints have the same endianness on all supported platforms."},{"DocComment":" * IEEE 754 very precisely specifies the bit layout of floats."},{"DocComment":""},{"DocComment":" However there is one caveat: prior to the 2008 version of IEEE 754, how"},{"DocComment":" to interpret the NaN signaling bit wasn't actually specified. Most platforms"},{"DocComment":" (notably x86 and ARM) picked the interpretation that was ultimately"},{"DocComment":" standardized in 2008, but some didn't (notably MIPS). As a result, all"},{"DocComment":" signaling NaNs on MIPS are quiet NaNs on x86, and vice-versa."},{"DocComment":""},{"DocComment":" Rather than trying to preserve signaling-ness cross-platform, this"},{"DocComment":" implementation favors preserving the exact bits. This means that"},{"DocComment":" any payloads encoded in NaNs will be preserved even if the result of"},{"DocComment":" this method is sent over the network from an x86 machine to a MIPS one."},{"DocComment":""},{"DocComment":" If the results of this method are only manipulated by the same"},{"DocComment":" architecture that produced them, then there is no portability concern."},{"DocComment":""},{"DocComment":" If the input isn't NaN, then there is no portability concern."},{"DocComment":""},{"DocComment":" If you don't care about signalingness (very likely), then there is no"},{"DocComment":" portability concern."},{"DocComment":""},{"DocComment":" Note that this function is distinct from `as` casting, which attempts to"},{"DocComment":" preserve the *numeric* value, and not the bitwise value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = f32::from_bits(0x41480000);"},{"DocComment":" assert_eq!(v, 12.5);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U32"}}}}],"output":{"Untagged":{"Scalar":{"Float":"F32"}}}},"src":"Normal","body":"Opaque"},{"def_id":207,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Trait":45}},{"Ident":["from_residual",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":2188,"col":4},"end":{"line":2188,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":24,"beg":{"line":2187,"col":4},"end":{"line":2187,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"},{"index":2,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":2185,"col":20},"end":{"line":2185,"col":35}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":2}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constrain