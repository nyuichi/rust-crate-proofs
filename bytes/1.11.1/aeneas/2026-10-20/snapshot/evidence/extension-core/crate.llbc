ed":{"data":{"file_id":6,"beg":{"line":603,"col":5},"end":{"line":603,"col":5}},"generated_from_span":null}},"id":175,"kind":{"StorageDead":9},"comments_before":[]},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":603,"col":5},"end":{"line":603,"col":5}},"generated_from_span":null}},"id":176,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":603,"col":5},"end":{"line":603,"col":5}},"generated_from_span":null}},"id":177,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":603,"col":5},"end":{"line":603,"col":5}},"generated_from_span":null}},"id":178,"kind":"Return","comments_before":[]}]},"comments":[[598,["The handle can already store at least `additional` more bytes, so","there is no further work needed to be done."]],[602,["will always succeed"]]]}}},{"def_id":17,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["try_reclaim",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":836,"col":4},"end":{"line":847,"col":5}},"generated_from_span":null}},"source_text":"pub fn try_reclaim(&mut self, additional: usize) -> bool {\n        let len = self.len();\n        let rem = self.capacity() - len;\n\n        if additional <= rem {\n            // The handle can already store at least `additional` more bytes, so\n            // there is no further work needed to be done.\n            return true;\n        }\n\n        self.reserve_inner(additional, false)\n    }","attr_info":{"attributes":[{"DocComment":" Attempts to cheaply reclaim already allocated capacity for at least `additional` more"},{"DocComment":" bytes to be inserted into the given `BytesMut` and returns `true` if it succeeded."},{"DocComment":""},{"DocComment":" `try_reclaim` behaves exactly like `reserve`, except that it never allocates new storage"},{"DocComment":" and returns a `bool` indicating whether it was successful in doing so:"},{"DocComment":""},{"DocComment":" `try_reclaim` returns false under these conditions:"},{"DocComment":"  - The spare capacity left is less than `additional` bytes AND"},{"DocComment":"  - The existing allocation cannot be reclaimed cheaply or it was less than"},{"DocComment":"    `additional` bytes in size"},{"DocComment":""},{"DocComment":" Reclaiming the allocation cheaply is possible if the `BytesMut` has no outstanding"},{"DocComment":" references through other `BytesMut`s or `Bytes` which point to the same underlying"},{"DocComment":" storage."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(64);"},{"DocComment":" assert_eq!(true, buf.try_reclaim(64));"},{"DocComment":" assert_eq!(64, buf.capacity());"},{"DocComment":""},{"DocComment":" buf.extend_from_slice(b\"abcd\");"},{"DocComment":" let mut split = buf.split();"},{"DocComment":" assert_eq!(60, buf.capacity());"},{"DocComment":" assert_eq!(4, split.capacity());"},{"DocComment":" assert_eq!(false, split.try_reclaim(64));"},{"DocComment":" assert_eq!(false, buf.try_reclaim(64));"},{"DocComment":" // The split buffer is filled with \"abcd\""},{"DocComment":" assert_eq!(false, split.try_reclaim(4));"},{"DocComment":" // buf is empty and has capacity for 60 bytes"},{"DocComment":" assert_eq!(true, buf.try_reclaim(60));"},{"DocComment":""},{"DocComment":" drop(buf);"},{"DocComment":" assert_eq!(false, split.try_reclaim(64));"},{"DocComment":""},{"DocComment":" split.clear();"},{"DocComment":" assert_eq!(4, split.capacity());"},{"DocComment":" assert_eq!(true, split.try_reclaim(64));"},{"DocComment":" assert_eq!(64, split.capacity());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":834,"col":4},"end":{"line":834,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Scalar":"Bool"}}},"src":"Normal","body":{"Structured":{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":836,"col":4},"end":{"line":847,"col":5}},"generated_from_span":null}},"bound_body_regions":12,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":836,"col":56},"end":{"line":836,"col":60}},"generated_from_span":null}},"ty":{"Untagged":{"Scalar":"Bool"}},"drop_flag_for":null},{"index":1,"name":"self","span":{"Untagged":{"data":{"file_id":6,"beg":{"line":836,"col":23},"end":{"line":836,"col":32}},"generated_from_span":null}},"ty":{"Untagged":{"Ref":[{"Body":1},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},"drop_flag_for":null},{"index":2,"name":"additional","span":{"Untagged":{"data":{"file_id":6,"beg":{"line":836,"col":34},"end":{"line":836,"col":44}},"generated_from_span":null}},"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}},"drop_flag_for":null},{"index":3,"name":