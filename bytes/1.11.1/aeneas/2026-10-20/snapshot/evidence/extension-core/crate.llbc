` points to the same memory."},{"DocComment":" let b = a.clone();"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"hello\");"},{"DocComment":" assert_eq!(&b[..], b\"hello\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":61,"col":4},"end":{"line":61,"col":20}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"ptr","is_positional":false,"ty":{"Untagged":{"Adt":{"id":17,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":62,"col":4},"end":{"line":62,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"len","is_positional":false,"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":63,"col":4},"end":{"line":63,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"cap","is_positional":false,"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":64,"col":4},"end":{"line":64,"col":21}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"data","is_positional":false,"ty":{"Untagged":{"RawPtr":[{"Untagged":{"Adt":{"id":18,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}}}]},"layout":[{"key":"x86_64-unknown-linux-g