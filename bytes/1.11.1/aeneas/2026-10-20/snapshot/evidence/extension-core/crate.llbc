"bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["unsplit",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":907,"col":4},"end":{"line":916,"col":5}},"generated_from_span":null}},"source_text":"pub fn unsplit(&mut self, other: BytesMut) {\n        if self.is_empty() {\n            *self = other;\n            return;\n        }\n\n        if let Err(other) = self.try_unsplit(other) {\n            self.extend_from_slice(other.as_ref());\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Absorbs a `BytesMut` that was previously split off."},{"DocComment":""},{"DocComment":" If the two `BytesMut` objects were previously contiguous and not mutated"},{"DocComment":" in a way that causes re-allocation i.e., if `other` was created by"},{"DocComment":" calling `split_off` on this `BytesMut`, then this is an `O(1)` operation"},{"DocComment":" that just decreases a reference count and sets a few indices."},{"DocComment":" Otherwise this method degenerates to"},{"DocComment":" `self.extend_from_slice(other.as_ref())`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(64);"},{"DocComment":" buf.extend_from_slice(b\"aaabbbcccddd\");"},{"DocComment":""},{"DocComment":" let split = buf.split_off(6);"},{"DocComment":" assert_eq!(b\"aaabbb\", &buf[..]);"},{"DocComment":" assert_eq!(b\"cccddd\", &split[..]);"},{"DocComment":""},{"DocComment":" buf.unsplit(split);"},{"DocComment":" assert_eq!(b\"aaabbbcccddd\", &buf[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_