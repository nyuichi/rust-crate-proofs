ount and"},{"DocComment":" sets a few indices."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut a = Bytes::from(&b\"hello world\"[..]);"},{"DocComment":" let b = a.split_to(5);"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\" world\");"},{"DocComment":" assert_eq!(&b[..], b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `at > len`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":"Opaque"},{"def_id":168,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Trait":9}},{"Ident":["advance",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":1155,"col":4},"end":{"line":1167,"col":5}},"generated_from_span":null}},"source_text":"fn advance(&mut self, cnt: usize) {\n        assert!(\n            cnt <= self.remaining(),\n            \"cannot advance past `remaining`: {:?} <= {:?}\",\n            cnt,\n            self.remaining(),\n        );\n        unsafe {\n            // SAFETY: We've checked that `cnt` <= `self.remaining()` and we know that