"bytes",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["truncate",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":588,"col":4},"end":{"line":601,"col":5}},"generated_from_span":null}},"source_text":"pub fn truncate(&mut self, len: usize) {\n        if len < self.len {\n            // The Vec \"promotable\" vtables do not store the capacity,\n            // so we cannot truncate while using this repr. We *have* to\n            // promote using `split_off` so the capacity can be stored.\n            if self.vtable as *const Vtable == &PROMOTABLE_EVEN_VTABLE\n                || self.vtable as *const Vtable == &PROMOTABLE_ODD_VTABLE\n            {\n                drop(self.split_off(len));\n            } else {\n                self.len = len;\n            }\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Shortens the buffer, keeping the first `len` bytes and dropping the"},{"DocComment":" rest."},{"DocComment":""},{"DocComment":" If `len` is greater than the buffer's current length, this has no"},{"DocComment":" effect."},{"DocComment":""},{"DocComment":" The [split_off](`Self::split_off()`) method can emulate `truncate`, but this causes the"},{"DocComment":" excess bytes to be returned instead of dropped."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut buf = Bytes::from(&b\"hello world\"[..]);"},{"DocComment":" buf.truncate(5);"},{"DocComment":" assert_eq!(buf, b\"hello\"[..]);"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":587,"col":4},"end":{"line":587,"col":13}},"generated_from_span":null}}