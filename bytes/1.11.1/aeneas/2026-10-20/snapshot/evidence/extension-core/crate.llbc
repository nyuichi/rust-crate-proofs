info":{"attributes":[{"DocComment":" Returns the number of leading zeros in the binary representation of `self`."},{"DocComment":""},{"DocComment":" Depending on what you're doing with the value, you might also be interested in the"},{"DocComment":" [`ilog2`] function which returns a consistent number, even if the type widens."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"let n = usize::MAX >> 2;"},{"DocComment":" assert_eq!(n.leading_zeros(), 2);"},{"DocComment":""},{"DocComment":"let zero = 0usize;"},{"DocComment":"assert_eq!(zero.leading_zeros(), 64);"},{"DocComment":""},{"DocComment":"let max = usize::MAX;"},{"DocComment":" assert_eq!(max.leading_zeros(), 0);"},{"DocComment":" ```"},{"DocComment":"[`ilog2`]: usize::ilog2"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U32"}}}}},"src":"Normal","body":"Opaque"},{"def_id":231,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["min",0]}],"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":1666,"col":0},"end":{"line":1666,"col":70}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Compares and returns the minimum of two values."},{"DocComment":""},{"DocComment":" Returns the first argument if the comparison determines them to be equal."},{"DocComment":""},{"DocComment":" Internally uses an alias to [`Ord::min`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cmp;"},{"Do