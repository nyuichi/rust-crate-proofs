"Clause":[{"Free":1},{"regions":[]}]},"trait_decl_ref":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}}]}},"kind":{"TraitMethod":[5,0]}}],"vtable":"Lazy"},{"def_id":128,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["chain",0]},{"Impl":{"Trait":128}}],"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":130,"col":0},"end":{"line":189,"col":1}},"generated_from_span":null}},"source_text":"impl<T, U> Buf for Chain<T, U>\nwhere\n    T: Buf,\n    U: Buf,\n{\n    fn remaining(&self) -> usize {\n        self.a.remaining().saturating_add(self.b.remaining())\n    }\n\n    fn chunk(&self) -> &[u8] {\n        if self.a.has_remaining() {\n            self.a.chunk()\n        } else {\n            self.b.chunk()\n        }\n    }\n\n    fn advance(&mut self, mut cnt: usize) {\n        let a_rem = self.a.remaining();\n\n        if a_rem != 0 {\n            if a_rem >= cnt {\n                self.a.advance(cnt);\n                return;\n            }\n\n            // Consume what is left of a\n            self.a.advance(a_rem);\n\n            cnt -= a_rem;\n        }\n\n        self.b.advance(cnt);\n    }\n\n    #[cfg(feature = \"std\")]\n    fn chunks_vectored<'a>(&'a self, dst: &mut [IoSlice<'a>]) -> usize {\n        let mut n = self.a.chunks_vectored(dst);\n        n += self.b.chunks_vectored(&mut dst[n..]);\n        n\n    }\n\n    fn copy_to_bytes(&mut self, len: usize) -> crate::Bytes {\n        let a_rem = self.a.remaining();\n        if a_rem >= len {\n            self.a.copy_to_bytes(len)\n        } else if a_rem == 0 {\n            self.b.copy_to_bytes(len)\n        } else {\n            assert!(\n                len - a_rem <= self.b.remaining(),\n                \"`len` greater than remaining\"\n            );\n            let mut ret = crate::BytesMut::with_capacity(len);\n            ret.put(&mut self.a);\n            ret.put((&mut self.b).take(len - a_rem));\n            ret.freeze()\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":29,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"U","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":132,"col":7},"end":{"line":132,"col":10}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":133,"col":7},"end":{"line":133,"col":10}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":684,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const