m<BytesMut> for Vec<u8> {\n    fn from(bytes: BytesMut) -> Self {\n        let kind = bytes.kind();\n        let bytes = ManuallyDrop::new(bytes);\n\n        let mut vec = if kind == KIND_VEC {\n            unsafe {\n                let off = bytes.get_vec_pos();\n                rebuild_vec(bytes.ptr.as_ptr(), bytes.len, bytes.cap, off)\n            }\n        } else {\n            let shared = bytes.data;\n\n            if unsafe { (*shared).is_unique() } {\n                let vec = core::mem::take(unsafe { &mut (*shared).vec });\n\n                unsafe { release_shared(shared) };\n\n                vec\n            } else {\n                return ManuallyDrop::into_inner(bytes).deref().to_vec();\n            }\n        };\n\n        let len = bytes.len;\n\n        unsafe {\n            ptr::copy(bytes.ptr.as_ptr(), vec.as_mut_ptr(), len);\n            vec.set_len(len);\n        }\n\n        vec\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":11,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":51,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":430,"generics":{"regions":[],"types":[],"const_generics":[]