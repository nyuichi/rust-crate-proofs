  /// assert_eq!(1.2f32, buf.get_f32_le());\n    /// assert_eq!(6, buf.remaining());\n    /// ```\n    ///\n    /// ```\n    /// use bytes::{Buf, TryGetError};\n    ///\n    /// let mut buf = &b\"\\x3F\\x99\\x99\"[..];\n    /// assert_eq!(Err(TryGetError{requested: 4, available: 3}), buf.try_get_f32_le());\n    /// assert_eq!(3, buf.remaining());\n    /// ```\n    fn try_get_f32_le(&mut self) -> Result<f32, TryGetError> {\n        Ok(f32::from_bits(self.try_get_u32_le()?))\n    }\n\n    /// Gets an IEEE754 single-precision (4 bytes) floating point number from\n    /// `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by 4.\n    ///\n    /// Returns `Err(TryGetError)` when there are not enough\n    /// remaining bytes to read the value.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let mut buf: &[u8] = match cfg!(target_endian = \"big\") {\n    ///     true => b\"\\x3F\\x99\\x99\\x9A hello\",\n    ///     false => b\"\\x9A\\x99\\x99\\x3F hello\",\n    /// };\n    /// assert_eq!(1.2f32, buf.get_f32_ne());\n    /// assert_eq!(6, buf.remaining());\n    /// ```\n    ///\n    /// ```\n    /// use bytes::{Buf, TryGetError};\n    ///\n    /// let mut buf = &b\"\\x3F\\x99\\x99\"[..];\n    /// assert_eq!(Err(TryGetError{requested: 4, available: 3}), buf.try_get_f32_ne());\n    /// assert_eq!(3, buf.remaining());\n    /// ```\n    fn try_get_f32_ne(&mut self) -> Result<f32, TryGetError> {\n        Ok(f32::from_bits(self.try_get_u32_ne()?))\n    }\n\n    /// Gets an IEEE754 double-precision (8 bytes) floating point number from\n    /// `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// Returns `Err(TryGetError)` when there are not enough\n    /// remaining bytes to read the value.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let mut buf = &b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\\x33 hello\"[..];\n    /// assert_eq!(1.2f64, buf.get_f64());\n    /// assert_eq!(6, buf.remaining());\n    /// ```\n    ///\n    /// ```\n    /// use bytes::{Buf, TryGetError};\n    ///\n    /// let mut buf = &b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\"[..];\n    /// assert_eq!(Err(TryGetError{requested: 8, available: 7}), buf.try_get_f64());\n    /// assert_eq!(7, buf.remaining());\n    /// ```\n    fn try_get_f64(&mut self) -> Result<f64, TryGetError> {\n        Ok(f64::from_bits(self.try_get_u64()?))\n    }\n\n    /// Gets an IEEE754 double-precision (8 bytes) floating point number from\n    /// `self` in little-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// Returns `Err(TryGetError)` when there are not enough\n    /// remaining bytes to read the value.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let mut buf = &b\"\\x33\\x33\\x33\\x33\\x33\\x33\\xF3\\x3F hello\"[..];\n    /// assert_eq!(1.2f64, buf.get_f64_le());\n    /// assert_eq!(6, buf.remaining());\n    /// ```\n    ///\n    /// ```\n    /// use bytes::{Buf, TryGetError};\n    ///\n    /// let mut buf = &b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\"[..];\n    /// assert_eq!(Err(TryGetError{requested: 8, available: 7}), buf.try_get_f64_le());\n    /// assert_eq!(7, buf.remaining());\n    /// ```\n    fn try_get_f64_le(&mut self) -> Result<f64, TryGetError> {\n        Ok(f64::from_bits(self.try_get_u64_le()?))\n    }\n\n    /// Gets an IEEE754 double-precision (8 bytes) floating point number from\n    /// `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// Returns `Err(TryGetError)` when there are not enough\n    /// remaining bytes to read the value.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let mut buf: &[u8] = match cfg!(target_endian = \"big\") {\n    ///     true => b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\\x33 hello\",\n    ///     false => b\"\\x33\\x33\\x33\\x33\\x33\\x33\\xF3\\x3F hello\",\n    /// };\n    /// assert_eq!(1.2f64, buf.get_f64_ne());\n    /// assert_eq!(6, buf.remaining());\n    /// ```\n    ///\n    /// ```\n    /// use bytes::{Buf, TryGetError};\n    ///\n    /// let mut buf = &b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\"[..];\n    /// assert_eq!(Err(TryGetError{requested: 8, available: 7}), buf.try_get_f64_ne());\n    /// assert_eq!(7, buf.remaining());\n    /// ```\n    fn try_get_f64_ne(&mut self) -> Result<f64, TryGetError> {\n        Ok(f64::from_bits(self.try_get_u64_ne()?))\n    }\n\n    /// Consumes `len` bytes inside self and returns new instance of `Bytes`\n    /// with this data.\n    ///\n    /// This function may be optimized by the underlying type to avoid actual\n    /// copies. For example, `Bytes` implementation will do a shallow copy\n    /// (ref-count increment).\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let bytes = (&b\"hello world\"[..]).copy_to_bytes(5);\n    /// assert_eq!(&bytes[..], &b\"hello\"[..]);\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if `len > self.remaining()`.\n    fn copy_to_bytes(&mut self, len: usize) -> crate::Bytes {\n        use super::BufMut;\n\n        if self.remaining() < len {\n            panic_advance(&TryGetError {\n                requested: len,\n                available: self.remaining(),\n            });\n        }\n\n        let mut ret = crate::BytesMut::with_capacity(len);\n        ret.put(self.take(len));\n        ret.freeze()\n    }\n\n    /// Creates an adaptor which will read at most `limit` bytes from `self`.\n    ///\n    /// This function returns a new instance of `Buf` which will read at most\n    /// `limit` bytes.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::{Buf, BufMut};\n    ///\n    /// let mut buf = b\"hello world\"[..].take(5);\n    /// let mut dst = vec![];\n    ///\n    /// dst.put(&mut buf);\n    /// assert_eq!(dst, b\"hello\");\n    ///\n    /// let mut buf = buf.into_inner();\n    /// dst.clear();\n    /// dst.put(&mut buf);\n    /// assert_eq!(dst, b\" world\");\n    /// ```\n    fn take(self, limit: usize) -> Take<Self>\n    where\n        Self: Sized,\n    {\n        take::new(self, limit)\n    }\n\n    /// Creates an adaptor which will chain this buffer with another.\n    ///\n    /// The returned `Buf` instance will first consume all bytes from `self`.\n    /// Afterwards the output is equivalent to the output of next.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::Buf;\n    ///\n    /// let mut chain = b\"hello \"[..].chain(&b\"world\"[..]);\n    ///\n    /// let full = chain.copy_to_bytes(11);\n    /// assert_eq!(full.chunk(), b\"hello world\");\n    /// ```\n    fn chain<U>(self, next: U) -> Chain<Self, U>\n    where\n        Self: Sized,\n    {\n        Chain::new(self, next)\n    }\n\n    /// Creates an adaptor which implements the `Read` trait for `self`.\n    ///\n    /// This function returns a new value which implements `Read` by adapting\n    /// the `Read` trait functions to the `Buf` trait functions. Given that\n    /// `Buf` operations are infallible, none of the `Read` functions will\n    /// return with `Err`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::{Bytes, Buf};\n    /// use std::io::Read;\n    ///\n    /// let buf = Bytes::from(\"hello world\");\n    ///\n    /// let mut reader = buf.reader();\n    /// let mut dst = [0; 1024];\n    ///\n    /// let num = reader.read(&mut dst).unwrap();\n    ///\n    /// assert_eq!(11, num);\n    /// assert_eq!(&dst[..11], &b\"hello world\"[..]);\n    /// ```\n    #[cfg(feature = \"std\")]\n    #[cfg_attr(docsrs, doc(cfg(feature = \"std\")))]\n    fn reader(self) -> Reader<Self>\n    where\n        Self: Sized,\n    {\n        reader::new(self)\n    }\n}","attr_info":{"attributes":[{"DocComment":" Read bytes from a buffer."},{"DocComment":""},{"DocComment":" A buffer stores bytes in memory such that read operations are infallible."},{"DocComment":" The underlying storage may or may not be in contiguous memory. A `Buf` value"},{"DocComment":" is a cursor into the buffer. Reading from `Buf` advances the cursor"},{"DocComment":" position. It can be thought of as an efficient `Iterator` for collections of"},{"DocComment":" bytes."},{"DocComment":""},{"DocComment":" The simplest `Buf` is a `&[u8]`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(b'h', buf.get_u8());"},{"DocComment":" assert_eq!(b'e', buf.get_u8());"},{"DocComment":" assert_eq!(b'l', buf.get_u8());"},{"DocComment":""},{"DocComment":" let mut rest = [0; 8];"},{"DocComment":" buf.copy_to_slice(&mut rest);"},{"DocComment":""},{"DocComment":" assert_eq!(&rest[..], &b\"lo world\"[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"remaining","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["remaining",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":143,"col":4},"end":{"line":143,"col":33}},"generated_from_span":null}},"source_text":"fn remaining(&self) -> usize;","attr_info":{"attributes":[{"DocComment":" Returns the number of bytes between the current position and the end of"},{"DocComment":" the buffer."},{"DocComment":""},{"DocComment":" This value is greater than or equal to the length of the slice returned"},{"DocComment":" by `chunk()`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.remaining(), 11);"},{"DocComment":""},{"DocComment":" buf.get_u8();"},{"DocComment":""},{"DocComment":" assert_eq!(buf.remaining(), 10);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" Implementations of `remaining` should ensure that the return value does"},{"DocComment":" not change unless a call is made to `advance` or any other function that"},{"DocComment":" is documented to change the `Buf`'s current position."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},"default":null},"kind":{"TraitMethod":[12,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunk","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["chunk",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":176,"col":4},"end":{"line":176,"col":29}},"generated_from_span":null}},"source_text":"fn chunk(&self) -> &[u8];","attr_info":{"attributes":[{"DocComment":" Returns a slice starting at the current position and of length between 0"},{"DocComment":" and `Buf::remaining()`. Note that this *can* return a shorter slice (this"},{"DocComment":" allows non-continuous internal representation)."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" buf.advance(6);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. `chunk()` should return an empty"},{"DocComment":" slice **if and only if** `remaining()` returns 0. In other words,"},{"DocComment":" `chunk()` returning an empty slice implies that `remaining()` will"},{"DocComment":" return 0 and `remaining()` returning 0 implies that `chunk()` will"},{"DocComment":" return an empty slice."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"Slice":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},null]}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[12,1]}},{"params":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunks_vectored","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["chunks_vectored",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":207,"col":4},"end":{"line":218,"col":5}},"generated_from_span":null}},"source_text":"fn chunks_vectored<'a>(&'a self, dst: &mut [IoSlice<'a>]) -> usize {\n        if dst.is_empty() {\n            return 0;\n        }\n\n        if self.has_remaining() {\n            dst[0] = IoSlice::new(self.chunk());\n            1\n        } else {\n            0\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Fills `dst` with potentially multiple slices starting at `self`'s"},{"DocComment":" current position."},{"DocComment":""},{"DocComment":" If the `Buf` is backed by disjoint slices of bytes, `chunk_vectored` enables"},{"DocComment":" fetching more than one slice at once. `dst` is a slice of `IoSlice`"},{"DocComment":" references, enabling the slice to be directly used with [`writev`]"},{"DocComment":" without any further conversion. The sum of the lengths of all the"},{"DocComment":" buffers written to `dst` will be less than or equal to `Buf::remaining()`."},{"DocComment":""},{"DocComment":" The entries in `dst` will be overwritten, but the data **contained** by"},{"DocComment":" the slices **will not** be modified. The return value is the number of"},{"DocComment":" slices written to `dst`. If `Buf::remaining()` is non-zero, then this"},{"DocComment":" writes at least one non-empty slice to `dst`."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. Once the end of the buffer is reached,"},{"DocComment":" i.e., `Buf::remaining` returns 0, calls to `chunk_vectored` must return 0"},{"DocComment":" without mutating `dst`."},{"DocComment":""},{"DocComment":" Implementations should also take care to properly handle being called"},{"DocComment":" with `dst` being a zero length slice."},{"DocComment":""},{"DocComment":" [`writev`]: http://man7.org/linux/man-pages/man2/readv.2.html"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Bound":[0,1]}},{"Untagged":{"Slice":[{"Untagged":{"Adt":{"id":41,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},null]}},"Mut"]}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},"default":{"id":125,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[12,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["advance",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":250,"col":4},"end":{"line":250,"col":38}},"generated_from_span":null}},"source_text":"fn advance(&mut self, cnt: usize);","attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the Buf"},{"DocComment":""},{"DocComment":" The next call to `chunk()` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" buf.advance(6);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance` to panic if `cnt >"},{"DocComment":" self.remaining()`. If the implementation does not panic, the call must"},{"DocComment":" behave as if `cnt == self.remaining()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":null},"kind":{"TraitMethod":[12,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","