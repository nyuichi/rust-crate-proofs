 available: self.remaining_mut(),\n            })\n        }\n\n        while cnt > 0 {\n            let dst = self.chunk_mut();\n            let dst_len = usize::min(dst.len(), cnt);\n            // SAFETY: The pointer is valid for `dst_len <= dst.len()` bytes.\n            unsafe { core::ptr::write_bytes(dst.as_mut_ptr(), val, dst_len) };\n            // SAFETY: We just initialized `dst_len` bytes in `self`.\n            unsafe { self.advance_mut(dst_len) };\n            cnt -= dst_len;\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Put `cnt` bytes `val` into `self`."},{"DocComment":""},{"DocComment":" Logically equivalent to calling `self.put_u8(val)` `cnt` times, but may work faster."},{"DocComment":""},{"DocComment":" `self` must have at least `cnt` remaining capacity."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 6];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let mut buf = &mut dst[..];"},{"DocComment":"     buf.put_bytes(b'a', 4);"},{"DocComment":""},{"DocComment":"     assert_eq!(2, buf.remaining_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(b\"aaaa\\0\\0\", &dst);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function panics if there is not enough remaining capacity in"},{"DocComment":" `self`."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":32,"beg":{"line":291,"col":4},"end":{"line":291,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},{"Untagged":{"Scala