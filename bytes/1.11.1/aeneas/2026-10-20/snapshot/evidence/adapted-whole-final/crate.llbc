= &PROMOTABLE_ODD_VTABLE\n            {\n                drop(self.split_off(len));\n            } else {\n                self.len = len;\n            }\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Shortens the buffer, keeping the first `len` bytes and dropping the"},{"DocComment":" rest."},{"DocComment":""},{"DocComment":" If `len` is greater than the buffer's current length, this has no"},{"DocComment":" effect."},{"DocComment":""},{"DocComment":" The [split_off](`Self::split_off()`) method can emulate `truncate`, but this causes the"},{"DocComment":" excess bytes to be returned instead of dropped."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut buf = Bytes::from(&b\"hello world\"[..]);"},{"DocComment":" buf.truncate(5);"},{"DocComment":" assert_eq!(buf, b\"hello\"[..]);"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":11,"beg":{"line":587,"col":4},"end":{"line":587,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":"Opaque"},{"def_id":114,"item_meta":{"name"