s function is not magic; it is literally defined as"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" pub fn drop<T>(_x: T) {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `_x` is moved into the function, it is automatically [dropped][drop] before"},{"DocComment":" the function returns."},{"DocComment":""},{"DocComment":" [drop]: Drop"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![1, 2, 3];"},{"DocComment":""},{"DocComment":" drop(v); // explicitly drop the vector"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since [`RefCell`] enforces the borrow rules at runtime, `drop` can"},{"DocComment":" release a [`RefCell`] borrow:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cell::RefCell;"},{"DocComment":""},{"DocComment":" let x = RefCell::new(1);"},{"DocComment":""},{"DocComment":" let mut mutable_borrow = x.borrow_mut();"},{"DocComment":" *mutable_borrow = 1;"},{"DocComment":""},{"DocComment":" drop(mutable_borrow); // relinquish the mutable borrow on this slot"},{"DocComment":""},{"DocComment":" let borrow = x.borrow();"},{"DocComment":" println!(\"{}\", *borrow);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"