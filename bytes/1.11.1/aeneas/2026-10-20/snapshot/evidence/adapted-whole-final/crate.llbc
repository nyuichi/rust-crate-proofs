Bytes {\n        use super::BufMut;\n\n        if self.remaining() < len {\n            panic_advance(&TryGetError {\n                requested: len,\n                available: self.remaining(),\n            });\n        }\n\n        let mut ret = crate::BytesMut::with_capacity(len);\n        ret.put(self.take(len));\n        ret.freeze()\n    }","attr_info":{"attributes":[{"DocComment":" Consumes `len` bytes inside self and returns new instance of `Bytes`"},{"DocComment":" with this data."},{"DocComment":""},{"DocComment":" This function may be optimized by the underlying type to avoid actual"},{"DocComment":" copies. For example, `Bytes` implementation will do a shallow copy"},{"DocComment":" (ref-count increment)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let bytes = (&b\"hello world\"[..]).copy_to_bytes(5);"},{"DocComment":" assert_eq!(&bytes[..], &b\"hello\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function panics if `len > self.remaining()`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":205,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[12,83]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"take","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["take",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":2394,"col":4},"end":{"line":2399,"col":5}},"generated_from_span":null}},"source_text":"fn take(self, limit: usize) -> Take<Self>\n    where\n        Self: Sized,\n    {\n        take::new(self, limit)\n    }","attr_info":{"attributes":[{"DocComment":" Creates an adaptor which will read at most `limit` bytes from `self`."},{"DocComment":""},{"DocComment":" This function returns a new instance of `Buf` which will read at most"},{"DocComment":" `limit` bytes."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Buf, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = b\"hello world\"[..].take(5);"},{"DocComment":" let mut dst = vec![];"},{"DocComment":""},{"DocComment":" dst.put(&mut buf);"},{"DocComment":" assert_eq!(dst, b\"hello\");"},{"DocComment":""},{"DocComment":" let mut buf = buf.into_inner();"},{"DocComment":" dst.clear();"},{"DocComment":" dst.put(&mut buf);"},{"DocComment":" assert_eq!(dst, b\" world\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":206,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[12,84]}},{"params":{"regions":[],"types":[{"index":0,"name":"U","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chain","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["chain",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":2416,"col":4},"end":{"line":2421,"col":5}},"generated_from_span":null}},"source_text":"fn chain<U>(self, next: U) -> Chain<Self, U>\n    where\n        Self: Sized,\n    {\n        Chain::new(self, next)\n    }","attr_info":{"attributes":[{"DocComment":" Creates an adaptor which will chain this buffer with another."},{"DocComment":""},{"DocComment":" The returned `Buf` instance will first consume all bytes from `self`."},{"DocComment":" Afterwards the output is equivalent to the output of next."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut chain = b\"hello \"[..].chain(&b\"world\"[..]);"},{"DocComment":""},{"DocComment":" let full = chain.copy_to_bytes(11);"},{"DocComment":" assert_eq!(full.chunk(), b\"hello world\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"output":{"Untagged":{"Adt":{"id":29,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":207,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[12,85]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"reader","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["reader",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":2448,"col":4},"end":{"line":2453,"col":5}},"generated_from_span":null}},"source_text":"fn reader(self) -> Reader<Self>\n    where\n        Self: Sized,\n    {\n        reader::new(self)\n    }","attr_info":{"attributes":[{"DocComment":" Creates an adaptor which implements the `Read` trait for `self`."},{"DocComment":""},{"DocComment":" This function returns a new value which implements `Read` by adapting"},{"DocComment":" the `Read` trait functions to the `Buf` trait functions. Given that"},{"DocComment":" `Buf` operations are infallible, none of the `Read` functions will"},{"DocComment":" return with `Err`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Bytes, Buf};"},{"DocComment":" use std::io::Read;"},{"DocComment":""},{"DocComment":" let buf = Bytes::from(\"hello world\");"},{"DocComment":""},{"DocComment":" let mut reader = buf.reader();"},{"DocComment":" let mut dst = [0; 1024];"},{"DocComment":""},{"DocComment":" let num = reader.read(&mut dst).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(11, num);"},{"DocComment":" assert_eq!(&dst[..11], &b\"hello world\"[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}}],"output":{"Untagged":{"Adt":{"id":42,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":208,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[12,86]}}],"vtable":{"id":40,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":13,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]}],"span":{"Untagged":{"data":{"file_id":32,"beg":{"line":30,"col":0},"end":{"line":1351,"col":1}},"generated_from_span":null}},"source_text":"pub unsafe trait BufMut {\n    /// Returns the number of bytes that can be written from the current\n    /// position until the end of the buffer is reached.\n    ///\n    /// This value is greater than or equal to the length of the slice returned\n    /// by `chunk_mut()`.\n    ///\n    /// Writing to a `BufMut` may involve allocating more memory on the fly.\n    /// Implementations may fail before reaching the number of bytes indicated\n    /// by this method if they encounter an allocation failure.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut dst = [0; 10];\n    /// let mut buf = &mut dst[..];\n    ///\n    /// let original_remaining = buf.remaining_mut();\n    /// buf.put(&b\"hello\"[..]);\n    ///\n    /// assert_eq!(original_remaining - 5, buf.remaining_mut());\n    /// ```\n    ///\n    /// # Implementer notes\n    ///\n    /// Implementations of `remaining_mut` should ensure that the return value\n    /// does not change unless a call is made to `advance_mut` or any other\n    /// function that is documented to change the `BufMut`'s current position.\n    ///\n    /// # Note\n    ///\n    /// `remaining_mut` may return value smaller than actual available space.\n    fn remaining_mut(&self) -> usize;\n\n    /// Advance the internal cursor of the BufMut\n    ///\n    /// The next call to `chunk_mut` will return a slice starting `cnt` bytes\n    /// further into the underlying buffer.\n    ///\n    /// # Safety\n    ///\n    /// The caller must ensure that the next `cnt` bytes of `chunk` are\n    /// initialized.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = Vec::with_capacity(16);\n    ///\n    /// // Write some data\n    /// buf.chunk_mut()[0..2].copy_from_slice(b\"he\");\n    /// unsafe { buf.advance_mut(2) };\n    ///\n    /// // write more bytes\n    /// buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");\n    ///\n    /// unsafe { buf.advance_mut(3); }\n    ///\n    /// assert_eq!(5, buf.len());\n    /// assert_eq!(buf, b\"hello\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function **may** panic if `cnt > self.remaining_mut()`.\n    ///\n    /// # Implementer notes\n    ///\n    /// It is recommended for implementations of `advance_mut` to panic if\n    /// `cnt > self.remaining_mut()`. If the implementation does not panic,\n    /// the call must behave as if `cnt == self.remaining_mut()`.\n    ///\n    /// A call with `cnt == 0` should never panic and be a no-op.\n    unsafe fn advance_mut(&mut self, cnt: usize);\n\n    /// Returns true if there is space in `self` for more bytes.\n    ///\n    /// This is equivalent to `self.remaining_mut() != 0`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut dst = [0; 5];\n    /// let mut buf = &mut dst[..];\n    ///\n    /// assert!(buf.has_remaining_mut());\n    ///\n    /// buf.put(&b\"hello\"[..]);\n    ///\n    /// assert!(!buf.has_remaining_mut());\n    /// ```\n    #[inline]\n    fn has_remaining_mut(&self) -> bool {\n        self.remaining_mut() > 0\n    }\n\n    /// Returns a mutable slice starting at the current BufMut position and of\n    /// length between 0 and `BufMut::remaining_mut()`. Note that this *can* be shorter than the\n    /// whole remainder of the buffer (this allows non-continuous implementation).\n    ///\n    /// This is a lower level function. Most operations are done with other\n    /// functions.\n    ///\n    /// The returned byte slice may represent uninitialized memory.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = Vec::with_capacity(16);\n    ///\n    /// unsafe {\n    ///     // MaybeUninit::as_mut_ptr\n    ///     buf.chunk_mut()[0..].as_mut_ptr().write(b'h');\n    ///     buf.chunk_mut()[1..].as_mut_ptr().write(b'e');\n    ///\n    ///     buf.advance_mut(2);\n    ///\n    ///     buf.chunk_mut()[0..].as_mut_ptr().write(b'l');\n    ///     buf.chunk_mut()[1..].as_mut_ptr().write(b'l');\n    ///     buf.chunk_mut()[2..].as_mut_ptr().write(b'o');\n    ///\n    ///     buf.advance_mut(3);\n    /// }\n    ///\n    /// assert_eq!(5, buf.len());\n    /// assert_eq!(buf, b\"hello\");\n    /// ```\n    ///\n    /// # Implementer notes\n    ///\n    /// This function should never panic. `chunk_mut()` should return an empty\n    /// slice **if and only if** `remaining_mut()` returns 0. In other words,\n    /// `chunk_mut()` returning an empty slice implies that `remaining_mut()` will\n    /// return 0 and `remaining_mut()` returning 0 implies that `chunk_mut()` will\n    /// return an empty slice.\n    ///\n    /// This function may trigger an out-of-memory abort if it tries to allocate\n    /// memory and fails to do so.\n    // The `chunk_mut` method was previously called `bytes_mut`. This alias makes the\n    // rename more easily discoverable.\n    #[cfg_attr(docsrs, doc(alias = \"bytes_mut\"))]\n    fn chunk_mut(&mut self) -> &mut UninitSlice;\n\n    /// Transfer bytes into `self` from `src` and advance the cursor by the\n    /// number of bytes written.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    ///\n    /// buf.put_u8(b'h');\n    /// buf.put(&b\"ello\"[..]);\n    /// buf.put(&b\" world\"[..]);\n    ///\n    /// assert_eq!(buf, b\"hello world\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// Panics if `self` does not have enough capacity to contain `src`.\n    #[inline]\n    fn put<T: super::Buf>(&mut self, mut src: T)\n    where\n        Self: Sized,\n    {\n        if self.remaining_mut() < src.remaining() {\n            panic_advance(&TryGetError {\n                requested: src.remaining(),\n                available: self.remaining_mut(),\n            });\n        }\n\n        while src.has_remaining() {\n            let s = src.chunk();\n            let d = self.chunk_mut();\n            let cnt = usize::min(s.len(), d.len());\n\n            d[..cnt].copy_from_slice(&s[..cnt]);\n\n            // SAFETY: We just initialized `cnt` bytes in `self`.\n            unsafe { self.advance_mut(cnt) };\n            src.advance(cnt);\n        }\n    }\n\n    /// Transfer bytes into `self` from `src` and advance the cursor by the\n    /// number of bytes written.\n    ///\n    /// `self` must have enough remaining capacity to contain all of `src`.\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut dst = [0; 6];\n    ///\n    /// {\n    ///     let mut buf = &mut dst[..];\n    ///     buf.put_slice(b\"hello\");\n    ///\n    ///     assert_eq!(1, buf.remaining_mut());\n    /// }\n    ///\n    /// assert_eq!(b\"hello\\0\", &dst);\n    /// ```\n    #[inline]\n    fn put_slice(&mut self, mut src: &[u8]) {\n        if self.remaining_mut() < src.len() {\n            panic_advance(&TryGetError {\n                requested: src.len(),\n                available: self.remaining_mut(),\n            });\n        }\n\n        while !src.is_empty() {\n            let dst = self.chunk_mut();\n            let cnt = usize::min(src.len(), dst.len());\n\n            dst[..cnt].copy_from_slice(&src[..cnt]);\n            src = &src[cnt..];\n\n            // SAFETY: We just initialized `cnt` bytes in `self`.\n            unsafe { self.advance_mut(cnt) };\n        }\n    }\n\n    /// Put `cnt` bytes `val` into `self`.\n    ///\n    /// Logically equivalent to calling `self.put_u8(val)` `cnt` times, but may work faster.\n    ///\n    /// `self` must have at least `cnt` remaining capacity.\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut dst = [0; 6];\n    ///\n    /// {\n    ///     let mut buf = &mut dst[..];\n    ///     buf.put_bytes(b'a', 4);\n    ///\n    ///     assert_eq!(2, buf.remaining_mut());\n    /// }\n    ///\n    /// assert_eq!(b\"aaaa\\0\\0\", &dst);\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_bytes(&mut self, val: u8, mut cnt: usize) {\n        if self.remaining_mut() < cnt {\n            panic_advance(&TryGetError {\n                requested: cnt,\n                available: self.remaining_mut(),\n            })\n        }\n\n        while cnt > 0 {\n            let dst = self.chunk_mut();\n            let dst_len = usize::min(dst.len(), cnt);\n            // SAFETY: The pointer is valid for `dst_len <= dst.len()` bytes.\n            unsafe { core::ptr::write_bytes(dst.as_mut_ptr(), val, dst_len) };\n            // SAFETY: We just initialized `dst_len` bytes in `self`.\n            unsafe { self.advance_mut(dst_len) };\n            cnt -= dst_len;\n        }\n    }\n\n    /// Writes an unsigned 8 bit integer to `self`.\n    ///\n    /// The current position is advanced by 1.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_u8(0x01);\n    /// assert_eq!(buf, b\"\\x01\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_u8(&mut self, n: u8) {\n        let src = [n];\n        self.put_slice(&src);\n    }\n\n    /// Writes a signed 8 bit integer to `self`.\n    ///\n    /// The current position is advanced by 1.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_i8(0x01);\n    /// assert_eq!(buf, b\"\\x01\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_i8(&mut self, n: i8) {\n        let src = [n as u8];\n        self.put_slice(&src)\n    }\n\n    /// Writes an unsigned 16 bit integer to `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by 2.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_u16(0x0809);\n    /// assert_eq!(buf, b\"\\x08\\x09\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_u16(&mut self, n: u16) {\n        self.put_slice(&n.to_be_bytes())\n    }\n\n    /// Writes an unsigned 16 bit integer to `self` in little-endian byte order.\n    ///\n    /// The current position is advanced by 2.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_u16_le(0x0809);\n    /// assert_eq!(buf, b\"\\x09\\x08\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_u16_le(&mut self, n: u16) {\n        self.put_slice(&n.to_le_bytes())\n    }\n\n    /// Writes an unsigned 16 bit integer to `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by 2.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    