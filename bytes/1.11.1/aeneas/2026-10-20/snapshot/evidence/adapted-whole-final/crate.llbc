agnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":12,"col":9},"end":{"line":12,"col":14}},"generated_from_span":{"file_id":36,"beg":{"line":13,"col":16},"end":{"line":13,"col":17}}}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":787,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}},{"Var":{"Bound":[0,2]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":{"Clause":[{"Free":0},{"regions":[]}]},"trait_decl_ref":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}},"kind":{"TraitMethod":[5,0]}}],"vtable":"Lazy"},{"def_id":137,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["take",0]},{"Impl":{"Trait":137}}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":135,"col":0},"end":{"line":187,"col":1}},"generated_from_span":null}},"source_text":"impl<T: Buf> Buf for Take<T> {\n    fn remaining(&self) -> usize {\n        cmp::min(self.inner.remaining(), self.limit)\n    }\n\n    fn chunk(&self) -> &[u8] {\n        let bytes = self.inner.chunk();\n        &bytes[..cmp::min(bytes.len(), self.limit)]\n    }\n\n    fn advance(&mut self, cnt: usize) {\n        assert!(cnt <= self.limit);\n        self.inner.advance(cnt);\n        self.limit -= cnt;\n    }\n\n    fn copy_to_bytes(&mut self, len: usize) -> crate::Bytes {\n        assert!(len <= self.remaining(), \"`len` greater than remaining\");\n\n        let r = self.inner.copy_to_bytes(len);\n        self.limit -= len;\n        r\n    }\n\n    #[cfg(feature = \"std\")]\n    fn chunks_vectored<'a>(&'a self, dst: &mut [IoSlice<'a>]) -> usize {\n        if self.limit == 0 {\n            return 0;\n        }\n\n        const LEN: usize = 16;\n        let mut slices: [IoSlice<'a>; LEN] = [IoSlice::new(&[]); LEN];\n\n        let cnt = self\n            .inner\n            .chunks_vectored(&mut slices[..dst.len().min(LEN)]);\n        let mut limit = self.limit;\n        for (i, (dst, slice)) in dst[..cnt].iter_mut().zip(slices.iter()).enumerate() {\n            if let Some(buf) = slice.get(..limit) {\n                // SAFETY: We could do this safely with `IoSlice::advance` if we had a larger MSRV.\n                let buf = unsafe { std::mem::transmute::<&[u8], &'a [u8]>(buf) };\n                *dst = IoSlice::new(buf);\n                return i + 1;\n            } else {\n                // SAFETY: We could do this safely with `IoSlice::advance` if we had a larger MSRV.\n                let buf = unsafe { std::mem::transmute::<&[u8], &'a [u8]>(slice) };\n                *dst = IoSlice::new(buf);\n                limit -= slice.len();\n            }\n        }\n        cnt\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":135,"col":8},"end":{"line":135,"col":11}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":793,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":{"Clause":[{"Free":0},{"regions":[]}]},"trait_decl_ref":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}},"kind":{"TraitMethod":[12,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"