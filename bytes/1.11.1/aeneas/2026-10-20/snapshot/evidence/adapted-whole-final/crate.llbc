 {\n            return Bytes::new();\n        }\n\n        let bytes_p = self.as_ptr() as usize;\n        let bytes_len = self.len();\n\n        let sub_p = subset.as_ptr() as usize;\n        let sub_len = subset.len();\n\n        assert!(\n            sub_p >= bytes_p,\n            \"subset pointer ({:p}) is smaller than self pointer ({:p})\",\n            subset.as_ptr(),\n            self.as_ptr(),\n        );\n        assert!(\n            sub_p + sub_len <= bytes_p + bytes_len,\n            \"subset is out of bounds: self = ({:p}, {}), subset = ({:p}, {})\",\n            self.as_ptr(),\n            bytes_len,\n            subset.as_ptr(),\n            sub_len,\n        );\n\n        let sub_offset = sub_p - bytes_p;\n\n        self.slice(sub_offset..(sub_offset + sub_len))\n    }","attr_info":{"attributes":[{"DocComment":" Returns a slice of self that is equivalent to the given `subset`."},{"DocComment":""},{"DocComment":" When processing a `Bytes` buffer with other tools, one often gets a"},{"DocComment":" `&[u8]` which is in fact a slice of the `Bytes`, i.e. a subset of it."},{"DocComment":" This function turns that `&[u8]` into another `Bytes`, as if one had"},{"DocComment":" called `self.slice()` with the offsets that correspond to `subset`."},{"DocComment":""},{"DocComment":" This operation is `O(1)`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let bytes = Bytes::from(&b\"012345678\"[..]);"},{"DocComment":" let as_slice = bytes.as_ref();"},{"DocComment":" let subset = &as_slice[2..6];"},{"DocComment":" let subslice = bytes.slice_ref(&subset);"},{"DocComment":" assert_eq!(&subslice[..], b\"2345\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Requires that the given `sub` slice is in fact contained within the"},{"DocComment":" `Bytes` buffer; otherwise this function will panic."}],"inlin