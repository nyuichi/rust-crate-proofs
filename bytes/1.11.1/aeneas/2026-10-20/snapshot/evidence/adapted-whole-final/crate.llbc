Equal {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool { true }"},{"DocComment":" }"},{"DocComment":" impl PartialOrd for Equal {"},{"DocComment":"     fn partial_cmp(&self, other: &Self) -> Option<Ordering> { Some(Ordering::Equal) }"},{"DocComment":" }"},{"DocComment":" impl Ord for Equal {"},{"DocComment":"     fn cmp(&self, other: &Self) -> Ordering { Ordering::Equal }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Equal(\"self\").min(Equal(\"other\")).0, \"self\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"cmp_ord_min","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":0}}}],"output":{"Untagged":{"TypeVar":{"Free":0}}}},"default":{"id":231,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":27,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":4,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[27,2]}},null,null],"vtable":null},{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["clamp",0]},{"Ident":["ClampBounds",0]}],"span":{"Untagged":{"data":{"file_id":55,"beg":{"line":7,"col":0},"end":{"line":7,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for ranges supported by [`Ord::clamp_to`]."}],"inline":null,"rename":null,"public"