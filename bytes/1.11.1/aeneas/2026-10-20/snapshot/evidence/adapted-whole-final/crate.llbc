ffer so that `len` is equal to `new_len`."},{"DocComment":""},{"DocComment":" If `new_len` is greater than `len`, the buffer is extended by the"},{"DocComment":" difference with each additional byte set to `value`. If `new_len` is"},{"DocComment":" less than `len`, the buffer is simply truncated."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::new();"},{"DocComment":""},{"DocComment":" buf.resize(3, 0x1);"},{"DocComment":" assert_eq!(&buf[..], &[0x1, 0x1, 0x1]);"},{"DocComment":""},{"DocComment":" buf.resize(2, 0x2);"},{"DocComment":" assert_eq!(&buf[..], &[0x1, 0x1]);"},{"DocComment":""},{"DocComment":" buf.resize(4, 0x3);"},{"DocComment":" assert_eq!(&buf[..], &[0x1, 0x1, 0x3, 0x3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":"Opaque"},{"def_id":301,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["set_len",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":527,"col":4},"end":{"line":530,"col":5}},"generated_from_span":null}},"source_text":"pub unsafe fn set_len(&mut self, len: usize) {\n        debug_assert!(len <= self.cap, \"set_len out of bounds\");\n        self.len = len;\n    }","attr_info":{"attributes":[{"DocComment":" Sets the length of the buffer."},{"DocComment":""},{"DocComment":" This will explicitly set the size of the buffer without actually"},{"DocComment":" modifying the data, so it is up to the caller to ensure that the data"},{"DocComment":" has been initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut b = BytesMut::from(&b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     b.set_len(5);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(&b[..], b\"hello\");"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     b.set_len(11);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(&b[..], b\"hello world\");"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":12,"beg":{"line":526,"col":4},"end":{"line":526,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":"Opaque"},{"def_id":302,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["reserve",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":591,"col":4},"end":{"line":603,"col":5}},"generated_from_span":null}},"source_text":"pub fn reserve(&mut self, additional: usize) {\n        let len = self.len();\n        let rem = self.capacity() - len;\n\n        if additional <= rem {\n            // The handle can already store at least `additional` more bytes, so\n            // there is no further work needed to be done.\n            return;\n        }\n\n        // will always succeed\n        let _ = self.reserve_inner(additional, true);\n    }","attr_info":{"attributes":[{"DocComment":" Reserves capacity for at least `additional` more bytes to be inserted"},{"DocComment":" into the given `BytesMut`."},{"DocComment":""},{"DocComment":" More than `additional` bytes may be reserved in order to avoid frequent"},{"DocComment":" reallocations. A call to `reserve` may result in an allocation."},{"DocComment":""},{"DocComment":" Before allocating new buffer space, the function will attempt to reclaim"},{"DocComment":" space in the existing buffer. If the current handle references a view"},{"DocComment":" into a larger original buffer, and all other handles referencing part"},{"DocComment":" of the same original buffer have been dropped, then the current view"},{"DocComment":" can be copied/shifted to the front of the buffer and the handle can take"},{"DocComment":" ownership of the full buffer, provided that the full buffer is large"},{"DocComment":" enough to fit the requested additional capacity."},{"DocComment":""},{"DocComment":" This optimization will only happen if shifting the data from the current"},{"DocComment":" view to the front of the buffer is not too expensive in terms of the"},{"DocComment":" (amortized) time required. The precise condition is subject to change;"},{"DocComment":" as of now, the length of the data being shifted needs to be at least as"},{"DocComment":" large as the distance that it's shifted by. If the current view is empty"},{"DocComment":" and the original buffer is large enough to fit the requested additional"},{"DocComment":" capacity, then reallocations will never happen."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" In the following example, a new buffer is allocated."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::from(&b\"hello\"[..]);"},{"DocComment":" buf.reserve(64);"},{"DocComment":" assert!(buf.capacity() >= 69);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In the following example, the existing buffer is reclaimed."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(128);"},{"DocComment":" buf.put(&[0; 64][..]);"},{"DocComment":""},{"DocComment":" let ptr = buf.as_ptr();"},{"DocComment":" let other = buf.split();"},{"DocComment":""},{"DocComment":" assert!(buf.is_empty());"},{"DocComment":" assert_eq!(buf.capacity(), 64);"},{"DocComment":""},{"DocComment":" drop(other);"},{"DocComment":" buf.reserve(128);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.capacity(), 128);"},{"DocComment":" assert_eq!(buf.as_ptr(), ptr);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity overflows `usize`."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":12,"beg":{"line":590,"col":4},"end":{"line":590,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":{"Structured":{"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":591,"col":4},"end":{"line":603,"col":5}},"generated_from_span":null}},"bound_body_regions":12,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":591,"col":48},"end":{"line":591,"col":48}},"generated_from_span":null}},"ty":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},"drop_flag_for":null},{"index":1,"name":"self","span":{"Untagged":{"data":{"file_id":12,"beg":{"line":591,"col":19},"end":{"line":591,"col":28}},"generated_from_span":null}},"ty":{"Untagged":{"Ref":[{"Body":1},{"Untagged":{"Adt":{"id":12,"generic