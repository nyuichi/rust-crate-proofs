"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Untagged":{"RawPtr":[{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}},"src":"Normal","body":"Opaque"},{"def_id":275,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["const_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"RawPtr":[{"Untagged":{"TypeVar":{"Bound":[0,0]}}},"Shared"]}},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}],"span":{"Untagged":{"data":{"file_id":65,"beg":{"line":1036,"col":4},"end":{"line":1038,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Adds an unsigned offset to a pointer using wrapping arithmetic."},{"DocComment":""},{"DocComment":" `count` is in units of T; e.g., a `count` of 3 represents a pointer"},{"DocComment":" offset of `3 * size_of::<T>()` bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" This operation itself is always safe, but using the resulting pointer is not."},{"DocComment":""},{"DocComment":" The resulting pointer \"remembers\" the [allocation] that `self` points to; it must not"},{"DocComment":" be used to read or write other allocations."},{"DocComment":""},{"DocComment":" In other words, `let z = x.wrapping_add((y as usize) - (x as usize))` does *not* make `z`"},{"DocComment":" the same as `y` even if we assume `T` has size `1` and there is no overflow: `z` is still"},{"DocComment":" attached to the object `x` is attached to, and dereferencing it is Undefined Behavior unless"},{"DocComment":" `x` and `y` point into the same allocation."},{"DocComment":""},{"DocComment":" Compared to [`add`], this method basically delays the requirement of staying within the"},{"DocComment":" same allocation: [`add`] is immediate Undefined Behavior when crossing object"},{"DocComment":" boundaries; `wrapping_add` produces a pointer but still leads to Undefined Behavior if a"},{"DocComment":" pointer is dereferenced when it is out-of-bounds of the object it is attached to. [`add`]"},{"DocComment":" can be optimized better and is thus preferable in performance-sensitive code."},{"DocComment":""},{"DocComment":" The delayed check only considers the value of the pointer that was dereferenced, not the"},{"DocComment":" intermediate values used during the computation of the final result. For example,"},{"DocComment":" `x.wrapping_add(o).wrapping_sub(o)` is always the same as `x`. In other words, leaving the"},{"DocComment":" allocation and then re-entering it later is permitted."},{"DocComment":""},{"DocComment":" [`add`]: #method.add"},{"DocComment":" [allocation]: crate::ptr#allocation"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt::Write;"},{"DocComment":" // Iterate using a raw pointer in increments of two elements"},{"DocComment":" let data = [1u8, 2, 3, 4, 5];"},{"DocComment":" let mut ptr: *const u8 = data.as_ptr();"},{"DocComment":" let step = 2;"},{"DocComment":" let end_rounded_up = ptr.wrapping_add(6);"},{"DocComment":""},{"DocComment":" let mut out = String::new();"},{"DocComment":" while ptr != end_rounded_up {"},{"DocComment":"     unsafe {"},{"DocComment":"         write!(&mut out, \"{}, \", *ptr)?;"},{"DocComment":"     }"},{"DocComment":"     ptr = ptr.wrapping_add(step);"},{"DocComment":" }"},{"DocComment":" assert_eq!(out, \"1, 3, 5, \");"},{"DocComment":" # std::fmt::Result::Ok(())"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null