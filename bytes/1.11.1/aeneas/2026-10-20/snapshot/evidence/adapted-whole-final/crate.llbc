sn't been promoted to an\n        // `Arc`, those three fields still are the components of the\n        // vector.\n        let shared = Box::new(Shared {\n            vec: rebuild_vec(self.ptr.as_ptr(), self.len, self.cap, off),\n            original_capacity_repr,\n            ref_count: AtomicUsize::new(ref_cnt),\n        });\n\n        let shared = Box::into_raw(shared);\n\n        // The pointer should be aligned, so this assert should\n        // always succeed.\n        debug_assert_eq!(shared as usize & KIND_MASK, KIND_ARC);\n\n        self.data = shared;\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":"Opaque"},{"def_id":314,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["shallow_clone",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":1061,"col":4},"end":{"line":1069,"col":5}},"generated_from_span":null}},"source_text":"unsafe fn shallow_clone(&mut self) -> BytesMut {\n        if self.kind() == KIND_ARC {\n            increment_shared(self.data);\n            ptr::read(self)\n        } else {\n            self.promote_to_shared(/*ref_count = */ 2);\n            ptr::read(self)\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Makes an exact shallow clone of `self`."},{"DocComment":""},{"DocComment":" The kind of `self` doesn't matter, but this is unsafe"},{"DocComment":" because the clone will have the same offsets. You must"},{"DocComment":" be sure the returned value to the user doesn't allow"},{"DocComment":" two views into the same range."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":12,"beg":{"line":1060,"col":4},"end":{"line":1060,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":"Opaque"},{"def_id":315,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics