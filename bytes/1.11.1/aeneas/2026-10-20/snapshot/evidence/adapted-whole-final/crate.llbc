."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut a = BytesMut::from(&b\"hello world\"[..]);"},{"DocComment":" let mut b = a.split_off(5);"},{"DocComment":""},{"DocComment":" a[0] = b'j';"},{"DocComment":" b[0] = b'!';"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"jello\");"},{"DocComment":" assert_eq!(&b[..], b\"!world\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `at > capacity`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":"Opaque"},{"def_id":296,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["split",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":362,"col":4},"end":{"line":365,"col":5}},"generated_from_span":null}},"source_text":"pub fn split(&mut self) -> BytesMut {\n        let len = self.len();\n        self.split_to(len)\n    }","attr_info":{"attributes":[{"DocComment":" Removes the bytes from the current view, returning them in a new"},{"DocComment":" `BytesMut` handle."},{"DocComment":""},{"DocComment":" Afterwards, `self` will be empty, but will retain any additional"},{"DocComment":" capacity that it had before the operation. This is identical to"},{"DocComment":" `self.split_to(self.len())`."},{"DocComment":""},{"DocComment":" This is an `O(1)` operation that just increases the reference count and"},{"DocComment":" sets a few indices."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(1024);"},{"DocComment":" buf.put(&b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" let other = buf.split();"},{"DocComment":""},{"DocComment":" assert!(buf.is_empty());"},{"DocComment":" assert_eq!(1013, buf.capacity());"},{"DocComment":""},{"DocComment":" assert_eq!(other, b\"hello world\"[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":