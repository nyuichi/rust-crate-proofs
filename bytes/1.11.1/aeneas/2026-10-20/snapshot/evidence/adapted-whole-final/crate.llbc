g":{"line":30,"col":0},"end":{"line":33,"col":1}},"generated_from_span":null}},"source_text":"pub struct Chain<T, U> {\n    a: T,\n    b: U,\n}","attr_info":{"attributes":[{"DocComment":" A `Chain` sequences two buffers."},{"DocComment":""},{"DocComment":" `Chain` is an adapter that links two underlying buffers and provides a"},{"DocComment":" continuous view across both buffers. It is able to sequence either immutable"},{"DocComment":" buffers ([`Buf`] values) or mutable buffers ([`BufMut`] values)."},{"DocComment":""},{"DocComment":" This struct is generally created by calling [`Buf::chain`]. Please see that"},{"DocComment":" function's documentation for more detail."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Bytes, Buf};"},{"DocComment":""},{"DocComment":" let mut buf = (&b\"hello \"[..])"},{"DocComment":"     .chain(&b\"world\"[..]);"},{"DocComment":""},{"DocComment":" let full: Bytes = buf.copy_to_bytes(11);"},{"DocComment":" assert_eq!(full[..], b\"hello world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Buf::chain`]: Buf::chain"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"U","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":31,"col":4},"end":{"line":31,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"a","is_positional":false,"ty":{"Untagged":{"TypeVar":{"Free":0}}}},{"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":32,"col":4},"end":{"line":32,"col":8}},"generated_from_span":null}},"att