l}},"source_text":"pub fn freeze(self) -> Bytes {\n        let bytes = ManuallyDrop::new(self);\n        if bytes.kind() == KIND_VEC {\n            // Just re-use `Bytes` internal Vec vtable\n            unsafe {\n                let off = bytes.get_vec_pos();\n                let vec = rebuild_vec(bytes.ptr.as_ptr(), bytes.len, bytes.cap, off);\n                let mut b: Bytes = vec.into();\n                b.advance(off);\n                b\n            }\n        } else {\n            debug_assert_eq!(bytes.kind(), KIND_ARC);\n\n            let ptr = bytes.ptr.as_ptr();\n            let len = bytes.len;\n            let data = AtomicPtr::new(bytes.data.cast());\n            unsafe { Bytes::with_vtable(ptr, len, data, &SHARED_VTABLE) }\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Converts `self` into an immutable `Bytes`."},{"DocComment":""},{"DocComment":" The conversion is zero cost and is used to indicate that the slice"},{"DocComment":" referenced by the handle will no longer be mutated. Once the conversion"},{"DocComment":" is done, the handle can be cloned and shared across threads."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```ignore-wasm"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let mut b = BytesMut::with_capacity(64);"},{"DocComment":" b.put(&b\"hello world\"[..]);"},{"DocComment":" let b1 = b.freeze();"},{"DocComment":" let b2 = b1.clone();"},{"DocComment":""},{"DocComment":" let th = thread::spawn(move || {"},{"DocComment":"     assert_eq!(&b1[..], b\"hello world\");"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(&b2[..], b\"hello world\");"},{"DocComment":" th.join().unwrap();"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":12,"beg":{"line":244,"col":4},"end":{"line":244,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is