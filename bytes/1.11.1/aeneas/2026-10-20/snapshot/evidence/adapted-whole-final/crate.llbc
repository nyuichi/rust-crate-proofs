_constraints":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":31,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[]}]},"trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},"type_id":0,"ty":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}}}]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":85,"col":17},"end":{"line":85,"col":39}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["metadata",0]},{"Ident":["Pointee",0]}],"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":59,"col":0},"end":{"line":59,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Provides the pointer metadata type of any pointed-to type."},{"DocComment":""},{"DocComment":" # Pointer metadata"},{"DocComment":""},{"DocComment":" Raw pointer types and reference types in Rust can be thought of as made of two parts:"},{"DocComment":" a data pointer that contains the memory address of the value, and some metadata."},{"DocComment":""},{"DocComment":" For statically-sized types (that implement the `Sized` traits)"},{"DocComment":" as well as for `extern` types,"},{"DocComment":" pointers are said to be “thin”: metadata is zero-sized and its type is `()`."},{"DocComment":""},{"DocComment":" Pointers to [dynamically-sized types][dst] are said to be “wide” or “fat”,"},{"DocComment":" they have non-zero-sized metadata:"},{"DocComment":""},{"DocComment":" * For structs whose last field is a DST, metadata is the metadata for the last field"},{"DocComment":" * For the `str` type, metadata is the length in bytes as `usize`"},{"DocComment":" * For slice types like `[T]`, metadata is the length in items as `usize`"},{"DocComment":" * For trait objects like `dyn SomeTrait`, metadata is [`DynMetadata<Self>`][DynMetadata]"},{"DocComment":"   (e.g. `DynMetadata<dyn SomeTrait>`)"},{"DocComment":""},{"DocComment":" In the future, the Rust language may gain new kinds of types"},{"DocComment":" that have different pointer metadata."},{"DocComment":""},{"DocComment":" [dst]: https://doc.rust-lang.org/nomicon/exotic-sizes.html#dynamically-sized-types-dsts"},{"DocComment":""},{"DocComment":""},{"DocComment":" # The `Pointee` trait"},{"DocComment":""},{"DocComment":" The point of this trait is its `Metadata` associated type,"},{"DocComment":" which is `()` or `usize` or `DynMetadata<_>` as described above."},{"DocComment":" It is automatically implemented for every type."},{"DocComment":" It can be assumed to be implemented in a generic context, even without a corresponding bound."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" Raw pointers can be decomposed into the data pointer and metadata components"},{"DocComment":" with their [`to_raw_parts`] method."},{"DocComment":""},{"DocComment":" Alternatively, metadata alone can be extracted with the [`metadata`] function."},{"DocComment":" A reference can be passed to [`metadata`] and implicitly coerced."},{"DocComment":""},{"DocComment":" A (possibly-wide) pointer can be put back together from its data pointer and metadata"},{"DocComment":" with [`from_raw_parts`] or [`from_raw_parts_mut`]."},{"DocComment":""},{"DocComment":" [`to_raw_parts`]: *const::to_raw_parts"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"PointeeTrait","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":19},"end":{"line":67,"col":29}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":32},"end":{"line":67,"col":36}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":39},"end":{"line":67,"col":43}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":46},"end":{"line":67,"col":50}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":53},"end":{"line":67,"col":56}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":27,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":5,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":59},"end":{"line":67,"col":63}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":6,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":66},"end":{"line":67,"col":71}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":34,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":7,"span":{"Untagged":{"data":{"file_id":64,"beg":{"line":67,"col":74},"end":{"line":67,"col":80}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":35,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"Metadata","attr_info":{"attributes":[{"DocComment":" The type for metadata in pointers and references to `Self`."}],"inline":null,"rename":null,"public":false},"default":null,"implied_clauses":[]},"kind":{"TraitType":[32,0]}}],"methods":[],"vtable":null},{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":454,"col":0},"end":{"line":454,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types whose values can be duplicated simply by copying bits."},{"DocComment":""},{"DocComment":" By default, variable bindings have 'move semantics.' In other"},{"DocComment":" words:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `x` has moved into `y`, and so cannot be used"},{"DocComment":""},{"DocComment":" // println!(\"{x:?}\"); // error: use of moved value"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, if a type implements `Copy`, it instead has 'copy semantics':"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // We can derive a `Copy` implementation. `Clone` is also required, as it's"},{"DocComment":" // a supertrait of `Copy`."},{"DocComment":" #[derive(Debug, Copy, Clone)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `y` is a copy of `x`"},{"DocComment":""},{"DocComment":" println!(\"{x:?}\"); // A-OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's important to note that in these two examples, the only difference is whether you"},{"DocComment":" are allowed to access `x` after the assignment. Under the hood, both a copy and a move"},{"DocComment":" can result in bits being copied in memory, although this is sometimes optimized away."},{"DocComment":""},{"DocComment":" ## How can I implement `Copy`?"},{"DocComment":""},{"DocComment":" There are two ways to implement `Copy` on your type. The simplest is to use `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct MyStruct;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also implement `Copy` and `Clone` manually:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct MyStruct;"},{"DocComment":""},{"DocComment":" impl Copy for MyStruct { }"},{"DocComment":""},{"DocComment":" impl Clone for MyStruct {"},{"DocComment":"     fn clone(&self) -> MyStruct {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There is a small difference between the two. The `derive` strategy will also place a `Copy`"},{"DocComment":" bound on type parameters:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct MyStruct<T>(T);"},{"DocComment":""},{"DocComment":" impl<T: Copy> Copy for MyStruct<T> { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This isn't always desired. For example, shared references (`&T`) can be copied regardless of"},{"DocComment":" whether `T` is `Copy`. Likewise, a generic struct containing markers such as [`PhantomData`]"},{"DocComment":" could potentially be duplicated with a bit-wise copy."},{"DocComment":""},{"DocComment":" ## What's the difference between `Copy` and `Clone`?"},{"DocComment":""},{"DocComment":" Copies happen implicitly, for example as part of an assignment `y = x`. The behavior of"},{"DocComment":" `Copy` is not overloadable; it is always a simple bit-wise copy."},{"DocComment":""},{"DocComment":" Cloning is an explicit action, `x.clone()`. The implementation of [`Clone`] can"},{"DocComment":" provide any type-specific behavior necessary to duplicate values safely. For example,"},{"DocComment":" the implementation of [`Clone`] for [`String`] needs to copy the pointed-to string"},{"DocComment":" buffer in the heap. A simple bitwise copy of [`String`] values would merely copy the"},{"DocComment":" pointer, leading to a double free down the line. For this reason, [`String`] is [`Clone`]"},{"DocComment":" but not `Copy`."},{"DocComment":""},{"DocComment":" [`Clone`] is a supertrait of `Copy`, so everything which is `Copy` must also implement"},{"DocComment":" [`Clone`]. If a type is `Copy` then its [`Clone`] implementation only needs to return `*self`"},{"DocComment":" (see the example above)."},{"DocComment":""},{"DocComment":" ## When can my type be `Copy`?"},{"DocComment":""},{"DocComment":" A type can implement `Copy` if all of its components implement `Copy`. For example, this"},{"DocComment":" struct can be `Copy`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Point {"},{"DocComment":"    x: i32,"},{"DocComment":"    y: i32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A struct can be `Copy`, and [`i32`] is `Copy`, therefore `Point` is eligible to be `Copy`."},{"DocComment":" By contrast, consider"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct Point;"},{"DocComment":" struct PointList {"},{"DocComment":"     points: Vec<Point>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The struct `PointList` cannot implement `Copy`, because [`Vec<T>`] is not `Copy`. If we"},{"DocComment":" attempt to derive a `Copy` implementation, we'll get an error:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" the trait `Copy` cannot be implemented for this type; field `points` does not implement `Copy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Shared references (`&T`) are also `Copy`, so a type can be `Copy`, even when it holds"},{"DocComment":" shared references of types `T` that are *not* `Copy`. Consider the following struct,"},{"DocComment":" which can implement `Copy`, because it only holds a *shared reference* to our non-`Copy`"},{"DocComment":" type `PointList` from above:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct PointList;"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct PointListWrapper<'a> {"},{"DocComment":"     point_list_ref: &'a PointList,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## When *can't* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Some types can't be copied safely. For example, copying `&mut T` would create an aliased"},{"DocComment":" mutable reference. Copying [`String`] would duplicate responsibility for managing the"},{"DocComment":" [`String`]'s buffer, leading to a double free."},{"DocComment":""},{"DocComment":" Generalizing the latter case, any type implementing [`Drop`] can't be `Copy`, because it's"},{"DocComment":" managing some resource besides its own [`size_of::<T>`] bytes."},{"DocComment":""},{"DocComment":" If you try to implement `Copy` on a struct or enum containing non-`Copy` data, you will get"},{"DocComment":" the error [E0204]."},{"DocComment":""},{"DocComment":" [E0204]: ../../error_codes/E0204.html"},{"DocComment":""},{"DocComment":" ## When *should* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Generally speaking, if your type _can_ implement `Copy`, it should. Keep in mind, though,"},{"DocComment":" that implementing `Copy` is part of the public API of your type. If the type might become"},{"DocComment":" non-`Copy` in the future, it could be prudent to omit the `Copy` implementation now, to"},{"DocComment":" avoid a breaking API change."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Copy`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Copy` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Copy`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Copy`."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`size_of::<T>`]: size_of"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Copy","diagnostic_item":"Copy","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":454,"col":16},"end":{"line":454,"col":21}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Unpin",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":1014,"col":0},"end":{"line":1014,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that do not require any pinning guarantees."},{"DocComment":""},{"DocComment":" For information on what \"pinning\" is, see the [`pin` module] documentation."},{"DocComment":""},{"DocComment":" Implementing the `Unpin` trait for `T` expresses the fact that `T` is pinning-agnostic:"},{"DocComment":" it shall not expose nor rely on any pinning guarantees. This, in turn, means that a"},{"DocComment":" `Pin`-wrapped pointer to such a type can feature a *fully unrestricted* API."},{"DocComment":" In other words, if `T: Unpin`, a value of type `T` will *not* be bound by the invariants"},{"DocComment":" which pinning otherwise offers, even when \"pinned\" by a [`Pin<Ptr>`] pointing at it."},{"DocComment":" When a value of type `T` is pointed at by a [`Pin<Ptr>`], [`Pin`] will not restrict access"},{"DocComment":" to the pointee value like it normally would, thus allowing the user to do anything that they"},{"DocComment":" normally could with a non-[`Pin`]-wrapped `Ptr` to that value."},{"DocComment":""},{"DocComment":" The idea of this trait is to alleviate the reduced ergonomics of APIs that require the use"},{"DocComment":" of [`Pin`] for soundness for some types, but which also want to be used by other types that"},{"DocComment":" don't care about pinning. The prime example of such an API is [`Future::poll`]. There are many"},{"DocComment":" [`Future`] types that don't care about pinning. These futures can implement `Unpin` and"},{"DocComment":" therefore get around the pinning related restrictions in the API, while still allowing the"},{"DocComment":" subset of [`Future`]s which *do* require pinning to be implemented soundly."},{"DocComment":""},{"DocComment":" For more discussion on the consequences of [`Unpin`] within the wider scope of the pinning"},{"DocComment":" system, see the [section about `Unpin`] in the [`pin` module]."},{"DocComment":""},{"DocComment":" `Unpin` has no consequence at all for non-pinned data. In particular, [`mem::replace`] happily"},{"DocComment":" moves `!Unpin` data, which would be immovable when pinned ([`mem::replace`] works for any"},{"DocComment":" `&mut T`, not just when `T: Unpin`)."},{"DocComment":""},{"DocComment":" *However*, you cannot use [`mem::replace`] on `!Unpin` data which is *pinned* by being wrapped"},{"DocComment":" inside a [`Pin<Ptr>`] pointing at it. This is because you cannot (safely) use a"},{"DocComment":" [`Pin<Ptr>`] to get a `&mut T` to its pointee value, which you would need to call"},{"DocComment":" [`mem::replace`], and *that* is what makes this system work."},{"DocComment":""},{"DocComment":" So this, for example, can only be done on types implementing `Unpin`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" use std::mem;"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" let mut string = \"this\".to_string();"},{"DocComment":" let mut pinned_string = Pin::new(&mut string);"},{"DocComment":""},{"DocComment":" // We need a mutable reference to call `mem::replace`."},{"DocComment":" // We can obtain such a reference by (implicitly) invoking `Pin::deref_mut`,"},{"DocComment":" // but that is only possible because `String` implements `Unpin`."},{"DocComment":" mem::replace(&mut *pinned_string, \"other\".to_string());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This trait is automatically implemented for almost every type. The compiler is free"},{"DocComment":" to take the conservative stance of marking types as [`Unpin`] so long as all of the types that"},{"DocComment":" compose its fields are also [`Unpin`]. This is because if a type implements [`Unpin`], then it"},{"DocComment":" is unsound for that type's implementation to rely on pinning-related guarantees for soundness,"},{"DocComment":" *even* when viewed through a \"pinning\" pointer! It is the responsibility of the implementor of"},{"DocComment":" a type that relies upon pinning for soundness to ensure that type is *not* marked as [`Unpin`]"},{"DocComment":" by adding [`PhantomPinned`] field. For more details, see the [`pin` module] docs."},{"DocComment":""},{"DocComment":" [`mem::replace`]: crate::mem::replace \"mem replace\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future poll\""},{"DocComment":" [`Pin`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`Pin<Ptr>`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`pin` module]: crate::pin \"pin module\""},{"DocComment":" [section about `Unpin`]: crate::pin#unpin \"pin module docs about unpin\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Unpin","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":104,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Freeze",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":906,"col":0},"end":{"line":906,"col":28}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to determine whether a type contains"},{"DocComment":" any `UnsafeCell` internally, but not through an indirection."},{"DocComment":" This affects, for example, whether a `static` of that type is"},{"DocComment":" placed in read-only static memory or writable static memory."},{"DocComment":" This can be used to declare that a constant with a generic type"},{"DocComment":" will not contain interior mutability, and subsequently allow"},{"DocComment":" placing the constant behind references."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" This trait is a core part of the language, it is just expressed as a trait in libcore for"},{"DocComment":" convenience. Do *not* implement it for other types."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Freeze","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":105,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":372,"col":0},"end":{"line":372,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap mutable-to-mutable reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsRef`] but used for converting between mutable"},{"DocComment":" references. If you need to do a costly conversion it is better to"},{"DocComment":" implement [`From`] with type `&mut T` or write a custom function."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsMut` auto-dereferences if the inner type is a mutable reference"},{"DocComment":" (e.g.: `foo.as_mut()` will work the same if `foo` has type `&mut Foo` or `&mut &mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [mutably dereferenceable types], e.g. `foo.as_mut()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_mut()`. Instead, many smart pointers provide an `as_mut` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsMut::as_mut`] should not be"},{"DocComment":" used for the sole purpose of mutable dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [mutably dereferenceable types]: core::ops::DerefMut"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::DerefMut#mutable-deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &mut i32 = x.as_mut();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &mut i32 = &mut x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`DerefMut`] should consider to add an implementation of `AsMut<T>` as"},{"DocComment":" follows:"},{"DocComment":""},{"DocComment":" [`DerefMut`]: core::ops::DerefMut"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::{Deref, DerefMut};"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" # impl DerefMut for SomeType {"},{"DocComment":" #     fn deref_mut(&mut self) -> &mut [u8] {"},{"DocComment":" #         &mut []"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsMut<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     <SomeType as Deref>::Target: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.deref_mut().as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsMut` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsMut<T> for T`"},{"DocComment":" with [`as_mut`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&mut T where T: AsMut<U>` which allows `AsMut` to auto-dereference, see \"Generic"},{"DocComment":" Implementations\" above)."},{"DocComment":""},{"DocComment":" [`as_mut`]: AsMut::as_mut"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsMut<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using `AsMut` as trait bound for a generic function, we can accept all mutable references that"},{"DocComment":" can be converted to type `&mut T`. Unlike [dereference], which has a single [target type],"},{"DocComment":" there can be multiple implementations of `AsMut` for a type. In particular, `Vec<T>` implements"},{"DocComment":" both `AsMut<Vec<T>>` and `AsMut<[T]>`."},{"DocComment":""},{"DocComment":" In the following, the example functions `caesar` and `null_terminate` provide a generic"},{"DocComment":" interface which works with any type that can be converted by cheap mutable-to-mutable conversion"},{"DocComment":" into a byte slice (`[u8]`) or a byte vector (`Vec<u8>`), respectively."},{"DocComment":""},{"DocComment":" [dereference]: core::ops::DerefMut"},{"DocComment":" [target type]: core::ops::Deref::Target"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Document {"},{"DocComment":"     info: String,"},{"DocComment":"     content: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: ?Sized> AsMut<T> for Document"},{"DocComment":" where"},{"DocComment":"     Vec<u8>: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.content.as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn caesar<T: AsMut<[u8]>>(data: &mut T, key: u8) {"},{"DocComment":"     for byte in data.as_mut() {"},{"DocComment":"         *byte = byte.wrapping_add(key);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn null_terminate<T: AsMut<Vec<u8>>>(data: &mut T) {"},{"DocComment":"     // Using a non-generic inner function, which contains most of the"},{"DocComment":"     // functionality, helps to minimize monomorphization overhead."},{"DocComment":"     fn doit(data: &mut Vec<u8>) {"},{"DocComment":"         let len = data.len();"},{"DocComment":"         if len == 0 || data[len-1] != 0 {"},{"DocComment":"             data.push(0);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     doit(data.as_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut v: Vec<u8> = vec![1, 2, 3];"},{"DocComment":"     caesar(&mut v, 5);"},{"DocComment":"     assert_eq!(v, [6, 7, 8]);"},{"DocComment":"     null_terminate(&mut v);"},{"DocComment":"     assert_eq!(v, [6, 7, 8, 0]);"},{"DocComment":"     let mut doc = Document {"},{"DocComment":"         info: String::from(\"Example\"),"},{"DocComment":"         content: vec![17, 19, 8],"},{"DocComment":"     };"},{"DocComment":"     caesar(&mut doc, 1);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9]);"},{"DocComment":"     null_terminate(&mut doc);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9, 0]);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note, however, that APIs don't need to be generic. In many cases taking a `&mut [u8]` or"},{"DocComment":" `&mut Vec<u8>`, for example, is the better choice (callers need to pass the correct type then)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsMut","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]},{"Ident":["as_mut",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":375,"col":4},"end":{"line":375,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a mutable reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[36,0]}}],"vtable":{"id":58,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]}],"span":{"Untagged":{"data":{"file_id":45,"beg":{"line":270,"col":0},"end":{"line":270,"col":54}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for mutable dereferencing operations, like in `*v = 1;`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in mutable contexts, `DerefMut` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"mutable deref coercion\"][coercion]. In immutable contexts, [`Deref`] is used."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `DerefMut`. The"},{"DocComment":" compiler will silently insert calls to `DerefMut::deref_mut`. For this"},{"DocComment":" reason, one should be careful about implementing `DerefMut` and only do so"},{"DocComment":" when mutable deref coercion is desirable. See [the `Deref` docs][implementing]"},{"DocComment":" for advice on when this is typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `DerefMut` or `Deref` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Mutable deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `DerefMut<Target = U>`, and `v` is a value of type `T`,"},{"DocComment":" then:"},{"DocComment":""},{"DocComment":" * In mutable contexts, `*v` (where `T` is neither a reference nor a raw pointer)"},{"DocComment":"   is equivalent to `*DerefMut::deref_mut(&mut v)`."},{"DocComment":" * Values of type `&mut T` are coerced to values of type `&mut U`"},{"DocComment":" * `T` implicitly implements all the (mutable) methods of the type `U`."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution] and [type coercions]."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `DerefMut::deref_mut` implicitly."},{"DocComment":" Failure during dereferencing can be extremely confusing when `DerefMut` is"},{"DocComment":" invoked implicitly. In the majority of uses it should be infallible, though"},{"DocComment":" it may be acceptable to panic if the type is misused through programmer"},{"DocComment":" error, for example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #mutable-deref-coercion"},{"DocComment":" [implementing]: Deref#when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is modifiable by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Deref, DerefMut};"},{"DocComment":""},{"DocComment":" struct DerefMutExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefMutExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> DerefMut for DerefMutExample<T> {"},{"DocComment":"     fn deref_mut(&mut self) -> &mut Self::Target {"},{"DocComment":"         &mut self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x = DerefMutExample { value: 'a' };"},{"DocComment":" *x = 'b';"},{"DocComment":" assert_eq!('b', x.value);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"DerefMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Target","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":45,"beg":{"line":270,"col":26},"end":{"line":270,"col":39}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deref_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]},{"Ident":["deref_mut",0]}],"span":{"Untagged":{"data":{"file_id":45,"beg":{"line":274,"col":4},"end":{"line":274,"col":49}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutably dereferences the value."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"deref_mut_method","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[37,0]}}],"vtable":{"id":59,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["BorrowMut",0]}],"span":{"Untagged":{"data":{"file_id":47,"beg":{"line":190,"col":0},"end":{"line":190,"col":69}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for mutably borrowing data."},{"DocComment":""},{"DocComment":" As a companion to [`Borrow<T>`] this trait allows a type to borrow as"},{"DocComment":" an underlying type by providing a mutable reference. See [`Borrow<T>`]"},{"DocComment":" for more information on borrowing as another type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BorrowMut","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Borrowed","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":47,"beg":{"line":190,"col":45},"end":{"line":190,"col":69}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":22,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"borrow_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["BorrowMut",0]},{"Ident":["borrow_mut",0]}],"span":{"Untagged":{"data":{"file_id":47,"beg":{"line":207,"col":4},"end":{"line":207,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutably borrows from an owned value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::BorrowMut;"},{"DocComment":""},{"DocComment":" fn check<T: BorrowMut<[i32]>>(mut v: T) {"},{"DocComment":"     assert_eq!(&mut [1, 2, 3], v.borrow_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![1, 2, 3];"},{"DocComment":""},{"DocComment":" check(v);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[38,0]}}],"vtable":{"id":60,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":39,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Write",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":123,"col":0},"end":{"line":123,"col":15}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for writing or formatting into Unicode-accepting buffers or streams."},{"DocComment":""},{"DocComment":" This trait only accepts UTF-8–encoded data and is not [flushable]. If you only"},{"DocComment":" want to accept Unicode and you don't need flushing, you should implement this trait;"},{"DocComment":" otherwise you should implement [`std::io::Write`]."},{"DocComment":""},{"DocComment":" [`std::io::Write`]: ../../std/io/trait.Write.html"},{"DocComment":" [flushable]: ../../std/io/trait.Write.html#tymethod.flush"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"FmtWrite","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write_str","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Write",0]},{"Ident":["write_str",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":156,"col":4},"end":{"line":156,"col":47}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes a string slice into this writer, returning whether the write"},{"DocComment":" succeeded."},{"DocComment":""},{"DocComment":" This method can only succeed if the entire string slice was successfully"},{"DocComment":" written, and this method will not return until all data has been"},{"DocComment":" written or an error occurs."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" This function will return an instance of [`std::fmt::Error`][Error] on error."},{"DocComment":""},{"DocComment":" The purpose of that error is to abort the formatting operation when the underlying"},{"DocComment":" destination encounters some error preventing it from accepting more text;"},{"DocComment":" in particular, it does not communicate any information about *what* error occurred."},{"DocComment":" It should generally be propagated rather than handled, at least when implementing"},{"DocComment":" formatting traits."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt::{Error, Write};"},{"DocComment":""},{"DocComment":" fn writer<W: Write>(f: &mut W, s: &str) -> Result<(), Error> {"},{"DocComment":"     f.write_str(s)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut buf = String::new();"},{"DocComment":" writer(&mut buf, \"hola\")?;"},{"DocComment":" assert_eq!(&buf, \"hola\");"},{"DocComment":" # std::fmt::Result::Ok(())"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Ref":[{"Var":{"Bound":[0,1]}},{"Untagged":{"Adt":{"id":24,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Str"}}},"Shared"]}}],"output":{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},{"Untagged":{"Adt":{"id":62,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":null},"kind":{"TraitMethod":[39,0]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write_fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Write",0]},{"Ident":["write_fmt",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":214,"col":4},"end":{"line":214,"col":58}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Glue for usage of the [`write!`] macro with implementors of this trait."},{"DocComment":""},{"DocComment":" This method should generally not be invoked manually, but rather through"},{"DocComment":" the [`write!`] macro itself."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" This function will return an instance of [`Error`] on error. Please see"},{"DocComment":" [write_str](Write::write_str) for details."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt::{Error, Write};"},{"DocComment":""},{"DocComment":" fn writer<W: Write>(f: &mut W, s: &str) -> Result<(), Error> {"},{"DocComment":"     f.write_fmt(format_args!(\"{s}\"))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut buf = String::new();"},{"DocComment":" writer(&mut buf, \"world\")?;"},{"DocComment":" assert_eq!(&buf, \"world\");"},{"DocComment":" # std::fmt::Result::Ok(())"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Adt":{"id":27,"generics":{"regions":[{"Var":{"Bound":[0,1]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"output":{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},{"Untagged":{"Adt":{"id":62,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":390,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":39,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[39,2]}}],"vtable":{"id":61,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":40,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["collect",0]},{"Ident":["Extend",0]}],"span":{"Untagged":{"data":{"file_id":50,"beg":{"line":397,"col":0},"end":{"line":397,"col":19}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Extend a collection with the contents of an iterator."},{"DocComment":""},{"DocComment":" Iterators produce a series of values, and collections can also be thought"},{"DocComment":" of as a series of values. The `Extend` trait bridges this gap, allowing you"},{"DocComment":" to extend a collection by including the contents of that iterator. When"},{"DocComment":" extending a collection with an already existing key, that entry is updated"},{"DocComment":" or, in the case of collections that permit multiple entries with equal"},{"DocComment":" keys, that entry is inserted."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // You can extend a String with some chars:"},{"DocComment":" let mut message = String::from(\"The first three letters are: \");"},{"DocComment":""},{"DocComment":" message.extend(&['a', 'b', 'c']);"},{"DocComment":""},{"DocComment":" assert_eq!(\"abc\", &message[29..32]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Implementing `Extend`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // A sample collection, that's just a wrapper over Vec<T>"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyCollection(Vec<i32>);"},{"DocComment":""},{"DocComment":" // Let's give it some methods so we can create one and add things"},{"DocComment":" // to it."},{"DocComment":" impl MyCollection {"},{"DocComment":"     fn new() -> MyCollection {"},{"DocComment":"         MyCollection(Vec::new())"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn add(&mut self, elem: i32) {"},{"DocComment":"         self.0.push(elem);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // since MyCollection has a list of i32s, we implement Extend for i32"},{"DocComment":" impl Extend<i32> for MyCollection {"},{"DocComment":""},{"DocComment":"     // This is a bit simpler with the concrete type signature: we can call"},{"DocComment":"     // extend on anything which can be turned into an Iterator which gives"},{"DocComment":"     // us i32s. Because we need i32s to put into MyCollection."},{"DocComment":"     fn extend<I: IntoIterator<Item=i32>>(&mut self, iter: I) {"},{"DocComment":""},{"DocComment":"         // The implementation is very straightforward: loop through the"},{"DocComment":"         // iterator, and add() each element to ourselves."},{"DocComment":"         for elem in iter {"},{"DocComment":"             self.add(elem);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut c = MyCollection::new();"},{"DocComment":""},{"DocComment":" c.add(5);"},{"DocComment":" c.add(6);"},{"DocComment":" c.add(7);"},{"DocComment":""},{"DocComment":" // let's extend our collection with three more numbers"},{"DocComment":" c.extend(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // we've added these elements onto the end"},{"DocComment":" assert_eq!(\"MyCollection([5, 6, 7, 1, 2, 3])\", format!(\"{c:?}\"));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"I","variance":"Contravariant"},{"index":1,"name":"Clause0_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":50,"beg":{"line":416,"col":17},"end":{"line":416,"col":39}},"generated_from_span":null}},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":23,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}},{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Bound":[1,1]}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"extend","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["collect",0]},{"Ident":["Extend",0]},{"Ident":["extend",0]}],"span":{"Untagged":{"data":{"file_id":50,"beg":{"line":416,"col":4},"end":{"line":416,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Extends a collection with the contents of an iterator."},{"DocComment":""},{"DocComment":" As this is the only required method for this trait, the [trait-level] docs"},{"DocComment":" contain more details."},{"DocComment":""},{"DocComment":" [trait-level]: Extend"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // You can extend a String with some chars:"},{"DocComment":" let mut message = String::from(\"abc\");"},{"DocComment":""},{"DocComment":" message.extend(['d', 'e', 'f'].iter());"},{"DocComment":""},{"DocComment":" assert_eq!(\"abcdef\", &message);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":null},"kind":{"TraitMethod":[40,0]}},null,null,null],"vtable":null},{"def_id":41,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryFrom",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":696,"col":0},"end":{"line":696,"col":33}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Simple and safe type conversions that may fail in a controlled"},{"DocComment":" way under some circumstances. It is the reciprocal of [`TryInto`]."},{"DocComment":""},{"DocComment":" This is useful when you are doing a type conversion that may"},{"DocComment":" trivially succeed but may also need special handling."},{"DocComment":" For example, there is no way to convert an [`i64`] into an [`i32`]"},{"DocComment":" using the [`From`] trait, because an [`i64`] may contain a value"},{"DocComment":" that an [`i32`] cannot represent and so the conversion would lose data."},{"DocComment":" This might be handled by truncating the [`i64`] to an [`i32`] or by"},{"DocComment":" simply returning [`i32::MAX`], or by some other method.  The [`From`]"},{"DocComment":" trait is intended for perfect conversions, so the `TryFrom` trait"},{"DocComment":" informs the programmer when a type conversion could go bad and lets"},{"DocComment":" them decide how to handle it."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" - `TryFrom<T> for U` implies [`TryInto`]`<U> for T`"},{"DocComment":" - [`try_from`] is reflexive, which means that `TryFrom<T> for T`"},{"DocComment":" is implemented and cannot fail -- the associated `Error` type for"},{"DocComment":" calling `T::try_from()` on a value of type `T` is [`Infallible`]."},{"DocComment":" When the [`!`] type is stabilized [`Infallible`] and [`!`] will be"},{"DocComment":" equivalent."},{"DocComment":""},{"DocComment":" Prefer using [`TryInto`] over [`TryFrom`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`TryInto`] can be used as well."},{"DocComment":""},{"DocComment":" `TryFrom<T>` can be implemented as follows:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct GreaterThanZero(i32);"},{"DocComment":""},{"DocComment":" impl TryFrom<i32> for GreaterThanZero {"},{"DocComment":"     type Error = &'static str;"},{"DocComment":""},{"DocComment":"     fn try_from(value: i32) -> Result<Self, Self::Error> {"},{"DocComment":"         if value <= 0 {"},{"DocComment":"             Err(\"GreaterThanZero only accepts values greater than zero!\")"},{"DocComment":"         } else {"},{"DocComment":"             Ok(GreaterThanZero(value))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" As described, [`i32`] implements `TryFrom<`[`i64`]`>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let big_number = 1_000_000_000_000i64;"},{"DocComment":" // Silently truncates `big_number`, requires detecting"},{"DocComment":" // and handling the truncation after the fact."},{"DocComment":" let smaller_number = big_number as i32;"},{"DocComment":" assert_eq!(smaller_number, -727379968);"},{"DocComment":""},{"DocComment":" // Returns an error because `big_number` is too big to"},{"DocComment":" // fit in an `i32`."},{"DocComment":" let try_smaller_number = i32::try_from(big_number);"},{"DocComment":" assert!(try_smaller_number.is_err());"},{"DocComment":""},{"DocComment":" // Returns `Ok(3)`."},{"DocComment":" let try_successful_smaller_number = i32::try_from(3);"},{"DocComment":" assert!(try_successful_smaller_number.is_ok());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`try_from`]: TryFrom::try_from"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"TryFrom","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"},{"index":2,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_from","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryFrom",0]},{"Ident":["try_from",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":704,"col":4},"end":{"line":704,"col":55}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the conversion."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"try_from_fn","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":1}}}],"output":{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":null},"kind":{"TraitMethod":[41,0]}}],"vtable":null},{"def_id":42,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["ZeroablePrimitive",0]}],"span":{"Untagged":{"data":{"file_id":76,"beg":{"line":34,"col":0},"end":{"line":34,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker trait for primitive types which can be zero."},{"DocComment":""},{"DocComment":" This is an implementation detail for <code>[NonZero]\\<T></code> which may disappear or be replaced at any time."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Types implementing this trait must be primitives that are valid when zeroed."},{"DocComment":""},{"DocComment":" The associated `Self::NonZeroInner` type must have the same size+align as `Self`,"},{"DocComment":" but with a niche and bit validity making it so the following `transmutes` are sound:"},{"DocComment":""},{"DocComment":" - `Self::NonZeroInner` to `Option<Self::NonZeroInner>`"},{"DocComment":" - `Option<Self::NonZeroInner>` to `Self`"},{"DocComment":""},{"DocComment":" (And, consequently, `Self::NonZeroInner` to `Self`.)"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_NonZeroInner","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":76,"beg":{"line":34,"col":55},"end":{"line":34,"col":59}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":76,"beg":{"line":36,"col":31},"end":{"line":36,"col":35}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[],"vtable":null},{"def_id":43,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnMut",0]}],"span":{"Untagged":{"data":{"file_id":62,"beg":{"line":163,"col":0},"end":{"line":163,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a mutable receiver."},{"DocComment":""},{"DocComment":" Instances of `FnMut` can be called repeatedly and may mutate state."},{"DocComment":""},{"DocComment":" `FnMut` is implemented automatically by closures which take mutable"},{"DocComment":" references to captured variables, as well as all types that implement"},{"DocComment":" [`Fn`], e.g., (safe) [function pointers] (since `FnMut` is a supertrait of"},{"DocComment":" [`Fn`]). Additionally, for any type `F` that implements `FnMut`, `&mut F`"},{"DocComment":" implements `FnMut`, too."},{"DocComment":""},{"DocComment":" Since [`FnOnce`] is a supertrait of `FnMut`, any instance of `FnMut` can be"},{"DocComment":" used where a [`FnOnce`] is expected, and since [`Fn`] is a subtrait of"},{"DocComment":" `FnMut`, any instance of [`Fn`] can be used where `FnMut` is expected."},{"DocComment":""},{"DocComment":" Use `FnMut` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and need to call it repeatedly, while allowing it to mutate state."},{"DocComment":" If you don't want the parameter to mutate state, use [`Fn`] as a"},{"DocComment":" bound; if you don't need to call it repeatedly, use [`FnOnce`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Calling a mutably capturing closure"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = 5;"},{"DocComment":" {"},{"DocComment":"     let mut square_x = || x *= x;"},{"DocComment":"     square_x();"},{"DocComment":" }"},{"DocComment":" assert_eq!(x, 25);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Using a `FnMut` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn do_twice<F>(mut func: F)"},{"DocComment":"     where F: FnMut()"},{"DocComment":" {"},{"DocComment":"     func();"},{"DocComment":"     func();"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x: usize = 1;"},{"DocComment":" {"},{"DocComment":"     let add_two_to_x = || x += 2;"},{"DocComment":"     do_twice(add_two_to_x);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(x, 5);"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":62,"beg":{"line":163,"col":36},"end":{"line":163,"col":48}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":30,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnMut",0]},{"Ident":["call_mut",0]}],"span":{"Untagged":{"data":{"file_id":62,"beg":{"line":166,"col":4},"end":{"line":166,"col":74}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":{"Other":"rust-call"},"is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"TypeVar":{"Free":1}}}],"output":{"Untagged":{"TypeVar":{"Free":2}}}},"default":null},"kind":{"TraitMethod":[43,0]}}],"vtable":{"id":111,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":44,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["Try",0]}],"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":133,"col":0},"end":{"line":133,"col":41}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `?` operator and `try {}` blocks."},{"DocComment":""},{"DocComment":" `try_*` methods typically involve a type implementing this trait.  For"},{"DocComment":" example, the closures passed to [`Iterator::try_fold`] and"},{"DocComment":" [`Iterator::try_for_each`] must return such a type."},{"DocComment":""},{"DocComment":" `Try` types are typically those containing two or more categories of values,"},{"DocComment":" some subset of which are so commonly handled via early returns that it's"},{"DocComment":" worth providing a terse (but still visible) syntax to make that easy."},{"DocComment":""},{"DocComment":" This is most often seen for error handling with [`Result`] and [`Option`]."},{"DocComment":" The quintessential implementation of this trait is on [`ControlFlow`]."},{"DocComment":""},{"DocComment":" # Using `Try` in Generic Code"},{"DocComment":""},{"DocComment":" `Iterator::try_fold` was stabilized to call back in Rust 1.27, but"},{"DocComment":" this trait is much newer.  To illustrate the various associated types and"},{"DocComment":" methods, let's implement our own version."},{"DocComment":""},{"DocComment":" As a reminder, an infallible version of a fold looks something like this:"},{"DocComment":" ```"},{"DocComment":" fn simple_fold<A, T>("},{"DocComment":"     iter: impl Iterator<Item = T>,"},{"DocComment":"     mut accum: A,"},{"DocComment":"     mut f: impl FnMut(A, T) -> A,"},{"DocComment":" ) -> A {"},{"DocComment":"     for x in iter {"},{"DocComment":"         accum = f(accum, x);"},{"DocComment":"     }"},{"DocComment":"     accum"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" So instead of `f` returning just an `A`, we'll need it to return some other"},{"DocComment":" type that produces an `A` in the \"don't short circuit\" path.  Conveniently,"},{"DocComment":" that's also the type we need to return from the function."},{"DocComment":""},{"DocComment":" Let's add a new generic parameter `R` for that type, and bound it to the"},{"DocComment":" output type that we want:"},{"DocComment":" ```"},{"DocComment":" # #![feature(try_trait_v2)]"},{"DocComment":" # use std::ops::Try;"},{"DocComment":" fn simple_try_fold_1<A, T, R: Try<Output = A>>("},{"DocComment":"     iter: impl Iterator<Item = T>,"},{"DocComment":"     mut accum: A,"},{"DocComment":"     mut f: impl FnMut(A, T) -> R,"},{"DocComment":" ) -> R {"},{"DocComment":"     todo!()"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If we get through the entire iterator, we need to wrap up the accumulator"},{"DocComment":" into the return type using [`Try::from_output`]:"},{"DocComment":" ```"},{"DocComment":" # #![feature(try_trait_v2)]"},{"DocComment":" # use std::ops::{ControlFlow, Try};"},{"DocComment":" fn simple_try_fold_2<A, T, R: Try<Output = A>>("},{"DocComment":"     iter: impl Iterator<Item = T>,"},{"DocComment":"     mut accum: A,"},{"DocComment":"     mut f: impl FnMut(A, T) -> R,"},{"DocComment":" ) -> R {"},{"DocComment":"     for x in iter {"},{"DocComment":"         let cf = f(accum, x).branch();"},{"DocComment":"         match cf {"},{"DocComment":"             ControlFlow::Continue(a) => accum = a,"},{"DocComment":"             ControlFlow::Break(_) => todo!(),"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     R::from_output(accum)"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" We'll also need [`FromResidual::from_residual`] to turn the residual back"},{"DocComment":" into the original type.  But because it's a supertrait of `Try`, we don't"},{"DocComment":" need to mention it in the bounds.  All types which implement `Try` can be"},{"DocComment":" recreated from their corresponding residual, so we'll just call it:"},{"DocComment":" ```"},{"DocComment":" # #![feature(try_trait_v2)]"},{"DocComment":" # use std::ops::{ControlFlow, Try};"},{"DocComment":" pub fn simple_try_fold_3<A, T, R: Try<Output = A>>("},{"DocComment":"     iter: impl Iterator<Item = T>,"},{"DocComment":"     mut accum: A,"},{"DocComment":"     mut f: impl FnMut(A, T) -> R,"},{"DocComment":" ) -> R {"},{"DocComment":"     for x in iter {"},{"DocComment":"         let cf = f(accum, x).branch();"},{"DocComment":"         match cf {"},{"DocComment":"             ControlFlow::Continue(a) => accum = a,"},{"DocComment":"             ControlFlow::Break(r) => return R::from_residual(r),"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     R::from_output(accum)"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" But this \"call `branch`, then `match` on it, and `return` if it was a"},{"DocComment":" `Break`\" is exactly what happens inside the `?` operator.  So rather than"},{"DocComment":" do all this manually, we can just use `?` instead:"},{"DocComment":" ```"},{"DocComment":" # #![feature(try_trait_v2)]"},{"DocComment":" # use std::ops::Try;"},{"DocComment":" fn simple_try_fold<A, T, R: Try<Output = A>>("},{"DocComment":"     iter: impl Iterator<Item = T>,"},{"DocComment":"     mut accum: A,"},{"DocComment":"     mut f: impl FnMut(A, T) -> R,"},{"DocComment":" ) -> R {"},{"DocComment":"     for x in iter {"},{"DocComment":"         accum = f(accum, x)?;"},{"DocComment":"     }"},{"DocComment":"     R::from_output(accum)"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Try","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":133,"col":21},"end":{"line":133,"col":41}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":55,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":160,"col":19},"end":{"line":160,"col":41}},"generated_from_span":null}},"origin":{"TraitItem":1},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":45,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}},{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}},{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},2,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"Output","attr_info":{"attributes":[{"DocComment":" The type of the value produced by `?` when *not* short-circuiting."}],"inline":null,"rename":null,"public":false},"default":null,"implied_clauses":[]},"kind":{"TraitType":[44,0]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"Residual","attr_info":{"attributes":[{"DocComment":" The type of the value passed to [`FromResidual::from_residual`]"},{"DocComment":" as part of `?` when short-circuiting."},{"DocComment":""},{"DocComment":" This represents the possible values of the `Self` type which are *not*"},{"DocComment":" represented by the `Output` type."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" The choice of this type is critical to interconversion."},{"DocComment":" Unlike the `Output` type, which will often be a raw generic type,"},{"DocComment":" this type is typically a newtype of some sort to \"color\" the type"},{"DocComment":" so that it's distinguishable from the residuals of other types."},{"DocComment":""},{"DocComment":" This is why `Result<T, E>::Residual` is not `E`, but `Result<!, E>`."},{"DocComment":" That way it's distinct from `ControlFlow<E>::Residual`, for example,"},{"DocComment":" and thus `?` on `ControlFlow` cannot be used in a method returning `Result`."},{"DocComment":""},{"DocComment":" If you're making a generic type `Foo<T>` that implements `Try<Output = T>`,"},{"DocComment":" then typically you can use `Foo<!>` as its `Residual`"},{"DocComment":" type: that type will have a \"hole\" in the correct place, and will maintain the"},{"DocComment":" \"foo-ness\" of the residual so other types need to opt-in to interconversion."}],"inline":null,"rename":null,"public":false},"default":null,"implied_clauses":[]},"kind":{"TraitType":[44,1]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"Self_Clause1_TryType","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"default":null,"implied_clauses":[]},"kind":{"TraitType":[44,2]}}],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"from_output","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["Try",0]},{"Ident":["from_output",0]}],"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":192,"col":4},"end":{"line":192,"col":49}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Constructs the type from its `Output` type."},{"DocComment":""},{"DocComment":" This should be implemented consistently with the `branch` method"},{"DocComment":" such that applying the `?` operator will get back the original value:"},{"DocComment":" `Try::from_output(x).branch() --> ControlFlow::Continue(x)`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_trait_v2)]"},{"DocComment":" use std::ops::Try;"},{"DocComment":""},{"DocComment":" assert_eq!(<Result<_, String> as Try>::from_output(3), Ok(3));"},{"DocComment":" assert_eq!(<Option<_> as Try>::from_output(4), Some(4));"},{"DocComment":" assert_eq!("},{"DocComment":"     <std::ops::ControlFlow<String, _> as Try>::from_output(5),"},{"DocComment":"     std::ops::ControlFlow::Continue(5),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" # fn make_question_mark_work() -> Option<()> {"},{"DocComment":" assert_eq!(Option::from_output(4)?, 4);"},{"DocComment":" # None }"},{"DocComment":" # make_question_mark_work();"},{"DocComment":""},{"DocComment":" // This is used, for example, on the accumulator in `try_fold`:"},{"DocComment":" let r = std::iter::empty().try_fold(4, |_, ()| -> Option<_> { unreachable!() });"},{"DocComment":" assert_eq!(r, Some(4));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"TryTraitFromOutput","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"output":{"Untagged":{"TypeVar":{"Free":0}}}},"default":null},"kind":{"TraitMethod":[44,0]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"branch","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["Try",0]},{"Ident":["branch",0]}],"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":219,"col":4},"end":{"line":219,"col":65}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used in `?` to decide whether the operator should produce a value"},{"DocComment":" (because this returned [`ControlFlow::Continue`])"},{"DocComment":" or propagate a value back to the caller"},{"DocComment":" (because this returned [`ControlFlow::Break`])."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_trait_v2)]"},{"DocComment":" use std::ops::{ControlFlow, Try};"},{"DocComment":""},{"DocComment":" assert_eq!(Ok::<_, String>(3).branch(), ControlFlow::Continue(3));"},{"DocComment":" assert_eq!(Err::<String, _>(3).branch(), ControlFlow::Break(Err(3)));"},{"DocComment":""},{"DocComment":" assert_eq!(Some(3).branch(), ControlFlow::Continue(3));"},{"DocComment":" assert_eq!(None::<String>.branch(), ControlFlow::Break(None));"},{"DocComment":""},{"DocComment":" assert_eq!(ControlFlow::<String, _>::Continue(3).branch(), ControlFlow::Continue(3));"},{"DocComment":" assert_eq!("},{"DocComment":"     ControlFlow::<_, String>::Break(3).branch(),"},{"DocComment":"     ControlFlow::Break(ControlFlow::Break(3)),"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"TryTraitBranch","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}}],"output":{"Untagged":{"Adt":{"id":50,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}},{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":null},"kind":{"TraitMethod":[44,1]}}],"vtable":null},{"def_id":45,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["Residual",0]}],"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":364,"col":0},"end":{"line":364,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows retrieving the canonical type implementing [`Try`] that has this type"},{"DocComment":" as its residual and allows it to hold an `O` as its output."},{"DocComment":""},{"DocComment":" If you think of the `Try` trait as splitting a type into its [`Try::Output`]"},{"DocComment":" and [`Try::Residual`] components, this allows putting them back together."},{"DocComment":""},{"DocComment":" For example,"},{"DocComment":" `Result<T, E>: Try<Output = T, Residual = Result<!, E>>`,"},{"DocComment":" and in the other direction,"},{"DocComment":" `<Result<!, E> as Residual<T>>::TryType = Result<T, E>`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"O","variance":"Unknown"},{"index":2,"name":"Self_TryType","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":45,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[]}]},"trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}},"type_id":0,"ty":{"Untagged":{"TypeVar":{"Free":1}}}}},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":45,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}},0,{"regions":[]}]},"trait_decl_ref":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}},"type_id":1,"ty":{"Untagged":{"TypeVar":{"Free":0}}}}}]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":97,"beg":{"line":368,"col":18},"end":{"line":368,"col":58}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":44,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[],"vtable":null},{"def_id":46,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]}],"span":{"Untagged":{"data":{"file_id":98,"beg":{"line":44,"col":0},"end":{"line":44,"col":53}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator able to yield elements from both ends."},{"DocComment":""},{"DocComment":" Something that implements `DoubleEndedIterator` has one extra capability"},{"DocComment":" over something that implements [`Iterator`]: the ability to also take"},{"DocComment":" `Item`s from the back, as well as the front."},{"DocComment":""},{"DocComment":" It is important to note that both back and forth work on the same range,"},{"DocComment":" and do not cross: iteration is over when they meet in the middle."},{"DocComment":""},{"DocComment":" In a similar fashion to the [`Iterator`] protocol, once a"},{"DocComment":" `DoubleEndedIterator` returns [`None`] from a [`next_back()`], calling it"},{"DocComment":" again may or may not ever return [`Some`] again. [`next()`] and"},{"DocComment":" [`next_back()`] are interchangeable for this purpose."},{"DocComment":""},{"DocComment":" [`next_back()`]: DoubleEndedIterator::next_back"},{"DocComment":" [`next()`]: Iterator::next"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = vec![1, 2, 3, 4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = numbers.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(Some(&1), iter.next());"},{"DocComment":" assert_eq!(Some(&6), iter.next_back());"},{"DocComment":" assert_eq!(Some(&5), iter.next_back());"},{"DocComment":" assert_eq!(Some(&2), iter.next());"},{"DocComment":" assert_eq!(Some(&3), iter.next());"},{"DocComment":" assert_eq!(Some(&4), iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next_back());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"DoubleEndedIterator","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":98,"beg":{"line":44,"col":37},"end":{"line":44,"col":53}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":24,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next_back","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]},{"Ident":["next_back",0]}],"span":{"Untagged":{"data":{"file_id":98,"beg":{"line":97,"col":4},"end":{"line":97,"col":50}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Removes and returns an element from the end of the iterator."},{"DocComment":""},{"DocComment":" Returns `None` when there are no more elements."},{"DocComment":""},{"DocComment":" The [trait-level] docs contain more details."},{"DocComment":""},{"DocComment":" [trait-level]: DoubleEndedIterator"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = vec![1, 2, 3, 4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = numbers.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(Some(&1), iter.next());"},{"DocComment":" assert_eq!(Some(&6), iter.next_back());"},{"DocComment":" assert_eq!(Some(&5), iter.next_back());"},{"DocComment":" assert_eq!(Some(&2), iter.next());"},{"DocComment":" assert_eq!(Some(&3), iter.next());"},{"DocComment":" assert_eq!(Some(&4), iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next_back());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Remarks"},{"DocComment":""},{"DocComment":" The elements yielded by `DoubleEndedIterator`'s methods may differ from"},{"DocComment":" the ones yielded by [`Iterator`]'s methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![(1, 'a'), (1, 'b'), (1, 'c'), (2, 'a'), (2, 'b')];"},{"DocComment":" let uniq_by_fst_comp = || {"},{"DocComment":"     let mut seen = std::collections::HashSet::new();"},{"DocComment":"     vec.iter().copied().filter(move |x| seen.insert(x.0))"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(uniq_by_fst_comp().last(), Some((2, 'a')));"},{"DocComment":" assert_eq!(uniq_by_fst_comp().next_back(), Some((2, 'b')));"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     uniq_by_fst_comp().fold(vec![], |mut v, x| {v.push(x); v}),"},{"DocComment":"     vec![(1, 'a'), (2, 'a')]"},{"DocComment":" );"},{"DocComment":" assert_eq!("},{"DocComment":"     uniq_by_fst_comp().rfold(vec![], |mut v, x| {v.push(x); v}),"},{"DocComment":"     vec![(2, 'b'), (1, 'c')]"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":null},"kind":{"TraitMethod":[46,0]}},null,null,null,null,null,null],"vtable":{"id":112,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":47,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["exact_size",0]},{"Ident":["ExactSizeIterator",0]}],"span":{"Untagged":{"data":{"file_id":99,"beg":{"line":86,"col":0},"end":{"line":86,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that knows its exact length."},{"DocComment":""},{"DocComment":" Many [`Iterator`]s don't know how many times they will iterate, but some do."},{"DocComment":" If an iterator knows how many times it can iterate, providing access to"},{"DocComment":" that information can be useful. For example, if you want to iterate"},{"DocComment":" backwards, a good start is to know where the end is."},{"DocComment":""},{"DocComment":" When implementing an `ExactSizeIterator`, you must also implement"},{"DocComment":" [`Iterator`]. When doing so, the implementation of [`Iterator::size_hint`]"},{"DocComment":" *must* return the exact size of the iterator."},{"DocComment":""},{"DocComment":" The [`len`] method has a default implementation, so you usually shouldn't"},{"DocComment":" implement it. However, you may be able to provide a more performant"},{"DocComment":" implementation than the default, so overriding it in this case makes sense."},{"DocComment":""},{"DocComment":" Note that this trait is a safe trait and as such does *not* and *cannot*"},{"DocComment":" guarantee that the returned length is correct. This means that `unsafe`"},{"DocComment":" code **must not** rely on the correctness of [`Iterator::size_hint`]. The"},{"DocComment":" unstable and unsafe [`TrustedLen`](super::marker::TrustedLen) trait gives"},{"DocComment":" this additional guarantee."},{"DocComment":""},{"DocComment":" [`len`]: ExactSizeIterator::len"},{"DocComment":""},{"DocComment":" # When *shouldn't* an adapter be `ExactSizeIterator`?"},{"DocComment":""},{"DocComment":" If an adapter makes an iterator *longer*, then it's usually incorrect for"},{"DocComment":" that adapter to implement `ExactSizeIterator`.  The inner exact-sized"},{"DocComment":" iterator might already be `usize::MAX`-long, and thus the length of the"},{"DocComment":" longer adapted iterator would no longer be exactly representable in `usize`."},{"DocComment":""},{"DocComment":" This is why [`Chain<A, B>`](crate::iter::Chain) isn't `ExactSizeIterator`,"},{"DocComment":" even when `A` and `B` are both `ExactSizeIterator`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // a finite range knows exactly how many times it will iterate"},{"DocComment":" let five = 0..5;"},{"DocComment":""},{"DocComment":" assert_eq!(5, five.len());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In the [module-level docs], we implemented an [`Iterator`], `Counter`."},{"DocComment":" Let's implement `ExactSizeIterator` for it as well:"},{"DocComment":""},{"DocComment":" [module-level docs]: crate::iter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # struct Counter {"},{"DocComment":" #     count: usize,"},{"DocComment":" # }"},{"DocComment":" # impl Counter {"},{"DocComment":" #     fn new() -> Counter {"},{"DocComment":" #         Counter { count: 0 }"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" # impl Iterator for Counter {"},{"DocComment":" #     type Item = usize;"},{"DocComment":" #     fn next(&mut self) -> Option<Self::Item> {"},{"DocComment":" #         self.count += 1;"},{"DocComment":" #         if self.count < 6 {"},{"DocComment":" #             Some(self.count)"},{"DocComment":" #         } else {"},{"DocComment":" #             None"},{"DocComment":" #         }"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl ExactSizeIterator for Counter {"},{"DocComment":"     // We can easily calculate the remaining number of iterations."},{"DocComment":"     fn len(&self) -> usize {"},{"DocComment":"         5 - self.count"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // And now we can use it!"},{"DocComment":""},{"DocComment":" let mut counter = Counter::new();"},{"DocComment":""},{"DocComment":" assert_eq!(5, counter.len());"},{"DocComment":" let _ = counter.next();"},{"DocComment":" assert_eq!(4, counter.len());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":99,"beg":{"line":86,"col":29},"end":{"line":86,"col":37}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":24,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null],"vtable":{"id":95,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":48,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["accum",0]},{"Ident":["Sum",0]}],"span":{"Untagged":{"data":{"file_id":105,"beg":{"line":18,"col":0},"end":{"line":18,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait to represent types that can be created by summing up an iterator."},{"DocComment":""},{"DocComment":" This trait is used to implement [`Iterator::sum()`]. Types which implement"},{"DocComment":" this trait can be generated by using t