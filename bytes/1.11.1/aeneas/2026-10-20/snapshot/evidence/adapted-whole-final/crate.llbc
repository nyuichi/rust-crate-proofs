13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["builders",0]},{"Ident":["DebugStruct",0]}],"span":{"Untagged":{"data":{"file_id":118,"beg":{"line":112,"col":0},"end":{"line":112,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A struct to help with [`fmt::Debug`](Debug) implementations."},{"DocComment":""},{"DocComment":" This is useful when you wish to output a formatted struct as a part of your"},{"DocComment":" [`Debug::fmt`] implementation."},{"DocComment":""},{"DocComment":" This can be constructed by the [`Formatter::debug_struct`] method."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Foo {"},{"DocComment":"     bar: i32,"},{"DocComment":"     baz: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Foo {"},{"DocComment":"     fn fmt(&self, fmt: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         fmt.debug_struct(\"Foo\")"},{"DocComment":"            .field(\"bar\", &self.bar)"},{"DocComment":"            .field(\"baz\", &self.baz)"},{"DocComment":"            .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"{:?}\", Foo { bar: 10, baz: \"Hello World\".to_string() }),"},{"DocComment":"     r#\"Foo { bar: 10, baz: \"Hello World\" }\"#,"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"DebugStruct","has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Mutable","late_bound":false},{"index":1,"name":"'b","variance":"Invariant","mutability":"Shared","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[{"region