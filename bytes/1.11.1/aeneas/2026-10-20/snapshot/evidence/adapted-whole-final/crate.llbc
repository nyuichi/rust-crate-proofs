hecked that `at` <= `self.len()` and we know that `self.len()` <=\n            // `self.capacity()`.\n            self.advance_unchecked(at);\n            other.cap = at;\n            other.len = at;\n            other\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Splits the buffer into two at the given index."},{"DocComment":""},{"DocComment":" Afterwards `self` contains elements `[at, len)`, and the returned `BytesMut`"},{"DocComment":" contains elements `[0, at)`."},{"DocComment":""},{"DocComment":" This is an `O(1)` operation that just increases the reference count and"},{"DocComment":" sets a few indices."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut a = BytesMut::from(&b\"hello world\"[..]);"},{"DocComment":" let mut b = a.split_to(5);"},{"DocComment":""},{"DocComment":" a[0] = b'!';"},{"DocComment":" b[0] = b'j';"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"!world\");"},{"DocComment":" assert_eq!(&b[..], b\"jello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `at > len`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":12,"generics":{"regions":[],"types":[],"c