Bound;\n\n        let len = self.len();\n\n        let begin = match range.start_bound() {\n            Bound::Included(&n) => n,\n            Bound::Excluded(&n) => n.checked_add(1).expect(\"out of range\"),\n            Bound::Unbounded => 0,\n        };\n\n        let end = match range.end_bound() {\n            Bound::Included(&n) => n.checked_add(1).expect(\"out of range\"),\n            Bound::Excluded(&n) => n,\n            Bound::Unbounded => len,\n        };\n\n        assert!(\n            begin <= end,\n            \"range start must not be greater than end: {:?} <= {:?}\",\n            begin,\n            end,\n        );\n        assert!(\n            end <= len,\n            \"range end out of bounds: {:?} <= {:?}\",\n            end,\n            len,\n        );\n\n        if end == begin {\n            return Bytes::new_empty_with_ptr(self.ptr.wrapping_add(begin));\n        }\n\n        let mut ret = self.clone();\n\n        ret.len = end - begin;\n        ret.ptr = unsafe { ret.ptr.add(begin) };\n\n        ret\n    }","attr_info":{"attributes":[{"DocComment":" Returns a slice of self for the provided range."},{"DocComment":""},{"DocComment":" This will increment the reference count for the underlying memory and"},{"DocComment":" return a new `Bytes` handle set to the slice."},{"DocComment":""},{"DocComment":" This operation is `O(1)`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let a = Bytes::from(&b\"hello world\"[..]);"},{"DocComment":" let b = a.slice(2..5);"},{"DocComment":""},{"DocComment":" assert_eq!(&b[..], b\"llo\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Requires that `begin <= end` and `end <= self.len()`, otherwise slicing"},{"DocComment":" will panic."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":