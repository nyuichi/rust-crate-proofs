e_text":"fn try_copy_to_slice(&mut self, mut dst: &mut [u8]) -> Result<(), TryGetError> {\n        if self.remaining() < dst.len() {\n            return Err(TryGetError {\n                requested: dst.len(),\n                available: self.remaining(),\n            });\n        }\n\n        while !dst.is_empty() {\n            let src = self.chunk();\n            let cnt = usize::min(src.len(), dst.len());\n\n            dst[..cnt].copy_from_slice(&src[..cnt]);\n            dst = &mut dst[cnt..];\n\n            self.advance(cnt);\n        }\n        Ok(())\n    }","attr_info":{"attributes":[{"DocComment":" Copies bytes from `self` into `dst`."},{"DocComment":""},{"DocComment":" The cursor is advanced by the number of bytes copied. `self` must have"},{"DocComment":" enough remaining bytes to fill `dst`."},{"DocComment":""},{"DocComment":" Returns `Err(TryGetError)` when there are not enough"},{"DocComment":" remaining bytes to read the value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 5];"},{"DocComment":""},{"DocComment":" assert_eq!(Ok(()), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(&b\"hello\"[..], &dst);"},{"DocComment":" assert_eq!(6, buf.remaining());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Buf, TryGetError};"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 12];"},{"DocComment":""},{"DocComment":" assert_eq!(Err(TryGetError{requested: 12, available: 11}), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(11, buf.remaining());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"ge