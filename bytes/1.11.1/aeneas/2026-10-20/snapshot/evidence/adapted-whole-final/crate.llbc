 do this safely with `IoSlice::advance` if we had a larger MSRV.\n                let buf = unsafe { std::mem::transmute::<&[u8], &'a [u8]>(slice) };\n                *dst = IoSlice::new(buf);\n                limit -= slice.len();\n            }\n        }\n        cnt\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":135,"col":8},"end":{"line":135,"col":11}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Var":{"Free":0}},{"Var":{"Free":1}}]}],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Untagged":{"TypeVar":{"Free":0}}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":32,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Untagged":{"Slice":[{"Untagged":{"Adt":{"id":41,"generics":{"regions":[{"Var":{"Free":0}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},null]}},"Mut"]}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usiz