es::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_i128_ne(0x01020304050607080910111213141516);\n    /// if cfg!(target_endian = \"big\") {\n    ///     assert_eq!(buf, b\"\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x10\\x11\\x12\\x13\\x14\\x15\\x16\");\n    /// } else {\n    ///     assert_eq!(buf, b\"\\x16\\x15\\x14\\x13\\x12\\x11\\x10\\x09\\x08\\x07\\x06\\x05\\x04\\x03\\x02\\x01\");\n    /// }\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_i128_ne(&mut self, n: i128) {\n        self.put_slice(&n.to_ne_bytes())\n    }\n\n    /// Writes an unsigned n-byte integer to `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_uint(0x010203, 3);\n    /// assert_eq!(buf, b\"\\x01\\x02\\x03\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_uint(&mut self, n: u64, nbytes: usize) {\n        let start = match mem::size_of_val(&n).checked_sub(nbytes) {\n            Some(start) => start,\n            None => panic_does_not_fit(nbytes, mem::size_of_val(&n)),\n        };\n\n        self.put_slice(&n.to_be_bytes()[start..]);\n    }\n\n    /// Writes an unsigned n-byte integer to `self` in the little-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_uint_le(0x010203, 3);\n    /// assert_eq!(buf, b\"\\x03\\x02\\x01\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_uint_le(&mut self, n: u64, nbytes: usize) {\n        let slice = n.to_le_bytes();\n        let slice = match slice.get(..nbytes) {\n            Some(slice) => slice,\n            None => panic_does_not_fit(nbytes, slice.len()),\n        };\n\n        self.put_slice(slice);\n    }\n\n    /// Writes an unsigned n-byte integer to `self` in the native-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_uint_ne(0x010203, 3);\n    /// if cfg!(target_endian = \"big\") {\n    ///     assert_eq!(buf, b\"\\x01\\x02\\x03\");\n    /// } else {\n    ///     assert_eq!(buf, b\"\\x03\\x02\\x01\");\n    /// }\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_uint_ne(&mut self, n: u64, nbytes: usize) {\n        if cfg!(target_endian = \"big\") {\n            self.put_uint(n, nbytes)\n        } else {\n            self.put_uint_le(n, nbytes)\n        }\n    }\n\n    /// Writes low `nbytes` of a signed integer to `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_int(0x0504010203, 3);\n    /// assert_eq!(buf, b\"\\x01\\x02\\x03\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_int(&mut self, n: i64, nbytes: usize) {\n        let start = match mem::size_of_val(&n).checked_sub(nbytes) {\n            Some(start) => start,\n            None => panic_does_not_fit(nbytes, mem::size_of_val(&n)),\n        };\n\n        self.put_slice(&n.to_be_bytes()[start..]);\n    }\n\n    /// Writes low `nbytes` of a signed integer to `self` in little-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_int_le(0x0504010203, 3);\n    /// assert_eq!(buf, b\"\\x03\\x02\\x01\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_int_le(&mut self, n: i64, nbytes: usize) {\n        let slice = n.to_le_bytes();\n        let slice = match slice.get(..nbytes) {\n            Some(slice) => slice,\n            None => panic_does_not_fit(nbytes, slice.len()),\n        };\n\n        self.put_slice(slice);\n    }\n\n    /// Writes low `nbytes` of a signed integer to `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by `nbytes`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_int_ne(0x010203, 3);\n    /// if cfg!(target_endian = \"big\") {\n    ///     assert_eq!(buf, b\"\\x01\\x02\\x03\");\n    /// } else {\n    ///     assert_eq!(buf, b\"\\x03\\x02\\x01\");\n    /// }\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self` or if `nbytes` is greater than 8.\n    #[inline]\n    fn put_int_ne(&mut self, n: i64, nbytes: usize) {\n        if cfg!(target_endian = \"big\") {\n            self.put_int(n, nbytes)\n        } else {\n            self.put_int_le(n, nbytes)\n        }\n    }\n\n    /// Writes an IEEE754 single-precision (4 bytes) floating point number to\n    /// `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by 4.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f32(1.2f32);\n    /// assert_eq!(buf, b\"\\x3F\\x99\\x99\\x9A\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f32(&mut self, n: f32) {\n        self.put_u32(n.to_bits());\n    }\n\n    /// Writes an IEEE754 single-precision (4 bytes) floating point number to\n    /// `self` in little-endian byte order.\n    ///\n    /// The current position is advanced by 4.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f32_le(1.2f32);\n    /// assert_eq!(buf, b\"\\x9A\\x99\\x99\\x3F\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f32_le(&mut self, n: f32) {\n        self.put_u32_le(n.to_bits());\n    }\n\n    /// Writes an IEEE754 single-precision (4 bytes) floating point number to\n    /// `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by 4.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f32_ne(1.2f32);\n    /// if cfg!(target_endian = \"big\") {\n    ///     assert_eq!(buf, b\"\\x3F\\x99\\x99\\x9A\");\n    /// } else {\n    ///     assert_eq!(buf, b\"\\x9A\\x99\\x99\\x3F\");\n    /// }\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f32_ne(&mut self, n: f32) {\n        self.put_u32_ne(n.to_bits());\n    }\n\n    /// Writes an IEEE754 double-precision (8 bytes) floating point number to\n    /// `self` in big-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f64(1.2f64);\n    /// assert_eq!(buf, b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\\x33\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f64(&mut self, n: f64) {\n        self.put_u64(n.to_bits());\n    }\n\n    /// Writes an IEEE754 double-precision (8 bytes) floating point number to\n    /// `self` in little-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f64_le(1.2f64);\n    /// assert_eq!(buf, b\"\\x33\\x33\\x33\\x33\\x33\\x33\\xF3\\x3F\");\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f64_le(&mut self, n: f64) {\n        self.put_u64_le(n.to_bits());\n    }\n\n    /// Writes an IEEE754 double-precision (8 bytes) floating point number to\n    /// `self` in native-endian byte order.\n    ///\n    /// The current position is advanced by 8.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut buf = vec![];\n    /// buf.put_f64_ne(1.2f64);\n    /// if cfg!(target_endian = \"big\") {\n    ///     assert_eq!(buf, b\"\\x3F\\xF3\\x33\\x33\\x33\\x33\\x33\\x33\");\n    /// } else {\n    ///     assert_eq!(buf, b\"\\x33\\x33\\x33\\x33\\x33\\x33\\xF3\\x3F\");\n    /// }\n    /// ```\n    ///\n    /// # Panics\n    ///\n    /// This function panics if there is not enough remaining capacity in\n    /// `self`.\n    #[inline]\n    fn put_f64_ne(&mut self, n: f64) {\n        self.put_u64_ne(n.to_bits());\n    }\n\n    /// Creates an adaptor which can write at most `limit` bytes to `self`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let arr = &mut [0u8; 128][..];\n    /// assert_eq!(arr.remaining_mut(), 128);\n    ///\n    /// let dst = arr.limit(10);\n    /// assert_eq!(dst.remaining_mut(), 10);\n    /// ```\n    #[inline]\n    fn limit(self, limit: usize) -> Limit<Self>\n    where\n        Self: Sized,\n    {\n        limit::new(self, limit)\n    }\n\n    /// Creates an adaptor which implements the `Write` trait for `self`.\n    ///\n    /// This function returns a new value which implements `Write` by adapting\n    /// the `Write` trait functions to the `BufMut` trait functions. Given that\n    /// `BufMut` operations are infallible, none of the `Write` functions will\n    /// return with `Err`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    /// use std::io::Write;\n    ///\n    /// let mut buf = vec![].writer();\n    ///\n    /// let num = buf.write(&b\"hello world\"[..]).unwrap();\n    /// assert_eq!(11, num);\n    ///\n    /// let buf = buf.into_inner();\n    ///\n    /// assert_eq!(*buf, b\"hello world\"[..]);\n    /// ```\n    #[cfg(feature = \"std\")]\n    #[cfg_attr(docsrs, doc(cfg(feature = \"std\")))]\n    #[inline]\n    fn writer(self) -> Writer<Self>\n    where\n        Self: Sized,\n    {\n        writer::new(self)\n    }\n\n    /// Creates an adapter which will chain this buffer with another.\n    ///\n    /// The returned `BufMut` instance will first write to all bytes from\n    /// `self`. Afterwards, it will write to `next`.\n    ///\n    /// # Examples\n    ///\n    /// ```\n    /// use bytes::BufMut;\n    ///\n    /// let mut a = [0u8; 5];\n    /// let mut b = [0u8; 6];\n    ///\n    /// let mut chain = (&mut a[..]).chain_mut(&mut b[..]);\n    ///\n    /// chain.put_slice(b\"hello world\");\n    ///\n    /// assert_eq!(&a[..], b\"hello\");\n    /// assert_eq!(&b[..], b\" world\");\n    /// ```\n    #[inline]\n    fn chain_mut<U>(self, next: U) -> Chain<Self, U>\n    where\n        Self: Sized,\n    {\n        Chain::new(self, next)\n    }\n}","attr_info":{"attributes":[{"DocComment":" A trait for values that provide sequential write access to bytes."},{"DocComment":""},{"DocComment":" Write bytes to a buffer"},{"DocComment":""},{"DocComment":" A buffer stores bytes in memory such that write operations are infallible."},{"DocComment":" The underlying storage may or may not be in contiguous memory. A `BufMut`"},{"DocComment":" value is a cursor into the buffer. Writing to `BufMut` advances the cursor"},{"DocComment":" position."},{"DocComment":""},{"DocComment":" The simplest `BufMut` is a `Vec<u8>`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = vec![];"},{"DocComment":""},{"DocComment":" buf.put(&b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(buf, b\"hello world\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"remaining_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["remaining_mut",0]}],"span":{"Untagged":{"data":{"file_id":32,"beg":{"line":64,"col":4},"end":{"line":64,"col":37}},"generated_from_span":null}},"source_text":"fn remaining_mut(&self) -> usize;","attr_info":{"attributes":[{"DocComment":" Returns the number of bytes that can be written from the current"},{"DocComment":" position until the end of the buffer is reached."},{"DocComment":""},{"DocComment":" This value is greater than or equal to the length of the slice returned"},{"DocComment":" by `chunk_mut()`."},{"DocComment":""},{"DocComment":" Writing to a `BufMut` may involve allocating more memory on the fly."},{"DocComment":" Implementations may fail before reaching the number of bytes indicated"},{"DocComment":" by this method if they encounter an allocation failure."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 10];"},{"DocComment":" let mut buf = &mut dst[..];"},{"DocComment":""},{"DocComment":" let original_remaining = buf.remaining_mut();"},{"DocComment":" buf.put(&b\"hello\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(original_remaining - 5, buf.remaining_mut());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" Implementations of `remaining_mut` should ensure that the return value"},{"DocComment":" does not change unless a call is made to `advance_mut` or any other"},{"DocComment":" function that is documented to change the `BufMut`'s current position."},{"DocComment":""},{"DocComment":" # Note"},{"DocComment":""},{"DocComment":" `remaining_mut` may return value smaller than actual available space."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},"default":null},"kind":{"TraitMethod":[13,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["advance_mut",0]}],"span":{"Untagged":{"data":{"file_id":32,"beg":{"line":107,"col":4},"end":{"line":107,"col":49}},"generated_from_span":null}},"source_text":"unsafe fn advance_mut(&mut self, cnt: usize);","attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the BufMut"},{"DocComment":""},{"DocComment":" The next call to `chunk_mut` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" The caller must ensure that the next `cnt` bytes of `chunk` are"},{"DocComment":" initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" // Write some data"},{"DocComment":" buf.chunk_mut()[0..2].copy_from_slice(b\"he\");"},{"DocComment":" unsafe { buf.advance_mut(2) };"},{"DocComment":""},{"DocComment":" // write more bytes"},{"DocComment":" buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");"},{"DocComment":""},{"DocComment":" unsafe { buf.advance_mut(3); }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining_mut()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance_mut` to panic if"},{"DocComment":" `cnt > self.remaining_mut()`. If the implementation does not panic,"},{"DocComment":" the call must behave as if `cnt == self.remaining_mut()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":null},"kind":{"TraitMethod":[13,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"has_remaining_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["has_remaining_mut",0]}],"span":{"Untagged":{"data":{"file_id":32,"beg":{"line":128,"col":4},"end":{"line":130,"col":5}},"generated_from_span":null}},"source_text":"fn has_remaining_mut(&self) -> bool {\n        self.remaining_mut() > 0\n    }","attr_info":{"attributes":[{"DocComment":" Returns true if there is space in `self` for more bytes."},{"DocComment":""},{"DocComment":" This is equivalent to `self.remaining_mut() != 0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 5];"},{"DocComment":" let mut buf = &mut dst[..];"},{"DocComment":""},{"DocComment":" assert!(buf.has_remaining_mut());"},{"DocComment":""},{"DocComment":" buf.put(&b\"hello\"[..]);"},{"DocComment":""},{"DocComment":" assert!(!buf.has_remaining_mut());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":32,"beg":{"line":127,"col":4},"end":{"line":127,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Scalar":"Bool"}}},"default":{"id":325,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[13,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunk_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["chunk_mut",0]}],"span":{"Untagged":{"data":{"file_id":32,"beg":{"line":179,"col":4},"end":{"line":179,"col":48}},"generated_from_span":null}},"source_text":"fn chunk_mut(&mut self) -> &mut UninitSlice;","attr_info":{"attributes":[{"DocComment":" Returns a mutable slice starting at the current BufMut position and of"},{"DocComment":" length between 0 and `BufMut::remaining_mut()`. Note that this *can* be shorter than the"},{"DocComment":" whole remainder of the buffer (this allows non-continuous implementation)."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" The returned byte slice may represent uninitialized memory."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // MaybeUninit::as_mut_ptr"},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'h');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'e');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(2);"},{"DocComment":""},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[2..].as_mut_ptr().write(b'o');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(3);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. `chunk_mut()` should return an empty"},{"DocComment":" slice **if and only if** `remaining_mut()` returns 0. In other words,"},{"DocComment":" `chunk_mut()` returning an empty slice implies that `remaining_mut()` will"},{"DocComment":" return 0 and `remaining_mut()` returning 0 implies that `chunk_mut()` will"},{"DocComment":" return an empty slice."},{"DocComment":""},{"DocComment":" This function may trigger an out-of-memory abort if it tries to allocate"},{"DocComment":" memory and fails to do so."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,