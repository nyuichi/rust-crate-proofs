rthand is `..`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..` syntax is a `RangeFull`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(.., std::ops::RangeFull);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" for i in .. {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Used as a [slicing index], `RangeFull` produces the full array as a slice."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]); // This is the `RangeFull`"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeFull","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":98,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeInclusive",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":362,"col":0},"end":{"line":362,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range bounded inclusively below and above (`start..=end`)."},{"DocComment":""},{"DocComment":" The `RangeInclusive` `start..=end` contains all values with `x >= start`"},{"DocComment":" and `x <= end`. It is empty unless `start <= end`."},{"DocComment":""},{"DocComment":" This iterator is [fused], but the specific values of `start` and `end` after"},{"DocComment":" iteration has finished are **unspecified** other than that [`.is_empty()`]"},{"DocComment":" will return `true` once no more values will be produced."},{"DocComment":""},{"DocComment":" [fused]: crate::iter::FusedIterator"},{"DocComment":" [`.is_empty()`]: RangeInclusive::is_empty"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..=end` syntax is a `RangeInclusive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..=5), std::ops::RangeInclusive::new(3, 5));"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..=5).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]); // This is a `RangeInclusive`"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeInclusiveStruct","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":99,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeTo",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":286,"col":0},"end":{"line":286,"col":23}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded exclusively above (`..end`)."},{"DocComment":""},{"DocComment":" The `RangeTo` `..end` contains all values with `x < end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..end` syntax is a `RangeTo`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..5), std::ops::RangeTo { end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeTo","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":289,"col":4},"end":{"line":289,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Untagged":{"TypeVar":{"Free":0}}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"AlignTo":{"base":{"Untagged":{"Plus":[{"Untagged":{"Constant":{"Untagged":[{"OffsetOf":[{"id":99,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},{"Untagged":{"Constant":{"Untagged":[{"SizeOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}]}},"target_align":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}}}}},"align":{"chosen":null,"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":null,"inhabited":{"Untagged":{"GenericType":{"Untagged":{"TypeVar":{"Free":0}}}}},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}},"chosen":null}],"inhabited":{"Untagged":{"GenericType":{"Untagged":{"TypeVar":{"Free":0}}}}},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":100,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeToInclusive",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":628,"col":0},"end":{"line":628,"col":32}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded inclusively above (`..=end`)."},{"DocComment":""},{"DocComment":" The `RangeToInclusive` `..=end` contains all values with `x <= end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..=end` syntax is a `RangeToInclusive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..=5), std::ops::RangeToInclusive{ end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in a"},{"DocComment":" `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeToInclusive<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..=5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeToInclusive` produces a slice of all"},{"DocComment":" array elements up to and including the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]); // This is a `RangeToInclusive`"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeToInclusive","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":631,"col":4},"end":{"line":631,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (inclusive)"}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Untagged":{"TypeVar":{"Free":0}}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"AlignTo":{"base":{"Untagged":{"Plus":[{"Untagged":{"Constant":{"Untagged":[{"OffsetOf":[{"id":100,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},{"Untagged":{"Constant":{"Untagged":[{"SizeOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}]}},"target_align":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}}}}},"align":{"chosen":null,"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":null,"inhabited":{"Untagged":{"GenericType":{"Untagged":{"TypeVar":{"Free":0}}}}},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Untagged":{"Constant":{"Untagged":[{"AlignOf":{"Untagged":{"TypeVar":{"Free":0}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}},"chosen":null}],"inhabited":{"Untagged":{"GenericType":{"Untagged":{"TypeVar":{"Free":0}}}}},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":101,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["vec_deque",0]},{"Ident":["VecDeque",0]}],"span":{"Untagged":{"data":{"file_id":106,"beg":{"line":104,"col":0},"end":{"line":107,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A double-ended queue implemented with a growable ring buffer."},{"DocComment":""},{"DocComment":" The \"default\" usage of this type as a queue is to use [`push_back`] to add to"},{"DocComment":" the queue, and [`pop_front`] to remove from the queue. [`extend`] and [`append`]"},{"DocComment":" push onto the back in this manner, and iterating over `VecDeque` goes front"},{"DocComment":" to back."},{"DocComment":""},{"DocComment":" A `VecDeque` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let deq = VecDeque::from([-1, 0, 1]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since `VecDeque` is a ring buffer, its elements are not necessarily contiguous"},{"DocComment":" in memory. If you want to access the elements as a single slice, such as for"},{"DocComment":" efficient sorting, you can use [`make_contiguous`]. It rotates the `VecDeque`"},{"DocComment":" so that its elements do not wrap, and returns a mutable slice to the"},{"DocComment":" now-contiguous element sequence."},{"DocComment":""},{"DocComment":" [`push_back`]: VecDeque::push_back"},{"DocComment":" [`pop_front`]: VecDeque::pop_front"},{"DocComment":" [`extend`]: VecDeque::extend"},{"DocComment":" [`append`]: VecDeque::append"},{"DocComment":" [`make_contiguous`]: VecDeque::make_contiguous"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"VecDeque","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},null,null,null,null,{"def_id":106,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]}],"span":{"Untagged":{"data":{"file_id":115,"beg":{"line":156,"col":0},"end":{"line":156,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is a _safe_ function that drops the contents of the `ManuallyDrop`"},{"DocComment":"   field, and it can be called outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`,"},{"DocComment":" or `Hash` on the struct or enum could be unsound, since the derived"},{"DocComment":" implementations of these traits would access the `ManuallyDrop` field."},{"DocComment":""},{"DocComment":" For example, in the following code, `derive(Debug)` is unsound in combination"},{"DocComment":" with the `ManuallyDrop::drop` call in `Foo::new`:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" # use std::mem::ManuallyDrop;"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     /// Invariant: this value may have been dropped!"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" As one could use the `Debug` implementation to access an already dropped"},{"DocComment":" field:"},{"DocComment":""},{"DocComment":" ```rust,ignore (uses-type-from-separate-snippet)"},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{foo:?}\"); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that similar unsoundness can arise without `derive`. The cause of the"},{"DocComment":" unsoundness are public APIs which allow to access an already dropped value"},{"DocComment":" inside `ManuallyDrop`."},{"DocComment":""},{"DocComment":" # Pre-`1.96` Interaction with `Box`"},{"DocComment":""},{"DocComment":" Before Rust `1.96.0`, if you had a `ManuallyDrop<T>`, where the type `T`"},{"DocComment":" was a `Box` or contained a `Box` inside, then dropping the `T` followed by"},{"DocComment":" moving the `ManuallyDrop<T>` was [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code caused undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior! (pre 1.96.0)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that this could also have happen with a generic type where the user of"},{"DocComment":" the library providing it could substitute the generic for a `Box<_>` and"},{"DocComment":" then move the library type:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound pre rust 1.96.0!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior! (pre 1.96)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"ManuallyDrop","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":107,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["Ordering",0]}],"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":465,"col":0},"end":{"line":465,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Atomic memory orderings"},{"DocComment":""},{"DocComment":" Memory orderings specify the way atomic operations synchronize memory."},{"DocComment":" In its weakest [`Ordering::Relaxed`], only the memory directly touched by the"},{"DocComment":" operation is synchronized. On the other hand, a store-load pair of [`Ordering::SeqCst`]"},{"DocComment":" operations synchronize other memory while additionally preserving a total order of such"},{"DocComment":" operations across all threads."},{"DocComment":""},{"DocComment":" Rust's memory orderings are [the same as those of"},{"DocComment":" C++20](https://en.cppreference.com/w/cpp/atomic/memory_order)."},{"DocComment":""},{"DocComment":" For more information see the [nomicon]."},{"DocComment":""},{"DocComment":" [nomicon]: ../../../nomicon/atomics.html"},{"Builtin":{"NonExhaustive":{"Untagged":{"data":{"file_id":39,"beg":{"line":463,"col":0},"end":{"line":463,"col":17}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Ordering","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":472,"col":4},"end":{"line":472,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No ordering constraints, only atomic operations."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_relaxed`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_relaxed`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Relaxed_ordering"}],"inline":null,"rename":null,"public":true},"name":"Relaxed","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":487,"col":4},"end":{"line":487,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a store, all previous operations become ordered"},{"DocComment":" before any load of this value with [`Acquire`] (or stronger) ordering."},{"DocComment":" In particular, all previous writes become visible to all threads"},{"DocComment":" that perform an [`Acquire`] (or stronger) load of this value."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] load operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a store."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_release`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_release`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Release","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":502,"col":4},"end":{"line":502,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a load, if the loaded value was written by a store operation with"},{"DocComment":" [`Release`] (or stronger) ordering, then all subsequent operations"},{"DocComment":" become ordered after that store. In particular, all subsequent loads will see data"},{"DocComment":" written before the store."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] store operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a load."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acquire`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acquire`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Acquire","fields":[],"discriminant":{"Signed":["Isize","2"]}},{"id":3,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":516,"col":4},"end":{"line":516,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Has the effects of both [`Acquire`] and [`Release`] together:"},{"DocComment":" For loads it uses [`Acquire`] ordering. For stores it uses the [`Release`] ordering."},{"DocComment":""},{"DocComment":" Notice that in the case of `compare_and_swap`, it is possible that the operation ends up"},{"DocComment":" not performing any store and hence it has just [`Acquire`] ordering. However,"},{"DocComment":" `AcqRel` will never perform [`Relaxed`] accesses."},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Signed":["Isize","3"]}},{"id":4,"span":{"Untagged":{"data":{"file_id":39,"beg":{"line":525,"col":4},"end":{"line":525,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Signed":["Isize","4"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}]],"fallback":"Invalid"}},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[[0,{"Unsigned":["U8","1"]}]]},{"field_offsets":[],"inhabited":{"Untagged":