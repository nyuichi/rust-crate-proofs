"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_copy_to_slice","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["try_copy_to_slice",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":1161,"col":4},"end":{"line":1179,"col":5}},"generated_from_span":null}},"source_text":"fn try_copy_to_slice(&mut self, mut dst: &mut [u8]) -> Result<(), TryGetError> {\n        if self.remaining() < dst.len() {\n            return Err(TryGetError {\n                requested: dst.len(),\n                available: self.remaining(),\n            });\n        }\n\n        while !dst.is_empty() {\n            let src = self.chunk();\n            let cnt = usize::min(src.len(), dst.len());\n\n            dst[..cnt].copy_from_slice(&src[..cnt]);\n            dst = &mut dst[cnt..];\n\n            self.advance(cnt);\n        }\n        Ok(())\n    }","attr_info":{"attributes":[{"DocComment":" Copies bytes from `self` into `dst`."},{"DocComment":""},{"DocComment":" The cursor is advanced by the number of bytes copied. `self` must have"},{"DocComment":" enough remaining bytes to fill `dst`."},{"DocComment":""},{"DocComment":" Returns `Err(TryGetError)` when there are not enough"},{"DocComment":" remaining bytes to read the value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 5];"},{"DocComment":""},{"DocComment":" assert_eq!(Ok(()), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(&b\"hello\"[..], &dst);"},{"DocComment":" assert_eq!(6, buf.remaining());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Buf, TryGetError};"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 12];"},{"DocComment":""},{"DocComment":" assert_eq!(Err(TryGetError{requested: 12, available: 11}), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(11, buf.remaining());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Ref":[{"Var":{"Bound":[0,1]}},{"Untagged":{"Slice":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},null]}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},{"Untagged":{"Adt":{"id":5,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":{"id":166,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[12,44]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_get_u8","item_meta":{"name":[{"Ident":["byte