       self.len(),\n        );\n\n        let mut ret = self.clone();\n\n        self.len = at;\n\n        unsafe { ret.inc_start(at) };\n\n        ret\n    }","attr_info":{"attributes":[{"DocComment":" Splits the bytes into two at the given index."},{"DocComment":""},{"DocComment":" Afterwards `self` contains elements `[0, at)`, and the returned `Bytes`"},{"DocComment":" contains elements `[at, len)`. It's guaranteed that the memory does not"},{"DocComment":" move, that is, the address of `self` does not change, and the address of"},{"DocComment":" the returned slice is `at` bytes after that."},{"DocComment":""},{"DocComment":" This is an `O(1)` operation that just increases the reference count and"},{"DocComment":" sets a few indices."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut a = Bytes::from(&b\"hello world\"[..]);"},{"DocComment":" let b = a.split_off(5);"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"hello\");"},{"DocComment":" assert_eq!(&b[..], b\" world\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `at > len`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":7,"generics":{"reg