t":"fn try_get_u8(&mut self) -> Result<u8, TryGetError> {\n        if self.remaining() < 1 {\n            return Err(TryGetError {\n                requested: 1,\n                available: self.remaining(),\n            });\n        }\n        let ret = self.chunk()[0];\n        self.advance(1);\n        Ok(ret)\n    }","attr_info":{"attributes":[{"DocComment":" Gets an unsigned 8 bit integer from `self`."},{"DocComment":""},{"DocComment":" The current position is advanced by 1."},{"DocComment":""},{"DocComment":" Returns `Err(TryGetError)` when there are not enough"},{"DocComment":" remaining bytes to read the value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"\\x08 hello\"[..];"},{"DocComment":" assert_eq!(Ok(0x08_u8), buf.try_get_u8());"},{"DocComment":" assert_eq!(6, buf.remaining());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Buf, TryGetError};"},{"DocComment":""},{"DocComment":" let mut buf = &b\"\"[..];"},{"DocComment":" assert_eq!(Err(TryGetError{requested: 1, available: 0}), buf.try_get_u8());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"origin":"TraitSelf","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outliv