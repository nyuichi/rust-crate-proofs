so take care to properly handle being called"},{"DocComment":" with `dst` being a zero length slice."},{"DocComment":""},{"DocComment":" [`writev`]: http://man7.org/linux/man-pages/man2/readv.2.html"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"origin":"TraitSelf","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Var":{"Free":0}},{"Var":{"Free":1}}]}],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Untagged":{"TypeVar":{"Free":0}}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Untagged":{"Slice":[{"Untagged":{"Adt":{"id":41,"generics":{"regions":[{"Var":{"Free":0}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},null]}},"Mut"]}}],"output":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},"src":{"TraitDefault":{"trait_ref":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}},"item_id":2}},"body":{"Structured":{"span":{"Untagged":{"data":{"file