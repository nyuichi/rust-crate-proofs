ut(cnt);\n        *self = b;\n    }\n\n    #[inline]\n    fn put_slice(&mut self, src: &[u8]) {\n        if self.len() < src.len() {\n            panic_advance(&TryGetError {\n                requested: src.len(),\n                available: self.len(),\n            });\n        }\n\n        // SAFETY: We just checked that the pointer is valid for `src.len()` bytes.\n        unsafe {\n            ptr::copy_nonoverlapping(src.as_ptr(), self.as_mut_ptr().cast(), src.len());\n            self.advance_mut(src.len());\n        }\n    }\n\n    #[inline]\n    fn put_bytes(&mut self, val: u8, cnt: usize) {\n        if self.len() < cnt {\n            panic_advance(&TryGetError {\n                requested: cnt,\n                available: self.len(),\n            });\n        }\n\n        // SAFETY: We just checked that the pointer is valid for `cnt` bytes.\n        unsafe {\n            ptr::write_bytes(self.as_mut_ptr() as *mut u8, val, cnt);\n            self.advance_mut(cnt);\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":[{"Untagged":{"Adt":{"id":65,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},null]}},"Mut"]}}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":true,"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late