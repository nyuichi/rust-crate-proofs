nt":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":167,"col":4},"end":{"line":167,"col":47}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a shared reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":4,"beg":{"line":166,"col":4},"end":{"line":166,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":2}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[2,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":173,"col":4},"end":{"line":173,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":4,"beg":{"line":172,"col":4},"end":{"line":172,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":2}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[2,5]}}],"vtable":{"id":9,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":170,"col":0},"end":{"line":170,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":14,"beg":{"line":178,"col":4},"end":{"line":178,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"TypeVar":{"Free":1}}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":2}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":8,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":2}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["Deref",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":139,"col":0},"end":{"line":139,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for immutable dereferencing operations, like `*v`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in immutable contexts, `Deref` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"`Deref` coercion\"][coercion]. In mutable contexts, [`DerefMut`] is used and"},{"DocComment":" mutable deref coercion similarly occurs."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `Deref`. The"},{"DocComment":" compiler will silently insert calls to `Deref::deref`. For this reason, one"},{"DocComment":" should be careful about implementing `Deref` and only do so when deref"},{"DocComment":" coercion is desirable. See [below][implementing] for advice on when this is"},{"DocComment":" typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `Deref` or `DerefMut` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `Deref<Target = U>`, and `v` is a value of type `T`, then:"},{"DocComment":""},{"DocComment":" * In immutable contexts, `*v` (where `T` is neither a reference nor a raw"},{"DocComment":"   pointer) is equivalent to `*Deref::deref(&v)`."},{"DocComment":" * Values of type `&T` are coerced to values of type `&U`"},{"DocComment":" * `T` implicitly implements all the methods of the type `U` which take the"},{"DocComment":"   `&self` receiver."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution], and [type coercions]."},{"DocComment":""},{"DocComment":" # When to implement `Deref` or `DerefMut`"},{"DocComment":""},{"DocComment":" The same advice applies to both deref traits. In general, deref traits"},{"DocComment":" **should** be implemented if:"},{"DocComment":""},{"DocComment":" 1. a value of the type transparently behaves like a value of the target"},{"DocComment":"    type;"},{"DocComment":" 1. the implementation of the deref function is cheap; and"},{"DocComment":" 1. users of the type will not be surprised by any deref coercion behavior."},{"DocComment":""},{"DocComment":" In general, deref traits **should not** be implemented if:"},{"DocComment":""},{"DocComment":" 1. the deref implementations could fail unexpectedly; or"},{"DocComment":" 1. the type has methods that are likely to collide with methods on the"},{"DocComment":"    target type; or"},{"DocComment":" 1. committing to deref coercion as part of the public API is not desirable."},{"DocComment":""},{"DocComment":" Note that there's a large difference between implementing deref traits"},{"DocComment":" generically over many target types, and doing so only for specific target"},{"DocComment":" types."},{"DocComment":""},{"DocComment":" Generic implementations, such as for [`Box<T>`][box] (which is generic over"},{"DocComment":" every type and dereferences to `T`) should be careful to provide few or no"},{"DocComment":" methods, since the target type is unknown and therefore every method could"},{"DocComment":" collide with one on the target type, causing confusion for users."},{"DocComment":" `impl<T> Box<T>` has no methods (though several associated functions),"},{"DocComment":" partly for this reason."},{"DocComment":""},{"DocComment":" Specific implementations, such as for [`String`][string] (whose `Deref`"},{"DocComment":" implementation has `Target = str`) can have many methods, since avoiding"},{"DocComment":" collision is much easier. `String` and `str` both have many methods, and"},{"DocComment":" `String` additionally behaves as if it has every method of `str` because of"},{"DocComment":" deref coercion. The implementing type may also be generic while the"},{"DocComment":" implementation is still specific in this sense; for example, [`Vec<T>`][vec]"},{"DocComment":" dereferences to `[T]`, so methods of `T` are not applicable."},{"DocComment":""},{"DocComment":" Consider also that deref coercion means that deref traits are a much larger"},{"DocComment":" part of a type's public API than any other trait as it is implicitly called"},{"DocComment":" by the compiler. Therefore, it is advisable to consider whether this is"},{"DocComment":" something you are comfortable supporting as a public API."},{"DocComment":""},{"DocComment":" The [`AsRef`] and [`Borrow`][core::borrow::Borrow] traits have very similar"},{"DocComment":" signatures to `Deref`. It may be desirable to implement either or both of"},{"DocComment":" these, whether in addition to or rather than deref traits. See their"},{"DocComment":" documentation for details."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `Deref::deref` implicitly. Failure"},{"DocComment":" during dereferencing can be extremely confusing when `Deref` is invoked"},{"DocComment":" implicitly. In the majority of uses it should be infallible, though it may"},{"DocComment":" be acceptable to panic if the type is misused through programmer error, for"},{"DocComment":" example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #deref-coercion"},{"DocComment":" [implementing]: #when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [vec]: ../../alloc/vec/struct.Vec.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is accessible by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Deref;"},{"DocComment":""},{"DocComment":" struct DerefExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = DerefExample { value: 'a' };"},{"DocComment":" assert_eq!('a', *x);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Deref","diagnostic_item":"Deref","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Target","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["Deref",0]},{"Ident":["deref",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":150,"col":4},"end":{"line":150,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Dereferences the value."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"deref_method","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[4,0]}}],"vtable":{"id":11,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":220,"col":0},"end":{"line":220,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsRef","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_ref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]},{"Ident":["as_ref",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":223,"col":4},"end":{"line":223,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a shared reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[5,0]}}],"vtable":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["Borrow",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":158,"col":0},"end":{"line":158,"col":40}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for borrowing data."},{"DocComment":""},{"DocComment":" In Rust, it is common to provide different representations of a type for"},{"DocComment":" different use cases. For instance, storage location and management for a"},{"DocComment":" value can be specifically chosen as appropriate for a particular use via"},{"DocComment":" pointer types such as [`Box<T>`] or [`Rc<T>`]. Beyond these generic"},{"DocComment":" wrappers that can be used with any type, some types provide optional"},{"DocComment":" facets providing potentially costly functionality. An example for such a"},{"DocComment":" type is [`String`] which adds the ability to extend a string to the basic"},{"DocComment":" [`str`]. This requires keeping additional information unnecessary for a"},{"DocComment":" simple, immutable string."},{"DocComment":""},{"DocComment":" These types provide access to the underlying data through references"},{"DocComment":" to the type of that data. They are said to be ‘borrowed as’ that type."},{"DocComment":" For instance, a [`Box<T>`] can be borrowed as `T` while a [`String`]"},{"DocComment":" can be borrowed as `str`."},{"DocComment":""},{"DocComment":" Types express that they can be borrowed as some type `T` by implementing"},{"DocComment":" `Borrow<T>`, providing a reference to a `T` in the trait’s"},{"DocComment":" [`borrow`] method. A type is free to borrow as several different types."},{"DocComment":" If it wishes to mutably borrow as the type, allowing the underlying data"},{"DocComment":" to be modified, it can additionally implement [`BorrowMut<T>`]."},{"DocComment":""},{"DocComment":" Further, when providing implementations for additional traits, it needs"},{"DocComment":" to be considered whether they should behave identically to those of the"},{"DocComment":" underlying type as a consequence of acting as a representation of that"},{"DocComment":" underlying type. Generic code typically uses `Borrow<T>` when it relies"},{"DocComment":" on the identical behavior of these additional trait implementations."},{"DocComment":" These traits will likely appear as additional trait bounds."},{"DocComment":""},{"DocComment":" In particular `Eq`, `Ord` and `Hash` must be equivalent for"},{"DocComment":" borrowed and owned values: `x.borrow() == y.borrow()` should give the"},{"DocComment":" same result as `x == y`."},{"DocComment":""},{"DocComment":" If generic code merely needs to work for all types that can"},{"DocComment":" provide a reference to related type `T`, it is often better to use"},{"DocComment":" [`AsRef<T>`] as more types can safely implement it."},{"DocComment":""},{"DocComment":" [`Box<T>`]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`Mutex<T>`]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [`Rc<T>`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`borrow`]: Borrow::borrow"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" As a data collection, [`HashMap<K, V>`] owns both keys and values. If"},{"DocComment":" the key’s actual data is wrapped in a managing type of some kind, it"},{"DocComment":" should, however, still be possible to search for a value using a"},{"DocComment":" reference to the key’s data. For instance, if the key is a string, then"},{"DocComment":" it is likely stored with the hash map as a [`String`], while it should"},{"DocComment":" be possible to search using a [`&str`][`str`]. Thus, `insert` needs to"},{"DocComment":" operate on a `String` while `get` needs to be able to use a `&str`."},{"DocComment":""},{"DocComment":" Slightly simplified, the relevant parts of `HashMap<K, V>` look like"},{"DocComment":" this:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::Borrow;"},{"DocComment":" use std::hash::Hash;"},{"DocComment":""},{"DocComment":" pub struct HashMap<K, V> {"},{"DocComment":"     # marker: ::std::marker::PhantomData<(K, V)>,"},{"DocComment":"     // fields omitted"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<K, V> HashMap<K, V> {"},{"DocComment":"     pub fn insert(&self, key: K, value: V) -> Option<V>"},{"DocComment":"     where K: Hash + Eq"},{"DocComment":"     {"},{"DocComment":"         # unimplemented!()"},{"DocComment":"         // ..."},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     pub fn get<Q>(&self, k: &Q) -> Option<&V>"},{"DocComment":"     where"},{"DocComment":"         K: Borrow<Q>,"},{"DocComment":"         Q: Hash + Eq + ?Sized"},{"DocComment":"     {"},{"DocComment":"         # unimplemented!()"},{"DocComment":"         // ..."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The entire hash map is generic over a key type `K`. Because these keys"},{"DocComment":" are stored with the hash map, this type has to own the key’s data."},{"DocComment":" When inserting a key-value pair, the map is given such a `K` and needs"},{"DocComment":" to find the correct hash bucket and check if the key is already present"},{"DocComment":" based on that `K`. It therefore requires `K: Hash + Eq`."},{"DocComment":""},{"DocComment":" When searching for a value in the map, however, having to provide a"},{"DocComment":" reference to a `K` as the key to search for would require to always"},{"DocComment":" create such an owned value. For string keys, this would mean a `String`"},{"DocComment":" value needs to be created just for the search for cases where only a"},{"DocComment":" `str` is available."},{"DocComment":""},{"DocComment":" Instead, the `get` method is generic over the type of the underlying key"},{"DocComment":" data, called `Q` in the method signature above. It states that `K`"},{"DocComment":" borrows as a `Q` by requiring that `K: Borrow<Q>`. By additionally"},{"DocComment":" requiring `Q: Hash + Eq`, it signals the requirement that `K` and `Q`"},{"DocComment":" have implementations of the `Hash` and `Eq` traits that produce identical"},{"DocComment":" results."},{"DocComment":""},{"DocComment":" The implementation of `get` relies in particular on identical"},{"DocComment":" implementations of `Hash` by determining the key’s hash bucket by calling"},{"DocComment":" `Hash::hash` on the `Q` value even though it inserted the key based on"},{"DocComment":" the hash value calculated from the `K` value."},{"DocComment":""},{"DocComment":" As a consequence, the hash map breaks if a `K` wrapping a `Q` value"},{"DocComment":" produces a different hash than `Q`. For instance, imagine you have a"},{"DocComment":" type that wraps a string but compares ASCII letters ignoring their case:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" pub struct CaseInsensitiveString(String);"},{"DocComment":""},{"DocComment":" impl PartialEq for CaseInsensitiveString {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool {"},{"DocComment":"         self.0.eq_ignore_ascii_case(&other.0)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Eq for CaseInsensitiveString { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because two equal values need to produce the same hash value, the"},{"DocComment":" implementation of `Hash` needs to ignore ASCII case, too:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::hash::{Hash, Hasher};"},{"DocComment":" # pub struct CaseInsensitiveString(String);"},{"DocComment":" impl Hash for CaseInsensitiveString {"},{"DocComment":"     fn hash<H: Hasher>(&self, state: &mut H) {"},{"DocComment":"         for c in self.0.as_bytes() {"},{"DocComment":"             c.to_ascii_lowercase().hash(state)"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Can `CaseInsensitiveString` implement `Borrow<str>`? It certainly can"},{"DocComment":" provide a reference to a string slice via its contained owned string."},{"DocComment":" But because its `Hash` implementation differs, it behaves differently"},{"DocComment":" from `str` and therefore must not, in fact, implement `Borrow<str>`."},{"DocComment":" If it wants to allow others access to the underlying `str`, it can do"},{"DocComment":" that via `AsRef<str>` which doesn’t carry any extra requirements."},{"DocComment":""},{"DocComment":" [`Hash`]: crate::hash::Hash"},{"DocComment":" [`HashMap<K, V>`]: ../../std/collections/struct.HashMap.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Borrow","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Borrowed","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"borrow","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["Borrow",0]},{"Ident":["borrow",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":179,"col":4},"end":{"line":179,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Immutably borrows from an owned value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::Borrow;"},{"DocComment":""},{"DocComment":" fn check<T: Borrow<str>>(s: T) {"},{"DocComment":"     assert_eq!(\"Hello\", s.borrow());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"Hello\".to_string();"},{"DocComment":""},{"DocComment":" check(s);"},{"DocComment":""},{"DocComment":" let s = \"Hello\";"},{"DocComment":""},{"DocComment":" check(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[6,0]}}],"vtable":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":372,"col":0},"end":{"line":372,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap mutable-to-mutable reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsRef`] but used for converting between mutable"},{"DocComment":" references. If you need to do a costly conversion it is better to"},{"DocComment":" implement [`From`] with type `&mut T` or write a custom function."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsMut` auto-dereferences if the inner type is a mutable reference"},{"DocComment":" (e.g.: `foo.as_mut()` will work the same if `foo` has type `&mut Foo` or `&mut &mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [mutably dereferenceable types], e.g. `foo.as_mut()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_mut()`. Instead, many smart pointers provide an `as_mut` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsMut::as_mut`] should not be"},{"DocComment":" used for the sole purpose of mutable dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [mutably dereferenceable types]: core::ops::DerefMut"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::DerefMut#mutable-deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &mut i32 = x.as_mut();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &mut i32 = &mut x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`DerefMut`] should consider to add an implementation of `AsMut<T>` as"},{"DocComment":" follows:"},{"DocComment":""},{"DocComment":" [`DerefMut`]: core::ops::DerefMut"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::{Deref, DerefMut};"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" # impl DerefMut for SomeType {"},{"DocComment":" #     fn deref_mut(&mut self) -> &mut [u8] {"},{"DocComment":" #         &mut []"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsMut<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     <SomeType as Deref>::Target: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.deref_mut().as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsMut` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsMut<T> for T`"},{"DocComment":" with [`as_mut`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&mut T where T: AsMut<U>` which allows `AsMut` to auto-dereference, see \"Generic"},{"DocComment":" Implementations\" above)."},{"DocComment":""},{"DocComment":" [`as_mut`]: AsMut::as_mut"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsMut<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using `AsMut` as trait bound for a generic function, we can accept all mutable references that"},{"DocComment":" can be converted to type `&mut T`. Unlike [dereference], which has a single [target type],"},{"DocComment":" there can be multiple implementations of `AsMut` for a type. In particular, `Vec<T>` implements"},{"DocComment":" both `AsMut<Vec<T>>` and `AsMut<[T]>`."},{"DocComment":""},{"DocComment":" In the following, the example functions `caesar` and `null_terminate` provide a generic"},{"DocComment":" interface which works with any type that can be converted by cheap mutable-to-mutable conversion"},{"DocComment":" into a byte slice (`[u8]`) or a byte vector (`Vec<u8>`), respectively."},{"DocComment":""},{"DocComment":" [dereference]: core::ops::DerefMut"},{"DocComment":" [target type]: core::ops::Deref::Target"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Document {"},{"DocComment":"     info: String,"},{"DocComment":"     content: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: ?Sized> AsMut<T> for Document"},{"DocComment":" where"},{"DocComment":"     Vec<u8>: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.content.as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn caesar<T: AsMut<[u8]>>(data: &mut T, key: u8) {"},{"DocComment":"     for byte in data.as_mut() {"},{"DocComment":"         *byte = byte.wrapping_add(key);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn null_terminate<T: AsMut<Vec<u8>>>(data: &mut T) {"},{"DocComment":"     // Using a non-generic inner function, which contains most of the"},{"DocComment":"     // functionality, helps to minimize monomorphization overhead."},{"DocComment":"     fn doit(data: &mut Vec<u8>) {"},{"DocComment":"         let len = data.len();"},{"DocComment":"         if len == 0 || data[len-1] != 0 {"},{"DocComment":"             data.push(0);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     doit(data.as_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut v: Vec<u8> = vec![1, 2, 3];"},{"DocComment":"     caesar(&mut v, 5);"},{"DocComment":"     assert_eq!(v, [6, 7, 8]);"},{"DocComment":"     null_terminate(&mut v);"},{"DocComment":"     assert_eq!(v, [6, 7, 8, 0]);"},{"DocComment":"     let mut doc = Document {"},{"DocComment":"         info: String::from(\"Example\"),"},{"DocComment":"         content: vec![17, 19, 8],"},{"DocComment":"     };"},{"DocComment":"     caesar(&mut doc, 1);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9]);"},{"DocComment":"     null_terminate(&mut doc);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9, 0]);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note, however, that APIs don't need to be generic. In many cases taking a `&mut [u8]` or"},{"DocComment":" `&mut Vec<u8>`, for example, is the better choice (callers need to pass the correct type then)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsMut","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]},{"Ident":["as_mut",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":375,"col":4},"end":{"line":375,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a mutable reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[7,0]}}],"vtable":{"id":14,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["BorrowMut",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":190,"col":0},"end":{"line":190,"col":69}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for mutably borrowing data."},{"DocComment":""},{"DocComment":" As a companion to [`Borrow<T>`] this trait allows a type to borrow as"},{"DocComment":" an underlying type by providing a mutable reference. See [`Borrow<T>`]"},{"DocComment":" for more information on borrowing as another type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BorrowMut","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Borrowed","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":190,"col":45},"end":{"line":190,"col":69}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"borrow_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["borrow",0]},{"Ident":["BorrowMut",0]},{"Ident":["borrow_mut",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":207,"col":4},"end":{"line":207,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutably borrows from an owned value."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::BorrowMut;"},{"DocComment":""},{"DocComment":" fn check<T: BorrowMut<[i32]>>(mut v: T) {"},{"DocComment":"     assert_eq!(&mut [1, 2, 3], v.borrow_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![1, 2, 3];"},{"DocComment":""},{"DocComment":" check(v);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[8,0]}}],"vtable":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":270,"col":0},"end":{"line":270,"col":54}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for mutable dereferencing operations, like in `*v = 1;`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in mutable contexts, `DerefMut` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"mutable deref coercion\"][coercion]. In immutable contexts, [`Deref`] is used."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `DerefMut`. The"},{"DocComment":" compiler will silently insert calls to `DerefMut::deref_mut`. For this"},{"DocComment":" reason, one should be careful about implementing `DerefMut` and only do so"},{"DocComment":" when mutable deref coercion is desirable. See [the `Deref` docs][implementing]"},{"DocComment":" for advice on when this is typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `DerefMut` or `Deref` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Mutable deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `DerefMut<Target = U>`, and `v` is a value of type `T`,"},{"DocComment":" then:"},{"DocComment":""},{"DocComment":" * In mutable contexts, `*v` (where `T` is neither a reference nor a raw pointer)"},{"DocComment":"   is equivalent to `*DerefMut::deref_mut(&mut v)`."},{"DocComment":" * Values of type `&mut T` are coerced to values of type `&mut U`"},{"DocComment":" * `T` implicitly implements all the (mutable) methods of the type `U`."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution] and [type coercions]."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `DerefMut::deref_mut` implicitly."},{"DocComment":" Failure during dereferencing can be extremely confusing when `DerefMut` is"},{"DocComment":" invoked implicitly. In the majority of uses it should be infallible, though"},{"DocComment":" it may be acceptable to panic if the type is misused through programmer"},{"DocComment":" error, for example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #mutable-deref-coercion"},{"DocComment":" [implementing]: Deref#when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is modifiable by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Deref, DerefMut};"},{"DocComment":""},{"DocComment":" struct DerefMutExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefMutExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> DerefMut for DerefMutExample<T> {"},{"DocComment":"     fn deref_mut(&mut self) -> &mut Self::Target {"},{"DocComment":"         &mut self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x = DerefMutExample { value: 'a' };"},{"DocComment":" *x = 'b';"},{"DocComment":" assert_eq!('b', x.value);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"DerefMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Clause0_Target","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":270,"col":26},"end":{"line":270,"col":39}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deref_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]},{"Ident":["deref_mut",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":274,"col":4},"end":{"line":274,"col":49}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutably dereferences the value."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"deref_mut_method","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":1}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[9,0]}}],"vtable":{"id":16,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["AtomicPrimitive",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":291,"col":0},"end":{"line":291,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker trait for primitive types which can be modified atomically."},{"DocComment":""},{"DocComment":" This is an implementation detail for <code>[Atomic]\\<T></code> which may disappear or be replaced at any time."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Storage","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":291,"col":53},"end":{"line":291,"col":57}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[],"vtable":null},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker for types that can be dropped."},{"DocComment":""},{"DocComment":" This should be used for `[const]` bounds,"},{"DocComment":" as non-const bounds will always hold for every type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Destruct","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":null},"kind":{"TraitMethod":[11,0]}}],"vtable":null},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":454,"col":0},"end":{"line":454,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types whose values can be duplicated simply by copying bits."},{"DocComment":""},{"DocComment":" By default, variable bindings have 'move semantics.' In other"},{"DocComment":" words:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `x` has moved into `y`, and so cannot be used"},{"DocComment":""},{"DocComment":" // println!(\"{x:?}\"); // error: use of moved value"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, if a type implements `Copy`, it instead has 'copy semantics':"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // We can derive a `Copy` implementation. `Clone` is also required, as it's"},{"DocComment":" // a supertrait of `Copy`."},{"DocComment":" #[derive(Debug, Copy, Clone)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `y` is a copy of `x`"},{"DocComment":""},{"DocComment":" println!(\"{x:?}\"); // A-OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's important to note that in these two examples, the only difference is whether you"},{"DocComment":" are allowed to access `x` after the assignment. Under the hood, both a copy and a move"},{"DocComment":" can result in bits being copied in memory, although this is sometimes optimized away."},{"DocComment":""},{"DocComment":" ## How can I implement `Copy`?"},{"DocComment":""},{"DocComment":" There are two ways to implement `Copy` on your type. The simplest is to use `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct MyStruct;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also implement `Copy` and `Clone` manually:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct MyStruct;"},{"DocComment":""},{"DocComment":" impl Copy for MyStruct { }"},{"DocComment":""},{"DocComment":" impl Clone for MyStruct {"},{"DocComment":"     fn clone(&self) -> MyStruct {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There is a small difference between the two. The `derive` strategy will also place a `Copy`"},{"DocComment":" bound on type parameters:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct MyStruct<T>(T);"},{"DocComment":""},{"DocComment":" impl<T: Copy> Copy for MyStruct<T> { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This isn't always desired. For example, shared references (`&T`) can be copied regardless of"},{"DocComment":" whether `T` is `Copy`. Likewise, a generic struct containing markers such as [`PhantomData`]"},{"DocComment":" could potentially be duplicated with a bit-wise copy."},{"DocComment":""},{"DocComment":" ## What's the difference between `Copy` and `Clone`?"},{"DocComment":""},{"DocComment":" Copies happen implicitly, for example as part of an assignment `y = x`. The behavior of"},{"DocComment":" `Copy` is not overloadable; it is always a simple bit-wise copy."},{"DocComment":""},{"DocComment":" Cloning is an explicit action, `x.clone()`. The implementation of [`Clone`] can"},{"DocComment":" provide any type-specific behavior necessary to duplicate values safely. For example,"},{"DocComment":" the implementation of [`Clone`] for [`String`] needs to copy the pointed-to string"},{"DocComment":" buffer in the heap. A simple bitwise copy of [`String`] values would merely copy the"},{"DocComment":" pointer, leading to a double free down the line. For this reason, [`String`] is [`Clone`]"},{"DocComment":" but not `Copy`."},{"DocComment":""},{"DocComment":" [`Clone`] is a supertrait of `Copy`, so everything which is `Copy` must also implement"},{"DocComment":" [`Clone`]. If a type is `Copy` then its [`Clone`] implementation only needs to return `*self`"},{"DocComment":" (see the example above)."},{"DocComment":""},{"DocComment":" ## When can my type be `Copy`?"},{"DocComment":""},{"DocComment":" A type can implement `Copy` if all of its components implement `Copy`. For example, this"},{"DocComment":" struct can be `Copy`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Point {"},{"DocComment":"    x: i32,"},{"DocComment":"    y: i32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A struct can be `Copy`, and [`i32`] is `Copy`, therefore `Point` is eligible to be `Copy`."},{"DocComment":" By contrast, consider"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct Point;"},{"DocComment":" struct PointList {"},{"DocComment":"     points: Vec<Point>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The struct `PointList` cannot implement `Copy`, because [`Vec<T>`] is not `Copy`. If we"},{"DocComment":" attempt to derive a `Copy` implementation, we'll get an error:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" the trait `Copy` cannot be implemented for this type; field `points` does not implement `Copy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Shared references (`&T`) are also `Copy`, so a type can be `Copy`, even when it holds"},{"DocComment":" shared references of types `T` that are *not* `Copy`. Consider the following struct,"},{"DocComment":" which can implement `Copy`, because it only holds a *shared reference* to our non-`Copy`"},{"DocComment":" type `PointList` from above:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct PointList;"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct PointListWrapper<'a> {"},{"DocComment":"     point_list_ref: &'a PointList,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## When *can't* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Some types can't be copied safely. For example, copying `&mut T` would create an aliased"},{"DocComment":" mutable reference. Copying [`String`] would duplicate responsibility for managing the"},{"DocComment":" [`String`]'s buffer, leading to a double free."},{"DocComment":""},{"DocComment":" Generalizing the latter case, any type implementing [`Drop`] can't be `Copy`, because it's"},{"DocComment":" managing some resource besides its own [`size_of::<T>`] bytes."},{"DocComment":""},{"DocComment":" If you try to implement `Copy` on a struct or enum containing non-`Copy` data, you will get"},{"DocComment":" the error [E0204]."},{"DocComment":""},{"DocComment":" [E0204]: ../../error_codes/E0204.html"},{"DocComment":""},{"DocComment":" ## When *should* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Generally speaking, if your type _can_ implement `Copy`, it should. Keep in mind, though,"},{"DocComment":" that implementing `Copy` is part of the public API of your type. If the type might become"},{"DocComment":" non-`Copy` in the future, it could be prudent to omit the `Copy` implementation now, to"},{"DocComment":" avoid a breaking API change."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Copy`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Copy` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Copy`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Copy`."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`size_of::<T>`]: size_of"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Copy","diagnostic_item":"Copy","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":454,"col":16},"end":{"line":454,"col":21}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"regions_out