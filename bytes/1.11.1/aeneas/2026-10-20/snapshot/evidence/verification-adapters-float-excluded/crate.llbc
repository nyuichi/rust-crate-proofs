          debug_assert!(dst.len() >= cnt);\n\n            ptr::copy_nonoverlapping(extend.as_ptr(), dst.as_mut_ptr().cast(), cnt);\n        }\n\n        unsafe {\n            self.advance_mut(cnt);\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Appends given bytes to this `BytesMut`."},{"DocComment":""},{"DocComment":" If this `BytesMut` object does not have enough capacity, it is resized"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(0);"},{"DocComment":" buf.extend_from_slice(b\"aaabbb\");"},{"DocComment":" buf.extend_from_slice(b\"cccddd\");"},{"DocComment":""},{"DocComment":" assert_eq!(b\"aaabbbcccddd\", &buf[..]);"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":865,"col":4},"end":{"line":865,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Untagged":{"Slice":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},null]}},"Shared"]}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}}