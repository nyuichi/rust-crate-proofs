by the"},{"DocComment":" number of bytes written."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = vec![];"},{"DocComment":""},{"DocComment":" buf.put_u8(b'h');"},{"DocComment":" buf.put(&b\"ello\"[..]);"},{"DocComment":" buf.put(&b\" world\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(buf, b\"hello world\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `self` does not have enough capacity to contain `src`."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":38,"beg":{"line":201,"col":4},"end":{"line":201,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":{"id":287,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMe