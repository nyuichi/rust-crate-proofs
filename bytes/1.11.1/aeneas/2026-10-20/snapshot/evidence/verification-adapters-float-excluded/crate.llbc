:[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"A","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":24,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_ptr",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":2058,"col":4},"end":{"line":2058,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a raw mutable pointer to the vector's buffer, or a dangling"},{"DocComment":" raw pointer valid for zero sized reads if the vector didn't allocate."},{"DocComment":""},{"DocComment":" The caller must ensure that the vector outlives the pointer this"},{"DocComment":" function returns, or else it will end up dangling."},{"DocComment":" Modifying the vector may cause its buffer to be reallocated,"},{"DocComment":" which would also make any pointers to it invalid."},{"DocComment":""},{"DocComment":" This method guarantees that for the purpose of the aliasing model, this method"},{"DocComment":" does not materialize a reference to the underlying slice, and thus the returned pointer"},{"DocComment":" will remain valid when mixed with other calls to [`as_ptr`], [`as_mut_ptr`],"},{"DocComment":" and [`as_non_null`]."},{"DocComment":" Note that calling other methods that materialize references to the slice,"},{"DocComment":" or references to specific elements you are planning on accessing through this pointer,"},{"DocComment":" may still invalidate this pointer."},{"DocComment":" See the second example below for how this guarantee can be used."},{"DocComment":""},{"DocComment":" The method also guarantees that, as long as `T` is not zero-sized and the capacity is"},{"DocComment":" nonzero, the pointer may be passed into [`dealloc`] with a layout of"},{"DocComment":" `Layout::array::<T>(capacity)` in order to deallocate the backing memory. If this is done,"},{"DocComment":" be careful not to run the destructor of the `Vec`, as dropping it will result in"},{"DocComment":" double-frees. Wrapping the `Vec` in a [`ManuallyDrop`] is the typical way to achieve this."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // Allocate vector big enough for 4 elements."},{"DocComment":" let size = 4;"},{"DocComment":" let mut x: Vec<i32> = Vec::with_capacity(size);"},{"DocComment":" let x_ptr = x.as_mut_ptr();"},{"DocComment":""},{"DocComment":" // Initialize elements via raw pointer writes, then set length."},{"DocComment":" unsafe {"},{"DocComment":"     for i in 0..size {"},{"DocComment":"         *x_ptr.add(i) = i as i32;"},{"DocComment":"     }"},{"DocComment":"     x.set_len(size);"},{"DocComment":" }"},{"DocComment":" assert_eq!(&*x, &[0, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Due to the aliasing guarantee, the following code is legal:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" unsafe {"},{"DocComment":"     let mut v = vec![0];"},{"DocComment":"     let ptr1 = v.as_mut_ptr();"},{"DocComment":"     ptr1.write(1);"},{"DocComment":"     let ptr2 = v.as_mut_ptr();"},{"DocComment":"     ptr2.write(2);"},{"DocComment":"     // Notably, the write to `ptr2` did *not* invalidate `ptr1`:"},{"DocComment":"     ptr1.write(3);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Deallocating a vector using [`Box`] (which uses [`dealloc`] internally):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{ManuallyDrop, MaybeUninit};"},{"DocComment":""},{"DocComment":" let mut v = ManuallyDrop::new(vec![0, 1, 2]);"},{"DocComment":" let ptr = v.as_mut_ptr();"},{"DocComment":" let capacity = v.capacity();"},{"DocComment":" let slice_ptr: *mut [MaybeUninit<i32>] ="},{"DocComment":"     std::ptr::slice_from_raw_parts_mut(ptr.cast(), capacity);"},{"DocComment":" drop(unsafe { Box::from_raw(slice_ptr) });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_mut_ptr`]: Vec::as_mut_ptr"},{"DocComment":" [`as_ptr`]: Vec::as_ptr"},{"DocComment":" [`as_non_null`]: Vec::as_non_null"},{"DocComment":" [`dealloc`]: crate::alloc::GlobalAlloc::dealloc"},{"DocComment":" [`ManuallyDrop`]: core::mem::ManuallyDrop"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"A","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Untagged":{"TypeVar":{"Free":0}}},{"Var":{"Free":0}}]},{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Untagged":{"TypeVar":{"Free":1}}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":24,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}}],"output":{"Untagged":{"RawPtr":[{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}},"src":"Normal","body":"Opaque"},{"def_id":348,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Ident":["vptr",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":1767,"col":0},"end":{"line":1773,"col":1}},"generated_from_span":null}},"source_text":"fn vptr(ptr: *mut u8) -> NonNull<u8> {\n    if cfg!(debug_assertions) {\n        NonNull::new(ptr).expect(\"Vec