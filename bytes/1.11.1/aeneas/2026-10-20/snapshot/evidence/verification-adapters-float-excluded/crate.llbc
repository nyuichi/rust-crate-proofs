"DocComment":" release a [`RefCell`] borrow:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cell::RefCell;"},{"DocComment":""},{"DocComment":" let x = RefCell::new(1);"},{"DocComment":""},{"DocComment":" let mut mutable_borrow = x.borrow_mut();"},{"DocComment":" *mutable_borrow = 1;"},{"DocComment":""},{"DocComment":" drop(mutable_borrow); // relinquish the mutable borrow on this slot"},{"DocComment":""},{"DocComment":" let borrow = x.borrow();"},{"DocComment":" println!(\"{}\", *borrow);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"mem_drop","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":41,"beg":{"line":1047,"col":7},"end":{"line":1047,"col":23}},"generated_from_span":null}},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is