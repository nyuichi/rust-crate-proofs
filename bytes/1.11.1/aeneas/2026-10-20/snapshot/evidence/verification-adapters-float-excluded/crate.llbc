mment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 5];"},{"DocComment":""},{"DocComment":" assert_eq!(Ok(()), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(&b\"hello\"[..], &dst);"},{"DocComment":" assert_eq!(6, buf.remaining());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Buf, TryGetError};"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":" let mut dst = [0; 12];"},{"DocComment":""},{"DocComment":" assert_eq!(Err(TryGetError{requested: 12, available: 11}), buf.try_copy_to_slice(&mut dst));"},{"DocComment":" assert_eq!(11, buf.remaining());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"origin":"TraitSelf","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Untagged":{"TypeVar":{"Free":0}}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"TypeVar":{"Free":0}}}