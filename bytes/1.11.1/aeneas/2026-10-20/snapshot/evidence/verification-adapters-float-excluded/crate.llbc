":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":{"TraitImpl":{"impl_ref":{"id":23,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"const_generics":[],"trait_refs":[]}},"item_id":6,"reuses_default":false}},"body":"Opaque"},{"def_id":334,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes_mut",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"kind":"InherentImplBlock"}}},{"Ident":["reserve",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":591,"col":4},"end":{"line":603,"col":5}},"generated_from_span":null}},"source_text":"pub fn reserve(&mut self, additional: usize) {\n        let len = self.len();\n        let rem = self.capacity() - len;\n\n        if additional <= rem {\n            // The handle can already store at least `additional` more bytes, so\n            // there is no further work needed to be done.\n            return;\n        }\n\n        // will always succeed\n        let _ = self.reserve_inner(additional, true);\n    }","attr_info":{"attributes":[{"DocComment":" Reserves capacity for at least `additional` more bytes to be inserted"},{"DocComment":" into the given `BytesMut`."},{"DocComment":""},{"DocComment":" More than `additional` bytes may be reserved in order to avoid frequent"},{"DocComment":" reallocations. A call to `reserve` may result in an allocation."},{"DocComment":""},{"DocComment":" Before allocating new buffer space, the function will attempt to reclaim"},{"DocComment":" space in the existing buffer. If the current handle references a view"},{"DocComment":" into a larger original buffer, and all other handles referencing part"},{"DocComment":" of the same original buffer have been dropped, then the current view"},{"DocComment":" can be copied/shifted to the front of the buffer and the handle can take"},{"DocComment":" ownership of the full buffer, provided that the full buffer is large"},{"DocComment":" enough to fit the requested additional capacity."},{"DocComment":""},{"DocComment":" This optimization will only happen if shifting the data from the current"},{"DocComment":" view to the front of the buffer is not too expensive in terms of the"},{"DocComment":" (amortized) time required. The precise condition is subject to change;"},{"DocComment":" as of now, the length of the data being shifted needs to be at least as"},{"DocComment":" large as the distance that it's shifted by. If the current view is empty"},{"DocComment":" and the original buffer is large enough to fit the requested additional"},{"DocComment":" capacity, then reallocations will never happen."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" In the following example, a new buffer is allocated."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BytesMut;"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::from(&b\"hello\"[..]);"},{"DocComment":" buf.reserve(64);"},{"DocComment":" assert!(buf.capacity() >= 69);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In the following example, the existing buffer is reclaimed."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(128);"},{"DocComment":" buf.put(&[0; 64][..]);"},{"DocComment":""},{"DocComment":" let ptr = buf.as_ptr();"},{"DocComment":" let other = buf.split();"},{"DocComment":""},{"DocComment":" assert!(buf.is_empty());"},{"DocComment":" assert_eq!(buf.capacity(), 64);"},{"DocComment":""},{"DocComment":" drop(other);"},{"DocComment":" buf.reserve(128);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.capacity(), 128);"},{"DocComment":" assert_eq!(buf.as_ptr(), ptr);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity overflows `usize`."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":590,"col":4},"end":{"line":590,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"src":"Normal","body":{"Structured":{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":591,"col":4},"end":{"line":603,"col":5}},"generated_from_span":null