ill implicitly grow its buffer as"},{"DocComment":" necessary. However, explicitly reserving the required space up-front before"},{"DocComment":" a series of inserts will be more efficient."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(64);"},{"DocComment":""},{"DocComment":" buf.put_u8(b'h');"},{"DocComment":" buf.put_u8(b'e');"},{"DocComment":" buf.put(&b\"llo\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(&buf[..], b\"hello\");"},{"DocComment":""},{"DocComment":" // Freeze the buffer so that it can be shared"},{"DocComment":" let a = buf.freeze();"},{"DocComment":""},{"DocComment":" // This does not allocate, instead `b` points to the same memory."},{"DocComment":" let b = a.clone();"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"hello\");"},{"DocComment":" assert_eq!(&b[..], b\"hello\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":61,"col":4},"end":{"line":61,"col":20}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"ptr","is_positional":false,"ty":{"Untagged":{"Adt":{"id":14,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":62,"col":4},"end":{"line":62,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"len","is_positi