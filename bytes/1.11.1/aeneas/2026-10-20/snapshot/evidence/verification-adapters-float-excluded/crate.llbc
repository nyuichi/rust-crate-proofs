ait":6}},{"Ident":["chunks_vectored",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":160,"col":4},"end":{"line":186,"col":5}},"generated_from_span":null}},"source_text":"fn chunks_vectored<'a>(&'a self, dst: &mut [IoSlice<'a>]) -> usize {\n        if self.limit == 0 {\n            return 0;\n        }\n\n        const LEN: usize = 16;\n        let mut slices: [IoSlice<'a>; LEN] = [IoSlice::new(&[]); LEN];\n\n        let cnt = self\n            .inner\n            .chunks_vectored(&mut slices[..dst.len().min(LEN)]);\n        let mut limit = self.limit;\n        for (i, (dst, slice)) in dst[..cnt].iter_mut().zip(slices.iter()).enumerate() {\n            if let Some(buf) = slice.get(..limit) {\n                // SAFETY: We could do this safely with `IoSlice::advance` if we had a larger MSRV.\n                let buf = unsafe { std::mem::transmute::<&[u8], &'a [u8]>(buf) };\n                *dst = IoSlice::new(buf);\n                return i + 1;\n            } else {\n                // SAFETY: We could do this safely with `IoSlice::advance` if we had a larger MSRV.\n                let buf = unsafe { std::mem::transmute::<&[u8], &'a [u8]>(slice) };\n                *dst = IoSlice::new(buf);\n                limit -= slice.len();\n            }\n        }\n        cnt\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":135,"col":8},"end":{"line":135,"col":11}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"regi