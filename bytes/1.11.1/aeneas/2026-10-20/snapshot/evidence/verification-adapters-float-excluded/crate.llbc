aining_mut());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":38,"beg":{"line":127,"col":4},"end":{"line":127,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Scalar":"Bool"}}},"default":{"id":286,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Untagged":{"kind":"SelfId","trait_decl_ref":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[13,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunk_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["chunk_mut",0]}],"span":{"Untagged":{"data":{"file_id":38,"beg":{"line":179,"col":4},"end":{"line":179,"col":48}},"generated_from_span":null}},"source_text":"fn chunk_mut(&mut self) -> &mut UninitSlice;","attr_info":{"attributes":[{"DocComment":" Returns a mutable slice starting at the current BufMut position and of"},{"DocComment":" length between 0 and `BufMut::remaining_mut()`. Note that this *can* be shorter than the"},{"DocComment":" whole remainder of the buffer (this allows non-continuous implementation)."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" The returned byte slice may represent uninitialized memory."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // MaybeUninit::as_mut_ptr"},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'h');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'e');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(2);"},{"DocComment":""},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[2..].as_mut_ptr().write(b'o');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(3);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. `chunk_mut()` should return an empty"},{"DocComment":" slice **if and only if** `remaining_mut()` returns 0. In other words,"},{"DocComment":" `chunk_mut()` returning an empty slice implies that `remaining_mut()` will"},{"DocComment":" return 0 and `remaining_mut()` returning 0 implies that `chunk_mut()` will"},{"DocComment":" return an empty slice."},{"DocComment":""},{"DocComment":" This function may trigger an out-of-memory abort if it tries to allocate"},{"DocComment":" memory and fails to do so."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":