ap = vec.capacity();\n\n        // Avoid an extra allocation if possible.\n        if len == cap {\n            let vec = ManuallyDrop::into_inner(vec);\n            return Bytes::from(vec.into_boxed_slice());\n        }\n\n        let shared = Box::new(Shared {\n            buf: ptr,\n            cap,\n            ref_cnt: AtomicUsize::new(1),\n        });\n\n        let shared = Box::into_raw(shared);\n        // The pointer should be aligned, so this assert should\n        // always succeed.\n        debug_assert!(\n            0 == (shared as usize & KIND_MASK),\n            \"internal: Box<Shared> should have an aligned pointer\",\n        );\n        Bytes {\n            ptr,\n            len,\n            data: AtomicPtr::new(shared as _),\n            vtable: &SHARED_VTABLE,\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Adt":{"id":18,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"output":{"Untagged":{"Adt":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":{"TraitImpl":{"impl_ref":{"id":18,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":19,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},{"Untagged":{"Adt":{"id":18,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"c