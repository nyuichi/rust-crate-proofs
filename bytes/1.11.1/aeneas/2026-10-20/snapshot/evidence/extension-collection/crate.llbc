",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":60,"col":0},"end":{"line":65,"col":1}},"generated_from_span":null}},"source_text":"pub struct BytesMut {\n    ptr: NonNull<u8>,\n    len: usize,\n    cap: usize,\n    data: *mut Shared,\n}","attr_info":{"attributes":[{"DocComment":" A unique reference to a contiguous slice of memory."},{"DocComment":""},{"DocComment":" `BytesMut` represents a unique view into a potentially shared memory region."},{"DocComment":" Given the uniqueness guarantee, owners of `BytesMut` handles are able to"},{"DocComment":" mutate the memory."},{"DocComment":""},{"DocComment":" `BytesMut` can be thought of as containing a `buf: Arc<Vec<u8>>`, an offset"},{"DocComment":" into `buf`, a slice length, and a guarantee that no other `BytesMut` for the"},{"DocComment":" same `buf` overlaps with its slice. That guarantee means that a write lock"},{"DocComment":" is not required."},{"DocComment":""},{"DocComment":" # Growth"},{"DocComment":""},{"DocComment":" `BytesMut`'s `BufMut` implementation will implicitly grow its buffer as"},{"DocComment":" necessary. However, explicitly reserving the required space up-front before"},{"DocComment":" a series of inserts will be more efficient."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{BytesMut, BufMut};"},{"DocComment":""},{"DocComment":" let mut buf = BytesMut::with_capacity(64);"},{"DocComment":""},{"DocComment":" buf.put_u8(b'h');"},{"DocComment":" buf.put_u8(b'e');"},{"DocComment":" buf.put(&b\"llo\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(&buf[..], b\"hello\");"},{"DocComment":""},{"DocComment":" // Freeze the buffer so that it can be shared"},{"DocComment":" let a = buf.freeze();"},{"DocComment":""},{"DocComment":" // This does not allocate, instead `b` points to the same memory."},{"DocComment":" let b = a.clone();"},{"DocComment":""},{"DocComment":" assert_eq!(&a[..], b\"hello\");"},{"DocComment":" assert_eq!(&b[..], b\"hello\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":61,"col":4},"end":{"line":61,"col":20}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"ptr","is_positional":false,"ty":{"Untagged":{"Adt":{"id":14,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":62,"col":4},"end":{"line":62,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"len","is_positional":false,"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":63,"col":4},"end":{"line":63,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"cap","is_positional":false,"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},{"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":64,"col":4},"end":{"line":64,"col":21}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"data","is_positional":false,"ty":{"Untagged":{"RawPtr":[{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}},"Mut"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","32"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usiz