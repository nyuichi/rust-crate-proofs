o; it must not"},{"DocComment":" be used to read or write other allocations."},{"DocComment":""},{"DocComment":" In other words, `let z = x.wrapping_add((y as usize) - (x as usize))` does *not* make `z`"},{"DocComment":" the same as `y` even if we assume `T` has size `1` and there is no overflow: `z` is still"},{"DocComment":" attached to the object `x` is attached to, and dereferencing it is Undefined Behavior unless"},{"DocComment":" `x` and `y` point into the same allocation."},{"DocComment":""},{"DocComment":" Compared to [`add`], this method basically delays the requirement of staying within the"},{"DocComment":" same allocation: [`add`] is immediate Undefined Behavior when crossing object"},{"DocComment":" boundaries; `wrapping_add` produces a pointer but still leads to Undefined Behavior if a"},{"DocComment":" pointer is dereferenced when it is out-of-bounds of the object it is attached to. [`add`]"},{"DocComment":" can be optimized better and is thus preferable in performance-sensitive code."},{"DocComment":""},{"DocComment":" The delayed check only considers the value of the pointer that was dereferenced, not the"},{"DocComment":" intermediate values used during the computation of the final result. For example,"},{"DocComment":" `x.wrapping_add(o).wrapping_sub(o)` is always the same as `x`. In other words, leaving the"},{"DocComment":" allocation and then re-entering it later is permitted."},{"DocComment":""},{"DocComment":" [`add`]: #method.add"},{"DocComment":" [allocation]: crate::ptr#allocation"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt::Write;"},{"DocComment":" // Iterate using a raw pointer in increments of two elements"},{"DocComment":" let data = [1u8, 2, 3, 4, 5];"},{"DocComment":" let mut ptr: *const u8 = data.as_ptr();"},{"DocComment":" let step = 2;"},{"DocComment":" let end_rounded_up = ptr.wrapping_add(6);"},{"DocComment":""},{"DocComment":" let mut out = String::new();"},{"DocComment":" while ptr != end_rounded_up {"},{"DocComment":"     unsafe {"},{"DocComment":"         write!(&mut out, \"{}, \", *ptr)?;"},{"DocComment":"     }"},{"DocComment":"     ptr = ptr.wrapping_add(step);"},{"DocComment":" }"},{"DocComment":" assert_eq!(out, \"1, 3, 5, \");"},{"DocComment":" # std::fmt::Result::Ok(())"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"RawPtr":[{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"output":{"Untagged":{"RawPtr":[{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}},"src":"Normal","body":"Opaque"},null,{"def_id":51,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Trait":16}},{"Ident":["from_iter",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":4038,"col":4},"end":{"line":4038,"col":62}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"I","variance":"Contravariant"},{"index":2,"name":"Clause0_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":4038,"col":20},"end":{"line":4038,"col":42}},"generated_from_span":null}},"origin":"WhereClauseOnFn","trait_":{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_b