utlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Tuple"},"kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":1,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Ident":["Bytes",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":101,"col":0},"end":{"line":107,"col":1}},"generated_from_span":null}},"source_text":"pub struct Bytes {\n    ptr: *const u8,\n    len: usize,\n    // inlined \"trait object\"\n    data: AtomicPtr<()>,\n    vtable: &'static Vtable,\n}","attr_info":{"attributes":[{"DocComment":" A cheaply cloneable and sliceable chunk of contiguous memory."},{"DocComment":""},{"DocComment":" `Bytes` is an efficient container for storing and operating on contiguous"},{"DocComment":" slices of memory. It is intended for use primarily in networking code, but"},{"DocComment":" could have applications elsewhere as well."},{"DocComment":""},{"DocComment":" `Bytes` values facilitate zero-copy network programming by allowing multiple"},{"DocComment":" `Bytes` objects to point to the same underlying memory."},{"DocComment":""},{"DocComment":" `Bytes` does not have a single implementation. It is an interface, whose"},{"DocComment":" exact behavior is implemented through dynamic dispatch in several underlying"},{"DocComment":" implementations of `Bytes`."},{"DocComment":""},{"DocComment":" All `Bytes` implementations must fulfill the following requirements:"},{"DocComment":" - They are cheaply cloneable and thereby shareable between an unlimited amount"},{"DocComment":"   of components, for example by modifying a reference count."},{"DocComment":" - Instances can be sliced to refer to a subset of the original buffer."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut mem = Bytes::from(\"Hello world\");"},{"DocComment":" let a = mem.slice(0..5);"},{"DocComment":""},{"DocComment":" assert_eq!(a, \"Hello\");"},{"DocComment":""},{"DocComment":" let b = mem.split_to(6);"},{"DocComment":""},{"DocComment":" assert_eq!(mem, \"world\");"},{"DocComment":" assert_eq!(b, \"Hello \");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" The `Bytes` struct itself is fairly small, limited to 4 `usize` fields used"},{"DocComment":" to track information about which segment of the underlying memory the"},{"DocComment":" `Bytes` handle has access to."},{"DocComment":""},{"DocComment":" `Bytes` keeps both a pointer to the shared state containing the full memory"},{"DocComment":" slice and a pointer to the start of the region visible by the handle."},{"DocComment":" `Bytes` also tracks the length of its view into the memory."},{"DocComment":""},{"DocComment":" # Sharing"},{"DocComment":""},{"DocComment":" `Bytes` contains a vtable, which allows implementations of `Bytes` to define"},{"DocComment":" how sharing/cloning is implemented in detail."},{"DocComment":" When `Bytes::clone()` is called, `Bytes` will call the vtable function for"},{"DocComment":" cloning the backing storage in order to share it behind multiple `Bytes`"},{"DocComment":" instances."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which refer to constant memory (e.g. created"},{"DocComment":" via `Bytes::from_static()`) the cloning implementation will be a no-op."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which point to a reference counted shared storage"},{"DocComment":" (e.g. an `Arc<[u8]>`), sharing will be implemented by increasing the"},{"DocComment":" reference count."},{"DocComment":""},{"DocComment":" Due to this mechanism, multiple `Bytes` instances may point to the same"},{"DocComment":" shared memory region."},{"DocComment":" Each `Bytes` instance can point to different sections within that"},{"DocComment":" memory region, and `Bytes` instances may or may not have overlapping views"},{"DocComment":" into the memory."},{"DocComment":""},{"DocComment":" The following diagram visualizes a scenario where 2 `Bytes` instances make"},{"DocComment":" use of an `Arc`-based backing storage, and provide access to different views:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":""},{"DocComment":"    Arc ptrs                   ┌─────────┐"},{"DocComment":"    ________________________ / │ Bytes 2 │"},{"DocComment":"   /                           └─────────┘"},{"DocComment":"  /          ┌───────────┐     |         |"},{"DocComment":" |_________/ │  Bytes 1  │     |         |"},{"DocComment":" |           └───────────┘     |         |"},{"DocComment":" |           |           | ___/ data     | tail"},{"DocComment":" |      data |      tail |/              |"},{"DocComment":" v           v           v               v"},{"DocComment":" ┌─────┬─────┬───────────┬───────────────┬─────┐"},{"DocComment":" │ Arc │     │           │               │     │"},{"DocComment":" └─────┴─────┴───────────┴───────────────┴─────┘"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":