erating on contiguous"},{"DocComment":" slices of memory. It is intended for use primarily in networking code, but"},{"DocComment":" could have applications elsewhere as well."},{"DocComment":""},{"DocComment":" `Bytes` values facilitate zero-copy network programming by allowing multiple"},{"DocComment":" `Bytes` objects to point to the same underlying memory."},{"DocComment":""},{"DocComment":" `Bytes` does not have a single implementation. It is an interface, whose"},{"DocComment":" exact behavior is implemented through dynamic dispatch in several underlying"},{"DocComment":" implementations of `Bytes`."},{"DocComment":""},{"DocComment":" All `Bytes` implementations must fulfill the following requirements:"},{"DocComment":" - They are cheaply cloneable and thereby shareable between an unlimited amount"},{"DocComment":"   of components, for example by modifying a reference count."},{"DocComment":" - Instances can be sliced to refer to a subset of the original buffer."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut mem = Bytes::from(\"Hello world\");"},{"DocComment":" let a = mem.slice(0..5);"},{"DocComment":""},{"DocComment":" assert_eq!(a, \"Hello\");"},{"DocComment":""},{"DocComment":" let b = mem.split_to(6);"},{"DocComment":""},{"DocComment":" assert_eq!(mem, \"world\");"},{"DocComment":" assert_eq!(b, \"Hello \");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" The `Bytes` struct itself is fairly small, limited to 4 `usize` fields used"},{"DocComment":" to track information about which segment of the underlying memory the"},{"DocComment":" `Bytes` handle has access to."},{"DocComment":""},{"DocComment":" `Bytes` keeps both a pointer to the shared state containing the full memory"},{"DocComment":" slice and a pointer to the start of the region visible by the handle."},{"DocComment":" `Bytes` also tracks the length of its view into the memory."},{"DocComment":""},{"DocComment":" # Sharing"},{"DocComment":""},{"DocComment":" `Bytes` contains a vtable, which allows implementations of `Bytes` to define"},{"DocComment":" how sharing/cloning is implemented in detail."},{"DocComment":" When `Bytes::clone()` is called, `Bytes` will call the vtable function for"},{"DocComment":" cloning the backing storage in order to share it behind multiple `Bytes`"},{"DocComment":" instances."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which refer to constant memory (e.g. created"},{"DocComment":" via `Bytes::from_static()`) the cloning implementation will be a no-op."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which point to a reference counted shared storage"},{"DocComment":" (e.g. an `Arc<[u8]>`), sharing will be implemented by increasing the"},{"DocComment":" reference count."},{"DocComment":""},{"DocComment":" Due to this mechanism, multiple `Bytes` instances may point to the same"},{"DocComment":" shared memory region."},{"DocComment":" Each `Bytes` instance can point to different sections within that"},{"DocComment":" memory region, and `Bytes` instances may or may not have overlapping views"},{"DocComment":" into the memory."},{"DocComment":""},{"DocComment":" The following diagram visualizes a scenario where 2 `Bytes` instances make"},{"DocComment":" use of an `Arc`-based backing storage, and provide access to different views:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":""},{"DocComment":"    Arc ptrs                   ┌─────────┐"},{"DocComment":"    ________________________ / │ Bytes 2 │"},{"DocComment":"   /                           └─────────┘"},{"DocComment":"  /          ┌───────────┐     |         |"},{"DocComment":" |_________/ │  Bytes 1  │     |         |"},{"DocComment":" |           └───────────┘     |         |"},{"DocComment":" |           |           | ___/ data     | tail"},{"DocComment":" |      data |      tail |/              |"},{"DocComment":" v           v           v               v"},{"DocComment":" ┌─────┬─────┬───────────┬───────────────┬─────┐"},{"DocComment":" │ Arc │     │           │               │     │"},{"DocComment":" └─────┴─────┴───────────┴───────────────┴─────┘"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":102,"col":4},"end":{"line":102,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"ptr","is_positional":false,"ty":{"Untagged":{"RawPtr":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},"Shared"]}}},{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":103,"col":4},"end":{"line":103,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"len","is_positional":false,"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}},{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":105,"col":4},"end":{"line":105,"col":23}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"data","is_positional":false,"ty":{"Untagged":{"Adt":{"id":13,"generics":{"regions":[],"types":[{"Untagged":{"RawPtr":[{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},"Mut"]}},{"Untagged":{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Untagged":{"RawPtr":[{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}},"Mut"]}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"cons