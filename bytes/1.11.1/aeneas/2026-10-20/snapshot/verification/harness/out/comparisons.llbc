 documentation]."},{"DocComment":""},{"DocComment":" **Note:** This type is only available on platforms that support atomic loads"},{"DocComment":" and stores of `T`."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::sync::atomic"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Atomic","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"},{"index":1,"name":"Clause0_Storage","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":14,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Ident":["Vtable",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":109,"col":0},"end":{"line":109,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","40"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","8"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":16},{"guarant