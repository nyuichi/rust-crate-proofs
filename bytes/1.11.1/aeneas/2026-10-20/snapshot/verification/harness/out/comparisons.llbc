ull);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" for i in .. {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Used as a [slicing index], `RangeFull` produces the full array as a slice."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]); // This is the `RangeFull`"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeFull","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Consta