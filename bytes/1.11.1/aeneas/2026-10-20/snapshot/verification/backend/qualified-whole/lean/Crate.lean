def buf.buf_impl.sign_extend
  (val : Std.U64) (nbytes : Std.Usize) : Result Std.I64 := do
  let i ← 8#usize - nbytes
  let shift ← i * 8#usize
  let i1 ← val <<< shift
  let i2 ← lift (UScalar.hcast .I64 i1)
  i2 >>> shift

