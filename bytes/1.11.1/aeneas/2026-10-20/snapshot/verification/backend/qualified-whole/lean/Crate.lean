@[trait_default]
def buf.buf_impl.Buf.chunks_vectored.default
  {Self : Type _} (BufInst : buf.buf_impl.Buf Self) (self : Self)
  (dst : Slice core.io.io_slice.IoSlice) :
  Result (Std.Usize × (Slice core.io.io_slice.IoSlice))
  := do
  let b ← core.slice.Slice.is_empty dst
  if b
  then ok (0#usize, dst)
  else
    let b1 ← BufInst.has_remaining self
    if b1
    then
      let s ← BufInst.chunk self
      let is ← core.io.io_slice.IoSlice.new s
      let dst1 ← Slice.update dst 0#usize is
      ok (1#usize, dst1)
    else ok (0#usize, dst)

