#!/usr/bin/env python3
"""Stage AX inputs and build a repository-rooted shared capture recipe.

This performs byte copying and hash checks only. It does not build or prove.
All local composer sources are explicit files under one fresh scratch root;
published AV imports resolve relative to the actual bytes-work repository.
"""
from __future__ import annotations

import hashlib
import json
import pathlib
import shutil

WORK = pathlib.Path('/workspace/work')
STAGE = WORK / 'ax-capture-source-v1'
V1_PROFILE = WORK / 'AX_INPUT_BINDINGS.json'
V1_RECIPE = WORK / 'ax-capture-recipe.json'
OUT_PROFILE = WORK / 'AX_INPUT_BINDINGS_v2.json'
OUT_RECIPE = WORK / 'ax-capture-recipe-v2.json'
SCRIPT = pathlib.Path(__file__).resolve()

AV_MANIFEST = pathlib.Path('bytes/1.11.1/verification/evidence-closures/av-admitted-v1/manifest.json')
AV_CAS = pathlib.Path('bytes/1.11.1/verification/evidence-closures/av-admitted-v1/objects')
AV_RAW_SHA = '31d82fc5061a6112ee8031aed021c325f114001c93510ec4777d4c6acdf56288'


def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def encoded(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()


def write_exclusive(path: pathlib.Path, raw: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)


def main() -> None:
    if STAGE.exists() or OUT_PROFILE.exists() or OUT_RECIPE.exists():
        raise RuntimeError('refusing to overwrite an existing V2 capture staging artifact')
    profile_raw = V1_PROFILE.read_bytes()
    recipe_raw = V1_RECIPE.read_bytes()
    profile = json.loads(profile_raw)
    recipe = json.loads(recipe_raw)
    if profile.get('schema') != 'ax-current-input-bindings-v1':
        raise RuntimeError('unexpected V1 binding profile schema')
    if recipe.get('schema') != 'evidence-capture-recipe-v1':
        raise RuntimeError('unexpected V1 recipe schema')

    rows = [row for row in profile['bindings'] if row['resolution'] == 'local']
    local_sources = [source for source in recipe['sources'] if source['kind'] == 'local_file']
    local_mounts = [mount for mount in recipe['mounts'] if mount['source_id'] in {s['id'] for s in local_sources}]
    if len(rows) != 427 or len(local_sources) != 429 or len(local_mounts) != 429:
        raise RuntimeError('unexpected V1 local-input inventory')

    # V1 builder emits the first 427 local sources in the exact order of its
    # local binding rows; validate that relation before moving any bytes.
    for row, source in zip(rows, local_sources[:len(rows)], strict=True):
        if source['path'] != row['local_source_path']:
            raise RuntimeError('V1 source order does not match local binding rows')

    # Validate and stage the AV import under repository-relative locators.
    repository = pathlib.Path('/workspace/bytes-work')
    av_path = repository / AV_MANIFEST
    av_raw = av_path.read_bytes()
    if sha(av_raw) != AV_RAW_SHA:
        raise RuntimeError('published AV manifest raw hash changed')
    av = json.loads(av_raw)
    if len(av.get('mounts', [])) != 23:
        raise RuntimeError('published AV mount inventory changed')

    STAGE.mkdir(parents=False)
    staged_sources: list[dict] = []
    source_by_id = {source['id']: source for source in local_sources}
    for index, (row, source) in enumerate(zip(rows, local_sources[:len(rows)], strict=True)):
        src = pathlib.Path('/workspace') / source['path']
        if src.is_symlink() or not src.is_file():
            raise RuntimeError(f'local source is not a regular file: {source["path"]}')
        raw = src.read_bytes()
        if (sha(raw), len(raw)) != (row['sha256'], row['size']):
            raise RuntimeError(f'local input changed after profile generation: {row["logical_path"]}')
        target_rel = f'inputs/{source["id"]}'
        write_exclusive(STAGE / target_rel, raw)
        row['local_source_path'] = target_rel
        source['path'] = target_rel
        staged_sources.append({'source_id': source['id'], 'logical_path': row['logical_path'],
                               'path': target_rel, 'sha256': row['sha256'], 'size': row['size']})

    metadata_sources = local_sources[len(rows):]
    if [s['id'] for s in metadata_sources] != ['ax-binding-profile', 'ax-recipe-builder']:
        raise RuntimeError('unexpected V1 metadata source identities')
    profile['source_root_policy'] = 'all local_source_path values are relative to the recipe source-root'
    # The profile and its builder are ordinary recipe sources, not bindings
    # within the profile itself; this avoids a self-hash cycle.
    profile_payload = encoded(profile)
    profile_path = 'metadata/AX_INPUT_BINDINGS.json'
    builder_path = 'metadata/ax_stage_capture_recipe_v2.py'
    write_exclusive(STAGE / profile_path, profile_payload)
    builder_raw = SCRIPT.read_bytes()
    write_exclusive(STAGE / builder_path, builder_raw)
    final_profile_raw = profile_payload
    OUT_PROFILE.write_bytes(final_profile_raw)

    metadata_sources[0]['path'] = profile_path
    metadata_sources[1]['path'] = builder_path
    for mount in local_mounts:
        if mount['source_id'] == 'ax-binding-profile':
            mount['path_prefix'] = 'ax/evidence/AX_INPUT_BINDINGS.json'
        elif mount['source_id'] == 'ax-recipe-builder':
            mount['path_prefix'] = 'ax/evidence/ax_stage_capture_recipe_v2.py'

    recipe['imports'][0]['manifest_path'] = AV_MANIFEST.as_posix()
    recipe['imports'][0]['cas_root'] = AV_CAS.as_posix()
    recipe['sources'] = local_sources
    # Keep all original mount identities, roots, and typed roles, changing
    # only local object source ids' content paths via the source rows above.
    recipe_raw_v2 = encoded(recipe)
    OUT_RECIPE.write_bytes(recipe_raw_v2)

    # Verify all local recipe paths are inside and exactly equal to the staged
    # regular-file set; this is intentionally a strict no-extra-files check.
    expected = {source['path'] for source in local_sources}
    actual = {path.relative_to(STAGE).as_posix() for path in STAGE.rglob('*') if path.is_file() and not path.is_symlink()}
    if expected != actual:
        raise RuntimeError(f'staged source-root mismatch: missing={sorted(expected-actual)}, extra={sorted(actual-expected)}')
    for source in local_sources:
        target = STAGE / source['path']
        if target.is_symlink() or not target.is_file():
            raise RuntimeError(f'staged source is unsafe or missing: {source["path"]}')
    print(json.dumps({
        'status': 'staged',
        'source_root': str(STAGE),
        'source_root_file_count': len(actual),
        'local_binding_count': len(rows),
        'local_source_count': len(local_sources),
        'imported_av_mounts': len(recipe['imports'][0]['mounts']),
        'repository_root': str(repository),
        'av_manifest_sha256': AV_RAW_SHA,
        'profile_path': str(OUT_PROFILE),
        'profile_sha256': sha(final_profile_raw),
        'recipe_path': str(OUT_RECIPE),
        'recipe_sha256': sha(recipe_raw_v2),
        'staged_source_inventory_sha256': sha(encoded(staged_sources)),
    }, sort_keys=True, indent=2))


if __name__ == '__main__':
    main()
