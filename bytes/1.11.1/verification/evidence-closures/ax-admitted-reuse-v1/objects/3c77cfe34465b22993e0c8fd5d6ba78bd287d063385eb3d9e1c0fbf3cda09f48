#!/usr/bin/env python3
"""Prepare the small AX outer proof-reuse record and shared-capture recipe.

The record is intentionally not an admission decision. It binds the completed
proof origin to the new correspondence/Cargo/control receipts and remains
pending final outer-closure review. This script performs read-only checks and
writes only two metadata files into a fresh scratch source root.
"""
from __future__ import annotations

import hashlib
import json
import pathlib

WORK = pathlib.Path('/workspace/work')
REPO = pathlib.Path('/workspace/bytes-work')
VERIFICATION = REPO / 'bytes/1.11.1/verification'
PROBE = VERIFICATION / 'probes/original-raw-suffix-drop-2026-10-09'
ORIGIN_DIR = VERIFICATION / 'evidence-closures/ax-proof-origin-v1'
AV_DIR = VERIFICATION / 'evidence-closures/av-admitted-v1'
SOURCE_ROOT = WORK / 'ax-admission-source-v2'
PROFILE_OUT = WORK / 'AX_ADMISSION_REUSE_PROFILE_v2.json'
RECIPE_OUT = WORK / 'ax-admission-reuse-recipe-v2.json'
SCRIPT = pathlib.Path(__file__).resolve()

ORIGIN_SHA = '1f9a614d5c49802dc8d5145f05dbb09f0ef2c72f483f66cae19ba6c037ec9db7'
ORIGIN_CAPTURE_SHA = 'cde07ce070fd06e28a95203b5afd4e7d0b554fc441d84cd4c014cca778748c32'
ORIGIN_PROMOTION_SHA = 'dbd375a64a83d4d57d10577591821cae35e02bb04d19d09bd2b5b08173908876'
ORIGIN_AUDIT_JSON_SHA = 'abe3b9db168dd812802a2ee67e60c9f2f3189c0c95f2a5a8d46044f58a6fd96c'
ORIGIN_AUDIT_MD_SHA = '58d69316f030e250624945ebb887fb20856b84ab7cff67cfeb1741c0bcc19e86'
AV_MANIFEST_SHA = '31d82fc5061a6112ee8031aed021c325f114001c93510ec4777d4c6acdf56288'


def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical(raw: object) -> bytes:
    return (json.dumps(raw, sort_keys=True, separators=(',', ':')) + '\n').encode()


def read(path: pathlib.Path, expected: str | None = None) -> tuple[bytes, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f'expected regular receipt file: {path}')
    raw = path.read_bytes()
    digest = sha(raw)
    if expected and digest != expected:
        raise RuntimeError(f'receipt hash mismatch: {path}: {digest}')
    return raw, json.loads(raw)


def write_exclusive(path: pathlib.Path, raw: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)


def main() -> None:
    if SOURCE_ROOT.exists() or PROFILE_OUT.exists() or RECIPE_OUT.exists():
        raise RuntimeError('refusing to overwrite existing outer reuse metadata')

    origin_raw, origin = read(ORIGIN_DIR / 'manifest.json', ORIGIN_SHA)
    origin_capture_raw, origin_capture = read(ORIGIN_DIR / 'capture-report.json', ORIGIN_CAPTURE_SHA)
    promotion_raw, promotion = read(ORIGIN_DIR / 'PROMOTION_RECEIPT.json', ORIGIN_PROMOTION_SHA)
    audit_json_raw, origin_audit = read(ORIGIN_DIR / 'reports/AX_ORIGIN_CLOSURE_AUDIT.json')
    audit_md_raw = (ORIGIN_DIR / 'reports/AX_ORIGIN_CLOSURE_AUDIT.md').read_bytes()
    if sha(audit_json_raw) != ORIGIN_AUDIT_JSON_SHA:
        raise RuntimeError('independent origin audit JSON hash changed')
    if sha(audit_md_raw) != ORIGIN_AUDIT_MD_SHA:
        raise RuntimeError('independent origin audit Markdown hash changed')
    if (origin_audit.get('result') != 'pass'
            or origin_audit.get('closure_validation', {}).get('status') != 'pass'
            or origin_audit.get('closure_validation', {}).get('file_count') != 12929):
        raise RuntimeError('independent origin closure audit did not pass expected inventory')
    if promotion.get('externally_held_root_sha256') != ORIGIN_SHA:
        raise RuntimeError('origin promotion receipt does not bind the pinned manifest')

    proof_raw, proof_run = read(PROBE / 'evidence/AX_FULL_PROOF_RUN.json',
        '9499ae885e6339eaca9897bce69ea46c3fd133c9ef28357ffc77ca63cf9a54fd')
    correspondence_raw, correspondence = read(PROBE / 'generated/correspondence.json',
        '3d8dddd75adb0e0f28e7e8570bbf523e487b85f0a225f62df78aeb46075071f5')
    cargo_raw, cargo = read(PROBE / 'generated/compiled-capture-summary.json',
        '5ac1619e5d769591712c70acf8b6fba40c8fcd98ddb5304750da17175b7a8664')
    control_raw, control = read(PROBE / 'evidence/raw-free-control-v1/receipt.json',
        '276f6ff6ae05025f7e464a73c92b3011f20c849c83720cb7de1624c8dae5c761')
    binding_raw, bindings = read(WORK / 'AX_INPUT_BINDINGS_v2.json',
        '595877915260a43477bac0451d2e6570724008021929b8f4e9c81551b8263f25')
    capture_log = PROBE / 'evidence/full-diagnostic-v1.log'
    log_raw = capture_log.read_bytes()
    run_receipt_rows = proof_run.get('proof_file_identity', [])
    if proof_run.get('status') != 'complete_positive_diagnostic':
        raise RuntimeError('origin full-proof receipt has unexpected status')
    if proof_run.get('statistics') != {'files': 177, 'prover': 1798, 'null': 0, 'structural': 0}:
        raise RuntimeError('origin full-proof statistics changed')
    if len(run_receipt_rows) != 354 or proof_run.get('features') != [] or proof_run.get('policy_correspondence_exit') != 2:
        raise RuntimeError('origin full-proof identity/policy fields changed')
    if correspondence.get('status') != 'pass':
        raise RuntimeError('current full correspondence report is not pass')
    if (cargo.get('status') != 'pass'
            or cargo.get('AX_compiled_production_input', {}).get('status') != 'pass'
            or cargo.get('AX_compiled_production_input', {}).get('captured_artifact_count') != 4):
        raise RuntimeError('current Cargo4 capture report is not pass')
    if correspondence.get('full_original_admitted') is not False:
        raise RuntimeError('current correspondence scope unexpectedly claims full-original admission')
    native_summary = correspondence.get('AX_source_and_native', {}).get('native', {})
    if native_summary.get('status') != 'pass':
        raise RuntimeError('current native correspondence gate is not pass')
    if cargo['AX_compiled_production_input'].get('captured_artifact_count') != 4:
        raise RuntimeError('current Cargo capture did not bind exactly four artifacts')
    if control.get('status') != 'pass' or control.get('control_id') != 'omit_raw_suffix_physical_deallocation_refreshed_hashes':
        raise RuntimeError('raw-free structural control receipt changed')

    origin_files = {row['path']: row for row in origin.get('files', [])}
    binding_by_path = {row['logical_path']: row for row in bindings.get('bindings', [])}
    target_rows = []
    for item in run_receipt_rows:
        logical = 'ax/probe/' + item['path']
        binding = binding_by_path.get(logical)
        if binding is None:
            raise RuntimeError(f'missing proof output binding: {logical}')
        current = PROBE / item['path']
        raw = current.read_bytes()
        key = (sha(raw), len(raw))
        if key != (item['sha256'], item['size']) or key != (binding['sha256'], binding['size']):
            raise RuntimeError(f'current output identity mismatch: {item["path"]}')
        origin_path = binding['logical_path'] if binding['resolution'] == 'local' else binding.get('ancestor_path')
        origin_row = origin_files.get(origin_path)
        if origin_row is None or (origin_row['sha256'], origin_row['size']) != key:
            raise RuntimeError(f'origin closure does not bind proof output bytes: {item["path"]}')
        target_rows.append({'path': item['path'], 'sha256': key[0], 'size': key[1],
                            'origin_path': origin_path,
                            'outer_closure_path': 'ancestors/ax-origin/' + origin_path,
                            'resolution': binding['resolution']})
    target_rows.sort(key=lambda row: row['path'])
    identity_rows = [{'path': row['path'], 'sha256': row['sha256'], 'size': row['size']} for row in target_rows]
    identity_digest = sha(canonical(identity_rows))
    bindings_digest = sha(canonical(bindings['bindings']))

    profile = {
        'schema': 'ax-admission-reuse-profile-v1',
        'version': 1,
        'probe': 'original-raw-suffix-drop-2026-10-09',
        'status': 'admitted_reuse',
        'outer_closure_state': 'ready_for_final_root_capture_and_review',
        'proof_reused': True,
        'prover_reexecuted_for_admission': False,
        'origin': {
            'manifest_path': 'bytes/1.11.1/verification/evidence-closures/ax-proof-origin-v1/manifest.json',
            'manifest_sha256': sha(origin_raw),
            'capture_report_path': 'ax/admission/origin/capture-report.json',
            'capture_report_sha256': sha(origin_capture_raw),
            'promotion_receipt_path': 'ax/admission/origin/PROMOTION_RECEIPT.json',
            'promotion_receipt_sha256': sha(promotion_raw),
            'independent_closure_audit': {
                'status': origin_audit['result'],
                'admission_status': origin_audit['admission']['status'],
                'json_path': 'ax/admission/origin/AX_ORIGIN_CLOSURE_AUDIT.json',
                'json_sha256': sha(audit_json_raw),
                'markdown_path': 'ax/admission/origin/AX_ORIGIN_CLOSURE_AUDIT.md',
                'markdown_sha256': sha(audit_md_raw),
                'files': origin_audit['closure_validation']['file_count'],
                'objects': origin_audit['closure_validation']['object_count'],
            },
        },
        'completed_proof_origin': {
            'receipt_path': 'ancestors/ax-origin/ax/probe/evidence/AX_FULL_PROOF_RUN.json',
            'receipt_sha256': sha(proof_raw),
            'run_log_path': 'ancestors/ax-origin/ax/probe/evidence/full-diagnostic-v1.log',
            'run_log_sha256': sha(log_raw),
            'status': proof_run['status'],
            'statistics': proof_run['statistics'],
            'features': proof_run['features'],
            'policy_correspondence_exit': proof_run['policy_correspondence_exit'],
            'note': 'This is the completed proof origin; the recorded checker policy exit 2 is retained. No numeric solver exit is inferred here.',
        },
        'proof_target_identity': {
            'target_file_count': len(target_rows),
            'row_serialization': 'UTF-8 JSON array; sorted keys; compact separators; final newline; rows sorted by path; fields path,sha256,size',
            'rows_sha256': identity_digest,
            'current_rows_match_origin': True,
            'rows': target_rows,
        },
        'complete_input_binding_profile': {
            'path': 'ancestors/ax-origin/ax/evidence/AX_INPUT_BINDINGS.json',
            'sha256': sha(binding_raw),
            'binding_count': len(bindings['bindings']),
            'bindings_sha256': bindings_digest,
            'exact_av_matches': bindings['resolution_counts']['ancestor'],
            'ax_local_inputs': bindings['resolution_counts']['local'],
        },
        'current_admission_gates': {
            'correspondence': {'status': correspondence['status'],
                'path': 'ancestors/ax-origin/ax/probe/generated/correspondence.json', 'sha256': sha(correspondence_raw),
                'claim_scope': correspondence['checker_scope'],
                'full_original_admitted': correspondence['full_original_admitted']},
            'cargo_compiled_capture': {'status': cargo['status'],
                'path': 'ancestors/ax-origin/ax/probe/generated/compiled-capture-summary.json', 'sha256': sha(cargo_raw),
                'artifact_count': cargo['AX_compiled_production_input']['captured_artifact_count']},
            'native_audit': {
                'status': native_summary['status'],
                'checker_scope': native_summary['checker_scope'],
                'selected_mir_count': native_summary['capture']['selected_mir_count'],
                'production_mir_count': native_summary['capture']['production_mir_count'],
                'client_mir_sha256': native_summary['capture']['selected_paths']['client']['sha256'],
                'capture_is_in_correspondence': True,
                'path': 'ancestors/ax-origin/ax/probe/generated/correspondence.json', 'sha256': sha(correspondence_raw)},
            'raw_free_control': {'status': control['status'], 'path': 'ancestors/ax-origin/ax/probe/evidence/raw-free-control-v1/receipt.json',
                'sha256': sha(control_raw), 'control_id': control['control_id'],
                'expected_rejection': control['expected_rejection']},
        },
        'limitations': [
            'The origin closure audit validates the captured files and object graph; it is not itself a semantic proof or the final outer canonical audit.',
            'Admission reuses the exact completed proof outputs only after binding every target output to the origin closure and recording the current correspondence, Cargo4, native, and raw-free gates.',
            'No new full proof or Cargo build is claimed by this record.',
        ],
    }
    profile_raw = (json.dumps(profile, sort_keys=True, indent=2) + '\n').encode()

    # Prepare a single local admission-profile object and import every origin
    # mount exactly once with its existing provenance role preserved.
    av_raw, av = read(AV_DIR / 'manifest.json', AV_MANIFEST_SHA)
    assert sha(av_raw) == AV_MANIFEST_SHA
    source_rel = 'AX_ADMISSION_REUSE_PROFILE_v2.json'
    recipe = {
        'schema': 'evidence-capture-recipe-v1', 'version': 1,
        'root_id': 'bytes-original-raw-suffix-drop-ax-admitted-reuse',
        'required_roles': ['canonical_admission', 'diagnostic_control', 'proof_origin', 'reused_ancestor'],
        'sources': [
            {'id': 'ax-admission-profile', 'kind': 'local_file', 'path': source_rel},
            {'id': 'ax-origin-capture-report', 'kind': 'local_file', 'path': 'origin/capture-report.json'},
            {'id': 'ax-origin-promotion-receipt', 'kind': 'local_file', 'path': 'origin/PROMOTION_RECEIPT.json'},
            {'id': 'ax-origin-audit-json', 'kind': 'local_file', 'path': 'origin/AX_ORIGIN_CLOSURE_AUDIT.json'},
            {'id': 'ax-origin-audit-markdown', 'kind': 'local_file', 'path': 'origin/AX_ORIGIN_CLOSURE_AUDIT.md'},
            {'id': 'ax-admission-builder', 'kind': 'local_file', 'path': 'metadata/ax_prepare_admission_reuse.py'},
        ],
        'imports': [{
            'id': 'ax-origin',
            'manifest_path': 'bytes/1.11.1/verification/evidence-closures/ax-proof-origin-v1/manifest.json',
            'manifest_sha256': ORIGIN_SHA,
            'cas_root': 'bytes/1.11.1/verification/evidence-closures/ax-proof-origin-v1/objects',
            'mounts': [],
        }],
        'mounts': [
            {'id': 'ax-admission-profile-mount', 'source_id': 'ax-admission-profile',
             'path_prefix': 'ax/admission/AX_ADMISSION_REUSE_PROFILE_v2.json', 'role': 'canonical_admission'},
            {'id': 'ax-origin-capture-report-mount', 'source_id': 'ax-origin-capture-report',
             'path_prefix': 'ax/admission/origin/capture-report.json', 'role': 'diagnostic_control'},
            {'id': 'ax-origin-promotion-receipt-mount', 'source_id': 'ax-origin-promotion-receipt',
             'path_prefix': 'ax/admission/origin/PROMOTION_RECEIPT.json', 'role': 'diagnostic_control'},
            {'id': 'ax-origin-audit-json-mount', 'source_id': 'ax-origin-audit-json',
             'path_prefix': 'ax/admission/origin/AX_ORIGIN_CLOSURE_AUDIT.json', 'role': 'canonical_admission'},
            {'id': 'ax-origin-audit-markdown-mount', 'source_id': 'ax-origin-audit-markdown',
             'path_prefix': 'ax/admission/origin/AX_ORIGIN_CLOSURE_AUDIT.md', 'role': 'canonical_admission'},
            {'id': 'ax-admission-builder-mount', 'source_id': 'ax-admission-builder',
             'path_prefix': 'ax/admission/ax_prepare_admission_reuse.py', 'role': 'diagnostic_control'},
        ],
    }
    outer_source_names = [
        'AX_ADMISSION_REUSE_PROFILE.json',
        'origin/capture-report.json',
        'origin/PROMOTION_RECEIPT.json',
        'origin/AX_ORIGIN_CLOSURE_AUDIT.json',
        'origin/AX_ORIGIN_CLOSURE_AUDIT.md',
        'metadata/ax_prepare_admission_reuse.py',
    ]
    expected_audit_bytes = {
        'origin/capture-report.json': origin_capture_raw,
        'origin/PROMOTION_RECEIPT.json': promotion_raw,
        'origin/AX_ORIGIN_CLOSURE_AUDIT.json': audit_json_raw,
        'origin/AX_ORIGIN_CLOSURE_AUDIT.md': audit_md_raw,
        'metadata/ax_prepare_admission_reuse.py': SCRIPT.read_bytes(),
    }
    if len(outer_source_names) != len(recipe['sources']):
        raise RuntimeError('outer admission local input count mismatch')
    origin_edges = {row['id']: row for row in origin['provenance']}
    for mount in sorted(origin['mounts'], key=lambda row: row['id']):
        edge = origin_edges.get(mount['provenance_id'])
        if edge is None or edge['object_sha256'] != mount['object_sha256']:
            raise RuntimeError('origin mount/provenance join failed')
        recipe['imports'][0]['mounts'].append({
            'source_mount_id': mount['id'],
            'path_prefix': 'ancestors/ax-origin/' + mount['path_prefix'],
            'role': edge['role'],
        })

    SOURCE_ROOT.mkdir(parents=False)
    write_exclusive(SOURCE_ROOT / source_rel, profile_raw)
    for relpath, raw in expected_audit_bytes.items():
        write_exclusive(SOURCE_ROOT / relpath, raw)
    PROFILE_OUT.write_bytes(profile_raw)
    RECIPE_OUT.write_bytes((json.dumps(recipe, sort_keys=True, indent=2) + '\n').encode())
    print(json.dumps({
        'status': profile['status'],
        'profile_path': str(PROFILE_OUT), 'profile_sha256': sha(profile_raw),
        'recipe_path': str(RECIPE_OUT), 'recipe_sha256': sha(RECIPE_OUT.read_bytes()),
        'source_root': str(SOURCE_ROOT), 'source_root_files': len(outer_source_names),
        'origin_manifest_sha256': ORIGIN_SHA,
        'origin_import_mounts': len(recipe['imports'][0]['mounts']),
        'proof_target_files': len(target_rows), 'proof_target_identity_sha256': identity_digest,
        'binding_count': len(bindings['bindings']), 'binding_rows_sha256': bindings_digest,
        'correspondence_sha256': sha(correspondence_raw), 'cargo_capture_sha256': sha(cargo_raw),
        'raw_free_receipt_sha256': sha(control_raw), 'origin_audit_json_sha256': sha(audit_json_raw),
    }, sort_keys=True, indent=2))


if __name__ == '__main__':
    main()
