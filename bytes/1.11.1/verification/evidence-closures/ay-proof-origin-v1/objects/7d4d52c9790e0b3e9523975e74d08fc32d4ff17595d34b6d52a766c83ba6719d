#!/usr/bin/env python3
"""Declare the exact AY current-input inventory for shared direct-CAS capture."""
import hashlib,json,re
from pathlib import Path

REPO=Path('/workspace/bytes-work');VERIFY=REPO/'bytes/1.11.1/verification';ROOT=VERIFY/'probes/original-root-phase-view-2026-10-09';OUT=Path('/workspace/work/AY_REQUIRED_INPUTS_v1.json')
rows={}
def sha(raw):return hashlib.sha256(raw).hexdigest()
def add(destination,path,category,expected=None,size=None):
 assert path.is_file() and not path.is_symlink(),str(path)
 raw=path.read_bytes();h=sha(raw)
 if expected:assert h==expected,str(path)
 if size is not None:assert len(raw)==size,str(path)
 row=dict(destination=destination,source=str(path.resolve()),sha256=h,size=len(raw),category=category)
 if destination in rows:assert all(rows[destination][k]==row[k] for k in ('destination','source','sha256','size')),(destination,'conflicting required slot')
 else:rows[destination]=row
 return raw

def probe(relative,category='current_input',expected=None,size=None):return add('ay/probe/'+relative,ROOT/relative,category,expected,size)

full_raw=probe('evidence/AY_FULL_PROOF_RUN.json','proof_origin','c10232a3db94caa520eeabf25b9be1387c71fb1e41cd17cab5aecf27d09b3dc4');full=json.loads(full_raw)
assert full['statistics']==dict(files=186,prover=1955,null=0,structural=0) and len(full['proof_file_identity'])==372 and len(full['probe_input_identity'])==36
probe('evidence/full-diagnostic-v1.log','proof_origin',full['log_sha256'])
for row in full['proof_file_identity']:probe(row['path'],'proof_output',row['sha256'],row['size'])
for row in full['probe_input_identity']:probe(row['path'],'current_input',row['sha256'],row['size'])
# Immutable full-origin snapshot is an explicit union derived from its receipt.
snapshot='evidence/full-origin-inputs-v1/'
for row in full['proof_file_identity']:probe(snapshot+'proofs/'+row['path'],'proof_origin',row['sha256'],row['size'])
for row in full['probe_input_identity']:probe(snapshot+'inputs/'+row['path'],'proof_origin',row['sha256'],row['size'])
for row in full['external_input_identity']:probe(snapshot+row['snapshot_path'],'proof_origin',row['sha256'],row['size'])
for row in full['snapshot_support_identity']:probe(snapshot+row['path'],'proof_origin',row['sha256'],row['size'])
probe(snapshot+'receipt.json','proof_origin',sha(full_raw));probe(snapshot+'run.log','proof_origin',full['log_sha256'])
# Selected diagnostic evidence is declared from each immutable receipt.
for label in ('new-bodies-diagnostic-v1b','affected-bodies-diagnostic-v2'):
 prefix='evidence/'+label+'/'
 receipt_raw=probe(prefix+'receipt.json','diagnostic_control');receipt=json.loads(receipt_raw)
 for row in receipt['members']:probe(prefix+'inputs/'+row['path'],'diagnostic_control',row['sha256'],row['size'])
 probe(prefix+'run.log','diagnostic_control',receipt['log_sha256'])
# Current metadata and compiler-produced public declaration snapshots.
for name in ('AY_SCAFFOLD.json','AY_REVIEWED_SOURCE.json','check_correspondence.py','check_native.py','prepare_capture.py','native.rs','capture-native.sh','native-field-profile.rs','native-field-profile.log','reviewed-production-inputs.json','TASK_PRINTING.md','print_proof_task.ml'):
 probe(name)
for name in ('compiled-capture-summary.json','correspondence.json','mapping.json','proof-targets.json','public_records.rs','public_traits.rs','source-map.json','native_bindings.rs','native_view_bindings.rs','native_cursor_bindings.rs'):
 destination='ay/probe/generated/'+name
 if destination not in rows:probe('generated/'+name)
for name in ('public_records.rs','cargo-run-build-fingerprint.json','cargo-build-output.txt','cargo-root-output.txt','public-records-build-receipt.json'):probe('generated/compiled-inputs/'+name)
# Closed native namespace: 31 selected MIR and three captured version/receipt files.
capture_raw=probe('native-mir/capture.json');capture=json.loads(capture_raw);assert len(capture['selected'])==31
for row in capture['selected']:probe(row['path'],'current_input',row['sha256'])
for name in ('rustc-version.txt','cargo-version.txt'):probe('native-mir/'+name)
for name in ('Cargo.toml','Cargo.lock','native-run.log','tests/root_phase_witness.rs'):probe('native-test/'+name)
# ONE new control's complete frozen declared namespace, without scanning caches.
control='evidence/peer-drop-control-v1/'
probe(control+'receipt.json','diagnostic_control','4dc3c34b957f20e398d10a3a521ad343a87b6c020881cd3e994dc53a050322db')
files_raw=probe(control+'FILES.json','diagnostic_control');files=json.loads(files_raw)
for row in (files if isinstance(files,list) else files['files']):
 relative=row['path'];probe(control+relative,'diagnostic_control',row['sha256'],row.get('size'))
# All current native production/Std/config identities are required separately.
review=json.loads((ROOT/'reviewed-production-inputs.json').read_bytes())
production=REPO/'bytes/1.11.1'
for relative,expected in review['files'].items():add('ay/repository/bytes/1.11.1/'+relative,production/relative,'production_input',expected)
if (production/'Cargo.toml.orig').is_file():add('ay/repository/bytes/1.11.1/Cargo.toml.orig',production/'Cargo.toml.orig','production_input')
for row in full['external_input_identity']:add('ay/'+row['snapshot_path'],Path(row['path']),'environment_input',row['sha256'],row['size'])
# Resolve actual local #[path] source imports used by the unchanged crate route.
seen=set()
def source_imports(path):
 path=path.resolve()
 if path in seen:return
 seen.add(path)
 assert path.is_relative_to(REPO)
 add('ay/repository/'+path.relative_to(REPO).as_posix(),path,'module_source')
 text=path.read_text()
 for literal in re.findall(r'#\[path\s*=\s*"([^"]+)"\]\s*(?:pub\s+)?mod\s+\w+\s*;',text):source_imports(path.parent/literal)
for path in sorted((ROOT/'src').glob('*.rs')):source_imports(path)
# Shared producer/validator and recorded decision identities are first-class slots.
for relative in ('tools/evidence_capture.py','tools/evidence_closure.py','tools/test_evidence_capture.py','tools/test_evidence_closure.py','ARCHITECTURE_DECISIONS.md','ARCHITECTURE_ASSESSMENT.md'):
 add('ay/verification/'+relative,VERIFY/relative,'capture_metadata')
for name,path in [('ay_derive_capture_inventory.py',Path(__file__)),('ay_capture_full.py',Path('/workspace/work/ay_capture_full.py')),('ay_capture_selected.py',Path('/workspace/work/ay_capture_selected.py')),('ay_capture_selected_focused.py',Path('/workspace/work/ay_capture_selected_focused.py'))]:
 add('ay/evidence/producers/'+name,path,'capture_metadata')
assert not OUT.exists()
report=dict(schema='ay-required-input-inventory-v1',version=1,probe=ROOT.name,full_proof_origin_receipt_sha256=sha(full_raw),current_correspondence_sha256=sha((ROOT/'generated/correspondence.json').read_bytes()),fresh_Cargo4_sha256=sha((ROOT/'generated/compiled-capture-summary.json').read_bytes()),peer_control_receipt_sha256='4dc3c34b957f20e398d10a3a521ad343a87b6c020881cd3e994dc53a050322db',external_binaries=full['external_tool_binaries'],entries=[rows[p] for p in sorted(rows)],full_original_admitted=False)
OUT.write_text(json.dumps(report,sort_keys=True,indent=2)+'\n')
print(json.dumps(dict(inventory=str(OUT),inventory_sha256=sha(OUT.read_bytes()),required_slots=len(rows),proof_statistics=full['statistics'],external_binaries=len(full['external_tool_binaries'])),indent=2))
