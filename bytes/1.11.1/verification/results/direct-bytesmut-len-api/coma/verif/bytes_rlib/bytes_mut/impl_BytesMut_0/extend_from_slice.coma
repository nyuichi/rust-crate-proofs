use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Ptr
use creusot.prelude.Opaque
use creusot.int.Int64
use creusot.prelude.MutBorrow
use map.Map
use map.Const
use creusot.prelude.Any
use int.Int

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_NonNull_u8

function view_NonNull_u8 (self: t_NonNull_u8) : Opaque.ptr

function addr_NonNull_u8 [@inline:trivial] (self: t_NonNull_u8) : UInt64.t =
  [%#snonnull'0] Ptr.addr_logic_u64 (view_NonNull_u8 self)

meta "rewrite_def" function addr_NonNull_u8

predicate is_null_NonNull_u8 (self: t_NonNull_u8) = [%#sptr'17] addr_NonNull_u8 self = (0: UInt64.t)

predicate invariant_NonNull_u8 (self: t_NonNull_u8) = [%#snonnull] not is_null_NonNull_u8 self

predicate inv_NonNull_u8 (_1: t_NonNull_u8)

axiom inv_axiom: forall x: t_NonNull_u8 [inv_NonNull_u8 x]. inv_NonNull_u8 x -> invariant_NonNull_u8 x

type t_BoundPtr

type t_RawAllocation

type t_Recovery

type t_PhysicalRegion

type tup2_Recovery_PhysicalRegion = { f0: t_Recovery; f1: t_PhysicalRegion }

type t_OriginalUniqueProof = {
  base: t_BoundPtr;
  cursor: t_BoundPtr;
  raw: t_RawAllocation;
  capabilities: tup2_Recovery_PhysicalRegion }

type t_Option_OriginalUniqueProof = None | Some t_OriginalUniqueProof

type t_SharedOwnerPacket__private

type t_EventBoundInvariant_SharedPayload

type t_OwnerTicket

type t_SharedOwnerPacket = {
  capsule'0: t_EventBoundInvariant_SharedPayload;
  ticket'0: t_OwnerTicket;
  region'0: t_PhysicalRegion;
  base'0: t_BoundPtr;
  cursor'0: t_BoundPtr;
  t_SharedOwnerPacket__private'0: t_SharedOwnerPacket__private }

type t_Option_SharedOwnerPacket = None'0 | Some'0 t_SharedOwnerPacket

type t_BytesMut = {
  ptr: t_NonNull_u8;
  len: UInt64.t;
  cap: UInt64.t;
  data: Opaque.ptr;
