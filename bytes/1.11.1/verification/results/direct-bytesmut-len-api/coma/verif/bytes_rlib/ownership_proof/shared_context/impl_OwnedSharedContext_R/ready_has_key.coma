(* ownership_proof::shared_context::OwnedSharedContext<'ctx, R> *)

type namespace_other

type t_Namespace = Other namespace_other

let%span sready_registry = "/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/ready_registry.rs" 190 14 190 46
let%span sshared_context = "/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/shared_context.rs" 59 14 59 61

type t_Tokens

type t_ReadyRegistry_R

type t_OwnedSharedContext_R = { tokens: t_Tokens; ready: t_ReadyRegistry_R; _not_objective: () }

type t_ReadyKey

predicate contains_key_R [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/ready_registry.rs" 174 4 174 48] (self: t_ReadyRegistry_R) (key: t_ReadyKey)

predicate has_key_R [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/ready_registry.rs" 191 4 191 54] (self: t_ReadyRegistry_R) (key: t_ReadyKey)

axiom has_key_R_spec:
  forall self: t_ReadyRegistry_R, key: t_ReadyKey [has_key_R self key]. [%#sready_registry] has_key_R self key
    = contains_key_R self key

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_OwnedSharedContext_R

constant key : t_ReadyKey

predicate ready_has_key_R [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/shared_context.rs" 60 4 60 60] (self: t_OwnedSharedContext_R) (key: t_ReadyKey)

goal vc_ready_has_key_R: ([@stop_split] [@expl:has_key ensures] [%#sready_registry] has_key_R self.ready key
    = contains_key_R self.ready key)
  -> ([@stop_split] [@expl:ready_has_key ensures] [%#sshared_context] has_key_R self.ready key
  = has_key_R self.ready key)
