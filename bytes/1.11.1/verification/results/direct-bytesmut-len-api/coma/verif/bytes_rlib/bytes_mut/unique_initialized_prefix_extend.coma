        )}
      s1
    | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & prestate: t_BytesMut = prestate
  | & old_len: UInt64.t = old_len
  | & new_len: UInt64.t = new_len ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:unique_initialized_prefix_extend ensures] [%#sbytes_mut'4] forall i: int. 0 <= i
        /\ i < UInt64.t'int new_len -> slot_known (unique_slot prestate i)}
    (! return {result}) ]
