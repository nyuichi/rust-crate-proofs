  /\ ([@stop_split] [@expl:unique_initialized_prefix_suffix requires #3] [%#sbytes_mut'5] UInt64.t'int count
  <= unique_length prestate)}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] [%#sbytes_mut] forall i: int. 0 <= i
          /\ i
          < (if UInt64.t'int count <= unique_length prestate then unique_length prestate - UInt64.t'int count else 0)
        -> 0 <= UInt64.t'int count + i /\ UInt64.t'int count + i < unique_length prestate}
      s1
    | s1 = {[@expl:assertion] [%#sbytes_mut'0] forall i: int. 0 <= i
          /\ i
          < (if UInt64.t'int count <= unique_length prestate then unique_length prestate - UInt64.t'int count else 0)
        -> slot_known (unique_slot prestate (UInt64.t'int count + i))}
      s2
    | s2 = {[@expl:assertion] [%#sbytes_mut'1] forall i: int. 0 <= i /\ i < unique_offset prestate + UInt64.t'int count
        -> (if i < unique_offset prestate then
          slot_known (unique_allocation_slot prestate i)
        else
          slot_known (unique_slot prestate (i - unique_offset prestate))
        )}
      s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l () | & prestate: t_BytesMut = prestate | & count: UInt64.t = count ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:unique_initialized_prefix_suffix ensures] ([@stop_split] [@expl:unique_initialized_prefix_suffix ensures #0] [%#sbytes_mut'6] forall i: int. 0
            <= i
          /\ i
          < (if UInt64.t'int count <= unique_length prestate then unique_length prestate - UInt64.t'int count else 0)
        -> slot_known (unique_slot prestate (UInt64.t'int count + i)))
    /\ ([@stop_split] [@expl:unique_initialized_prefix_suffix ensures #1] [%#sbytes_mut'7] forall i: int. 0 <= i
        /\ i < unique_offset prestate + UInt64.t'int count -> slot_known (unique_allocation_slot prestate i))}
    (! return {result}) ]
