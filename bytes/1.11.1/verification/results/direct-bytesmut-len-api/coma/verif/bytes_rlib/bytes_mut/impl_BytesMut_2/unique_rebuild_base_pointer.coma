    | s10 = {[@expl:assertion] [%#sbytes_mut'7] offset_ptr_u8'0 ptr (Int64.to_int delta) = raw_pointer proof.base} s11
    | s11 = [ &_ret <- result ] s12
    | s12 = return {_ret} ] ]
  [ & _ret: Opaque.ptr = Any.any_l ()
  | & proof: t_OriginalUniqueProof = proof
  | & ptr: Opaque.ptr = ptr
  | & off: UInt64.t = off
  | & delta: Int64.t = Any.any_l ()
  | & _33: Int64.t = Any.any_l ()
  | & result: Opaque.ptr = Any.any_l () ])
  [ return (result: Opaque.ptr) -> {[@stop_split] [@expl:unique_rebuild_base_pointer ensures] [%#sbytes_mut'18] result
    = raw_pointer'0 proof.raw}
    (! return {result}) ]
