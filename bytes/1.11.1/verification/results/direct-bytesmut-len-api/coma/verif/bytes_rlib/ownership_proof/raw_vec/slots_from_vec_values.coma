function slots_from_vec [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/raw_vec.rs" 53 0 53 62] (contents: Seq.seq UInt8.t) (capacity: int) : t_FMap_Int_Excl_Option_u8

axiom slots_from_vec_def:
  forall contents: Seq.seq UInt8.t, capacity: int [slots_from_vec contents capacity]. ([%#sraw_vec'3] 0 <= capacity)
    -> slots_from_vec contents capacity
    = ([%#sraw_vec'6] if capacity = 0 then
