                                                                                     else
                                                                                       None
                                                                                     ) }
    )

axiom slots_from_vec_spec:
  forall contents: Seq.seq UInt8.t, capacity: int [slots_from_vec contents capacity]. ([%#sraw_vec'3] 0 <= capacity)
