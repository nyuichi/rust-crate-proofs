  {[@stop_split] [@expl:advance_cursor ensures] ([@stop_split] [@expl:advance_cursor result type invariant] [%#sshared_capsule'3] inv_SharedOwnerPacket result)
    /\ ([@stop_split] [@expl:advance_cursor ensures #0] [%#sshared_capsule'4] invariant_SharedOwnerPacket result)
    /\ ([@stop_split] [@expl:advance_cursor ensures #1] [%#sshared_capsule'5] result.capsule = self.capsule)
    /\ ([@stop_split] [@expl:advance_cursor ensures #2] [%#sshared_capsule'6] capsule_public result
      = capsule_public self)
    /\ ([@stop_split] [@expl:advance_cursor ensures #3] [%#sshared_capsule'7] result.ticket = self.ticket)
    /\ ([@stop_split] [@expl:advance_cursor ensures #4] [%#sshared_capsule'8] result.region = self.region)
    /\ ([@stop_split] [@expl:advance_cursor ensures #5] [%#sshared_capsule'9] forall i: int. 0 <= i
          /\ i < capacity self.region -> allocation_slot result i = allocation_slot self i)
    /\ ([@stop_split] [@expl:advance_cursor ensures #6] [%#sshared_capsule'10] result.base = self.base)
    /\ ([@stop_split] [@expl:advance_cursor ensures #7] [%#sshared_capsule'11] view_BoundPtr result.cursor
      = Some { f0 = (unwrap_Option_tup3_Id_Int_Int (view_BoundPtr self.cursor)).f0;
               f1 = (unwrap_Option_tup3_Id_Int_Int (view_BoundPtr self.cursor)).f1;
               f2 = (unwrap_Option_tup3_Id_Int_Int (view_BoundPtr self.cursor)).f2 + UInt64.t'int count })
    /\ ([@stop_split] [@expl:advance_cursor ensures #8] [%#sshared_capsule'12] current_address result.cursor
      = current_address self.cursor + UInt64.t'int count)
    /\ ([@stop_split] [@expl:advance_cursor ensures #9] [%#sshared_capsule'13] UInt64.t'int (Ptr.addr_logic_u64 (raw_pointer result.cursor))
    = UInt64.t'int (Ptr.addr_logic_u64 (raw_pointer self.cursor)) + UInt64.t'int count)}
    (! return {result}) ]
