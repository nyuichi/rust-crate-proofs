axiom active_lease_pool_protocol_spec:
  forall pool: t_PhysicalPool, ledger: t_OwnerLedger, capacity'0: int, binding: t_Id, lent_span: t_Option_tup3_Int_Int_Int [active_lease_pool_protocol pool ledger capacity'0 binding lent_span]. [%#sshared_capsule'6] active_lease_pool_protocol pool ledger capacity'0 binding lent_span
    = (capacity pool = capacity'0
    /\ namespace pool = binding
    /\ resource_id pool = binding
    /\ match lent_span with
      | None -> (forall index: int. contains pool index
          = (0 <= index /\ index < capacity'0 /\ not active_mutable_contains (active_ids ledger) index))
      /\ (forall owner_id: int. match get_Int'0 (active_ids ledger) owner_id with
          | Some'3 {f0'6 = {f1'5 = Readonly; f2'5 = lo; f3'5 = hi}} -> forall index: int. lo <= index /\ index < hi
            -> contains pool index /\ slot_known (slot pool index)
          | _ -> true
          end)
      | Some {f0 = owner_id; f1 = lo; f2 = hi} -> 0 <= lo
      /\ lo <= hi
      /\ hi <= capacity'0
      /\ get_Int'0 (active_ids ledger) owner_id
        = Some'3 { f0'6 = { f0'5 = allocation_binding ledger; f1'5 = Readonly; f2'5 = lo; f3'5 = hi } }
      /\ (forall index: int. contains pool index
          = (0 <= index
          /\ index < capacity'0
          /\ not active_mutable_contains (active_ids ledger) index /\ not (lo <= index /\ index < hi)))
      /\ (forall other_owner: int. match get_Int'0 (active_ids ledger) other_owner with
          | Some'3 {f0'6 = {f1'5 = Readonly; f2'5 = other_lo; f3'5 = other_hi}} -> forall index: int. other_lo <= index
              /\ index < other_hi /\ not (lo <= index /\ index < hi)
            -> contains pool index /\ slot_known (slot pool index)
          | _ -> true
          end)
      end)

