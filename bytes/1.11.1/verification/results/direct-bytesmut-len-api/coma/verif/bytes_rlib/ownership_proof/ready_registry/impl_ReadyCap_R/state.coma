type t_View_AuthViewRel_R

type t_Option_R = None | Some t_R

function op_R (self: t_R) (other: t_R) : t_Option_R

predicate incl_R (self: t_R) (other: t_R)

axiom incl_R_spec: forall self: t_R, other: t_R [incl_R self other]. [%#sra] incl_R self other
    = (exists factor: t_R. op_R self factor = Some other)

function incl_transitive_R (a: t_R) (b: t_R) (c: t_R) : ()

axiom incl_transitive_R_spec: forall a: t_R, b: t_R, c: t_R. ([%#sra'10] incl_R a b)
    -> ([%#sra'11] incl_R b c) -> ([%#sra'12] incl_R a c)

function associative_some_R (a: t_R) (b: t_R) (c: t_R) (ab: t_R) (bc: t_R) : ()

axiom associative_some_R_spec: forall a: t_R, b: t_R, c: t_R, ab: t_R, bc: t_R. ([%#sra'7] op_R a b = Some ab)
    -> ([%#sra'8] op_R b c = Some bc) -> ([%#sra'9] op_R a bc = op_R ab c)

function associative_none_R (a: t_R) (b: t_R) (c: t_R) (bc: t_R) : ()

axiom associative_none_R_spec: forall a: t_R, b: t_R, c: t_R, bc: t_R. ([%#sra'4] op_R a b = None)
    -> ([%#sra'5] op_R b c = Some bc) -> ([%#sra'6] op_R a bc = None)

function commutative_R (a: t_R) (b: t_R) : ()

axiom commutative_R_spec: forall a: t_R, b: t_R. [%#sra'3] op_R a b = op_R b a

function incl_op_R (self: t_R) (other: t_R) (comb: t_R) : ()

axiom incl_op_R_spec: forall self: t_R, other: t_R, comb: t_R. ([%#sra'1] op_R self other = Some comb)
    -> ([%#sra'2] incl_R self comb)

function core_R (self: t_R) : t_Option_R

function core_total_R (self: t_R) : t_R

axiom core_total_R_spec: forall self: t_R [core_total_R self]. [%#sra'15] core_R self = Some (core_total_R self)

constant unit_R : t_R

axiom unit_R_spec: [%#sra'0] forall x: t_R [op_R x unit_R]. op_R x unit_R = Some x

constant unit_core_R : ()

axiom unit_core_R_spec: [%#sra'14] core_total_R unit_R = unit_R

constant incl_refl_R : ()

