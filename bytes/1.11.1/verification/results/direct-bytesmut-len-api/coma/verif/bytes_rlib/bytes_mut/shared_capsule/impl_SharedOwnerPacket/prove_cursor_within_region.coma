      <= (unwrap_Option_tup3_Id_Int_Int (view_BoundPtr self.cursor)).f2'3)
    /\ ([@stop_split] [@expl:prove_cursor_within_region ensures #9] [%#sshared_capsule'12] (unwrap_Option_tup3_Id_Int_Int (view_BoundPtr self.cursor)).f2'3
    <= hi self.region)}
    (! return {result}) ]
