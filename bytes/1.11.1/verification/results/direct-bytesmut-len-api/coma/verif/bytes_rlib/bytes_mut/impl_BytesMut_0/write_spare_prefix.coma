let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_NonNull_u8

function view_NonNull_u8 (self: t_NonNull_u8) : Opaque.ptr

function addr_NonNull_u8 [@inline:trivial] (self: t_NonNull_u8) : UInt64.t =
  [%#snonnull'0] Ptr.addr_logic_u64 (view_NonNull_u8 self)

meta "rewrite_def" function addr_NonNull_u8

predicate is_null_NonNull_u8 (self: t_NonNull_u8) = [%#sptr'17] addr_NonNull_u8 self = (0: UInt64.t)

predicate invariant_NonNull_u8 (self: t_NonNull_u8) = [%#snonnull] not is_null_NonNull_u8 self

predicate inv_NonNull_u8 (_1: t_NonNull_u8)

axiom inv_axiom: forall x: t_NonNull_u8 [inv_NonNull_u8 x]. inv_NonNull_u8 x -> invariant_NonNull_u8 x

