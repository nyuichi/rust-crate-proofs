    /\ namespace (unwrap_Option_OriginalUniqueProof self.final.unique_proof).capabilities.f1
      = namespace (unwrap_Option_OriginalUniqueProof self.current.unique_proof).capabilities.f1
    /\ capacity (unwrap_Option_OriginalUniqueProof self.final.unique_proof).capabilities.f1
      = capacity (unwrap_Option_OriginalUniqueProof self.current.unique_proof).capabilities.f1
    /\ resource_id (unwrap_Option_OriginalUniqueProof self.final.unique_proof).capabilities.f1
      = resource_id (unwrap_Option_OriginalUniqueProof self.current.unique_proof).capabilities.f1
    /\ lo (unwrap_Option_OriginalUniqueProof self.final.unique_proof).capabilities.f1
      = lo (unwrap_Option_OriginalUniqueProof self.current.unique_proof).capabilities.f1
    /\ hi (unwrap_Option_OriginalUniqueProof self.final.unique_proof).capabilities.f1
      = hi (unwrap_Option_OriginalUniqueProof self.current.unique_proof).capabilities.f1
    /\ self.final.shared_proof = self.current.shared_proof
    /\ UInt64.bw_and (Ptr.addr_logic_u64 (unique_tag_pointer self.final)) const_NOT_VEC_POS_MASK
      = UInt64.bw_and (Ptr.addr_logic_u64 (unique_tag_pointer self.current)) const_NOT_VEC_POS_MASK
    /\ unique_bytes self.final = unique_bytes self.current
    /\ (forall i: int. 0 <= i /\ i < unique_length self.current
        -> unique_allocation_slot self.final i = Some'4 (Some'3 (Seq.get (unique_bytes self.current) i)))
    /\ (forall i: int. unique_length self.current <= i /\ i < unique_allocation_capacity self.current
      -> unique_allocation_slot self.final i = unique_allocation_slot self.current i)}
    (! return {result}) ]
