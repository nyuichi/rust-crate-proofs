 = [%#sraw_vec'1] (view_OwnedRegion (view_PhysicalRegion self).f0'4).f1'3

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant before : t_PhysicalRegion

constant cut : int

constant split : tup2_PhysicalRegion_PhysicalRegion

predicate mutable_owner_region_split_slots_result [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/bytes_mut/shared_capsule.rs" 198 0 202 9] (before: t_PhysicalRegion) (cut: int) (split: tup2_PhysicalRegion_PhysicalRegion)

goal vc_mutable_owner_region_split_slots_result: if forall i: int. slot'0 split.f0 i
    = (if lo before <= i /\ i < cut then slot'0 before i else None'0) then
    [@stop_split] [@expl:mutable_owner_region_split_slots_result ensures] [%#sshared_capsule] (forall i: int. slot'0 split.f1 i
        = (if cut <= i /\ i < hi before then slot'0 before i else None'0))
    = ((forall i: int. slot'0 split.f0 i = (if lo before <= i /\ i < cut then slot'0 before i else None'0))
    /\ (forall i: int. slot'0 split.f1 i = (if cut <= i /\ i < hi before then slot'0 before i else None'0)))
  else
    [@stop_split] [@expl:mutable_owner_region_split_slots_result ensures] [%#sshared_capsule] false
    = ((forall i: int. slot'0 split.f0 i = (if lo before <= i /\ i < cut then slot'0 before i else None'0))
    /\ (forall i: int. slot'0 split.f1 i = (if cut <= i /\ i < hi before then slot'0 before i else None'0)))
  
