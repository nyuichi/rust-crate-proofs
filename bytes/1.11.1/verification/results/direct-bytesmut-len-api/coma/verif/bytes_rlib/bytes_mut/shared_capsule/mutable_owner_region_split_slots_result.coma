function slot'0 [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/raw_vec.rs" 728 4 728 62] (self: t_PhysicalRegion) (index: int) : t_Option_Option_u8

axiom slot_spec'0: forall self: t_PhysicalRegion, index: int [slot'0 self index]. [%#sraw_vec] slot'0 self index
    = slot (view_PhysicalRegion self).f0'4 index

function lo [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/ownership_proof/raw_vec.rs" 702 4 702 33] (self: t_PhysicalRegion) : int
 = [%#sraw_vec'0] (view_OwnedRegion (view_PhysicalRegion self).f0'4).f0'3

