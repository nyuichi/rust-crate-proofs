use creusot.int.UInt64BW
use creusot.int.UInt32BW
use creusot.prelude.Any
use int.Int

constant const_MIN_ORIGINAL_CAPACITY_WIDTH: UInt64BW.t = [%#sbytes_mut'17] (10: UInt64BW.t)

constant const_BITS: UInt32BW.t = (64: UInt32BW.t)

function leading_zeros_usize (self: UInt64BW.t) : UInt32BW.t

axiom leading_zeros_usize_spec:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum'0] UInt32BW.le (leading_zeros_usize self) const_BITS

axiom leading_zeros_usize_spec'0:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum'1] (leading_zeros_usize self <> const_BITS)
    = (UInt64BW.shr self (UInt64BW.of_BV256 (UInt32BW.to_BV256 (UInt32BW.sub (UInt32BW.sub const_BITS (leading_zeros_usize self)) (1: UInt32BW.t))))
    = (1: UInt64BW.t))

axiom leading_zeros_usize_spec'1:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum'2] (leading_zeros_usize self = const_BITS)
    = (self = (0: UInt64BW.t))

let leading_zeros (self_: UInt64BW.t) (return (x: UInt32BW.t)) = any
  [ return (result: UInt32BW.t) -> {[@stop_split] [@expl:leading_zeros ensures] [%#snum] result
    = leading_zeros_usize self_}
    (! return {result}) ]

constant const_PTR_WIDTH: UInt64BW.t = [%#sbytes_mut'17] (64: UInt64BW.t)

constant const_MAX_ORIGINAL_CAPACITY_WIDTH: UInt64BW.t = [%#sbytes_mut'17] (17: UInt64BW.t)

function deep_model_usize [@inline:trivial] (self: UInt64BW.t) : int = [%#snum'3] UInt64BW.t'int self

meta "rewrite_def" function deep_model_usize

let min_usize (v1: UInt64BW.t) (v2: UInt64BW.t) (return (x: UInt64BW.t)) = any
  [ return (result: UInt64BW.t) ->
  {[@stop_split] [@expl:min_usize ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_usize result
      <= deep_model_usize v1)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_usize result <= deep_model_usize v2)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = v1 \/ result = v2)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_usize v1 < deep_model_usize v2 -> result = v1)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_usize v2 <= deep_model_usize v1 -> result = v2)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let original_capacity_to_repr [#"/workspace/rust-crate-proofs/bytes/1.11.1/src/bytes_mut.rs" 1844 0 1844 49]
  (cap: UInt64BW.t) (return (x: UInt64BW.t)) = (! bb0
  [ bb0 = s0
    [ s0 = UInt64BW.shr [%#sbytes_mut'0] {cap} {UInt64BW.to_BV256 ([%#sbytes_mut] const_MIN_ORIGINAL_CAPACITY_WIDTH)}
        (fun (_x: UInt64BW.t) -> [ &_22 <- _x ] s1)
    | s1 = leading_zeros [%#sbytes_mut'1] {_22} (fun (_x: UInt32BW.t) -> [ &_21 <- _x ] s2)
    | s2 = [ &_20 <- UInt64BW.of_BV256 (UInt32BW.to_BV256 _21) ] s3
    | s3 = UInt64BW.sub [%#sbytes_mut'3] {[%#sbytes_mut'2] const_PTR_WIDTH} {_20}
        (fun (_x: UInt64BW.t) -> [ &width <- _x ] s4)
    | s4 = UInt64BW.sub [%#sbytes_mut'6] {[%#sbytes_mut'5] const_MAX_ORIGINAL_CAPACITY_WIDTH}
        {[%#sbytes_mut'4] const_MIN_ORIGINAL_CAPACITY_WIDTH} (fun (_x: UInt64BW.t) -> [ &_25 <- _x ] s5)
    | s5 = min_usize [%#sbytes_mut'7] {width} {_25} (fun (_x: UInt64BW.t) -> [ &_ret <- _x ] s6)
    | s6 = return {_ret} ] ]
  [ & _ret: UInt64BW.t = Any.any_l ()
  | & cap: UInt64BW.t = cap
  | & width: UInt64BW.t = Any.any_l ()
  | & _20: UInt64BW.t = Any.any_l ()
  | & _21: UInt32BW.t = Any.any_l ()
  | & _22: UInt64BW.t = Any.any_l ()
  | & _25: UInt64BW.t = Any.any_l () ])
  [ return (result: UInt64BW.t) ->
  {[@stop_split] [@expl:original_capacity_to_repr ensures] ([@stop_split] [@expl:original_capacity_to_repr ensures #0] [%#sbytes_mut'8] UInt64BW.t'int result
      <= 7)
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #1] [%#sbytes_mut'9] (UInt64BW.t'int result = 0)
      = (UInt64BW.t'int cap < 1024))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #2] [%#sbytes_mut'10] (UInt64BW.t'int result = 1)
      = (1024 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 2048))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #3] [%#sbytes_mut'11] (UInt64BW.t'int result = 2)
      = (2048 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 4096))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #4] [%#sbytes_mut'12] (UInt64BW.t'int result = 3)
      = (4096 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 8192))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #5] [%#sbytes_mut'13] (UInt64BW.t'int result = 4)
      = (8192 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 16384))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #6] [%#sbytes_mut'14] (UInt64BW.t'int result = 5)
      = (16384 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 32768))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #7] [%#sbytes_mut'15] (UInt64BW.t'int result = 6)
      = (32768 <= UInt64BW.t'int cap /\ UInt64BW.t'int cap < 65536))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #8] [%#sbytes_mut'16] (UInt64BW.t'int result = 7)
