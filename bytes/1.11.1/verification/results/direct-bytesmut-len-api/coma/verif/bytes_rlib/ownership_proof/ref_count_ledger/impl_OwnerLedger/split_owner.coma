    | & _137: int = Any.any_l ()
    | & child: t_OwnerTicket = Any.any_l ()
    | & _146: () = Any.any_l ()
    | & _153: () = Any.any_l ()
    | & _156: t_OwnerTicket = Any.any_l () ]))
  [ return (result: t_OwnerTicket) ->
  {[@stop_split] [@expl:split_owner ensures] ([@stop_split] [@expl:split_owner result type invariant] [%#sref_count_ledger'40] inv_Ghost_OwnerTicket result)
    /\ ([@stop_split] [@expl:split_owner ensures #0] [%#sref_count_ledger'41] invariant_OwnerLedger ledger.final
      /\ is_live ledger.final)
    /\ ([@stop_split] [@expl:split_owner ensures #1] [%#sref_count_ledger'42] ledger_id'2 ledger.final
      = ledger_id'2 ledger.current)
    /\ ([@stop_split] [@expl:split_owner ensures #2] [%#sref_count_ledger'43] allocation_binding'1 ledger.final
      = allocation_binding'1 ledger.current)
    /\ ([@stop_split] [@expl:split_owner ensures #3] [%#sref_count_ledger'44] count ledger.final
      = count ledger.current + 1)
    /\ ([@stop_split] [@expl:split_owner ensures #4] [%#sref_count_ledger'45] agrees_with_value ledger.final (count ledger.current
      + 1))
    /\ ([@stop_split] [@expl:split_owner ensures #5] [%#sref_count_ledger'46] active_ids ledger.final
      = insert_Int (insert_Int (active_ids ledger.current) (owner_id parent.current) { f0'2 = { f0'1 = allocation_binding'0 parent.current;
                                                                                                f1'1 = owned_lo parent.current;
                                                                                                f2'1 = cut } }) (next_id'0 ledger.current) { f0'2 = { f0'1 = allocation_binding'0 parent.current;
                                                                                                                                                      f1'1 = cut;
                                                                                                                                                      f2'1 = owned_hi parent.current } })
    /\ ([@stop_split] [@expl:split_owner ensures #6] [%#sref_count_ledger'47] next_id'0 ledger.final
      = next_id'0 ledger.current + 1)
    /\ ([@stop_split] [@expl:split_owner ensures #7] [%#sref_count_ledger'48] has_ticket ledger.final parent.final)
    /\ ([@stop_split] [@expl:split_owner ensures #8] [%#sref_count_ledger'49] invariant_OwnerTicket result)
    /\ ([@stop_split] [@expl:split_owner ensures #9] [%#sref_count_ledger'50] ledger_id'1 result
      = ledger_id'2 ledger.current)
    /\ ([@stop_split] [@expl:split_owner ensures #10] [%#sref_count_ledger'51] owner_id result
      = next_id'0 ledger.current)
    /\ ([@stop_split] [@expl:split_owner ensures #11] [%#sref_count_ledger'52] fragment_resource_id result
      = ledger_id'2 ledger.current)
    /\ ([@stop_split] [@expl:split_owner ensures #12] [%#sref_count_ledger'53] allocation_binding'0 result
      = allocation_binding'0 parent.current)
    /\ ([@stop_split] [@expl:split_owner ensures #13] [%#sref_count_ledger'54] owned_lo result = cut)
    /\ ([@stop_split] [@expl:split_owner ensures #14] [%#sref_count_ledger'55] owned_hi result
      = owned_hi parent.current)
    /\ ([@stop_split] [@expl:split_owner ensures #15] [%#sref_count_ledger'56] owned_lo parent.final
      = owned_lo parent.current)
    /\ ([@stop_split] [@expl:split_owner ensures #16] [%#sref_count_ledger'57] owned_hi parent.final = cut)
    /\ ([@stop_split] [@expl:split_owner ensures #17] [%#sref_count_ledger'58] fragment_map result
      = singleton_Int (next_id'0 ledger.current) { f0'2 = { f0'1 = allocation_binding'0 parent.current;
                                                            f1'1 = cut;
                                                            f2'1 = owned_hi parent.current } })
    /\ ([@stop_split] [@expl:split_owner ensures #18] [%#sref_count_ledger'59] has_ticket ledger.final result)}
    (! return {result}) ]
