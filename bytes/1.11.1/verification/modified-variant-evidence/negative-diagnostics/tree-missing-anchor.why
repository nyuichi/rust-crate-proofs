  le_log_PositiveReal (frac self) (from_int1 1)

predicate accepts_payload_LifetimeToken (self:
  t_SharedRetirement_LifetimeToken) (t:t_Ticket) (payload:t_LifetimeToken) =
  accepts_LifetimeToken self t /\
  wellformed_LifetimeToken payload /\
  metadata_LifetimeToken payload =
  (if is_leftqt0 t then (expected_LifetimeToken self).f0qt1
   else (expected_LifetimeToken self).f1qt1)

predicate accepted_byqt0 (self:t_ReadHandle) (context:t_CloseContext) =
  accepts_payload_LifetimeToken (context.machine) (self.ticketqt0)
  (self.permitqt0)

