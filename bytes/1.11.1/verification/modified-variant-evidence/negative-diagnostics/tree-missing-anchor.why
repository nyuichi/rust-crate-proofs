function from_int int : real

axiom Zero [@useraxiom] : from_int 0 = 0.0

axiom One [@useraxiom] : from_int 1 = 1.0

axiom Add [@useraxiom] :
  forall x:int, y:int.
   from_int (infix_pl x y) = infix_pl5 (from_int x) (from_int y)

axiom Sub [@useraxiom] :
  forall x:int, y:int.
   from_int (infix_mn x y) = infix_mn1 (from_int x) (from_int y)

