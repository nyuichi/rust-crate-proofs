  prop Inv_def_l2 = Inv_def_l, prop Unit_def_r3 = Unit_def_r,
  prop Unit_def_l3 = Unit_def_l, prop Assoc4 = Assoc,  *)

axiom Assoc5 :
  forall x:int, y:int, z:int.
   infix_as (infix_as x y) z = infix_as x (infix_as y z)

(* clone algebra.Assoc with type t = int, function op = infix_as,
  prop Assoc1 = Assoc5,  *)

axiom Mul_distr_l :
  forall x:int, y:int, z:int.
   infix_as x (infix_pl y z) = infix_pl (infix_as x y) (infix_as x z)

axiom Mul_distr_r :
  forall x:int, y:int, z:int.
   infix_as (infix_pl y z) x = infix_pl (infix_as y x) (infix_as z x)

(* clone algebra.Ring with type t5 = int, function infix_as1 = infix_as,
  function prefix_mn1 = prefix_mn, function infix_pl1 = infix_pl,
