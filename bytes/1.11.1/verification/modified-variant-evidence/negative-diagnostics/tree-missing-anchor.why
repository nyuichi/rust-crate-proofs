predicate accepted_by (self:t_Closed) (context:t_CloseContext) =
  accepts_receipt_LifetimeToken (context.machine) (self.receipt) (self.last) /\
  (self.last = True <-> not self.recovered = None) /\
  (self.last = True ->
   Tup2_tup2_Lifetime_PositiveReal_tup2_Lifetime_PositiveRealqtmk
   (metadata_LifetimeToken
    ((unwrap_Option_tup2_LifetimeToken_LifetimeToken (self.recovered)).f0qt0))
   (metadata_LifetimeToken
    ((unwrap_Option_tup2_LifetimeToken_LifetimeToken (self.recovered)).f1qt0)) =
   expected_LifetimeToken (context.machine))

predicate is_leftqt1 (self:t_Closed) = is_left (self.receipt)

