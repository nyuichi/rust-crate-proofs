predicate valid (self:t_CloseContext) = valid_LifetimeToken (self.machine)

predicate restores_to (self:t_BranchContext) (parent:t_CloseContext) =
  accepts_LifetimeToken (parent.machine) (self.parent_ticket) /\
  self.original =
  (if is_leftqt0 (self.parent_ticket)
   then (expected_LifetimeToken (parent.machine)).f0qt1
   else (expected_LifetimeToken (parent.machine)).f1qt1) /\
  le_log_PositiveReal ((self.original).f1) (from_int1 1) /\
  lft (self.anchor) = (self.original).f0 /\
  frac (self.anchor) = div_PositiveReal ((self.original).f1) (from_int1 2) /\
  valid (self.children) /\
  (expected_LifetimeToken ((self.children).machine)).f0qt1 =
  Tup2_Lifetime_PositiveRealqtmk ((self.original).f0)
  (div_PositiveReal ((self.original).f1) (from_int1 4)) /\
  (expected_LifetimeToken ((self.children).machine)).f1qt1 =
  Tup2_Lifetime_PositiveRealqtmk ((self.original).f0)
  (div_PositiveReal ((self.original).f1) (from_int1 4))

