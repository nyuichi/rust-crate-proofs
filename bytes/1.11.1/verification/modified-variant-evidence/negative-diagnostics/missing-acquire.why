function inherit_id int int : int

(* use creusot.prelude.MutBorrow *)

type (->) 'a 'b

function infix_at ('a -> 'b) 'a : 'b

(* use why3.HighOrd.HighOrd *)

type map 'a 'b = 'a -> 'b

function get (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function set (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b =
  fun (y:'a) -> if y = x then v else infix_at f y

function mixfix_lbrb (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function mixfix_lblsmnrb (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b = set f x v

(* use map.Map *)

constant zero : int = 0

constant one : int = 1

function prefix_mn int : int

function infix_pl int int : int

function infix_as int int : int

predicate infix_ls int int

function infix_mn (x:int) (y:int) : int = infix_pl x (prefix_mn y)

predicate infix_gt (x:int) (y:int) = infix_ls y x

predicate infix_lseq (x:int) (y:int) = infix_ls x y \/ x = y

predicate infix_gteq (x:int) (y:int) = infix_lseq y x

axiom Assoc :
  forall x:int, y:int, z:int.
   infix_pl (infix_pl x y) z = infix_pl x (infix_pl y z)

(* clone algebra.Assoc with type t1 = int, function op = infix_pl,
  prop Assoc1 = Assoc,  *)

axiom Unit_def_l : forall x:int. infix_pl zero x = x

axiom Unit_def_r : forall x:int. infix_pl x zero = x

(* clone algebra.Monoid with type t2 = int, constant unit = zero,
  function op1 = infix_pl, prop Unit_def_r1 = Unit_def_r,
  prop Unit_def_l1 = Unit_def_l, prop Assoc2 = Assoc,  *)

axiom Inv_def_l : forall x:int. infix_pl (prefix_mn x) x = zero

axiom Inv_def_r : forall x:int. infix_pl x (prefix_mn x) = zero

(* clone algebra.Group with type t3 = int, function inv = prefix_mn,
  constant unit1 = zero, function op2 = infix_pl,
  prop Inv_def_r1 = Inv_def_r, prop Inv_def_l1 = Inv_def_l,
  prop Unit_def_r2 = Unit_def_r, prop Unit_def_l2 = Unit_def_l,
  prop Assoc3 = Assoc,  *)

axiom Comm : forall x:int, y:int. infix_pl x y = infix_pl y x

(* clone algebra.Comm with type t4 = int, function op3 = infix_pl,
  prop Comm1 = Comm,  *)

(* meta AC function infix_pl *)

(* clone algebra.CommutativeGroup with type t5 = int,
