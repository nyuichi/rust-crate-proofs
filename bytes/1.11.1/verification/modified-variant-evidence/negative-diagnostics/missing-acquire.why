(* use int.Int *)

function abs (x:int) : int = if infix_gteq x 0 then x else prefix_mn x

axiom Abs_le :
  forall x:int, y:int.
   infix_lseq (abs x) y <-> infix_lseq (prefix_mn y) x /\ infix_lseq x y

(* meta remove_unused:dependency prop Abs_le, function abs *)

axiom Abs_pos : forall x:int. infix_gteq (abs x) 0

(* meta remove_unused:dependency prop Abs_pos, function abs *)

(* use int.Abs *)

function div int int : int

function mod int int : int

axiom Div_mod [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div x y)) (mod x y)

(* meta remove_unused:dependency prop Div_mod, function div *)

(* meta remove_unused:dependency prop Div_mod, function mod *)

axiom Div_bound [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div x y) /\ infix_lseq (div x y) x

(* meta remove_unused:dependency prop Div_bound, function div *)

(* meta remove_unused:dependency prop Div_bound, function mod *)

axiom Mod_bound [@useraxiom] :
  forall x:int, y:int.
   not y = 0 ->
   infix_ls (prefix_mn (abs y)) (mod x y) /\ infix_ls (mod x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound, function div *)

(* meta remove_unused:dependency prop Mod_bound, function mod *)

axiom Div_sign_pos [@useraxiom] :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 -> infix_gteq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_pos, function div *)

(* meta remove_unused:dependency prop Div_sign_pos, function mod *)

axiom Div_sign_neg [@useraxiom] :
  forall x:int, y:int.
   infix_lseq x 0 /\ infix_gt y 0 -> infix_lseq (div x y) 0

(* meta remove_unused:dependency prop Div_sign_neg, function div *)

(* meta remove_unused:dependency prop Div_sign_neg, function mod *)

axiom Mod_sign_pos [@useraxiom] :
  forall x:int, y:int. infix_gteq x 0 /\ not y = 0 -> infix_gteq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_pos, function div *)

(* meta remove_unused:dependency prop Mod_sign_pos, function mod *)

axiom Mod_sign_neg [@useraxiom] :
  forall x:int, y:int. infix_lseq x 0 /\ not y = 0 -> infix_lseq (mod x y) 0

(* meta remove_unused:dependency prop Mod_sign_neg, function div *)

(* meta remove_unused:dependency prop Mod_sign_neg, function mod *)

axiom Rounds_toward_zero :
  forall x:int, y:int.
   not y = 0 -> infix_lseq (abs (infix_as (div x y) y)) (abs x)

(* meta remove_unused:dependency prop Rounds_toward_zero, function div *)

(* meta remove_unused:dependency prop Rounds_toward_zero, function mod *)

axiom Div_1 : forall x:int. div x 1 = x

(* meta remove_unused:dependency prop Div_1, function div *)

(* meta remove_unused:dependency prop Div_1, function mod *)

axiom Mod_1 : forall x:int. mod x 1 = 0

(* meta remove_unused:dependency prop Mod_1, function div *)

(* meta remove_unused:dependency prop Mod_1, function mod *)

axiom Div_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> div x y = 0

(* meta remove_unused:dependency prop Div_inf, function div *)

(* meta remove_unused:dependency prop Div_inf, function mod *)

axiom Mod_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> mod x y = x

(* meta remove_unused:dependency prop Mod_inf, function div *)

(* meta remove_unused:dependency prop Mod_inf, function mod *)

axiom Div_mult :
  forall x:int, y:int, z:int [div (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   div (infix_pl (infix_as x y) z) x = infix_pl y (div z x)

(* meta remove_unused:dependency prop Div_mult, function div *)

(* meta remove_unused:dependency prop Div_mult, function mod *)

axiom Mod_mult :
  forall x:int, y:int, z:int [mod (infix_pl (infix_as x y) z) x].
   infix_gt x 0 /\ infix_gteq y 0 /\ infix_gteq z 0 ->
   mod (infix_pl (infix_as x y) z) x = mod z x

(* meta remove_unused:dependency prop Mod_mult, function div *)

(* meta remove_unused:dependency prop Mod_mult, function mod *)

(* use int.ComputerDivision *)

(* use mach.int.Int1 *)

type t18 = <range 0 18446744073709551615>

function tqtint t18 : int

constant tqtmaxInt : int = 18446744073709551615

constant tqtminInt : int = 0

predicate tqteq (a:t18) (b:t18) = tqtint a = tqtint b

axiom tqtinj [@W:non_conservative_extension:N] :
  forall a:t18, b:t18. tqteq a b -> a = b

(* meta range_type type t18, function tqtint *)

(* meta model_projection function tqtint *)

(* meta remove_unused:dependency prop tqtinj, predicate tqteq *)

constant two_power_size : int = 0x10000000000000000

axiom extensionality [@useraxiom] :
  forall x:t18, y:t18 [tqtint x, tqtint y]. tqtint x = tqtint y -> x = y

predicate in_bounds [@inline:trivial] (n:int) =
  infix_lseq 0 n /\ infix_lseq n 0xFFFFFFFFFFFFFFFF

function of_int int : t18

axiom to_of_int [@useraxiom] :
  forall x:int [of_int x]. in_bounds x -> tqtint (of_int x) = x

function add t18 t18 : t18

axiom add_in_bounds [@useraxiom] :
  forall x:t18, y:t18 [add x y].
   in_bounds (infix_pl (tqtint x) (tqtint y)) ->
   tqtint (add x y) = infix_pl (tqtint x) (tqtint y)

axiom add_wrapping [@useraxiom] :
  forall x:t18, y:t18 [add x y].
   exists k:int.
    tqtint (add x y) =
    infix_pl (infix_pl (tqtint x) (tqtint y)) (infix_as k two_power_size)

function sub t18 t18 : t18

axiom sub_in_bounds [@useraxiom] :
  forall x:t18, y:t18 [sub x y].
   in_bounds (infix_mn (tqtint x) (tqtint y)) ->
   tqtint (sub x y) = infix_mn (tqtint x) (tqtint y)

axiom sub_wrapping [@useraxiom] :
  forall x:t18, y:t18 [sub x y].
   exists k:int.
    tqtint (sub x y) =
    infix_pl (infix_mn (tqtint x) (tqtint y)) (infix_as k two_power_size)

function mul t18 t18 : t18

axiom mul_in_bounds [@useraxiom] :
  forall x:t18, y:t18 [mul x y].
   in_bounds (infix_as (tqtint x) (tqtint y)) ->
   tqtint (mul x y) = infix_as (tqtint x) (tqtint y)

axiom mul_wrapping [@useraxiom] :
  forall x:t18, y:t18 [mul x y].
   exists k:int.
    tqtint (mul x y) =
    infix_pl (infix_as (tqtint x) (tqtint y)) (infix_as k two_power_size)

function neg t18 : t18

axiom neg_zero [@useraxiom] :
  forall x:t18 [neg x]. tqtint x = 0 -> tqtint (neg x) = 0

axiom neg_not_zero [@useraxiom] :
  forall x:t18 [neg x].
   infix_ls 0 (tqtint x) /\ infix_lseq (tqtint x) 0xFFFFFFFFFFFFFFFF ->
   tqtint (neg x) = infix_mn two_power_size (tqtint x)

function of_bool [@inline:trivial] (b:bool) : t18 =
  if b = True then (1:t18) else (0:t18)

predicate le [@inline:trivial] (a:t18) (b:t18) =
  infix_lseq (tqtint a) (tqtint b)

predicate lt [@inline:trivial] (a:t18) (b:t18) =
  infix_ls (tqtint a) (tqtint b)

predicate ge [@inline:trivial] (a:t18) (b:t18) =
  infix_gteq (tqtint a) (tqtint b)

predicate gt [@inline:trivial] (a:t18) (b:t18) =
  infix_gt (tqtint a) (tqtint b)

function bw_and t18 t18 : t18

function bw_or t18 t18 : t18

function bw_xor t18 t18 : t18

function bw_not t18 : t18

function shl t18 t18 : t18

function shr t18 t18 : t18

function nth t18 int : bool

type tuple2 'a 'a1 =
  | Tuple2 [@builtin] 'a 'a1

(* use why3.Tuple2.Tuple21 *)

function add_with_overflow (a:t18) (b:t18) : (t18, bool) = (add a b,
  if not in_bounds (infix_pl (tqtint a) (tqtint b)) then True else False)

function sub_with_overflow (a:t18) (b:t18) : (t18, bool) = (sub a b,
  if not in_bounds (infix_mn (tqtint a) (tqtint b)) then True else False)

function mul_with_overflow (a:t18) (b:t18) : (t18, bool) = (mul a b,
  if not in_bounds (infix_as (tqtint a) (tqtint b)) then True else False)

(* use creusot.int.UInt64 *)

function any_l 'a : 'b

(* use creusot.prelude.Any *)

function const (v:'b) : 'a -> 'b = fun (us [@__dummy__]:'a) -> v

(* use map.Const *)

type set 'a = 'a -> bool

(* meta material_type_arg type set, 0 *)

predicate mem (x:'a) (s:'a -> bool) = mixfix_lbrb s x = True

predicate infix_eqeq (m1:'a -> 'b) (m2:'a -> 'b) =
  forall x:'a. infix_at m1 x = infix_at m2 x

axiom extensionality1 :
  forall m1:'a -> 'b, m2:'a -> 'b. infix_eqeq m1 m2 -> m1 = m2

(* meta extensionality predicate infix_eqeq *)

(* use map.MapExt *)

predicate subset (s1:'a -> bool) (s2:'a -> bool) =
  forall x:'a. mem x s1 -> mem x s2

axiom subset_refl : forall s:'a -> bool. subset s s

axiom subset_trans :
  forall s1:'a -> bool, s2:'a -> bool, s3:'a -> bool.
   subset s1 s2 -> subset s2 s3 -> subset s1 s3

predicate is_empty (s:'a -> bool) = forall x:'a. not mem x s

constant empty : 'a -> bool = const False: 'a -> bool

axiom is_empty_empty : is_empty (empty: 'a -> bool)

axiom empty_is_empty :
  forall s:'a -> bool. is_empty s -> s = (empty: 'a -> bool)

constant all : 'a -> bool = const True: 'a -> bool

function add1 (x:'a) (s:'a -> bool) : 'a -> bool = mixfix_lblsmnrb s x True

function singleton (x:'a) : 'a -> bool = add1 x (empty: 'a -> bool)

axiom mem_singleton : forall x:'a, y:'a. mem y (singleton x) -> y = x

function remove (x:'a) (s:'a -> bool) : 'a -> bool =
  mixfix_lblsmnrb s x False

axiom add_remove :
  forall x:'a, s:'a -> bool [add1 x (remove x s)].
   mem x s -> add1 x (remove x s) = s

(* meta remove_unused:dependency prop add_remove, function remove *)

axiom remove_add :
  forall x:'a, s:'a -> bool. remove x (add1 x s) = remove x s

(* meta remove_unused:dependency prop remove_add, function remove *)

axiom subset_remove : forall x:'a, s:'a -> bool. subset (remove x s) s

(* meta remove_unused:dependency prop subset_remove, function remove *)

function union (s1:'a -> bool) (s2:'a -> bool) : 'a -> bool =
  fun (x:'a) -> mem x s1 \/ mem x s2

axiom subset_union_1 :
  forall s1:'a -> bool, s2:'a -> bool. subset s1 (union s1 s2)

axiom subset_union_2 :
  forall s1:'a -> bool, s2:'a -> bool. subset s2 (union s1 s2)

function inter (s1:'a -> bool) (s2:'a -> bool) : 'a -> bool =
  fun (x:'a) -> mem x s1 /\ mem x s2

axiom subset_inter_1 :
  forall s1:'a -> bool, s2:'a -> bool. subset (inter s1 s2) s1

(* meta remove_unused:dependency prop subset_inter_1, function inter *)

axiom subset_inter_2 :
  forall s1:'a -> bool, s2:'a -> bool. subset (inter s1 s2) s2

(* meta remove_unused:dependency prop subset_inter_2, function inter *)

function diff (s1:'a -> bool) (s2:'a -> bool) : 'a -> bool =
  fun (x:'a) -> mem x s1 /\ not mem x s2

axiom subset_diff :
  forall s1:'a -> bool, s2:'a -> bool. subset (diff s1 s2) s1

(* meta remove_unused:dependency prop subset_diff, function diff *)

function complement (s:'a -> bool) : 'a -> bool = fun (x:'a) -> not mem x s

function pick ('a -> bool) : 'a

axiom pick_def [@useraxiom] :
  forall s:'a -> bool. not is_empty s -> mem (pick s) s

(* meta remove_unused:dependency prop pick_def, function pick *)

predicate disjoint (s1:'a -> bool) (s2:'a -> bool) =
  forall x:'a. not mem x s1 \/ not mem x s2

axiom disjoint_inter_empty :
  forall s1:'a -> bool, s2:'a -> bool.
   disjoint s1 s2 <-> is_empty (inter s1 s2)

(* meta remove_unused:dependency prop disjoint_inter_empty, function inter *)

axiom disjoint_diff_eq :
  forall s1:'a -> bool, s2:'a -> bool. disjoint s1 s2 <-> diff s1 s2 = s1

(* meta remove_unused:dependency prop disjoint_diff_eq, function diff *)

axiom disjoint_diff_s2 :
  forall s1:'a -> bool, s2:'a -> bool. disjoint (diff s1 s2) s2

(* meta remove_unused:dependency prop disjoint_diff_s2, function diff *)

function product ('a -> bool) ('b -> bool) : ('a, 'b) -> bool

axiom product_def [@useraxiom] :
  forall s1:'a -> bool, s2:'b -> bool, x:'a, y:'b.
   mem (x, y) (product s1 s2) <-> mem x s1 /\ mem y s2

(* meta remove_unused:dependency prop product_def, function product *)

function filter ('a -> bool) ('a -> bool) : 'a -> bool

axiom filter_def [@useraxiom] :
  forall s:'a -> bool, p:'a -> bool, x:'a.
   mem x (filter s p) <-> mem x s /\ infix_at p x = True

(* meta remove_unused:dependency prop filter_def, function filter *)

axiom subset_filter :
