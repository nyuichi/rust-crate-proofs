axiom Comm4 : forall x:int, y:int. infix_as x y = infix_as y x

(* clone algebra.Comm with type t4 = int, function op3 = infix_as,
  prop Comm1 = Comm4,  *)

(* meta AC function infix_as *)

(* clone algebra.CommutativeRing with type t7 = int,
