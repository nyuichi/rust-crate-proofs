{
  "version": "portable-atomic 1.15.0",
  "cargo_alias": "extra-platforms",
  "features": [
    "require-cas"
  ],
  "default_features": false,
  "scope": "host x86_64 std lifecycle; MSP alloc entry excludes scoped atomics",
  "runtime_mapping": {
    "NativeAtomic::new": "portable AtomicUsize::new",
    "NativeAtomic::decrement": "portable fetch_sub(1,Release)",
    "NativeAtomic::acquire": "portable load(Acquire)",
    "retirement final acquire": "portable fence(Acquire); on x86 current library delegates non-SeqCst fence to core fence"
  },
  "model_sorts": "unchanged stock ModelAtomic/Perm/Committer/SyncView",
  "protocol": "unchanged body and release_rmw generic rule",
  "TCB": "existing generic atomic contracts mapped to portable operations; added local Acquire fence adapter has exact stock contract. Portable implementation is not body-proved.",
