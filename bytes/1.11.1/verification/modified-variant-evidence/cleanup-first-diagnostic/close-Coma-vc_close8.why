  prop Unit_def_l5 = Unit_def_l8, prop Assoc9 = Assoc14,  *)

axiom Unitary3 : forall x:real. infix_as5 one3 x = x

axiom NonTrivialRing3 : not zero5 = one3

(* clone algebra.UnitaryCommutativeRing with type t7 = real,
