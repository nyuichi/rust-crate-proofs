function inv2 real : real

axiom Inverse : forall x:real. not x = zero5 -> infix_as5 x (inv2 x) = one3

function infix_mn1 (x:real) (y:real) : real = infix_pl5 x (prefix_mn5 y)

function infix_sl (x:real) (y:real) : real = infix_as5 x (inv2 y)

axiom add_div :
  forall x:real, y:real, z:real.
   not z = zero5 ->
   infix_sl (infix_pl5 x y) z = infix_pl5 (infix_sl x z) (infix_sl y z)

(* meta remove_unused:dependency prop add_div, function infix_sl *)

axiom sub_div :
  forall x:real, y:real, z:real.
   not z = zero5 ->
   infix_sl (infix_mn1 x y) z = infix_mn1 (infix_sl x z) (infix_sl y z)

(* meta remove_unused:dependency prop sub_div, function infix_sl *)

axiom neg_div :
  forall x:real, y:real.
   not y = zero5 -> infix_sl (prefix_mn5 x) y = prefix_mn5 (infix_sl x y)

(* meta remove_unused:dependency prop neg_div, function infix_sl *)

axiom assoc_mul_div :
  forall x:real, y:real, z:real.
   not z = zero5 -> infix_sl (infix_as5 x y) z = infix_as5 x (infix_sl y z)

(* meta remove_unused:dependency prop assoc_mul_div, function infix_sl *)

axiom assoc_div_mul :
  forall x:real, y:real, z:real.
   not y = zero5 /\ not z = zero5 ->
   infix_sl (infix_sl x y) z = infix_sl x (infix_as5 y z)

(* meta remove_unused:dependency prop assoc_div_mul, function infix_sl *)

axiom assoc_div_div :
  forall x:real, y:real, z:real.
   not y = zero5 /\ not z = zero5 ->
   infix_sl x (infix_sl y z) = infix_sl (infix_as5 x z) y

(* meta remove_unused:dependency prop assoc_div_div, function infix_sl *)

