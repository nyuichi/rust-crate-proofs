(* use real.Real *)

function from_int int : real

axiom Zero [@useraxiom] : from_int 0 = 0.0

axiom One [@useraxiom] : from_int 1 = 1.0

axiom Add [@useraxiom] :
  forall x:int, y:int.
   from_int (infix_pl x y) = infix_pl5 (from_int x) (from_int y)

axiom Sub [@useraxiom] :
  forall x:int, y:int.
   from_int (infix_mn x y) = infix_mn1 (from_int x) (from_int y)

axiom Mul [@useraxiom] :
  forall x:int, y:int.
   from_int (infix_as x y) = infix_as5 (from_int x) (from_int y)

axiom Neg [@useraxiom] :
  forall x:int. from_int (prefix_mn x) = prefix_mn5 (from_int x)

axiom Injective : forall x:int, y:int. from_int x = from_int y -> x = y

axiom Monotonic [@useraxiom] :
  forall x:int, y:int.
   infix_lseq x y -> infix_lseq2 (from_int x) (from_int y)

(* use real.FromInt *)

type t21 = <range -9223372036854775808 9223372036854775807>

function tqtint2 t21 : int

constant tqtmaxInt2 : int = 9223372036854775807

constant tqtminInt2 : int = (- 9223372036854775808)

predicate tqteq2 (a:t21) (b:t21) = tqtint2 a = tqtint2 b

axiom tqtinj2 [@W:non_conservative_extension:N] :
  forall a:t21, b:t21. tqteq2 a b -> a = b

(* meta range_type type t21, function tqtint2 *)

(* meta model_projection function tqtint2 *)

