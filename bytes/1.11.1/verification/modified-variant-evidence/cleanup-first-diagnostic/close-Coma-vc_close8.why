axiom Comm12 : forall x:real, y:real. infix_as5 x y = infix_as5 y x

(* clone algebra.Comm with type t3 = real, function op3 = infix_as5,
  prop Comm1 = Comm12,  *)

(* meta AC function infix_as5 *)

