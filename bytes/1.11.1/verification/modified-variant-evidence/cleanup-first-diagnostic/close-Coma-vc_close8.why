  prop Assoc4 = Assoc14,  *)

axiom Assoc15 :
  forall x:real, y:real, z:real.
   infix_as5 (infix_as5 x y) z = infix_as5 x (infix_as5 y z)

(* clone algebra.Assoc with type t = real, function op = infix_as5,
  prop Assoc1 = Assoc15,  *)

axiom Mul_distr_l5 :
  forall x:real, y:real, z:real.
   infix_as5 x (infix_pl5 y z) = infix_pl5 (infix_as5 x y) (infix_as5 x z)

axiom Mul_distr_r5 :
  forall x:real, y:real, z:real.
   infix_as5 (infix_pl5 y z) x = infix_pl5 (infix_as5 y x) (infix_as5 z x)

