axiom Inv_def_l7 : forall x:real. infix_pl5 (prefix_mn5 x) x = zero5

axiom Inv_def_r7 : forall x:real. infix_pl5 x (prefix_mn5 x) = zero5

(* clone algebra.Group with type t2 = real, function inv = prefix_mn5,
