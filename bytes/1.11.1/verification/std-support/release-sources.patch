--- a/src/std/sync/release_sources.rs
+++ b/src/std/sync/release_sources.rs
@@ -0,0 +1,116 @@
+//! Pure algebra for release-sequence provenance in atomic histories.
+//!
+//! These functions describe how already-established release sources flow
+//! through modifications. They do not assert which release views a native
+//! operation contributes; the atomic-operation boundary must establish those
+//! inputs from the operation's actual ordering and read-from event.
+
+use crate::{logic::FSet, prelude::*};
+
+use super::view::SyncView;
+
+/// Release views whose writes may synchronize with an acquire that observes a
+/// particular atomic modification.
+pub type ReleaseSources = FSet<SyncView>;
+
+/// A non-RMW store starts its own release history from the sources attached to
+/// that store. It does not inherit sources from the modification it replaces.
+#[logic(open, inline)]
+pub fn plain_store_sources(attached: ReleaseSources) -> ReleaseSources {
+    attached
+}
+
+/// An RMW remains in the release sequences of the exact modification it reads
+/// and can also contribute a release view of its own.
+#[logic(open, inline)]
+pub fn rmw_sources(inherited: ReleaseSources, attached: ReleaseSources) -> ReleaseSources {
+    inherited.union(attached)
+}
+
+/// An acquire observes only the release sources recorded on its read-from
+/// modification. Importing those views into a thread view is a separate
+/// synchronization step.
+#[logic(open, inline)]
+pub fn acquire_sources(observed: ReleaseSources) -> ReleaseSources {
+    observed
+}
+
+/// A plain store preserves exactly its own attached sources.
+#[check(ghost)]
+#[ensures(plain_store_sources(*attached) == *attached)]
+pub fn plain_store_source_identity(attached: Snapshot<ReleaseSources>) {}
+
+/// An RMW carries every source inherited from the exact event it read.
+#[check(ghost)]
+#[requires(inherited.contains(*source))]
+#[ensures(rmw_sources(*inherited, *attached).contains(*source))]
+pub fn rmw_preserves_inherited_source(
+    inherited: Snapshot<ReleaseSources>,
+    attached: Snapshot<ReleaseSources>,
+    source: Snapshot<SyncView>,
+) {
+    proof_assert!(rmw_sources(*inherited, *attached) == (*inherited).union(*attached));
+    proof_assert!((*inherited).contains(*source) ==> rmw_sources(*inherited, *attached).contains(*source));
+}
+
+/// An RMW carries each release view attached to its own successful event.
+#[check(ghost)]
+#[requires(attached.contains(*source))]
+#[ensures(rmw_sources(*inherited, *attached).contains(*source))]
+pub fn rmw_adds_attached_source(
+    inherited: Snapshot<ReleaseSources>,
+    attached: Snapshot<ReleaseSources>,
+    source: Snapshot<SyncView>,
+) {
+    proof_assert!(rmw_sources(*inherited, *attached) == (*inherited).union(*attached));
+    proof_assert!((*attached).contains(*source) ==> rmw_sources(*inherited, *attached).contains(*source));
+}
+
+/// A non-RMW store drops inherited release-sequence sources.
+#[check(ghost)]
+#[requires(!attached.contains(*source))]
+#[ensures(!plain_store_sources(*attached).contains(*source))]
+pub fn plain_store_drops_inherited_source(
+    attached: Snapshot<ReleaseSources>,
+    source: Snapshot<SyncView>,
+) {
+    proof_assert!(plain_store_sources(*attached) == *attached);
+}
+
+/// Representative chain: a relaxed RMW increment, followed by a release RMW
+/// decrement, then an acquire observation of the final modification. The
+/// relaxed increment contributes no source of its own, but carries the source
+/// from the modification it reads into the later release sequence.
+#[check(ghost)]
+#[requires(initial.contains(*inherited_source))]
+#[requires(decrement_attached.contains(*decrement_source))]
+#[ensures(acquire_sources(rmw_sources(
+    rmw_sources(*initial, FSet::empty()),
+    *decrement_attached,
+)).contains(*inherited_source))]
+#[ensures(acquire_sources(rmw_sources(
+    rmw_sources(*initial, FSet::empty()),
+    *decrement_attached,
+)).contains(*decrement_source))]
+pub fn relaxed_rmw_then_release_rmw_to_acquire(
+    initial: Snapshot<ReleaseSources>,
+    decrement_attached: Snapshot<ReleaseSources>,
+    inherited_source: Snapshot<SyncView>,
+    decrement_source: Snapshot<SyncView>,
+) {
+    rmw_preserves_inherited_source(
+        initial,
+        snapshot!(FSet::empty()),
+        inherited_source,
+    );
+    rmw_preserves_inherited_source(
+        snapshot!(rmw_sources(*initial, FSet::empty())),
+        decrement_attached,
+        inherited_source,
+    );
+    rmw_adds_attached_source(
+        snapshot!(rmw_sources(*initial, FSet::empty())),
+        decrement_attached,
+        decrement_source,
+    );
+}
