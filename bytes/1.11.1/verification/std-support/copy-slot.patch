+
+    /// Attempts to start a scoped worker while keeping an explicit mutable
+    /// slot owned by the parent until the worker actually begins.
+    ///
+    /// Returns `None` if the operating system cannot create the thread; the
+    /// underlying `io::Error` is discarded. On that normal return, the startup
+    /// closure was dropped without invoking `f`, so the slot is unchanged.
+    /// `F: Copy` ensures that dropping the unstarted closure cannot run a user
+    /// destructor that mutates state aliased with the slot. No guarantee is
+    /// made for other external state.
+    #[requires(forall<s: &mut S, t: Ghost<Tokens>>
+        *s == *slot && ^s == ^slot && (forall<ns> t.contains(ns)) ==>
+            f.precondition((s, t)))]
+    #[ensures(match result {
+        Some(join) => exists<s: &mut S, t: Ghost<Tokens>>
+            *s == *slot && ^s == ^slot && (forall<ns> t.contains(ns)) &&
+            forall<r> join.valid_result(r) ==> f.postcondition_once((s, t), r),
+        None => ^slot == *slot
+    })]
+    #[trusted]
+    pub fn try_spawn_with_slot<S, F, T>(
+        &mut self,
+        stack_size: Option<usize>,
+        slot: &'scope mut S,
+        f: F,
+    ) -> Option<ScopedJoinHandle<'scope, T>>
+    where
+        S: Send + 'scope,
+        F: FnOnce(&mut S, Ghost<Tokens>) -> T + Copy + Send + 'scope,
+        T: Send + 'scope,
+    {
+        let builder = match stack_size {
+            Some(size) => Builder::new().stack_size(size),
+            None => Builder::new(),
+        };
+        match builder.spawn_scoped(self.inner, move || f(slot, Tokens::new())) {
+            Ok(join) => Some(join),
+            Err(_error) => None,
+        }
+    }
 }
 
