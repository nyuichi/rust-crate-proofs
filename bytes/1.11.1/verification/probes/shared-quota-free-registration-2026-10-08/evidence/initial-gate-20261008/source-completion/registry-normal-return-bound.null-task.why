theory Task
  
  type int
  
  type real
  
  type string
  
  predicate (=) 'a 'a
  
  (* use why3.BuiltIn.BuiltIn *)
  
  type bool =
    | True
    | False
  
  (* use why3.Bool.Bool *)
  
  type tuple0 =
    | Tuple0
  
  (* use why3.Tuple0.Tuple01 *)
  
  type unit = unit
  
  (* use why3.Unit.Unit *)
  
  type t 'a =
    | T'mk (current:'a) (final:'a) (id:int)
  
  (* meta model_record function id *)
  
  (* meta model_record function final *)
  
  (* meta model_record function current *)
  
  function borrow_logic (cur:'a) (fin:'a) (id1:int) : t 'a = T'mk cur fin id1
  
  function get_id (x:t 'a) : int = x.id
  
  function inherit_id int int : int
  
  (* use creusot.prelude.MutBorrow *)
  
  type (->) 'a 'b
  
  function (@) ('a -> 'b) 'a : 'b
  
  (* use why3.HighOrd.HighOrd *)
  
  type map 'a 'b = 'a -> 'b
  
  function get (f:'a -> 'b) (x:'a) : 'b = f @ x
  
  function set (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b =
    fun (y:'a) -> if y = x then v else f @ y
  
  function ([]) (f:'a -> 'b) (x:'a) : 'b = f @ x
  
  function ([<-]) (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b = set f x v
  
  (* use map.Map *)
  
  constant zero : real = 0.0
  
  constant one : real = 1.0
  
  function (-_) real : real
  
  function (+) real real : real
  
  function ( * ) real real : real
  
  predicate (<) real real
  
  predicate (>) (x:real) (y:real) = y < x
  
  predicate (<=) (x:real) (y:real) = x < y \/ x = y
  
  predicate (>=) (x:real) (y:real) = y <= x
  
  axiom Assoc : forall x:real, y:real, z:real. ((x + y) + z) = (x + (y + z))
  
  (* clone algebra.Assoc with type t1 = real, function op = (+),
    prop Assoc1 = Assoc,  *)
  
  axiom Unit_def_l : forall x:real. (zero + x) = x
  
  axiom Unit_def_r : forall x:real. (x + zero) = x
  
  (* clone algebra.Monoid with type t2 = real, constant unit = zero,
    function op1 = (+), prop Unit_def_r1 = Unit_def_r,
    prop Unit_def_l1 = Unit_def_l, prop Assoc2 = Assoc,  *)
  
  axiom Inv_def_l : forall x:real. ((- x) + x) = zero
  
  axiom Inv_def_r : forall x:real. (x + (- x)) = zero
  
  (* clone algebra.Group with type t3 = real, function inv = (-_),
    constant unit1 = zero, function op2 = (+), prop Inv_def_r1 = Inv_def_r,
    prop Inv_def_l1 = Inv_def_l, prop Unit_def_r2 = Unit_def_r,
    prop Unit_def_l2 = Unit_def_l, prop Assoc3 = Assoc,  *)
  
  axiom Comm : forall x:real, y:real. (x + y) = (y + x)
  
  (* clone algebra.Comm with type t4 = real, function op3 = (+),
    prop Comm1 = Comm,  *)
  
  (* meta AC function (+) *)
  
  (* clone algebra.CommutativeGroup with type t5 = real,
    function inv1 = (-_), constant unit2 = zero, function op4 = (+),
    prop Comm2 = Comm, prop Inv_def_r2 = Inv_def_r,
    prop Inv_def_l2 = Inv_def_l, prop Unit_def_r3 = Unit_def_r,
    prop Unit_def_l3 = Unit_def_l, prop Assoc4 = Assoc,  *)
  
  axiom Assoc5 : forall x:real, y:real, z:real. ((x * y) * z) = (x * (y * z))
  
  (* clone algebra.Assoc with type t1 = real, function op = ( * ),
    prop Assoc1 = Assoc5,  *)
  
  axiom Mul_distr_l :
    forall x:real, y:real, z:real. (x * (y + z)) = ((x * y) + (x * z))
  
  axiom Mul_distr_r :
    forall x:real, y:real, z:real. ((y + z) * x) = ((y * x) + (z * x))
  
  (* clone algebra.Ring with type t6 = real, function ( *') = ( * ),
    function (-'_) = (-_), function (+') = (+), constant zero1 = zero,
    prop Mul_distr_r1 = Mul_distr_r, prop Mul_distr_l1 = Mul_distr_l,
    prop Assoc6 = Assoc5, prop Comm3 = Comm, prop Inv_def_r3 = Inv_def_r,
    prop Inv_def_l3 = Inv_def_l, prop Unit_def_r4 = Unit_def_r,
    prop Unit_def_l4 = Unit_def_l, prop Assoc7 = Assoc,  *)
  
  axiom Comm4 : forall x:real, y:real. (x * y) = (y * x)
  
  (* clone algebra.Comm with type t4 = real, function op3 = ( * ),
    prop Comm1 = Comm4,  *)
  
  (* meta AC function ( * ) *)
  
  (* clone algebra.CommutativeRing with type t7 = real,
    function ( *'') = ( * ), function (-''_) = (-_), function (+'') = (+),
    constant zero2 = zero, prop Comm5 = Comm4,
    prop Mul_distr_r2 = Mul_distr_r, prop Mul_distr_l2 = Mul_distr_l,
    prop Assoc8 = Assoc5, prop Comm6 = Comm, prop Inv_def_r4 = Inv_def_r,
    prop Inv_def_l4 = Inv_def_l, prop Unit_def_r5 = Unit_def_r,
    prop Unit_def_l5 = Unit_def_l, prop Assoc9 = Assoc,  *)
  
  axiom Unitary : forall x:real. (one * x) = x
  
  axiom NonTrivialRing : not zero = one
  
  (* clone algebra.UnitaryCommutativeRing with type t8 = real,
    constant one1 = one, function ( *''') = ( * ), function (-'''_) = (-_),
    function (+''') = (+), constant zero3 = zero,
    prop NonTrivialRing1 = NonTrivialRing, prop Unitary1 = Unitary,
    prop Comm7 = Comm4, prop Mul_distr_r3 = Mul_distr_r,
    prop Mul_distr_l3 = Mul_distr_l, prop Assoc10 = Assoc5,
    prop Comm8 = Comm, prop Inv_def_r5 = Inv_def_r,
    prop Inv_def_l5 = Inv_def_l, prop Unit_def_r6 = Unit_def_r,
    prop Unit_def_l6 = Unit_def_l, prop Assoc11 = Assoc,  *)
  
  function inv2 real : real
  
  axiom Inverse : forall x:real. not x = zero -> (x * inv2 x) = one
  
  function (-) (x:real) (y:real) : real = x + (- y)
  
  function (/) (x:real) (y:real) : real = x * inv2 y
  
  axiom add_div :
    forall x:real, y:real, z:real.
     not z = zero -> ((x + y) / z) = ((x / z) + (y / z))
  
  (* meta remove_unused:dependency prop add_div, function (/) *)
  
  axiom sub_div :
    forall x:real, y:real, z:real.
     not z = zero -> ((x - y) / z) = ((x / z) - (y / z))
  
  (* meta remove_unused:dependency prop sub_div, function (/) *)
  
  axiom neg_div :
    forall x:real, y:real. not y = zero -> ((- x) / y) = (- (x / y))
  
  (* meta remove_unused:dependency prop neg_div, function (/) *)
  
  axiom assoc_mul_div :
    forall x:real, y:real, z:real.
     not z = zero -> ((x * y) / z) = (x * (y / z))
  
  (* meta remove_unused:dependency prop assoc_mul_div, function (/) *)
  
  axiom assoc_div_mul :
    forall x:real, y:real, z:real.
     not y = zero /\ not z = zero -> ((x / y) / z) = (x / (y * z))
  
  (* meta remove_unused:dependency prop assoc_div_mul, function (/) *)
  
  axiom assoc_div_div :
    forall x:real, y:real, z:real.
     not y = zero /\ not z = zero -> (x / (y / z)) = ((x * z) / y)
  
  (* meta remove_unused:dependency prop assoc_div_div, function (/) *)
  
  (* clone algebra.Field with type t9 = real, function (/') = (/),
    function (-') = (-), function inv3 = inv2, constant one2 = one,
    function ( *'''') = ( * ), function (-''''_) = (-_),
    function (+'''') = (+), constant zero4 = zero,
    prop assoc_div_div1 = assoc_div_div, prop assoc_div_mul1 = assoc_div_mul,
    prop assoc_mul_div1 = assoc_mul_div, prop neg_div1 = neg_div,
    prop sub_div1 = sub_div, prop add_div1 = add_div,
    prop Inverse1 = Inverse, prop NonTrivialRing2 = NonTrivialRing,
    prop Unitary2 = Unitary, prop Comm9 = Comm4,
    prop Mul_distr_r4 = Mul_distr_r, prop Mul_distr_l4 = Mul_distr_l,
    prop Assoc12 = Assoc5, prop Comm10 = Comm, prop Inv_def_r6 = Inv_def_r,
    prop Inv_def_l6 = Inv_def_l, prop Unit_def_r7 = Unit_def_r,
    prop Unit_def_l7 = Unit_def_l, prop Assoc13 = Assoc,  *)
  
  (* clone relations.EndoRelation with type t10 = real, predicate rel = (<=),
     *)
  
  axiom Refl : forall x:real. x <= x
  
  (* clone relations.Reflexive with type t11 = real, predicate rel1 = (<=),
    prop Refl1 = Refl,  *)
  
  (* clone relations.EndoRelation with type t10 = real, predicate rel = (<=),
     *)
  
  axiom Trans : forall x:real, y:real, z:real. x <= y -> y <= z -> x <= z
  
  (* clone relations.Transitive with type t12 = real, predicate rel2 = (<=),
    prop Trans1 = Trans,  *)
  
  (* clone relations.PreOrder with type t13 = real, predicate rel3 = (<=),
    prop Trans2 = Trans, prop Refl2 = Refl,  *)
  
  (* clone relations.EndoRelation with type t10 = real, predicate rel = (<=),
     *)
  
  axiom Antisymm : forall x:real, y:real. x <= y -> y <= x -> x = y
  
  (* clone relations.Antisymmetric with type t14 = real,
    predicate rel4 = (<=), prop Antisymm1 = Antisymm,  *)
  
  (* clone relations.PartialOrder with type t15 = real,
    predicate rel5 = (<=), prop Antisymm2 = Antisymm, prop Trans3 = Trans,
    prop Refl3 = Refl,  *)
  
  (* clone relations.EndoRelation with type t10 = real, predicate rel = (<=),
     *)
  
  axiom Total : forall x:real, y:real. x <= y \/ y <= x
  
  (* clone relations.Total with type t16 = real, predicate rel6 = (<=),
    prop Total1 = Total,  *)
  
  (* clone relations.TotalOrder with type t17 = real, predicate rel7 = (<=),
    prop Total2 = Total, prop Antisymm3 = Antisymm, prop Trans4 = Trans,
    prop Refl4 = Refl,  *)
  
  axiom ZeroLessOne : zero <= one
  
  axiom CompatOrderAdd :
    forall x:real, y:real, z:real. x <= y -> (x + z) <= (y + z)
  
  axiom CompatOrderMult :
    forall x:real, y:real, z:real. x <= y -> zero <= z -> (x * z) <= (y * z)
  
  (* clone algebra.OrderedField with type t18 = real, predicate (<=') = (<=),
    function (/'') = (/), function (-'') = (-), function inv4 = inv2,
    constant one3 = one, function ( *''''') = ( * ),
    function (-'''''_) = (-_), function (+''''') = (+),
    constant zero5 = zero, prop CompatOrderMult1 = CompatOrderMult,
    prop CompatOrderAdd1 = CompatOrderAdd, prop ZeroLessOne1 = ZeroLessOne,
    prop Total3 = Total, prop Antisymm4 = Antisymm, prop Trans5 = Trans,
    prop Refl5 = Refl, prop assoc_div_div2 = assoc_div_div,
    prop assoc_div_mul2 = assoc_div_mul, prop assoc_mul_div2 = assoc_mul_div,
    prop neg_div2 = neg_div, prop sub_div2 = sub_div,
    prop add_div2 = add_div, prop Inverse2 = Inverse,
    prop NonTrivialRing3 = NonTrivialRing, prop Unitary3 = Unitary,
    prop Comm11 = Comm4, prop Mul_distr_r5 = Mul_distr_r,
    prop Mul_distr_l5 = Mul_distr_l, prop Assoc14 = Assoc5,
    prop Comm12 = Comm, prop Inv_def_r7 = Inv_def_r,
    prop Inv_def_l7 = Inv_def_l, prop Unit_def_r8 = Unit_def_r,
    prop Unit_def_l8 = Unit_def_l, prop Assoc15 = Assoc,  *)
  
  (* meta remove_unused:keep function (+) *)
  
  (* meta remove_unused:keep function (-) *)
  
  (* meta remove_unused:keep function (-_) *)
  
  (* meta remove_unused:keep predicate (<) *)
  
  (* meta remove_unused:keep predicate (<=) *)
  
  (* meta remove_unused:keep predicate (>) *)
  
  (* meta remove_unused:keep predicate (>=) *)
  
  (* use real.Real *)
  
  constant zero6 : int = 0
  
  constant one4 : int = 1
  
  function (-''''''_) int : int
  
  function (+'''''') int int : int
  
  function ( *'''''') int int : int
  
  predicate (<') int int
  
  function (-''') (x:int) (y:int) : int = x +'''''' (-'''''' y)
  
  predicate (>') (x:int) (y:int) = y <' x
  
  predicate (<='') (x:int) (y:int) = x <' y \/ x = y
  
  predicate (>=') (x:int) (y:int) = y <='' x
  
  axiom Assoc16 :
    forall x:int, y:int, z:int.
     ((x +'''''' y) +'''''' z) = (x +'''''' (y +'''''' z))
  
  (* clone algebra.Assoc with type t1 = int, function op = (+''''''),
    prop Assoc1 = Assoc16,  *)
  
  axiom Unit_def_l9 : forall x:int. (zero6 +'''''' x) = x
  
  axiom Unit_def_r9 : forall x:int. (x +'''''' zero6) = x
  
  (* clone algebra.Monoid with type t2 = int, constant unit = zero6,
    function op1 = (+''''''), prop Unit_def_r1 = Unit_def_r9,
    prop Unit_def_l1 = Unit_def_l9, prop Assoc2 = Assoc16,  *)
  
  axiom Inv_def_l8 : forall x:int. ((-'''''' x) +'''''' x) = zero6
  
  axiom Inv_def_r8 : forall x:int. (x +'''''' (-'''''' x)) = zero6
  
  (* clone algebra.Group with type t3 = int, function inv = (-''''''_),
    constant unit1 = zero6, function op2 = (+''''''),
    prop Inv_def_r1 = Inv_def_r8, prop Inv_def_l1 = Inv_def_l8,
    prop Unit_def_r2 = Unit_def_r9, prop Unit_def_l2 = Unit_def_l9,
    prop Assoc3 = Assoc16,  *)
  
  axiom Comm13 : forall x:int, y:int. (x +'''''' y) = (y +'''''' x)
  
  (* clone algebra.Comm with type t4 = int, function op3 = (+''''''),
    prop Comm1 = Comm13,  *)
  
  (* meta AC function (+'''''') *)
  
  (* clone algebra.CommutativeGroup with type t5 = int,
    function inv1 = (-''''''_), constant unit2 = zero6,
    function op4 = (+''''''), prop Comm2 = Comm13,
    prop Inv_def_r2 = Inv_def_r8, prop Inv_def_l2 = Inv_def_l8,
    prop Unit_def_r3 = Unit_def_r9, prop Unit_def_l3 = Unit_def_l9,
    prop Assoc4 = Assoc16,  *)
  
  axiom Assoc17 :
    forall x:int, y:int, z:int.
     ((x *'''''' y) *'''''' z) = (x *'''''' (y *'''''' z))
  
  (* clone algebra.Assoc with type t1 = int, function op = ( *''''''),
    prop Assoc1 = Assoc17,  *)
  
  axiom Mul_distr_l6 :
    forall x:int, y:int, z:int.
     (x *'''''' (y +'''''' z)) = ((x *'''''' y) +'''''' (x *'''''' z))
  
  axiom Mul_distr_r6 :
    forall x:int, y:int, z:int.
     ((y +'''''' z) *'''''' x) = ((y *'''''' x) +'''''' (z *'''''' x))
  
  (* clone algebra.Ring with type t6 = int, function ( *') = ( *''''''),
    function (-'_) = (-''''''_), function (+') = (+''''''),
    constant zero1 = zero6, prop Mul_distr_r1 = Mul_distr_r6,
    prop Mul_distr_l1 = Mul_distr_l6, prop Assoc6 = Assoc17,
    prop Comm3 = Comm13, prop Inv_def_r3 = Inv_def_r8,
    prop Inv_def_l3 = Inv_def_l8, prop Unit_def_r4 = Unit_def_r9,
    prop Unit_def_l4 = Unit_def_l9, prop Assoc7 = Assoc16,  *)
  
  axiom Comm14 : forall x:int, y:int. (x *'''''' y) = (y *'''''' x)
  
  (* clone algebra.Comm with type t4 = int, function op3 = ( *''''''),
    prop Comm1 = Comm14,  *)
  
  (* meta AC function ( *'''''') *)
  
  (* clone algebra.CommutativeRing with type t7 = int,
    function ( *'') = ( *''''''), function (-''_) = (-''''''_),
    function (+'') = (+''''''), constant zero2 = zero6, prop Comm5 = Comm14,
    prop Mul_distr_r2 = Mul_distr_r6, prop Mul_distr_l2 = Mul_distr_l6,
    prop Assoc8 = Assoc17, prop Comm6 = Comm13, prop Inv_def_r4 = Inv_def_r8,
    prop Inv_def_l4 = Inv_def_l8, prop Unit_def_r5 = Unit_def_r9,
    prop Unit_def_l5 = Unit_def_l9, prop Assoc9 = Assoc16,  *)
  
  axiom Unitary4 : forall x:int. (one4 *'''''' x) = x
  
  axiom NonTrivialRing4 : not zero6 = one4
  
  (* clone algebra.UnitaryCommutativeRing with type t8 = int,
    constant one1 = one4, function ( *''') = ( *''''''),
    function (-'''_) = (-''''''_), function (+''') = (+''''''),
    constant zero3 = zero6, prop NonTrivialRing1 = NonTrivialRing4,
    prop Unitary1 = Unitary4, prop Comm7 = Comm14,
    prop Mul_distr_r3 = Mul_distr_r6, prop Mul_distr_l3 = Mul_distr_l6,
    prop Assoc10 = Assoc17, prop Comm8 = Comm13,
    prop Inv_def_r5 = Inv_def_r8, prop Inv_def_l5 = Inv_def_l8,
    prop Unit_def_r6 = Unit_def_r9, prop Unit_def_l6 = Unit_def_l9,
    prop Assoc11 = Assoc16,  *)
  
  (* clone relations.EndoRelation with type t10 = int,
    predicate rel = (<=''),  *)
  
  axiom Refl6 : forall x:int. x <='' x
  
  (* clone relations.Reflexive with type t11 = int, predicate rel1 = (<=''),
    prop Refl1 = Refl6,  *)
  
  (* clone relations.EndoRelation with type t10 = int,
    predicate rel = (<=''),  *)
  
  axiom Trans6 : forall x:int, y:int, z:int. x <='' y -> y <='' z -> x <='' z
  
  (* clone relations.Transitive with type t12 = int, predicate rel2 = (<=''),
    prop Trans1 = Trans6,  *)
  
  (* clone relations.PreOrder with type t13 = int, predicate rel3 = (<=''),
    prop Trans2 = Trans6, prop Refl2 = Refl6,  *)
  
  (* clone relations.EndoRelation with type t10 = int,
    predicate rel = (<=''),  *)
  
  axiom Antisymm5 : forall x:int, y:int. x <='' y -> y <='' x -> x = y
  
  (* clone relations.Antisymmetric with type t14 = int,
    predicate rel4 = (<=''), prop Antisymm1 = Antisymm5,  *)
  
  (* clone relations.PartialOrder with type t15 = int,
    predicate rel5 = (<=''), prop Antisymm2 = Antisymm5,
    prop Trans3 = Trans6, prop Refl3 = Refl6,  *)
  
  (* clone relations.EndoRelation with type t10 = int,
    predicate rel = (<=''),  *)
  
  axiom Total4 : forall x:int, y:int. x <='' y \/ y <='' x
  
  (* clone relations.Total with type t16 = int, predicate rel6 = (<=''),
    prop Total1 = Total4,  *)
  
  (* clone relations.TotalOrder with type t17 = int, predicate rel7 = (<=''),
    prop Total2 = Total4, prop Antisymm3 = Antisymm5, prop Trans4 = Trans6,
    prop Refl4 = Refl6,  *)
  
  axiom ZeroLessOne2 : zero6 <='' one4
  
  axiom CompatOrderAdd2 :
    forall x:int, y:int, z:int. x <='' y -> (x +'''''' z) <='' (y +'''''' z)
  
  axiom CompatOrderMult2 :
    forall x:int, y:int, z:int.
     x <='' y -> zero6 <='' z -> (x *'''''' z) <='' (y *'''''' z)
  
  (* meta remove_unused:dependency prop CompatOrderMult2,
    function ( *'''''') *)
  
  (* clone algebra.OrderedUnitaryCommutativeRing with type t19 = int,
    predicate (<=''') = (<=''), constant one5 = one4,
    function ( *''''''') = ( *''''''), function (-'''''''_) = (-''''''_),
    function (+''''''') = (+''''''), constant zero7 = zero6,
    prop CompatOrderMult3 = CompatOrderMult2,
    prop CompatOrderAdd3 = CompatOrderAdd2, prop ZeroLessOne3 = ZeroLessOne2,
    prop Total5 = Total4, prop Antisymm6 = Antisymm5, prop Trans7 = Trans6,
    prop Refl7 = Refl6, prop NonTrivialRing5 = NonTrivialRing4,
    prop Unitary5 = Unitary4, prop Comm15 = Comm14,
    prop Mul_distr_r7 = Mul_distr_r6, prop Mul_distr_l7 = Mul_distr_l6,
    prop Assoc18 = Assoc17, prop Comm16 = Comm13,
    prop Inv_def_r9 = Inv_def_r8, prop Inv_def_l9 = Inv_def_l8,
    prop Unit_def_r10 = Unit_def_r9, prop Unit_def_l10 = Unit_def_l9,
    prop Assoc19 = Assoc16,  *)
  
  (* meta remove_unused:keep function (+'''''') *)
  
  (* meta remove_unused:keep function (-''') *)
  
  (* meta remove_unused:keep function (-''''''_) *)
  
  (* meta remove_unused:keep predicate (<') *)
  
  (* meta remove_unused:keep predicate (<='') *)
  
  (* meta remove_unused:keep predicate (>') *)
  
  (* meta remove_unused:keep predicate (>=') *)
  
  (* use int.Int *)
  
  function from_int int : real
  
  axiom Zero : from_int 0 = 0.0
  
  axiom One : from_int 1 = 1.0
  
  axiom Add :
    forall x:int, y:int. from_int (x +'''''' y) = (from_int x + from_int y)
  
  axiom Sub :
    forall x:int, y:int. from_int (x -''' y) = (from_int x - from_int y)
  
  axiom Mul :
    forall x:int, y:int. from_int (x *'''''' y) = (from_int x * from_int y)
  
  axiom Neg : forall x:int. from_int (-'''''' x) = (- from_int x)
  
  axiom Injective : forall x:int, y:int. from_int x = from_int y -> x = y
  
  axiom Monotonic : forall x:int, y:int. x <='' y -> from_int x <= from_int y
  
  (* use real.FromInt *)
  
  function abs (x:int) : int = if x >=' 0 then x else -'''''' x
  
  axiom Abs_le :
    forall x:int, y:int. abs x <='' y <-> (-'''''' y) <='' x /\ x <='' y
  
  (* meta remove_unused:dependency prop Abs_le, function abs *)
  
  axiom Abs_pos : forall x:int. abs x >=' 0
  
  (* meta remove_unused:dependency prop Abs_pos, function abs *)
  
  (* use int.Abs *)
  
  function div int int : int
  
  function mod int int : int
  
  axiom Div_mod :
    forall x:int, y:int.
     not y = 0 -> x = ((y *'''''' div x y) +'''''' mod x y)
  
  (* meta remove_unused:dependency prop Div_mod, function div *)
  
  (* meta remove_unused:dependency prop Div_mod, function mod *)
  
  axiom Div_bound :
    forall x:int, y:int.
     x >=' 0 /\ y >' 0 -> 0 <='' div x y /\ div x y <='' x
  
  (* meta remove_unused:dependency prop Div_bound, function div *)
  
  (* meta remove_unused:dependency prop Div_bound, function mod *)
  
  axiom Mod_bound :
    forall x:int, y:int.
     not y = 0 -> (-'''''' abs y) <' mod x y /\ mod x y <' abs y
  
  (* meta remove_unused:dependency prop Mod_bound, function div *)
  
  (* meta remove_unused:dependency prop Mod_bound, function mod *)
  
  axiom Div_sign_pos :
