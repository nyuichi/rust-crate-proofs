use real.Real
use real.FromInt
use map.Map
use int.Int

type t_FMap_Int_Excl_PositiveReal

type t_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'3] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate gt_log_Real [@inline:trivial] (self: Real.real) (other: Real.real) = [%#sord'0] Real.(<) other self

meta "rewrite_def" predicate gt_log_Real

function to_real (self: t_PositiveReal) : Real.real

axiom to_real_spec:
  forall self: t_PositiveReal [to_real self]. [%#sreal] gt_log_Real (to_real self) (FromInt.from_int 0)

function ticket_fraction [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 17 0 17 60] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : Real.real
 = [%#sfraction_map'5] match get_Int live id with
    | None -> FromInt.from_int 0
    | Some {f0 = fraction} -> to_real fraction
    end

meta "rewrite_def" function ticket_fraction

function sum_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 34 0 34 57] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : Real.real

axiom sum_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [sum_prefix live next]. ([%#sfraction_map'3] ge_log_Int next 0)
    -> sum_prefix live next
    = ([%#sfraction_map'4] if next = 0 then
      FromInt.from_int 0
    else
      Real.(+) (ticket_fraction live (next - 1)) (sum_prefix live (next - 1))
    )

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'1] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'2] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) (v: t_Excl_PositiveReal) : t_FMap_Int_Excl_PositiveReal

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap'0] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant id : int

constant fraction : t_PositiveReal

constant next : int

function insertion_outside_sum [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 68 0 68 93] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (fraction: t_PositiveReal) (next: int) : ()

goal vc_insertion_outside_sum: ([%#sfraction_map'0] ge_log_Int next 0 /\ next <= id)
  -> (if gt_log_Int next 0 then
    let last = next
    - 1 in ([@stop_split] [@expl:insert ensures] ([@stop_split] [@expl:insert ensures #0] [%#sfmap] to_mapping_Int (insert_Int live id { f0 = fraction })
        = Map.set (to_mapping_Int live) id (Some { f0 = fraction }))
      /\ ([@stop_split] [@expl:insert ensures #1] [%#sfmap'0] len_Int (insert_Int live id { f0 = fraction })
      = (if contains_Int live id then len_Int live else len_Int live + 1)))
    -> get_Int (insert_Int live id { f0 = fraction }) last = get_Int live last
    && (([@stop_split] [@expl:insertion_outside_sum requires] [%#sfraction_map'0] ge_log_Int last 0 /\ last <= id)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sfraction_map] next) ([%#sfraction_map] last)))
    /\ (([@stop_split] [@expl:insertion_outside_sum ensures] [%#sfraction_map'1] sum_prefix (insert_Int live id { f0 = fraction }) last
      = sum_prefix live last)
    -> (let _ = insertion_outside_sum live id fraction last in [@stop_split] [@expl:insertion_outside_sum ensures] [%#sfraction_map'1] sum_prefix (insert_Int live id { f0 = fraction }) next
    = sum_prefix live next))
  else
    [@stop_split] [@expl:insertion_outside_sum ensures] [%#sfraction_map'1] sum_prefix (insert_Int live id { f0 = fraction }) next
    = sum_prefix live next
  )
