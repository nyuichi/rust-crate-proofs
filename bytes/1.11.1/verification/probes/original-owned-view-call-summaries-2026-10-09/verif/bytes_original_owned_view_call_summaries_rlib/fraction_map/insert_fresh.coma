let%span sreal = "/workspace/bytes-proof-tools/bytes-proof-std/src/logic/real.rs" 136 14 136 40

use map.Map
use real.Real
use real.FromInt
use int.Int

type t_FMap_Int_Excl_PositiveReal

type t_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate gt_log_Real [@inline:trivial] (self: Real.real) (other: Real.real) = [%#sord'0] Real.(<) other self

meta "rewrite_def" predicate gt_log_Real

function to_real (self: t_PositiveReal) : Real.real

axiom to_real_spec:
  forall self: t_PositiveReal [to_real self]. [%#sreal] gt_log_Real (to_real self) (FromInt.from_int 0)

function ticket_fraction [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 17 0 17 60] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : Real.real
 = [%#sfraction_map'16] match get_Int live id with
    | None -> FromInt.from_int 0
    | Some {f0 = fraction} -> to_real fraction
    end

meta "rewrite_def" function ticket_fraction

function sum_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 34 0 34 57] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : Real.real

axiom sum_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [sum_prefix live next]. ([%#sfraction_map'7] ge_log_Int next 0)
    -> sum_prefix live next
    = ([%#sfraction_map'8] if next = 0 then
      FromInt.from_int 0
    else
      Real.(+) (ticket_fraction live (next - 1)) (sum_prefix live (next - 1))
    )

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'2] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'3] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) (v: t_Excl_PositiveReal) : t_FMap_Int_Excl_PositiveReal

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap'0] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap'1] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

function ticket_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 26 0 26 62] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : int
 = [%#sfraction_map'17] if get_Int live id = None then 0 else 1

meta "rewrite_def" function ticket_cardinality

function cardinality_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 46 0 46 64] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : int

axiom cardinality_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [cardinality_prefix live next]. ([%#sfraction_map'10] ge_log_Int next 0)
    -> cardinality_prefix live next
    = ([%#sfraction_map'11] if next = 0 then
      0
    else
      ticket_cardinality live (next - 1) + cardinality_prefix live (next - 1)
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function insertion_outside_sum [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 68 0 68 93] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (fraction: t_PositiveReal) (next: int) : ()

axiom insertion_outside_sum_def:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, fraction: t_PositiveReal, next: int [insertion_outside_sum live id fraction next]. ([%#sfraction_map'2] ge_log_Int next 0
      /\ next <= id)
    -> insertion_outside_sum live id fraction next
    = ([%#sfraction_map'13] if gt_log_Int next 0 then
      let last = next - 1 in let _ = insertion_outside_sum live id fraction last in ()
    else
      ()
    )

axiom insertion_outside_sum_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, fraction: t_PositiveReal, next: int. ([%#sfraction_map'2] ge_log_Int next 0
      /\ next <= id)
    -> ([%#sfraction_map'3] sum_prefix (insert_Int live id { f0 = fraction }) next = sum_prefix live next)

function insertion_outside_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 81 0 86 1] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (fraction: t_PositiveReal) (next: int) : ()

axiom insertion_outside_cardinality_def:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, fraction: t_PositiveReal, next: int [insertion_outside_cardinality live id fraction next]. ([%#sfraction_map'4] ge_log_Int next 0
      /\ next <= id)
    -> insertion_outside_cardinality live id fraction next
    = ([%#sfraction_map'15] if gt_log_Int next 0 then
      let last = next - 1 in let _ = insertion_outside_cardinality live id fraction last in ()
    else
      ()
    )

axiom insertion_outside_cardinality_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, fraction: t_PositiveReal, next: int. ([%#sfraction_map'4] ge_log_Int next 0
      /\ next <= id)
    -> ([%#sfraction_map'5] cardinality_prefix (insert_Int live id { f0 = fraction }) next
    = cardinality_prefix live next)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant next : int

constant fraction : t_PositiveReal

function insert_fresh [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 101 0 101 75] (live: t_FMap_Int_Excl_PositiveReal) (next: int) (fraction: t_PositiveReal) : ()

goal vc_insert_fresh: ([%#sfraction_map] ge_log_Int next 0 /\ get_Int live next = None)
  -> ([@stop_split] [@expl:insertion_outside_sum requires] [%#sfraction_map'2] ge_log_Int next 0 /\ next <= next)
  /\ (([@stop_split] [@expl:insertion_outside_sum ensures] [%#sfraction_map'3] sum_prefix (insert_Int live next { f0 = fraction }) next
    = sum_prefix live next)
  -> (let _ = insertion_outside_sum live next fraction next in ([@stop_split] [@expl:insertion_outside_cardinality requires] [%#sfraction_map'4] ge_log_Int next 0
    /\ next <= next)
  /\ (([@stop_split] [@expl:insertion_outside_cardinality ensures] [%#sfraction_map'5] cardinality_prefix (insert_Int live next { f0 = fraction }) next
    = cardinality_prefix live next)
  -> (let _ = insertion_outside_cardinality live next fraction next in [@stop_split] [@expl:insert_fresh ensures] ([@stop_split] [@expl:insert_fresh ensures #0] [%#sfraction_map'0] sum_prefix (insert_Int live next { f0 = fraction }) (next
      + 1)
    = Real.(+) (to_real fraction) (sum_prefix live next))
  /\ ([@stop_split] [@expl:insert_fresh ensures #1] [%#sfraction_map'1] cardinality_prefix (insert_Int live next { f0 = fraction }) (next
    + 1)
  = 1 + cardinality_prefix live next)))))
