let%span sfraction_map = "/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 58 8 59 69
