use map.Map
use int.Int

type t_FMap_Int_Excl_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_PositiveReal

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'3] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate ids_bounded [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 56 0 56 58] (live: t_FMap_Int_Excl_PositiveReal) (next: int) =
  [%#sfraction_map] ge_log_Int next 0 /\ (forall id: int. get_Int live id <> None -> 0 <= id /\ id < next)

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'1] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'2] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function remove_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_FMap_Int_Excl_PositiveReal

axiom remove_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap] to_mapping_Int (remove_Int self k)
    = Map.set (to_mapping_Int self) k (None)

axiom remove_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap'0] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant id : int

constant next : int

function remove_preserves_bound [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-call-summaries-2026-10-09/src/lifecycle.rs" 306 0 306 66] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (next: int) : ()

goal vc_remove_preserves_bound: ([%#slifecycle] ge_log_Int next 0 /\ ids_bounded live next)
  -> (forall key: int. get_Int (remove_Int live id) key <> None -> get_Int live key <> None /\ key <> id)
  && (forall key: int. get_Int (remove_Int live id) key <> None -> 0 <= key /\ key < next)
  && ([@stop_split] [@expl:remove_preserves_bound ensures] [%#slifecycle'0] ids_bounded (remove_Int live id) next)
