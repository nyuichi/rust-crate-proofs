# Runtime-generated verification state; immutable run archives are captured below.
/.proof-config/
/.why3find/
/target/
/verif/

# Keep expanded proof attempts local; commit only immutable archive artifacts
# and small receipts/manifests directly under evidence/.
/evidence/*
!/evidence/*.tar.gz
!/evidence/*.tar.gz.sha256
!/evidence/*.SHA256SUMS
!/evidence/*.json
!/evidence/*.json.sha256
