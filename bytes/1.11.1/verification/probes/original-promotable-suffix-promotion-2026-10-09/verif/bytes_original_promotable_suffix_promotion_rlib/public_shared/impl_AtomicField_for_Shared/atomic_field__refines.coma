use creusot.prelude.Opaque
use creusot.int.UInt64

type t_Atomic_usize

type t_Shared = { buf: Opaque.ptr; cap: UInt64.t; ref_cnt: t_Atomic_usize }

predicate inv_Atomic_usize (_1: t_Atomic_usize)

predicate inv_Shared (_1: t_Shared)

axiom inv_axiom [@rewrite]: forall x: t_Shared [inv_Shared x]. inv_Shared x = inv_Atomic_usize x.ref_cnt

predicate invariant_ref_Shared [@inline:trivial] (self: t_Shared) = [%#sinvariant] inv_Shared self

meta "rewrite_def" predicate invariant_ref_Shared

predicate inv_ref_Shared [@inline:trivial] (_1: t_Shared) = invariant_ref_Shared _1

meta "rewrite_def" predicate inv_ref_Shared

