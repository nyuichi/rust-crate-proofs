use map.Map
use map.Const
use int.Int

type t_FMap_Int_Excl_PositiveReal

type t_PositiveReal

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'0] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap] ge_log_Int (len_Int self) 0

constant empty_Int : t_FMap_Int_Excl_PositiveReal

axiom empty_Int_spec: [%#sfmap'1] len_Int empty_Int = 0

axiom empty_Int_spec'0: [%#sfmap'2] to_mapping_Int empty_Int = Const.const (None)

function empty_live_map [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-promotable-suffix-promotion-2026-10-09/src/lifecycle.rs" 738 0 738 38] (live: t_FMap_Int_Excl_PositiveReal) : ()
 = [%#slifecycle'3] ()

axiom empty_live_map_spec: forall live: t_FMap_Int_Excl_PositiveReal. ([%#slifecycle'1] len_Int live = 0)
    -> ([%#slifecycle'2] live = empty_Int)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant id : int

function contains_implies_nonempty [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-promotable-suffix-promotion-2026-10-09/src/lifecycle.rs" 748 0 748 58] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : ()

goal vc_contains_implies_nonempty: ([%#slifecycle] get_Int live id <> None)
  -> ([@stop_split] [@expl:len ensures] [%#sfmap] ge_log_Int (len_Int live) 0)
  -> (if len_Int live = 0 then
    ([@stop_split] [@expl:empty_live_map requires] [%#slifecycle'1] len_Int live = 0)
    /\ (([@stop_split] [@expl:empty_live_map ensures] [%#slifecycle'2] live = empty_Int)
    -> (let _ = empty_live_map live in get_Int live id = None
    && ([@stop_split] [@expl:contains_implies_nonempty ensures] [%#slifecycle'0] gt_log_Int (len_Int live) 0)))
  else
    [@stop_split] [@expl:contains_implies_nonempty ensures] [%#slifecycle'0] gt_log_Int (len_Int live) 0
  )
