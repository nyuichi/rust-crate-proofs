use creusot.int.UInt8
use map.Map
use creusot.prelude.Any

type t_Option_u8 = None | Some UInt8.t

type t_Excl_Option_u8 = { f0: t_Option_u8 }

type t_Option_Excl_Option_u8 = None'0 | Some'0 t_Excl_Option_u8

type t_Option_Option_Excl_Option_u8 = None'1 | Some'1 t_Option_Excl_Option_u8

type tup2_Option_Excl_Option_u8_Option_Excl_Option_u8 = { f0'0: t_Option_Excl_Option_u8; f1'0: t_Option_Excl_Option_u8 }

function map_Option_Excl_Option_u8 (self: t_Option_Excl_Option_u8) (f: Map.map t_Excl_Option_u8 t_Option_Excl_Option_u8) : t_Option_Option_Excl_Option_u8
 = [%#soption'1] match self with
    | None'0 -> None'1
    | Some'0 x -> Some'1 (Map.get f x)
    end

function op_Excl_Option_u8 (self: t_Excl_Option_u8) (_other: t_Excl_Option_u8) : t_Option_Excl_Option_u8 =
  [%#sexcl] None'0

function commutative_Excl_Option_u8 (a: t_Excl_Option_u8) (b: t_Excl_Option_u8) : ()

axiom commutative_Excl_Option_u8_spec:
  forall a: t_Excl_Option_u8, b: t_Excl_Option_u8. [%#sexcl'0] op_Excl_Option_u8 a b = op_Excl_Option_u8 b a

function op_Option_Excl_Option_u8 (self: t_Option_Excl_Option_u8) (other: t_Option_Excl_Option_u8) : t_Option_Option_Excl_Option_u8
 = [%#soption] match { f0'0 = self; f1'0 = other } with
    | {f0'0 = None'0} -> Some'1 other
    | {f1'0 = None'0} -> Some'1 self
    | {f0'0 = Some'0 x; f1'0 = Some'0 y} -> map_Option_Excl_Option_u8 (op_Excl_Option_u8 x y) (fun (z: t_Excl_Option_u8) -> Some'0 z)
    end

function commutative_Option_Excl_Option_u8 (a: t_Option_Excl_Option_u8) (b: t_Option_Excl_Option_u8) : ()

axiom commutative_Option_Excl_Option_u8_spec:
  forall a: t_Option_Excl_Option_u8, b: t_Option_Excl_Option_u8. [%#soption'0] op_Option_Excl_Option_u8 a b
    = op_Option_Excl_Option_u8 b a

type t_FMap_Int_Excl_Option_u8

function to_mapping_Int (self: t_FMap_Int_Excl_Option_u8) : Map.map int t_Option_Excl_Option_u8

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_Option_u8) (k: int) : t_Option_Excl_Option_u8 =
  [%#sfmap] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

function total_op_Int (self: t_FMap_Int_Excl_Option_u8) (other: t_FMap_Int_Excl_Option_u8) : t_FMap_Int_Excl_Option_u8

axiom total_op_Int_spec:
  forall self: t_FMap_Int_Excl_Option_u8, other: t_FMap_Int_Excl_Option_u8 [total_op_Int self other]. ([%#sfmap'0] forall k: int. op_Option_Excl_Option_u8 (get_Int self k) (get_Int other k)
        <> None'1)
    -> ([%#sfmap'1] forall k: int. Some'1 (get_Int (total_op_Int self other) k)
      = op_Option_Excl_Option_u8 (get_Int self k) (get_Int other k))

predicate ext_eq_Int (self: t_FMap_Int_Excl_Option_u8) (other: t_FMap_Int_Excl_Option_u8) =
  [%#sfmap'3] forall k: int. get_Int self k = get_Int other k

axiom ext_eq_Int_spec: forall self: t_FMap_Int_Excl_Option_u8, other: t_FMap_Int_Excl_Option_u8 [self
    = other]. [%#sfmap'2] ext_eq_Int self other = (self = other)

type t_Option_FMap_Int_Excl_Option_u8 = None'2 | Some'2 t_FMap_Int_Excl_Option_u8

function op_FMap_Int_Excl_Option_u8 (self: t_FMap_Int_Excl_Option_u8) (other: t_FMap_Int_Excl_Option_u8) : t_Option_FMap_Int_Excl_Option_u8
 = [%#sfmap'4] if forall k: int. op_Option_Excl_Option_u8 (get_Int self k) (get_Int other k) <> None'1 then
    Some'2 (total_op_Int self other)
  else
    None'2


function commutative_FMap_Int_Excl_Option_u8 (a: t_FMap_Int_Excl_Option_u8) (b: t_FMap_Int_Excl_Option_u8) : ()

axiom commutative_FMap_Int_Excl_Option_u8_spec:
  forall a: t_FMap_Int_Excl_Option_u8, b: t_FMap_Int_Excl_Option_u8. [%#sfmap'5] op_FMap_Int_Excl_Option_u8 a b
    = op_FMap_Int_Excl_Option_u8 b a

