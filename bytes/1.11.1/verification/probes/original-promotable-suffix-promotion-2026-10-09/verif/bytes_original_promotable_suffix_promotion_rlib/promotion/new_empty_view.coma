    /\ ([@stop_split] [@expl:new_empty_view ensures #1] [%#sactive'15] result.len'0 = (0: UInt64.t)
    /\ Ptr.addr_logic_u64 result.ptr'0 = Ptr.addr_logic_u64 ptr)}
    (! return {result}) ]
