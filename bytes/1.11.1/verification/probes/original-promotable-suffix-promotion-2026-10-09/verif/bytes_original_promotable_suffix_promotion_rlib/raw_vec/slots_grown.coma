use creusot.int.UInt8
use map.Map
use int.Int

type t_FMap_Int_Excl_Option_u8

type t_Option_u8 = None | Some UInt8.t

type t_Excl_Option_u8 = { f0: t_Option_u8 }

type t_Option_Excl_Option_u8 = None'0 | Some'0 t_Excl_Option_u8

function to_mapping_Int (self: t_FMap_Int_Excl_Option_u8) : Map.map int t_Option_Excl_Option_u8

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_Option_u8) (k: int) : t_Option_Excl_Option_u8 =
  [%#sfmap'1] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function len_Int (self: t_FMap_Int_Excl_Option_u8) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_Option_u8 [len_Int self]. [%#sfmap'2] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_Option_u8) (k: int) =
  [%#sfmap'3] get_Int self k <> None'0

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_Option_u8) (k: int) (v: t_Excl_Option_u8) : t_FMap_Int_Excl_Option_u8

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_Option_u8, k: int, v: t_Excl_Option_u8 [insert_Int self k v]. [%#sfmap] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some'0 v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_Option_u8, k: int, v: t_Excl_Option_u8 [insert_Int self k v]. [%#sfmap'0] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant old' : t_FMap_Int_Excl_Option_u8

constant old_capacity : int

constant capacity : int

function slots_grown [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-promotable-suffix-promotion-2026-10-09/src/../../../../src/ownership_proof/raw_vec.rs" 72 0 72 73] (old': t_FMap_Int_Excl_Option_u8) (old_capacity: int) (capacity: int) : t_FMap_Int_Excl_Option_u8

goal vc_slots_grown: ([%#sraw_vec'0] 0 <= old_capacity /\ old_capacity <= capacity)
  -> (if capacity = old_capacity then
    let result = old' in [@stop_split] [@expl:slots_grown ensures] ([@stop_split] [@expl:slots_grown ensures #0] [%#sraw_vec'1] forall index: int. index
          < old_capacity -> get_Int result index = get_Int old' index)
    /\ ([@stop_split] [@expl:slots_grown ensures #1] [%#sraw_vec'2] forall index: int. old_capacity <= index
        /\ index < capacity -> get_Int result index = Some'0 { f0 = None })
  else
    (([@stop_split] [@expl:slots_grown requires] [%#sraw_vec'0] 0 <= old_capacity /\ old_capacity <= capacity - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sraw_vec] capacity
      - old_capacity) ([%#sraw_vec] capacity - 1 - old_capacity)))
    /\ (([@stop_split] [@expl:slots_grown ensures] ([@stop_split] [@expl:slots_grown ensures #0] [%#sraw_vec'1] forall index: int. index
            < old_capacity -> get_Int (slots_grown old' old_capacity (capacity - 1)) index = get_Int old' index)
      /\ ([@stop_split] [@expl:slots_grown ensures #1] [%#sraw_vec'2] forall index: int. old_capacity <= index
          /\ index < capacity - 1
        -> get_Int (slots_grown old' old_capacity (capacity - 1)) index = Some'0 { f0 = None }))
    -> ([@stop_split] [@expl:insert ensures] ([@stop_split] [@expl:insert ensures #0] [%#sfmap] to_mapping_Int (insert_Int (slots_grown old' old_capacity (capacity
          - 1)) (capacity - 1) { f0 = None })
        = Map.set (to_mapping_Int (slots_grown old' old_capacity (capacity - 1))) (capacity - 1) (Some'0 { f0 = None }))
      /\ ([@stop_split] [@expl:insert ensures #1] [%#sfmap'0] len_Int (insert_Int (slots_grown old' old_capacity (capacity
        - 1)) (capacity - 1) { f0 = None })
      = (if contains_Int (slots_grown old' old_capacity (capacity - 1)) (capacity - 1) then
        len_Int (slots_grown old' old_capacity (capacity - 1))
      else
        len_Int (slots_grown old' old_capacity (capacity - 1)) + 1
      )))
    -> (let result = insert_Int (slots_grown old' old_capacity (capacity - 1)) (capacity
    - 1) { f0 = None } in [@stop_split] [@expl:slots_grown ensures] ([@stop_split] [@expl:slots_grown ensures #0] [%#sraw_vec'1] forall index: int. index
          < old_capacity -> get_Int result index = get_Int old' index)
    /\ ([@stop_split] [@expl:slots_grown ensures #1] [%#sraw_vec'2] forall index: int. old_capacity <= index
        /\ index < capacity -> get_Int result index = Some'0 { f0 = None })))
  )
