      /\ gt_log_Int (get_timestamp_AtomicPtr_unit (pointer_model field) (fin_Ghost_refmut_SyncView current')) t
      /\ val_AtomicPtr_unit (fin_Ghost_refmut_Perm_AtomicPtr_unit own)
      = insert_Int (val_AtomicPtr_unit own.current) (t + 1) { f0 = new; f1 = fin_Ghost_refmut_SyncView current' })}
    (! return {result}) ]
