use map.Map
use map.Const
use int.Int

type t_FMap_Int_Excl_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_PositiveReal

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'5] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate ids_bounded [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 56 0 56 58] (live: t_FMap_Int_Excl_PositiveReal) (next: int) =
  [%#sfraction_map'7] ge_log_Int next 0 /\ (forall id: int. get_Int live id <> None -> 0 <= id /\ id < next)

function ticket_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 26 0 26 62] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : int
 = [%#sfraction_map'13] if get_Int live id = None then 0 else 1

meta "rewrite_def" function ticket_cardinality

function cardinality_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 46 0 46 64] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : int

axiom cardinality_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [cardinality_prefix live next]. ([%#sfraction_map'6] ge_log_Int next 0)
    -> cardinality_prefix live next
    = ([%#sfraction_map'9] if next = 0 then
      0
    else
      ticket_cardinality live (next - 1) + cardinality_prefix live (next - 1)
    )

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'2] ge_log_Int (len_Int self) 0

constant empty_Int : t_FMap_Int_Excl_PositiveReal

axiom empty_Int_spec: [%#sfmap] len_Int empty_Int = 0

axiom empty_Int_spec'0: [%#sfmap'0] to_mapping_Int empty_Int = Const.const (None)

predicate ext_eq_Int (self: t_FMap_Int_Excl_PositiveReal) (other: t_FMap_Int_Excl_PositiveReal) =
  [%#sfmap'6] forall k: int. get_Int self k = get_Int other k

axiom ext_eq_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal, other: t_FMap_Int_Excl_PositiveReal [self
    = other]. [%#sfmap'1] ext_eq_Int self other = (self = other)

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'7] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function remove_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_FMap_Int_Excl_PositiveReal

axiom remove_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap'3] to_mapping_Int (remove_Int self k)
    = Map.set (to_mapping_Int self) k (None)

axiom remove_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap'4] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function remove_last_preserves_prefix_bound [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 178 0 178 73] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : ()
 = [%#sfraction_map'10] let last = next - 1 in ()

axiom remove_last_preserves_prefix_bound_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int. ([%#sfraction_map'2] gt_log_Int next 0 /\ ids_bounded live next)
    -> ([%#sfraction_map'3] ids_bounded (remove_Int live (next - 1)) (next - 1))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function removal_outside_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 134 0 134 75] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (next: int) : ()

axiom removal_outside_cardinality_def:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int [removal_outside_cardinality live id next]. ([%#sfraction_map'4] ge_log_Int next 0
      /\ next <= id)
    -> removal_outside_cardinality live id next
    = ([%#sfraction_map'12] if gt_log_Int next 0 then
      let last = next - 1 in let _ = removal_outside_cardinality live id last in ()
    else
      ()
    )

axiom removal_outside_cardinality_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int. ([%#sfraction_map'4] ge_log_Int next 0 /\ next <= id)
    -> ([%#sfraction_map'5] cardinality_prefix (remove_Int live id) next = cardinality_prefix live next)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant next : int

function cardinality_prefix_is_len [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-bytes-cursor-closure-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 194 0 194 64] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : ()

goal vc_cardinality_prefix_is_len: ([%#sfraction_map'0] ids_bounded live next)
  -> (if next = 0 then
    (forall key: int. get_Int live key = None)
    && (([@stop_split] [@expl:empty ensures] ([@stop_split] [@expl:empty ensures #0] [%#sfmap] len_Int empty_Int = 0)
      /\ ([@stop_split] [@expl:empty ensures #1] [%#sfmap'0] to_mapping_Int empty_Int = Const.const (None)))
    -> ([@stop_split] [@expl:ext_eq ensures] [%#sfmap'1] ext_eq_Int live empty_Int = (live = empty_Int))
    -> ext_eq_Int live empty_Int
    && (([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int live) 0)
    -> len_Int live = 0
    && ([@stop_split] [@expl:cardinality_prefix_is_len ensures] [%#sfraction_map'1] cardinality_prefix live next
    = len_Int live)))
  else
    let last = next
    - 1 in ([@stop_split] [@expl:remove ensures] ([@stop_split] [@expl:remove ensures #0] [%#sfmap'3] to_mapping_Int (remove_Int live last)
        = Map.set (to_mapping_Int live) last (None))
      /\ ([@stop_split] [@expl:remove ensures #1] [%#sfmap'4] len_Int (remove_Int live last)
      = (if contains_Int live last then len_Int live - 1 else len_Int live)))
    -> (let remaining = remove_Int live last in ([@stop_split] [@expl:remove_last_preserves_prefix_bound requires] [%#sfraction_map'2] gt_log_Int next 0
      /\ ids_bounded live next)
    /\ (([@stop_split] [@expl:remove_last_preserves_prefix_bound ensures] [%#sfraction_map'3] ids_bounded (remove_Int live (next
      - 1)) (next - 1))
    -> (let _ = remove_last_preserves_prefix_bound live next in (([@stop_split] [@expl:cardinality_prefix_is_len requires] [%#sfraction_map'0] ids_bounded remaining last)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sfraction_map] next) ([%#sfraction_map] last)))
    /\ (([@stop_split] [@expl:cardinality_prefix_is_len ensures] [%#sfraction_map'1] cardinality_prefix remaining last
      = len_Int remaining)
    -> (let _ = cardinality_prefix_is_len remaining last in ([@stop_split] [@expl:removal_outside_cardinality requires] [%#sfraction_map'4] ge_log_Int last 0
      /\ last <= last)
    /\ (([@stop_split] [@expl:removal_outside_cardinality ensures] [%#sfraction_map'5] cardinality_prefix (remove_Int live last) last
      = cardinality_prefix live last)
    -> (let _ = removal_outside_cardinality live last last in ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int next 0)
    /\ ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int last 0)
    /\ cardinality_prefix live next = ticket_cardinality live last + cardinality_prefix live last
    && ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int last 0)
    /\ ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int last 0)
    /\ cardinality_prefix live last = cardinality_prefix remaining last
    && (if get_Int live last = None then
      ticket_cardinality live last = 0
      && (([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int remaining) 0)
      -> ([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int live) 0)
      -> len_Int remaining = len_Int live
      && ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int next 0)
      /\ (([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int live) 0)
      -> cardinality_prefix live next = len_Int live
      && ([@stop_split] [@expl:cardinality_prefix_is_len ensures] [%#sfraction_map'1] cardinality_prefix live next
      = len_Int live)))
    else
      ticket_cardinality live last = 1
      && (([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int remaining) 0)
      -> ([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int live) 0)
      -> len_Int remaining = len_Int live - 1
      && ([@stop_split] [@expl:cardinality_prefix requires] [%#sfraction_map'6] ge_log_Int next 0)
      /\ (([@stop_split] [@expl:len ensures] [%#sfmap'2] ge_log_Int (len_Int live) 0)
      -> cardinality_prefix live next = len_Int live
      && ([@stop_split] [@expl:cardinality_prefix_is_len ensures] [%#sfraction_map'1] cardinality_prefix live next
      = len_Int live)))
    ))))))))
  )
