type t_Excl_Option_u8 = { f0: t_Option_u8 }

type t_Option_Excl_Option_u8 = None'0 | Some'0 t_Excl_Option_u8

function to_mapping_Int (self: t_FMap_Int_Excl_Option_u8) : Map.map int t_Option_Excl_Option_u8

