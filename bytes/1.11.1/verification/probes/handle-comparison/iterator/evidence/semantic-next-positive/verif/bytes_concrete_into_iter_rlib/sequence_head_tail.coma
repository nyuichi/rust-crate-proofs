use creusot.int.UInt8
use seq.Seq
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant bytes : Seq.seq UInt8.t

function sequence_head_tail [#"/workspace/bytes-proof-tools/targets/bytes/debug/build/bytes-concrete-into-iter-3c9a44e1c143b68b/out/actual_iterator.rs" 86 0 86 37] (bytes: Seq.seq UInt8.t) : ()

goal vc_sequence_head_tail: ([%#sactual_iterator] gt_log_Int (Seq.length bytes) 0)
  -> ([@stop_split] [@expl:sequence_head_tail ensures] [%#sactual_iterator'0] bytes
  = Seq.(++) (Seq.singleton (Seq.get bytes 0)) (index_Seq_u8 bytes { start = 1 }))
