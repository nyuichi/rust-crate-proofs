use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq

type t_IntoIter_ref_slice_u8 = { inner: Slice64.slice UInt8.t }

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

predicate postcondition_size_hint (self: ()) (args: t_IntoIter_ref_slice_u8) (result: tup2_usize_Option_usize) =
  [%#sactual_iterator'2] let self'0 = args in [%#sactual_iterator'1] UInt64.t'int result.f0
    = Seq.length (Slice64.view self'0.inner)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

let size_hint_IntoIter_ref_slice_u8 (self: t_IntoIter_ref_slice_u8) (return (x: tup2_usize_Option_usize)) = any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] [%#sactual_iterator'1] UInt64.t'int result.f0
      = Seq.length (Slice64.view self.inner)
    /\ result.f1 = Some (result.f0)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_IntoIter_ref_slice_u8, r: tup2_usize_Option_usize. ([%#siter] postcondition_size_hint () self r)
    -> ([%#sactual_iterator] postcondition_size_hint () self r)
    /\ (forall result: (). ([%#sactual_iterator'0] r.f1 = Some (r.f0)) -> ([%#siter'0] r.f1 = Some (r.f0)))
