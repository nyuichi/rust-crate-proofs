axiom extensionality2 [@useraxiom] :
  forall x:t19, y:t19 [tqtint2 x, tqtint2 y]. tqtint2 x = tqtint2 y -> x = y

predicate in_bounds2 [@inline:trivial] (n:int) =
  infix_lseq 0 n /\ infix_lseq n 0xFFFFFFFF

function of_int2 int : t19

axiom to_of_int2 [@useraxiom] :
  forall x:int [of_int2 x]. in_bounds2 x -> tqtint2 (of_int2 x) = x

function add2 t19 t19 : t19

axiom add_in_bounds2 [@useraxiom] :
