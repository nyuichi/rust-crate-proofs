use map.Map
use real.Real
use real.FromInt
use int.Int

type t_FMap_Int_Excl_PositiveReal

type t_PositiveReal

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'1] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Real [@inline:trivial] (self: Real.real) (other: Real.real) = [%#sord] Real.(<) other self

meta "rewrite_def" predicate gt_log_Real

function to_real (self: t_PositiveReal) : Real.real

axiom to_real_spec:
  forall self: t_PositiveReal [to_real self]. [%#sreal] gt_log_Real (to_real self) (FromInt.from_int 0)

function ticket_fraction [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 17 0 17 60] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : Real.real
 = [%#sfraction_map'18] match get_Int live id with
    | None -> FromInt.from_int 0
    | Some {f0 = fraction} -> to_real fraction
    end

meta "rewrite_def" function ticket_fraction

function sum_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 34 0 34 57] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : Real.real

axiom sum_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [sum_prefix live next]. ([%#sfraction_map'9] ge_log_Int next 0)
    -> sum_prefix live next
    = ([%#sfraction_map'10] if next = 0 then
      FromInt.from_int 0
    else
      Real.(+) (ticket_fraction live (next - 1)) (sum_prefix live (next - 1))
    )

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'2] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'3] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function remove_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_FMap_Int_Excl_PositiveReal

axiom remove_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap] to_mapping_Int (remove_Int self k)
    = Map.set (to_mapping_Int self) k (None)

axiom remove_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap'0] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

function ticket_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 26 0 26 62] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : int
 = [%#sfraction_map'19] if get_Int live id = None then 0 else 1

meta "rewrite_def" function ticket_cardinality

function cardinality_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 46 0 46 64] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : int

axiom cardinality_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [cardinality_prefix live next]. ([%#sfraction_map'12] ge_log_Int next 0)
    -> cardinality_prefix live next
    = ([%#sfraction_map'13] if next = 0 then
      0
    else
      ticket_cardinality live (next - 1) + cardinality_prefix live (next - 1)
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function removal_outside_sum [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 121 0 121 67] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (next: int) : ()

axiom removal_outside_sum_def:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int [removal_outside_sum live id next]. ([%#sfraction_map'4] ge_log_Int next 0
      /\ next <= id)
    -> removal_outside_sum live id next
    = ([%#sfraction_map'15] if gt_log_Int next 0 then
      let last = next - 1 in let _ = removal_outside_sum live id last in ()
    else
      ()
    )

axiom removal_outside_sum_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int. ([%#sfraction_map'4] ge_log_Int next 0 /\ next <= id)
    -> ([%#sfraction_map'5] sum_prefix (remove_Int live id) next = sum_prefix live next)

function removal_outside_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 134 0 134 75] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (next: int) : ()

axiom removal_outside_cardinality_def:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int [removal_outside_cardinality live id next]. ([%#sfraction_map'6] ge_log_Int next 0
      /\ next <= id)
    -> removal_outside_cardinality live id next
    = ([%#sfraction_map'17] if gt_log_Int next 0 then
      let last = next - 1 in let _ = removal_outside_cardinality live id last in ()
    else
      ()
    )

axiom removal_outside_cardinality_spec:
  forall live: t_FMap_Int_Excl_PositiveReal, id: int, next: int. ([%#sfraction_map'6] ge_log_Int next 0 /\ next <= id)
    -> ([%#sfraction_map'7] cardinality_prefix (remove_Int live id) next = cardinality_prefix live next)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant id : int

constant fraction : t_PositiveReal

constant next : int

function remove_known [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 149 0 149 84] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (fraction: t_PositiveReal) (next: int) : ()

goal vc_remove_known: ([%#sfraction_map'0] 0 <= id /\ id < next)
  -> ([%#sfraction_map'1] get_Int live id = Some { f0 = fraction })
  -> (if gt_log_Int next (id + 1) then
    let last = next
    - 1 in ([@stop_split] [@expl:remove ensures] ([@stop_split] [@expl:remove ensures #0] [%#sfmap] to_mapping_Int (remove_Int live id)
        = Map.set (to_mapping_Int live) id (None))
      /\ ([@stop_split] [@expl:remove ensures #1] [%#sfmap'0] len_Int (remove_Int live id)
      = (if contains_Int live id then len_Int live - 1 else len_Int live)))
    -> get_Int (remove_Int live id) last = get_Int live last
    && (([@stop_split] [@expl:remove_known requires] ([@stop_split] [@expl:remove_known requires #0] [%#sfraction_map'0] 0
            <= id
          /\ id < last)
        /\ ([@stop_split] [@expl:remove_known requires #1] [%#sfraction_map'1] get_Int live id
        = Some { f0 = fraction }))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sfraction_map] next) ([%#sfraction_map] last)))
    /\ (([@stop_split] [@expl:remove_known ensures] ([@stop_split] [@expl:remove_known ensures #0] [%#sfraction_map'2] sum_prefix live last
        = Real.(+) (sum_prefix (remove_Int live id) last) (to_real fraction))
      /\ ([@stop_split] [@expl:remove_known ensures #1] [%#sfraction_map'3] cardinality_prefix live last
      = cardinality_prefix (remove_Int live id) last + 1))
    -> (let _ = remove_known live id fraction last in [@stop_split] [@expl:remove_known ensures] ([@stop_split] [@expl:remove_known ensures #0] [%#sfraction_map'2] sum_prefix live next
      = Real.(+) (sum_prefix (remove_Int live id) next) (to_real fraction))
    /\ ([@stop_split] [@expl:remove_known ensures #1] [%#sfraction_map'3] cardinality_prefix live next
    = cardinality_prefix (remove_Int live id) next + 1)))
  else
    next = id + 1
    && ([@stop_split] [@expl:removal_outside_sum requires] [%#sfraction_map'4] ge_log_Int id 0 /\ id <= id)
    /\ (([@stop_split] [@expl:removal_outside_sum ensures] [%#sfraction_map'5] sum_prefix (remove_Int live id) id
      = sum_prefix live id)
    -> (let _ = removal_outside_sum live id id in ([@stop_split] [@expl:removal_outside_cardinality requires] [%#sfraction_map'6] ge_log_Int id 0
      /\ id <= id)
    /\ (([@stop_split] [@expl:removal_outside_cardinality ensures] [%#sfraction_map'7] cardinality_prefix (remove_Int live id) id
      = cardinality_prefix live id)
    -> (let _ = removal_outside_cardinality live id id in [@stop_split] [@expl:remove_known ensures] ([@stop_split] [@expl:remove_known ensures #0] [%#sfraction_map'2] sum_prefix live next
      = Real.(+) (sum_prefix (remove_Int live id) next) (to_real fraction))
    /\ ([@stop_split] [@expl:remove_known ensures #1] [%#sfraction_map'3] cardinality_prefix live next
    = cardinality_prefix (remove_Int live id) next + 1)))))
  )
