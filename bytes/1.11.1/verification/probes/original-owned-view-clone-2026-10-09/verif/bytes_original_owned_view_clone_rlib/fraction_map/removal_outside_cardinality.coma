use map.Map
use int.Int

type t_FMap_Int_Excl_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_PositiveReal

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'3] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

function ticket_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 26 0 26 62] [@inline:trivial] (live: t_FMap_Int_Excl_PositiveReal) (id: int) : int
 = [%#sfraction_map'5] if get_Int live id = None then 0 else 1

meta "rewrite_def" function ticket_cardinality

function cardinality_prefix [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 46 0 46 64] (live: t_FMap_Int_Excl_PositiveReal) (next: int) : int

axiom cardinality_prefix_def:
  forall live: t_FMap_Int_Excl_PositiveReal, next: int [cardinality_prefix live next]. ([%#sfraction_map'3] ge_log_Int next 0)
    -> cardinality_prefix live next
    = ([%#sfraction_map'4] if next = 0 then
      0
    else
      ticket_cardinality live (next - 1) + cardinality_prefix live (next - 1)
    )

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'1] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'2] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function remove_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_FMap_Int_Excl_PositiveReal

axiom remove_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap] to_mapping_Int (remove_Int self k)
    = Map.set (to_mapping_Int self) k (None)

axiom remove_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int [remove_Int self k]. [%#sfmap'0] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant id : int

constant next : int

function removal_outside_cardinality [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-owned-view-clone-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 134 0 134 75] (live: t_FMap_Int_Excl_PositiveReal) (id: int) (next: int) : ()

goal vc_removal_outside_cardinality: ([%#sfraction_map'0] ge_log_Int next 0 /\ next <= id)
  -> (if gt_log_Int next 0 then
    let last = next
    - 1 in ([@stop_split] [@expl:remove ensures] ([@stop_split] [@expl:remove ensures #0] [%#sfmap] to_mapping_Int (remove_Int live id)
        = Map.set (to_mapping_Int live) id (None))
      /\ ([@stop_split] [@expl:remove ensures #1] [%#sfmap'0] len_Int (remove_Int live id)
      = (if contains_Int live id then len_Int live - 1 else len_Int live)))
    -> get_Int (remove_Int live id) last = get_Int live last
    && (([@stop_split] [@expl:removal_outside_cardinality requires] [%#sfraction_map'0] ge_log_Int last 0 /\ last <= id)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sfraction_map] next) ([%#sfraction_map] last)))
    /\ (([@stop_split] [@expl:removal_outside_cardinality ensures] [%#sfraction_map'1] cardinality_prefix (remove_Int live id) last
      = cardinality_prefix live last)
    -> (let _ = removal_outside_cardinality live id last in [@stop_split] [@expl:removal_outside_cardinality ensures] [%#sfraction_map'1] cardinality_prefix (remove_Int live id) next
    = cardinality_prefix live next))
  else
    [@stop_split] [@expl:removal_outside_cardinality ensures] [%#sfraction_map'1] cardinality_prefix (remove_Int live id) next
    = cardinality_prefix live next
  )
