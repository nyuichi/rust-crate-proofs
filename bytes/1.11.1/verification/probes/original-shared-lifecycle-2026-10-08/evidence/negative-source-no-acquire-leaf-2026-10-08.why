theory Task
  
  type int
  
  type real
  
  type string
  
  predicate (=) 'a 'a
  
  (* use why3.BuiltIn.BuiltIn *)
  
  type bool =
    | True
    | False
  
  (* use why3.Bool.Bool *)
  
  type tuple0 =
    | Tuple0
  
  (* use why3.Tuple0.Tuple01 *)
  
  type unit = unit
  
  (* use why3.Unit.Unit *)
  
  type ptr
  
  function thin ptr : ptr
  
  type foreign
  
  (* use creusot.prelude.Opaque *)
  
  constant zero : int = 0
  
  constant one : int = 1
  
  function (-_) int : int
  
  function (+) int int : int
  
  function ( * ) int int : int
  
  predicate (<) int int
  
  function (-) (x:int) (y:int) : int = x + (- y)
  
  predicate (>) (x:int) (y:int) = y < x
  
  predicate (<=) (x:int) (y:int) = x < y \/ x = y
  
  predicate (>=) (x:int) (y:int) = y <= x
  
  axiom Assoc : forall x:int, y:int, z:int. ((x + y) + z) = (x + (y + z))
  
  (* clone algebra.Assoc with type t = int, function op = (+),
    prop Assoc1 = Assoc,  *)
  
  axiom Unit_def_l : forall x:int. (zero + x) = x
  
  axiom Unit_def_r : forall x:int. (x + zero) = x
  
  (* clone algebra.Monoid with type t1 = int, constant unit = zero,
    function op1 = (+), prop Unit_def_r1 = Unit_def_r,
    prop Unit_def_l1 = Unit_def_l, prop Assoc2 = Assoc,  *)
  
  axiom Inv_def_l : forall x:int. ((- x) + x) = zero
  
  axiom Inv_def_r : forall x:int. (x + (- x)) = zero
  
  (* clone algebra.Group with type t2 = int, function inv = (-_),
    constant unit1 = zero, function op2 = (+), prop Inv_def_r1 = Inv_def_r,
    prop Inv_def_l1 = Inv_def_l, prop Unit_def_r2 = Unit_def_r,
    prop Unit_def_l2 = Unit_def_l, prop Assoc3 = Assoc,  *)
  
  axiom Comm : forall x:int, y:int. (x + y) = (y + x)
  
  (* clone algebra.Comm with type t3 = int, function op3 = (+),
    prop Comm1 = Comm,  *)
  
  (* meta AC function (+) *)
  
  (* clone algebra.CommutativeGroup with type t4 = int, function inv1 = (-_),
    constant unit2 = zero, function op4 = (+), prop Comm2 = Comm,
    prop Inv_def_r2 = Inv_def_r, prop Inv_def_l2 = Inv_def_l,
    prop Unit_def_r3 = Unit_def_r, prop Unit_def_l3 = Unit_def_l,
    prop Assoc4 = Assoc,  *)
  
  axiom Assoc5 : forall x:int, y:int, z:int. ((x * y) * z) = (x * (y * z))
  
  (* clone algebra.Assoc with type t = int, function op = ( * ),
    prop Assoc1 = Assoc5,  *)
  
  axiom Mul_distr_l :
    forall x:int, y:int, z:int. (x * (y + z)) = ((x * y) + (x * z))
  
  axiom Mul_distr_r :
    forall x:int, y:int, z:int. ((y + z) * x) = ((y * x) + (z * x))
  
  (* clone algebra.Ring with type t5 = int, function ( *') = ( * ),
    function (-'_) = (-_), function (+') = (+), constant zero1 = zero,
    prop Mul_distr_r1 = Mul_distr_r, prop Mul_distr_l1 = Mul_distr_l,
    prop Assoc6 = Assoc5, prop Comm3 = Comm, prop Inv_def_r3 = Inv_def_r,
    prop Inv_def_l3 = Inv_def_l, prop Unit_def_r4 = Unit_def_r,
    prop Unit_def_l4 = Unit_def_l, prop Assoc7 = Assoc,  *)
  
  axiom Comm4 : forall x:int, y:int. (x * y) = (y * x)
  
  (* clone algebra.Comm with type t3 = int, function op3 = ( * ),
    prop Comm1 = Comm4,  *)
  
  (* meta AC function ( * ) *)
  
  (* clone algebra.CommutativeRing with type t6 = int,
    function ( *'') = ( * ), function (-''_) = (-_), function (+'') = (+),
    constant zero2 = zero, prop Comm5 = Comm4,
    prop Mul_distr_r2 = Mul_distr_r, prop Mul_distr_l2 = Mul_distr_l,
    prop Assoc8 = Assoc5, prop Comm6 = Comm, prop Inv_def_r4 = Inv_def_r,
    prop Inv_def_l4 = Inv_def_l, prop Unit_def_r5 = Unit_def_r,
    prop Unit_def_l5 = Unit_def_l, prop Assoc9 = Assoc,  *)
  
  axiom Unitary : forall x:int. (one * x) = x
  
  axiom NonTrivialRing : not zero = one
  
  (* clone algebra.UnitaryCommutativeRing with type t7 = int,
    constant one1 = one, function ( *''') = ( * ), function (-'''_) = (-_),
    function (+''') = (+), constant zero3 = zero,
    prop NonTrivialRing1 = NonTrivialRing, prop Unitary1 = Unitary,
    prop Comm7 = Comm4, prop Mul_distr_r3 = Mul_distr_r,
    prop Mul_distr_l3 = Mul_distr_l, prop Assoc10 = Assoc5,
    prop Comm8 = Comm, prop Inv_def_r5 = Inv_def_r,
    prop Inv_def_l5 = Inv_def_l, prop Unit_def_r6 = Unit_def_r,
    prop Unit_def_l6 = Unit_def_l, prop Assoc11 = Assoc,  *)
  
  (* clone relations.EndoRelation with type t8 = int, predicate rel = (<=),
     *)
  
  axiom Refl : forall x:int. x <= x
  
  (* clone relations.Reflexive with type t9 = int, predicate rel1 = (<=),
    prop Refl1 = Refl,  *)
  
  (* clone relations.EndoRelation with type t8 = int, predicate rel = (<=),
     *)
  
  axiom Trans : forall x:int, y:int, z:int. x <= y -> y <= z -> x <= z
  
  (* clone relations.Transitive with type t10 = int, predicate rel2 = (<=),
    prop Trans1 = Trans,  *)
  
  (* clone relations.PreOrder with type t11 = int, predicate rel3 = (<=),
    prop Trans2 = Trans, prop Refl2 = Refl,  *)
  
  (* clone relations.EndoRelation with type t8 = int, predicate rel = (<=),
     *)
  
  axiom Antisymm : forall x:int, y:int. x <= y -> y <= x -> x = y
  
  (* clone relations.Antisymmetric with type t12 = int,
    predicate rel4 = (<=), prop Antisymm1 = Antisymm,  *)
  
  (* clone relations.PartialOrder with type t13 = int, predicate rel5 = (<=),
    prop Antisymm2 = Antisymm, prop Trans3 = Trans, prop Refl3 = Refl,  *)
  
  (* clone relations.EndoRelation with type t8 = int, predicate rel = (<=),
     *)
  
  axiom Total : forall x:int, y:int. x <= y \/ y <= x
  
  (* clone relations.Total with type t14 = int, predicate rel6 = (<=),
    prop Total1 = Total,  *)
  
  (* clone relations.TotalOrder with type t15 = int, predicate rel7 = (<=),
    prop Total2 = Total, prop Antisymm3 = Antisymm, prop Trans4 = Trans,
    prop Refl4 = Refl,  *)
  
  axiom ZeroLessOne : zero <= one
  
  axiom CompatOrderAdd :
    forall x:int, y:int, z:int. x <= y -> (x + z) <= (y + z)
  
  axiom CompatOrderMult :
    forall x:int, y:int, z:int. x <= y -> zero <= z -> (x * z) <= (y * z)
  
  (* meta remove_unused:dependency prop CompatOrderMult, function ( * ) *)
  
  (* clone algebra.OrderedUnitaryCommutativeRing with type t16 = int,
    predicate (<=') = (<=), constant one2 = one, function ( *'''') = ( * ),
    function (-''''_) = (-_), function (+'''') = (+), constant zero4 = zero,
    prop CompatOrderMult1 = CompatOrderMult,
    prop CompatOrderAdd1 = CompatOrderAdd, prop ZeroLessOne1 = ZeroLessOne,
    prop Total3 = Total, prop Antisymm4 = Antisymm, prop Trans5 = Trans,
    prop Refl5 = Refl, prop NonTrivialRing2 = NonTrivialRing,
    prop Unitary2 = Unitary, prop Comm9 = Comm4,
    prop Mul_distr_r4 = Mul_distr_r, prop Mul_distr_l4 = Mul_distr_l,
    prop Assoc12 = Assoc5, prop Comm10 = Comm, prop Inv_def_r6 = Inv_def_r,
    prop Inv_def_l6 = Inv_def_l, prop Unit_def_r7 = Unit_def_r,
    prop Unit_def_l7 = Unit_def_l, prop Assoc13 = Assoc,  *)
  
  (* meta remove_unused:keep function (+) *)
  
  (* meta remove_unused:keep function (-) *)
  
  (* meta remove_unused:keep function (-_) *)
  
  (* meta remove_unused:keep predicate (<) *)
  
  (* meta remove_unused:keep predicate (<=) *)
  
  (* meta remove_unused:keep predicate (>) *)
  
  (* meta remove_unused:keep predicate (>=) *)
  
  (* use int.Int *)
  
  function abs (x:int) : int = if x >= 0 then x else - x
  
  axiom Abs_le : forall x:int, y:int. abs x <= y <-> (- y) <= x /\ x <= y
  
  (* meta remove_unused:dependency prop Abs_le, function abs *)
  
  axiom Abs_pos : forall x:int. abs x >= 0
  
  (* meta remove_unused:dependency prop Abs_pos, function abs *)
  
  (* use int.Abs *)
  
  function div int int : int
  
  function mod int int : int
  
  axiom Div_mod :
    forall x:int, y:int. not y = 0 -> x = ((y * div x y) + mod x y)
  
  (* meta remove_unused:dependency prop Div_mod, function div *)
  
  (* meta remove_unused:dependency prop Div_mod, function mod *)
  
  axiom Div_bound :
    forall x:int, y:int. x >= 0 /\ y > 0 -> 0 <= div x y /\ div x y <= x
  
  (* meta remove_unused:dependency prop Div_bound, function div *)
  
  (* meta remove_unused:dependency prop Div_bound, function mod *)
  
  axiom Mod_bound :
    forall x:int, y:int. not y = 0 -> (- abs y) < mod x y /\ mod x y < abs y
  
  (* meta remove_unused:dependency prop Mod_bound, function div *)
  
  (* meta remove_unused:dependency prop Mod_bound, function mod *)
  
  axiom Div_sign_pos : forall x:int, y:int. x >= 0 /\ y > 0 -> div x y >= 0
  
  (* meta remove_unused:dependency prop Div_sign_pos, function div *)
  
  (* meta remove_unused:dependency prop Div_sign_pos, function mod *)
  
  axiom Div_sign_neg : forall x:int, y:int. x <= 0 /\ y > 0 -> div x y <= 0
  
  (* meta remove_unused:dependency prop Div_sign_neg, function div *)
  
  (* meta remove_unused:dependency prop Div_sign_neg, function mod *)
  
  axiom Mod_sign_pos :
    forall x:int, y:int. x >= 0 /\ not y = 0 -> mod x y >= 0
  
  (* meta remove_unused:dependency prop Mod_sign_pos, function div *)
  
  (* meta remove_unused:dependency prop Mod_sign_pos, function mod *)
  
  axiom Mod_sign_neg :
    forall x:int, y:int. x <= 0 /\ not y = 0 -> mod x y <= 0
  
  (* meta remove_unused:dependency prop Mod_sign_neg, function div *)
  
  (* meta remove_unused:dependency prop Mod_sign_neg, function mod *)
  
  axiom Rounds_toward_zero :
    forall x:int, y:int. not y = 0 -> abs (div x y * y) <= abs x
  
  (* meta remove_unused:dependency prop Rounds_toward_zero, function div *)
  
  (* meta remove_unused:dependency prop Rounds_toward_zero, function mod *)
  
  axiom Div_1 : forall x:int. div x 1 = x
  
  (* meta remove_unused:dependency prop Div_1, function div *)
  
  (* meta remove_unused:dependency prop Div_1, function mod *)
  
  axiom Mod_1 : forall x:int. mod x 1 = 0
  
  (* meta remove_unused:dependency prop Mod_1, function div *)
  
  (* meta remove_unused:dependency prop Mod_1, function mod *)
  
  axiom Div_inf : forall x:int, y:int. 0 <= x /\ x < y -> div x y = 0
  
  (* meta remove_unused:dependency prop Div_inf, function div *)
  
  (* meta remove_unused:dependency prop Div_inf, function mod *)
  
  axiom Mod_inf : forall x:int, y:int. 0 <= x /\ x < y -> mod x y = x
  
  (* meta remove_unused:dependency prop Mod_inf, function div *)
  
  (* meta remove_unused:dependency prop Mod_inf, function mod *)
  
  axiom Div_mult :
    forall x:int, y:int, z:int [div ((x * y) + z) x].
     x > 0 /\ y >= 0 /\ z >= 0 -> div ((x * y) + z) x = (y + div z x)
  
  (* meta remove_unused:dependency prop Div_mult, function div *)
  
  (* meta remove_unused:dependency prop Div_mult, function mod *)
  
  axiom Mod_mult :
    forall x:int, y:int, z:int [mod ((x * y) + z) x].
     x > 0 /\ y >= 0 /\ z >= 0 -> mod ((x * y) + z) x = mod z x
  
  (* meta remove_unused:dependency prop Mod_mult, function div *)
  
  (* meta remove_unused:dependency prop Mod_mult, function mod *)
  
  (* use int.ComputerDivision *)
  
  (* use mach.int.Int1 *)
  
  type t17 = <range 0 18446744073709551615>
  
  function t'int t17 : int
  
  constant t'maxInt : int = 18446744073709551615
  
  constant t'minInt : int = 0
  
  predicate t'eq (a:t17) (b:t17) = t'int a = t'int b
  
  axiom t'inj : forall a:t17, b:t17. t'eq a b -> a = b
  
  (* meta range_type type t17, function t'int *)
  
  (* meta model_projection function t'int *)
  
  (* meta remove_unused:dependency prop t'inj, predicate t'eq *)
  
  constant two_power_size : int = 0x10000000000000000
  
  axiom extensionality :
    forall x:t17, y:t17 [t'int x, t'int y]. t'int x = t'int y -> x = y
  
  predicate in_bounds (n:int) = 0 <= n /\ n <= 0xFFFFFFFFFFFFFFFF
  
  function of_int int : t17
  
  axiom to_of_int :
    forall x:int [of_int x]. in_bounds x -> t'int (of_int x) = x
  
  function add t17 t17 : t17
  
  axiom add_in_bounds :
    forall x:t17, y:t17 [add x y].
     in_bounds (t'int x + t'int y) -> t'int (add x y) = (t'int x + t'int y)
  
  axiom add_wrapping :
    forall x:t17, y:t17 [add x y].
     exists k:int.
      t'int (add x y) = ((t'int x + t'int y) + (k * two_power_size))
  
  function sub t17 t17 : t17
  
  axiom sub_in_bounds :
    forall x:t17, y:t17 [sub x y].
     in_bounds (t'int x - t'int y) -> t'int (sub x y) = (t'int x - t'int y)
  
  axiom sub_wrapping :
    forall x:t17, y:t17 [sub x y].
     exists k:int.
      t'int (sub x y) = ((t'int x - t'int y) + (k * two_power_size))
  
  function mul t17 t17 : t17
  
  axiom mul_in_bounds :
    forall x:t17, y:t17 [mul x y].
     in_bounds (t'int x * t'int y) -> t'int (mul x y) = (t'int x * t'int y)
  
  axiom mul_wrapping :
    forall x:t17, y:t17 [mul x y].
     exists k:int.
      t'int (mul x y) = ((t'int x * t'int y) + (k * two_power_size))
  
  function neg t17 : t17
  
  axiom neg_zero : forall x:t17 [neg x]. t'int x = 0 -> t'int (neg x) = 0
  
  axiom neg_not_zero :
    forall x:t17 [neg x].
     0 < t'int x /\ t'int x <= 0xFFFFFFFFFFFFFFFF ->
     t'int (neg x) = (two_power_size - t'int x)
  
  function of_bool (b:bool) : t17 = if b = True then (1:t17) else (0:t17)
  
  predicate le (a:t17) (b:t17) = t'int a <= t'int b
  
  predicate lt (a:t17) (b:t17) = t'int a < t'int b
  
  predicate ge (a:t17) (b:t17) = t'int a >= t'int b
  
  predicate gt (a:t17) (b:t17) = t'int a > t'int b
  
  function bw_and t17 t17 : t17
  
  function bw_or t17 t17 : t17
  
  function bw_xor t17 t17 : t17
  
  function bw_not t17 : t17
  
  function shl t17 t17 : t17
  
  function shr t17 t17 : t17
  
  function nth t17 int : bool
  
  type tuple2 'a 'a1 =
    | Tuple2 'a 'a1
  
  (* use why3.Tuple2.Tuple21 *)
  
  function add_with_overflow (a:t17) (b:t17) : (t17, bool) = (add a b,
    if not in_bounds (t'int a + t'int b) then True else False)
  
  function sub_with_overflow (a:t17) (b:t17) : (t17, bool) = (sub a b,
    if not in_bounds (t'int a - t'int b) then True else False)
  
  function mul_with_overflow (a:t17) (b:t17) : (t17, bool) = (mul a b,
    if not in_bounds (t'int a * t'int b) then True else False)
  
  (* use creusot.int.UInt64 *)
  
  type t18 'a =
    | T'mk (current:'a) (final:'a) (id:int)
  
  (* meta model_record function id *)
  
  (* meta model_record function final *)
  
  (* meta model_record function current *)
  
  function borrow_logic (cur:'a) (fin:'a) (id1:int) : t18 'a =
    T'mk cur fin id1
  
  function get_id (x:t18 'a) : int = x.id
  
  function inherit_id int int : int
  
  (* use creusot.prelude.MutBorrow *)
  
  type t19 = <range 0 255>
  
  function t'int1 t19 : int
  
  constant t'maxInt1 : int = 255
  
  constant t'minInt1 : int = 0
  
  predicate t'eq1 (a:t19) (b:t19) = t'int1 a = t'int1 b
  
  axiom t'inj1 : forall a:t19, b:t19. t'eq1 a b -> a = b
  
  (* meta range_type type t19, function t'int1 *)
  
  (* meta model_projection function t'int1 *)
  
  (* meta remove_unused:dependency prop t'inj1, predicate t'eq1 *)
  
  constant two_power_size1 : int = 0x100
  
  axiom extensionality1 :
    forall x:t19, y:t19 [t'int1 x, t'int1 y]. t'int1 x = t'int1 y -> x = y
  
  predicate in_bounds1 (n:int) = 0 <= n /\ n <= 0xFF
  
  function of_int1 int : t19
  
  axiom to_of_int1 :
    forall x:int [of_int1 x]. in_bounds1 x -> t'int1 (of_int1 x) = x
  
  function add1 t19 t19 : t19
  
  axiom add_in_bounds1 :
    forall x:t19, y:t19 [add1 x y].
     in_bounds1 (t'int1 x + t'int1 y) ->
     t'int1 (add1 x y) = (t'int1 x + t'int1 y)
  
  axiom add_wrapping1 :
    forall x:t19, y:t19 [add1 x y].
     exists k:int.
      t'int1 (add1 x y) = ((t'int1 x + t'int1 y) + (k * two_power_size1))
  
  function sub1 t19 t19 : t19
  
  axiom sub_in_bounds1 :
    forall x:t19, y:t19 [sub1 x y].
     in_bounds1 (t'int1 x - t'int1 y) ->
     t'int1 (sub1 x y) = (t'int1 x - t'int1 y)
  
  axiom sub_wrapping1 :
    forall x:t19, y:t19 [sub1 x y].
     exists k:int.
      t'int1 (sub1 x y) = ((t'int1 x - t'int1 y) + (k * two_power_size1))
  
  function mul1 t19 t19 : t19
  
  axiom mul_in_bounds1 :
    forall x:t19, y:t19 [mul1 x y].
     in_bounds1 (t'int1 x * t'int1 y) ->
     t'int1 (mul1 x y) = (t'int1 x * t'int1 y)
  
  axiom mul_wrapping1 :
    forall x:t19, y:t19 [mul1 x y].
     exists k:int.
      t'int1 (mul1 x y) = ((t'int1 x * t'int1 y) + (k * two_power_size1))
  
  function neg1 t19 : t19
  
  axiom neg_zero1 :
    forall x:t19 [neg1 x]. t'int1 x = 0 -> t'int1 (neg1 x) = 0
  
  axiom neg_not_zero1 :
    forall x:t19 [neg1 x].
     0 < t'int1 x /\ t'int1 x <= 0xFF ->
     t'int1 (neg1 x) = (two_power_size1 - t'int1 x)
  
  function of_bool1 (b:bool) : t19 = if b = True then (1:t19) else (0:t19)
  
  predicate le1 (a:t19) (b:t19) = t'int1 a <= t'int1 b
  
  predicate lt1 (a:t19) (b:t19) = t'int1 a < t'int1 b
  
  predicate ge1 (a:t19) (b:t19) = t'int1 a >= t'int1 b
  
  predicate gt1 (a:t19) (b:t19) = t'int1 a > t'int1 b
  
  function bw_and1 t19 t19 : t19
  
  function bw_or1 t19 t19 : t19
  
  function bw_xor1 t19 t19 : t19
  
  function bw_not1 t19 : t19
  
  function shl1 t19 t19 : t19
  
  function shr1 t19 t19 : t19
  
  function nth1 t19 int : bool
  
  function add_with_overflow1 (a:t19) (b:t19) : (t19, bool) = (add1 a b,
    if not in_bounds1 (t'int1 a + t'int1 b) then True else False)
  
  function sub_with_overflow1 (a:t19) (b:t19) : (t19, bool) = (sub1 a b,
    if not in_bounds1 (t'int1 a - t'int1 b) then True else False)
  
  function mul_with_overflow1 (a:t19) (b:t19) : (t19, bool) = (mul1 a b,
    if not in_bounds1 (t'int1 a * t'int1 b) then True else False)
  
  (* use creusot.int.UInt8 *)
  
  type seq 'a
  
  (* meta infinite_type type seq *)
  
  function length (seq 'a) : int
  
  axiom length_nonnegative : forall s:seq 'a. 0 <= length s
  
  (* meta remove_unused:dependency prop length_nonnegative,
    function length *)
  
  function get (seq 'a) int : 'a
  
  function ([]) (s:seq 'a) (i:int) : 'a = get s i
  
  predicate (==) (seq 'a) (seq 'a)
  
  axiom (==)'spec'0 :
    forall s1:seq 'a, s2:seq 'a.
     s1 == s2 <->
     length s1 = length s2 &&
     (forall i:int. 0 <= i /\ i < length s1 -> s1[i] = s2[i])
  
  axiom (==)'spec : forall s1:seq 'a, s2:seq 'a. s1 == s2 -> s1 = s2
  
  (* meta remove_unused:dependency prop (==)'spec'0, predicate (==) *)
  
  (* meta remove_unused:dependency prop (==)'spec, predicate (==) *)
  
  (* meta extensionality predicate (==) *)
  
  type (->) 'a 'b
  
  function (@) ('a -> 'b) 'a : 'b
  
  (* use why3.HighOrd.HighOrd *)
  
  function create int (int -> 'a) : seq 'a
  
  axiom create'spec'0 :
    forall len:int, f:int -> 'a. 0 <= len -> length (create len f) = len
  
  axiom create'spec :
    forall len:int, f:int -> 'a.
     0 <= len ->
     (forall i:int. 0 <= i /\ i < len -> (create len f)[i] = (f @ i))
  
  (* meta remove_unused:dependency prop create'spec'0, function create *)
  
  (* meta remove_unused:dependency prop create'spec, function create *)
  
  constant empty : seq 'a
  
  axiom empty'def : length (empty: seq 'a) = 0
  
  (* meta remove_unused:dependency prop empty'def, constant empty *)
  
  function set (seq 'a) int 'a : seq 'a
  
  axiom set'def :
    forall s:seq 'a, i:int, v:'a.
     0 <= i /\ i < length s ->
     set s i v = create (length s) (fun (j:int) -> if j = i then v else s[j])
  
  axiom set'spec'1 :
    forall s:seq 'a, i:int, v:'a.
     0 <= i /\ i < length s -> length (set s i v) = length s
  
  axiom set'spec'0 :
    forall s:seq 'a, i:int, v:'a.
     0 <= i /\ i < length s -> (set s i v)[i] = v
  
  axiom set'spec :
