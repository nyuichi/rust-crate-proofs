use map.Map
use int.Int

type t_FMap_Int_Excl_PositiveReal

type t_PositiveReal

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_Excl_PositiveReal = { f0: t_PositiveReal }

type t_Option_Excl_PositiveReal = None | Some t_Excl_PositiveReal

function to_mapping_Int (self: t_FMap_Int_Excl_PositiveReal) : Map.map int t_Option_Excl_PositiveReal

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) : t_Option_Excl_PositiveReal =
  [%#sfmap'1] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate ids_bounded [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-nonnull-view-boundaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 56 0 56 58] (live: t_FMap_Int_Excl_PositiveReal) (next: int) =
  [%#sfraction_map'1] ge_log_Int next 0 /\ (forall id: int. get_Int live id <> None -> 0 <= id /\ id < next)

function len_Int (self: t_FMap_Int_Excl_PositiveReal) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_PositiveReal [len_Int self]. [%#sfmap'2] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_PositiveReal) (k: int) =
  [%#sfmap'3] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_PositiveReal) (k: int) (v: t_Excl_PositiveReal) : t_FMap_Int_Excl_PositiveReal

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_PositiveReal, k: int, v: t_Excl_PositiveReal [insert_Int self k v]. [%#sfmap'0] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant live : t_FMap_Int_Excl_PositiveReal

constant next : int

constant fraction : t_PositiveReal

function insert_fresh_preserves_bound [#"/workspace/bytes-work/bytes/1.11.1/verification/probes/original-nonnull-view-boundaries-2026-10-09/src/../../shared-physical-lifecycle-2026-10-08/src/fraction_map.rs" 110 0 110 91] (live: t_FMap_Int_Excl_PositiveReal) (next: int) (fraction: t_PositiveReal) : ()

goal vc_insert_fresh_preserves_bound: ([%#sfraction_map] ids_bounded live next /\ get_Int live next = None)
  -> (forall id: int. get_Int (insert_Int live next { f0 = fraction }) id <> None -> 0 <= id /\ id < next + 1)
  && ([@stop_split] [@expl:insert_fresh_preserves_bound ensures] [%#sfraction_map'0] ids_bounded (insert_Int live next { f0 = fraction }) (next
  + 1))
