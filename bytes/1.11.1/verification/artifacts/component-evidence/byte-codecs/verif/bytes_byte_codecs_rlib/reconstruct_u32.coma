  [ & _ret: UInt32.t = Any.any_l () | & bytes: Slice64.array UInt8.t = bytes ])
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:reconstruct_u32 ensures] [%#slib'1] UInt32.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) * 16777216 + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 65536
