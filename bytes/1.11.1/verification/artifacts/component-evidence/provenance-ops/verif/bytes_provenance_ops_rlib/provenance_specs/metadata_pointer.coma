use creusot.prelude.Opaque
use creusot.prelude.Ptr
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

predicate is_null_ptr_u8 (self: Opaque.ptr) = [%#sptr'0] Ptr.addr_logic_u64 self = (0: UInt64.t)

let null_mut_u8 (return (x: Opaque.ptr)) = any
  [ return (result: Opaque.ptr) -> {[@stop_split] [@expl:null_mut ensures] [%#sptr] is_null_ptr_u8 result}
    (! return {result}) ]

constant size_of_u8: int = 1

meta "rewrite_def" constant size_of_u8

axiom size_of_u8_spec: [%#smem] 0 <= size_of_u8

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let wrapping_add_u8 (self_: Opaque.ptr) (offset: UInt64.t) (return (x: Opaque.ptr)) =
{[@stop_split] [@expl:wrapping_add requires] [%#sprovenance_specs'2] size_of_u8 = 1}
  any
  [ return (result: Opaque.ptr) ->
  {[@stop_split] [@expl:wrapping_add ensures] [%#sprovenance_specs'3] UInt64.t'int (Ptr.addr_logic_u64 result)
    = ComputerDivision.mod (UInt64.t'int (Ptr.addr_logic_u64 self_) + UInt64.t'int offset) (UInt64.t'int const_MAX + 1)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

