    ) (Seq.length (Slice64.view slice))}
    (! return {result}) ]

let advance_position (len: UInt64.t) (pos: UInt64.t) (cnt: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:advance_position requires] [%#slib'67] UInt64.t'int cnt
