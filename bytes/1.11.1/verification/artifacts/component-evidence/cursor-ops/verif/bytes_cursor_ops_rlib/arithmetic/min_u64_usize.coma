    /\ ([@stop_split] [@expl:try_from ensures] [%#sstd_specs] match result with
      | Ok v -> UInt64.t'int v = UInt64.t'int value /\ UInt64.t'int value <= UInt64.t'int const_MAX
      | Err _ -> gt_log_Int (UInt64.t'int value) (UInt64.t'int const_MAX)
      end)}
    (! return {result}) ]

let elim_Ok (_x: t_Result_usize_TryFromIntError) (return (f0: UInt64.t)) = any
