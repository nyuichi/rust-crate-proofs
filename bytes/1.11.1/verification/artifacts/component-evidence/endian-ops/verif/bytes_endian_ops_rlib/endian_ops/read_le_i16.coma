type t_Option_u16 = None | Some UInt16.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_le_u16 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_u16)) = any
  [ return (result: t_Option_u16) -> {[@stop_split] [@expl:read_le_u16 ensures] [%#sendian_ops'2] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 2
      /\ UInt16.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0)
        + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 256
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 2 }
      | None -> Seq.length (Slice64.view input.current) < 2 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

let elim_Some (_x: t_Option_u16) (return (f0: UInt16.t)) = any
  [ _k (f0: UInt16.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

function signed_u16 [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/endian-ops/src/../../../../src/endian_ops.rs" 9 0 9 42] (word: int) : int
 = [%#sendian_ops'4] if word <= 32767 then word else word - 65536

let signed_from_u16 (word: UInt16.t) (return (x: Int16.t)) = any
  [ return (result: Int16.t) -> {[@stop_split] [@expl:signed_from_u16 ensures] [%#sendian_ops'3] Int16.to_int result
    = signed_u16 (UInt16.t'int word)}
    (! return {result}) ]

