type t_Option_u32 = None | Some UInt32.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_be_u32 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_u32)) = any
  [ return (result: t_Option_u32) -> {[@stop_split] [@expl:read_be_u32 ensures] [%#sslice_read_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 4
      /\ UInt32.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 16777216
            + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 65536
          + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 3)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 4 }
      | None -> Seq.length (Slice64.view input.current) < 4 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

let elim_Some (_x: t_Option_u32) (return (f0: UInt32.t)) = any
  [ _k (f0: UInt32.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
