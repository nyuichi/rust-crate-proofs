function signed_u32 [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/endian-ops/src/../../../../src/endian_ops.rs" 18 0 18 42] (word: int) : int
 = [%#sendian_ops'3] if word <= 2147483647 then word else word - 4294967296

let signed_from_u32 (word: UInt32.t) (return (x: Int32.t)) = any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:signed_from_u32 ensures] [%#sendian_ops'2] Int32.to_int result
    = signed_u32 (UInt32.t'int word)}
    (! return {result}) ]

