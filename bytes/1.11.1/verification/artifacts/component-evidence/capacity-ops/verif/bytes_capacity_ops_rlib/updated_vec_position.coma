  (data: UInt64.t) (pos: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:updated_vec_position requires] [%#slib'1] UInt64.t'int pos <= UInt64.t'int const_MAX_VEC_POS}
  (! set_MAX_VEC_POS
