use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let saturating_sum (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:saturating_sum ensures] [%#schain_ops] UInt64.t'int result
    = (if UInt64.t'int a + UInt64.t'int b <= UInt64.t'int const_MAX then
      UInt64.t'int a + UInt64.t'int b
    else
      UInt64.t'int const_MAX
    )}
    (! return {result}) ]

type tup2_usize_usize = { f0: UInt64.t; f1: UInt64.t }

let split_count (a_remaining: UInt64.t) (count: UInt64.t) (return (x: tup2_usize_usize)) = any
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:split_count ensures] ([@stop_split] [@expl:split_count ensures #0] [%#schain_ops'0] UInt64.t'int result.f0
      = (if UInt64.t'int a_remaining <= UInt64.t'int count then UInt64.t'int a_remaining else UInt64.t'int count))
    /\ ([@stop_split] [@expl:split_count ensures #1] [%#schain_ops'1] UInt64.t'int result.f1
      = (if UInt64.t'int a_remaining < UInt64.t'int count then UInt64.t'int count - UInt64.t'int a_remaining else 0))
    /\ ([@stop_split] [@expl:split_count ensures #2] [%#schain_ops'2] UInt64.t'int result.f0 + UInt64.t'int result.f1
    = UInt64.t'int count)}
    (! return {result}) ]

type tup2_Int_Int = { f0'0: int; f1'0: int }

function deep_model_usize [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

meta "rewrite_def" function deep_model_usize

function deep_model_tup2_usize_usize [@inline:trivial] (self: tup2_usize_usize) : tup2_Int_Int =
  [%#stuples] { f0'0 = deep_model_usize self.f0; f1'0 = deep_model_usize self.f1 }

meta "rewrite_def" function deep_model_tup2_usize_usize

function deep_model_ref_tup2_usize_usize [@inline:trivial] (self: tup2_usize_usize) : tup2_Int_Int =
  [%#smodel] deep_model_tup2_usize_usize self

meta "rewrite_def" function deep_model_ref_tup2_usize_usize

let eq_tup2_usize_usize (self_: tup2_usize_usize) (rhs: tup2_usize_usize) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] [%#scmp] result
    = (deep_model_ref_tup2_usize_usize self_ = deep_model_ref_tup2_usize_usize rhs)}
    (! return {result}) ]

