use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function view_Box_slice_u8_Global [@inline:trivial] (self: Slice64.slice UInt8.t) : Seq.seq UInt8.t =
  [%#sboxed] Slice64.view self

meta "rewrite_def" function view_Box_slice_u8_Global

let write_disjoint_regions (input: Slice64.slice UInt8.t) (split: UInt64.t) (left_value: UInt8.t) (right_value: UInt8.t)
  (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:write_disjoint_regions requires] ([@stop_split] [@expl:write_disjoint_regions requires #0] [%#slib'6] ge_log_Int (Seq.length (view_Box_slice_u8_Global input)) 2)
  /\ ([@stop_split] [@expl:write_disjoint_regions requires #1] [%#slib'7] 0 < UInt64.t'int split
    /\ UInt64.t'int split < Seq.length (view_Box_slice_u8_Global input))
  /\ ([@stop_split] [@expl:write_disjoint_regions requires #2] [%#slib'8] UInt8.t'int left_value
  <> UInt8.t'int right_value)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:write_disjoint_regions ensures] ([@stop_split] [@expl:write_disjoint_regions ensures #0] [%#slib'9] Seq.length (view_Box_slice_u8_Global result)
      = Seq.length (view_Box_slice_u8_Global input))
    /\ ([@stop_split] [@expl:write_disjoint_regions ensures #1] [%#slib'10] Seq.get (view_Box_slice_u8_Global result) (UInt64.t'int split
        - 1)
      = left_value)
    /\ ([@stop_split] [@expl:write_disjoint_regions ensures #2] [%#slib'11] Seq.get (view_Box_slice_u8_Global result) (UInt64.t'int split)
      = right_value)
    /\ ([@stop_split] [@expl:write_disjoint_regions ensures #3] [%#slib'12] forall i: int. 0 <= i
        /\ i < Seq.length (view_Box_slice_u8_Global input) /\ i <> UInt64.t'int split - 1 /\ i <> UInt64.t'int split
      -> Seq.get (view_Box_slice_u8_Global result) i = Seq.get (view_Box_slice_u8_Global input) i)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wrong_overlap [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/region-permissions/src/lib.rs" 83 0 88 14]
  (input: Slice64.slice UInt8.t) (split: UInt64.t) (left_value: UInt8.t) (right_value: UInt8.t)
  (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:wrong_overlap requires] ([@stop_split] [@expl:wrong_overlap requires #0] [%#slib'0] ge_log_Int (Seq.length (view_Box_slice_u8_Global input)) 2)
  /\ ([@stop_split] [@expl:wrong_overlap requires #1] [%#slib'1] 0 < UInt64.t'int split
    /\ UInt64.t'int split < Seq.length (view_Box_slice_u8_Global input))
  /\ ([@stop_split] [@expl:wrong_overlap requires #2] [%#slib'2] UInt8.t'int left_value <> UInt8.t'int right_value)}
  (! bb0
  [ bb0 = s0
    [ s0 = write_disjoint_regions [%#slib] {input} {split} {left_value} {right_value}
        (fun (_x: Slice64.slice UInt8.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: Slice64.slice UInt8.t = Any.any_l ()
  | & input: Slice64.slice UInt8.t = input
  | & split: UInt64.t = split
  | & left_value: UInt8.t = left_value
  | & right_value: UInt8.t = right_value ])
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:wrong_overlap ensures] ([@stop_split] [@expl:wrong_overlap ensures #0] [%#slib'3] Seq.get (view_Box_slice_u8_Global result) (UInt64.t'int split
        - 1)
      = left_value)
    /\ ([@stop_split] [@expl:wrong_overlap ensures #1] [%#slib'4] Seq.get (view_Box_slice_u8_Global result) (UInt64.t'int split)
      = right_value)
    /\ ([@stop_split] [@expl:wrong_overlap ensures #2] [%#slib'5] Seq.get (view_Box_slice_u8_Global result) (UInt64.t'int split
      - 1)
    = right_value)}
    (! return {result}) ]
