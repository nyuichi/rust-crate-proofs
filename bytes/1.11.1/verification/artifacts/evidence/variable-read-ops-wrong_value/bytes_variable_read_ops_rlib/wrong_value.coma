  (input: MutBorrow.t (Slice64.slice UInt8.t)) (nbytes: UInt64.t) (return (x: t_Option_u64)) =
{[@stop_split] [@expl:wrong_value requires] [%#slib'0] UInt64.t'int nbytes = 1
  /\ ge_log_Int (Seq.length (Slice64.view input.current)) 1
  /\ gt_log_Int (UInt8.t'int (Seq.get (Slice64.view input.current) 0)) 0}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <Slice64.slice UInt8.t> {input.current} {MutBorrow.get_id input}
        (fun (_bor: MutBorrow.t (Slice64.slice UInt8.t)) ->
          [ &_7 <- _bor ] [ &input <- { input with current = _bor.final } ] s1)
    | s1 = read_be_u64 [%#slib] {_7} {nbytes} (fun (_x: t_Option_u64) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_ref_slice_u8 input}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Option_u64 = Any.any_l ()
  | & input: MutBorrow.t (Slice64.slice UInt8.t) = input
  | & nbytes: UInt64.t = nbytes
  | & _7: MutBorrow.t (Slice64.slice UInt8.t) = Any.any_l () ])
  [ return (result: t_Option_u64) -> {[@stop_split] [@expl:wrong_value ensures] [%#slib'1] match result with
      | Some value -> UInt64.t'int value = 0
      | None -> false
      end}
    (! return {result}) ]
