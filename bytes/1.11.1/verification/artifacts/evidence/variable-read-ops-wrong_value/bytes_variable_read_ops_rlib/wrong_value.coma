use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Option_u64 = None | Some UInt64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function be_weight [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/variable-read-ops/src/../../../../src/variable_read_ops.rs" 9 0 9 54] (bytes: Seq.seq UInt8.t) (n: int) : int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_be_u64 (input: MutBorrow.t (Slice64.slice UInt8.t)) (nbytes: UInt64.t) (return (x: t_Option_u64)) =
{[@stop_split] [@expl:read_be_u64 requires] [%#svariable_read_ops] UInt64.t'int nbytes <= 8}
  any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:read_be_u64 ensures] [%#svariable_read_ops'0] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) (UInt64.t'int nbytes)
      /\ UInt64.t'int value = be_weight (Slice64.view input.current) (UInt64.t'int nbytes)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = UInt64.t'int nbytes }
      | None -> Seq.length (Slice64.view input.current) < UInt64.t'int nbytes
      /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

