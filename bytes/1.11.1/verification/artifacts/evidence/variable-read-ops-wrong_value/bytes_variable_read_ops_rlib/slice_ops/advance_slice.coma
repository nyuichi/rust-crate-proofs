use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_RangeFrom_usize = { start: UInt64.t }

predicate in_bounds_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) =
  [%#sslice'1] UInt64.t'int self.start <= Seq.length seq

predicate has_value_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  [%#sslice'2] Seq.([..]) seq (UInt64.t'int self.start) (Seq.length seq) = Slice64.view out

let index_slice_u8 (self_: Slice64.slice UInt8.t) (ix: t_RangeFrom_usize) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:index requires] [%#sslice] in_bounds_RangeFrom_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#sslice'0] has_value_RangeFrom_usize ix (Slice64.view self_) result}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

type t_RangeFrom_Int = { start'0: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start'0 (Seq.length self)

meta "rewrite_def" function index_Seq_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let advance_slice [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/variable-read-ops/src/../../../../src/slice_ops.rs" 15 0 15 60]
  (input: MutBorrow.t (Slice64.slice UInt8.t)) (count: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:advance_slice requires] [%#sslice_ops'0] UInt64.t'int count
  <= Seq.length (Slice64.view input.current)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_13 <- { start = count } ] s1
    | s1 = index_slice_u8 [%#sslice_ops] {input.current} {_13} (fun (_x: Slice64.slice UInt8.t) -> [ &_11 <- _x ] s2)
    | s2 = [ &_10 <- _11 ] s3
    | s3 = [ &input <- { input with current = _10 } ] s4
    | s4 = -{resolve_refmut_ref_slice_u8 input}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & input: MutBorrow.t (Slice64.slice UInt8.t) = input
  | & count: UInt64.t = count
  | & _10: Slice64.slice UInt8.t = Any.any_l ()
  | & _11: Slice64.slice UInt8.t = Any.any_l ()
  | & _13: t_RangeFrom_usize = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:advance_slice ensures] [%#sslice_ops'1] Slice64.view input.final
    = index_Seq_u8 (Slice64.view input.current) { start'0 = UInt64.t'int count }}
    (! return {result}) ]
