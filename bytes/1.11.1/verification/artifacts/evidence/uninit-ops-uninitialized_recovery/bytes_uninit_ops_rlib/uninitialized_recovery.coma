use creusot.int.UInt8
use creusot.prelude.Any

type t_MaybeUninit_u8

type t_Option_u8 = None | Some UInt8.t

function view_MaybeUninit_u8 (self: t_MaybeUninit_u8) : t_Option_u8

let uninit_u8 (return (x: t_MaybeUninit_u8)) = any
  [ return (result: t_MaybeUninit_u8) -> {[@stop_split] [@expl:uninit ensures] [%#smem] view_MaybeUninit_u8 result
