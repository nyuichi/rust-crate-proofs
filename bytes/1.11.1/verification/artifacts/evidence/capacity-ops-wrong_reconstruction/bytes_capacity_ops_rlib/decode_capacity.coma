use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

constant const_MAX_ORIGINAL_CAPACITY_WIDTH: UInt64.t = [%#slib'4] (17: UInt64.t)

constant const_MIN_ORIGINAL_CAPACITY_WIDTH: UInt64.t = [%#slib'4] (10: UInt64.t)

predicate gt_log_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) = [%#sord] UInt64.lt other self

meta "rewrite_def" predicate gt_log_usize

predicate ge_log_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) = [%#sord'0] UInt64.le other self

meta "rewrite_def" predicate ge_log_usize

let original_capacity_from_repr (repr: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:original_capacity_from_repr requires] [%#scapacity_ops] UInt64.t'int repr
  <= UInt64.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH - UInt64.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:original_capacity_from_repr ensures] ([@stop_split] [@expl:original_capacity_from_repr ensures #0] [%#scapacity_ops'0] repr
        = (0: UInt64.t) -> result = (0: UInt64.t))
    /\ ([@stop_split] [@expl:original_capacity_from_repr ensures #1] [%#scapacity_ops'1] gt_log_usize repr (0: UInt64.t)
      -> result = UInt64.shl (1: UInt64.t) (UInt64.add repr (9: UInt64.t)))
    /\ ([@stop_split] [@expl:original_capacity_from_repr ensures #2] [%#scapacity_ops'2] gt_log_usize repr (0: UInt64.t)
      -> ge_log_usize result (UInt64.shl (1: UInt64.t) (10: UInt64.t)))
    /\ ([@stop_split] [@expl:original_capacity_from_repr ensures #3] [%#scapacity_ops'3] UInt64.le result (UInt64.shl (1: UInt64.t) (16: UInt64.t)))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let decode_capacity [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/capacity-ops/src/lib.rs" 30 0 30 44]
  (repr: UInt64.t) (return (x: UInt64.t)) = {[@stop_split] [@expl:decode_capacity requires] [%#slib'0] UInt64.t'int repr
  <= 7}
  (! bb0
  [ bb0 = s0
    [ s0 = original_capacity_from_repr [%#slib] {repr} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt64.t = Any.any_l () | & repr: UInt64.t = repr ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:decode_capacity ensures] ([@stop_split] [@expl:decode_capacity ensures #0] [%#slib'1] repr
        = (0: UInt64.t) -> result = (0: UInt64.t))
    /\ ([@stop_split] [@expl:decode_capacity ensures #1] [%#slib'2] gt_log_usize repr (0: UInt64.t)
      -> result = UInt64.shl (1: UInt64.t) (UInt64.add repr (9: UInt64.t)))
    /\ ([@stop_split] [@expl:decode_capacity ensures #2] [%#slib'3] UInt64.le result (UInt64.shl (1: UInt64.t) (16: UInt64.t)))}
    (! return {result}) ]
