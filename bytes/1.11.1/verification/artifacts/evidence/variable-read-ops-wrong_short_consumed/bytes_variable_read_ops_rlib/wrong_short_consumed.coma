  /\ gt_log_Int (UInt64.t'int nbytes) (Seq.length (Slice64.view input.current))
  /\ gt_log_Int (Seq.length (Slice64.view input.current)) 0}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <Slice64.slice UInt8.t> {input.current} {MutBorrow.get_id input}
        (fun (_bor: MutBorrow.t (Slice64.slice UInt8.t)) ->
          [ &_9 <- _bor ] [ &input <- { input with current = _bor.final } ] s1)
    | s1 = advance_slice [%#slib'0] {_9} {[%#slib] (1: UInt64.t)} (fun (_x: ()) -> [ &_8 <- _x ] s2)
    | s2 = -{resolve_refmut_ref_slice_u8 input}- s3
    | s3 = [ &_ret <- None ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Option_u64 = Any.any_l ()
  | & input: MutBorrow.t (Slice64.slice UInt8.t) = input
  | & _8: () = Any.any_l ()
  | & _9: MutBorrow.t (Slice64.slice UInt8.t) = Any.any_l () ])
  [ return (result: t_Option_u64) -> {[@stop_split] [@expl:wrong_short_consumed ensures] [%#slib'2] match result with
      | None -> Slice64.view input.final = Slice64.view input.current
      | Some _ -> false
      end}
    (! return {result}) ]
