use int.Int

let saturating_sub_usize_u64 (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:saturating_sub_usize_u64 ensures] [%#sarithmetic] UInt64.t'int result
    = (if UInt64.t'int b <= UInt64.t'int a then UInt64.t'int a - UInt64.t'int b else 0)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let subtract [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 11 0 11 42]
  (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = saturating_sub_usize_u64 [%#slib] {a} {b} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & a: UInt64.t = a | & b: UInt64.t = b ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:subtract ensures] [%#slib'0] UInt64.t'int result
    = (if UInt64.t'int b <= UInt64.t'int a then UInt64.t'int a - UInt64.t'int b else 0)}
    (! return {result}) ]
