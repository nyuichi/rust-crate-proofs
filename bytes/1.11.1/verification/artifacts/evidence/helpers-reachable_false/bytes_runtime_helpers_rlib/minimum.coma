let min_u64_usize (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:min_u64_usize ensures] [%#sarithmetic] UInt64.t'int result
