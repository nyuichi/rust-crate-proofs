let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

type t_Option_u64 = None | Some UInt64.t

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_8 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (8: UInt64.t)

predicate inv_array_u8_8 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_8 _1

meta "rewrite_def" predicate inv_array_u8_8

type t_RangeTo_usize = { end': UInt64.t }

predicate in_bounds_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt8.t) =
  [%#sslice'4] UInt64.t'int self.end' <= Seq.length seq

predicate has_value_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  [%#sslice'5] Seq.([..]) seq 0 (UInt64.t'int self.end') = Slice64.view out

let index_slice_u8 (self_: Slice64.slice UInt8.t) (ix: t_RangeTo_usize) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:index requires] [%#sslice'0] in_bounds_RangeTo_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#sslice'1] has_value_RangeTo_usize ix (Slice64.view self_) result}
    (! return {result}) ]

let copy_from_slice_u8 (self_: MutBorrow.t (Slice64.slice UInt8.t)) (src: Slice64.slice UInt8.t) (return (x: ())) =
{[@stop_split] [@expl:copy_from_slice requires] [%#sslice'2] Seq.length (Slice64.view self_.current)
  = Seq.length (Slice64.view src)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:copy_from_slice ensures] [%#sslice'3] Slice64.view self_.final
    = Slice64.view src}
    (! return {result}) ]

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let advance_slice (input: MutBorrow.t (Slice64.slice UInt8.t)) (count: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:advance_slice requires] [%#sslice_ops] UInt64.t'int count
  <= Seq.length (Slice64.view input.current)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:advance_slice ensures] [%#sslice_ops'0] Slice64.view input.final
    = index_Seq_u8 (Slice64.view input.current) { start = UInt64.t'int count }}
    (! return {result}) ]

let decode_le_u64 (bytes: Slice64.array UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:decode_le_u64 'bytes' type invariant] [%#sbyte_codec_wide_ops] inv_array_u8_8 bytes}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:decode_le_u64 ensures] [%#sbyte_codec_wide_ops'0] UInt64.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 256
              + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 65536
            + UInt8.t'int (Seq.get (Slice64.view bytes) 3) * 16777216
          + UInt8.t'int (Seq.get (Slice64.view bytes) 4) * 4294967296
        + UInt8.t'int (Seq.get (Slice64.view bytes) 5) * 1099511627776
      + UInt8.t'int (Seq.get (Slice64.view bytes) 6) * 281474976710656
    + UInt8.t'int (Seq.get (Slice64.view bytes) 7) * 72057594037927936}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

