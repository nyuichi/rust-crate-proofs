let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let advance_slice (input: MutBorrow.t (Slice64.slice UInt8.t)) (count: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:advance_slice requires] [%#sslice_ops] UInt64.t'int count
  <= Seq.length (Slice64.view input.current)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:advance_slice ensures] [%#sslice_ops'0] Slice64.view input.final
    = index_Seq_u8 (Slice64.view input.current) { start = UInt64.t'int count }}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

type t_Option_u64 = None | Some UInt64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

let read_be_u64 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_u64)) = any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:read_be_u64 ensures] [%#sslice_wide_read_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 8
      /\ UInt64.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 72057594037927936
                    + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 281474976710656
                  + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 1099511627776
                + UInt8.t'int (Seq.get (Slice64.view input.current) 3) * 4294967296
              + UInt8.t'int (Seq.get (Slice64.view input.current) 4) * 16777216
            + UInt8.t'int (Seq.get (Slice64.view input.current) 5) * 65536
          + UInt8.t'int (Seq.get (Slice64.view input.current) 6) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 7)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 8 }
      | None -> Seq.length (Slice64.view input.current) < 8 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

