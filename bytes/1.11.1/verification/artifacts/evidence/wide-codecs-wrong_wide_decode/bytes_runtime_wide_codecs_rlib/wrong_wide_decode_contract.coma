use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_8 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (8: UInt64.t)

predicate inv_array_u8_8 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_8 _1

meta "rewrite_def" predicate inv_array_u8_8

let decode_be_u64 (bytes: Slice64.array UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:decode_be_u64 'bytes' type invariant] [%#sbyte_codec_wide_ops] inv_array_u8_8 bytes}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:decode_be_u64 ensures] [%#sbyte_codec_wide_ops'0] UInt64.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) * 72057594037927936
                + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 281474976710656
              + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 1099511627776
            + UInt8.t'int (Seq.get (Slice64.view bytes) 3) * 4294967296
          + UInt8.t'int (Seq.get (Slice64.view bytes) 4) * 16777216
        + UInt8.t'int (Seq.get (Slice64.view bytes) 5) * 65536
      + UInt8.t'int (Seq.get (Slice64.view bytes) 6) * 256
    + UInt8.t'int (Seq.get (Slice64.view bytes) 7)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wrong_wide_decode_contract [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/wide-codecs/src/lib.rs" 117 0 117 56]
  (bytes: Slice64.array UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:wrong_wide_decode_contract 'bytes' type invariant] [%#slib'0] inv_array_u8_8 bytes}
  (! bb0
  [ bb0 = s0 [ s0 = decode_be_u64 [%#slib] {bytes} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & bytes: Slice64.array UInt8.t = bytes ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:wrong_wide_decode_contract ensures] [%#slib'1] UInt64.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 256
              + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 65536
            + UInt8.t'int (Seq.get (Slice64.view bytes) 3) * 16777216
          + UInt8.t'int (Seq.get (Slice64.view bytes) 4) * 4294967296
        + UInt8.t'int (Seq.get (Slice64.view bytes) 5) * 1099511627776
      + UInt8.t'int (Seq.get (Slice64.view bytes) 6) * 281474976710656
    + UInt8.t'int (Seq.get (Slice64.view bytes) 7) * 72057594037927936}
