use creusot.prelude.MutBorrow
use map.Map
use map.Const
use creusot.prelude.Any
use int.Int

type t_Authority_FMap_Int_Excl_unit

type t_FMap_Int_Excl_unit

function view_Authority_FMap_Int_Excl_unit (self: t_Authority_FMap_Int_Excl_unit) : t_FMap_Int_Excl_unit

type t_Excl_unit = { f0: () }

type t_Option_Excl_unit = None | Some t_Excl_unit

function to_mapping_Int (self: t_FMap_Int_Excl_unit) : Map.map int t_Option_Excl_unit

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_unit) (k: int) : t_Option_Excl_unit =
  [%#sfmap'6] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

type t_Option_FMap_Int_Excl_unit = None'0 | Some'0 t_FMap_Int_Excl_unit

type t_Option_Option_Excl_unit = None'1 | Some'1 t_Option_Excl_unit

type tup2_Option_Excl_unit_Option_Excl_unit = { f0'0: t_Option_Excl_unit; f1'0: t_Option_Excl_unit }

function map_Option_Excl_unit (self: t_Option_Excl_unit) (f: Map.map t_Excl_unit t_Option_Excl_unit) : t_Option_Option_Excl_unit
 = [%#soption'3] match self with
    | None -> None'1
    | Some x -> Some'1 (Map.get f x)
    end

function op_Excl_unit (self: t_Excl_unit) (_other: t_Excl_unit) : t_Option_Excl_unit = [%#sexcl] None

function commutative_Excl_unit (a: t_Excl_unit) (b: t_Excl_unit) : ()

axiom commutative_Excl_unit_spec: forall a: t_Excl_unit, b: t_Excl_unit. [%#sexcl'0] op_Excl_unit a b = op_Excl_unit b a

function op_Option_Excl_unit (self: t_Option_Excl_unit) (other: t_Option_Excl_unit) : t_Option_Option_Excl_unit =
  [%#soption'1] match { f0'0 = self; f1'0 = other } with
    | {f0'0 = None} -> Some'1 other
    | {f1'0 = None} -> Some'1 self
    | {f0'0 = Some x; f1'0 = Some y} -> map_Option_Excl_unit (op_Excl_unit x y) (fun (z: t_Excl_unit) -> Some z)
    end

function commutative_Option_Excl_unit (a: t_Option_Excl_unit) (b: t_Option_Excl_unit) : ()

axiom commutative_Option_Excl_unit_spec:
  forall a: t_Option_Excl_unit, b: t_Option_Excl_unit. [%#soption'2] op_Option_Excl_unit a b = op_Option_Excl_unit b a

function total_op_Int (self: t_FMap_Int_Excl_unit) (other: t_FMap_Int_Excl_unit) : t_FMap_Int_Excl_unit

axiom total_op_Int_spec:
  forall self: t_FMap_Int_Excl_unit, other: t_FMap_Int_Excl_unit [total_op_Int self other]. ([%#sfmap'11] forall k: int. op_Option_Excl_unit (get_Int self k) (get_Int other k)
        <> None'1)
    -> ([%#sfmap'12] forall k: int. Some'1 (get_Int (total_op_Int self other) k)
      = op_Option_Excl_unit (get_Int self k) (get_Int other k))

function op_FMap_Int_Excl_unit (self: t_FMap_Int_Excl_unit) (other: t_FMap_Int_Excl_unit) : t_Option_FMap_Int_Excl_unit
 = [%#sfmap'5] if forall k: int. op_Option_Excl_unit (get_Int self k) (get_Int other k) <> None'1 then
    Some'0 (total_op_Int self other)
  else
    None'0


function commutative_FMap_Int_Excl_unit (a: t_FMap_Int_Excl_unit) (b: t_FMap_Int_Excl_unit) : ()

axiom commutative_FMap_Int_Excl_unit_spec:
  forall a: t_FMap_Int_Excl_unit, b: t_FMap_Int_Excl_unit. [%#sfmap'10] op_FMap_Int_Excl_unit a b
    = op_FMap_Int_Excl_unit b a

constant any_FMap_Int_Excl_unit : t_FMap_Int_Excl_unit

function unwrap_Option_FMap_Int_Excl_unit (self: t_Option_FMap_Int_Excl_unit) : t_FMap_Int_Excl_unit =
  [%#soption'0] match self with
    | Some'0 x -> x
    | None'0 -> any_FMap_Int_Excl_unit
    end

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function len_Int (self: t_FMap_Int_Excl_unit) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_unit [len_Int self]. [%#sfmap'9] ge_log_Int (len_Int self) 0

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_unit) (k: int) = [%#sfmap'4] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_unit) (k: int) (v: t_Excl_unit) : t_FMap_Int_Excl_unit

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_unit, k: int, v: t_Excl_unit [insert_Int self k v]. [%#sfmap'2] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_unit, k: int, v: t_Excl_unit [insert_Int self k v]. [%#sfmap'3] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

constant empty_Int : t_FMap_Int_Excl_unit

axiom empty_Int_spec: [%#sfmap'7] len_Int empty_Int = 0

axiom empty_Int_spec'0: [%#sfmap'8] to_mapping_Int empty_Int = Const.const (None)

function singleton_Int (k: int) (v: t_Excl_unit) : t_FMap_Int_Excl_unit = [%#sfmap] insert_Int empty_Int k v

let fresh_ticket_extension (map: t_FMap_Int_Excl_unit) (first: int) (second: int) (return (x: ())) =
{[@stop_split] [@expl:fresh_ticket_extension requires] ([@stop_split] [@expl:fresh_ticket_extension requires #0] [%#sscalable_tickets'17] get_Int map first
    = None)
  /\ ([@stop_split] [@expl:fresh_ticket_extension requires #1] [%#sscalable_tickets'18] get_Int map second = None)
  /\ ([@stop_split] [@expl:fresh_ticket_extension requires #2] [%#sscalable_tickets'19] first <> second)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:fresh_ticket_extension ensures] [%#sscalable_tickets'20] op_FMap_Int_Excl_unit (unwrap_Option_FMap_Int_Excl_unit (op_FMap_Int_Excl_unit map (singleton_Int first { f0 = () }))) (singleton_Int second { f0 = () })
