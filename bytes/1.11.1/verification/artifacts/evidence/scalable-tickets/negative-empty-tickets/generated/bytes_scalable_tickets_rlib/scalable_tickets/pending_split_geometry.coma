function remove_Int (self: t_FMap_Int_tup2_Int_Int) (k: int) : t_FMap_Int_tup2_Int_Int

axiom remove_Int_spec:
  forall self: t_FMap_Int_tup2_Int_Int, k: int [remove_Int self k]. [%#sfmap'3] to_mapping_Int (remove_Int self k)
