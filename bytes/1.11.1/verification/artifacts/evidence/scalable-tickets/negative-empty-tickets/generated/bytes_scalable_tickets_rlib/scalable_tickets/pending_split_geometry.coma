  forall self: t_FMap_Int_tup2_Int_Int, k: int [remove_Int self k]. [%#sfmap'4] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

predicate pending_outside [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/scalable-tickets/src/../../../../src/ownership_proof/scalable_tickets.rs" 101 0 101 70] (pending: t_FMap_Int_tup2_Int_Int) (index: int) =
  [%#sscalable_tickets'7] forall id: int. match get_Int pending id with
      | Some {f0 = lo; f1 = hi} -> not (lo <= index /\ index < hi)
      | None -> true
      end

