meta "rewrite_def" function get_Int

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_tup2_Int_Int) (k: int) = [%#sfmap'0] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

predicate pending_interval_bounds_valid [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/scalable-tickets/src/../../../../src/ownership_proof/scalable_tickets.rs" 91 0 91 87] (pending: t_FMap_Int_tup2_Int_Int) (capacity: int) =
  [%#sscalable_tickets'6] forall id: int. match get_Int pending id with
