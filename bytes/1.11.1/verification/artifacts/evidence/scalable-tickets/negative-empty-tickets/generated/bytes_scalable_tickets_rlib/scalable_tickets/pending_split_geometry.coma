predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function len_Int (self: t_FMap_Int_tup2_Int_Int) : int

axiom len_Int_spec: forall self: t_FMap_Int_tup2_Int_Int [len_Int self]. [%#sfmap'5] ge_log_Int (len_Int self) 0

function insert_Int (self: t_FMap_Int_tup2_Int_Int) (k: int) (v: tup2_Int_Int) : t_FMap_Int_tup2_Int_Int

axiom insert_Int_spec:
  forall self: t_FMap_Int_tup2_Int_Int, k: int, v: tup2_Int_Int [insert_Int self k v]. [%#sfmap'1] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_tup2_Int_Int, k: int, v: tup2_Int_Int [insert_Int self k v]. [%#sfmap'2] len_Int (insert_Int self k v)
