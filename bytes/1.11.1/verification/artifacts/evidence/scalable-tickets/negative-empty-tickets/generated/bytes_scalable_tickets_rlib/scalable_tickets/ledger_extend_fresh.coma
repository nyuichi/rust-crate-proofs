  (returned: t_FMap_Int_Excl_unit) (active: t_FMap_Int_Excl_unit) (authority: t_FMap_Int_Excl_unit) (fresh: int)
  (return (x: ())) =
{[@stop_split] [@expl:ledger_extend_fresh requires] ([@stop_split] [@expl:ledger_extend_fresh requires #0] [%#sscalable_tickets'5] op_FMap_Int_Excl_unit returned active
    = Some'1 authority)
  /\ ([@stop_split] [@expl:ledger_extend_fresh requires #1] [%#sscalable_tickets'6] get_Int authority fresh = None)}
  (! bb0
