    | s1 = [ &next_authority <- [%#sscalable_tickets'0] insert_Int authority fresh { f0 = () } ] s2
    | s2 =
      {[@expl:assertion] [%#sscalable_tickets'1] forall key: int. op_Option_Excl_unit (get_Int returned key) (get_Int next_active key)
