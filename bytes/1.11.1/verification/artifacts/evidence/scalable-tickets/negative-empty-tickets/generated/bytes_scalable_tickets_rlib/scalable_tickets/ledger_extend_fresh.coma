  | & merged: t_FMap_Int_Excl_unit = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:ledger_extend_fresh ensures] [%#sscalable_tickets'7] op_FMap_Int_Excl_unit returned (insert_Int active fresh { f0 = () })
