        [ &_ret <- __arr_temp ] s10) ]
    | s10 = return {_ret} ] ]
  [ & _ret: Slice64.array UInt8.t = Any.any_l ()
  | & value: UInt16.t = value
  | & big_endian: Slice64.array UInt8.t = Any.any_l ()
