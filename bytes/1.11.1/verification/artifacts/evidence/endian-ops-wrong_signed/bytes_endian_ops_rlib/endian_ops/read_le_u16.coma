        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 1)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 2 }
      | None -> Seq.length (Slice64.view input.current) < 2 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

