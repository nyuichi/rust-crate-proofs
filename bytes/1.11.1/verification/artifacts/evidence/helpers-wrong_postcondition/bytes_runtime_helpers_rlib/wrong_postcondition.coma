(* #"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 30 0 30 37 *)

let%span slib = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 30 49 30 50
let%span slib'0 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 30 52 30 53
let%span slib'1 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 30 40 30 54
let%span slib'2 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 29 10 29 22
let%span slib'3 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 10 10 10 55

use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

let subtract (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:subtract ensures] [%#slib'3] UInt64.t'int result
    = (if UInt64.t'int b <= UInt64.t'int a then UInt64.t'int a - UInt64.t'int b else 0)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wrong_postcondition [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/helpers/src/lib.rs" 30 0 30 37]
  (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = subtract [%#slib'1] {[%#slib] (0: UInt64.t)} {[%#slib'0] (1: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt64.t = Any.any_l () ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:wrong_postcondition ensures] [%#slib'2] UInt64.t'int result = 1}
    (! return {result}) ]
