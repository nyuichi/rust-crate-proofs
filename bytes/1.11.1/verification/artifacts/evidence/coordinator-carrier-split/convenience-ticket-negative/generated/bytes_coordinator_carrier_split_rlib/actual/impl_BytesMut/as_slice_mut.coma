        -> proof_owned_slot self.final index = proof_owned_slot self.current index)
    /\ ([@stop_split] [@expl:as_slice_mut ensures #15] [%#sactual_carrier'27] self.current.shared_registration <> None'1
    -> (unwrap_Option_HandleRegistration self.final.shared_registration).packet.f0'0
      = (unwrap_Option_HandleRegistration self.current.shared_registration).packet.f0'0
    /\ lo (unwrap_Option_HandleRegistration self.final.shared_registration).packet.f1'0
      = lo (unwrap_Option_HandleRegistration self.current.shared_registration).packet.f1'0
    /\ hi (unwrap_Option_HandleRegistration self.final.shared_registration).packet.f1'0
    = hi (unwrap_Option_HandleRegistration self.current.shared_registration).packet.f1'0)}
    (! return {result}) ]
