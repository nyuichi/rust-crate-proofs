use map.Map
use map.Const
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_FMap_Int_tup2_Int_Int

function len_Int (self: t_FMap_Int_tup2_Int_Int) : int

axiom len_Int_spec: forall self: t_FMap_Int_tup2_Int_Int [len_Int self]. [%#sfmap] ge_log_Int (len_Int self) 0

type tup2_Int_Int = { f0: int; f1: int }

type t_Option_tup2_Int_Int = None | Some tup2_Int_Int

function to_mapping_Int (self: t_FMap_Int_tup2_Int_Int) : Map.map int t_Option_tup2_Int_Int

function get_Int [@inline:trivial] (self: t_FMap_Int_tup2_Int_Int) (k: int) : t_Option_tup2_Int_Int =
  [%#sfmap'8] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_tup2_Int_Int) (k: int) = [%#sfmap'2] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

function remove_Int (self: t_FMap_Int_tup2_Int_Int) (k: int) : t_FMap_Int_tup2_Int_Int

axiom remove_Int_spec:
  forall self: t_FMap_Int_tup2_Int_Int, k: int [remove_Int self k]. [%#sfmap'0] to_mapping_Int (remove_Int self k)
    = Map.set (to_mapping_Int self) k (None)

axiom remove_Int_spec'0:
  forall self: t_FMap_Int_tup2_Int_Int, k: int [remove_Int self k]. [%#sfmap'1] len_Int (remove_Int self k)
    = (if contains_Int self k then len_Int self - 1 else len_Int self)

predicate ext_eq_Int (self: t_FMap_Int_tup2_Int_Int) (other: t_FMap_Int_tup2_Int_Int) =
  [%#sfmap'4] forall k: int. get_Int self k = get_Int other k

axiom ext_eq_Int_spec: forall self: t_FMap_Int_tup2_Int_Int, other: t_FMap_Int_tup2_Int_Int [self
    = other]. [%#sfmap'3] ext_eq_Int self other = (self = other)

constant empty_Int : t_FMap_Int_tup2_Int_Int

axiom empty_Int_spec: [%#sfmap'5] len_Int empty_Int = 0

axiom empty_Int_spec'0: [%#sfmap'6] to_mapping_Int empty_Int = Const.const (None)

predicate is_empty_Int (self: t_FMap_Int_tup2_Int_Int) = [%#sfmap'7] ext_eq_Int self empty_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let pending_cardinality [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/coordinator-carrier-split/src/../../../../src/ownership_proof/scalable_tickets.rs" 158 0 158 75]
  (pending: t_FMap_Int_tup2_Int_Int) (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] [%#sscalable_tickets] forall key: int. ge_log_Int (len_Int (remove_Int pending key)) 0} s1
    | s1 = {[@expl:assertion] [%#sscalable_tickets'0] len_Int pending = 0
      -> (forall key: int. not contains_Int pending key)}
      s2
    | s2 = {[@expl:assertion] [%#sscalable_tickets'1] len_Int pending = 0 -> ext_eq_Int pending empty_Int} s3
    | s3 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & pending: t_FMap_Int_tup2_Int_Int = pending ])
  [ return (result: ()) -> {[@stop_split] [@expl:pending_cardinality ensures] [%#sscalable_tickets'2] (len_Int pending
      = 0)
    = is_empty_Int pending}
    (! return {result}) ]
