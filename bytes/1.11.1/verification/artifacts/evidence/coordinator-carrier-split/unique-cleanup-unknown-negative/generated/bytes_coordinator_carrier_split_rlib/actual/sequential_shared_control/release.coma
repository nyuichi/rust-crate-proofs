let release_shared (ptr: Opaque.ptr) (control: t_ControlPtr) (context: MutBorrow.t t_ControlContext)
  (registration'0: t_HandleRegistration) (return (x: bool)) =
{[@stop_split] [@expl:release_shared requires] ([@stop_split] [@expl:release_shared 'context' type invariant] [%#sactual_carrier] inv_Ghost_refmut_ControlContext context)
  /\ ([@stop_split] [@expl:release_shared 'registration' type invariant] [%#sactual_carrier'0] inv_Ghost_HandleRegistration registration'0)
  /\ ([@stop_split] [@expl:release_shared requires #0] [%#sactual_carrier'1] registration'0.control'0 = control
    /\ matches registration'0 context.current)
  /\ ([@stop_split] [@expl:release_shared requires #1] [%#sactual_carrier'2] control.pointer = ptr)}
  any
  [ return (result: bool) ->
  {[@stop_split] [@expl:release_shared ensures] ([@stop_split] [@expl:release_shared ensures #0] [%#sactual_carrier'3] valid'0 context.final control)
    /\ ([@stop_split] [@expl:release_shared ensures #1] [%#sactual_carrier'4] result = (not active context.final))
    /\ ([@stop_split] [@expl:release_shared ensures #2] [%#sactual_carrier'5] result
      = (len_Int context.current.status.pending = 1))
    /\ ([@stop_split] [@expl:release_shared ensures #3] [%#sactual_carrier'6] result
      = is_empty_Int context.final.status.pending)
    /\ ([@stop_split] [@expl:release_shared ensures #4] [%#sactual_carrier'7] context.final.status.capacity
        = context.current.status.capacity
      /\ context.final.status.allocation = context.current.status.allocation
      /\ context.final.status.registration = context.current.status.registration)
    /\ ([@stop_split] [@expl:release_shared ensures #5] [%#sactual_carrier'8] context.final.status.pending
      = remove_Int context.current.status.pending (logical_id registration'0.packet'0.f0))
    /\ ([@stop_split] [@expl:release_shared ensures #6] [%#sactual_carrier'9] len_Int context.final.status.pending + 1
      = len_Int context.current.status.pending)
    /\ ([@stop_split] [@expl:release_shared ensures #7] [%#sactual_carrier'10] forall other: t_HandleRegistration. matches other context.current
        /\ logical_id other.packet'0.f0 <> logical_id registration'0.packet'0.f0 -> matches other context.final)}
    (! return {result}) ]

