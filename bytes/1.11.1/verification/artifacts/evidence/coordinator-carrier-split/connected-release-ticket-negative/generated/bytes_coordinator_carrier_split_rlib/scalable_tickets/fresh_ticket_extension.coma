      s7
    | s7 = {[@expl:assertion] [%#sscalable_tickets'6] op_FMap_Int_Excl_unit after_first second_ticket <> None'1} s8
    | s8 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & map: t_FMap_Int_Excl_unit = map
  | & first: int = first
  | & second: int = second
  | & first_ticket: t_FMap_Int_Excl_unit = Any.any_l ()
  | & second_ticket: t_FMap_Int_Excl_unit = Any.any_l ()
  | & after_first: t_FMap_Int_Excl_unit = Any.any_l () ])
  [ return (result: ()) ->
