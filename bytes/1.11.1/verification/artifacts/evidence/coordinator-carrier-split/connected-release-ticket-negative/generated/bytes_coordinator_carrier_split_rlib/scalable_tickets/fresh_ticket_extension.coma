let fresh_ticket_extension [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/coordinator-carrier-split/src/../../../../src/ownership_proof/scalable_tickets.rs" 240 0 244 1]
  (map: t_FMap_Int_Excl_unit) (first: int) (second: int) (return (x: ())) =
{[@stop_split] [@expl:fresh_ticket_extension requires] ([@stop_split] [@expl:fresh_ticket_extension requires #0] [%#sscalable_tickets'7] get_Int map first
    = None)
  /\ ([@stop_split] [@expl:fresh_ticket_extension requires #1] [%#sscalable_tickets'8] get_Int map second = None)
  /\ ([@stop_split] [@expl:fresh_ticket_extension requires #2] [%#sscalable_tickets'9] first <> second)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &first_ticket <- [%#sscalable_tickets] singleton_Int first { f0 = () } ] s1
    | s1 = [ &second_ticket <- [%#sscalable_tickets'0] singleton_Int second { f0 = () } ] s2
    | s2 =
      {[@expl:assertion] [%#sscalable_tickets'1] forall key: int. op_Option_Excl_unit (get_Int map key) (get_Int first_ticket key)
        <> None'0}
      s3
    | s3 = {[@expl:assertion] [%#sscalable_tickets'2] op_FMap_Int_Excl_unit map first_ticket <> None'1} s4
    | s4 =
      [ &after_first <- [%#sscalable_tickets'3] unwrap_Option_FMap_Int_Excl_unit (op_FMap_Int_Excl_unit map first_ticket) ]
      s5
    | s5 = {[@expl:assertion] [%#sscalable_tickets'4] forall key: int. Some'0 (get_Int after_first key)
        = op_Option_Excl_unit (get_Int map key) (get_Int first_ticket key)}
      s6
    | s6 =
      {[@expl:assertion] [%#sscalable_tickets'5] forall key: int. op_Option_Excl_unit (get_Int after_first key) (get_Int second_ticket key)
