use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Ordering = Less | Equal | Greater

predicate lt_log_Seq_Int (self: Seq.seq int) (other: Seq.seq int) =
  [%#sseq'1] (exists i: int. 0 <= i
      /\ i < Seq.length self
      /\ i < Seq.length other
      /\ (forall j: int. 0 <= j /\ j < i -> Seq.get self j = Seq.get other j) /\ Seq.get self i < Seq.get other i)
  \/ Seq.length self < Seq.length other
  /\ (forall i: int. 0 <= i /\ i < Seq.length self -> Seq.get self i = Seq.get other i)

predicate le_log_Seq_Int [@inline:trivial] (self: Seq.seq int) (other: Seq.seq int) =
  [%#sord'0] lt_log_Seq_Int self other \/ self = other

meta "rewrite_def" predicate le_log_Seq_Int

function le_lt_log_Seq_Int (self: Seq.seq int) (other: Seq.seq int) : ()

axiom le_lt_log_Seq_Int_spec: forall self: Seq.seq int, other: Seq.seq int. [%#sseq'6] le_log_Seq_Int self other
    = (lt_log_Seq_Int self other \/ self = other)

function transitive_Seq_Int (x: Seq.seq int) (y: Seq.seq int) (z: Seq.seq int) : ()

axiom transitive_Seq_Int_spec: forall x: Seq.seq int, y: Seq.seq int, z: Seq.seq int. ([%#sseq'3] lt_log_Seq_Int x y)
    -> ([%#sseq'4] lt_log_Seq_Int y z) -> ([%#sseq'5] lt_log_Seq_Int x z)

function irreflexive_Seq_Int (self: Seq.seq int) : ()

axiom irreflexive_Seq_Int_spec: forall self: Seq.seq int. [%#sseq'2] not lt_log_Seq_Int self self

function lt_log_total_Seq_Int (self: Seq.seq int) (other: Seq.seq int) : ()

axiom lt_log_total_Seq_Int_spec: forall self: Seq.seq int, other: Seq.seq int. [%#sseq'0] lt_log_Seq_Int self other
    \/ self = other \/ lt_log_Seq_Int other self

function cmp_log_Seq_Int (self: Seq.seq int) (other: Seq.seq int) : t_Ordering = [%#sord] if self = other then
    Equal
  else
    if lt_log_Seq_Int self other then Less else Greater


function deep_model_u8 [@inline:trivial] (self: UInt8.t) : int = [%#snum] UInt8.t'int self

meta "rewrite_def" function deep_model_u8

function index_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: int) : UInt8.t =
  [%#sslice'1] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_u8

function deep_model_slice_u8 (self: Slice64.slice UInt8.t) : Seq.seq int

axiom deep_model_slice_u8_spec:
  forall self: Slice64.slice UInt8.t [deep_model_slice_u8 self]. [%#sslice] Seq.length (Slice64.view self)
    = Seq.length (deep_model_slice_u8 self)

axiom deep_model_slice_u8_spec'0:
  forall self: Slice64.slice UInt8.t [deep_model_slice_u8 self]. [%#sslice'0] forall i: int. 0 <= i
        /\ i < Seq.length (deep_model_slice_u8 self)
      -> Seq.get (deep_model_slice_u8 self) i = deep_model_u8 (index_slice_u8 self i)

let cmp_slice_u8 (self_: Slice64.slice UInt8.t) (rhs: Slice64.slice UInt8.t) (return (x: t_Ordering)) = any
  [ return (result: t_Ordering) -> {[@stop_split] [@expl:cmp ensures] [%#scmp] result
    = cmp_log_Seq_Int (deep_model_slice_u8 self_) (deep_model_slice_u8 rhs)}
    (! return {result}) ]

function deep_model_ref_slice_u8 [@inline:trivial] (self: Slice64.slice UInt8.t) : Seq.seq int =
  [%#smodel] deep_model_slice_u8 self

meta "rewrite_def" function deep_model_ref_slice_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let compare [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/comparison-ops/src/../../../../src/comparison_ops.rs" 13 0 13 71]
  (left: Slice64.slice UInt8.t) (right: Slice64.slice UInt8.t) (return (x: t_Ordering)) = (! bb0
  [ bb0 = s0
    [ s0 = cmp_slice_u8 [%#scomparison_ops] {left} {right} (fun (_x: t_Ordering) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_Ordering = Any.any_l () | & left: Slice64.slice UInt8.t = left | & right: Slice64.slice UInt8.t = right ])
  [ return (result: t_Ordering) -> {[@stop_split] [@expl:compare ensures] [%#scomparison_ops'0] result
    = cmp_log_Seq_Int (deep_model_ref_slice_u8 left) (deep_model_ref_slice_u8 right)}
    (! return {result}) ]
