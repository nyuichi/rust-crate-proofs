use creusot.int.UInt32
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_4 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u8_4 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_4 _1

meta "rewrite_def" predicate inv_array_u8_4

let encode_be_u32 (value: UInt32.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_be_u32 ensures] ([@stop_split] [@expl:encode_be_u32 result type invariant] [%#sbyte_codec_ops] inv_array_u8_4 result)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #0] [%#sbyte_codec_ops'0] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.div (UInt32.t'int value) 16777216)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #1] [%#sbyte_codec_ops'1] UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 65536) 256)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #2] [%#sbyte_codec_ops'2] UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 256) 256)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #3] [%#sbyte_codec_ops'3] UInt8.t'int (Seq.get (Slice64.view result) 3)
    = ComputerDivision.mod (UInt32.t'int value) 256)}
    (! return {result}) ]

let decode_be_u32 (bytes: Slice64.array UInt8.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:decode_be_u32 'bytes' type invariant] [%#sbyte_codec_ops'4] inv_array_u8_4 bytes}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:decode_be_u32 ensures] [%#sbyte_codec_ops'5] UInt32.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) * 16777216 + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 65536
      + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 256
    + UInt8.t'int (Seq.get (Slice64.view bytes) 3)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let round_trip_u32 [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/byte-codecs/src/lib.rs" 18 0 18 40]
  (value: UInt32.t) (return (x: UInt32.t)) = (! bb0
  [ bb0 = s0
    [ s0 = encode_be_u32 [%#slib] {value} (fun (_x: Slice64.array UInt8.t) -> [ &_4 <- _x ] s1)
    | s1 = decode_be_u32 [%#slib'0] {_4} (fun (_x: UInt32.t) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: UInt32.t = Any.any_l () | & value: UInt32.t = value | & _4: Slice64.array UInt8.t = Any.any_l () ])
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:round_trip_u32 ensures] [%#slib'1] UInt32.t'int result
    = UInt32.t'int value}
    (! return {result}) ]
