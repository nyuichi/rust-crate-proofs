let%span slib = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 40 15 40 32
let%span slib'0 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 41 13 41 14
let%span slib'1 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 39 27 39 32
let%span slib'2 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 38 10 38 30
