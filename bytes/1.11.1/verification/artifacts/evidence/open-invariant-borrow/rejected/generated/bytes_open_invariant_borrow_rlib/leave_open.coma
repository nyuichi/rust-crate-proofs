(* #"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 12 0 12 65 *)

let%span slib = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 13 14 13 15
let%span slib'0 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 10 10 10 28
let%span slib'1 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 11 10 11 27
let%span slib'2 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 6 45 6 61
let%span sinvariant = "/workspace/bytes-proof-tools/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/invariant.rs" 93 20 93 44

use creusot.int.UInt64
use creusot.prelude.MutBorrow
use int.ComputerDivision
use creusot.prelude.Any

type t_Even = { f0: UInt64.t }

predicate invariant_Even [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 6 4 6 30] (self: t_Even) =
  [%#slib'2] ComputerDivision.mod (UInt64.t'int self.f0) 2 = 0

predicate inv_Even (_1: t_Even)

axiom inv_axiom [@rewrite]: forall x: t_Even [inv_Even x]. inv_Even x = invariant_Even x

predicate invariant_refmut_Even [@inline:trivial] (self: MutBorrow.t t_Even) =
  [%#sinvariant] inv_Even self.current /\ inv_Even self.final

meta "rewrite_def" predicate invariant_refmut_Even

predicate inv_refmut_Even [@inline:trivial] (_1: MutBorrow.t t_Even) = invariant_refmut_Even _1

meta "rewrite_def" predicate inv_refmut_Even

predicate resolve_refmut_Even [@inline:trivial] (_1: MutBorrow.t t_Even) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Even

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let leave_open [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 12 0 12 65]
  (value: MutBorrow.t t_Even) (return (x: MutBorrow.t t_Even)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &value <- { value with current = { f0 = ([%#slib] (1: UInt64.t)) } } ] s1
    | s1 = MutBorrow.borrow_final <t_Even> {value.current} {MutBorrow.get_id value}
        (fun (_bor: MutBorrow.t t_Even) ->
          [ &_2 <- _bor ] -{inv_Even _bor.final}-
          [ &value <- { value with current = _bor.final } ] s2)
      [ _ck -> (! {[@expl:type invariant] inv_Even value.current} any) ]
    | s2 = MutBorrow.borrow_final <t_Even> {_2.current} {MutBorrow.get_id _2}
        (fun (_bor: MutBorrow.t t_Even) ->
          [ &_ret <- _bor ] -{inv_Even _bor.final}-
          [ &_2 <- { _2 with current = _bor.final } ] s3)
      [ _ck -> (! {[@expl:type invariant] inv_Even _2.current} any) ]
    | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_Even _2} any) ]
    | s4 = -{resolve_refmut_Even _2}- s5
    | s5 = s6 [ _ck -> (! {[@expl:type invariant] inv_refmut_Even value} any) ]
    | s6 = -{resolve_refmut_Even value}- s7
    | s7 = return {_ret} ] ]
  [ & _ret: MutBorrow.t t_Even = Any.any_l ()
  | & value: MutBorrow.t t_Even = value
  | & _2: MutBorrow.t t_Even = Any.any_l () ])
  [ return (result: MutBorrow.t t_Even) ->
  {[@stop_split] [@expl:leave_open ensures] ([@stop_split] [@expl:leave_open ensures #0] [%#slib'0] result.current.f0
      = (1: UInt64.t))
    /\ ([@stop_split] [@expl:leave_open ensures #1] [%#slib'1] result.final = value.final)}
    (! return {result}) ]
