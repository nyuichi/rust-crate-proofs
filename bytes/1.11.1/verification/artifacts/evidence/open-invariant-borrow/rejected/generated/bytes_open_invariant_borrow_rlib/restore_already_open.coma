use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_Even = { f0: UInt64.t }

predicate invariant_Even [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 6 4 6 30] (self: t_Even) =
  [%#slib'7] ComputerDivision.mod (UInt64.t'int self.f0) 2 = 0

predicate inv_Even (_1: t_Even)

axiom inv_axiom [@rewrite]: forall x: t_Even [inv_Even x]. inv_Even x = invariant_Even x

let leave_open (value: MutBorrow.t t_Even) (return (x: MutBorrow.t t_Even)) = any
  [ return (result: MutBorrow.t t_Even) ->
  {[@stop_split] [@expl:leave_open ensures] ([@stop_split] [@expl:leave_open ensures #0] [%#slib'5] result.current.f0
      = (1: UInt64.t))
    /\ ([@stop_split] [@expl:leave_open ensures #1] [%#slib'6] result.final = value.final)}
    (! return {result}) ]

predicate invariant_refmut_Even [@inline:trivial] (self: MutBorrow.t t_Even) =
  [%#sinvariant] inv_Even self.current /\ inv_Even self.final

meta "rewrite_def" predicate invariant_refmut_Even

predicate inv_refmut_Even [@inline:trivial] (_1: MutBorrow.t t_Even) = invariant_refmut_Even _1

meta "rewrite_def" predicate inv_refmut_Even

predicate resolve_refmut_Even [@inline:trivial] (_1: MutBorrow.t t_Even) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Even

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let restore_already_open [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/open-invariant-borrow/src/lib.rs" 24 0 24 52]
  (value: t_Even) (return (x: t_Even)) =
{[@stop_split] [@expl:restore_already_open 'value' type invariant] [%#slib'2] inv_Even value}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &value <- { f0 = ([%#slib] (3: UInt64.t)) } ] s1
    | s1 = MutBorrow.borrow_mut <t_Even> {value}
        (fun (_bor: MutBorrow.t t_Even) -> [ &_5 <- _bor ] -{inv_Even _bor.final}- [ &value <- _bor.final ] s2)
      [ _ck -> (! {[@expl:type invariant] inv_Even value} any) ]
    | s2 = MutBorrow.borrow_final <t_Even> {_5.current} {MutBorrow.get_id _5}
        (fun (_bor: MutBorrow.t t_Even) ->
          [ &_4 <- _bor ] -{inv_Even _bor.final}-
          [ &_5 <- { _5 with current = _bor.final } ] s3)
      [ _ck -> (! {[@expl:type invariant] inv_Even _5.current} any) ]
    | s3 = leave_open [%#slib'0] {_4} (fun (_x: MutBorrow.t t_Even) -> [ &open <- _x ] s4)
    | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_refmut_Even _5} any) ]
    | s5 = -{resolve_refmut_Even _5}- s6
    | s6 = [ &open <- { open with current = { f0 = ([%#slib'1] (2: UInt64.t)) } } ] s7
    | s7 = s8 [ _ck -> (! {[@expl:type invariant] inv_refmut_Even open} any) ]
    | s8 = -{resolve_refmut_Even open}- s9
    | s9 = [ &_ret <- value ] s10
    | s10 = return {_ret} ] ]
  [ & _ret: t_Even = Any.any_l ()
  | & value: t_Even = value
  | & open: MutBorrow.t t_Even = Any.any_l ()
  | & _4: MutBorrow.t t_Even = Any.any_l ()
  | & _5: MutBorrow.t t_Even = Any.any_l () ])
  [ return (result: t_Even) ->
  {[@stop_split] [@expl:restore_already_open ensures] ([@stop_split] [@expl:restore_already_open result type invariant] [%#slib'3] inv_Even result)
    /\ ([@stop_split] [@expl:restore_already_open ensures] [%#slib'4] result.f0 = (2: UInt64.t))}
    (! return {result}) ]
