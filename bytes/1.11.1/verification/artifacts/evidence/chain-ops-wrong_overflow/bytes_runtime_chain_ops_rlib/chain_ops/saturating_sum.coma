  [ return (result: UInt64.t) -> {[@stop_split] [@expl:saturating_sum ensures] [%#schain_ops'0] UInt64.t'int result
    = (if UInt64.t'int a + UInt64.t'int b <= UInt64.t'int const_MAX then
