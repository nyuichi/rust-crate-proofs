type t_Option_u32 = None | Some UInt32.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_le_u32 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_u32)) = any
  [ return (result: t_Option_u32) -> {[@stop_split] [@expl:read_le_u32 ensures] [%#sendian_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 4
      /\ UInt32.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0)
            + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 256
          + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 65536
        + UInt8.t'int (Seq.get (Slice64.view input.current) 3) * 16777216
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 4 }
      | None -> Seq.length (Slice64.view input.current) < 4 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

