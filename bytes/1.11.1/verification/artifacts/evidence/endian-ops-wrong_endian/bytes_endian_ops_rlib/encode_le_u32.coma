use creusot.int.UInt32
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_4 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u8_4 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_4 _1

meta "rewrite_def" predicate inv_array_u8_4

let encode_le_u32 (value: UInt32.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_le_u32 ensures] ([@stop_split] [@expl:encode_le_u32 result type invariant] [%#sendian_ops] inv_array_u8_4 result)
    /\ ([@stop_split] [@expl:encode_le_u32 ensures #0] [%#sendian_ops'0] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.mod (UInt32.t'int value) 256)
    /\ ([@stop_split] [@expl:encode_le_u32 ensures #1] [%#sendian_ops'1] UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 256) 256)
    /\ ([@stop_split] [@expl:encode_le_u32 ensures #2] [%#sendian_ops'2] UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 65536) 256)
    /\ ([@stop_split] [@expl:encode_le_u32 ensures #3] [%#sendian_ops'3] UInt8.t'int (Seq.get (Slice64.view result) 3)
    = ComputerDivision.div (UInt32.t'int value) 16777216)}
    (! return {result}) ]

