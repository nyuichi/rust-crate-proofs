(* #"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/address-comparison/src/lib.rs" 8 0 8 67 *)

let%span sprovenance_specs = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/address-comparison/src/../../../../src/provenance_specs.rs" 18 28 18 79
let%span slib = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/address-comparison/src/lib.rs" 9 4 9 50
let%span slib'0 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/address-comparison/src/lib.rs" 7 10 7 61

use creusot.prelude.Opaque
use creusot.prelude.Ptr
use creusot.prelude.Any

let pointer_addr_eq_u8 (left: Opaque.ptr) (right: Opaque.ptr) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:pointer_addr_eq ensures] [%#sprovenance_specs] result
    = (Ptr.addr_logic_u64 left = Ptr.addr_logic_u64 right)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let compare_addresses [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/address-comparison/src/lib.rs" 8 0 8 67]
  (left: Opaque.ptr) (right: Opaque.ptr) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = pointer_addr_eq_u8 [%#slib] {left} {right} (fun (_x: bool) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & left: Opaque.ptr = left | & right: Opaque.ptr = right ])
  [ return (result: bool) -> {[@stop_split] [@expl:compare_addresses ensures] [%#slib'0] result
    = (Ptr.addr_logic_u64 left = Ptr.addr_logic_u64 right)}
    (! return {result}) ]
