let rejected_overlap [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/owned-region-kernel/src/lib.rs" 95 0 95 73]
  (left: t_OwnedRegion) (right: t_OwnedRegion) (return (x: t_OwnedRegion)) =
{[@stop_split] [@expl:rejected_overlap requires] ([@stop_split] [@expl:rejected_overlap 'left' type invariant] [%#slib'0] inv_OwnedRegion left)
  /\ ([@stop_split] [@expl:rejected_overlap 'right' type invariant] [%#slib'1] inv_OwnedRegion right)
  /\ ([@stop_split] [@expl:rejected_overlap requires #0] [%#slib'2] invariant_OwnedRegion left
    /\ invariant_OwnedRegion right)
  /\ ([@stop_split] [@expl:rejected_overlap requires #1] [%#slib'3] resource_id left = resource_id right)
  /\ ([@stop_split] [@expl:rejected_overlap requires #2] [%#slib'4] lo right < hi left)}
  (! bb0
  [ bb0 = s0
    [ s0 = join [%#slib] {left} {right} (fun (_x: t_OwnedRegion) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_OwnedRegion = Any.any_l () | & left: t_OwnedRegion = left | & right: t_OwnedRegion = right ])
  [ return (result: t_OwnedRegion) ->
  {[@stop_split] [@expl:rejected_overlap result type invariant] [%#slib'5] inv_OwnedRegion result}
    (! return {result}) ]
