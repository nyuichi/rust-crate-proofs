let join (self: t_OwnedRegion) (other: t_OwnedRegion) (return (x: t_OwnedRegion)) =
{[@stop_split] [@expl:join requires] ([@stop_split] [@expl:join 'self' type invariant] [%#sowned_region] inv_OwnedRegion self)
  /\ ([@stop_split] [@expl:join 'other' type invariant] [%#sowned_region'0] inv_OwnedRegion other)
  /\ ([@stop_split] [@expl:join requires #0] [%#sowned_region'1] invariant_OwnedRegion self
    /\ invariant_OwnedRegion other)
  /\ ([@stop_split] [@expl:join requires #1] [%#sowned_region'2] resource_id self = resource_id other)
  /\ ([@stop_split] [@expl:join requires #2] [%#sowned_region'3] hi self = lo other)}
  any
  [ return (result: t_OwnedRegion) ->
  {[@stop_split] [@expl:join ensures] ([@stop_split] [@expl:join result type invariant] [%#sowned_region'4] inv_OwnedRegion result)
    /\ ([@stop_split] [@expl:join ensures #0] [%#sowned_region'5] invariant_OwnedRegion result)
    /\ ([@stop_split] [@expl:join ensures #1] [%#sowned_region'6] lo result = lo self /\ hi result = hi other)
    /\ ([@stop_split] [@expl:join ensures #2] [%#sowned_region'7] resource_id result = resource_id self)
    /\ ([@stop_split] [@expl:join ensures #3] [%#sowned_region'8] forall index: int. slot result index
      = (if lo self <= index /\ index < hi self then
        slot self index
      else
        if lo other <= index /\ index < hi other then slot other index else None'1
      ))}
    (! return {result}) ]

