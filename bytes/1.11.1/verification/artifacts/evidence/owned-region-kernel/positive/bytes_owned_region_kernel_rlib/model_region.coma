use creusot.int.UInt8
use map.Map
use map.Const
use creusot.int.Int128
use creusot.prelude.Any
use int.Int

type t_FMap_Int_Excl_Option_u8

type t_Option_u8 = None | Some UInt8.t

type t_Excl_Option_u8 = { f0: t_Option_u8 }

type t_Option_Excl_Option_u8 = None'0 | Some'0 t_Excl_Option_u8

function to_mapping_Int (self: t_FMap_Int_Excl_Option_u8) : Map.map int t_Option_Excl_Option_u8

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function len_Int (self: t_FMap_Int_Excl_Option_u8) : int

axiom len_Int_spec: forall self: t_FMap_Int_Excl_Option_u8 [len_Int self]. [%#sfmap'4] ge_log_Int (len_Int self) 0

function get_Int [@inline:trivial] (self: t_FMap_Int_Excl_Option_u8) (k: int) : t_Option_Excl_Option_u8 =
  [%#sfmap'3] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Excl_Option_u8) (k: int) =
  [%#sfmap'5] get_Int self k <> None'0

meta "rewrite_def" predicate contains_Int

function insert_Int (self: t_FMap_Int_Excl_Option_u8) (k: int) (v: t_Excl_Option_u8) : t_FMap_Int_Excl_Option_u8

axiom insert_Int_spec:
  forall self: t_FMap_Int_Excl_Option_u8, k: int, v: t_Excl_Option_u8 [insert_Int self k v]. [%#sfmap] to_mapping_Int (insert_Int self k v)
    = Map.set (to_mapping_Int self) k (Some'0 v)

axiom insert_Int_spec'0:
  forall self: t_FMap_Int_Excl_Option_u8, k: int, v: t_Excl_Option_u8 [insert_Int self k v]. [%#sfmap'0] len_Int (insert_Int self k v)
    = (if contains_Int self k then len_Int self else len_Int self + 1)

constant empty_Int : t_FMap_Int_Excl_Option_u8

axiom empty_Int_spec: [%#sfmap'1] len_Int empty_Int = 0

axiom empty_Int_spec'0: [%#sfmap'2] to_mapping_Int empty_Int = Const.const (None'0)

type t_Excl_unit = { f0'0: () }

type t_Option_Excl_unit = None'1 | Some'1 t_Excl_unit

type tup2_Option_Excl_unit_FMap_Int_Excl_Option_u8 = { f0'1: t_Option_Excl_unit; f1'1: t_FMap_Int_Excl_Option_u8 }

type t_Option_Option_Excl_Option_u8 = None'2 | Some'2 t_Option_Excl_Option_u8

type tup2_Option_Excl_Option_u8_Option_Excl_Option_u8 = { f0'2: t_Option_Excl_Option_u8; f1'2: t_Option_Excl_Option_u8 }

function map_Option_Excl_Option_u8 (self: t_Option_Excl_Option_u8) (f: Map.map t_Excl_Option_u8 t_Option_Excl_Option_u8) : t_Option_Option_Excl_Option_u8
 = [%#soption'1] match self with
    | None'0 -> None'2
    | Some'0 x -> Some'2 (Map.get f x)
    end

function op_Excl_Option_u8 (self: t_Excl_Option_u8) (_other: t_Excl_Option_u8) : t_Option_Excl_Option_u8 =
  [%#sexcl] None'0

function commutative_Excl_Option_u8 (a: t_Excl_Option_u8) (b: t_Excl_Option_u8) : ()

axiom commutative_Excl_Option_u8_spec:
  forall a: t_Excl_Option_u8, b: t_Excl_Option_u8. [%#sexcl'0] op_Excl_Option_u8 a b = op_Excl_Option_u8 b a

function op_Option_Excl_Option_u8 (self: t_Option_Excl_Option_u8) (other: t_Option_Excl_Option_u8) : t_Option_Option_Excl_Option_u8
 = [%#soption] match { f0'2 = self; f1'2 = other } with
    | {f0'2 = None'0} -> Some'2 other
    | {f1'2 = None'0} -> Some'2 self
    | {f0'2 = Some'0 x; f1'2 = Some'0 y} -> map_Option_Excl_Option_u8 (op_Excl_Option_u8 x y) (fun (z: t_Excl_Option_u8) -> Some'0 z)
    end

function commutative_Option_Excl_Option_u8 (a: t_Option_Excl_Option_u8) (b: t_Option_Excl_Option_u8) : ()

axiom commutative_Option_Excl_Option_u8_spec:
  forall a: t_Option_Excl_Option_u8, b: t_Option_Excl_Option_u8. [%#soption'0] op_Option_Excl_Option_u8 a b
