use creusot.prelude.Opaque
use creusot.int.UInt64
use creusot.prelude.Ptr
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

constant size_of_u8: int = 1

meta "rewrite_def" constant size_of_u8

axiom size_of_u8_spec: [%#smem] 0 <= size_of_u8

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let wrapping_add_u8 (self_: Opaque.ptr) (offset: UInt64.t) (return (x: Opaque.ptr)) =
{[@stop_split] [@expl:wrapping_add requires] [%#sprovenance_specs'1] size_of_u8 = 1}
  any
  [ return (result: Opaque.ptr) ->
  {[@stop_split] [@expl:wrapping_add ensures] [%#sprovenance_specs'2] UInt64.t'int (Ptr.addr_logic_u64 result)
    = ComputerDivision.mod (UInt64.t'int (Ptr.addr_logic_u64 self_) + UInt64.t'int offset) (UInt64.t'int const_MAX + 1)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wrapping_offset [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/bound-pointer-offset/src/../../../../src/provenance_specs.rs" 75 0 75 69]
  (ptr: Opaque.ptr) (offset: UInt64.t) (return (x: Opaque.ptr)) = (! bb0
  [ bb0 = s0
    [ s0 = wrapping_add_u8 [%#sprovenance_specs] {ptr} {offset} (fun (_x: Opaque.ptr) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: Opaque.ptr = Any.any_l () | & ptr: Opaque.ptr = ptr | & offset: UInt64.t = offset ])
  [ return (result: Opaque.ptr) ->
  {[@stop_split] [@expl:wrapping_offset ensures] [%#sprovenance_specs'0] UInt64.t'int (Ptr.addr_logic_u64 result)
    = ComputerDivision.mod (UInt64.t'int (Ptr.addr_logic_u64 ptr) + UInt64.t'int offset) (UInt64.t'int const_MAX + 1)}
    (! return {result}) ]
