use creusot.int.UInt64
use creusot.prelude.Any

predicate ge_log_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) = [%#sord] UInt64.le other self

meta "rewrite_def" predicate ge_log_usize

let reconstructed_original_capacity (cap: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:reconstructed_original_capacity ensures] ([@stop_split] [@expl:reconstructed_original_capacity ensures #0] [%#scapacity_ops] UInt64.le result cap)
    /\ ([@stop_split] [@expl:reconstructed_original_capacity ensures #1] [%#scapacity_ops'0] UInt64.lt cap (UInt64.shl (1: UInt64.t) (10: UInt64.t))
      -> result = (0: UInt64.t))
    /\ ([@stop_split] [@expl:reconstructed_original_capacity ensures #2] [%#scapacity_ops'1] ge_log_usize cap (UInt64.shl (1: UInt64.t) (10: UInt64.t))
      -> ge_log_usize result (UInt64.shl (1: UInt64.t) (10: UInt64.t)))
    /\ ([@stop_split] [@expl:reconstructed_original_capacity ensures #3] [%#scapacity_ops'2] UInt64.le result (UInt64.shl (1: UInt64.t) (16: UInt64.t)))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let reconstructed_capacity [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/capacity-ops/src/lib.rs" 40 0 40 55]
  (capacity: UInt64.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = reconstructed_original_capacity [%#slib] {capacity} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt64.t = Any.any_l () | & capacity: UInt64.t = capacity ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:reconstructed_capacity ensures] ([@stop_split] [@expl:reconstructed_capacity ensures #0] [%#slib'0] UInt64.le result capacity)
    /\ ([@stop_split] [@expl:reconstructed_capacity ensures #1] [%#slib'1] UInt64.lt capacity (UInt64.shl (1: UInt64.t) (10: UInt64.t))
      -> result = (0: UInt64.t))
    /\ ([@stop_split] [@expl:reconstructed_capacity ensures #2] [%#slib'2] ge_log_usize capacity (UInt64.shl (1: UInt64.t) (10: UInt64.t))
      -> ge_log_usize result (UInt64.shl (1: UInt64.t) (10: UInt64.t)))
    /\ ([@stop_split] [@expl:reconstructed_capacity ensures #3] [%#slib'3] UInt64.le result (UInt64.shl (1: UInt64.t) (16: UInt64.t)))}
    (! return {result}) ]
