use int.Int

type t_BoundPtr

type t_Recovery

type t_PhysicalRegion

type tup2_Recovery_PhysicalRegion = { f0: t_Recovery; f1: t_PhysicalRegion }

type t_Option_tup2_Recovery_PhysicalRegion = None | Some tup2_Recovery_PhysicalRegion

type t_CounterOwn

type t_Perm_ptr_Shared

type t_PendingControl = { counter: t_CounterOwn; owner: t_Perm_ptr_Shared; caps: tup2_Recovery_PhysicalRegion }

type t_Option_PendingControl = None'0 | Some'0 t_PendingControl

type t_Id

type t_ControlPtr = { pointer: Opaque.ptr; identity: t_Id }

type t_Status = {
  capacity: int;
  allocation: t_Id;
  split: int;
  registration: t_Id;
  left_pending: bool;
