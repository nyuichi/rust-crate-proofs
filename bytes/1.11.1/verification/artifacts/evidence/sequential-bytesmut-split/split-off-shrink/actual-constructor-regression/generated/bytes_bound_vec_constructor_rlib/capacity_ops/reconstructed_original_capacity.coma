constant const_MAX_ORIGINAL_CAPACITY_WIDTH: UInt64BW.t = [%#scapacity_ops'13] (17: UInt64BW.t)

constant const_MIN_ORIGINAL_CAPACITY_WIDTH: UInt64BW.t = [%#scapacity_ops'13] (10: UInt64BW.t)

constant const_BITS: UInt32BW.t = (64: UInt32BW.t)

function leading_zeros_usize (self: UInt64BW.t) : UInt32BW.t

axiom leading_zeros_usize_spec:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum] UInt32BW.le (leading_zeros_usize self) const_BITS

axiom leading_zeros_usize_spec'0:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum'0] (leading_zeros_usize self <> const_BITS)
    = (UInt64BW.shr self (UInt64BW.of_BV256 (UInt32BW.to_BV256 (UInt32BW.sub (UInt32BW.sub const_BITS (leading_zeros_usize self)) (1: UInt32BW.t))))
    = (1: UInt64BW.t))

axiom leading_zeros_usize_spec'1:
  forall self: UInt64BW.t [leading_zeros_usize self]. [%#snum'1] (leading_zeros_usize self = const_BITS)
    = (self = (0: UInt64BW.t))

constant const_PTR_WIDTH: UInt64BW.t = [%#scapacity_ops'13] (64: UInt64BW.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function original_capacity_class [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/bound-vec-constructor/src/../../../../src/capacity_ops.rs" 41 0 41 62] (cap: UInt64BW.t) : int
 = [%#scapacity_ops'14] if UInt32BW.t'int (leading_zeros_usize (UInt64BW.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))
  = UInt64BW.t'int const_PTR_WIDTH then
    0
  else
    if gt_log_Int (UInt64BW.t'int const_PTR_WIDTH
    - UInt32BW.t'int (leading_zeros_usize (UInt64BW.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))) (UInt64BW.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH
    - UInt64BW.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH) then
      UInt64BW.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH - UInt64BW.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH
    else
      UInt64BW.t'int const_PTR_WIDTH
      - UInt32BW.t'int (leading_zeros_usize (UInt64BW.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))
  


let original_capacity_to_repr (cap: UInt64BW.t) (return (x: UInt64BW.t)) = any
  [ return (result: UInt64BW.t) ->
