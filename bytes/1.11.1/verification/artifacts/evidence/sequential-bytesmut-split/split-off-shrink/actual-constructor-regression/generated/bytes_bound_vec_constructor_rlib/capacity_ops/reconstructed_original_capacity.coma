        - UInt32BW.t'int (leading_zeros_usize (UInt64BW.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))) (UInt64BW.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH
        - UInt64BW.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH) then
