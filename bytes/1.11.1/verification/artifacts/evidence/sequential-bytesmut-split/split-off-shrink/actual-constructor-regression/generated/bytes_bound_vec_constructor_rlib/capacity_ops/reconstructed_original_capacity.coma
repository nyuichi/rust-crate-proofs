          - UInt32BW.t'int (leading_zeros_usize (UInt64BW.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))
      
      ))
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #2] [%#scapacity_ops'7] UInt64BW.t'int result
    = original_capacity_class cap)}
    (! return {result}) ]

predicate gt_log_usize [@inline:trivial] (self: UInt64BW.t) (other: UInt64BW.t) = [%#sord'0] UInt64BW.lt other self

meta "rewrite_def" predicate gt_log_usize

predicate ge_log_usize [@inline:trivial] (self: UInt64BW.t) (other: UInt64BW.t) = [%#sord] UInt64BW.le other self

