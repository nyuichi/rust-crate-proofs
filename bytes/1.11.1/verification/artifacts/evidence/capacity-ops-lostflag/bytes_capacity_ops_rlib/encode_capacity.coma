use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any
use int.Int

constant const_MAX_ORIGINAL_CAPACITY_WIDTH: UInt64.t = [%#slib'2] (17: UInt64.t)

constant const_MIN_ORIGINAL_CAPACITY_WIDTH: UInt64.t = [%#slib'2] (10: UInt64.t)

constant const_BITS: UInt32.t = (64: UInt32.t)

function leading_zeros_usize (self: UInt64.t) : UInt32.t

axiom leading_zeros_usize_spec:
  forall self: UInt64.t [leading_zeros_usize self]. [%#snum] UInt32.le (leading_zeros_usize self) const_BITS

axiom leading_zeros_usize_spec'0: forall self: UInt64.t [leading_zeros_usize self]. [%#snum'0] (leading_zeros_usize self
      <> const_BITS)
    = (UInt64.shr self (UInt64.of_int (UInt32.t'int (UInt32.sub (UInt32.sub const_BITS (leading_zeros_usize self)) (1: UInt32.t))))
    = (1: UInt64.t))

axiom leading_zeros_usize_spec'1: forall self: UInt64.t [leading_zeros_usize self]. [%#snum'1] (leading_zeros_usize self
      = const_BITS)
    = (self = (0: UInt64.t))

constant const_PTR_WIDTH: UInt64.t = [%#slib'2] (64: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

let original_capacity_to_repr (cap: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:original_capacity_to_repr ensures] ([@stop_split] [@expl:original_capacity_to_repr ensures #0] [%#scapacity_ops] UInt64.t'int result
      <= UInt64.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH - UInt64.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH)
    /\ ([@stop_split] [@expl:original_capacity_to_repr ensures #1] [%#scapacity_ops'0] UInt64.t'int result
    = (if UInt32.t'int (leading_zeros_usize (UInt64.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))
    = UInt64.t'int const_PTR_WIDTH then
      0
    else
      if gt_log_Int (UInt64.t'int const_PTR_WIDTH
      - UInt32.t'int (leading_zeros_usize (UInt64.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))) (UInt64.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH
      - UInt64.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH) then
        UInt64.t'int const_MAX_ORIGINAL_CAPACITY_WIDTH - UInt64.t'int const_MIN_ORIGINAL_CAPACITY_WIDTH
      else
        UInt64.t'int const_PTR_WIDTH
        - UInt32.t'int (leading_zeros_usize (UInt64.shr cap const_MIN_ORIGINAL_CAPACITY_WIDTH))
    
    ))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let encode_capacity [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/capacity-ops/src/lib.rs" 21 0 21 48]
  (capacity: UInt64.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = original_capacity_to_repr [%#slib] {capacity} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt64.t = Any.any_l () | & capacity: UInt64.t = capacity ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:encode_capacity ensures] ([@stop_split] [@expl:encode_capacity ensures #0] [%#slib'0] UInt64.t'int result
      <= 7)
    /\ ([@stop_split] [@expl:encode_capacity ensures #1] [%#slib'1] UInt64.t'int result
    = (if UInt32.t'int (leading_zeros_usize (UInt64.shr capacity const_MIN_ORIGINAL_CAPACITY_WIDTH)) = 64 then
      0
    else
      if gt_log_Int (64
      - UInt32.t'int (leading_zeros_usize (UInt64.shr capacity const_MIN_ORIGINAL_CAPACITY_WIDTH))) 7 then
        7
      else
        64 - UInt32.t'int (leading_zeros_usize (UInt64.shr capacity const_MIN_ORIGINAL_CAPACITY_WIDTH))
    
    ))}
    (! return {result}) ]
