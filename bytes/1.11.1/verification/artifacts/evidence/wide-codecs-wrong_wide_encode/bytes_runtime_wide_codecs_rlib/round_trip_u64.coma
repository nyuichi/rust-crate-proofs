predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_8 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (8: UInt64.t)

predicate inv_array_u8_8 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_8 _1

meta "rewrite_def" predicate inv_array_u8_8

let encode_be_u64 (value: UInt64.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_be_u64 ensures] ([@stop_split] [@expl:encode_be_u64 result type invariant] [%#sbyte_codec_wide_ops] inv_array_u8_8 result)
    /\ ([@stop_split] [@expl:encode_be_u64 ensures] [%#sbyte_codec_wide_ops'0] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.div (UInt64.t'int value) 72057594037927936
    /\ UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 281474976710656) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 1099511627776) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 3)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 4294967296) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 4)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 16777216) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 5)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 65536) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 6)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 256) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 7) = ComputerDivision.mod (UInt64.t'int value) 256)}
    (! return {result}) ]

let decode_be_u64 (bytes: Slice64.array UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:decode_be_u64 'bytes' type invariant] [%#sbyte_codec_wide_ops'1] inv_array_u8_8 bytes}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:decode_be_u64 ensures] [%#sbyte_codec_wide_ops'2] UInt64.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) * 72057594037927936
                + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 281474976710656
              + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 1099511627776
            + UInt8.t'int (Seq.get (Slice64.view bytes) 3) * 4294967296
          + UInt8.t'int (Seq.get (Slice64.view bytes) 4) * 16777216
        + UInt8.t'int (Seq.get (Slice64.view bytes) 5) * 65536
      + UInt8.t'int (Seq.get (Slice64.view bytes) 6) * 256
    + UInt8.t'int (Seq.get (Slice64.view bytes) 7)}
    (! return {result}) ]

let encode_le_u64 (value: UInt64.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_le_u64 ensures] ([@stop_split] [@expl:encode_le_u64 result type invariant] [%#sbyte_codec_wide_ops'3] inv_array_u8_8 result)
    /\ ([@stop_split] [@expl:encode_le_u64 ensures] [%#sbyte_codec_wide_ops'4] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.mod (UInt64.t'int value) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 256) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 65536) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 3)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 16777216) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 4)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 4294967296) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 5)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 1099511627776) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 6)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 281474976710656) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 7) = ComputerDivision.div (UInt64.t'int value) 72057594037927936)}
    (! return {result}) ]

let decode_le_u64 (bytes: Slice64.array UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:decode_le_u64 'bytes' type invariant] [%#sbyte_codec_wide_ops'5] inv_array_u8_8 bytes}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:decode_le_u64 ensures] [%#sbyte_codec_wide_ops'6] UInt64.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 256
              + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 65536
            + UInt8.t'int (Seq.get (Slice64.view bytes) 3) * 16777216
          + UInt8.t'int (Seq.get (Slice64.view bytes) 4) * 4294967296
        + UInt8.t'int (Seq.get (Slice64.view bytes) 5) * 1099511627776
      + UInt8.t'int (Seq.get (Slice64.view bytes) 6) * 281474976710656
    + UInt8.t'int (Seq.get (Slice64.view bytes) 7) * 72057594037927936}
    (! return {result}) ]

