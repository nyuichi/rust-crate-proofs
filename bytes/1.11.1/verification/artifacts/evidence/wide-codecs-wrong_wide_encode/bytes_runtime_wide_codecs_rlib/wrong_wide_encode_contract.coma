use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_8 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (8: UInt64.t)

predicate inv_array_u8_8 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_8 _1

meta "rewrite_def" predicate inv_array_u8_8

let encode_be_u64 (value: UInt64.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_be_u64 ensures] ([@stop_split] [@expl:encode_be_u64 result type invariant] [%#sbyte_codec_wide_ops] inv_array_u8_8 result)
    /\ ([@stop_split] [@expl:encode_be_u64 ensures] [%#sbyte_codec_wide_ops'0] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.div (UInt64.t'int value) 72057594037927936
    /\ UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 281474976710656) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 1099511627776) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 3)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 4294967296) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 4)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 16777216) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 5)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 65536) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 6)
      = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int value) 256) 256
    /\ UInt8.t'int (Seq.get (Slice64.view result) 7) = ComputerDivision.mod (UInt64.t'int value) 256)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wrong_wide_encode_contract [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/wide-codecs/src/lib.rs" 106 0 106 56]
  (value: UInt64.t) (return (x: Slice64.array UInt8.t)) = (! bb0
  [ bb0 = s0
    [ s0 = encode_be_u64 [%#slib] {value} (fun (_x: Slice64.array UInt8.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: Slice64.array UInt8.t = Any.any_l () | & value: UInt64.t = value ])
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:wrong_wide_encode_contract ensures] ([@stop_split] [@expl:wrong_wide_encode_contract result type invariant] [%#slib'0] inv_array_u8_8 result)
    /\ ([@stop_split] [@expl:wrong_wide_encode_contract ensures] [%#slib'1] UInt8.t'int (Seq.get (Slice64.view result) 0)
    = ComputerDivision.mod (UInt64.t'int value) 256)}
