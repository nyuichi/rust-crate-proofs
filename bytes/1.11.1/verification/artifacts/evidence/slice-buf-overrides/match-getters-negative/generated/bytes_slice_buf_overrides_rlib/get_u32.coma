use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_TryGetError = { requested: UInt64.t; available: UInt64.t }

type t_Result_u32_TryGetError = Ok UInt32.t | Err t_TryGetError

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let try_get_u32 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Result_u32_TryGetError)) = any
  [ return (result: t_Result_u32_TryGetError) ->
  {[@stop_split] [@expl:try_get_u32 ensures] [%#sactual_slice_overrides'3] match result with
      | Ok value -> ge_log_Int (Seq.length (Slice64.view input.current)) 4
      /\ UInt32.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 16777216
            + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 65536
          + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 3)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 4 }
      | Err error -> Seq.length (Slice64.view input.current) < 4
      /\ error.requested = (4: UInt64.t)
      /\ UInt64.t'int error.available = Seq.length (Slice64.view input.current)
      /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

let elim_Err (_x: t_Result_u32_TryGetError) (return (f0: t_TryGetError)) = any
  [ _k (f0: t_TryGetError) -> {Err f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

let elim_Ok (_x: t_Result_u32_TryGetError) (return (f0: UInt32.t)) = any
  [ _k (f0: UInt32.t) -> {Ok f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

