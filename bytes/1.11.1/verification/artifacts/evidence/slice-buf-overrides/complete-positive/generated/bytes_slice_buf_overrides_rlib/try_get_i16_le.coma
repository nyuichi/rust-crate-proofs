use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.Int16
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Option_i16 = None | Some Int16.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function signed_u16 [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/slice-buf-overrides/src/../../../../src/endian_ops.rs" 9 0 9 42] (word: int) : int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_le_i16 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_i16)) = any
  [ return (result: t_Option_i16) -> {[@stop_split] [@expl:read_le_i16 ensures] [%#sendian_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 2
      /\ Int16.to_int value
        = signed_u16 (UInt8.t'int (Seq.get (Slice64.view input.current) 0)
        + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 256)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 2 }
      | None -> Seq.length (Slice64.view input.current) < 2 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_TryGetError = { requested: UInt64.t; available: UInt64.t }

type t_Result_i16_TryGetError = Ok Int16.t | Err t_TryGetError

predicate resolve_TryGetError [@inline:trivial] (_1: t_TryGetError) = true

meta "rewrite_def" predicate resolve_TryGetError

let ok_or_i16 (self_: t_Option_i16) (err: t_TryGetError) (return (x: t_Result_i16_TryGetError)) = any
  [ return (result: t_Result_i16_TryGetError) -> {[@stop_split] [@expl:ok_or ensures] [%#soption] match self_ with
      | None -> result = Err err
      | Some t -> result = Ok t /\ resolve_TryGetError err
      end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

