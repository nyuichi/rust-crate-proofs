type t_Option_u128 = None | Some UInt128.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let read_be_u128 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Option_u128)) = any
  [ return (result: t_Option_u128) ->
  {[@stop_split] [@expl:read_be_u128 ensures] [%#sslice_wide_read_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 16
      /\ UInt128.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 1329227995784915872903807060280344576
                                    + UInt8.t'int (Seq.get (Slice64.view input.current) 1)
                                    * 5192296858534827628530496329220096
                                  + UInt8.t'int (Seq.get (Slice64.view input.current) 2)
                                  * 20282409603651670423947251286016
