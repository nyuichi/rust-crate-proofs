let ok_or_i64 (self_: t_Option_i64) (err: t_TryGetError) (return (x: t_Result_i64_TryGetError)) = any
  [ return (result: t_Result_i64_TryGetError) -> {[@stop_split] [@expl:ok_or ensures] [%#soption] match self_ with
      | None -> result = Err err
      | Some t -> result = Ok t /\ resolve_TryGetError err
