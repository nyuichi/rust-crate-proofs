      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 8
      /\ UInt64.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 72057594037927936
                    + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 281474976710656
                  + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 1099511627776
                + UInt8.t'int (Seq.get (Slice64.view input.current) 3) * 4294967296
              + UInt8.t'int (Seq.get (Slice64.view input.current) 4) * 16777216
            + UInt8.t'int (Seq.get (Slice64.view input.current) 5) * 65536
          + UInt8.t'int (Seq.get (Slice64.view input.current) 6) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 7)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 8 }
      | None -> Seq.length (Slice64.view input.current) < 8 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
