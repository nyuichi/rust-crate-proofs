        = signed_u32 (UInt8.t'int (Seq.get (Slice64.view input.current) 0)
            + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 256
          + UInt8.t'int (Seq.get (Slice64.view input.current) 2) * 65536
        + UInt8.t'int (Seq.get (Slice64.view input.current) 3) * 16777216)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 4 }
      | Err error -> Seq.length (Slice64.view input.current) < 4
      /\ error.requested = (4: UInt64.t)
      /\ UInt64.t'int error.available = Seq.length (Slice64.view input.current)
      /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

