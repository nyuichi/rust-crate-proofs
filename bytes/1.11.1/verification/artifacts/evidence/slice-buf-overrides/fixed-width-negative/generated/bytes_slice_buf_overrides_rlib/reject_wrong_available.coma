use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt16
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_TryGetError = { requested: UInt64.t; available: UInt64.t }

type t_Result_u16_TryGetError = Ok UInt16.t | Err t_TryGetError

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let try_get_u16 (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Result_u16_TryGetError)) = any
  [ return (result: t_Result_u16_TryGetError) ->
  {[@stop_split] [@expl:try_get_u16 ensures] [%#sactual_slice_overrides] match result with
      | Ok value -> ge_log_Int (Seq.length (Slice64.view input.current)) 2
      /\ UInt16.t'int value
        = UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 1)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 2 }
      | Err error -> Seq.length (Slice64.view input.current) < 2
      /\ error.requested = (2: UInt64.t)
      /\ UInt64.t'int error.available = Seq.length (Slice64.view input.current)
      /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let reject_wrong_available [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/slice-buf-overrides/src/lib.rs" 22 0 22 76]
  (input: MutBorrow.t (Slice64.slice UInt8.t)) (return (x: t_Result_u16_TryGetError)) =
{[@stop_split] [@expl:reject_wrong_available requires] [%#slib'0] Seq.length (Slice64.view input.current) = 1}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <Slice64.slice UInt8.t> {input.current} {MutBorrow.get_id input}
        (fun (_bor: MutBorrow.t (Slice64.slice UInt8.t)) ->
          [ &_5 <- _bor ] [ &input <- { input with current = _bor.final } ] s1)
    | s1 = try_get_u16 [%#slib] {_5} (fun (_x: t_Result_u16_TryGetError) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_ref_slice_u8 input}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_u16_TryGetError = Any.any_l ()
  | & input: MutBorrow.t (Slice64.slice UInt8.t) = input
  | & _5: MutBorrow.t (Slice64.slice UInt8.t) = Any.any_l () ])
  [ return (result: t_Result_u16_TryGetError) ->
  {[@stop_split] [@expl:reject_wrong_available ensures] [%#slib'1] match result with
      | Err error -> error.available = (0: UInt64.t)
      | Ok _ -> false
      end}
    (! return {result}) ]
