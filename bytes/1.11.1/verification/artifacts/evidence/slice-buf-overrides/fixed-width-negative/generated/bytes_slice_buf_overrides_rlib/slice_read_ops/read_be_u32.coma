type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

let advance_slice (input: MutBorrow.t (Slice64.slice UInt8.t)) (count: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:advance_slice requires] [%#sslice_ops] UInt64.t'int count
  <= Seq.length (Slice64.view input.current)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:advance_slice ensures] [%#sslice_ops'0] Slice64.view input.final
    = index_Seq_u8 (Slice64.view input.current) { start = UInt64.t'int count }}
    (! return {result}) ]

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_4 (self: Slice64.array UInt8.t) =
  [%#sarray] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u8_4 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_4 _1

meta "rewrite_def" predicate inv_array_u8_4

let decode_be_u32 (bytes: Slice64.array UInt8.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:decode_be_u32 'bytes' type invariant] [%#sbyte_codec_ops] inv_array_u8_4 bytes}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:decode_be_u32 ensures] [%#sbyte_codec_ops'0] UInt32.t'int result
    = UInt8.t'int (Seq.get (Slice64.view bytes) 0) * 16777216 + UInt8.t'int (Seq.get (Slice64.view bytes) 1) * 65536
      + UInt8.t'int (Seq.get (Slice64.view bytes) 2) * 256
    + UInt8.t'int (Seq.get (Slice64.view bytes) 3)}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

