      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = UInt64.t'int nbytes }
      | Err error -> Seq.length (Slice64.view input.current) < UInt64.t'int nbytes
      /\ error.requested = nbytes
      /\ UInt64.t'int error.available = Seq.length (Slice64.view input.current)
      /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
