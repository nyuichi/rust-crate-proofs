                          + UInt8.t'int (Seq.get (Slice64.view input.current) 6) * 4722366482869645213696
                        + UInt8.t'int (Seq.get (Slice64.view input.current) 7) * 18446744073709551616
                      + UInt8.t'int (Seq.get (Slice64.view input.current) 8) * 72057594037927936
                    + UInt8.t'int (Seq.get (Slice64.view input.current) 9) * 281474976710656
                  + UInt8.t'int (Seq.get (Slice64.view input.current) 10) * 1099511627776
                + UInt8.t'int (Seq.get (Slice64.view input.current) 11) * 4294967296
              + UInt8.t'int (Seq.get (Slice64.view input.current) 12) * 16777216
            + UInt8.t'int (Seq.get (Slice64.view input.current) 13) * 65536
          + UInt8.t'int (Seq.get (Slice64.view input.current) 14) * 256
        + UInt8.t'int (Seq.get (Slice64.view input.current) 15)
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 16 }
      | None -> Seq.length (Slice64.view input.current) < 16 /\ Slice64.view input.final = Slice64.view input.current
      end}
    (! return {result}) ]

predicate resolve_refmut_ref_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) =
  _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_ref_slice_u8

let elim_Some (_x: t_Option_u128) (return (f0: UInt128.t)) = any
  [ _k (f0: UInt128.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

function signed_u128 [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/slice-buf-overrides/src/../../../../src/signed_wide_ops.rs" 18 0 18 43] (word: int) : int
 = [%#ssigned_wide_ops'3] if word <= 170141183460469231731687303715884105727 then
    word
  else
    word - (2 * 170141183460469231731687303715884105727 + 2)


let signed_from_u128 (word: UInt128.t) (return (x: Int128.t)) = any
  [ return (result: Int128.t) ->
  {[@stop_split] [@expl:signed_from_u128 ensures] [%#ssigned_wide_ops'2] Int128.to_int result
    = signed_u128 (UInt128.t'int word)}
    (! return {result}) ]

