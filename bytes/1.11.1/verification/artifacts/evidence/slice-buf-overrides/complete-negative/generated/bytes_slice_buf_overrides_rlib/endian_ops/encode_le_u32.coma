let encode_be_u32 (value: UInt32.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_be_u32 ensures] ([@stop_split] [@expl:encode_be_u32 result type invariant] [%#sbyte_codec_ops] inv_array_u8_4 result)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #0] [%#sbyte_codec_ops'0] UInt8.t'int (Seq.get (Slice64.view result) 0)
      = ComputerDivision.div (UInt32.t'int value) 16777216)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #1] [%#sbyte_codec_ops'1] UInt8.t'int (Seq.get (Slice64.view result) 1)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 65536) 256)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #2] [%#sbyte_codec_ops'2] UInt8.t'int (Seq.get (Slice64.view result) 2)
      = ComputerDivision.mod (ComputerDivision.div (UInt32.t'int value) 256) 256)
    /\ ([@stop_split] [@expl:encode_be_u32 ensures #3] [%#sbyte_codec_ops'3] UInt8.t'int (Seq.get (Slice64.view result) 3)
    = ComputerDivision.mod (UInt32.t'int value) 256)}
    (! return {result}) ]

