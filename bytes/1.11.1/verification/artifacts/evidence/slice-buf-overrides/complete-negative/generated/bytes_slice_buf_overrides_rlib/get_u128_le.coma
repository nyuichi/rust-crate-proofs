                        + UInt8.t'int (Seq.get (Slice64.view input.current) 7) * 72057594037927936
                      + UInt8.t'int (Seq.get (Slice64.view input.current) 8) * 18446744073709551616
                    + UInt8.t'int (Seq.get (Slice64.view input.current) 9) * 4722366482869645213696
                  + UInt8.t'int (Seq.get (Slice64.view input.current) 10) * 1208925819614629174706176
                + UInt8.t'int (Seq.get (Slice64.view input.current) 11) * 309485009821345068724781056
              + UInt8.t'int (Seq.get (Slice64.view input.current) 12) * 79228162514264337593543950336
            + UInt8.t'int (Seq.get (Slice64.view input.current) 13) * 20282409603651670423947251286016
          + UInt8.t'int (Seq.get (Slice64.view input.current) 14) * 5192296858534827628530496329220096
        + UInt8.t'int (Seq.get (Slice64.view input.current) 15) * 1329227995784915872903807060280344576
      /\ Slice64.view input.final = index_Seq_u8 (Slice64.view input.current) { start = 16 }
      | Err error -> Seq.length (Slice64.view input.current) < 16
