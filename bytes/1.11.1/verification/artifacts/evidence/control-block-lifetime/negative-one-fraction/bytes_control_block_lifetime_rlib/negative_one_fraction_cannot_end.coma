use real.Real
use real.FromInt
use creusot.prelude.Any

type t_LifetimeToken

predicate inv_LifetimeToken (_1: t_LifetimeToken)

type t_PositiveReal

function frac (self: t_LifetimeToken) : t_PositiveReal

predicate gt_log_Real [@inline:trivial] (self: Real.real) (other: Real.real) = [%#sord] Real.(<) other self

meta "rewrite_def" predicate gt_log_Real

function to_real (self: t_PositiveReal) : Real.real

axiom to_real_spec:
  forall self: t_PositiveReal [to_real self]. [%#sreal'4] gt_log_Real (to_real self) (FromInt.from_int 0)

function new (n: Real.real) : t_PositiveReal

axiom new_spec: forall n: Real.real [new n]. ([%#sreal'2] gt_log_Real n (FromInt.from_int 0))
    -> ([%#sreal'3] to_real (new n) = n)

function from_int [@inline:trivial] (i: int) : t_PositiveReal = [%#sreal] new (FromInt.from_int i)

meta "rewrite_def" function from_int

let new'0 (return (x: t_LifetimeToken)) = any
  [ return (result: t_LifetimeToken) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] [%#slifetime_logic] inv_LifetimeToken result)
    /\ ([@stop_split] [@expl:new ensures] [%#slifetime_logic'0] frac result = from_int 1)}
    (! return {result}) ]

type tup2_LifetimeToken_LifetimeToken = { f0: t_LifetimeToken; f1: t_LifetimeToken }

predicate inv_tup2_LifetimeToken_LifetimeToken [@inline:trivial] (_1: tup2_LifetimeToken_LifetimeToken) =
  inv_LifetimeToken _1.f0 /\ inv_LifetimeToken _1.f1

meta "rewrite_def" predicate inv_tup2_LifetimeToken_LifetimeToken

type t_Lifetime

function lft (self: t_LifetimeToken) : t_Lifetime

function add_PositiveReal (self: t_PositiveReal) (other: t_PositiveReal) : t_PositiveReal

axiom add_PositiveReal_spec:
  forall self: t_PositiveReal, other: t_PositiveReal [add_PositiveReal self other]. [%#sreal'0] to_real (add_PositiveReal self other)
    = Real.(+) (to_real self) (to_real other)

function div_PositiveReal (self: t_PositiveReal) (other: t_PositiveReal) : t_PositiveReal

axiom div_PositiveReal_spec:
  forall self: t_PositiveReal, other: t_PositiveReal [div_PositiveReal self other]. [%#sreal'1] to_real (div_PositiveReal self other)
    = Real.(/) (to_real self) (to_real other)

let split (self: t_LifetimeToken) (return (x: tup2_LifetimeToken_LifetimeToken)) =
{[@stop_split] [@expl:split 'self' type invariant] [%#slifetime_logic'1] inv_LifetimeToken self}
  any
  [ return (result: tup2_LifetimeToken_LifetimeToken) ->
  {[@stop_split] [@expl:split ensures] ([@stop_split] [@expl:split result type invariant] [%#slifetime_logic'2] inv_tup2_LifetimeToken_LifetimeToken result)
    /\ ([@stop_split] [@expl:split ensures #0] [%#slifetime_logic'3] lft result.f0 = lft self
      /\ lft result.f1 = lft self)
    /\ ([@stop_split] [@expl:split ensures #1] [%#slifetime_logic'4] add_PositiveReal (frac result.f0) (frac result.f1)
      = frac self)
    /\ ([@stop_split] [@expl:split ensures #2] [%#slifetime_logic'5] frac result.f0
      = div_PositiveReal (frac self) (from_int 2)
    /\ frac result.f1 = div_PositiveReal (frac self) (from_int 2))}
    (! return {result}) ]

predicate resolve_LifetimeToken (_1: t_LifetimeToken)

type t_LifetimeDead

predicate inv_LifetimeDead (_1: t_LifetimeDead)

function lft'0 (self: t_LifetimeDead) : t_Lifetime

let end' (self: t_LifetimeToken) (return (x: t_LifetimeDead)) =
{[@stop_split] [@expl:end requires] ([@stop_split] [@expl:end 'self' type invariant] [%#slifetime_logic'6] inv_LifetimeToken self)
  /\ ([@stop_split] [@expl:end requires] [%#slifetime_logic'7] frac self = from_int 1)}
  any
  [ return (result: t_LifetimeDead) ->
  {[@stop_split] [@expl:end ensures] ([@stop_split] [@expl:end result type invariant] [%#slifetime_logic'8] inv_LifetimeDead result)
    /\ ([@stop_split] [@expl:end ensures] [%#slifetime_logic'9] lft'0 result = lft self)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let negative_one_fraction_cannot_end [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/control-block-lifetime/src/lib.rs" 111 0 111 41]
  (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = new'0 [%#slib] (fun (_x: t_LifetimeToken) -> [ &lifetime <- _x ] s1)
    | s1 = split [%#slib'0] {lifetime} (fun (_x: tup2_LifetimeToken_LifetimeToken) -> [ &_4 <- _x ] s2)
    | s2 = [ &one_half <- _4.f0 ] s3
    | s3 = [ &_other_half <- _4.f1 ] s4
    | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_LifetimeToken _other_half} any) ]
    | s5 = -{resolve_LifetimeToken _other_half}- s6
    | s6 = end' [%#slib'1] {one_half} (fun (_x: t_LifetimeDead) -> [ &_dead <- _x ] s7)
    | s7 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & lifetime: t_LifetimeToken = Any.any_l ()
  | & one_half: t_LifetimeToken = Any.any_l ()
  | & _other_half: t_LifetimeToken = Any.any_l ()
  | & _4: tup2_LifetimeToken_LifetimeToken = Any.any_l ()
  | & _dead: t_LifetimeDead = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
