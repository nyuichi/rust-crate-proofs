use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type tup2_usize_usize = { f0: UInt64.t; f1: UInt64.t }

let split_count (a_remaining: UInt64.t) (count: UInt64.t) (return (x: tup2_usize_usize)) = any
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:split_count ensures] ([@stop_split] [@expl:split_count ensures #0] [%#schain_ops] UInt64.t'int result.f0
      = (if UInt64.t'int a_remaining <= UInt64.t'int count then UInt64.t'int a_remaining else UInt64.t'int count))
    /\ ([@stop_split] [@expl:split_count ensures #1] [%#schain_ops'0] UInt64.t'int result.f1
      = (if UInt64.t'int a_remaining < UInt64.t'int count then UInt64.t'int count - UInt64.t'int a_remaining else 0))
    /\ ([@stop_split] [@expl:split_count ensures #2] [%#schain_ops'1] UInt64.t'int result.f0 + UInt64.t'int result.f1
    = UInt64.t'int count)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let split_exact [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/chain-ops/src/lib.rs" 16 0 16 70]
  (a_remaining: UInt64.t) (count: UInt64.t) (return (x: tup2_usize_usize)) = (! bb0
  [ bb0 = s0
    [ s0 = split_count [%#slib] {a_remaining} {count} (fun (_x: tup2_usize_usize) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: tup2_usize_usize = Any.any_l () | & a_remaining: UInt64.t = a_remaining | & count: UInt64.t = count ])
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:split_exact ensures] ([@stop_split] [@expl:split_exact ensures #0] [%#slib'0] UInt64.t'int result.f0
      = (if UInt64.t'int a_remaining <= UInt64.t'int count then UInt64.t'int a_remaining else UInt64.t'int count))
    /\ ([@stop_split] [@expl:split_exact ensures #1] [%#slib'1] UInt64.t'int result.f1
      = (if UInt64.t'int a_remaining < UInt64.t'int count then UInt64.t'int count - UInt64.t'int a_remaining else 0))
    /\ ([@stop_split] [@expl:split_exact ensures #2] [%#slib'2] UInt64.t'int result.f0 + UInt64.t'int result.f1
    = UInt64.t'int count)}
    (! return {result}) ]
