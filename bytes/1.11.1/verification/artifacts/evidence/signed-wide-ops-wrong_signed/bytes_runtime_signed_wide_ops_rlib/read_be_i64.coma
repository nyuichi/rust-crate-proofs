  [ return (result: t_Option_i64) -> {[@stop_split] [@expl:read_be_i64 ensures] [%#ssigned_wide_ops] match result with
      | Some value -> ge_log_Int (Seq.length (Slice64.view input.current)) 8
      /\ Int64.to_int value
        = signed_u64 (UInt8.t'int (Seq.get (Slice64.view input.current) 0) * 72057594037927936
                    + UInt8.t'int (Seq.get (Slice64.view input.current) 1) * 281474976710656
