  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #5] [%#slib'8] capacity'1 capabilities.f1 = capacity raw)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #6] [%#slib'9] namespace capabilities.f0 <> namespace'0 raw)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #7] [%#slib'10] namespace'1 capabilities.f1
    = namespace capabilities.f0)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #8] [%#slib'11] resource_id capabilities.f1
    = namespace capabilities.f0)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #9] [%#slib'12] lo capabilities.f1 = 0)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #10] [%#slib'13] hi capabilities.f1 = capacity raw)
  /\ ([@stop_split] [@expl:wrong_namespace_resume requires #11] [%#slib'14] forall index: int. 0 <= index /\ index < 1
    -> (exists value: UInt8.t. slot capabilities.f1 index = Some'2 (Some'0 value)))}
  (! bb0
  [ bb0 = s0
    [ s0 = resume_vec [%#slib'0] {raw} {[%#slib] (1: UInt64.t)} {capabilities}
        (fun (_x: t_Vec_u8_Global) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_Vec_u8_Global = Any.any_l ()
  | & raw: t_RawAllocation = raw
  | & capabilities: tup2_Recovery_PhysicalRegion = capabilities ])
  [ return (result: t_Vec_u8_Global) -> (! return {result}) ]
