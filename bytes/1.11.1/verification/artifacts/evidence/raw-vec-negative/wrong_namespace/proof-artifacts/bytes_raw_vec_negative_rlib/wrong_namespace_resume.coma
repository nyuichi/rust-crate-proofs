let resume_vec (raw: t_RawAllocation) (len: UInt64.t) (capabilities: tup2_Recovery_PhysicalRegion)
  (return (x: t_Vec_u8_Global)) =
{[@stop_split] [@expl:resume_vec requires] ([@stop_split] [@expl:resume_vec 'raw' type invariant] [%#sraw_vec] inv_RawAllocation raw)
  /\ ([@stop_split] [@expl:resume_vec 'capabilities' type invariant] [%#sraw_vec'0] inv_Ghost_tup2_Recovery_PhysicalRegion capabilities)
  /\ ([@stop_split] [@expl:resume_vec requires #0] [%#sraw_vec'1] invariant_RawAllocation raw)
  /\ ([@stop_split] [@expl:resume_vec requires #1] [%#sraw_vec'2] UInt64.t'int len <= capacity raw)
  /\ ([@stop_split] [@expl:resume_vec requires #2] [%#sraw_vec'3] invariant' capabilities.f0)
  /\ ([@stop_split] [@expl:resume_vec requires #3] [%#sraw_vec'4] invariant_PhysicalRegion capabilities.f1)
  /\ ([@stop_split] [@expl:resume_vec requires #4] [%#sraw_vec'5] capacity'0 capabilities.f0 = capacity raw)
  /\ ([@stop_split] [@expl:resume_vec requires #5] [%#sraw_vec'6] capacity'1 capabilities.f1 = capacity raw)
  /\ ([@stop_split] [@expl:resume_vec requires #6] [%#sraw_vec'7] namespace capabilities.f0 = namespace'0 raw)
  /\ ([@stop_split] [@expl:resume_vec requires #7] [%#sraw_vec'8] namespace'1 capabilities.f1 = namespace'0 raw)
  /\ ([@stop_split] [@expl:resume_vec requires #8] [%#sraw_vec'9] resource_id capabilities.f1
    = namespace capabilities.f0)
  /\ ([@stop_split] [@expl:resume_vec requires #9] [%#sraw_vec'10] lo capabilities.f1 = 0)
  /\ ([@stop_split] [@expl:resume_vec requires #10] [%#sraw_vec'11] hi capabilities.f1 = capacity raw)
  /\ ([@stop_split] [@expl:resume_vec requires #11] [%#sraw_vec'12] forall index: int. 0 <= index
      /\ index < UInt64.t'int len -> (exists value: UInt8.t. slot capabilities.f1 index = Some'2 (Some'0 value)))}
  any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:resume_vec ensures] ([@stop_split] [@expl:resume_vec ensures #0] [%#sraw_vec'13] Seq.length (view_Vec_u8_Global result)
      = UInt64.t'int len)
    /\ ([@stop_split] [@expl:resume_vec ensures #1] [%#sraw_vec'14] forall index: int. 0 <= index
        /\ index < UInt64.t'int len
      -> slot capabilities.f1 index = Some'2 (Some'0 (Seq.get (view_Vec_u8_Global result) index)))}
    (! return {result}) ]

