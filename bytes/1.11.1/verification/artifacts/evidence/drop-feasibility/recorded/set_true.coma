(* #"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/drop-feasibility/src/lib.rs" 8 0 8 28 *)

let%span slib = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/drop-feasibility/src/lib.rs" 9 12 9 16
let%span slib'0 = "/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/drop-feasibility/src/lib.rs" 7 10 7 23

use creusot.prelude.MutBorrow
use creusot.prelude.Any

predicate resolve_refmut_bool [@inline:trivial] (_1: MutBorrow.t bool) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let set_true [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/drop-feasibility/src/lib.rs" 8 0 8 28]
  (flag: MutBorrow.t bool) (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = [ &flag <- { flag with current = ([%#slib] true) } ] s1
    | s1 = -{resolve_refmut_bool flag}- s2
    | s2 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & flag: MutBorrow.t bool = flag ])
  [ return (result: ()) -> {[@stop_split] [@expl:set_true ensures] [%#slib'0] flag.final = true} (! return {result}) ]
