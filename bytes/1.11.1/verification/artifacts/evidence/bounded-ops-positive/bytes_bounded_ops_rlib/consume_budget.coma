let decrease_limit (limit: MutBorrow.t UInt64.t) (count: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:decrease_limit requires] [%#sbounded_ops] UInt64.t'int count <= UInt64.t'int limit.current}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:decrease_limit ensures] [%#sbounded_ops'0] UInt64.t'int limit.final
    = UInt64.t'int limit.current - UInt64.t'int count}
    (! return {result}) ]

