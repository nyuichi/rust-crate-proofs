use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

function deep_model_usize [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

meta "rewrite_def" function deep_model_usize

let min_usize (v1: UInt64.t) (v2: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:min_usize ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_usize result
      <= deep_model_usize v1)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_usize result <= deep_model_usize v2)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = v1 \/ result = v2)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_usize v1 < deep_model_usize v2 -> result = v1)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_usize v2 <= deep_model_usize v1 -> result = v2)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let bounded_len [#"/workspace/bytes-runtime-verification/bytes/1.11.1/verification/probes/bounded-ops/src/../../../../src/bounded_ops.rs" 7 0 7 66]
  (available: UInt64.t) (limit: UInt64.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = min_usize [%#sbounded_ops] {available} {limit} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & available: UInt64.t = available | & limit: UInt64.t = limit ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:bounded_len ensures] [%#sbounded_ops'0] UInt64.t'int result
    = (if UInt64.t'int available < UInt64.t'int limit then UInt64.t'int available else UInt64.t'int limit)}
    (! return {result}) ]
