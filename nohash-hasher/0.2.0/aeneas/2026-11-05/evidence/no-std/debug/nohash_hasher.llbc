See [`IsEnabled`] for use with custom types."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use nohash_hasher::NoHashHasher;"},{"DocComment":" use std::{collections::HashMap, hash::BuildHasherDefault};"},{"DocComment":""},{"DocComment":" let mut m: HashMap::<u8, char, BuildHasherDefault<NoHashHasher<u8>>> ="},{"DocComment":"     HashMap::with_capacity_and_hasher(2, BuildHasherDefault::default());"},{"DocComment":""},{"DocComment":" m.insert(0, 'a');"},{"DocComment":" m.insert(1, 'b');"},{"DocComment":""},{"DocComment":" assert_eq!(Some(&'a'), m.get(&0));"},{"DocComment":" assert_eq!(Some(&'b'), m.get(&1));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":107,"col":27},"end":{"line":107,"col":30}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_0","is_positional":true,"ty":{"Value":[4,{"Scalar":{"Integer":{"Unsigned":"U64"}}}]}},{"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":107,"col":32},"end":{"line":107,"col":36}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_1","is_positional":true,"ty":{"Value":[5,{"Scalar":"Bool"}]}},{"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":107,"col":38},"end":{"line":107,"col":52}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_2","is_positional":true,"ty":{"Value":[6,{"Adt":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}}]},"l