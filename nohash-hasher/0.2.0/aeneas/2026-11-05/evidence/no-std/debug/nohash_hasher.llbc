{"charon_version":"0.1.291","translated":{"crate_name":"nohash_hasher","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_u8","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_u16","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_u32","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_u64","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_usize","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_i8","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_i16","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_i32","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_i64","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::write_isize","{impl core::hash::Hasher for nohash_hasher::NoHashHasher<_>}::finish","{impl core::default::Default for nohash_hasher::NoHashHasher<_>}::default","{impl core::clone::Clone for nohash_hasher::NoHashHasher<_>}::clone"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/full-api/endian/nohash-publication-candidate/nohash-hasher/0.2.0/aeneas/2026-11-05/evidence/no-std/debug/nohash_hasher.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"nohash_hasher","contents":"// Copyright 2018-2020 Parity Technologies (UK) Ltd.\n//\n// Licensed under the Apache License, Version 2.0 or MIT license, at your option.\n//\n// A copy of the Apache License, Version 2.0 is included in the software as\n// LICENSE-APACHE and a copy of the MIT license is included in the software\n// as LICENSE-MIT. You may also obtain a copy of the Apache License, Version 2.0\n// at https://www.apache.org/licenses/LICENSE-2.0 and a copy of the MIT license\n// at https://opensource.org/licenses/MIT.\n\n#![cfg_attr(not(feature = \"std\"), no_std)]\n\nuse core::{fmt, hash::{BuildHasherDefault, Hasher}, marker::PhantomData};\n\n/// A `HashMap` with an integer domain, using `NoHashHasher` to perform no hashing at all.\n///\n/// # Examples\n///\n/// See [`IsEnabled`] for use with custom types.\n///\n/// ```\n/// use nohash_hasher::IntMap;\n///\n/// let mut m: IntMap<u32, bool> = IntMap::default();\n///\n/// m.insert(0, false);\n/// m.insert(1, true);\n///\n/// assert!(m.contains_key(&0));\n/// assert!(m.contains_key(&1));\n/// ```\n#[cfg(feature = \"std\")]\npub type IntMap<K, V> = std::collections::HashMap<K, V, BuildNoHashHasher<K>>;\n\n/// A `HashSet` of integers, using `NoHashHasher` to perform no hashing at all.\n///\n/// # Examples\n///\n/// See [`IsEnabled`] for use with custom types.\n///\n/// ```\n/// use nohash_hasher::IntSet;\n///\n/// let mut m = IntSet::default();\n///\n/// m.insert(0u32);\n/// m.insert(1u32);\n///\n/// assert!(m.contains(&0));\n/// assert!(m.contains(&1));\n/// ```\n#[cfg(feature = \"std\")]\npub type IntSet<T> = std::collections::HashSet<T, BuildNoHashHasher<T>>;\n\n/// An alias for `BuildHasherDefault` for use with `NoHashHasher`.\n///\n/// # Examples\n///\n/// See also [`IntMap`] and [`IntSet`] for some easier usage examples.\n///\n/// ```\n/// use nohash_hasher::BuildNoHashHasher;\n/// use std::collections::HashMap;\n///\n/// let mut m: HashMap::<u8, char, BuildNoHashHasher<u8>> =\n///     HashMap::with_capacity_and_hasher(2, BuildNoHashHasher::default());\n///\n/// m.insert(0, 'a');\n/// m.insert(1, 'b');\n///\n/// assert_eq!(Some(&'a'), m.get(&0));\n/// assert_eq!(Some(&'b'), m.get(&1));\n/// ```\npub type BuildNoHashHasher<T> = BuildHasherDefault<NoHashHasher<T>>;\n\n/// For an enabled type `T`, a `NoHashHasher<T>` implements `std::hash::Hasher` and\n/// uses the value set by one of the `write_{u8, u16, u32, u64, usize, i8, i16, i32,\n/// i64, isize}` methods as its hash output.\n///\n/// `NoHashHasher` does not implement any hashing algorithm and can only be used\n/// with types which can be mapped directly to a numeric value. Out of the box\n/// `NoHashHasher` is enabled for `u8`, `u16`, `u32`, `u64`, `usize`, `i8`, `i16`,\n/// `i32`, `i64`, and `isize`. Types that should be used with `NoHashHasher` need\n/// to implement [`IsEnabled`] and by doing so assert that their `Hash` impl invokes\n/// *only one* of the `Hasher::write_{u8, u16, u32, u64, usize, i8, i16, i32, i64,\n/// isize}` methods *exactly once*.\n///\n/// # Examples\n///\n/// See also [`BuildNoHashHasher`], [`IntMap`] and [`IntSet`] for some easier\n/// usage examples. See [`IsEnabled`] for use with custom types.\n///\n/// ```\n/// use nohash_hasher::NoHashHasher;\n/// use std::{collections::HashMap, hash::BuildHasherDefault};\n///\n/// let mut m: HashMap::<u8, char, BuildHasherDefault<NoHashHasher<u8>>> =\n///     HashMap::with_capacity_and_hasher(2, BuildHasherDefault::default());\n///\n/// m.insert(0, 'a');\n/// m.insert(1, 'b');\n///\n/// assert_eq!(Some(&'a'), m.get(&0));\n/// assert_eq!(Some(&'b'), m.get(&1));\n/// ```\n#[cfg(debug_assertions)]\npub struct NoHashHasher<T>(u64, bool, PhantomData<T>);\n\n#[cfg(not(debug_assertions))]\npub struct NoHashHasher<T>(u64, PhantomData<T>);\n\nimpl<T> fmt::Debug for NoHashHasher<T> {\n    #[cfg(debug_assertions)]\n    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n        f.debug_tuple(\"NoHashHasher\").field(&self.0).field(&self.1).finish()\n    }\n\n    #[cfg(not(debug_assertions))]\n    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n        f.debug_tuple(\"NoHashHasher\").field(&self.0).finish()\n    }\n}\n\nimpl<T> Default for NoHashHasher<T> {\n    #[cfg(debug_assertions)]\n    fn default() -> Self {\n        NoHashHasher(0, false, PhantomData)\n    }\n\n    #[cfg(not(debug_assertions))]\n    fn default() -> Self {\n        NoHashHasher(0, PhantomData)\n    }\n}\n\nimpl<T> Clone for NoHashHasher<T> {\n    #[cfg(debug_assertions)]\n    fn clone(&self) -> Self {\n        NoHashHasher(self.0, self.1, self.2)\n    }\n\n    #[cfg(not(debug_assertions))]\n    fn clone(&self) -> Self {\n        NoHashHasher(self.0, self.1)\n    }\n}\n\nimpl<T> Copy for NoHashHasher<T> {}\n\n/// Types which are safe to use with `NoHashHasher`.\n///\n/// This marker trait is an option for types to enable themselves for use\n/// with `NoHashHasher`. In order to be safe, the `Hash` impl needs to\n/// satisfy the following constraint:\n///\n/// > **One of the `Hasher::write_{u8,u16,u32,u64,usize,i8,i16,i32,i64,isize}`\n/// methods is invoked exactly once.**\n///\n/// The best way to ensure this is to write a custom `Hash` impl even when\n/// deriving `Hash` for a simple newtype of a single type which itself\n/// implements `IsEnabled` may work as well.\n///\n/// # Example\n///\n/// ```\n/// #[derive(PartialEq, Eq)]\n/// struct SomeType(u32);\n///\n/// impl std::hash::Hash for SomeType {\n///     fn hash<H: std::hash::Hasher>(&self, hasher: &mut H) {\n///         hasher.write_u32(self.0)\n///     }\n/// }\n///\n/// impl nohash_hasher::IsEnabled for SomeType {}\n///\n/// let mut m = nohash_hasher::IntMap::default();\n///\n/// m.insert(SomeType(1), 't');\n/// m.insert(SomeType(0), 'f');\n///\n/// assert_eq!(Some(&'t'), m.get(&SomeType(1)));\n/// assert_eq!(Some(&'f'), m.get(&SomeType(0)));\n/// ```\npub trait IsEnabled {}\n\nimpl IsEnabled for u8 {}\nimpl IsEnabled for u16 {}\nimpl IsEnabled for u32 {}\nimpl IsEnabled for u64 {}\nimpl IsEnabled for usize {}\nimpl IsEnabled for i8 {}\nimpl IsEnabled for i16 {}\nimpl IsEnabled for i32 {}\nimpl IsEnabled for i64 {}\nimpl IsEnabled for isize {}\n\n#[cfg(not(debug_assertions))]\nimpl<T: IsEnabled> Hasher for NoHashHasher<T> {\n    fn write(&mut self, _: &[u8]) {\n        panic!(\"Invalid use of NoHashHasher\")\n    }\n\n    fn write_u8(&mut self, n: u8)       { self.0 = u64::from(n) }\n    fn write_u16(&mut self, n: u16)     { self.0 = u64::from(n) }\n    fn write_u32(&mut self, n: u32)     { self.0 = u64::from(n) }\n    fn write_u64(&mut self, n: u64)     { self.0 = n }\n    fn write_usize(&mut self, n: usize) { self.0 = n as u64 }\n\n    fn write_i8(&mut self, n: i8)       { self.0 = n as u64 }\n    fn write_i16(&mut self, n: i16)     { self.0 = n as u64 }\n    fn write_i32(&mut self, n: i32)     { self.0 = n as u64 }\n    fn write_i64(&mut self, n: i64)     { self.0 = n as u64 }\n    fn write_isize(&mut self, n: isize) { self.0 = n as u64 }\n\n    fn finish(&self) -> u64 { self.0 }\n}\n\n#[cfg(debug_assertions)]\nimpl<T: IsEnabled> Hasher for NoHashHasher<T> {\n    fn write(&mut self, _: &[u8]) {\n        panic!(\"Invalid use of NoHashHasher\")\n    }\n\n    fn write_u8(&mut self, n: u8) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = u64::from(n);\n        self.1 = true\n    }\n\n    fn write_u16(&mut self, n: u16) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = u64::from(n);\n        self.1 = true\n    }\n\n    fn write_u32(&mut self, n: u32) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = u64::from(n);\n        self.1 = true\n    }\n\n    fn write_u64(&mut self, n: u64) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n;\n        self.1 = true\n    }\n\n    fn write_usize(&mut self, n: usize) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn write_i8(&mut self, n: i8) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn write_i16(&mut self, n: i16) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn write_i32(&mut self, n: i32) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn write_i64(&mut self, n: i64) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn write_isize(&mut self, n: isize) {\n        assert!(!self.1, \"NoHashHasher: second write attempt detected.\");\n        self.0 = n as u64;\n        self.1 = true\n    }\n\n    fn finish(&self) -> u64 {\n        self.0\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn ok() {\n        let mut h1 = NoHashHasher::<u8>::default();\n        h1.write_u8(42);\n        assert_eq!(42, h1.finish());\n\n        let mut h2 = NoHashHasher::<u16>::default();\n        h2.write_u16(42);\n        assert_eq!(42, h2.finish());\n\n        let mut h3 = NoHashHasher::<u32>::default();\n        h3.write_u32(42);\n        assert_eq!(42, h3.finish());\n\n        let mut h4 = NoHashHasher::<u64>::default();\n        h4.write_u64(42);\n        assert_eq!(42, h4.finish());\n\n        let mut h5 = NoHashHasher::<usize>::default();\n        h5.write_usize(42);\n        assert_eq!(42, h5.finish());\n\n        let mut h6 = NoHashHasher::<i8>::default();\n        h6.write_i8(42);\n        assert_eq!(42, h6.finish());\n\n        let mut h7 = NoHashHasher::<i16>::default();\n        h7.write_i16(42);\n        assert_eq!(42, h7.finish());\n\n        let mut h8 = NoHashHasher::<i32>::default();\n        h8.write_i32(42);\n        assert_eq!(42, h8.finish());\n\n        let mut h9 = NoHashHasher::<i64>::default();\n        h9.write_i64(42);\n        assert_eq!(42, h9.finish());\n\n        let mut h10 = NoHashHasher::<isize>::default();\n        h10.write_isize(42);\n        assert_eq!(42, h10.finish())\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn u8_double_usage() {\n        let mut h = NoHashHasher::<u8>::default();\n        h.write_u8(42);\n        h.write_u8(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn u16_double_usage() {\n        let mut h = NoHashHasher::<u16>::default();\n        h.write_u16(42);\n        h.write_u16(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn u32_double_usage() {\n        let mut h = NoHashHasher::<u32>::default();\n        h.write_u32(42);\n        h.write_u32(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn u64_double_usage() {\n        let mut h = NoHashHasher::<u64>::default();\n        h.write_u64(42);\n        h.write_u64(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn usize_double_usage() {\n        let mut h = NoHashHasher::<usize>::default();\n        h.write_usize(42);\n        h.write_usize(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn i8_double_usage() {\n        let mut h = NoHashHasher::<i8>::default();\n        h.write_i8(42);\n        h.write_i8(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn i16_double_usage() {\n        let mut h = NoHashHasher::<i16>::default();\n        h.write_i16(42);\n        h.write_i16(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn i32_double_usage() {\n        let mut h = NoHashHasher::<i32>::default();\n        h.write_i32(42);\n        h.write_i32(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn i64_double_usage() {\n        let mut h = NoHashHasher::<i64>::default();\n        h.write_i64(42);\n        h.write_i64(43);\n    }\n\n    #[cfg(debug_assertions)]\n    #[test]\n    #[should_panic]\n    fn isize_double_usage() {\n        let mut h = NoHashHasher::<isize>::default();\n        h.write_isize(42);\n        h.write_isize(43);\n    }\n}\n\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/hash/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]