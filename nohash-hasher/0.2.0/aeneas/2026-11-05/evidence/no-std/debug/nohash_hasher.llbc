ted":0}]]}}]},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Value":[0,"True"]},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,null,null,{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":86,"col":0},"end":{"line":86,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A (half-open) range bounded inclusively below and exclusively above"},{"DocComment":" (`start..end`)."},{"DocComment":""},{"DocComment":" The range `start..end` contains all values with `start <= x < end`."},{"DocComment":" It is empty if `start >= end`."},{"DocComment":""},{"DocComment":" Note that this type is not suited to represent all possible ranges. For example, `Range<u8>`"},{"DocComment":" cannot represent the range that covers all of `u8`. Use [`(Bound<T>, Bound<T>)`][Bound] if you"},{"DocComment":" need a type that can store an arbitrary range."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..end` syntax is a `Range`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..5), std::ops::Range { start: 3, end: 5 });"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..6).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]); // This is a `Range`"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Range","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":89,"col":4},"end":{"line":89,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Value":[3,{"TypeVar":{"Free":0}}]}},{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":92,"col":4},"end":{"line":92,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":3}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[2,{"AtLeast":{"Value":[3,{"AlignTo":{"base":{"Value":[4,{"Max":[{"Value":[5,{"Plus":[{"Value":[6,{"Constant":{"Value":[3,[{"OffsetOf":[{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Value":[7,{"Constant":{"Value":[4,[{"SizeOf":{"Deduplicated":3}},{"Deduplicated":0}]]}}]}]}]},{"Value":[8,{"Plus":[{"Value":[9,{"Constant":{"Value":[5,[{"OffsetOf":[{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]},"builtin":null},null,1]},{"Deduplicated":0}]]}}]},{"Deduplicated":7}]}]}]}]},"target_align":{"Value":[10,{"Max":[{"Value":[11,{"Constant":{"Value":[6,[{"AlignOf":{"Deduplicated":3}},{"Deduplicated":0}]]}}]},{"Deduplicated