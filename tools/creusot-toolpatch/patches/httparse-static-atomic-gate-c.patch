+fn check_profile_invocation(profile: StaticAtomicProfile, args: &[String]) -> Result<(), String> {
+    if profile != StaticAtomicProfile::X86RuntimeCapsV1 {
+        return Ok(());
+    }
+    for (index, arg) in args.iter().enumerate() {
+        let cfg = if arg == "--cfg" {
+            args.get(index + 1).map(String::as_str)
+        } else {
+            arg.strip_prefix("--cfg=")
+        };
+        let Some(cfg) = cfg else { continue };
+        let key = cfg.split('=').next().unwrap_or(cfg);
+        if key == "target_feature" || key.starts_with("httparse_simd_target_feature") {
+            return Err(format!("Gate C profile rejects manually supplied --cfg `{key}`"));
+        }
+    }
+    Ok(())
+}
+
+fn check_profile_target(profile: StaticAtomicProfile, tcx: TyCtxt<'_>) -> Result<(), String> {
+    if profile != StaticAtomicProfile::X86RuntimeCapsV1 {
+        return Ok(());
+    }
+    let target = tcx.sess.opts.target_triple.to_string();
+    if target != "x86_64-unknown-linux-gnu" {
+        return Err(format!(
+            "Gate C profile x86-runtime-caps-v1 requires x86_64-unknown-linux-gnu, found `{target}`"
+        ));
+    }
+    if tcx.sess.opts.cg.target_cpu.is_some() || !tcx.sess.opts.cg.target_feature.is_empty() {
+        return Err(
+            "Gate C profile rejects explicit -C target-cpu and -C target-feature overrides".into(),
+        );
+    }
+    // Check rustc's effective session state as well as the raw command line.
+    // `ParseSess::config` combines user cfg flags with the codegen backend's
+    // target-feature cfgs, while `Session::target_features` contains the
+    // backend's resolved enabled target features. The argv check above remains
+    // necessary because the user-provided cfg set is not kept separately here.
+    let avx2 = Symbol::intern("avx2");
+    let sse42 = Symbol::intern("sse4.2");
+    let cfg_target_features = tcx
+        .sess
+        .psess
+        .config
+        .iter()
+        .filter_map(|(name, value)| (*name == Symbol::intern("target_feature")).then_some(*value))
+        .collect::<Vec<_>>();
+    if cfg_target_features.iter().any(Option::is_none) {
+        return Err("Gate C profile rejects malformed effective target_feature cfg".into());
+    }
+    let cfg_has = |feature| cfg_target_features.contains(&Some(feature));
+    let session_has = |feature| tcx.sess.target_features.contains(&feature);
+    if session_has(avx2) || session_has(sse42) {
+        return Err(
+            "Gate C profile requires AVX2 and SSE4.2 absent from effective session target features"
+                .into(),
+        );
+    }
+    if cfg_has(avx2) || cfg_has(sse42) {
+        return Err(
+            "Gate C profile requires AVX2 and SSE4.2 absent from effective session cfg".into()
+        );
+    }
+    for feature in tcx.sess.target.options.features.split(',') {
+        if feature == "+avx2" || feature == "+sse4.2" {
+            return Err(format!(
+                "Gate C profile does not admit baseline target feature `{feature}`"
+            ));
+        }
+    }
+    Ok(())
+}
