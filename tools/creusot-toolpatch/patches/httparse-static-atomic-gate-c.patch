+/// Build one checked invariant application. Gate C's capability arguments are
+/// fixed compiler-owned qualified constants, never terms supplied by a Rust
+/// caller or names accepted from the registration manifest.
+pub(crate) fn invariant_application<'tcx>(
+    ctx: &Why3Generator<'tcx>,
+    names: &impl Namer<'tcx>,
+    spec: StaticAtomicSpec,
+    value: Exp,
+) -> Exp {
+    let predicate =
+        names.item(spec.predicate_id, GenericArgs::identity_for_item(ctx.tcx, spec.predicate_id));
+    match spec.profile {
+        StaticAtomicProfile::ByteInvariant => Exp::Var(predicate).app([value]),
+        StaticAtomicProfile::X86RuntimeCapsV1 => {
+            let caps = PreMod::StaticAtomicCaps;
+            let avx2 = Exp::qvar(names.in_pre(caps, "avx2_usable"));
+            let sse42 = Exp::qvar(names.in_pre(caps, "sse42_usable"));
+            Exp::Var(predicate).app([value, avx2, sse42])
+        }
+    }
+}
 
