+/// Gate B permits only a syntactically total invariant language. Calls are
+/// rejected except the primitive `View(u8) -> Int` model; this keeps a fresh
+/// load assumption from invoking an unproved or partial user function.
+fn static_atomic_predicate_is_total<'tcx>(
+    ctx: &TranslationCtx<'tcx>,
+    term: &Term<'tcx>,
+    bound: &[pearlite::PIdent],
+) -> bool {
+    use pearlite::{BinOp, Literal, TermKind, UnOp};
+
+    match &term.kind {
+        TermKind::Var(variable) => bound.contains(variable),
+        TermKind::Lit(
+            Literal::Bool(_)
+            | Literal::Integer(_)
+            | Literal::UInteger(_)
+            | Literal::MachSigned(..)
+            | Literal::MachUnsigned(..),
+        ) => true,
+        TermKind::Spanned(inner) => static_atomic_predicate_is_total(ctx, inner, bound),
+        TermKind::Binary { op, lhs, rhs }
+            if matches!(
+                op,
+                BinOp::Eq
+                    | BinOp::Ne
+                    | BinOp::Lt
+                    | BinOp::Le
+                    | BinOp::Gt
+                    | BinOp::Ge
+                    | BinOp::And
+                    | BinOp::Or
+            ) =>
+        {
+            static_atomic_predicate_is_total(ctx, lhs, bound)
+                && static_atomic_predicate_is_total(ctx, rhs, bound)
+        }
+        TermKind::Unary { op: UnOp::Not, arg } => static_atomic_predicate_is_total(ctx, arg, bound),
+        TermKind::Call { id, args, .. } if static_atomic_u8_view_call(ctx, *id, term, args) => {
+            static_atomic_predicate_is_total(ctx, &args[0], bound)
+        }
+        _ => false,
+    }
+}
+
+fn static_atomic_u8_view_call<'tcx>(
+    ctx: &TranslationCtx<'tcx>,
+    id: DefId,
+    term: &Term<'tcx>,
+    args: &[Term<'tcx>],
+) -> bool {
+    let view_method = Intrinsic::View.get(ctx);
+    let view_trait = ctx.tcx.parent(view_method);
+    let impl_id = ctx.tcx.parent(id);
+    if !matches!(ctx.tcx.def_kind(impl_id), DefKind::Impl { .. }) {
+        return false;
+    }
+    let Some(trait_ref) = ctx.tcx.impl_opt_trait_ref(impl_id) else { return false };
+    let trait_ref = trait_ref.skip_binder();
+    let sig = ctx.tcx.fn_sig(id).instantiate_identity().skip_binder();
+    let output = ctx.tcx.normalize_erasing_regions(ctx.typing_env(id), sig.output());
+    let checks = [
+        trait_ref.def_id == view_trait,
+        trait_ref.self_ty() == ctx.tcx.types.u8,
+        ctx.tcx.item_name(id) == ctx.tcx.item_name(view_method),
+        ctx.tcx.generics_of(id).count() == 0,
+        crate::contracts_items::get_builtin(ctx.tcx, id)
+            .is_some_and(|builtin| builtin.as_str() == "creusot.int.UInt8$BW$.t'int"),
+        ctx.sig(id).contract.requires.is_empty(),
+        sig.inputs().len() == 1
+            && sig.inputs().first().is_some_and(|input| *input == ctx.tcx.types.u8),
+        output == ctx.int_ty(),
+        args.len() == 1,
+        args.first().is_some_and(|arg| arg.ty == ctx.tcx.types.u8),
+        term.ty == ctx.int_ty(),
+    ];
+    checks.into_iter().all(|ok| ok)
+}
+
 pub fn crate_name(tcx: TyCtxt) -> why3::Symbol {
     tcx.crate_name(LOCAL_CRATE).as_str().into()
 }
