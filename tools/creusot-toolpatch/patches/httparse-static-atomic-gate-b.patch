+fn compare_audits(config: &AuditConfig, normal: &str, proof: &str) -> Result<(), String> {
+    fn common_header<'a>(text: &'a str) -> Result<HashMap<&'a str, &'a str>, String> {
+        let mut fields = HashMap::new();
+        for line in text.lines().skip(1) {
+            if line.starts_with("registration\t")
+                || line.starts_with("access\t")
+                || line.starts_with("begin_mir\t")
+            {
+                break;
+            }
+            if let Some((key, value)) = line.split_once('\t') {
+                if key != "mode" {
+                    fields.insert(key, value);
+                }
+            }
+        }
+        if fields.is_empty() {
+            return Err("Gate B audit report has no provenance header".into());
+        }
+        Ok(fields)
+    }
+
+    fn normalize_body(body: &str) -> String {
+        fn normalize_local_defids(text: &str) -> String {
+            let mut out = String::with_capacity(text.len());
+            let mut rest = text;
+            while let Some(start) = rest.find("DefId(0:") {
+                out.push_str(&rest[..start]);
+                let candidate = &rest[start..];
+                let Some(path_start) = candidate.find(" ~ ").map(|ix| ix + 3) else {
+                    out.push_str(candidate);
+                    return out;
+                };
+                let Some(path_end) = candidate[path_start..].find(')').map(|ix| path_start + ix)
+                else {
+                    out.push_str(candidate);
+                    return out;
+                };
+                let path = &candidate[path_start..path_end];
+                out.push_str("DefId(");
+                let mut path_rest = path;
+                while let Some(open) = path_rest.find('[') {
+                    out.push_str(&path_rest[..open]);
+                    let after_open = &path_rest[open + 1..];
+                    let Some(close) = after_open.find(']') else {
+                        out.push_str(&path_rest[open..]);
+                        path_rest = "";
+                        break;
+                    };
+                    let hash = &after_open[..close];
+                    if (4..=16).contains(&hash.len()) && hash.bytes().all(|b| b.is_ascii_hexdigit())
+                    {
+                        path_rest = &after_open[close + 1..];
+                    } else {
+                        out.push_str(&path_rest[open..open + close + 2]);
+                        path_rest = &after_open[close + 1..];
+                    }
+                }
+                out.push_str(path_rest);
+                out.push(')');
+                rest = &candidate[path_end + 1..];
+            }
+            out.push_str(rest);
+            out
+        }
+
+        // MIR Debug prints each Span's hygiene syntax-context table index as
+        // `(#N)`. Adding logic-only items can renumber that session-local
+        // index without changing the executable MIR. Restrict normalization to
+        // syntactically printed Span fields, never arbitrary MIR text or string
+        // constants; unknown Span formats therefore fail closed.
+        fn normalize_span_contexts(text: &str) -> String {
+            fn is_number_pair(text: &str) -> bool {
+                let mut parts = text.split(':');
+                matches!((parts.next(), parts.next(), parts.next()), (Some(a), Some(b), None)
+                    if !a.is_empty() && !b.is_empty()
+                        && a.bytes().all(|byte| byte.is_ascii_digit())
+                        && b.bytes().all(|byte| byte.is_ascii_digit()))
+            }
+
+            fn looks_like_span_field(prefix: &str) -> bool {
+                let marker = ["span: ", "pat_span: ", "opt_match_place:"]
+                    .into_iter()
+                    .filter_map(|needle| prefix.rfind(needle).map(|position| (position, needle)))
+                    .max_by_key(|(position, _)| *position);
+                let Some((position, needle)) = marker else { return false };
+                let field = prefix[position + needle.len()..].trim_end();
+                let mut locations = field.split_whitespace().rev();
+                let Some(end) = locations.next() else { return false };
+                let Some(start) = locations.next().and_then(|token| token.strip_suffix(':')) else {
+                    return false;
+                };
+                if !is_number_pair(end) {
+                    return false;
+                }
+                let mut start_parts = start.rsplit(':');
+                matches!((start_parts.next(), start_parts.next(), start_parts.next()),
+                    (Some(column), Some(line), Some(path))
+                    if !path.is_empty()
+                        && !line.is_empty()
+                        && !column.is_empty()
+                        && line.bytes().all(|byte| byte.is_ascii_digit())
+                        && column.bytes().all(|byte| byte.is_ascii_digit()))
+            }
+
+            fn inside_debug_string(prefix: &str) -> bool {
+                let mut quoted = false;
+                let mut escaped = false;
+                for byte in prefix.bytes() {
+                    if escaped {
+                        escaped = false;
+                    } else if byte == b'\\' && quoted {
+                        escaped = true;
+                    } else if byte == b'"' {
+                        quoted = !quoted;
+                    }
+                }
+                quoted
+            }
+
+            let mut out = String::with_capacity(text.len());
+            let mut rest = text;
+            while let Some(start) = rest.find("(#") {
+                let candidate = &rest[start + 2..];
+                let digit_count = candidate.bytes().take_while(u8::is_ascii_digit).count();
+                if digit_count == 0 || candidate.as_bytes().get(digit_count) != Some(&b')') {
+                    out.push_str(&rest[..start + 2]);
+                    rest = candidate;
+                    continue;
+                }
+                let prefix = &rest[..start];
+                if looks_like_span_field(prefix) && !inside_debug_string(prefix) {
+                    out.push_str(prefix);
+                    out.push_str("(#SPAN_CTXT)");
+                } else {
+                    out.push_str(&rest[..start + digit_count + 3]);
+                }
+                rest = &candidate[digit_count + 1..];
+            }
+            out.push_str(rest);
+            out
+        }
+
+        let normalized = normalize_span_contexts(&normalize_local_defids(body));
+        let mut out = String::with_capacity(normalized.len());
+        let mut rest = normalized.as_str();
+        while let Some(start) = rest.find(", cache: Cache {") {
+            out.push_str(&rest[..start]);
+            let after_start = &rest[start..];
+            let Some(end) = after_start.find(" }, phase:") else {
+                out.push_str(after_start);
+                return out;
+            };
+            rest = &after_start[end + 2..];
+        }
+        out.push_str(rest);
+        out
+    }
+
+    fn payload(text: &str) -> Vec<String> {
+        let mut entries = Vec::new();
+        let mut in_mir = false;
+        for line in text.lines() {
+            if line.starts_with("registration\t") {
+                entries.push(line.split('\t').take(4).collect::<Vec<_>>().join("\t"));
+                continue;
+            }
+            if line.starts_with("begin_mir\t") {
+                in_mir = true;
+            }
+            if line.starts_with("access\t") {
+                entries.push(line.to_string());
+            } else if in_mir {
+                entries.push(normalize_body(line));
+            }
+            if line.starts_with("end_mir\t") {
+                in_mir = false;
+            }
+        }
+        entries
+    }
+
+    if !normal.starts_with("creusot-static-atomic-audit-v2\nmode\tNormal\n")
+        || !proof.starts_with("creusot-static-atomic-audit-v2\nmode\tProof\n")
+    {
+        return Err("Gate B requires fresh normal and proof v2 audit reports".into());
+    }
+    if common_header(normal)? != common_header(proof)? {
+        return Err("Gate B normal/proof audit provenance headers differ".into());
+    }
+    let header = common_header(proof)?;
+    let expected = [
+        ("crate", config.crate_name.as_str()),
+        ("target", config.target.as_str()),
+        ("source_sha256", config.source_sha256.as_str()),
+        ("run_id", config.provenance.run_id.as_str()),
