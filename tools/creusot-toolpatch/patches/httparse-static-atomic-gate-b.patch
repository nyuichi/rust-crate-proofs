+/// Build the proof-only static invariant registry after matching the normal
+/// and proof executable MIR reports. Missing or non-identical reports never
+/// enable the load/store translation rules.
+pub fn build_gate_b_registry<'tcx>(
+    config: &AuditConfig,
+    tcx: TyCtxt<'tcx>,
+) -> Result<GateBRegistry, String> {
+    if config.mode != AuditMode::Proof {
+        return Err("Gate B requires the proof audit mode".into());
+    }
+    let normal_path = env::var_os(GATE_B_NORMAL_AUDIT_ENV)
+        .map(PathBuf::from)
+        .ok_or_else(|| format!("Gate B requires {GATE_B_NORMAL_AUDIT_ENV}"))?;
+    let normal = fs::read_to_string(&normal_path)
+        .map_err(|err| format!("cannot read {}: {err}", normal_path.display()))?;
+    let proof = fs::read_to_string(&config.output)
+        .map_err(|err| format!("cannot read proof audit {}: {err}", config.output.display()))?;
+    compare_audits(config, &normal, &proof)?;
+
+    let atomic_u8 = tcx
+        .get_diagnostic_item(Symbol::intern("AtomicU8"))
+        .ok_or_else(|| "sysroot AtomicU8 diagnostic item was not found".to_string())?;
+    let mut statics = HashMap::new();
+    for registration in &config.statics {
+        let static_id = resolve_local(tcx, &registration.static_path)?;
+        let predicate_id = resolve_local(tcx, &registration.predicate_path)?;
+        validate_static(tcx, static_id, atomic_u8)?;
+        validate_predicate(tcx, predicate_id)?;
+        let initial = read_initial_byte(tcx, static_id)?;
+        if statics
+            .insert(static_id, StaticAtomicSpec { static_id, predicate_id, initial })
+            .is_some()
+        {
+            return Err(format!(
+                "duplicate Gate B registration for {}",
+                tcx.def_path_str(static_id)
+            ));
+        }
+    }
+
+    let local_ids = tcx
+        .iter_local_def_id()
+        .map(|local| (tcx.def_path_str(local.to_def_id()), local.to_def_id()))
+        .collect::<HashMap<_, _>>();
+    let mut accessors: HashMap<_, Vec<_>> = HashMap::new();
+    for line in proof.lines().filter(|line| line.starts_with("access\t")) {
+        let fields = line.split('\t').collect::<Vec<_>>();
+        if fields.len() != 5 || fields[4] != "Ordering::Relaxed" {
+            return Err(format!("malformed Gate B access record: {line}"));
+        }
+        let body_id = *local_ids
+            .get(fields[1])
+            .ok_or_else(|| format!("Gate B access has unknown body `{}`", fields[1]))?;
+        let static_id = *local_ids
+            .get(fields[2])
+            .ok_or_else(|| format!("Gate B access has unknown static `{}`", fields[2]))?;
+        if !statics.contains_key(&static_id) {
+            return Err(format!("Gate B access names unregistered static `{}`", fields[2]));
+        }
+        let method = match fields[3] {
+            "load" => AtomicMethod::Load,
+            "store" => AtomicMethod::Store,
+            other => return Err(format!("unsupported Gate B access method `{other}`")),
+        };
+        if !matches!(tcx.def_kind(body_id), DefKind::Fn | DefKind::AssocFn | DefKind::Closure)
+            || !body_id.is_local()
+            || tcx.hir_maybe_body_owned_by(body_id.expect_local()).is_none()
+            || crate::contracts_items::is_no_translate(tcx, body_id)
+            || crate::backend::is_trusted_item(tcx, body_id)
+        {
+            return Err(format!(
+                "Gate B accessor {} is excluded, trusted, or has no body",
+                tcx.def_path_str(body_id)
+            ));
+        }
+        accessors.entry(body_id).or_default().push((static_id, method));
+    }
+    if accessors.is_empty() {
+        return Err("Gate B registration has no translated load/store accessors".into());
+    }
+    Ok(GateBRegistry {
+        crate_name: config.crate_name.clone(),
+        target: config.target.clone(),
+        provenance: config.provenance.clone(),
+        statics,
+        validated_predicates: HashSet::new(),
+        accessors,
+        bodies: HashMap::new(),
+        translated_accessors: HashSet::new(),
+        emitted_initializers: HashSet::new(),
+    })
+}
+
+/// Serialize the exact obligations and accessor sites that completed Gate B
+/// translation. This is a translation coverage index, not evidence that a
+/// Why3 solver discharged any of the generated goals.
+pub fn coverage_report(
+    ctx: &crate::backend::Why3Generator<'_>,
+    registry: &GateBRegistry,
+) -> Result<String, String> {
+    let tcx = ctx.tcx;
+    registry.verify_complete()?;
+    let mut output = String::from("creusot-static-atomic-coverage-v1\n");
+    output.push_str(&format!("crate\t{}\n", registry.crate_name));
+    output.push_str(&format!("target\t{}\n", registry.target));
+    output.push_str(&format!("run_id\t{}\n", registry.provenance.run_id));
+    output.push_str(&format!(
+        "normal_input_sha256\t{}\nproof_input_sha256\t{}\n",
+        registry.provenance.normal_input_sha256, registry.provenance.proof_input_sha256
+    ));
+    output.push_str(&format!(
+        "compiler_sha256\t{}\npatch_sha256\t{}\nfixture_sha256\t{}\nrunner_sha256\t{}\n",
+        registry.provenance.compiler_sha256,
+        registry.provenance.patch_sha256,
+        registry.provenance.fixture_sha256,
+        registry.provenance.runner_sha256
+    ));
+
+    let mut statics = registry.statics.values().copied().collect::<Vec<_>>();
+    statics.sort_by_key(|spec| tcx.def_path_str(spec.static_id));
+    let mut predicate_modules = HashSet::new();
+    let mut predicates = statics
+        .iter()
+        .map(|spec| spec.predicate_id)
+        .collect::<HashSet<_>>()
+        .into_iter()
+        .collect::<Vec<_>>();
+    predicates.sort_by_key(|predicate| tcx.def_path_str(*predicate));
+    for predicate in predicates {
+        if !registry.validated_predicates.contains(&predicate) {
+            return Err(format!(
+                "Gate B predicate {} was not checked for structural totality",
+                tcx.def_path_str(predicate)
+            ));
+        }
+        output.push_str(&format!(
+            "predicate\t{}\tstructurally-total\tclosed-syntax; allowed-std-tcb=creusot.int.UInt8$BW$.t'int\n",
+            tcx.def_path_str(predicate)
+        ));
+    }
+    for spec in statics {
+        let static_path = tcx.def_path_str(spec.static_id);
+        let predicate_path = tcx.def_path_str(spec.predicate_id);
+        let module_name = ctx.module_path(spec.static_id).why3_ident();
+        predicate_modules.insert((spec.predicate_id, module_name.to_string()));
+        output.push_str(&format!(
+            "init\t{static_path}\t{predicate_path}\t{}\t{}\tvc-emitted\n",
+            spec.initial,
+            module_name.to_string()
+        ));
+    }
+
+    let mut bodies = registry.bodies.iter().collect::<Vec<_>>();
+    bodies.sort_by_key(|(body_id, _)| tcx.def_path_str(**body_id));
+    for (&body_id, audited) in bodies {
+        let body_path = tcx.def_path_str(body_id);
+        let module_name = ctx.module_path(body_id).why3_ident();
+        output.push_str(&format!(
+            "accessor\t{body_path}\t{}\tprogram-goals-emitted\n",
+            module_name.to_string()
+        ));
+        let mut operations = audited.operations.iter().collect::<Vec<_>>();
+        operations.sort_by_key(|(location, operation)| {
+            (
+                location.block.as_usize(),
+                location.statement_index,
+                tcx.def_path_str(operation.static_id),
+                operation.method as u8,
+            )
+        });
+        for (location, operation) in operations {
+            let predicate_id = registry
+                .statics
+                .get(&operation.static_id)
+                .ok_or_else(|| {
+                    format!(
+                        "Gate B coverage references unregistered static {}",
+                        tcx.def_path_str(operation.static_id)
+                    )
+                })?
+                .predicate_id;
+            let predicate_path = tcx.def_path_str(predicate_id);
+            predicate_modules.insert((predicate_id, module_name.to_string()));
+            output.push_str(&format!(
+                "access\t{body_path}\t{}\t{}\t{}\t{}\t{}\t{}\ttranslated\n",
+                module_name.to_string(),
+                tcx.def_path_str(operation.static_id),
+                predicate_path,
+                operation.method.as_str(),
+                location.block.as_usize(),
+                location.statement_index,
+            ));
+        }
+    }
+    let mut predicate_modules = predicate_modules.into_iter().collect::<Vec<_>>();
+    predicate_modules
+        .sort_by_key(|(predicate_id, module)| (tcx.def_path_str(*predicate_id), module.clone()));
+    for (predicate_id, module) in predicate_modules {
+        output.push_str(&format!(
+            "predicate-body\t{}\t{}\tdependency-lowered\n",
+            tcx.def_path_str(predicate_id),
+            module,
+        ));
+    }
+    Ok(output)
+}
+
+pub fn analyze_translation_body<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    body_id: rustc_hir::def_id::DefId,
+    body: &mir::Body<'tcx>,
+    registry: &GateBRegistry,
+) -> Result<AuditedBody, String> {
+    let static_ids = registry.statics.keys().copied().collect::<HashSet<_>>();
+    let contains_registered_static = body.local_decls.iter().any(|decl| {
+        matches!(local_info(decl), Some(LocalInfo::StaticRef { def_id, is_thread_local: false }) if static_ids.contains(def_id))
+    });
+    if !contains_registered_static {
+        return Err(format!(
+            "Gate B accessor {} has no registered static reference in its translated MIR",
+            tcx.def_path_str(body_id)
+        ));
+    }
+    let atomic_u8 = tcx
+        .get_diagnostic_item(Symbol::intern("AtomicU8"))
+        .ok_or_else(|| "sysroot AtomicU8 diagnostic item was not found".to_string())?;
+    let methods = atomic_method_ids(tcx, atomic_u8);
+    let audited = audit_body(tcx, body, body_id, &static_ids, atomic_u8, &methods)?;
+    let mut expected = registry.accessors.get(&body_id).cloned().ok_or_else(|| {
+        format!("Gate B has no built-MIR inventory for {}", tcx.def_path_str(body_id))
+    })?;
+    let mut actual = audited
+        .operations
+        .values()
+        .map(|operation| (operation.static_id, operation.method))
+        .collect::<Vec<_>>();
+    expected.sort_by_key(|(static_id, method)| (tcx.def_path_str(*static_id), *method as u8));
+    actual.sort_by_key(|(static_id, method)| (tcx.def_path_str(*static_id), *method as u8));
+    if actual != expected {
+        return Err(format!(
+            "Gate B translated MIR operation inventory differs for {}: actual {:?}, audited {:?}",
+            tcx.def_path_str(body_id),
+            actual,
+            expected
+        ));
+    }
+    Ok(audited)
+}
