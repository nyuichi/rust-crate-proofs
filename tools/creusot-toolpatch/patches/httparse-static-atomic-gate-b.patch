diff --git a/creusot/src/backend/static_atomic.rs b/creusot/src/backend/static_atomic.rs
new file mode 100644
index 0000000..b963a89
--- /dev/null
+++ b/creusot/src/backend/static_atomic.rs
@@ -0,0 +1,43 @@
+use crate::{
+    backend::{Why3Generator, clone_map::Dependencies, common_meta_decls, term::lower_pure},
+    translated_item::FileModule,
+    translation::{constant::u8_to_term, pearlite::Term},
+};
+use rustc_hir::def_id::DefId;
+use rustc_middle::ty::GenericArgs;
+use why3::{Ident, declaration::Module};
+
+/// Emit the checked initializer obligation for one registered static. The
+/// static value is never translated as a constant or dependency; only its
+/// checked initial byte and the registered predicate appear in this goal.
+pub(crate) fn translate_initializer(
+    ctx: &Why3Generator<'_>,
+    static_id: DefId,
+) -> Option<FileModule> {
+    let spec = ctx.static_atomics.as_ref()?.spec(static_id)?;
+    let names = Dependencies::new(ctx, static_id);
+    let predicate_args = GenericArgs::identity_for_item(ctx.tcx, spec.predicate_id);
+    let initial = u8_to_term(
+        spec.initial,
+        ctx,
+        ctx.typing_env(static_id),
+        ctx.tcx.def_span(static_id),
+    );
+    let invariant = Term::call(
+        ctx.tcx,
+        ctx.typing_env(static_id),
+        spec.predicate_id,
+        predicate_args,
+        [initial],
+    );
+    let goal = lower_pure(ctx, &names, &invariant.spanned());
+    let (mut decls, setters) = names.provide_deps(ctx);
+    decls.extend(common_meta_decls());
+    decls.push(setters.mk_goal(Ident::fresh_local("vc_static_atomic_init"), goal));
+
+    let path = ctx.module_path(static_id);
+    let name = path.why3_ident();
+    let attrs = ctx.span_attr(ctx.def_span(static_id)).into_iter().collect();
+    let meta = ctx.display_impl_of(static_id);
+    Some(FileModule { path, modl: Module { name, decls: decls.into(), attrs, meta } })
+}
