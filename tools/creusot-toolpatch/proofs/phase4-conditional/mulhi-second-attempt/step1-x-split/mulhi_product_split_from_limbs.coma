let rec mulhi_x_split_product (x: UInt128.t) (factor: UInt128.t) (x_hi: UInt64.t) (x_lo: UInt64.t) (return (x'0: ())) =
  {[@stop_split] [@expl:mulhi_x_split_product requires] [%#su128_ext'5] UInt128.t'int x
  = UInt64.t'int x_hi * Pow2int.pow2 64 + UInt64.t'int x_lo}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:mulhi_x_split_product ensures] [%#su128_ext'6] UInt128.t'int x
      * UInt128.t'int factor
    = (UInt64.t'int x_hi * Pow2int.pow2 64 + UInt64.t'int x_lo) * UInt128.t'int factor}
    (! return {result}) ]

let rec mulhi_factor_y_split_product (factor: UInt128.t) (y: UInt128.t) (y_hi: UInt64.t) (y_lo: UInt64.t)
