  [ return (result: ()) ->
  {[@stop_split] [@expl:mulhi_factor_y_split_product ensures] [%#su128_ext'8] UInt128.t'int factor * UInt128.t'int y
    = UInt128.t'int factor * (UInt64.t'int y_hi * Pow2int.pow2 64 + UInt64.t'int y_lo)}
    (! return {result}) ]

