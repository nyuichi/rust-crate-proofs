+#[ensures(0 <= result.0@ && result.0@ < 64.pow2())]
+#[ensures(0 <= result.1@ && result.1@ < 64.pow2())]
+pub(crate) fn u128_halves(n: u128) -> (u64, u64) {
+    ((n >> 64) as u64, n as u64)
