+/// Format an i8 magnitude into the digit-capacity suffix used by the native
+/// signed writer. This is the original signed-wrapper operation extracted so
+/// its mutable slice-to-array view can be related to the containing buffer.
+#[inline]
+#[cfg_attr(all(feature = "no-panic", not(creusot)), no_panic)]
+#[cfg_attr(creusot, ensures(result@ + decimal_values(value@).len() == buf@.len()))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    result@ <= i && i < buf@.len() ==> buf@[i]@ != None))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    result@ <= i && i < buf@.len() ==>
+        buf@[i]@.unwrap_logic()@ == decimal_values(value@)[i - result@]))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    0 <= i && i < result@ ==> (^buf)@[i]@ == buf@[i]@))]
+fn write_u8_suffix_i8(
+    value: u8,
+    buf: &mut [MaybeUninit<u8>; <i8 as Integer>::MAX_STR_LEN],
+) -> usize {
+    #[cfg(creusot)]
+    let buf_before = snapshot!(buf@);
+    let mut offset = <i8 as Integer>::MAX_STR_LEN - <u8 as Integer>::MAX_STR_LEN;
+    #[cfg(creusot)]
+    let old_offset = offset;
+
+    let slice: &mut [MaybeUninit<u8>] = buf;
+    let range = &mut slice[offset..];
+    #[cfg(creusot)]
+    let range_before = snapshot!(range@);
+    let suffix: &mut [MaybeUninit<u8>; <u8 as Integer>::MAX_STR_LEN] =
+        range.try_into().unwrap();
+    #[cfg(creusot)]
+    let suffix_before = snapshot!(suffix@);
+    #[cfg(creusot)]
+    proof_assert!(*suffix_before == *range_before);
+
+    let digit_len = Unsigned::fmt(value, suffix);
+    offset += digit_len;
+
+    #[cfg(creusot)]
+    {
+        proof_assert! {
+            let range_current = *range_before;
+            let range_final = (^range)@;
+            let suffix_current = *suffix_before;
+            let suffix_final = (^suffix)@;
+            suffix_current == range_current && suffix_final == range_final
+                && range_current == (*buf_before).subsequence(old_offset@, (*buf_before).len())
+                && range_final == buf@.subsequence(old_offset@, buf@.len())
+        };
+        proof_assert! {
+            let suffix_current = *suffix_before;
+            let suffix_final = (^suffix)@;
+            forall<i: Int> 0 <= i && i < digit_len@ ==>
+                suffix_final[i]@ == suffix_current[i]@
+        };
+        proof_assert! {
+            let suffix_current = *suffix_before;
+            let suffix_final = (^suffix)@;
+            forall<i: Int> 0 <= i && i < digit_len@ ==>
+                logical_slot_states(suffix_final)[i] == logical_slot_states(suffix_current)[i]
+        };
+        proof_assert! {
+            let suffix_current = *suffix_before;
+            let suffix_final = (^suffix)@;
+            logical_slot_states(suffix_current).subsequence(0, digit_len@)
+                == logical_slot_states(suffix_final).subsequence(0, digit_len@)
+        };
+        proof_assert! {
+            let _ = range_from_prefix_raw_frame(
+                *buf_before,
+                buf@,
+                *suffix_before,
+                (^suffix)@,
+                old_offset@,
+                digit_len@,
+            );
+            forall<i: Int> old_offset@ <= i && i < old_offset@ + digit_len@ ==>
+                (^buf)@[i]@ == buf@[i]@
+        };
+        proof_assert!(forall<i: Int> 0 <= i && i < old_offset@ ==>
+            (^buf)@[i]@ == (*buf_before)[i]@);
+        proof_assert!(offset@ + decimal_values(value@).len() == buf@.len());
+        proof_assert!(forall<i: Int> offset@ <= i && i < buf@.len() ==> buf@[i]@ != None);
+        proof_assert!(forall<i: Int> offset@ <= i && i < buf@.len() ==>
+            buf@[i]@.unwrap_logic()@ == decimal_values(value@)[i - offset@]);
+        proof_assert!(forall<i: Int> 0 <= i && i < offset@ ==> (^buf)@[i]@ == (*buf_before)[i]@);
+    }
+
+    offset
+}
+
+/// Signed i8 adapter used by the native `Sealed::write` implementation.
+/// It calls the proved u8 runtime formatter, then performs the original sign
+/// placement and byte write.
+#[inline]
+#[cfg_attr(all(feature = "no-panic", not(creusot)), no_panic)]
+#[cfg_attr(creusot, ensures(result@ + integer_decimal_values(value).len() == buf@.len()))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    result@ <= i && i < buf@.len() ==> (^buf)@[i]@ != None))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    result@ <= i && i < buf@.len() ==>
+        (^buf)@[i]@.unwrap_logic()@ == integer_decimal_values(value)[i - result@]))]
+#[cfg_attr(creusot, ensures(forall<i: Int>
+    0 <= i && i < result@ ==> (^buf)@[i]@ == buf@[i]@))]
+fn signed_write_i8(
+    value: i8,
+    buf: &mut [MaybeUninit<u8>; <i8 as Integer>::MAX_STR_LEN],
+) -> usize {
+    let magnitude = value.unsigned_abs();
+    #[cfg(creusot)]
+    {
+        proof_assert!(integer_value(value) == value@);
+        proof_assert!(magnitude@ == if integer_value(value) < 0 {
+            -integer_value(value)
+        } else {
+            integer_value(value)
+        });
+        proof_assert! {
+            let _ = decimal_values_len_u8(magnitude);
+            decimal_values(magnitude@).len() <= 3
+        };
+    }
+
+    let mut offset = write_u8_suffix_i8(magnitude, buf);
+    if value < 0 {
+        offset -= 1;
+        buf[offset].write(b'-');
+    }
+    offset
+}
+
+#[cfg(creusot)]
+fn check_signed_i8_write(value: i8) {
+    let mut buf = [MaybeUninit::<u8>::uninit(); <i8 as Integer>::MAX_STR_LEN];
+    let start = signed_write_i8(value, &mut buf);
+    proof_assert!(start@ + integer_decimal_values(value).len() == buf@.len());
+    proof_assert!(forall<i: Int> start@ <= i && i < buf@.len() ==> buf@[i]@ != None);
+    proof_assert!(forall<i: Int> start@ <= i && i < buf@.len() ==>
+        buf@[i]@.unwrap_logic()@ == integer_decimal_values(value)[i - start@]);
+}
+
