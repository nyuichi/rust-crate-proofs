que identifier for a type."},{"DocComment":""},{"DocComment":" Each `TypeId` is an opaque object which does not allow inspection of what's"},{"DocComment":" inside but does allow basic operations such as cloning, comparison,"},{"DocComment":" printing, and showing."},{"DocComment":""},{"DocComment":" A `TypeId` is currently only available for types which ascribe to `'static`,"},{"DocComment":" but this limitation may be removed in the future."},{"DocComment":""},{"DocComment":" While `TypeId` implements `Hash`, `PartialOrd`, and `Ord`, it is worth"},{"DocComment":" noting that the hashes and ordering will vary between Rust releases. Beware"},{"DocComment":" of relying on them inside of your code!"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" Like other [`Rust`-representation][repr-rust] types, `TypeId`'s size and layout are unstable."},{"DocComment":" In particular, this means that you cannot rely on the size and layout of `TypeId` remaining the"},{"DocComment":" same between Rust releases; they are subject to change without prior notice between Rust"},{"DocComment":" releases."},{"DocComment":""},{"DocComment":" [repr-rust]: https://doc.rust-lang.org/reference/type-layout.html#r-layout.repr.rust.unspecified"},{"DocComment":""},{"DocComment":" # Danger of Improper Variance"},{"DocComment":""},{"DocComment":" You might think that subtyping is impossible between two static types,"},{"DocComment":" but this is false; there exists a static type with a static subtype."},{"DocComment":" To wit, `fn(&str)`, which is short for `for<'any> fn(&'any str)`, and"},{"DocComment":" `fn(&'static str)`, are two distinct, static types, and yet,"},{"DocComment":" `fn(&str)` is a subtype of `fn(&'static str)`, since any value of type"},{"DocComment":" `fn(&str)` can be used where a value of type `fn(&'static str)` is needed."},{"DocComment":""},{"DocComment":" This means that abstractions around `TypeId`, despite its"},{"DocComment":" `'static` bound on arguments, still need to worry about unnecessary"},{"DocComment":" and improper variance: it is advisable to strive for invariance"},{"DocComment":" first. The usability impact will be negligible, while the reduction"},{"DocComment":" in the risk of unsoundness will be most welcome."},{"DocComment":""},{"DocComment":" ## Examples"},{"DocComment":""},{"DocComment":" Suppose `SubType` is a subtype of `SuperType`, that is,"},{"DocComment":" a value of type `SubType` can be used wherever"},{"DocComment":" a value of type `SuperType` is expected."},{"DocComment":" Suppose also that `CoVar<T>` is a generic type, which is covariant over `T`"},{"DocComment":" (like many other types, including `PhantomData<T>` and `Vec<T>`)."},{"DocComment":""},{"DocComment":" Then, by covariance, `CoVar<SubType>` is a subtype of `CoVar<SuperType>`,"},{"DocComment":" that is, a value of type `CoVar<SubType>` can be used wherever"},{"DocComment":" a value of type `CoVar<SuperType>` is expected."},{"DocComment":""},{"DocComment":" Then if `CoVar<SuperType>` relies on `TypeId::of::<SuperType>()` to uphold any invariants,"},{"DocComment":" those invariants may be broken because a value of type `CoVar<SuperType>` can be created"},{"DocComment":" without going through any of its methods, like so:"},{"DocComment":" ```"},{"DocComment":" type SubType = fn(&());"},{"DocComment":" type SuperType = fn(&'static ());"},{"DocComment":" type CoVar<T> = Vec<T>; // imagine something more complicated"},{"DocComment":""},{"DocComment":" let sub: CoVar<SubType> = CoVar::new();"},{"DocComment":" // we have a `CoVar<SuperType>` instance without"},{"DocComment":" // *ever* having called `CoVar::<SuperType>::new()`!"},{"DocComment":" let fake_super: CoVar<SuperType> = sub;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following is an example program that tries to use `TypeId::of` to"},{"DocComment":" implement a generic type `Unique<T>` that guarantees unique instances for each `Unique<T>`,"},{"DocComment":" that is, for each type `T` there can be at most one value of type `Unique<T>` at any time."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" mod unique {"},{"DocComment":"     use std::any::TypeId;"},{"DocComment":"     use std::collections::BTreeSet;"},{"DocComment":"     use std::marker::PhantomData;"},{"DocComment":"     use std::sync::Mutex;"},{"DocComment":""},{"DocComment":"     static ID_SET: Mutex<BTreeSet<TypeId>> = Mutex::new(BTreeSet::new());"},{"DocComment":""},{"DocComment":"     // TypeId has only covariant uses, which makes Unique covariant over TypeAsId 🚨"},{"DocComment":"     #[derive(Debug, PartialEq)]"},{"DocComment":"     pub struct Unique<TypeAsId: 'static>("},{"DocComment":"         // private field prevents creation without `new` outside this module"},{"DocComment":"         PhantomData<TypeAsId>,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Unique<TypeAsId> {"},{"DocComment":"         pub fn new() -> Option<Self> {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (set.insert(TypeId::of::<TypeAsId>())).then(|| Self(PhantomData))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Drop for Unique<TypeAsId> {"},{"DocComment":"         fn drop(&mut self) {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (!set.remove(&TypeId::of::<TypeAsId>())).then(|| panic!(\"duplicity detected\"));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" use unique::Unique;"},{"DocComment":""},{"DocComment":" // `OtherRing` is a subtype of `TheOneRing`. Both are 'static, and thus have a TypeId."},{"DocComment":" type TheOneRing = fn(&'static ());"},{"DocComment":" type OtherRing = fn(&());"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let the_one_ring: Unique<TheOneRing> = Unique::new().unwrap();"},{"DocComment":"     assert_eq!(Unique::<TheOneRing>::new(), None);"},{"DocComment":""},{"DocComment":"     let other_ring: Unique<OtherRing> = Unique::new().unwrap();"},{"DocComment":"     // Use that `Unique<OtherRing>` is a subtype of `Unique<TheOneRing>` 🚨"},{"DocComment":"     let fake_one_ring: Unique<TheOneRing> = other_ring;"},{"DocComment":"     assert_eq!(fake_one_ring, the_one_ring);"},{"DocComment":""},{"DocComment":"     std::mem::forget(fake_one_ring);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"TypeId","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":2},"guarantee":null},"align":{"chosen":{"Deduplicated":13},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":15,"item_meta":{"name":[{"Builtin":["Str",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Str"},"kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Value":[13,{"Slice":[{"Value":[14,{"Scalar":{"Integer":{"Unsigned":"U8"}}}]},null]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[68,{"FromMetadata":"SliceLength"}]},"guarantee":{"Value":[69,{"AtLeast":{"Value":[70,{"AlignTo":{"base":{"Value":[71,{"Plus":[{"Value":[72,{"Constant":{"Value":[26,[{"OffsetOf":[{"id":15,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Str"},null,0]},{"Deduplicated":0}]]}}]},{"Value":[73,{"Constant":{"Value":[27,[{"SizeOf":{"Deduplicated":13}},{"Deduplicated":0}]]}}]}]}]},"target_align":{"Value":[74,{"Constant":{"Value":[28,[{"AlignOf":{"Deduplicated":13}},{"Deduplicated":0}]]}}]}}}]}}]}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[75,{"AtLeast":{"Deduplicated":74}}]}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":74}},"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":false,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Request",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":588,"col":0},"end":{"line":588,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Request` supports generic, type-driven access to data. Its use is currently restricted to the"},{"DocComment":" standard library in cases where trait authors wish to allow trait implementors to share generic"},{"DocComment":" information across trait boundaries. The motivating and prototypical use case is"},{"DocComment":" `core::error::Error` which would otherwise require a method per concrete type (e.g."},{"DocComment":" `std::backtrace::Backtrace` instance that implementors want to expose to users)."},{"DocComment":""},{"DocComment":" # Data flow"},{"DocComment":""},{"DocComment":" To describe the intended data flow for Request objects, let's consider two conceptual users"},{"DocComment":" separated by API boundaries:"},{"DocComment":""},{"DocComment":" * Consumer - the consumer requests objects using a Request instance; e.g. a crate that offers"},{"DocComment":"   fancy `Error`/`Result` reporting to users wants to request a Backtrace from a given `dyn Error`."},{"DocComment":""},{"DocComment":" * Producer - the producer provides objects when requested via Request; e.g. a library with an"},{"DocComment":"   an `Error` implementation that automatically captures backtraces at the time instances are"},{"DocComment":"   created."},{"DocComment":""},{"DocComment":" The consumer only needs to know where to submit their request and is expected to handle the"},{"DocComment":" request not being fulfilled by the use of `Option<T>` in the responses offered by the producer."},{"DocComment":""},{"DocComment":" * A Producer initializes the value of one of its fields of a specific type. (or is otherwise"},{"DocComment":"   prepared to generate a value requested). e.g., `backtrace::Backtrace` or"},{"DocComment":"   `std::backtrace::Backtrace`."},{"DocComment":" * A Consumer requests an object of a specific type (say `std::backtrace::Backtrace`). In the"},{"DocComment":"   case of a `dyn Error` trait object (the Producer), there are functions called `request_ref` and"},{"DocComment":"   `request_value` to simplify obtaining an `Option<T>` for a given type."},{"DocComment":" * The Producer, when requested, populates the given Request object which is given as a mutable"},{"DocComment":"   reference."},{"DocComment":" * The Consumer extracts a value or reference to the requested type from the `Request` object"},{"DocComment":"   wrapped in an `Option<T>`; in the case of `dyn Error` the aforementioned `request_ref` and"},{"DocComment":"   `request_value` methods mean that `dyn Error` users don't have to deal with the `Request` type at"},{"DocComment":"   all (but `Error` implementors do). The `None` case of the `Option` suggests only that the"},{"DocComment":"   Producer cannot currently offer an instance of the requested type, not that it can't or never will."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The best way to demonstrate this is using an example implementation of `Error`'s `provide` trait"},{"DocComment":" method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(error_generic_member_access)]"},{"DocComment":" use core::fmt;"},{"DocComment":" use core::error::Request;"},{"DocComment":" use core::error::request_ref;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum MyLittleTeaPot {"},{"DocComment":"     Empty,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyBacktrace {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl MyBacktrace {"},{"DocComment":"     fn new() -> MyBacktrace {"},{"DocComment":"         // ..."},{"DocComment":"         # MyBacktrace {}"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Error {"},{"DocComment":"     backtrace: MyBacktrace,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Error {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Example Error\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl std::error::Error for Error {"},{"DocComment":"     fn provide<'a>(&'a self, request: &mut Request<'a>) {"},{"DocComment":"         request"},{"DocComment":"             .provide_ref::<MyBacktrace>(&self.backtrace);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let backtrace = MyBacktrace::new();"},{"DocComment":"     let error = Error { backtrace };"},{"DocComment":"     let dyn_error = &error as &dyn std::error::Error;"},{"DocComment":"     let backtrace_ref = request_ref::<MyBacktrace>(dyn_error).unwrap();"},{"DocComment":""},{"DocComment":"     assert!(core::ptr::eq(&error.backtrace, backtrace_ref));"},{"DocComment":"     assert!(request_ref::<MyLittleTeaPot>(dyn_error).is_none());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Invariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[76,{"AlignTo":{"base":{"Value":[77,{"AlignTo":{"base":{"Value":[78,{"Plus":[{"Deduplicated":2},{"Value":[79,{"FromMetadata":"DynSize"}]}]}]},"target_align":{"Value":[80,{"Max":[{"Value":[81,{"FromMetadata":"DynAlign"}]},{"Deduplicated":13}]}]}}}]},"target_align":{"Deduplicated":80}}}]},"guarantee":null},"align":{"chosen":{"Deduplicated":80},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":17,"item_meta":{"