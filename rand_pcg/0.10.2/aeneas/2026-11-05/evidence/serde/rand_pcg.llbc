 is a `Range`"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Range","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":89,"col":4},"end":{"line":89,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Value":[10,{"TypeVar":{"Free":0}}]}},{"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":92,"col":4},"end":{"line":92,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":10}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[39,{"AtLeast":{"Value":[40,{"AlignTo":{"base":{"Value":[41,{"Max":[{"Value":[42,{"Plus":[{"Value":[43,{"Constant":{"Value":[17,[{"OffsetOf":[{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Value":[44,{"Constant":{"Value":[18,[{"SizeOf":{"Deduplicated":10}},{"Deduplicated":0}]]}}]}]}]},{"Value":[45,{"Plus":[{"Value":[46,{"Constant":{"Value":[19,[{"OffsetOf":[{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null},null,1]},{"Deduplicated":0}]]}}]},{"Deduplicated":44}]}]}]}]},"target_align":{"Value":[47,{"Max":[{"Value":[48,{"Constant":{"Value":[20,[{"AlignOf":{"Deduplicated"