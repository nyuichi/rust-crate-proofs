self.step();\n\n        // Output function XSH RR: xorshift high (bits), followed by a random rotate\n        // Constants are for 64-bit state, 32-bit output\n        const ROTATE: u32 = 59; // 64 - 5\n        const XSHIFT: u32 = 18; // (5 + 32) / 2\n        const SPARE: u32 = 27; // 64 - 32 - 5\n\n        let rot = (state >> ROTATE) as u32;\n        let xsh = (((state >> XSHIFT) ^ state) >> SPARE) as u32;\n        Ok(xsh.rotate_right(rot))\n    }\n\n    #[inline]\n    fn try_next_u64(&mut self) -> Result<u64, Infallible> {\n        utils::next_u64_via_u32(self)\n    }\n\n    #[inline]\n    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), Infallible> {\n        utils::fill_bytes_via_next_word(dest, || self.try_next_u32());\n        Ok(())\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3},{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":{"Value":[10,{"kind":{"TraitImpl":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}]}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":25,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"tra